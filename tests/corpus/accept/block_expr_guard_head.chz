# rule: blockValue, recoverBlock, elseGuard
fn o() -> int?:
    return None
fn f(n: int) -> int:
    x := match n:
        1: o()
        _: o()
    else:
        return 7
    y := match n:
        1: o()
        _: o()
    else:
        return 8
    recover:
        print(1 / 0)
    else e:
        return 9
    return x + y
