# rule: fnDecl, closure
# An inline body may be a closure literal: a fn, a method, a `match` arm, an `if`, a statement.
fn adder(n: int) -> fn(int) -> int: fn(x: int) -> int: x + n

struct Scale:
    k: int

    fn by(self) -> fn(int) -> int: fn(x: int) -> int: x * self.k

fn pick(n: int) -> fn(int) -> int:
    match n:
        0: return fn(x: int) -> int: x
        _: return fn(x: int) -> int: x + n

print(adder(1)(2))
print(Scale(k=3).by()(2))
print(pick(4)(1))
if true: fn(x: int) -> int: x
match 1:
    1: fn(x: int) -> int: x
    _: pass
fn(x: int) -> int: x
