# `else` guard: bind on success, handle the failure and leave.
fn parse(s: str) -> int!str:
    if s == "":
        return !"empty"
    return s.len()

fn first(xs: List[int]) -> int?:
    if xs.len() == 0:
        return None
    return xs[0]

fn save(p: str) -> None!str:
    if p == "":
        return !"no path"

fn run(s: str) -> int!str:
    n := parse(s) else e:
        print("bad input: {e}")
        return !e
    m := first([n]) else:
        return 0
    save(s) else e:
        return !e
    _ := save(s) else e:
        panic(e)
    return n + m

fn total(items: List[str]) -> int:
    sum := 0
    for s in items:
        n := parse(s) else:
            continue
        sum += n
    return sum

match run("abc"):
    ?v: print(v)
    !e: print(e)
print(total(["a", "", "abc"]))
