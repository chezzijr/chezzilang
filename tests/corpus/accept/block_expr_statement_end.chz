# rule: value, yieldStmt, returnStmt, assignStmt
n := 1
x := 0
x = match n:
    1: 10
    _: 20
a, b := match n:
    1: (1, 2)
    _: (3, 4)
a, b = match n:
    1: (1, 2)
    _: (3, 4)
fn g(n: int) -> Iterator[int]:
    yield match n:
        1: 10
        _: 20
fn r() -> !:
    return recover:
        print(1)
struct S:
    a: int = match n:
        1: 10
        _: 20
    b: int = 0
