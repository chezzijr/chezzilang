# rule: ifLineStmt, blockValue
c := false
n := 1
if c: x := match n:
    1: 10
    _: 20
elif n == 1:
    print(2)
if c: r := recover:
    1 / 0
elif true:
    print(4)
fn f(c: bool, n: int) -> int:
    if c: return match n:
        1: 10
        _: 20
    elif n == 1:
        return 5
    return 6
fn g() -> int?:
    return None
fn h(c: bool, n: int) -> int:
    if c: x := match n:
        1: g()
        _: g()
    else:
        return 7
    return 8
