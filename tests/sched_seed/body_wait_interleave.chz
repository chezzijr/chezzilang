fn main():
    a := Channel[str]()
    b := Channel[str](1)
    out: List[str] = []
    parallel:
        for i in 0..4:
            spawn:
                for j in 0..3:
                    if i % 2 == 0:
                        a.send("a{i}.{j}")
                    else:
                        b.send("b{i}.{j}")
        for _ in 0..12:
            wait:
                v := a.recv(): out.push(v)
                w := b.recv(): out.push(w)
    print(" ".join(out))
main()
