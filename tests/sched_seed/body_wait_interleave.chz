fn main():
    a := Channel[str]()
    b := Channel[str](1)
    out: List[str] = []
    parallel:
        for i in 0..4:
            spawn:
                for j in 0..3:
                    if i % 2 == 0:
                        a.send("a{i}.{j}")
                    else:
                        b.send("b{i}.{j}")
        for _ in 0..12:
            wait:
                v := a.recv():
                    x := v else: panic("a closed")
                    out.push(x)
                w := b.recv():
                    y := w else: panic("b closed")
                    out.push(y)
    print(" ".join(out))
main()
