fn main():
    ch := Channel[str]()
    out: List[str] = []
    fn put(i: int, j: int) -> int:
        ch.send("t{i}.{j}")
        return j
    parallel:
        for i in 0..4:
            spawn:
                _ := [0, 1, 2].map(fn(j: int) -> int: put(i, j))
        for _ in 0..12:
            v := ch.recv() else: panic("ch closed")
            out.push(v)
    print(" ".join(out))
main()
