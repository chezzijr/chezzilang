fn main():
    ch := Channel[str]()
    parallel:
        for i in 0..4:
            spawn:
                for j in 0..3:
                    ch.send("t{i}.{j}")
    out: List[str] = []
    for _ in 0..12:
        v := ch.recv() else: panic("ch closed")
        out.push(v)
    print(" ".join(out))
main()
