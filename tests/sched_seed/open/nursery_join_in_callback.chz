fn work(tag: str, ch: Channel[str]) -> int:
    parallel:
        for i in 0..3:
            spawn:
                for j in 0..3:
                    ch.send("{tag}{i}.{j}")
    return 0
fn main():
    ch := Channel[str](16)
    res := Channel[str](4)
    parallel:
        for c in 0..3:
            spawn:
                _got := [0, 1, 2].map(fn(k: int) -> int: work("c{c}k{k}:", ch))
                res.send("done{c}")
        spawn:
            out: List[str] = []
            for _ in 0..81:
                v := ch.recv() else: panic("ch closed")
                out.push(v)
            print(" ".join(out))
    r1 := res.recv() else: panic("res closed")
    print(r1)
    r2 := res.recv() else: panic("res closed")
    print(r2)
    r3 := res.recv() else: panic("res closed")
    print(r3)
main()
