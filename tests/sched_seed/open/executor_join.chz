import Executor from std.concurrency
fn job(tag: str, ch: Channel[str]) -> int:
    for j in 0..3:
        ch.send("{tag}.{j}")
    return 0
fn main():
    ch := Channel[str](64)
    parallel:
        for c in 0..3:
            spawn:
                ex := Executor()
                for k in 0..3:
                    _ := ex.submit(fn() -> int: job("c{c}k{k}", ch))
                ex.shutdown()
                ch.send("joined{c}")
    out: List[str] = []
    for _ in 0..30:
        out.push(ch.recv())
    print(" ".join(out))
main()
