fn main():
    ch := Channel[str]()
    res := Channel[str](4)
    parallel:
        for i in 0..4:
            spawn:
                for j in 0..3:
                    ch.send("t{i}.{j}")
        for c in 0..2:
            spawn:
                got := [0, 1, 2, 3, 4, 5].map(fn(k: int) -> str: ch.recv())
                res.send("c{c}:" + " ".join(got))
    print(res.recv())
    print(res.recv())
main()
