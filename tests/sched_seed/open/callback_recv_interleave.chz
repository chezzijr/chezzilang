fn main():
    ch := Channel[str]()
    res := Channel[str](4)
    parallel:
        for i in 0..4:
            spawn:
                for j in 0..3:
                    ch.send("t{i}.{j}")
        for c in 0..2:
            spawn:
                fn take(k: int) -> str:
                    v := ch.recv() else: panic("ch closed")
                    return v
                got := [0, 1, 2, 3, 4, 5].map(take)
                res.send("c{c}:" + " ".join(got))
    r1 := res.recv() else: panic("res closed")
    print(r1)
    r2 := res.recv() else: panic("res closed")
    print(r2)
main()
