fn work() -> str:
    ch := Channel[str]()
    parallel:
        for i in 0..4:
            spawn:
                for j in 0..3:
                    ch.send("t{i}.{j}")
    out: List[str] = []
    for _ in 0..12:
        v := ch.recv() else: panic("ch closed")
        out.push(v)
    return " ".join(out)

fn main():
    res := Channel[str](1)
    parallel:
        spawn:
            res.send(work())
    r := res.recv() else: panic("res closed")
    print(r)
main()
