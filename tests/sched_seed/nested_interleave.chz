fn work() -> str:
    ch := Channel[str]()
    parallel:
        for i in 0..4:
            spawn:
                for j in 0..3:
                    ch.send("t{i}.{j}")
    out: List[str] = []
    for _ in 0..12:
        out.push(ch.recv())
    return " ".join(out)

fn main():
    res := Channel[str](1)
    parallel:
        spawn:
            res.send(work())
    print(res.recv())
main()
