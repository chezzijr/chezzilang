# TICKET-246 (F2) — the cursor rule of a walk over a shared collection:
#
#   a walk visits exactly the entries present when it starts, each once.
#
# Grid: walk {for_each, fold, for_each_entry, fold_entries, snapshot, display} x collection
# {List, Set, Map} x mutation during the walk {none, remove visited, remove later, add} x
# mutator {the callback, another task}. `ConcurrentList` has no remove, so its mutation is `push`.
#
# Before the fix a walk re-took the lock per element and indexed by position, so a callback that
# removed the element it was visiting saw `[1, 3, 5]` of six, and a reader beside a remover
# counted 1997 of 2000 untouched entries.

import std.concurrency
import ConcurrentList, ConcurrentSet, ConcurrentMap from std.concurrency.collection

fn six_set() -> ConcurrentSet[int]:
    s := ConcurrentSet[int].new()
    for i in 1..7:
        s.add(i)
    return s

fn six_map() -> ConcurrentMap[int, str]:
    m := ConcurrentMap[int, str].new()
    for i in 1..7:
        m.set(i, "v")
    return m

fn six_list() -> ConcurrentList[int]:
    xs := ConcurrentList[int].new()
    for i in 1..7:
        xs.push(i)
    return xs

# mode 0: none; 1: remove the visited entry; 2: remove a later entry; 3: add an entry.
fn touch_set(s: ConcurrentSet[int], mode: int, x: int):
    if mode == 1:
        s.remove(x)
    if mode == 2:
        s.remove(x + 1)
    if mode == 3:
        s.add(x + 100)

fn touch_map(m: ConcurrentMap[int, str], mode: int, k: int):
    if mode == 1:
        m.remove(k)
    if mode == 2:
        m.remove(k + 1)
    if mode == 3:
        m.set(k + 100, "n")

fn visit_set(s: ConcurrentSet[int], seen: List[int], mode: int, x: int):
    seen.push(x)
    touch_set(s, mode, x)

fn sum_set(s: ConcurrentSet[int], mode: int, acc: int, x: int) -> int:
    touch_set(s, mode, x)
    return acc + x

fn visit_map(m: ConcurrentMap[int, str], seen: List[int], mode: int, k: int):
    seen.push(k)
    touch_map(m, mode, k)

fn sum_map(m: ConcurrentMap[int, str], mode: int, acc: int, k: int) -> int:
    touch_map(m, mode, k)
    return acc + k

fn visit_list(xs: ConcurrentList[int], seen: List[int], mode: int, x: int):
    seen.push(x)
    if mode == 3:
        xs.push(x + 100)

fn sum_list(xs: ConcurrentList[int], mode: int, acc: int, x: int) -> int:
    if mode == 3:
        xs.push(x + 100)
    return acc + x

# ---- mutator: the callback ----

test fn set_for_each_visits_every_starting_entry_under_each_callback_mutation():
    for mode in 0..4:
        s := six_set()
        seen: List[int] = []
        s.for_each(fn(x: int): visit_set(s, seen, mode, x))
        assert seen == [1, 2, 3, 4, 5, 6], "mode {mode}: {seen}"

test fn set_for_each_leaves_what_the_callback_left():
    s := six_set()
    seen: List[int] = []
    s.for_each(fn(x: int): visit_set(s, seen, 1, x))
    assert s.len() == 0
    t := six_set()
    t.for_each(fn(x: int): visit_set(t, seen, 3, x))
    assert t.len() == 12

test fn set_fold_visits_every_starting_entry_under_each_callback_mutation():
    for mode in 0..4:
        s := six_set()
        total := s.fold(0, fn(a: int, x: int) -> int: sum_set(s, mode, a, x))
        assert total == 21, "mode {mode}: {total}"

test fn map_for_each_entry_visits_every_starting_entry_under_each_callback_mutation():
    for mode in 0..4:
        m := six_map()
        seen: List[int] = []
        m.for_each_entry(fn(k: int, v: str): visit_map(m, seen, mode, k))
        assert seen == [1, 2, 3, 4, 5, 6], "mode {mode}: {seen}"

test fn map_fold_entries_visits_every_starting_entry_under_each_callback_mutation():
    for mode in 0..4:
        m := six_map()
        total := m.fold_entries(0, fn(a: int, k: int, v: str) -> int: sum_map(m, mode, a, k))
        assert total == 21, "mode {mode}: {total}"

test fn list_for_each_and_fold_visit_every_starting_entry_when_the_callback_pushes():
    for mode in [0, 3]:
        xs := six_list()
        seen: List[int] = []
        xs.for_each(fn(x: int): visit_list(xs, seen, mode, x))
        assert seen == [1, 2, 3, 4, 5, 6], "mode {mode}: {seen}"
        ys := six_list()
        total := ys.fold(0, fn(a: int, x: int) -> int: sum_list(ys, mode, a, x))
        assert total == 21, "mode {mode}: {total}"

test fn snapshot_and_display_are_one_whole_view():
    s := six_set()
    assert s.snapshot() == {1, 2, 3, 4, 5, 6}
    assert str(s.inner) == "RwShared(" + str(s.snapshot()) + ")"
    m := six_map()
    assert m.snapshot().len() == 6
    xs := six_list()
    assert xs.snapshot() == [1, 2, 3, 4, 5, 6]
    assert str(xs.inner) == "RwShared([1, 2, 3, 4, 5, 6])"

# ---- mutator: another task ----
#
# Odd entries are never touched; a remover deletes the even ones while a reader walks. Every odd
# entry is present for the whole walk, so the reader counts all 2000 of them.

fn odd(x: int) -> int:
    return x % 2

fn remover(s: ConcurrentSet[int], m: ConcurrentMap[int, int]):
    for i in 0..2000:
        s.remove(i * 2)
        m.remove(i * 2)

fn count_odd(acc: concurrency.Shared[int], x: int):
    if x % 2 == 1:
        acc.update(fn(n): n + 1)

fn reader(s: ConcurrentSet[int], m: ConcurrentMap[int, int], out: Channel[List[int]]):
    a := s.fold(0, fn(acc: int, x: int) -> int: acc + odd(x))
    b := m.fold_entries(0, fn(acc: int, k: int, v: int) -> int: acc + odd(k))
    c := concurrency.Shared(0)
    s.for_each(fn(x: int): count_odd(c, x))
    d := concurrency.Shared(0)
    m.for_each_entry(fn(k: int, v: int): count_odd(d, k))
    e := 0
    for x in s.snapshot():
        e += odd(x)
    out.send([a, b, c.get(), d.get(), e])

test fn a_walk_beside_a_remover_visits_every_entry_present_throughout():
    s := ConcurrentSet[int].new()
    m := ConcurrentMap[int, int].new()
    for i in 0..4000:
        s.add(i)
        m.set(i, i)
    out := Channel[List[int]](1)
    parallel:
        spawn remover(s, m)
        spawn reader(s, m, out)
    assert out.recv() == [2000, 2000, 2000, 2000, 2000]
    assert s.len() == 2000
    assert m.len() == 2000

fn pusher(xs: ConcurrentList[int]):
    for i in 1000..2000:
        xs.push(i)

# The starting entries are 0..1000 and the pusher appends 1000..2000 in order, so a walk sees a
# prefix 0..n with n >= 1000: its sum is n * (n - 1) / 2 for the n it counted.
fn list_reader(xs: ConcurrentList[int], out: Channel[bool]):
    n := xs.fold(0, fn(acc: int, x: int) -> int: acc + 1)
    total := xs.fold(0, fn(acc: int, x: int) -> int: acc + x)
    shown := str(xs.inner)
    out.send(n >= 1000 and total >= n * (n - 1) / 2 and shown.starts_with("RwShared([0, 1, 2,"))

test fn a_list_walk_beside_a_pusher_visits_a_whole_prefix():
    xs := ConcurrentList[int].new()
    for i in 0..1000:
        xs.push(i)
    out := Channel[bool](1)
    parallel:
        spawn pusher(xs)
        spawn list_reader(xs, out)
    assert out.recv()
    assert xs.len() == 2000
    assert xs.fold(0, fn(acc: int, x: int) -> int: acc + x) == 1999 * 2000 / 2
