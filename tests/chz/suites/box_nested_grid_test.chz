# TICKET-246 -- nested box calls: a box closure that calls another box.
#
# Grid: depth {2, 3} x inner read {top-level fn, scalar, aggregate, none, qualified module call}
# x outer closure {reads none, a scalar, an aggregate} x box kinds {Shared, RwShared, mixed}
# x inner action {plain, spawn, Executor.submit}; then global boxes, a later-bound box,
# a rebinding between calls, and the plan validator's program.
#
# Every expected value is the output of the base binary (commit 7e4421e4, encoded store) for
# the same cell: a box closure sees the caller's globals as of the call, at every depth. With
# ONE saved caller instead of the chain `Vm.box_chain` the depth-3 cells panic
# (`index out of bounds: the len is 0 but the index is 4`).
# Generated once from the planning probe by target/t246-scratch/nest_to_test.py.

import Executor, RwShared, Shared from std.concurrency
import std.math
K: int = 7
G: List[int] = [1, 2, 3]
fn inc(y: int) -> int:
    return y + 1
fn job(ch: Channel[int]):
    ch.send(K + G.len())
test fn nest_cell_1():
    b0 := Shared(1)
    b1 := Shared(2)
    fn f1(y: int) -> int:
        return inc(y)
    fn f0(x: int) -> int:
        b1.update(f1)
        return x + 1
    r := recover: b0.update(f0)
    assert "{r} {b0.get()} {b1.get()}" == "None 2 3", "d2 Shared/Shared outer=none inner=fn"
test fn nest_cell_2():
    b0 := Shared(1)
    b1 := Shared(2)
    fn f1(y: int) -> int:
        return y + K
    fn f0(x: int) -> int:
        b1.update(f1)
        return x + 1
    r := recover: b0.update(f0)
    assert "{r} {b0.get()} {b1.get()}" == "None 2 9", "d2 Shared/Shared outer=none inner=scalar"
