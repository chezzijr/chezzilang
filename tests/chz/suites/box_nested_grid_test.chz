ga := Shared(1)
gb := RwShared(2)
gc := Shared(3)
late := Shared(100)
fn g2(y: int) -> int:
    return y + late.get() + inc(0)
fn g1(x: int) -> int:
    gb.write(g2)
    return x + 1
fn h3(z: int) -> int:
    return z + late.get() + G.len()
fn h2(y: int) -> int:
    gc.update(h3)
    return y + 1
fn h1(x: int) -> int:
    gb.write(h2)
    return x + K
r1 := recover: ga.update(g1)
assert "{r1} {ga.get()} {gb.get()}" == "None 2 103", "top d2 later-box"
r2 := recover: ga.update(h1)
assert "{r2} {ga.get()} {gb.get()} {gc.get()}" == "None 9 104 106", "top d3 later-box"
G.push(4)
K = 8
r3 := recover: ga.update(h1)
assert "{r3} {ga.get()} {gb.get()} {gc.get()}" == "None 17 105 210", "top d3 after rebinding"
va := Shared(1)
vb := Shared(2)
fn bumpb(x: int) -> int:
    vb.update(fn(y: int) -> int: inc(y))
    return x + 1
va.update(bumpb)
assert "{va.get()} {vb.get()}" == "2 3", "validator"
# The module top level runs before any `test fn`: put the two globals back, so every cell
# above sees the values its expectation was measured with.
K = 7
G.pop()
