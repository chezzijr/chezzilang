# tests/chz/suites/datetime_test.chz — TDD table for std.datetime (pure-Chezzi civil-calendar, UTC-only).
# Published vectors. WEEKDAY ORIGIN is Sunday=0..Saturday=6 (contractual; matches native std.time:
# epoch 0 == 1970-01-01 is Thursday == weekday 4). Run: `cargo run -- test tests/chz/suites/datetime_test.chz`.

import std.datetime

test fn t_leap():
    assert datetime.is_leap_year(2000) == true
    assert datetime.is_leap_year(1900) == false
    assert datetime.is_leap_year(2024) == true
    assert datetime.is_leap_year(2023) == false
    assert datetime.days_in_month(2024, 2) == 29
    assert datetime.days_in_month(2023, 2) == 28
    assert datetime.days_in_month(2024, 4) == 30
    assert datetime.days_in_month(2024, 1) == 31
    assert datetime.days_in_month(2024, 12) == 31

test fn t_days_from_civil():
    assert datetime.days_from_civil(1970, 1, 1) == 0
    assert datetime.days_from_civil(2023, 11, 14) == 19675
    assert datetime.days_from_civil(1969, 12, 31) == -1
    assert datetime.days_from_civil(2024, 2, 29) == 19782

test fn t_civil_from_days():
    y, m, d := datetime.civil_from_days(0)
    assert y == 1970 and m == 1 and d == 1
    y2, m2, d2 := datetime.civil_from_days(19675)
    assert y2 == 2023 and m2 == 11 and d2 == 14
    y3, m3, d3 := datetime.civil_from_days(-1)
    assert y3 == 1969 and m3 == 12 and d3 == 31
    # 2000-02-29 (leap)
    z := datetime.days_from_civil(2000, 2, 29)
    y4, m4, d4 := datetime.civil_from_days(z)
    assert y4 == 2000 and m4 == 2 and d4 == 29

test fn t_from_epoch():
    a := datetime.from_epoch(0)
    assert a.year == 1970 and a.month == 1 and a.day == 1
    assert a.hour == 0 and a.minute == 0 and a.second == 0
    assert a.weekday == 4    # Thursday (Sunday=0)
    b := datetime.from_epoch(1700000000)
    assert b.year == 2023 and b.month == 11 and b.day == 14
    assert b.hour == 22 and b.minute == 13 and b.second == 20
    c := datetime.from_epoch(-1)
    assert c.year == 1969 and c.month == 12 and c.day == 31
    assert c.hour == 23 and c.minute == 59 and c.second == 59
    assert c.weekday == 3    # Wednesday

test fn t_to_epoch_roundtrip():
    # spread incl. negatives, leap day, day boundaries
    assert datetime.to_epoch(datetime.from_epoch(0)) == 0
    assert datetime.to_epoch(datetime.from_epoch(1700000000)) == 1700000000
    assert datetime.to_epoch(datetime.from_epoch(-1)) == -1
    assert datetime.to_epoch(datetime.from_epoch(86399)) == 86399
    assert datetime.to_epoch(datetime.from_epoch(-86400)) == -86400
    assert datetime.to_epoch(datetime.from_epoch(951782400)) == 951782400   # 2000-02-29 00:00:00
    assert datetime.to_epoch(datetime.from_epoch(1709164800)) == 1709164800 # 2024-02-29 00:00:00

test fn t_format():
    dt := datetime.from_epoch(1700000000)
    assert datetime.to_iso8601(dt) == "2023-11-14T22:13:20Z"
    assert datetime.to_date_string(dt) == "2023-11-14"
    assert datetime.to_time_string(dt) == "22:13:20"
    assert datetime.to_string(dt) == "2023-11-14 22:13:20"
    # zero-pad: epoch 0
    z := datetime.from_epoch(0)
    assert datetime.to_iso8601(z) == "1970-01-01T00:00:00Z"
    assert datetime.to_string(z) == "1970-01-01 00:00:00"
    # proleptic year padding: <1000 and negative (BCE) years keep the sign + zero-pad to 4 digits
    assert datetime.to_date_string(datetime.DateTime(999, 1, 1, 0, 0, 0, 0)) == "0999-01-01"
    assert datetime.to_date_string(datetime.DateTime(0, 1, 1, 0, 0, 0, 0)) == "0000-01-01"
    assert datetime.to_date_string(datetime.DateTime(-44, 3, 15, 0, 0, 0, 0)) == "-0044-03-15"

test fn t_duration():
    assert datetime.add_seconds(0, 90) == 90
    assert datetime.add_days(0, 1) == 86400
    assert datetime.diff_seconds(90, 0) == 90
    assert datetime.diff_days(172800, 0) == 2
    assert datetime.diff_days(-1, 0) == -1   # floor

test fn t_weekday():
    assert datetime.weekday(0) == 4    # Thursday
    assert datetime.weekday(-1) == 3   # Wednesday
    assert datetime.weekday(1700000000) == 2   # 2023-11-14 is Tuesday
    assert datetime.weekday_name(4) == "Thursday"
    assert datetime.weekday_name(0) == "Sunday"
    assert datetime.weekday_name(6) == "Saturday"
    # Out-of-range faults via `panic` (not `assert`), so the message carries the offending value.
    r := recover: datetime.weekday_name(7)
    match r:
        Ok(_): assert false, "expected a fault"
        Err(e): assert e.message().contains("7"), "message must name the offending value"

test fn t_now():
    # smoke: deterministic bounds only, NOT an exact value (clock-dependent).
    n := datetime.now()
    assert n.year >= 2024
    assert n.month >= 1 and n.month <= 12
    assert n.day >= 1 and n.day <= 31
    assert n.hour >= 0 and n.hour <= 23
    assert n.minute >= 0 and n.minute <= 59
    assert n.second >= 0 and n.second <= 59
    assert n.weekday >= 0 and n.weekday <= 6

test fn t_parse_roundtrip():
    # parse_iso8601(to_iso8601(dt)) == dt for representative from_epoch-derived values.
    for e in [0, 1700000000, -1, 951782400, 86399]:
        dt := datetime.from_epoch(e)
        match datetime.parse_iso8601(datetime.to_iso8601(dt)):
            Ok(got): assert got == dt, "roundtrip failed for epoch {e}"
            Err(msg): assert false, "unexpected Err for epoch {e}: {msg}"

test fn t_parse_forms():
    # date-only -> midnight, correct weekday
    match datetime.parse_iso8601("2023-11-14"):
        Ok(d): assert d.year == 2023 and d.month == 11 and d.day == 14 and d.hour == 0 and d.minute == 0 and d.second == 0 and d.weekday == 2
        Err(_): assert false, "date-only should parse"
    # 'T' separator, no tz (naive == UTC)
    match datetime.parse_iso8601("2023-11-14T22:13:20"):
        Ok(d): assert datetime.to_epoch(d) == 1700000000
        Err(_): assert false, "T-form should parse"
    # ' ' (space) separator, equals the 'T' form
    match datetime.parse_iso8601("2023-11-14 22:13:20"):
        Ok(d): assert datetime.to_epoch(d) == 1700000000
        Err(_): assert false, "space-form should parse"

test fn t_parse_tz():
    match datetime.parse_iso8601("1970-01-01T00:00:00Z"):
        Ok(d): assert datetime.to_epoch(d) == 0
        Err(_): assert false, "Z should parse"
    match datetime.parse_iso8601("1970-01-01T05:00:00+05:00"):
        Ok(d): assert datetime.to_epoch(d) == 0
        Err(_): assert false, "+offset should normalize to UTC"
    match datetime.parse_iso8601("1970-01-01T00:00:00-05:00"):
        Ok(d): assert datetime.to_epoch(d) == 18000
        Err(_): assert false, "-offset should normalize to UTC"

test fn t_parse_frac():
    match datetime.parse_iso8601("2023-11-14T22:13:20.5Z"):
        Ok(d): assert datetime.to_epoch(d) == 1700000000
        Err(_): assert false, "fractional seconds should be accepted+truncated"

test fn t_parse_err():
    # every malformed / out-of-range input must be a clean Err (never a fault/abort)
    for bad in ["2023-13-01", "2023-01-32", "2023-01-01T25:00:00Z", "2023-01-01T00:00:60Z", "2023-1x-01", "2023-1-1", "hello", "", "999999999999-01-01", "99999999999999999999-01-01"]:
        match datetime.parse_iso8601(bad):
            Ok(_): assert false, "expected Err for '{bad}'"
            Err(_): assert true

# W6-12 — the YEAR is width-checked like every other field: a short year was silently accepted
# ("24-01-01" parsed as year 24) while "2024-1-1" (short month) correctly Err'd.
test fn t_parse_year_width():
    for bad in ["24-01-01", "4-01-01", "024-01-01", "-24-01-01", "24-01-01T00:00:00Z"]:
        match datetime.parse_iso8601(bad):
            Ok(_): assert false, "expected Err for short year '{bad}'"
            Err(_): assert true
    # The bound MIRRORS the emitter (`pad_year` writes >=4 digits, more for an extended year), so a
    # padded, a negative-padded and an oversized-but-<=9-digit year all still parse.
    for good in ["0999-01-01", "-0044-03-15", "0000-01-01", "20244-01-01"]:
        match datetime.parse_iso8601(good):
            Ok(_): assert true
            Err(msg): assert false, "expected Ok for '{good}', got: {msg}"

# W6-13 — a month outside 1..12 is a domain violation: it FAULTS (recoverable), instead of returning
# a plausible-looking 31 that a `if d > days_in_month(y, m)` validator would silently accept.
test fn t_days_in_month_domain():
    for bad in [13, 0, -1, 100]:
        r := recover: datetime.days_in_month(2024, bad)
        match r:
            Ok(_): assert false, "expected a fault for month {bad}"
            Err(e): assert e.message().contains("month out of range"), "wrong message: {e.message()}"
