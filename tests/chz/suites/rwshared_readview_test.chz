# Tests for the zero-copy READ-view methods on RwShared[List[E]] — len/at/slice/for_each/fold.
# These walk the stored heap-independent WireValue::List under the read guard and from_wire ONE
# element at a time (O(1) memory), so they are naturally serial==M:N byte-identical. The
# chz_suite_passes_both_engines gate runs this file on BOTH engines and asserts identical verdicts.
import std.concurrency

# len / at (incl. negative index) / slice, plus an OOB fault caught by recover:.
test fn read_view_indexing():
    box := RwShared(List(range(1, 1001)))   # [1, 2, ..., 1000]
    assert box.len() == 1000
    assert box.at(0) == 1
    assert box.at(999) == 1000
    assert box.at(-1) == 1000
    assert box.at(-1000) == 1
    assert box.slice(2, 5) == [3, 4, 5]
    assert box.slice(0, 0) == []
    r := recover: box.at(5000)
    match r:
        Ok(v): assert false, "expected OOB fault, got " + str(v)
        Err(e): assert e.message().contains("out of bounds"), e.message()

# for_each: side-effect scan accumulating into an AtomicInt (its own box, no reentrancy).
test fn read_view_for_each():
    box := RwShared(List(range(1, 1001)))
    n := AtomicInt(0)
    box.for_each(fn(x): n.add(x))
    assert n.load() == 500500

# fold: reduce; R is inferred from the init accumulator (int here).
test fn read_view_fold_int():
    box := RwShared(List(range(1, 1001)))
    s := box.fold(0, fn(a, x): a + x)
    assert s == 500500

# fold with a str accumulator — proves R is NOT pinned to int (recovered from init).
test fn read_view_fold_str():
    box := RwShared(List(range(1, 4)))   # [1, 2, 3]
    s := box.fold("", fn(a, x): a + str(x))
    assert s == "123"

# The real fan-out use case: reduce the shared list from inside a spawned task under parallel:.
# Assert the scalar reduced value (order-insensitive) so M:N output ordering can't flake.
test fn read_view_fold_under_parallel():
    box := RwShared(List(range(1, 1001)))
    out := AtomicInt(0)
    parallel:
        spawn:
            out.store(box.fold(0, fn(a, x): a + x))
    assert out.load() == 500500

# Regression: a callback that does a NESTED READ of the SAME box, while a sibling worker HAMMERS that
# box's write lock. The pre-fix impl held ONE read guard across the whole for_each/fold walk; the
# write-preferring std RwLock then blocks the recursive read behind the queued writer -> M:N deadlock
# (serial completes -> parity divergence + hang). Per-element re-lock (guard dropped before the
# callback) makes the nested read fine. Reliably deadlocked the old code; completes fast now.
test fn read_view_nested_read_under_writer():
    box := RwShared(List(range(1, 51)))
    done := AtomicInt(0)
    parallel:
        spawn:                                   # walker: nested read of the SAME box inside the walk
            for _round in range(0, 20):
                box.for_each(fn(x): box.len())   # closure re-reads the same box (return discarded)
                s := box.fold(0, fn(a, x): a + box.at(0))
                assert s == 50
            done.add(1)
        spawn:                                   # writer: hammer the same box's write lock concurrently
            for _round in range(0, 2000):
                box.set(List(range(1, 51)))
    assert done.load() == 1

# Regression: AB-BA cross-box walk. W1 walks A calling B.set; W2 walks B calling A.set. The pre-fix
# impl held A's read guard across B.set (blocked on B.write) while W2 held B's read guard across A.set
# -> mutual M:N deadlock; serial serialises the spawns so it never deadlocks (parity divergence).
test fn read_view_cross_box_no_deadlock():
    a := RwShared(List(range(1, 31)))
    b := RwShared(List(range(1, 31)))
    done := AtomicInt(0)
    parallel:
        spawn:
            for _round in range(0, 30):
                a.for_each(fn(x): b.set(List(range(1, 31))))
            done.add(1)
        spawn:
            for _round in range(0, 30):
                b.for_each(fn(x): a.set(List(range(1, 31))))
            done.add(1)
    assert done.load() == 2
