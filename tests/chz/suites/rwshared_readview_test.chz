# Tests for the zero-copy READ-view methods on RwShared[List[E]] — len/at/slice/for_each/fold.
# These walk the stored heap-independent WireValue::List under the read guard and from_wire ONE
# element at a time (O(1) memory).
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
import std.concurrency

# len / at (incl. negative index) / slice. `at` is the SAFE index: out of range is None, never a
# fault (`[]` is the dangerous one). Same split as `get_key` below and `std.json.at`.
test fn read_view_indexing():
    box := RwShared(List(range(1, 1001)))   # [1, 2, ..., 1000]
    assert box.len() == 1000
    assert box.at(0) == Some(1)
    assert box.at(999) == Some(1000)
    assert box.at(-1) == Some(1000)
    assert box.at(-1000) == Some(1)
    assert box.slice(2, 5) == [3, 4, 5]
    assert box.slice(0, 0) == []
    assert box.at(5000) == None
    assert box.at(-5000) == None

# for_each: side-effect scan accumulating into an AtomicInt (its own box, no reentrancy).
test fn read_view_for_each():
    box := RwShared(List(range(1, 1001)))
    n := AtomicInt(0)
    box.for_each(fn(x): n.add(x))
    assert n.load() == 500500

# fold: reduce; R is inferred from the init accumulator (int here).
test fn read_view_fold_int():
    box := RwShared(List(range(1, 1001)))
    s := box.fold(0, fn(a, x): a + x)
    assert s == 500500

# fold with a str accumulator — proves R is NOT pinned to int (recovered from init).
test fn read_view_fold_str():
    box := RwShared(List(range(1, 4)))   # [1, 2, 3]
    s := box.fold("", fn(a, x): a + str(x))
    assert s == "123"

# The real fan-out use case: reduce the shared list from inside a spawned task under parallel:.
# Assert the scalar reduced value (order-insensitive) so M:N output ordering can't flake.
test fn read_view_fold_under_parallel():
    box := RwShared(List(range(1, 1001)))
    out := AtomicInt(0)
    parallel:
        spawn:
            out.store(box.fold(0, fn(a, x): a + x))
    assert out.load() == 500500

# Regression: a callback that does a NESTED READ of the SAME box, while a sibling worker HAMMERS that
# box's write lock. The pre-fix impl held ONE read guard across the whole for_each/fold walk; the
# write-preferring std RwLock then blocks the recursive read behind the queued writer -> M:N deadlock
# (serial completes -> parity divergence + hang). Per-element re-lock (guard dropped before the
# callback) makes the nested read fine. Reliably deadlocked the old code; completes fast now.
#
# `at` returns `Option[E]`, and `Option` carries no methods, so the nested read goes through this
# named helper rather than an inline expression. The writer always stores the same 50-element list,
# so `None` is unreachable — if it ever fired, the `s == 50` assert below would catch it.
fn nested_first(b: RwShared[List[int]]) -> int:
    match b.at(0):
        Some(v): return v
        None: return 0

test fn read_view_nested_read_under_writer():
    box := RwShared(List(range(1, 51)))
    done := AtomicInt(0)
    parallel:
        spawn:                                   # walker: nested read of the SAME box inside the walk
            for _round in range(0, 20):
                box.for_each(fn(x): box.len())   # closure re-reads the same box (return discarded)
                s := box.fold(0, fn(a, x): a + nested_first(box))
                assert s == 50
            done.add(1)
        spawn:                                   # writer: hammer the same box's write lock concurrently
            for _round in range(0, 2000):
                box.set(List(range(1, 51)))
    assert done.load() == 1

# Regression: AB-BA cross-box walk. W1 walks A calling B.set; W2 walks B calling A.set. The pre-fix
# impl held A's read guard across B.set (blocked on B.write) while W2 held B's read guard across A.set
# -> mutual M:N deadlock; serial serialises the spawns so it never deadlocks (parity divergence).
test fn read_view_cross_box_no_deadlock():
    a := RwShared(List(range(1, 31)))
    b := RwShared(List(range(1, 31)))
    done := AtomicInt(0)
    parallel:
        spawn:
            for _round in range(0, 30):
                a.for_each(fn(x): b.set(List(range(1, 31))))
            done.add(1)
        spawn:
            for _round in range(0, 30):
                b.for_each(fn(x): a.set(List(range(1, 31))))
            done.add(1)
    assert done.load() == 2

# ---- Map[K,V] read-view: len / get_key / has / for_each_entry / fold_entries ----

# len / has (hit + miss) / get_key (Some + None).
test fn map_read_view_len_has_get():
    box := RwShared({"a": 1, "b": 2, "c": 3})
    assert box.len() == 3
    assert box.has("a")
    assert box.has("c")
    assert not box.has("z")
    match box.get_key("b"):
        Some(v): assert v == 2
        None: assert false, "expected Some(2)"
    match box.get_key("z"):
        Some(v): assert false, "expected None, got " + str(v)
        None: assert true

# fold_entries: sum the values. R inferred from the int init.
test fn map_read_view_fold_entries_sum():
    box := RwShared({"a": 1, "b": 2, "c": 3, "d": 4})
    s := box.fold_entries(0, fn(a, k, v): a + v)
    assert s == 10

# fold_entries with a str accumulator over keys — proves R is not pinned to V.
test fn map_read_view_fold_entries_str():
    box := RwShared({"x": 10})
    s := box.fold_entries("", fn(a, k, v): a + k)
    assert s == "x"

# for_each_entry: accumulate values into an AtomicInt (its own box, no reentrancy).
test fn map_read_view_for_each_entry():
    box := RwShared({"a": 5, "b": 7, "c": 11})
    n := AtomicInt(0)
    box.for_each_entry(fn(k, v): n.add(v))
    assert n.load() == 23

# The fan-out use case: reduce the shared map from inside a spawned task under parallel:.
test fn map_read_view_fold_entries_under_parallel():
    box := RwShared({"a": 1, "b": 2, "c": 3, "d": 4, "e": 5})
    out := AtomicInt(0)
    parallel:
        spawn:
            out.store(box.fold_entries(0, fn(a, k, v): a + v))
    assert out.load() == 15

# ---- Set[E] read-view: len / contains / for_each / fold ----

test fn set_read_view_len_contains():
    box := RwShared(Set([1, 2, 3, 4]))
    assert box.len() == 4
    assert box.contains(3)
    assert not box.contains(99)

test fn set_read_view_fold():
    box := RwShared(Set([1, 2, 3, 4, 5]))
    s := box.fold(0, fn(a, x): a + x)
    assert s == 15

test fn set_read_view_for_each():
    box := RwShared(Set([2, 4, 6]))
    n := AtomicInt(0)
    box.for_each(fn(x): n.add(x))
    assert n.load() == 12

# contains from inside a spawned task under parallel:.
test fn set_read_view_contains_under_parallel():
    box := RwShared(Set([10, 20, 30]))
    hit := AtomicInt(0)
    parallel:
        spawn:
            if box.contains(20):
                hit.add(1)
    assert hit.load() == 1

# ---- deadlock regressions (Map + Set), mirroring the List ones above ----
# Pre-fix (guard held across the walk / across hash+eq) reliably hangs on M:N; serial serialises spawns
# so it never deadlocks -> parity divergence. Per-entry/per-probe re-lock makes them complete fast.

test fn map_read_view_nested_read_under_writer():
    box := RwShared({"a": 1, "b": 2, "c": 3})
    done := AtomicInt(0)
    parallel:
        spawn:                                            # walker: nested read of the SAME box
            for _round in range(0, 20):
                box.for_each_entry(fn(k, v): box.len())   # closure re-reads the same box
                s := box.fold_entries(0, fn(a, k, v): a + box.len())
                assert s == 9                             # 3 entries * len 3
            done.add(1)
        spawn:                                            # writer: hammer the same box's write lock
            for _round in range(0, 2000):
                box.set({"a": 1, "b": 2, "c": 3})
    assert done.load() == 1

test fn map_read_view_get_key_nested_under_writer():
    box := RwShared({"a": 1, "b": 2, "c": 3})
    done := AtomicInt(0)
    parallel:
        spawn:                                            # walker does a nested get_key/has of same box
            for _round in range(0, 50):
                match box.get_key("b"):
                    Some(v): assert box.has("a")
                    None: assert true                     # may miss under a concurrent set
            done.add(1)
        spawn:
            for _round in range(0, 2000):
                box.set({"a": 1, "b": 2, "c": 3})
    assert done.load() == 1

test fn set_read_view_nested_read_under_writer():
    box := RwShared(Set([1, 2, 3, 4, 5]))
    done := AtomicInt(0)
    parallel:
        spawn:
            for _round in range(0, 20):
                box.for_each(fn(x): box.len())
                s := box.fold(0, fn(a, x): a + box.len())
                assert s == 25                            # 5 elements * len 5
            done.add(1)
        spawn:
            for _round in range(0, 2000):
                box.set(Set([1, 2, 3, 4, 5]))
    assert done.load() == 1

# ---- W7-11: a stored element whose cycle closes through the ROOT container ----
#
# `RwShared` stores its value as a flat wire; `RwShared([a])` with `a.back = [a]`'s own list gives
#     List{id:0, items:[ Struct{id:1, back: Backref(0)} ]}
# A copy-out view rebuilds ONE piece with its own id->object map, where id 0 (the container, which the
# view never copied) is undefined. That used to hit a `.expect` and ABORT THE HOST — not a fault, the
# process died — on a legal single-threaded program, while `get()` on the same box worked.
#
# The view now rebuilds the whole container and returns the piece out of it, so the cycle survives.
# That is CPython's measured answer for the same shape:
#     b = copy.deepcopy(xs[0]); b.val = 42; b.next[0].val   -> 42
# `elem_split` cannot cover this: it re-emits CELL definitions per piece, and the missing node is a
# container. Every assert below dies with the process, not with a red test, if the fix regresses.

struct Cyc:
    val: int
    back: List[Cyc]

struct CycMap:
    val: int
    back: Map[str, CycMap]

struct CycHash:                # Set/Map-key shapes need a non-recursing `hash`
    val: int
    back: List[CycHash]
    fn hash(self) -> int:
        return self.val

fn cyclic_list() -> List[Cyc]:
    a := Cyc(1, [])
    xs := [a, Cyc(2, [])]
    a.back = xs                # element 0 points back at the list that holds it
    return xs

test fn cyclic_element_at_returns_the_piece_with_its_cycle_intact():
    box := RwShared(cyclic_list())
    match box.at(0):
        Some(e):
            assert e.val == 1
            assert e.back.len() == 2
            # walk the cycle: the copied element is reachable from its own back-reference
            assert e.back[0].back[0].back[0].val == 1
            # identity, not just shape — mutating the copy is visible through its own cycle,
            # exactly as CPython's deepcopy reports (`b.next[0] is b` -> True)
            e.val = 42
            assert e.back[0].val == 42
            assert e.back[0].back[0].back[0].val == 42
        None: assert false, "at(0) on a 2-element list must be Some"
    # the acyclic sibling in the same container is unaffected
    match box.at(1):
        Some(e): assert e.val == 2 and e.back.len() == 0
        None: assert false, "at(1) must be Some"

test fn cyclic_element_slice_for_each_fold():
    box := RwShared(cyclic_list())
    sliced := box.slice(0, 1)
    assert sliced.len() == 1
    assert sliced[0].back[0].back[0].val == 1
    n := AtomicInt(0)
    box.for_each(fn(x): n.add(x.val + x.back.len()))   # 1+2 then 2+0
    assert n.load() == 5
    assert box.fold(0, fn(a, x): a + x.back.len()) == 2

test fn cyclic_map_value_views():
    b := CycMap(7, {})
    m := {"k": b}
    b.back = m                 # the value points back at the map that holds it
    box := RwShared(m)
    match box.get_key("k"):
        Some(v):
            assert v.val == 7
            assert v.back.len() == 1
            v.val = 9
            assert v.back["k"].val == 9        # identity through the cycle
        None: assert false, "get_key must be Some"
    t := AtomicInt(0)
    box.for_each_entry(fn(k, v): t.add(v.val + v.back.len()))
    assert t.load() == 8
    assert box.fold_entries(0, fn(a, k, v): a + v.back["k"].back["k"].val) == 7

test fn cyclic_set_element_views():
    e := CycHash(1, [])
    xs := [e]
    e.back = xs
    box := RwShared(Set(xs))
    n := AtomicInt(0)
    box.for_each(fn(x): n.add(x.val + x.back.len()))
    assert n.load() == 2
    assert box.fold(0, fn(a, x): a + x.back[0].back[0].val) == 1

# ADVERSARIAL REVIEW, charge 1 (the first cut of the W7-11 fix shipped this, and it was WORSE than the
# crash it replaced). `slice` shares ONE rebuild map across its elements, deliberately, so sibling
# closures land on one cell. The first fix ATTEMPTED each piece and reacted to the miss afterwards —
# so element 0's half-finished attempt left a `Cell` holding the inert placeholder in that shared map,
# and element 1 hit the cell's first-wins dedupe and got `nil`:
#   sl[1]()  ->  runtime error: type nil has no method 'len'
# The check is now a PRE-check (`WireValue::backrefs_resolvable`): nothing is allocated until the piece
# is known to be rebuildable, so the map is never poisoned. Both engines agreed on the wrong answer,
# so parity could not have caught it.
test fn cyclic_slice_shared_map_is_not_poisoned_by_a_piece_that_needs_the_container():
    xs: List[fn() -> int] = []
    f := fn() -> int: xs.len()
    g := fn() -> int: xs.len() + 100
    xs.push(f)
    xs.push(g)
    sl := RwShared(xs).slice(0, 2)
    assert sl[0]() == 2
    assert sl[1]() == 102

# ADVERSARIAL REVIEW, charge 2 — `slice` is ONE call returning a container, so it shares within itself
# (`concurrency.md` §airlock). That must hold on cyclic data too: the whole-container rebuild goes into
# the CALLER's map, so every later piece is served from that same container instead of a private copy.
test fn cyclic_slice_shares_within_itself_like_get():
    a := Cyc(1, [])
    b := Cyc(2, [])
    xs := [a, b]
    a.back = xs
    b.back = xs
    box := RwShared(xs)
    sl := box.slice(0, 2)
    sl[1].val = 99
    assert sl[0].back[1].val == 99, "slice must share within itself, like get()"
    g := box.get()
    g[1].val = 77
    assert g[0].back[1].val == 77

# ADVERSARIAL REVIEW round 2 — the same contract, with only a LATER element cyclic. This is the case
# the test above cannot reach, and the second cut of the fix got it wrong: the whole-container rebuild
# went into the shared map at element 1, and `from_wire_memo`'s container arms have no first-wins
# dedupe (only `Cell` does), so it OVERWROTE the entry for element 0 — already materialized and already
# pushed into the result. `sl[1].back[0]` was then a different object than `sl[0]`, i.e. identity
# depended on element ORDER. Measured against CPython on the same shape:
#   sl[0].val = 55  ->  sl[1].back[0].val   CPython 55 (`is sl[0]` -> True), Chezzi gave 1.
# `slice` now decides once, before the first element.
test fn cyclic_slice_shares_when_only_a_LATER_element_is_cyclic():
    a := Cyc(1, [])
    b := Cyc(2, [])
    xs := [a, b]
    b.back = xs                # element 0 is self-contained; only element 1 needs the container
    sl := RwShared(xs).slice(0, 2)
    sl[0].val = 55
    assert sl[1].back[0].val == 55, "slice identity must not depend on element order"

# ADVERSARIAL REVIEW, charge 3 — a `Generator` carries NO wire id (its parked frame can never be a
# `Backref` target), but it CAN contain one through its backing closure. The first cut read "no id" as
# "cannot dangle" and handed back the degraded placeholder; the generator then faulted on `nil`.
test fn cyclic_generator_element_rebuilds_against_the_whole_container():
    xs: List[Iterator[int]] = []
    fn g() -> Iterator[int]:
        yield xs.len()
        yield 99
    xs.push(g())
    match RwShared(xs).at(0):
        Some(it):
            got := []
            for v in it:
                got.push(v)
            assert got == [1, 99], str(got)
        None: assert false, "at(0) must be Some"

# `contains`/`has` rebuild the piece and then compare it — the rebuild no longer aborts, and what is
# left is the PRE-EXISTING, documented limit that structural `==` on cyclic data trips the depth cap
# (same as `cyclic_equality_errors_not_crashes`). Asserted as a catchable fault so a future regression
# back to a host abort is caught here: an abort kills the process instead of failing this test.
test fn cyclic_set_contains_faults_recoverably_instead_of_aborting():
    e := CycHash(1, [])
    xs := [e]
    e.back = xs
    box := RwShared(Set(xs))
    r := recover: box.contains(e)
    match r:
        Ok(v): assert false, "expected the cyclic-equality depth fault, got " + str(v)
        Err(err): assert err.message().contains("maximum structural depth"), err.message()

# AB-BA cross-box: W1 walks map A calling B.set; W2 walks set B calling A.set.
test fn map_set_read_view_cross_box_no_deadlock():
    a := RwShared({"a": 1, "b": 2, "c": 3})
    b := RwShared(Set([1, 2, 3]))
    done := AtomicInt(0)
    parallel:
        spawn:
            for _round in range(0, 30):
                a.for_each_entry(fn(k, v): b.set(Set([1, 2, 3])))
            done.add(1)
        spawn:
            for _round in range(0, 30):
                b.for_each(fn(x): a.set({"a": 1, "b": 2, "c": 3}))
            done.add(1)
    assert done.load() == 2
