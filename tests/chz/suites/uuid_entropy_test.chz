# tests/chz/suites/uuid_entropy_test.chz — std.uuid v4() on the DEFAULT (unseeded) path, which draws
# 16 bytes from the OS CSPRNG per call (CPython's uuid4 shape).
# Output is INTENTIONALLY non-deterministic, so there is NO byte-exact golden — every run draws
# DIFFERENT uuids. We assert PROPERTIES only: uniqueness and the RFC 4122 v4 shape (36 chars, version
# nibble '4', variant in 8/9/a/b).
# It must NOT call uuid_seed: `chezzi test` runs the whole suite in ONE process and the seeded switch
# is process-global and sticky, so seeding here would poison every later v4() in the run.
# Under `cargo test` the gate is `chz_suite_passes` (`tests/chz_suite.rs`), an integration-test binary
# with its own process and its own copy of every `static`. The seeding tests it used to race
# (`vm::parity_tests::golden_uuid_via_run_file`) live in the LIB binary, which cargo sequences
# strictly before/after — so the unseeded path is guaranteed by process isolation, not by a lock.
# Run: `cargo run -- test tests/chz/suites/uuid_entropy_test.chz`.

import std.uuid

test fn t_v4_draws_differ():
    # Two unseeded draws differ with overwhelming probability (128 bits from the OS CSPRNG).
    assert uuid.v4() != uuid.v4()

test fn t_v4_shape():
    u := uuid.v4()
    assert u.len() == 36
    assert u[8:9] == "-"
    assert u[13:14] == "-"
    assert u[18:19] == "-"
    assert u[23:24] == "-"
    assert u[14:15] == "4", "version nibble not 4: {u}"
    assert u[19:20] in "89ab", "variant char not in 8/9/a/b: {u}"

test fn t_v4_lowercase_hex():
    u := uuid.v4()
    for c in u:
        assert c in "0123456789abcdef-", "non-lowercase-hex char: {c}"
