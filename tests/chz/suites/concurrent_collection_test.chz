# Tests for std.concurrency.collection — ConcurrentMap[K, V] + ConcurrentCounter[K] over RwShared.
# Covers single-thread semantics AND the load-bearing concurrency cruxes: the struct stays a SHARED
# handle in a spawned task (the parent's object, by handle), and compound read-modify-write mutators
# (increment/add/get_or_insert) are race-free via a SINGLE exclusive write lock.
import std.concurrency
import std.concurrency.collection

# CRUX GUARD — a spawned task must hold the parent's wrapper struct by handle.
# 1 pre-bind increment + 100 spawned increments on the SAME key under `parallel:` must total exactly
# 101, observed by the PARENT after the join. If the struct were deep-copied, the parent would see 1.
# If the RMW raced (get-then-set instead of one write closure), it would be < 101.
test fn spawned_task_shares_the_wrapper_handle():
    ctr: collection.ConcurrentCounter[str] = collection.ConcurrentCounter(concurrency.RwShared({}))
    ctr.increment("k")
    parallel:
        for i in 0..100:
            spawn:
                ctr.increment("k")
    assert ctr.count("k") == 101

# Single-thread ConcurrentMap surface: set/get (a value / None), contains, len, remove, get_or_insert.
test fn map_basic():
    m: collection.ConcurrentMap[str, int] = collection.ConcurrentMap(concurrency.RwShared({}))
    assert m.len() == 0
    assert m.get("a") == None
    assert not m.contains("a")
    _ := m.insert("a", 1)
    _ := m.insert("b", 2)
    assert m.get("a") == ?1
    assert m.contains("a")
    assert m.len() == 2
    _ := m.remove("a")
    assert m.get("a") == None
    assert not m.contains("a")
    assert m.len() == 1
    # get_or_insert: absent -> inserts default and returns it; present -> returns existing.
    assert m.get_or_insert("c", 9) == 9
    assert m.get("c") == ?9
    assert m.get_or_insert("c", 100) == 9      # already present: default ignored
    assert m.get("c") == ?9
    assert m.len() == 2

# snapshot returns a COPY of the map (a concurrent read).
test fn map_snapshot():
    m: collection.ConcurrentMap[str, int] = collection.ConcurrentMap(concurrency.RwShared({}))
    _ := m.insert("x", 10)
    _ := m.insert("y", 20)
    snap: Map[str, int] = m.snapshot()
    assert snap.len() == 2
    assert snap["x"] == 10
    # mutating the original after the snapshot does not change the copy
    _ := m.insert("z", 30)
    assert snap.len() == 2
    assert m.len() == 3

# Single-thread ConcurrentCounter surface: increment/add/count/total.
test fn counter_basic():
    c: collection.ConcurrentCounter[str] = collection.ConcurrentCounter(concurrency.RwShared({}))
    assert c.count("a") == 0            # absent -> 0
    c.increment("a")
    c.increment("a")
    assert c.count("a") == 2
    c.add("a", 5)
    assert c.count("a") == 7
    c.add("a", -3)                      # negative add
    assert c.count("a") == 4
    c.increment("b")
    assert c.count("b") == 1
    assert c.total() == 5               # 4 + 1

# CORRECTNESS CORE: 100 spawned tasks each increment the SAME key once -> exactly 100.
# The single-write-lock RMW serializes the read-modify-write; any get-then-set race would lose updates.
test fn counter_race_exact():
    c: collection.ConcurrentCounter[str] = collection.ConcurrentCounter(concurrency.RwShared({}))
    parallel:
        for i in 0..100:
            spawn:
                c.increment("hit")
    assert c.count("hit") == 100
    assert c.total() == 100

# Order-independent concurrent shape: each task writes its OWN key i -> i*i; parent reads them all.
test fn map_each_own_key():
    m: collection.ConcurrentMap[int, int] = collection.ConcurrentMap(concurrency.RwShared({}))
    parallel:
        for i in 0..10:
            spawn:
                _ := m.insert(i, i * i)
    s := 0
    for i in 0..10:
        match m.get(i):
            ?v: s = s + v
            None: assert false
    assert s == 285                     # sum of i*i for i in 0..10
    assert m.len() == 10

# Regression: `get_or_insert` raced against `remove` must NOT fault. Pre-fix it did the insert and the
# value read-back in TWO separate locks; a `remove` landing in the window made the read-back recurse
# forever -> "maximum call depth exceeded". Now the check+insert+capture are one write lock, so this
# can't happen. Reaching the asserts at all proves no task faulted; the only legal present value is 7.
test fn get_or_insert_race_no_fault():
    m: collection.ConcurrentMap[str, int] = collection.ConcurrentMap(concurrency.RwShared({}))
    parallel:
        for i in 0..50:
            spawn:
                m.get_or_insert("k", 7)
        for i in 0..50:
            spawn:
                _ := m.remove("k")
    match m.get("k"):
        ?v: assert v == 7
        None: assert true

# ---- TICKET-243: ConcurrentList / ConcurrentSet single-element writers ----------------------------

struct CKey:
    n: int
    tags: List[int]
    fn hash(self) -> int:
        return self.n % 2
    fn eq(self, other: CKey) -> bool:
        return self.n == other.n

# Every pushed row lands once, in order. Red when a push drops its element:
# `[[1], [2], [4], [5, 6]]`. M3.3: `snapshot()` is a shallow copy, so its rows are the live ones.
test fn list_push_keeps_nested_elements_apart():
    c := collection.ConcurrentList(concurrency.RwShared([[1], [2]]))
    c.push([3])
    c.push([4])
    c.push([5, 6])
    snap := c.snapshot()
    assert snap == [[1], [2], [3], [4], [5, 6]]
    snap[3].push(9)
    assert snap == [[1], [2], [3], [4, 9], [5, 6]]
    assert c.at(3) == ?[4, 9]
    assert c.len() == 5

# A whole `set` / `write` on the box replaces the list; the next push must still land after it.
test fn list_push_after_a_whole_store():
    c := collection.ConcurrentList(concurrency.RwShared([[1]]))
    c.push([2])
    c.push([3])
    c.inner.set([[7], [8]])
    c.push([9])
    c.push([10])
    assert c.snapshot() == [[7], [8], [9], [10]]
    c.inner.write(fn(xs): xs[0..1])
    c.push([11])
    c.push([12])
    snap := c.snapshot()
    assert snap == [[7], [11], [12]]
    snap[1].push(0)
    assert snap[2] == [12]

# M3.3: a push stores its argument by handle, so the same object pushed three times is one object
# (Go: `append` of one pointer three times).
test fn list_push_holds_its_argument_by_handle():
    a := [1]
    c := collection.ConcurrentList[List[int]].new()
    c.push(a)
    c.push(a)
    a.push(2)
    c.push(a)
    assert c.snapshot() == [[1, 2], [1, 2], [1, 2]]

test fn list_push_on_empty_and_readers():
    c := collection.ConcurrentList[str].new()
    assert c.len() == 0
    assert c.at(0) == None
    c.push("a")
    c.push("b")
    assert c.at(-1) == ?"b"
    assert c[0..5] == ["a", "b"]
    assert c.fold("", fn(acc: str, x: str) -> str: acc + x) == "ab"

# add is a no-op on a present element and remove on an absent one; colliding user hashes probe by eq.
test fn set_add_and_remove_single_elements():
    c := collection.ConcurrentSet[CKey].new()
    c.insert(CKey(1, [1]))
    c.insert(CKey(3, [3]))
    c.insert(CKey(1, [99]))
    assert c.len() == 2
    assert c.contains(CKey(3, []))
    assert not c.contains(CKey(5, []))
    c.remove(CKey(5, []))
    assert c.len() == 2
    c.remove(CKey(1, []))
    assert c.len() == 1
    assert not c.contains(CKey(1, []))
    assert c.contains(CKey(3, []))
    c.remove(CKey(3, []))
    assert c.len() == 0
    c.insert(CKey(3, [4]))
    assert c.fold(0, fn(a: int, k: CKey) -> int: a + k.tags[0]) == 4

# remove, add, remove on a set built from elements that held one shared list (a Set snapshots its
# elements, so the stored set is flat): the survivors keep their own payload and the hash index
# stays in step with the entries after each in-place removal.
test fn set_remove_then_add_then_remove_keeps_the_survivors():
    shared := [7]
    c := collection.ConcurrentSet(concurrency.RwShared({CKey(1, shared), CKey(2, shared), CKey(3, shared)}))
    c.remove(CKey(1, []))
    assert c.len() == 2
    assert c.fold(0, fn(a: int, k: CKey) -> int: a + k.tags[0]) == 14
    c.insert(CKey(4, [1]))
    c.remove(CKey(2, []))
    assert c.fold(0, fn(a: int, k: CKey) -> int: a + k.n * 10 + k.tags[0]) == 30 + 7 + 40 + 1

# Writers from spawned tasks are visible to the parent: the collection crosses as a shared handle.
test fn list_and_set_writes_from_tasks_reach_the_parent():
    cl := collection.ConcurrentList[List[int]].new()
    cs := collection.ConcurrentSet[int].new()
    parallel:
        for i in 0..50:
            spawn:
                cl.push([i, i + 1])
                cs.insert(i % 10)
                cs.insert(100 + i)
                cs.remove(100 + i)
    assert cl.len() == 50
    assert cs.len() == 10
    assert cl.fold(0, fn(a: int, x: List[int]) -> int: a + x[1] - x[0]) == 50
    total := 0
    for row in cl.snapshot():
        total = total + row[0]
    assert total == 1225
