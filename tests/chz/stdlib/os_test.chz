# tests/chz/stdlib/os_test.chz — std.os module surface.
#
# Run: `cargo run -- test tests/chz/`. Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import std.os

# `hostname()` is `Option[str]`: `None` on the rare `gethostname` syscall FAILURE, where the old code
# substituted a `""` indistinguishable from a real answer. The syscall doesn't fail on a healthy box,
# so `None` can't be forced from Chezzi — assert the SHAPE and the `??` composition, both of which are
# properties of the code.
#
# Deliberately NOT `h.len() > 0`: an empty UTS name is a legitimate `Some("")` (reproduced with
# `unshare -Ur -u` + `sethostname("")`, where CPython's `socket.gethostname()` likewise returns `''`
# rather than erroring). Asserting non-emptiness would gate `cargo test` on a property of the host
# box — any container with an unset UTS name would fail the build for no code defect.
test fn hostname_is_an_option_whose_coalesce_agrees():
    match os.hostname():
        Some(h): assert (os.hostname() ?? "<sentinel>") == h
        None:    assert (os.hostname() ?? "<sentinel>") == "<sentinel>"

test fn hostname_is_stable_across_calls():
    assert (os.hostname() ?? "<sentinel>") == (os.hostname() ?? "<sentinel>")

# `os.chdir` on a missing path must name the path, matching every other path-taking `Err` in the
# fs/io/os surface (`fs.size`, etc. all prefix `"{path}: {e}"`) and both CPython and Go.
test fn chdir_missing_path_names_the_path():
    match os.chdir("/nope/zz-TICKET-081"):
        Err(e): assert e.message().contains("/nope/zz-TICKET-081"), e.message()
        Ok(_):  assert false, "expected Err for a nonexistent directory"
