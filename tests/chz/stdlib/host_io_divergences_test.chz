# tests/chz/stdlib/host_io_divergences_test.chz — TICKET-143 (W14-29, W14-31).
# Go 1.27 `flag` parses ints with ParseInt(s, 0, 64); Go `base64.StdEncoding.DecodeString` and
# CPython `b64decode` ignore \r and \n.

import std.flag as flag
import std.encoding as encoding

test fn flag_int_accepts_go_prefixed_bases():
    fs := flag.new()
    fs.int_flag("n", 0, "count")
    match fs.parse(["-n", "0x10"]):
        Ok(_): pass
        Err(e): assert false, "unexpected Err(" + e.message() + ")"
    assert fs.get_int("n") == 16, str(fs.get_int("n"))

test fn flag_int_leading_zero_is_octal():
    fs := flag.new()
    fs.int_flag("n", 0, "count")
    match fs.parse(["-n", "010"]):
        Ok(_): pass
        Err(e): assert false, "unexpected Err(" + e.message() + ")"
    assert fs.get_int("n") == 8, str(fs.get_int("n"))

test fn base64_decode_ignores_newlines():
    match encoding.base64_decode("Zm9v\r\nYmFy\n"):
        Ok(s): assert s == "foobar", s
        Err(e): assert false, "unexpected Err(" + e.message() + ")"

# Parse one `-n <val>` against an int flag; `Ok(n)` or the `Err` message.
fn parse_n(val: str) -> Result[int, str]:
    fs := flag.new()
    fs.int_flag("n", 0, "count")
    match fs.parse(["-n", val]):
        Ok(_): return Ok(fs.get_int("n"))
        Err(e): return Err(e.message())

fn expect_n(val: str, want: int):
    match parse_n(val):
        Ok(n): assert n == want, val + " -> " + str(n)
        Err(m): assert false, val + " unexpected Err(" + m + ")"

fn expect_bad_n(val: str):
    match parse_n(val):
        Ok(n): assert false, "'" + val + "' parsed as " + str(n) + ", Go rejects it"
        Err(m): assert m.contains("cannot parse"), m

# Go `strconv.ParseInt(s, 0, 64)` rejects these (measured Go 1.27.0).
test fn flag_int_rejects_what_go_rejects():
    expect_bad_n(" 3")
    expect_bad_n("3 ")
    expect_bad_n("08")
    expect_bad_n("1__0")
    expect_bad_n("0x")
    expect_bad_n("0b")
    expect_bad_n("0_")
    expect_bad_n("_1")
    expect_bad_n("1_")
    expect_bad_n("+-5")
    expect_bad_n("")
    expect_bad_n("-")

# Go accepts base prefixes 0x/0o/0b (any case), a leading-0 octal, and `_` between digits.
test fn flag_int_accepts_go_underscores():
    expect_n("0_10", 8)
    expect_n("0x_1f", 31)
    expect_n("1_000", 1000)
    expect_n("0B11", 3)
    expect_n("0o17", 15)
    expect_n("-0x10", -16)
    expect_n("+7", 7)
    expect_n("0", 0)
    expect_n("00", 0)

# The i64 boundary: MIN parses, one past either end is an Err.
test fn flag_int_i64_boundary():
    expect_n("9223372036854775807", 9223372036854775807)
    expect_n("-9223372036854775808", -9223372036854775807 - 1)
    expect_n("-0x8000000000000000", -9223372036854775807 - 1)
    match parse_n("9223372036854775808"):
        Ok(n): assert false, "overflow parsed as " + str(n)
        Err(m): assert m.contains("overflows"), m

fn bad_syntax(args: List[str]) -> str:
    fs := flag.new()
    fs.str_flag("name", "", "n")
    match fs.parse(args):
        Ok(_): return "OK"
        Err(e): return e.message()

test fn flag_bad_syntax_like_go():
    assert bad_syntax(["---name", "x"]).contains("bad flag syntax: ---name"), bad_syntax(["---name", "x"])
    assert bad_syntax(["-=x"]).contains("bad flag syntax: -=x"), bad_syntax(["-=x"])
    assert bad_syntax(["--=x"]).contains("bad flag syntax: --=x"), bad_syntax(["--=x"])

# One and two dashes, and a lone `-` positional, still work.
test fn flag_dash_forms_still_parse():
    assert bad_syntax(["-name", "x"]) == "OK"
    assert bad_syntax(["--name", "x"]) == "OK"
    assert bad_syntax(["--name=x", "-"]) == "OK"
