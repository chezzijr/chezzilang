# tests/chz/stdlib/w10_contract_test.chz — TICKET-069 repro (bug-hunt wave 10, W10-23/24/25/26/18/21).
#
# Six independent stdlib contract violations, each judged against its RUN ancestor. See docs/contributing/gaps.md
# W10-23 (cmp tie rules), W10-24 (fs.mkdir("")), W10-25 (csv.format not injective), W10-26
# (path.with_ext doesn't normalize), W10-18 (1-tuple render), W10-21 (int() rejects underscores).
# Run: `cargo run -- test tests/chz/`.

import std.cmp
import std.fs
import std.csv
import std.path

test fn cmp_min_first_wins_on_tie_like_python():
    nan := 0.0 / 0.0
    # Python: min(-0.0, 0.0) == -0.0 (first arg wins on a non-`<` tie).
    assert cmp.min(-0.0, 0.0) == -0.0, "cmp.min(-0.0, 0.0)"
    # Python: min(nan, 1.0) is nan (first arg wins); Chezzi currently returns 1.0.
    assert cmp.min(nan, 1.0) != cmp.min(nan, 1.0), "cmp.min(nan, 1.0) should be NaN"

test fn fs_mkdir_empty_path_errs():
    r := fs.mkdir("")
    match r:
        ?_: assert false, "fs.mkdir(\"\") should be Err"
        !_: pass

test fn csv_format_round_trips_a_single_empty_field_row():
    rows: List[List[str]] = [[], [""], ["a"]]
    assert csv.parse(csv.format(rows)) == rows, "csv.format([[], [\"\"], [\"a\"]]) round-trip"

test fn path_with_ext_normalizes_extension():
    assert "{path.with_ext("a.b", "..d")}" == "a.d", "with_ext(a.b, ..d)"

test fn one_tuple_renders_with_trailing_comma():
    t := (1,)
    assert "{t}" == "(1,)", "display of (1,)"

test fn to_int_accepts_pep515_underscores():
    assert "1_000".to_int() == ?1000, "to_int(1_000)"

test fn cmp_max_first_wins_on_tie_like_python():
    nan := 0.0 / 0.0
    assert "{cmp.max(-0.0, 0.0)}" == "-0.0", "cmp.max(-0.0, 0.0)"
    assert cmp.max(nan, 1.0) != cmp.max(nan, 1.0), "cmp.max(nan, 1.0) should be NaN"
    assert cmp.max(1.0, nan) == 1.0, "cmp.max(1.0, nan)"
    assert "{cmp.min(0.0, -0.0)}" == "0.0", "cmp.min(0.0, -0.0)"
    assert cmp.min(1.0, nan) == 1.0, "cmp.min(1.0, nan)"
    assert "{cmp.min(-0.0, 0.0)}" == "-0.0", "cmp.min(-0.0, 0.0)"

test fn cmp_clamp_faults_on_inverted_bounds():
    r := recover: cmp.clamp(5, 10, 1)
    match r:
        ?_: assert false, "clamp should fault"
        !e: assert e.message() == "cmp.clamp: inverted bounds (lo > hi)", "clamp fault message"
    assert cmp.clamp(5, 1, 10) == 5, "clamp(5, 1, 10)"
    assert cmp.clamp(15, 0, 10) == 10, "clamp(15, 0, 10)"
    assert cmp.clamp(-4, 0, 10) == 0, "clamp(-4, 0, 10)"
    assert cmp.clamp(3, 3, 3) == 3, "clamp(3, 3, 3) is not inverted"

test fn fs_mkdir_empty_path_message():
    match fs.mkdir(""):
        ?_: assert false, "mkdir empty should be Err"
        !e: assert e.message() == ": No such file or directory (os error 2)", "mkdir empty message"
    match fs.mkdir("."):
        ?_: pass
        !e: assert false, "mkdir . must stay Ok: " + e.message()

test fn csv_format_quotes_a_sole_empty_field():
    assert csv.format([[""]]).len() == 4, "csv.format([[\"\"]]) length"
    assert csv.format([[]]).len() == 2, "csv.format([[]]) length"

test fn csv_round_trip_is_total_over_the_empty_shapes():
    rows: List[List[str]] = [["a"], [], [""], ["", ""], ["b", "c"]]
    assert csv.parse(csv.format(rows)) == rows, "csv round trip over mixed empty shapes"
    assert csv.parse(csv.format([[]])) == [[]], "csv round trip [[]]"
    assert csv.parse(csv.format([[""]])) == [[""]], "csv round trip [[\"\"]]"

test fn path_with_ext_rejects_an_invalid_extension():
    r1 := recover: path.with_ext("a.b", ".")
    match r1:
        ?_: assert false, "with_ext(a.b, .) should fault"
        !e: assert e.message() == "with_ext: invalid extension: '.'", "with_ext(a.b, .) message"
    r2 := recover: path.with_ext("a.b", "/x")
    match r2:
        ?_: assert false, "with_ext(a.b, /x) should fault"
        !e: assert e.message() == "with_ext: invalid extension: '/x'", "with_ext(a.b, /x) message"
    r3 := recover: path.with_ext("a.b", "..")
    match r3:
        ?_: assert false, "with_ext(a.b, ..) should fault"
        !e: assert e.message() == "with_ext: invalid extension: '..'", "with_ext(a.b, ..) message"
    assert "{path.with_ext("a.b", "")}" == "a", "with_ext(a.b, \"\")"
    assert "{path.with_ext("a.b", "md")}" == "a.md", "with_ext(a.b, md)"
    assert "{path.with_ext("a.b", ".md")}" == "a.md", "with_ext(a.b, .md)"
    assert "{path.with_ext("a.b", ".tar.gz")}" == "a.tar.gz", "with_ext(a.b, .tar.gz)"

test fn one_tuple_renders_with_trailing_comma_nested():
    assert "{((1,),)}" == "((1,),)", "display of ((1,),)"
    assert "{[(1,)]}" == "[(1,)]", "display of [(1,)]"
    assert "{("a",)}" == "('a',)", "display of (\"a\",)"
    assert "{(1, 2)}" == "(1, 2)", "display of (1, 2) unchanged"
    assert "{[1]}" == "[1]", "display of [1] list unchanged"

test fn numeric_underscores_follow_pep515():
    assert "1e1_0".to_float() == ?1e10, "to_float(1e1_0)"
    assert ".5_5".to_float() == ?0.55, "to_float(.5_5)"
    assert "12_34_56".to_int() == ?123456, "to_int(12_34_56)"
    assert " 1_000 ".to_int() == ?1000, "to_int( 1_000 )"
    assert "1_0".to_int() == ?10, "to_int(1_0)"
    assert "1_0.5".to_float() == ?10.5, "to_float(1_0.5)"
    assert "1__0".to_int() == !"to_int: cannot parse '1__0' as int", "to_int(1__0) rejected"
    assert "_1".to_int() == !"to_int: cannot parse '_1' as int", "to_int(_1) rejected"
    assert "1_".to_int() == !"to_int: cannot parse '1_' as int", "to_int(1_) rejected"
    assert "1_.5".to_float() == !"to_float: cannot parse '1_.5' as float", "to_float(1_.5) rejected"
    assert "1._5".to_float() == !"to_float: cannot parse '1._5' as float", "to_float(1._5) rejected"
    assert "1_e5".to_float() == !"to_float: cannot parse '1_e5' as float", "to_float(1_e5) rejected"
