# tests/chz/stdlib/fs_glob_missing_dir_test.chz — TICKET-046(b): `fs.glob` must not `Err` just
# because the pattern's directory does not exist.
#
# Measured: Go `filepath.Glob("nope/*")` -> `[] err=<nil>` ("Glob ignores file system errors such
# as I/O errors reading directories"); Python `glob.glob("nope/*")` -> `[]`. A malformed pattern
# must still be `Err`.

import std.fs

test fn glob_on_missing_directory_is_ok_empty():
    match fs.glob("nope_dir_xyz_ticket046/*.c"):
        Ok(matches): assert matches == [], "expected no matches, got " + str(matches)
        Err(e): assert false, "missing directory must not error: " + e.message()

test fn glob_malformed_pattern_still_errs():
    match fs.glob("[unterminated"):
        Ok(matches): assert false, "malformed pattern must still Err, got " + str(matches)
        Err(_): pass
