# tests/chz/stdlib/process_test.chz — std.process output decoding (W6-4).
#
# `ProcResult`'s fields (and `cmd`'s return) are `str`, so the text seam decodes the child's output
# LOSSILY — deliberately, and pinned here: a finished child has no carry (unlike `Socket.read`), so
# Err-ing the call would DESTROY the captured stdout/stderr/code, which is the very data loss B1's
# non-destructive rule forbids. The byte-exact hatch is additive: `run_bytes` / `run_args_bytes`.
# The undecodable byte is SYNTHESIZED with `io.write_bytes` — `printf '\377'` is shell/locale dependent.
# Temp paths carry the pid (the suite runs concurrently with other `cargo test` / `chezzi test` runs).
# Run: `cargo run -- test tests/chz/`. Serial==M:N guarded by the dual-engine gate.

import std.process as pr
import std.io
import std.os
import std.fs

# Write the 3 bytes `A \xff B` to a per-process scratch file and return its path.
fn bad_bytes_file(name: str) -> str:
    p := os.temp_dir() + "/chz_w6_4_" + name + "_" + str(os.getpid()) + ".bin"
    match io.write_bytes(p, b"A\xffB"):
        Ok(_): pass
        Err(e): assert false, "setup: " + e.message()
    return p

test fn run_bytes_is_byte_exact():
    p := bad_bytes_file("run_bytes")
    defer fs.remove_file(p)
    match pr.run_bytes("cat " + p):
        Ok(b): assert b == b"A\xffB", "run_bytes must be byte-exact"
        Err(e): assert false, "run_bytes: " + e.message()

test fn run_args_bytes_is_byte_exact():
    # The injection-safe argv form needs the same hatch (no shell to `2>&1` through).
    p := bad_bytes_file("run_args_bytes")
    defer fs.remove_file(p)
    match pr.run_args_bytes("cat", [p]):
        Ok(b): assert b == b"A\xffB", "run_args_bytes must be byte-exact"
        Err(e): assert false, "run_args_bytes: " + e.message()

test fn bytes_twins_keep_stdout_on_a_non_zero_exit():
    # NON-DESTRUCTIVE (B1's rule) + the `run`/`run_args` Ok/Err partition + Go `cmd.Output()`: captured
    # bytes are handed back even though the child failed.
    match pr.run_bytes("printf out; exit 3"):
        Ok(b): assert b == b"out", "a non-zero exit must not throw the captured bytes away"
        Err(e): assert false, "run_bytes: " + e.message()
    match pr.run_args_bytes("sh", ["-c", "printf out; exit 3"]):
        Ok(b): assert b == b"out", "a non-zero exit must not throw the captured bytes away"
        Err(e): assert false, "run_args_bytes: " + e.message()

test fn bytes_twins_err_only_on_a_spawn_failure():
    match pr.run_args_bytes("definitely-no-such-prog-xyz", []):
        Ok(_): assert false, "a spawn failure must be Err"
        Err(e): assert e.message().contains("failed to run command"), e.message()

test fn text_seam_is_a_documented_lossy_view_never_a_loss():
    # The text seam still returns Ok — the exit code and the decodable stream survive; only the
    # undecodable byte is rendered as U+FFFD, with `run_bytes` beside it for the exact bytes.
    p := bad_bytes_file("text_view")
    defer fs.remove_file(p)
    match pr.run("cat " + p + "; exit 1"):
        Ok(r):
            assert r.code == 1, "the exit code must survive an undecodable stream"
            assert r.stdout.encode() == b"A\xef\xbf\xbdB", str(r.stdout.encode())
        Err(e): assert false, "the text seam must not destroy the capture: " + e.message()
    # Same shape when it is stderr that cannot decode.
    match pr.run("cat " + p + " 1>&2; exit 1"):
        Ok(r):
            assert r.code == 1
            assert r.stderr.encode() == b"A\xef\xbf\xbdB", str(r.stderr.encode())
        Err(e): assert false, "the text seam must not destroy the capture: " + e.message()

test fn text_results_unchanged():
    # Control: the ordinary decodable path is untouched.
    match pr.run("printf hi"):
        Ok(r):
            assert r.stdout == "hi"
            assert r.stderr == ""
            assert r.code == 0
        Err(e): assert false, e.message()
    match pr.run("exit 3"):
        Ok(r): assert r.code == 3, "a non-zero exit stays Ok with the code"
        Err(e): assert false, e.message()
    match pr.cmd("printf hi"):
        Ok(s): assert s == "hi"
        Err(e): assert false, e.message()
