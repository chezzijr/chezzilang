# tests/chz/stdlib/task_cancel_test.chz — TICKET-148 (W14-13).
#
# `shutdown_now()` must not strand a `submit_task` Task: `get()` must promptly return an `Err`
# and `done()` must be true. Reference — CPython 3.14 `shutdown(cancel_futures=True)`:
# `future.result()` raises `CancelledError` at once.
#
# No sleep here (DEC-050). `slow` parks on a channel nothing ever sends to, so only a cancel ends
# it. `shutdown_now()` returns only after every job and its defers finished, so `done()` is settled
# when it returns, whether or not the job had started.

import std.concurrency
import submit_task from std.concurrency.task

fn slow(hold: Channel[int]) -> int:
    return hold.recv()

test fn shutdown_now_does_not_strand_a_submitted_task():
    hold := Channel[int](1)
    ex := Executor()
    t := submit_task(ex, fn(): slow(hold))
    ex.shutdown_now()
    assert t.done(), "done() must be true after shutdown_now()"

test fn a_cancelled_tasks_get_returns_the_cancel_error():
    hold := Channel[int](1)
    ex := Executor()
    t := submit_task(ex, fn(): slow(hold))
    ex.shutdown_now()
    assert t.done(), "done() must be true before get() is called"
    r := t.get()
    match r:
        Ok(_): assert false, "a cancelled task must not yield a value"
        Err(e): assert e.message() == "task cancelled: shutdown_now() stopped it before it finished"
    again := t.get()
    match again:
        Ok(_): assert false, "get() must replay the cancel"
        Err(e): assert e.message() == "task cancelled: shutdown_now() stopped it before it finished"

test fn every_task_is_done_after_shutdown_now_started_or_not():
    hold := Channel[int](1)
    ex := Executor()
    ts := [submit_task(ex, fn(): slow(hold)) for i in range(30)]
    ex.shutdown_now()
    n := 0
    for t in ts:
        if t.done():
            n += 1
    assert n == 30, "all 30 tasks must be done, got {n}"

test fn shutdown_now_settles_a_submit_result_channel():
    hold := Channel[int](1)
    ex := Executor()
    ch := ex.submit_result(fn(): slow(hold))
    ex.shutdown_now()
    match ch.recv():
        Ok(_): assert false, "a cancelled job must not send a value"
        Err(e): assert e.message() == "task cancelled: shutdown_now() stopped it before it finished"

test fn a_task_that_finished_carries_no_cancel_message():
    ex := Executor()
    t := submit_task(ex, fn(): 5)
    ex.shutdown()
    ex.shutdown_now()
    match t.get():
        Ok(v): assert v == 5
        Err(e): assert false, "a finished job must not report a cancel: " + e.message()

# TICKET-219 (C2) — under `Executor(1)` the first job runs and the rest are held, whatever the
# timing. `shutdown_now()` drops the held jobs; each handle settles `Err` (CPython
# `cancel_futures=True`), and a sealed channel gives the same `Err` on every `recv`.
test fn a_held_job_dropped_by_shutdown_now_settles_err():
    msg := "task cancelled: shutdown_now() stopped it before it finished"
    hold := Channel[int](1)
    ex := Executor(1)
    first := submit_task(ex, fn(): slow(hold))
    a := submit_task(ex, fn() -> int: 1)
    b := submit_task(ex, fn() -> int: 2)
    c := ex.submit_result(fn() -> int: 3)
    ex.shutdown_now()
    for t in [first, a, b]:
        assert t.done(), "done() must be true after shutdown_now()"
        match t.get():
            Ok(_): assert false, "a dropped job must not yield a value"
            Err(e): assert e.message() == msg
    for _ in 0..2:
        match c.recv():
            Ok(_): assert false, "a dropped job must not send a value"
            Err(e): assert e.message() == msg

# TICKET-219 — `is_settled` reads a channel; any other value faults instead of answering.
test fn is_settled_rejects_a_non_channel():
    r := recover: concurrency.is_settled(5)
    match r:
        Ok(_): assert false, "is_settled(5) must fault"
        Err(e): assert e.message().contains("Channel"), e.message()

# TICKET-219 — the std internals `_settle` and `_submit_settled` seal only a channel; any other
# value faults instead of being treated as one.
test fn the_settle_internals_reject_a_non_channel():
    r := recover: concurrency._settle(5, 1)
    match r:
        Ok(_): assert false, "_settle(5, 1) must fault"
        Err(e): assert e.message().contains("Channel"), e.message()
    ex := Executor()
    s := recover: ex._submit_settled(fn(): pass, 5)
    match s:
        Ok(_): assert false, "_submit_settled with a non-channel must fault"
        Err(e): assert e.message().contains("requires a Channel"), e.message()
    ex.shutdown()
