# tests/chz/stdlib/task_copy_crossing_value_test.chz — TICKET-203.
#
# A spawn captures the value as of the crossing. A `Task` copy whose owner already called `get()`
# must see the owner's alias as copied (including the owner's later push), not the core's fill-time value.
#
# Grid: {Task.get, memoize1} x owner state {observed and mutated, observed, not observed before the
# crossing} x carrier {spawn call, `spawn:` block, Executor job, Channel send of the handle} x reader
# {copy, owner}, judged against CPython (`Future.result()`, `functools.cache`: the one object) and
# Chezzi's spawn rule (the value current at the crossing). Plus: the owner's `get()` stays one object
# after a crossing, and a copy's write to the crossing value faults (D4), as a captured write does.
#
# TICKET-213 (A1): `a_copy_write_faults_in_every_owner_state` and its `_in_an_executor_job` twin run
# {Task.get, memoize1} x owner state x carrier {spawn call, Executor job}: a copy's write faults in
# the `unobserved` state too. `a_handoff_receiver_write_is_never_silently_lost` is the channel-handoff
# carrier, `a_task_owned_key_reachable_from_a_memo_result_stays_writable` the over-mark cell, and
# `a_copy_miss_on_a_key_that_never_equals_itself_returns_the_fill` the bounded read-back.
# `a_function_valued_copy_result_leaves_the_readers_globals_writable` is the module cell: a marked
# result that holds a function must not mark the reader's globals through the function's module.

import std.concurrency
import submit_task, Task from std.concurrency.task
import memoize1 from std.memoize

# A handle carries a `Result`; these tests read a job that did not fault.
fn must[T](r: Result[T]) -> T:
    match r:
        Ok(v): return v
        Err(e): panic(e.message())

fn mk() -> List[int]:
    return [1]

test fn copy_get_sees_owner_alias_as_of_the_crossing():
    ex := Executor()
    t := submit_task(ex, mk)
    ex.shutdown()
    xs := must(t.get())
    xs.push(99)
    out := Channel[str](2)
    parallel:
        spawn: out.send("captured xs: {xs}  must(t.get()): {must(t.get())}")
    assert out.recv() == "captured xs: [1, 99]  must(t.get()): [1, 99]"

fn one(k: int) -> List[int]:
    return [k]

fn task_in_state(state: str) -> Task[List[int]]:
    ex := Executor()
    t := submit_task(ex, mk)
    ex.shutdown()
    if state != "unobserved":
        xs := must(t.get())
        if state == "mutated":
            xs.push(99)
    return t

fn memo_in_state(state: str) -> fn(int) -> List[int]:
    m := memoize1(one)
    if state != "unobserved":
        a := m(1)
        if state == "mutated":
            a.push(99)
    return m

fn read_task(t: Task[List[int]], out: Channel[str]):
    out.send(str(must(t.get())))

fn read_memo(m: fn(int) -> List[int], out: Channel[str]):
    out.send(str(m(1)))

fn recv_read_task(hc: Channel[Task[List[int]]], out: Channel[str]):
    read_task(hc.recv(), out)

fn recv_read_memo(hc: Channel[fn(int) -> List[int]], out: Channel[str]):
    read_memo(hc.recv(), out)

fn states() -> List[str]:
    return ["mutated", "observed", "unobserved"]

fn want() -> str:
    return "['mutated: copy [1, 99] owner [1, 99]', 'observed: copy [1] owner [1]', 'unobserved: copy [1] owner [1]']"

test fn task_copy_value_through_a_spawn_call():
    got: List[str] = []
    for s in states():
        t := task_in_state(s)
        out := Channel[str](1)
        parallel:
            spawn read_task(t, out)
        got.push("{s}: copy {out.recv()} owner {must(t.get())}")
    assert str(got) == want(), str(got)

test fn task_copy_value_through_a_spawn_block():
    got: List[str] = []
    for s in states():
        t := task_in_state(s)
        out := Channel[str](1)
        parallel:
            spawn: out.send(str(must(t.get())))
        got.push("{s}: copy {out.recv()} owner {must(t.get())}")
    assert str(got) == want(), str(got)

test fn task_copy_value_through_an_executor_job():
    got: List[str] = []
    for s in states():
        t := task_in_state(s)
        out := Channel[str](1)
        ex := Executor()
        ex.submit(fn(): read_task(t, out))
        ex.shutdown()
        got.push("{s}: copy {out.recv()} owner {must(t.get())}")
    assert str(got) == want(), str(got)

test fn task_copy_value_through_a_channel_send():
    got: List[str] = []
    for s in states():
        t := task_in_state(s)
        out := Channel[str](1)
        hc := Channel[Task[List[int]]](1)
        hc.send(t)
        parallel:
            spawn recv_read_task(hc, out)
        got.push("{s}: copy {out.recv()} owner {must(t.get())}")
    assert str(got) == want(), str(got)

test fn memo_copy_value_through_a_spawn_call():
    got: List[str] = []
    for s in states():
        m := memo_in_state(s)
        out := Channel[str](1)
        parallel:
            spawn read_memo(m, out)
        got.push("{s}: copy {out.recv()} owner {m(1)}")
    assert str(got) == want(), str(got)

test fn memo_copy_value_through_a_spawn_block():
    got: List[str] = []
    for s in states():
        m := memo_in_state(s)
        out := Channel[str](1)
        parallel:
            spawn: out.send(str(m(1)))
        got.push("{s}: copy {out.recv()} owner {m(1)}")
    assert str(got) == want(), str(got)

test fn memo_copy_value_through_an_executor_job():
    got: List[str] = []
    for s in states():
        m := memo_in_state(s)
        out := Channel[str](1)
        ex := Executor()
        ex.submit(fn(): read_memo(m, out))
        ex.shutdown()
        got.push("{s}: copy {out.recv()} owner {m(1)}")
    assert str(got) == want(), str(got)

test fn memo_copy_value_through_a_channel_send():
    got: List[str] = []
    for s in states():
        m := memo_in_state(s)
        out := Channel[str](1)
        hc := Channel[fn(int) -> List[int]](1)
        hc.send(m)
        parallel:
            spawn recv_read_memo(hc, out)
        got.push("{s}: copy {out.recv()} owner {m(1)}")
    assert str(got) == want(), str(got)

test fn owner_get_stays_one_object_after_a_crossing():
    t := task_in_state("mutated")
    m := memo_in_state("mutated")
    out := Channel[str](2)
    parallel:
        spawn read_task(t, out)
        spawn read_memo(m, out)
    out.recv()
    out.recv()
    a := must(t.get())
    a.push(7)
    b := m(1)
    b.push(7)
    assert str(must(t.get())) == "[1, 99, 7]", str(must(t.get()))
    assert str(m(1)) == "[1, 99, 7]", str(m(1))

fn send_outcome[T](r: Result[T, Error], out: Channel[str]):
    match r:
        Ok(_): out.send("write ok")
        Err(e): out.send(e.message())

fn copy_write(t: Task[List[int]], m: fn(int) -> List[int], out: Channel[str]):
    rt := recover: must(t.get()).push(5)
    send_outcome(rt, out)
    rm := recover: m(1).push(5)
    send_outcome(rm, out)

test fn a_copy_write_to_the_crossing_value_faults_like_a_captured_write():
    t := task_in_state("mutated")
    m := memo_in_state("mutated")
    out := Channel[str](2)
    parallel:
        spawn copy_write(t, m, out)
    d4 := "this value is this task's copy: a write to it would be lost at the join; share it through Shared/Channel, or make a task-local copy with .copy()"
    got := [out.recv(), out.recv()]
    assert got == [d4, d4], str(got)
    assert str(must(t.get())) == "[1, 99]", str(must(t.get()))
    assert str(m(1)) == "[1, 99]", str(m(1))

fn d4_msg() -> str:
    return "this value is this task's copy: a write to it would be lost at the join; share it through Shared/Channel, or make a task-local copy with .copy()"

fn want_owner(state: str) -> str:
    if state == "mutated":
        return "[1, 99]"
    return "[1]"

test fn a_copy_write_faults_in_every_owner_state():
    for state in ["mutated", "observed", "unobserved"]:
        t := task_in_state(state)
        m := memo_in_state(state)
        out := Channel[str](2)
        parallel:
            spawn copy_write(t, m, out)
        got := [out.recv(), out.recv()]
        assert got == [d4_msg(), d4_msg()], "{state}: {got}"
        assert str(must(t.get())) == want_owner(state), "{state}: {must(t.get())}"
        assert str(m(1)) == want_owner(state), "{state}: {m(1)}"

test fn a_copy_write_faults_in_every_owner_state_in_an_executor_job():
    for state in ["mutated", "observed", "unobserved"]:
        t := task_in_state(state)
        m := memo_in_state(state)
        out := Channel[str](2)
        ex := Executor()
        ex.submit(fn(): copy_write(t, m, out))
        ex.shutdown()
        got := [out.recv(), out.recv()]
        assert got == [d4_msg(), d4_msg()], "{state}: {got}"
        assert str(must(t.get())) == want_owner(state), "{state}: {must(t.get())}"
        assert str(m(1)) == want_owner(state), "{state}: {m(1)}"

fn handoff_write(tc: Channel[Task[List[int]]], mc: Channel[fn(int) -> List[int]], out: Channel[str]):
    t := tc.recv()
    m := mc.recv()
    rt := recover: must(t.get()).push(5)
    send_outcome(rt, out)
    out.send(str(must(t.get())))
    rm := recover: m(1).push(5)
    send_outcome(rm, out)

test fn a_handoff_receiver_write_is_never_silently_lost():
    t := task_in_state("unobserved")
    m := memo_in_state("unobserved")
    tc := Channel[Task[List[int]]](1)
    mc := Channel[fn(int) -> List[int]](1)
    tc.send(t)
    mc.send(m)
    out := Channel[str](3)
    parallel:
        spawn handoff_write(tc, mc, out)
    got := [out.recv(), out.recv(), out.recv()]
    assert got == ["write ok", "[1, 5]", d4_msg()], str(got)
    assert str(must(t.get())) == "[1]", str(must(t.get()))
    assert str(m(1)) == "[1]", str(m(1))

struct Key:
    id: int
    log: List[int]

    fn hash(self) -> int:
        return self.id

    fn eq(self, other: Key) -> bool:
        return self.id == other.id

fn same(k: Key) -> Key:
    return k

fn own_key_write(m: fn(Key) -> Key, out: Channel[str]):
    k := Key(7, [])
    r := m(k)
    rk := recover: k.log.push(1)
    send_outcome(rk, out)
    out.send(str(k.log))
    rr := recover: r.log.push(2)
    send_outcome(rr, out)

test fn a_task_owned_key_reachable_from_a_memo_result_stays_writable():
    m := memoize1(same)
    out := Channel[str](3)
    parallel:
        spawn own_key_write(m, out)
    got := [out.recv(), out.recv(), out.recv()]
    assert got == ["write ok", "[1]", d4_msg()], str(got)
    assert str(m(Key(7, [])).log) == "[]"

struct NeverEq:
    id: int

    fn hash(self) -> int:
        return self.id

    fn eq(self, other: NeverEq) -> bool:
        return false

fn never_list(k: NeverEq) -> List[int]:
    return [k.id]

fn never_use(m: fn(NeverEq) -> List[int], out: Channel[str]):
    out.send(str(m(NeverEq(1))))

# A key that never equals itself is not found by the copy's read-back: the fill's own value is
# returned and the call ends (a retry loop there hangs).
test fn a_copy_miss_on_a_key_that_never_equals_itself_returns_the_fill():
    m := memoize1(never_list)
    out := Channel[str](1)
    parallel:
        spawn never_use(m, out)
    assert out.recv() == "[1]"

struct FnBox:
    f: fn(int) -> int
    xs: List[int]

fn inc(x: int) -> int:
    return x + 1

fn mk_box(k: int) -> FnBox:
    return FnBox(inc, [k])

owner_global: List[int] = [1]

fn send_memo(mc: Channel[fn(int) -> FnBox]):
    mc.send(memoize1(mk_box))

# A wrapper received from a channel returns a marked snapshot. A function inside it points at this
# heap's module; the mark stops there, so the reader's own global stays writable.
test fn a_function_valued_copy_result_leaves_the_readers_globals_writable():
    mc := Channel[fn(int) -> FnBox](1)
    parallel:
        spawn send_memo(mc)
    m := mc.recv()
    b := m(1)
    assert b.f(1) == 2
    rb := recover: b.xs.push(5)
    match rb:
        Ok(_): assert false, "the marked result took a write"
        Err(e): assert e.message() == d4_msg(), e.message()
    rg := recover: owner_global.push(3)
    match rg:
        Ok(_): pass
        Err(e): assert false, e.message()
    assert str(owner_global) == "[1, 3]", str(owner_global)
