# tests/chz/stdlib/time_ms_test.chz — TICKET-163: the wall clock has a millisecond reading.
#
# `time.now_ms()` is epoch MILLISECONDS; `time.now()` stays whole seconds. `DateTime` gains an
# appended `milli` field, `datetime.to_epoch_ms` is the ms twin of `to_epoch`, and ISO-8601 emits
# `.SSS` only when `milli` is non-zero (CPython's rule). Red on base: `now_ms` does not exist.
# Run: `cargo run -- test tests/chz/stdlib/time_ms_test.chz`

import std.time
import std.datetime

test fn now_ms_advances_across_a_sleep():
    a := time.now_ms()
    time.sleep_ms(50)
    b := time.now_ms()
    assert b - a >= 50
    assert b - a < 1000

test fn now_ms_agrees_with_now_seconds():
    s := time.now()
    ms := time.now_ms()
    d := ms / 1000 - s
    assert d >= 0 and d <= 1

test fn datetime_now_populates_milli():
    dt := datetime.now()
    assert dt.milli >= 0 and dt.milli <= 999
