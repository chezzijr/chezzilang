# tests/chz/stdlib/io_writer_test.chz — std.io `Writer` durability (W6-1).
#
# `flush()`/`close()` on a `buffered(create(p))` writer must make the bytes readable FROM WITHIN THE
# SAME PROGRAM, not merely at process exit (the drop-flush). W6-1: a mid-write drain (write > cap)
# emptied the in-VM buffer and left the drained bytes sitting unflushed in the inner `BufWriter`, so a
# later flush/close saw an empty buffer, returned early, and persisted NOTHING.
# Temp paths carry the pid (the suite runs concurrently with other `cargo test` / `chezzi test` runs).
# Run: `cargo run -- test tests/chz/`. Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import std.io
import std.os
import std.fs

# Write `text` through `buffered(create(p), cap)`, then flush (or close), then read the file back
# in-process. Returns the file's contents.
fn write_then_read(p: str, cap: int, text: str, use_close: bool) -> Result[str]:
    w0 := io.create(p)?
    w := io.buffered(w0, cap)
    w.write(text)?
    if use_close:
        w.close()?
    else:
        w.flush()?
    return io.read_file(p)

# A per-process scratch path: two concurrent suite runs must not truncate/delete each other's file.
fn scratch(name: str) -> str:
    return os.temp_dir().str() + "/chz_w6_1_" + name + "_" + str(os.getpid()) + ".txt"

fn check(name: str, cap: int, text: str, use_close: bool):
    p := scratch(name)
    defer fs.remove_file(p)
    match write_then_read(p, cap, text, use_close):
        Ok(s): assert s == text, name + ": expected " + text + ", got " + s
        Err(e): assert false, name + ": " + e.message()

test fn buffered_flush_persists_after_mid_write_drain():
    # 8 bytes into a cap-4 buffer ⇒ mid-write drain, then flush.
    check("flush_drain", 4, "abcdefgh", false)

test fn buffered_close_persists_after_mid_write_drain():
    check("close_drain", 4, "abcdefgh", true)

test fn buffered_never_filled_still_persists():
    # Control: the buffer never reached cap — this path always worked, it must stay green.
    check("never_filled", 4, "abc", false)

test fn buffered_exactly_at_cap_persists():
    # The boundary: len == cap drains, so the tail is in the inner core, not the in-VM buffer.
    check("at_cap", 4, "abcd", true)

test fn buffered_cap1_two_writes_persist():
    p := scratch("cap1")
    defer fs.remove_file(p)
    match write_then_read(p, 1, "ab", true):
        Ok(s): assert s == "ab", "cap1: got " + s
        Err(e): assert false, "cap1: " + e.message()

test fn nested_buffered_chain_flushes_every_level():
    # The recursion is the whole point: a `buffered(buffered(file))` chain must flush EVERY core
    # beneath the receiver, both when the outer buffer holds the tail (3 < cap 4) and after a drain.
    p := scratch("nested")
    defer fs.remove_file(p)
    match write_then_read2(p, 8, 4, "abc"):
        Ok(s): assert s == "abc", "nested (tail in the outer buf): got " + s
        Err(e): assert false, "nested: " + e.message()
    match write_then_read2(p, 8, 4, "abcdefghij"):
        Ok(s): assert s == "abcdefghij", "nested (mid-write drain): got " + s
        Err(e): assert false, "nested drain: " + e.message()

# Two-level chain: `buffered(buffered(create(p), inner_cap), outer_cap)`.
fn write_then_read2(p: str, inner_cap: int, outer_cap: int, text: str) -> Result[str]:
    w1 := io.buffered(io.create(p)?, inner_cap)
    w2 := io.buffered(w1, outer_cap)
    w2.write(text)?
    w2.flush()?
    return io.read_file(p)

test fn flush_through_a_closed_inner_is_a_clean_err_naming_the_inner():
    # A flush that provably persisted nothing must NOT report success (that is the W6-1 shape), and the
    # message must name the INNER handle — the receiver `w` is wide open, it is `w0` that is closed.
    p := scratch("closed_inner")
    defer fs.remove_file(p)
    match io.create(p):
        Ok(w0):
            w := io.buffered(w0, 8)
            _ := w.write("abc")
            _ := w0.close()
            match w.flush():
                Ok(_): assert false, "flush into a closed inner must be Err"
                Err(e): assert e.message().contains("inner writer"), e.message()
            # `close()` must not mask it either.
            match w.close():
                Ok(_): assert false, "close over a closed inner must be Err"
                Err(e): assert e.message().contains("inner writer"), e.message()
        Err(e): assert false, "create: " + e.message()

# ===== W6-9 — `write_bytes` is BYTE-EXACT and returns the input length =====
#
# The raw stdout/stderr BYTES can only be witnessed by a real child process (the `chezzi test`
# runner captures output in-process and hands it back as a Rust `String`), so those assertions live
# in `tests/interactive.rs::{stdout,stderr,buffered_stdout}_write_bytes_is_byte_exact`. What IS
# expressible here — and what pins the retype from the in-language side — is the RETURN COUNT on
# every backing plus the file arm's byte-exactness, which the console arm now matches.

test fn stdout_write_bytes_returns_the_input_length():
    match io.stdout().write_bytes(b"\xff\xfe"):
        Ok(n): assert n == 2, "stdout write_bytes returned " + str(n)
        Err(e): assert false, "stdout write_bytes: " + e.message()

test fn stderr_write_bytes_returns_the_input_length():
    match io.stderr().write_bytes(b"\xff\xfe"):
        Ok(n): assert n == 2, "stderr write_bytes returned " + str(n)
        Err(e): assert false, "stderr write_bytes: " + e.message()

test fn file_write_bytes_round_trips_non_utf8():
    # The file arm was ALREADY byte-exact; pin it so the sink retype cannot regress it.
    p := scratch("nonutf8")
    defer fs.remove_file(p)
    raw := b"\xff\xfe\x00A\x80"
    match io.create(p):
        Ok(w):
            match w.write_bytes(raw):
                Ok(n): assert n == 5, "file write_bytes returned " + str(n)
                Err(e): assert false, "file write_bytes: " + e.message()
            _ := w.close()
        Err(e): assert false, "create: " + e.message()
    match io.read_bytes(p):
        Ok(got): assert got == raw, "non-UTF-8 bytes did not round-trip"
        Err(e): assert false, "read_bytes: " + e.message()

test fn large_write_bytes_returns_the_full_count():
    # Nothing in `write_to_core` can short-write (write_all / in-memory / an unbounded queue), so the
    # count is the input length at every size — this is the only "partial write" case expressible.
    p := scratch("large")
    defer fs.remove_file(p)
    ba := bytearray()
    for i in range(200000):
        ba.push(255)
    big := bytes(ba)
    match io.create(p):
        Ok(w):
            match w.write_bytes(big):
                Ok(n): assert n == 200000, "large write_bytes returned " + str(n)
                Err(e): assert false, "large write_bytes: " + e.message()
            _ := w.close()
        Err(e): assert false, "create: " + e.message()
    match io.read_bytes(p):
        Ok(got): assert got.len() == 200000, "short file: " + str(got.len())
        Err(e): assert false, "read_bytes: " + e.message()

test fn write_that_drains_into_a_closed_inner_names_the_inner_too():
    # Sibling arm: `write_to_core`'s drain recursion carries the same wrong-handle risk.
    p := scratch("closed_inner_w")
    defer fs.remove_file(p)
    match io.create(p):
        Ok(w0):
            w := io.buffered(w0, 2)
            _ := w0.close()
            match w.write("abcd"):        # 4 > cap 2 ⇒ drains into the closed inner
                Ok(_): assert false, "a drain into a closed inner must be Err"
                Err(e): assert e.message().contains("inner writer"), e.message()
        Err(e): assert false, "create: " + e.message()
