# tests/chz/stdlib/fs_copy_test.chz — `fs.copy` same-file guard (W7-1).
#
# `std::fs::copy` opens the DESTINATION with O_TRUNC, so copying a file onto ITSELF used to return
# `Ok(nil)` after truncating the file to 0 bytes — silent data loss. Python's `shutil.copyfile`
# raises `SameFileError` and coreutils `cp a a` errors "are the same file"; both leave the file
# alone, so Chezzi returns a recoverable `Err` and the bytes must survive.
# Identity is INODE identity (dev+ino), not a path-string compare: a symlink (and a hardlink) reaches
# the same inode under a different name and truncates exactly the same way — the symlink case below
# is what pins that.
# Temp paths carry the pid (the suite runs concurrently with other `cargo test` / `chezzi test` runs)
# and are SINGLE-QUOTED into any shell line (TMPDIR may contain a space/glob).
# Run: `cargo run -- test tests/chz/`. Serial==M:N guarded by the dual-engine gate.

import std.fs
import std.io
import std.os
import std.process as pr

fn scratch(name: str) -> str:
    return os.temp_dir().str() + "/chz_w7_1_" + name + "_" + str(os.getpid()) + ".txt"

fn seed(p: str, text: str):
    match io.write_file(p, text):
        Ok(_): pass
        Err(e): assert false, "setup: " + e.message()

fn contents(p: str) -> str:
    match io.read_file(p):
        Ok(s): return s
        Err(e):
            assert false, "read: " + e.message()
            return ""

test fn copy_same_path_errs_and_preserves():
    p := scratch("same")
    defer fs.remove_file(p)
    seed(p, "important-data")
    match fs.copy(p, p):
        Ok(_): assert false, "copying a file onto itself must Err, not truncate it"
        Err(e): assert e.message().contains("same file"), e.message()
    assert contents(p) == "important-data", "the file must be byte-identical after a refused copy"

test fn copy_through_symlink_errs_and_preserves():
    # A path-string compare would MISS this: two different names, one inode.
    src := scratch("symsrc")
    link := scratch("symlink")
    defer fs.remove_file(src)
    defer fs.remove_file(link)
    seed(src, "important-data")
    match pr.run_args("ln", ["-sf", src, link]):
        Ok(_): pass
        Err(e): assert false, "setup ln: " + e.message()
    match fs.copy(link, src):
        Ok(_): assert false, "copying through a symlink to the same inode must Err"
        Err(e): assert e.message().contains("same file"), e.message()
    assert contents(src) == "important-data", "the file must be byte-identical after a refused copy"

test fn copy_distinct_files_still_works():
    a := scratch("dista")
    b := scratch("distb")
    defer fs.remove_file(a)
    defer fs.remove_file(b)
    seed(a, "payload-a")
    match fs.copy(a, b):
        Ok(_): pass
        Err(e): assert false, "a normal copy must still work: " + e.message()
    assert contents(b) == "payload-a"

test fn copy_onto_existing_different_dest_overwrites():
    a := scratch("ovra")
    b := scratch("ovrb")
    defer fs.remove_file(a)
    defer fs.remove_file(b)
    seed(a, "payload-a")
    seed(b, "stale-b")
    match fs.copy(a, b):
        Ok(_): pass
        Err(e): assert false, "overwriting a different dest must still work: " + e.message()
    assert contents(b) == "payload-a"
