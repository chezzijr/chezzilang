# tests/chz/stdlib/json_decode_value_test.chz — json.decode[T] as a value (TICKET-214).
import std.json

struct P:
    x: int
    y: int = 7

fn app2[V](f: fn(str) -> V!, v: V) -> V!:
    return f("5")

fn id[T](x: T) -> T:
    return x

test fn let_and_hof():
    d := json.decode[int]
    assert d("5") == ?5
    assert ["1", "2"].map(json.decode[int]) == [?1, ?2]
    match d("x"):
        ?_: assert false
        !_: assert true

test fn typed_let_struct_default_and_float():
    dp: fn(str) -> P! = json.decode
    match dp("{{\"x\": 1}}"):
        ?p: assert p.x == 1 and p.y == 7
        !_: assert false
    df := (json.decode[float])
    assert df("2.5") == ?2.5

test fn pinned_by_generic_callee():
    assert app2(json.decode, 3) == ?5

test fn pinned_through_a_bare_generic_slot_and_an_option():
    f: fn(str) -> int! = id(json.decode)
    assert f("5") == ?5
    o: (fn(str) -> int!)? = ?json.decode
    match o:
        ?g: assert g("6") == ?6
        None: assert false

test fn crosses_spawn():
    g := json.decode[int]
    ch := Channel[int](1)
    parallel:
        spawn:
            ch.send(g("4") ?? 0)
    assert ch.recv() == 4
