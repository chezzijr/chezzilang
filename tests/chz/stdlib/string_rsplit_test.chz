# tests/chz/stdlib/string_rsplit_test.chz — `std.string.rsplit` matches from the RIGHT, so a
# separator that overlaps itself splits at the right end (bug-hunt wave 16: it used to split from
# the left and regroup, giving ['', 'a'] for rsplit("aaa", "aa")). Every expectation is the
# CPython 3.14.7 `str.rsplit` value.
#
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
import std.string

test fn overlapping_separator_matches_at_the_right_end():
    assert string.rsplit("aaa", "aa") == ["a", ""]
    assert string.rsplit("aaa", "aa", 1) == ["a", ""]
    assert string.rsplit("aaaa", "aa") == ["", "", ""]
    assert string.rsplit("aaaaa", "aa") == ["a", "", ""]
    assert string.rsplit("aaaaa", "aa", 1) == ["aaa", ""]
    assert string.rsplit("xaaay", "aa") == ["xa", "y"]

test fn ordinary_separators_and_maxsplit():
    assert string.rsplit("a,b,c", ",") == ["a", "b", "c"]
    assert string.rsplit("a,b,c", ",", 1) == ["a,b", "c"]
    assert string.rsplit("a,b,c", ",", 0) == ["a,b,c"]
    assert string.rsplit(",a,", ",") == ["", "a", ""]
    assert string.rsplit("abc", "x") == ["abc"]
    assert string.rsplit("", "x") == [""]

test fn non_ascii_text_and_separator():
    assert string.rsplit("日本日本日", "日本", 1) == ["日本", "日"]
    assert string.rsplit("é-é-é", "-", 1) == ["é-é", "é"]

test fn empty_separator_faults():
    r := recover: string.rsplit("abc", "")
    match r:
        Ok(_): assert false
        Err(e): assert e.message().contains("rsplit: sep must not be empty")
