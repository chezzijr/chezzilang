# tests/chz/stdlib/executor_drain_test.chz — `Executor.shutdown` drain semantics (W7-5).
#
# Contract (TICKET-208): `shutdown` waits for EVERY submitted job and raises no job fault. A HANDLE
# job's fault is its handle's `Err` and costs its own result, never a sibling's work. A
# fire-and-forget job's fault ends the whole run, so it has no test here (see
# `tests/executor_task_grid.rs`). Early-stop is opt-in via a `std.cancel.Token`, not a drain mode.
#
# These assert on an `AtomicInt` accumulator read AFTER the drain returns, never on inter-task print
# order (N9 / nondeterministic cross-task ordering). Gated by
# `chz_suite_passes` (`tests/chz_suite.rs`).
# Run: `cargo run -- test tests/chz/stdlib/executor_drain_test.chz`

import std.concurrency
import std.cancel
import submit_task from std.concurrency.task

fn bump(c: AtomicInt, by: int):
    c.add(by)

fn blow_up_int() -> int:
    panic("boom")

fn blow_up_late_int() -> int:
    panic("late boom")

fn err_of(r: Result[int]) -> str:
    match r:
        Ok(_): return "no fault"
        Err(e): return e.message()

fn guarded_bump(tok: cancel.Token, c: AtomicInt):
    if tok.cancelled():
        return
    c.add(1)

# A HANDLE job's fault is its handle's `Err`: `shutdown()` raises nothing, and no sibling is cut.
test fn every_job_runs_despite_a_handle_job_fault():
    ex := Executor()
    c := AtomicInt(0)
    t := submit_task(ex, blow_up_int)
    ex.submit(fn(): bump(c, 1))
    ex.submit(fn(): bump(c, 10))
    ex.submit(fn(): bump(c, 100))
    ex.shutdown()
    assert err_of(t.get()).contains("boom"), err_of(t.get())
    assert c.load() == 111, "every non-faulting job must run, got " + str(c.load())

test fn each_handle_carries_its_own_fault():
    ex := Executor()
    a := submit_task(ex, blow_up_int)
    b := submit_task(ex, blow_up_late_int)
    ex.shutdown()
    assert err_of(a.get()).contains("boom"), err_of(a.get())
    assert not err_of(a.get()).contains("late"), err_of(a.get())
    assert err_of(b.get()).contains("late boom"), err_of(b.get())

test fn a_later_jobs_result_survives_an_earlier_handle_fault():
    ex := Executor()
    t := submit_task(ex, blow_up_int)
    ch := ex.submit_result(fn() -> int: 7)
    ex.shutdown()
    assert err_of(t.get()).contains("boom"), err_of(t.get())
    assert (ch.recv() ?? 0) == 7, "the surviving result must be the job's real value"

test fn a_second_shutdown_after_a_handle_fault_is_a_no_op():
    ex := Executor()
    c := AtomicInt(0)
    t := submit_task(ex, blow_up_int)
    ex.submit(fn(): bump(c, 1))
    ex.shutdown()
    ex.shutdown()
    assert err_of(t.get()).contains("boom"), err_of(t.get())
    assert c.load() == 1, "the second shutdown must not re-run anything, got " + str(c.load())

test fn a_pre_cancelled_token_stops_the_jobs():
    # The abort-siblings behaviour is not gone, it moved into the caller's hands. Cancel the token on
    # the main task BEFORE submitting/shutting down the queued jobs — no cancelling job is queued, so
    # there is nothing to race: `guarded_bump` observes an already-cancelled token deterministically,
    # unlike submitting `tok.cancel()` as job 0 and racing jobs 1/2 against it (M:N farms
    # `ready[1..]` to the pool before running `ready[0]` inline, so a hot pool thread can win that race).
    ex := Executor()
    tok := cancel.manual()
    tok.cancel()
    c := AtomicInt(0)
    ex.submit(fn(): guarded_bump(tok, c))
    ex.submit(fn(): guarded_bump(tok, c))
    ex.shutdown()
    assert c.load() == 0, "a cancelled token must stop the later jobs, got " + str(c.load())

# A JOIN NEVER WAITS FOR ITSELF. A job that shuts down the executor it is running under is itself one
# of that executor's outstanding jobs, so a join over "outstanding == 0" waits for an event the waiting
# thread is the only obstacle to. That made the joiner's blocked-party entry permanently unsatisfiable,
# and with `main` parked in its own `shutdown()` every party in the run was such a join — so the
# process-wide verdict declared a program whose every job had ALREADY RUN to be deadlocked. Measured on
# the pre-fix debug binary: 8/8 runs faulted for the graceful `shutdown()` below, and 8/60 for
# `shutdown_now()` (the rest escaped only because `shutdown_now` trips the cancel flag, which the joiner
# usually noticed before `main`'s 5 ms poll reached the verdict — a coin flip, not a verdict).
#
# Reference, CPython 3.14.6, measured: `shutdown(wait=True)` from inside its own worker raises
# `RuntimeError: cannot join current thread` and `shutdown(wait=False, cancel_futures=True)` returns in
# 0.000 s — the self-join is refused or skipped, and in neither case is the RUN declared dead. Chezzi
# joins over a COUNT rather than over thread handles, so it can do better than refuse: it waits for
# everything the executor owes EXCEPT this job.
#
# The self-shutdown job is submitted LAST on purpose: it marks the executor `shut`, so a submit racing
# behind it would be rejected with "submit on a shut-down Executor" (CPython raises there too).
test fn a_job_may_gracefully_shut_down_its_own_executor():
    ex := Executor()
    c := AtomicInt(0)
    ex.submit(fn(): bump(c, 1))
    ex.submit(fn(): bump(c, 10))
    ex.submit(fn(): ex.shutdown())
    ex.shutdown()
    # A graceful shutdown trips no cancel, so the siblings the self-join waits for all run.
    assert c.load() == 11, "a self-joining job must wait for its siblings, not report a deadlock; got " + str(c.load())

test fn a_job_may_shutdown_now_its_own_executor():
    # The reentrant-cancel half of the same seam. No accumulator assertion: `shutdown_now` trips the
    # per-core cancel flag, so whether a sibling reaches its next checkpoint first is genuinely
    # nondeterministic. What must be deterministic is that nobody calls this run dead.
    ex := Executor()
    ex.submit(fn(): ex.shutdown_now())
    r := recover: ex.shutdown()
    match r:
        Ok(_): pass
        Err(e): assert false, "a job that shuts down its own executor must not fault: " + e.message()

test fn an_uncancelled_token_is_a_no_op():
    ex := Executor()
    tok := cancel.manual()
    c := AtomicInt(0)
    ex.submit(fn(): guarded_bump(tok, c))
    ex.submit(fn(): guarded_bump(tok, c))
    ex.shutdown()
    assert c.load() == 2, "no cancel means every job runs, got " + str(c.load())
