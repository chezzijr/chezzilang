# tests/chz/stdlib/executor_dropped_task_fault_test.chz — TICKET-289.
#
# A job's fault appears ONLY in its Task's `t.get()`. A Task the program drops (`ex.submit(f)` as an
# expression statement) keeps its fault there too: `ex.shutdown()` raises nothing, so a `recover:`
# around it finds `?_`. The fault no longer ends the run and no `recover:` has to catch it.
# (The test keeps its first name, a stale reading of the earlier contract.)

import std.concurrency

fn bad():
    panic("boom")

test fn a_dropped_jobs_fault_is_caught_by_recover_around_shutdown():
    ex := concurrency.Executor()
    ex.submit(bad)
    res := recover: ex.shutdown()
    match res:
        ?_: pass
        !e: assert false, "shutdown() raised a job fault: {e.message()}"
