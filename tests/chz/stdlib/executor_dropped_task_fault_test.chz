# tests/chz/stdlib/executor_dropped_task_fault_test.chz — TICKET-289.
#
# A job whose Task the program drops (`ex.submit(f)` as an expression statement) is fire-and-forget:
# its fault is raised by `ex.shutdown()`, so a `recover:` around the `shutdown()` catches it, like a
# nursery child's fault caught by a `recover:` around `parallel:`. On base the fault ends the run
# at once and the `recover:` never sees it.

import std.concurrency

fn bad():
    panic("boom")

test fn a_dropped_jobs_fault_is_caught_by_recover_around_shutdown():
    ex := concurrency.Executor()
    ex.submit(bad)
    res := recover: ex.shutdown()
    match res:
        ?_: assert false, "shutdown() must raise the dropped job's fault"
        !e: assert e.message().contains("boom"), e.message()
