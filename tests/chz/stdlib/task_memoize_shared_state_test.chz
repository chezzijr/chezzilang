# tests/chz/stdlib/task_memoize_shared_state_test.chz — TICKET-191.
#
# Every copy of a `Task` handle reads one shared core, so `get()`/`done()` give CPython's
# `Future.result()`/`done()` answer from any caller. Grid: caller {parent, spawned task, Executor
# job, two tasks at once} x state {pending, done ok, done faulted}, plus a mutable-result row per
# caller: the task holding the original handle gets the same object back from every `get()`; a task
# holding an airlock copy gets the value as of the crossing, and its write to that value faults (D4).
# A faulted job's first observer may be a copy (its `get()` latches the fault into the core), and
# `done()` runs from a spawned task and an Executor job in every state.
# The `memoize` half (A3) moved to TICKET-192, which owns an O(1) shared cache.

import std.concurrency
import submit_task, Task from std.concurrency.task

# A handle carries a `T!E`; these tests read a job that did not fault.
fn must[T](r: T!) -> T:
    match r:
        ?v: return v
        !e: panic(e.message())

fn forty_two() -> int:
    return 42

fn gated(gate: Channel[int]) -> int:
    return gate.recv() + 41

fn boom() -> int:
    panic("boom")
    return 0

fn mk_list() -> List[int]:
    return [1, 2]

fn gated_boom(gate: Channel[int]) -> int:
    if gate.recv() > 0:
        panic("boom")
    return 0

fn show(t: Task[int]) -> str:
    r := recover: must(t.get())
    match r:
        ?v: return str(v)
        !e: return e.message()

fn child_show(t: Task[int], out: Channel[str]):
    out.send(show(t))

fn child_done3(p: Task[int], ok: Task[int], bad: Task[int], out: Channel[str]):
    out.send("{p.done()} {ok.done()} {bad.done()}")

fn _child_get(t: Task[int], ch: Channel[str]):
    r := recover: must(t.get())
    match r:
        ?v: ch.send(str(v))
        !e: ch.send(e.message())

fn child_mutate(t: Task[List[int]], out: Channel[str]):
    r := recover: _mutate_then_get(t)
    match r:
        ?s: out.send(s)
        !e: out.send(e.message())

fn _mutate_then_get(t: Task[List[int]]) -> str:
    a := must(t.get())
    r := recover: a.push(9)
    match r:
        ?_: return "push ok {must(t.get())}"
        !e: return "{must(t.get())} {e.message()}"

test fn task_get_in_spawned_task_then_parent_get_sees_same_result():
    ex := Executor()
    t := submit_task(ex, forty_two)
    ex.shutdown()
    ch := Channel[str](1)
    parallel:
        spawn _child_get(t, ch)
    child := ch.recv()
    assert child == "42", child
    r := recover: must(t.get())
    match r:
        ?v: assert v == 42, "parent get() after child get()"
        !e: assert false, e.message()

test fn task_pending_parent_get_waits():
    ex := Executor()
    gate := Channel[int](1)
    t := submit_task(ex, fn() -> int: gated(gate))
    assert not t.done()
    gate.send(1)
    assert show(t) == "42"
    assert t.done()
    ex.shutdown()

test fn task_pending_spawned_and_two_at_once():
    ex := Executor()
    gate := Channel[int](1)
    t := submit_task(ex, fn() -> int: gated(gate))
    out := Channel[str](2)
    parallel:
        spawn child_show(t, out)
        spawn child_show(t, out)
        gate.send(1)
    assert out.recv() == "42"
    assert out.recv() == "42"
    assert show(t) == "42"
    assert t.done()
    ex.shutdown()

test fn task_pending_executor_job_caller():
    ex := Executor()
    gate := Channel[int](1)
    t := submit_task(ex, fn() -> int: gated(gate))
    ex2 := Executor()
    t2 := submit_task(ex2, fn() -> int: must(t.get()) + 1)
    gate.send(1)
    ex.shutdown()
    ex2.shutdown()
    assert show(t2) == "43"
    assert show(t) == "42"

test fn task_done_ok_every_caller():
    ex := Executor()
    t := submit_task(ex, fn() -> int: 42)
    ex.shutdown()
    assert t.done()
    out := Channel[str](3)
    parallel:
        spawn child_show(t, out)
        spawn child_show(t, out)
    ex2 := Executor()
    ex2.submit(fn(): child_show(t, out))
    ex2.shutdown()
    assert out.recv() == "42"
    assert out.recv() == "42"
    assert out.recv() == "42"
    assert show(t) == "42"

test fn task_done_faulted_every_caller():
    ex := Executor()
    t := submit_task(ex, boom)
    ex.shutdown()
    assert t.done()
    out := Channel[str](3)
    parallel:
        spawn child_show(t, out)
        spawn child_show(t, out)
    ex2 := Executor()
    ex2.submit(fn(): child_show(t, out))
    ex2.shutdown()
    assert out.recv() == "boom"
    assert out.recv() == "boom"
    assert out.recv() == "boom"
    assert show(t) == "boom"
    assert t.done()

test fn task_mutable_result_parent_get_returns_the_same_object():
    ex := Executor()
    t := submit_task(ex, mk_list)
    ex.shutdown()
    a := must(t.get())
    a.push(3)
    assert str(must(t.get())) == "[1, 2, 3]", str(must(t.get()))
    b := must(t.get())
    b.push(4)
    assert str(a) == "[1, 2, 3, 4]", str(a)

test fn task_mutable_result_spawned_copy_sees_the_value_as_of_the_crossing():
    ex := Executor()
    t := submit_task(ex, mk_list)
    ex.shutdown()
    a := must(t.get())
    a.push(3)
    out := Channel[str](1)
    parallel:
        spawn child_mutate(t, out)
    got := out.recv()
    assert got == "[1, 2, 3] this value is this task's copy: a write to it would be lost at the join; share it through Shared/Channel, or make a task-local copy with .copy()", got
    assert str(must(t.get())) == "[1, 2, 3]", str(must(t.get()))

test fn task_mutable_result_executor_job_copy_sees_the_value_as_of_the_crossing():
    ex := Executor()
    t := submit_task(ex, mk_list)
    ex.shutdown()
    a := must(t.get())
    a.push(3)
    out := Channel[str](1)
    ex2 := Executor()
    ex2.submit(fn(): child_mutate(t, out))
    ex2.shutdown()
    got := out.recv()
    assert got == "[1, 2, 3] this value is this task's copy: a write to it would be lost at the join; share it through Shared/Channel, or make a task-local copy with .copy()", got
    assert str(must(t.get())) == "[1, 2, 3]", str(must(t.get()))

test fn task_faulted_first_observer_is_a_spawned_task():
    ex := Executor()
    t := submit_task(ex, boom)
    ex.shutdown()
    out := Channel[str](1)
    parallel:
        spawn child_show(t, out)
    got := out.recv()
    assert got == "boom", got
    assert show(t) == "boom", show(t)
    assert t.done()

test fn task_faulted_first_observer_is_an_executor_job():
    ex := Executor()
    t := submit_task(ex, boom)
    ex.shutdown()
    out := Channel[str](1)
    ex2 := Executor()
    ex2.submit(fn(): child_show(t, out))
    ex2.shutdown()
    got := out.recv()
    assert got == "boom", got
    assert show(t) == "boom", show(t)
    assert t.done()

test fn task_faulted_first_observers_are_two_tasks_at_once():
    ex := Executor()
    t := submit_task(ex, boom)
    ex.shutdown()
    out := Channel[str](2)
    parallel:
        spawn child_show(t, out)
        spawn child_show(t, out)
    a := out.recv()
    b := out.recv()
    assert a == "boom", a
    assert b == "boom", b
    assert show(t) == "boom", show(t)
    assert t.done()

test fn task_pending_then_faulted_spawned_waiter_sees_the_fault():
    ex := Executor()
    gate := Channel[int](1)
    t := submit_task(ex, fn() -> int: gated_boom(gate))
    out := Channel[str](1)
    parallel:
        spawn child_show(t, out)
        gate.send(1)
    got := out.recv()
    assert got == "boom", got
    ex.shutdown()
    assert show(t) == "boom", show(t)
    assert t.done()

test fn task_done_from_a_spawned_task_in_every_state():
    ex_ok := Executor()
    ok := submit_task(ex_ok, forty_two)
    ex_ok.shutdown()
    ex_bad := Executor()
    bad := submit_task(ex_bad, boom)
    ex_bad.shutdown()
    ex_p := Executor()
    gate := Channel[int](1)
    p := submit_task(ex_p, fn() -> int: gated(gate))
    out := Channel[str](1)
    parallel:
        spawn child_done3(p, ok, bad, out)
    got := out.recv()
    assert got == "false true true", got
    gate.send(1)
    ex_p.shutdown()
    assert show(p) == "42", show(p)
    assert show(ok) == "42", show(ok)
    assert show(bad) == "boom", show(bad)

test fn task_done_from_an_executor_job_in_every_state():
    ex_ok := Executor()
    ok := submit_task(ex_ok, forty_two)
    ex_ok.shutdown()
    ex_bad := Executor()
    bad := submit_task(ex_bad, boom)
    ex_bad.shutdown()
    ex_p := Executor()
    gate := Channel[int](1)
    p := submit_task(ex_p, fn() -> int: gated(gate))
    out := Channel[str](1)
    ex2 := Executor()
    ex2.submit(fn(): child_done3(p, ok, bad, out))
    ex2.shutdown()
    got := out.recv()
    assert got == "false true true", got
    gate.send(1)
    ex_p.shutdown()
    assert show(p) == "42", show(p)
    assert show(ok) == "42", show(ok)
    assert show(bad) == "boom", show(bad)
