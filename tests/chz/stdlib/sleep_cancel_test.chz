# tests/chz/stdlib/sleep_cancel_test.chz — W7-16: a wait whose DEADLINE WE OWN is a *continuous*
# cancellation checkpoint, not merely an entry one.
#
# Contract (`docs/concurrency.md` §cancellation points): `time.sleep_ms` and a `time.timer(ms)`
# channel's `recv` observe a cancel for the whole duration of the wait — in a `parallel:` nursery, in
# an eager `Executor` job, and on the top-level `main` thread — and the cancelled task still unwinds
# through its `defer`s. A genuinely syscall-blocking native (`fs.*`, `request*`, `process*`, `io.*`)
# stays an ENTRY-only checkpoint; that is a different contract and is not tested here. The `--timeout`
# half rides the same checkpoint but is not testable from Chezzi (it is a `chezzi test` flag) — it is
# fenced in `test_runner::timeout_aborts_a_sleeping_test_on_every_block_in_place_path`, whose
# doc-comment names the one shape it does NOT reach (`gaps.md` W7-17).
#
# Pre-fix, `shutdown_now()` at 50 ms against a `sleep_ms(3000)` waited the full 3005 ms on M:N AND ran
# the job's post-sleep code. Both forms below are deterministically red on the pre-fix binary.
#
# These assert on an `AtomicInt` read after the reap plus a wall-clock bound with 3× headroom, never
# on inter-task print order. Gated serial==M:N by `test_runner::chz_suite_passes` (serial
# reaches the same verdict by a different route: its drain never starts a `shutdown_now`-ed job).
# Run: `cargo run -- test tests/chz/stdlib/sleep_cancel_test.chz`

import std.time
import std.concurrency

woke := AtomicInt(0)

fn napper():
    time.sleep_ms(3000)
    woke.add(1)

fn short_nap():
    time.sleep_ms(200)

fn timer_napper():
    t := time.timer(3000)
    _ := t.recv()
    woke.add(1)

test fn shutdown_now_interrupts_a_sleeping_job():
    woke.store(0)
    t0 := time.monotonic()
    ex := Executor()
    ex.submit(napper)
    time.sleep_ms(50)
    ex.shutdown_now()
    d := time.monotonic() - t0
    assert d < 1.0, "a sleeping job must die at the cancel, not at its deadline: " + str(d) + "s"
    assert woke.load() == 0, "the cancelled job must not run its post-sleep code"

test fn shutdown_now_interrupts_a_job_waiting_on_a_timer():
    woke.store(0)
    t0 := time.monotonic()
    ex := Executor()
    ex.submit(timer_napper)
    time.sleep_ms(50)
    ex.shutdown_now()
    d := time.monotonic() - t0
    assert d < 1.0, "a timer-waiting job must die at the cancel, not at its deadline: " + str(d) + "s"
    assert woke.load() == 0, "the cancelled job must not run its post-timer code"

test fn a_sleep_still_sleeps():
    # The fence against the chunked wait ending EARLY — the failure mode the fix could introduce, and
    # the one no cancellation test can see. Inside a nursery, so it rides the M:N offload path (which
    # now re-arms its timer every 5 ms and must still land on the absolute deadline).
    t0 := time.monotonic()
    parallel:
        spawn short_nap()
    d := time.monotonic() - t0
    assert d >= 0.195, "a sleep must still reach its deadline: " + str(d) + "s"
