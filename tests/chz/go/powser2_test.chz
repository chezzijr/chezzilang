# Port of Go 1.27.0 test/chan/powser2.go. Copyright 2009 The Go Authors. BSD-style license: NOTICE.
# Test concurrency primitives: power series.

# Like powser1.go but uses channels of interfaces.
# Has not been cleaned up as much as powser1.go, to keep
# it distinct and therefore a different test.

# Power series package
# A power series is a channel, along which flow rational
# coefficients.  A denominator of zero signifies the end.
# Original code in Newsqueak by Doug McIlroy.
# See Squinting at Power Series by Doug McIlroy,
#   https://swtch.com/~rsc/thread/squint.pdf

# Go: import "os" (for the print mode, which this port drops; see main_).
import Executor from std.concurrency

# Go's power-series constructors return a channel fed by a goroutine that outlives the call, and
# Go leaks every goroutine still running when main returns. A spawn here joins at its fn's return,
# so each Go `go` is a job of this module-level Executor, and main_ cancels it as its last line.
ex := Executor()

# Every Go read of an item is downcast back to *rat (`.(*rat)`), and a checked downcast is deferred
# here (docs/reference/spec/05-conversions.md), so each channel and slice of item carries Rat; Item
# is the protocol Rat satisfies, and the type of eq's argument.
protocol Item:  # Go: type item interface
    fn pr(self) -> str  # Go: pr()
    fn eq(self, other: Item) -> bool  # Go: eq(c item) bool

struct Rat:  # Go: type rat struct
    num: int  # numerator  Go: num, den int64
    den: int  # denominator

    # Go: func (u *rat) pr() prints; this returns the text, for the check message.
    fn pr(self) -> str:
        if self.den == 1:
            return "{self.num} "  # Go: print(u.num)
        return "{self.num}/{self.den} "  # Go: print(u.num, "/", u.den)

    # The param is `other`, not Go's `c`, as in powser1. Go downcasts the item to read its fields;
    # without a downcast this compares the printed forms, which are equal exactly when num and den
    # are (pr prints `num ` only for den 1, else `num/den `).
    fn eq(self, other: Item) -> bool:  # Go: func (u *rat) eq(c item) bool
        # Go: c1 := c.(*rat); return u.num == c1.num && u.den == c1.den
        return self.pr() == other.pr()

struct Dch:  # Go: type dch struct
    req: Channel[int]
    dat: Channel[Rat]  # Go: dat chan item
    nam: int

# Go: type dch2 [2]*dch; a list of two Dch, shared by handle like Go's pointer.

chnames := ""
chnameserial := 0
seqno := 0

fn mkdch() -> Dch:
    c := chnameserial % chnames.len()
    chnameserial += 1
    return Dch(Channel[int](0), Channel[Rat](0), c)  # Go: d.dat = make(chan item)

fn mkdch2() -> List[Dch]:  # Go: func mkdch2() *dch2
    return [mkdch(), mkdch()]

# split reads a single demand channel and replicates its
# output onto two, which may be read at different rates.
# A process is created at first demand for an item and dies
# after the item has been sent to both outputs.

# When multiple generations of split exist, the newest
# will service requests on one channel, which is
# always renamed to be out[0]; the oldest will service
# requests on the other channel, out[1].  All generations but the
# newest hold queued data that has already been sent to
# out[0].  When data has finally been sent to out[1],
# a signal on the release-wait channel tells the next newer
# generation to begin servicing out[1].

fn dosplit(inp: Dch, out: List[Dch], wt: Channel[int]):  # Go: func dosplit(in *dch, out *dch2, wait chan int)
    both := false  # do not service both channels

    wait:
        _ := out[0].req.recv(): pass  # Go: case <-out[0].req:
        _ := wt.recv():  # Go: case <-wait:
            both = true
            wait:
                _ := out[0].req.recv(): pass  # Go: case <-out[0].req:
                _ := out[1].req.recv():  # Go: case <-out[1].req:
                    out[0], out[1] = out[1], out[0]

    seqno += 1
    inp.req.send(seqno)
    release := Channel[int](0)
    _ := ex.submit(fn(): dosplit(inp, out, release))  # Go: go dosplit(in, out, release)
    dat := inp.dat.recv() else: panic("inp.dat closed")
    out[0].dat.send(dat)
    if not both:
        _ := wt.recv()
    _ := out[1].req.recv()
    out[1].dat.send(dat)
    release.send(0)

fn split(inp: Dch, out: List[Dch]):
    release := Channel[int](0)
    _ := ex.submit(fn(): dosplit(inp, out, release))  # Go: go dosplit(in, out, release)
    release.send(0)

fn put(dat: Rat, out: Dch):  # Go: func put(dat item, out *dch)
    _ := out.req.recv()
    out.dat.send(dat)

fn get(inp: Dch) -> Rat:  # Go: func get(in *dch) *rat
    seqno += 1
    inp.req.send(seqno)
    r := inp.dat.recv() else: panic("inp.dat closed")  # Go: return (<-in.dat).(*rat)
    return r

# Go: a nil channel. A None channel's arm is switched off by its guard, so these never run.
fn nil_req() -> Channel[int]:
    assert false, "an off arm evaluated its channel"
    return Channel[int](0)

fn nil_dat() -> Channel[Rat]:
    assert false, "an off arm evaluated its channel"
    return Channel[Rat](0)

# Get one item from each of n demand channels

fn getn(inp: List[Dch]) -> List[Rat]:  # Go: func getn(in []*dch) []item
    n := inp.len()
    assert n == 2, "bad n in getn"  # Go: if n != 2 { panic("bad n in getn") }
    req: List[Channel[int]?] = [None, None]  # Go: req := make([]chan int, 2)
    dat: List[Channel[Rat]?] = [None, None]  # Go: dat := make([]chan item, 2)
    out := [Rat(0, 0), Rat(0, 0)]  # Go: out := make([]item, 2)
    for i in 0..n:  # Go: for i = 0; i < n; i++ {
        req[i] = inp[i].req
        dat[i] = None  # Go: dat[i] = nil
    n = 2 * n
    while n > 0:  # Go: for n = 2 * n; n > 0; n-- {
        seqno += 1

        wait:
            (req[0] ?? nil_req()).send(seqno) if req[0] != None:  # Go: case req[0] <- seqno:
                dat[0] = inp[0].dat
                req[0] = None  # Go: req[0] = nil
            (req[1] ?? nil_req()).send(seqno) if req[1] != None:  # Go: case req[1] <- seqno:
                dat[1] = inp[1].dat
                req[1] = None  # Go: req[1] = nil
            r := (dat[0] ?? nil_dat()).recv() if dat[0] != None:  # Go: case it = <-dat[0]:
                it := r else: panic("dat[0] closed")
                out[0] = it
                dat[0] = None  # Go: dat[0] = nil
            r := (dat[1] ?? nil_dat()).recv() if dat[1] != None:  # Go: case it = <-dat[1]:
                it := r else: panic("dat[1] closed")
                out[1] = it
                dat[1] = None  # Go: dat[1] = nil
        n -= 1
    return out

# Get one item from each of 2 demand channels

fn get2(in0: Dch, in1: Dch) -> List[Rat]:  # Go: []item
    return getn([in0, in1])

fn copy(inp: Dch, out: Dch):
    while true:  # Go: for {
        _ := out.req.recv()
        out.dat.send(get(inp))

fn repeat(dat: Rat, out: Dch):  # Go: func repeat(dat item, out *dch)
    while true:  # Go: for {
        put(dat, out)

# Go: type PS *dch (power series); type PS2 *[2]PS (pair of power series). Dch and List[Dch] here.

Ones := Dch(Channel[int](0), Channel[Rat](0), 0)  # Go: var Ones PS (nil until Init)
Twos := Dch(Channel[int](0), Channel[Rat](0), 0)  # Go: var Twos PS

fn mkPS() -> Dch:
    return mkdch()

fn mkPS2() -> List[Dch]:
    return mkdch2()

# Conventions
# Upper-case for power series.
# Lower-case for rationals.
# Input variables: U,V,...
# Output variables: ...,Y,Z

# Integer gcd; needed for rational arithmetic

fn gcd(u: int, v: int) -> int:
    if u < 0:
        return gcd(-u, v)
    if u == 0:
        return v
    return gcd(v % u, u)

# Make a rational from two ints and from one int

fn i2tor(u: int, v: int) -> Rat:
    g := gcd(u, v)
    r := Rat(0, 0)  # Go: r := new(rat)
    if v > 0:
        r.num = u / g
        r.den = v / g
    else:
        r.num = -u / g
        r.den = -v / g
    return r

fn itor(u: int) -> Rat:
    return i2tor(u, 1)

zero := Rat(0, 0)  # Go: var zero *rat
one := Rat(0, 0)  # Go: var one *rat

# End mark and end test

finis := Rat(0, 0)  # Go: var finis *rat

fn end(u: Rat) -> int:
    if u.den == 0:
        return 1
    return 0

# Operations on rationals

fn add(u: Rat, v: Rat) -> Rat:
    g := gcd(u.den, v.den)
    return i2tor(u.num * (v.den / g) + v.num * (u.den / g), u.den * (v.den / g))

fn mul(u: Rat, v: Rat) -> Rat:
    g1 := gcd(u.num, v.den)
    g2 := gcd(u.den, v.num)
    r := Rat(0, 0)  # Go: r := new(rat)
    r.num = (u.num / g1) * (v.num / g2)
    r.den = (u.den / g2) * (v.den / g1)
    return r

fn neg(u: Rat) -> Rat:
    return i2tor(-u.num, u.den)

fn sub(u: Rat, v: Rat) -> Rat:
    return add(u, neg(v))

fn inv(u: Rat) -> Rat:  # invert a rat
    assert u.num != 0, "zero divide in inv"  # Go: if u.num == 0 { panic("zero divide in inv") }
    return i2tor(u.den, u.num)

# print eval in floating point of PS at x=c to n terms
fn Evaln(c: Rat, U: Dch, n: int):
    xn := 1.0  # Go: xn := float64(1)
    x := c.num.to_float() / c.den.to_float()  # Go: float64(c.num) / float64(c.den)
    val := 0.0  # Go: val := float64(0)
    for _i in 0..n:
        u := get(U)
        if end(u) != 0:
            break
        val = val + x * u.num.to_float() / u.den.to_float()
        xn = xn * x
    print(val)  # Go: print(val, "\n")

# Print n terms of a power series
fn Printn(U: Dch, n0: int):
    n := n0
    done := false
    while not done and n > 0:  # Go: for ; !done && n > 0; n-- {
        u := get(U)
        if end(u) != 0:
            done = true
        else:
            print(u.pr())  # Go: u.pr()
        n -= 1
    print("")  # Go: print(("\n"))

fn Print(U: Dch):
    Printn(U, 1000000000)

# Evaluate n terms of power series U at x=c
fn eval(c: Rat, U: Dch, n: int) -> Rat:
    if n == 0:
        return zero
    y := get(U)
    if end(y) != 0:
        return zero
    return add(y, mul(c, eval(c, U, n - 1)))

# Power-series constructors return channels on which power
# series flow.  They start an encapsulated generator that
# puts the terms of the series on the channel.

# Make a pair of power series identical to a given power series

fn Split(U: Dch) -> List[Dch]:
    UU := mkdch2()
    _ := ex.submit(fn(): split(U, UU))  # Go: go split(U, UU)
    return UU

# Add two power series
fn Add(U: Dch, V: Dch) -> Dch:
    Z := mkPS()
    fn body(U: Dch, V: Dch, Z: Dch):  # Go: go func(U, V, Z PS) {
        while true:  # Go: for {
            _ := Z.req.recv()
            uv := get2(U, V)
            match end(uv[0]) + 2 * end(uv[1]):  # Go: switch end(uv[0].(*rat)) + 2*end(uv[1].(*rat)) {
                0: Z.dat.send(add(uv[0], uv[1]))  # Go: add(uv[0].(*rat), uv[1].(*rat))
                1:
                    Z.dat.send(uv[1])
                    copy(V, Z)
                2:
                    Z.dat.send(uv[0])
                    copy(U, Z)
                3: Z.dat.send(finis)
                _: pass  # Go: a switch with no default
    _ := ex.submit(fn(): body(U, V, Z))  # Go: }(U, V, Z)
    return Z

# Multiply a power series by a constant
fn Cmul(c: Rat, U: Dch) -> Dch:
    Z := mkPS()
    fn body(c: Rat, U: Dch, Z: Dch):  # Go: go func(c *rat, U, Z PS) {
        done := false
        while not done:
            _ := Z.req.recv()
            u := get(U)
            if end(u) != 0:
                done = true
            else:
                Z.dat.send(mul(c, u))
        Z.dat.send(finis)
    _ := ex.submit(fn(): body(c, U, Z))  # Go: }(c, U, Z)
    return Z

# Subtract

fn Sub(U: Dch, V: Dch) -> Dch:
    return Add(U, Cmul(neg(one), V))

# Multiply a power series by the monomial x^n

fn Monmul(U: Dch, n0: int) -> Dch:
    Z := mkPS()
    fn body(n0: int, U: Dch, Z: Dch):  # Go: go func(n int, U PS, Z PS) {
        n := n0
        while n > 0:  # Go: for ; n > 0; n-- {
            put(zero, Z)
            n -= 1
        copy(U, Z)
    _ := ex.submit(fn(): body(n0, U, Z))  # Go: }(n, U, Z)
    return Z

# Multiply by x

fn Xmul(U: Dch) -> Dch:
    return Monmul(U, 1)

fn Rep(c: Rat) -> Dch:
    Z := mkPS()
    _ := ex.submit(fn(): repeat(c, Z))  # Go: go repeat(c, Z)
    return Z

# Monomial c*x^n

fn Mon(c: Rat, n0: int) -> Dch:
    Z := mkPS()
    fn body(c: Rat, n0: int, Z: Dch):  # Go: go func(c *rat, n int, Z PS) {
        n := n0
        if c.num != 0:
            while n > 0:  # Go: for ; n > 0; n = n - 1 {
                put(zero, Z)
                n = n - 1
            put(c, Z)
        put(finis, Z)
    _ := ex.submit(fn(): body(c, n0, Z))  # Go: }(c, n, Z)
    return Z

fn Shift(c: Rat, U: Dch) -> Dch:
    Z := mkPS()
    fn body(c: Rat, U: Dch, Z: Dch):  # Go: go func(c *rat, U, Z PS) {
        put(c, Z)
        copy(U, Z)
    _ := ex.submit(fn(): body(c, U, Z))  # Go: }(c, U, Z)
    return Z

# simple pole at 1: 1/(1-x) = 1 1 1 1 1 ...

# Convert array of coefficients, constant term first
# to a (finite) power series

# Go: func Poly(a [] *rat) PS is commented out in the source (pre-Go syntax); not ported.

# Multiply. The algorithm is
# 	let U = u + x*UU
# 	let V = v + x*VV
# 	then UV = u*v + x*(u*VV+v*UU) + x*x*UU*VV

fn Mul(U: Dch, V: Dch) -> Dch:
    Z := mkPS()
    fn body(U: Dch, V: Dch, Z: Dch):  # Go: go func(U, V, Z PS) {
        _ := Z.req.recv()
        uv := get2(U, V)
        if end(uv[0]) != 0 or end(uv[1]) != 0:  # Go: end(uv[0].(*rat)) != 0 || end(uv[1].(*rat)) != 0
            Z.dat.send(finis)
        else:
            Z.dat.send(mul(uv[0], uv[1]))  # Go: mul(uv[0].(*rat), uv[1].(*rat))
            UU := Split(U)
            VV := Split(V)
            W := Add(Cmul(uv[0], VV[0]), Cmul(uv[1], UU[0]))  # Go: Cmul(uv[0].(*rat), VV[0]), Cmul(uv[1].(*rat), UU[0])
            _ := Z.req.recv()
            Z.dat.send(get(W))
            copy(Add(W, Mul(UU[1], VV[1])), Z)
    _ := ex.submit(fn(): body(U, V, Z))  # Go: }(U, V, Z)
    return Z

# Differentiate

fn Diff(U: Dch) -> Dch:
    Z := mkPS()
    fn body(U: Dch, Z: Dch):  # Go: go func(U, Z PS) {
        _ := Z.req.recv()
        u := get(U)
        if end(u) == 0:
            done := false
            i := 1
            while not done:  # Go: for i := 1; !done; i++ {
                u = get(U)
                if end(u) != 0:
                    done = true
                else:
                    Z.dat.send(mul(itor(i), u))  # Go: itor(int64(i))
                    _ := Z.req.recv()
                i += 1
        Z.dat.send(finis)
    _ := ex.submit(fn(): body(U, Z))  # Go: }(U, Z)
    return Z

# Integrate, with const of integration
fn Integ(c: Rat, U: Dch) -> Dch:
    Z := mkPS()
    fn body(c: Rat, U: Dch, Z: Dch):  # Go: go func(c *rat, U, Z PS) {
        put(c, Z)
        done := false
        i := 1
        while not done:  # Go: for i := 1; !done; i++ {
            _ := Z.req.recv()
            u := get(U)
            if end(u) != 0:
                done = true
            Z.dat.send(mul(i2tor(1, i), u))  # Go: i2tor(1, int64(i))
            i += 1
        Z.dat.send(finis)
    _ := ex.submit(fn(): body(c, U, Z))  # Go: }(c, U, Z)
    return Z

# Binomial theorem (1+x)^c

fn Binom(c0: Rat) -> Dch:
    Z := mkPS()
    fn body(c0: Rat, Z: Dch):  # Go: go func(c *rat, Z PS) {
        c := c0
        n := 1
        t := itor(1)
        while c.num != 0:
            put(t, Z)
            t = mul(mul(t, c), i2tor(1, n))  # Go: i2tor(1, int64(n))
            c = sub(c, one)
            n += 1
        put(finis, Z)
    _ := ex.submit(fn(): body(c0, Z))  # Go: }(c, Z)
    return Z

# Reciprocal of a power series
# 	let U = u + x*UU
# 	let Z = z + x*ZZ
# 	(u+x*UU)*(z+x*ZZ) = 1
# 	z = 1/u
# 	u*ZZ + z*UU +x*UU*ZZ = 0
# 	ZZ = -UU*(z+x*ZZ)/u

fn Recip(U: Dch) -> Dch:
    Z := mkPS()
    fn body(U: Dch, Z: Dch):  # Go: go func(U, Z PS) {
        ZZ := mkPS2()
        _ := Z.req.recv()
        z := inv(get(U))
        Z.dat.send(z)
        split(Mul(Cmul(neg(z), U), Shift(z, ZZ[0])), ZZ)
        copy(ZZ[1], Z)
    _ := ex.submit(fn(): body(U, Z))  # Go: }(U, Z)
    return Z

# Exponential of a power series with constant term 0
# (nonzero constant term would make nonrational coefficients)
# bug: the constant term is simply ignored
# 	Z = exp(U)
# 	DZ = Z*DU
# 	integrate to get Z

fn Exp(U: Dch) -> Dch:
    ZZ := mkPS2()
    split(Integ(one, Mul(ZZ[0], Diff(U))), ZZ)
    return ZZ[1]

# Substitute V for x in U, where the leading term of V is zero
# 	let U = u + x*UU
# 	let V = v + x*VV
# 	then S(U,V) = u + VV*S(V,UU)
# bug: a nonzero constant term is ignored

fn Subst(U: Dch, V: Dch) -> Dch:
    Z := mkPS()
    fn body(U: Dch, V: Dch, Z: Dch):  # Go: go func(U, V, Z PS) {
        VV := Split(V)
        _ := Z.req.recv()
        u := get(U)
        Z.dat.send(u)
        if end(u) == 0:
            if end(get(VV[0])) != 0:
                put(finis, Z)
            else:
                copy(Mul(VV[0], Subst(U, VV[1])), Z)
    _ := ex.submit(fn(): body(U, V, Z))  # Go: }(U, V, Z)
    return Z

# Monomial Substitution: U(c x^n)
# Each Ui is multiplied by c^i and followed by n-1 zeros

fn MonSubst(U: Dch, c0: Rat, n: int) -> Dch:
    Z := mkPS()
    fn body(U: Dch, Z: Dch, c0: Rat, n: int):  # Go: go func(U, Z PS, c0 *rat, n int) {
        c := one
        while true:  # Go: for {
            _ := Z.req.recv()
            u := get(U)
            Z.dat.send(mul(u, c))
            c = mul(c, c0)
            if end(u) != 0:
                Z.dat.send(finis)
                break
            for _i in 1..n:  # Go: for i := 1; i < n; i++ {
                _ := Z.req.recv()
                Z.dat.send(zero)
    _ := ex.submit(fn(): body(U, Z, c0, n))  # Go: }(U, Z, c0, n)
    return Z

fn Init():
    chnameserial = -1
    seqno = 0
    chnames = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    zero = itor(0)
    one = itor(1)
    finis = i2tor(1, 0)
    Ones = Rep(one)
    Twos = Rep(itor(2))

fn check(U: Dch, c: Rat, count: int, s: str):  # Go: str string
    for _i in 0..count:
        r := get(U)
        # Go: print("got: "); r.pr(); print("should get "); c.pr(); print("\n"); panic(str)
        assert r.eq(c), "got: {r.pr()}should get {c.pr()}\n{s}"

N := 10  # Go: const N = 10

fn checka(U: Dch, a: List[Rat], s: str):  # Go: a []*rat, str string
    for i in 0..N:
        check(U, a[i], 1, s)

test fn main_():
    Init()
    # Go: if len(os.Args) > 1 { ... } prints each series with Printn; this port runs only the
    # test branch, which is what Go's test harness runs.
    check(Ones, one, 5, "Ones")
    check(Add(Ones, Ones), itor(2), 0, "Add Ones Ones")  # 1 1 1 1 1
    check(Add(Ones, Twos), itor(3), 0, "Add Ones Twos")  # 3 3 3 3 3
    a := [Rat(0, 0) for _ in 0..N]  # Go: a := make([]*rat, N)
    d := Diff(Ones)
    for i in 0..N:
        a[i] = itor(i + 1)  # Go: itor(int64(i + 1))
    checka(d, a, "Diff")  # 1 2 3 4 5
    inp := Integ(zero, Ones)  # Go: in := Integ(zero, Ones)
    a[0] = zero  # integration constant
    for i in 1..N:
        a[i] = i2tor(1, i)  # Go: i2tor(1, int64(i))
    checka(inp, a, "Integ")  # 0 1 1/2 1/3 1/4 1/5
    check(Cmul(neg(one), Twos), itor(-2), 10, "CMul")  # -1 -1 -1 -1 -1
    check(Sub(Ones, Twos), itor(-1), 0, "Sub Ones Twos")  # -1 -1 -1 -1 -1
    m := Mul(Ones, Ones)
    for i in 0..N:
        a[i] = itor(i + 1)  # Go: itor(int64(i + 1))
    checka(m, a, "Mul")  # 1 2 3 4 5
    e := Exp(Ones)
    a[0] = itor(1)
    a[1] = itor(1)
    a[2] = i2tor(3, 2)
    a[3] = i2tor(13, 6)
    a[4] = i2tor(73, 24)
    a[5] = i2tor(167, 40)
    a[6] = i2tor(4051, 720)
    a[7] = i2tor(37633, 5040)
    a[8] = i2tor(43817, 4480)
    a[9] = i2tor(4596553, 362880)
    checka(e, a, "Exp")  # 1 1 3/2 13/6 73/24
