# Test select when discarding a value.
import std.time

fn recv1(c: Channel[int]):  # Go: c <-chan int
    c.recv()

fn recv2(c: Channel[int]):
    wait:
        _ := c.recv(): pass

fn recv3(c: Channel[int]):
    c2 := Channel[int](0)
    wait:
        _ := c.recv(): pass
        _ := c2.recv(): pass

fn send1(recv: fn(Channel[int]) -> None):
    c := Channel[int](0)
    spawn recv(c)
    time.sleep_ms(1)  # Go: runtime.Gosched() (a yield; Chezzi has none and sleep_ms(0) returns at once)
    c.send(1)

fn send2(recv: fn(Channel[int]) -> None):
    c := Channel[int](0)
    spawn recv(c)
    time.sleep_ms(1)  # Go: runtime.Gosched() (a yield; Chezzi has none and sleep_ms(0) returns at once)
    wait:
        c.send(1): pass

fn send3(recv: fn(Channel[int]) -> None):
    c := Channel[int](0)
    spawn recv(c)
    time.sleep_ms(1)  # Go: runtime.Gosched() (a yield; Chezzi has none and sleep_ms(0) returns at once)
    c2 := Channel[int](0)
    wait:
        c.send(1): pass
        c2.send(1): pass

test fn main_():
    send1(recv1)
    send2(recv1)
    send3(recv1)
    send1(recv2)
    send2(recv2)
    send3(recv2)
    send1(recv3)
    send2(recv3)
    send3(recv3)
