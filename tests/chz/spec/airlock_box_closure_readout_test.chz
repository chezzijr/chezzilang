# TICKET-285 — D4 layer C: a closure another task reads out of Shared/RwShared marks its
# captures exactly as the Channel route does, so a write through a capture FAULTS.
#
# Grid: closure x readout route x capture kind. Every route a closure can be read out of is one
# `route` row: the four box readout sites (`box_copy_out`, `box_copy_pieces`, the `box_call` result,
# the `rwshared_mutate` result) and the three wire-stored routes (Channel, Atomic, Task). A reader
# task faults on a write to a captured list and to a module global (`silent_routes`). The task that
# stored the closure faults too when it reads it back (TICKET-291: a same-task round trip is a crossing).
import Shared, RwShared, Atomic, Executor from std.concurrency
import ConcurrentList, ConcurrentMap from std.concurrency.collection

COPY_TAIL := "is this task's copy: a write to it would be lost at the join"
ROUTES := ["Shared.get", "Shared.read", "RwShared.get", "RwShared.read", "ConcurrentList.at", "ConcurrentMap.get", "ConcurrentMap.remove", "Channel.recv", "Atomic.load", "Task.get"]
BOX_ROUTES := ["Shared.get", "Shared.read", "RwShared.get", "RwShared.read", "ConcurrentList.at", "ConcurrentMap.get"]
G := [1]

fn some(o: (fn() -> None)?) -> fn() -> None:
    match o:
        ?v: return v
        None: panic("the route holds no closure")

fn ok(o: (fn() -> None)!) -> fn() -> None:
    match o:
        ?v: return v
        !e: panic(e.message())

# The fault message of `g()`, or "no-fault".
fn outcome(g: fn() -> None) -> str:
    res := recover: g()
    match res:
        ?_: return "no-fault"
        !e: return e.message()

# Store `f` behind `name` and return the reader that takes it back out.
fn route(name: str, f: fn() -> None) -> fn() -> fn() -> None:
    match name:
        "Shared.get":
            b := Shared([f])
            return fn(): b.get()[0]
        "Shared.read":
            b := Shared([f])
            return fn(): b.read(fn(s): s[0])
        "RwShared.get":
            b := RwShared([f])
            return fn(): b.get()[0]
        "RwShared.read":
            b := RwShared([f])
            return fn(): b.read(fn(s): s[0])
        "ConcurrentList.at":
            cl := ConcurrentList[fn() -> None].new()
            cl.push(f)
            return fn(): some(cl.at(0))
        "ConcurrentMap.get":
            cm := ConcurrentMap[int, fn() -> None].new()
            _ := cm.insert(1, f)
            return fn(): some(cm.get(1))
        "ConcurrentMap.remove":
            cm := ConcurrentMap[int, fn() -> None].new()
            _ := cm.insert(1, f)
            return fn(): some(cm.remove(1))
        "Channel.recv":
            ch := Channel[fn() -> None](1)
            ch.send(f)
            return fn(): ch.recv()
        "Atomic.load":
            a := Atomic(f)
            return fn(): a.load()
        "Task.get":
            ex := Executor(1)
            t := ex.submit(fn(): f)
            ex.shutdown()
            return fn(): ok(t.get())
        _: panic("no route {name}")

# Read the closure out in a spawned task and call it there.
fn in_task(read: fn() -> fn() -> None) -> str:
    r := Channel[str](1)
    parallel:
        spawn:
            r.send(outcome(read()))
    return r.recv()

fn list_writer() -> fn() -> None:
    xs := [1]
    return fn(): xs.push(2)

fn global_writer() -> fn() -> None:
    return fn(): G.push(2)

# The routes whose reader task did NOT fault, for a closure from `make`.
fn silent_routes(make: fn() -> fn() -> None) -> List[str]:
    out: List[str] = []
    for name in ROUTES:
        if not in_task(route(name, make())).contains(COPY_TAIL):
            out.push(name)
    return out

test fn shared_get_closure_capture_write_faults():
    assert in_task(route("Shared.get", list_writer())).contains(COPY_TAIL)

test fn rwshared_get_closure_capture_write_faults():
    assert in_task(route("RwShared.get", list_writer())).contains(COPY_TAIL)

test fn shared_read_result_closure_capture_write_faults():
    assert in_task(route("Shared.read", list_writer())).contains(COPY_TAIL)

test fn rwshared_read_closure_capture_write_faults():
    assert in_task(route("RwShared.read", list_writer())).contains(COPY_TAIL)

test fn concurrent_list_at_closure_capture_write_faults():
    assert in_task(route("ConcurrentList.at", list_writer())).contains(COPY_TAIL)

test fn concurrent_map_get_closure_capture_write_faults():
    assert in_task(route("ConcurrentMap.get", list_writer())).contains(COPY_TAIL)

test fn concurrent_map_remove_closure_capture_write_faults():
    assert in_task(route("ConcurrentMap.remove", list_writer())).contains(COPY_TAIL)

test fn channel_recv_closure_capture_write_faults():
    assert in_task(route("Channel.recv", list_writer())).contains(COPY_TAIL)

test fn list_capture_write_faults_on_every_route():
    assert silent_routes(list_writer) == []

test fn global_write_faults_on_every_route():
    assert silent_routes(global_writer) == []

# The task that stored the closure reads it back: the read rebuilt the captures as copies (TICKET-291).
test fn self_read_back_faults_on_every_box_route():
    for name in BOX_ROUTES:
        assert outcome(route(name, list_writer())()).contains(COPY_TAIL), name

test fn a_task_reads_back_its_own_stored_closure_and_faults():
    r := Channel[str](1)
    parallel:
        spawn:
            r.send(outcome(route("Shared.get", list_writer())()))
    assert r.recv().contains(COPY_TAIL)

# A closure a task built and stored, read by main after the join: the Channel twin faults.
test fn task_built_closure_read_by_main_faults():
    b := Shared[List[fn() -> None]]([])
    parallel:
        spawn:
            b.set([list_writer()])
    assert outcome(b.get()[0]).contains(COPY_TAIL)

# `update` stores a captured closure: every reader faults, the updating task included.
test fn update_stored_closure_read_by_task_faults():
    g := list_writer()
    b := Shared[List[fn() -> None]]([])
    b.update(fn(s): s + [g])
    assert outcome(b.get()[0]).contains(COPY_TAIL)
    assert in_task(fn(): b.get()[0]).contains(COPY_TAIL)

# A closure built inside the box captures the box's own state; the write would be lost, so it faults.
test fn box_built_closure_capture_write_faults():
    b := Shared([1])
    built := b.read(fn(s): fn(): s.push(9))
    assert outcome(built).contains(COPY_TAIL)
    assert b.get() == [1]

# TICKET-291 C1: a same-task round trip is a crossing too, so the write faults on every route.
test fn same_task_round_trip_faults_on_every_route():
    silent: List[str] = []
    for name in ROUTES:
        if not outcome(route(name, list_writer())()).contains(COPY_TAIL):
            silent.push(name)
    assert silent == []

# C2: a relay task re-stores the closure; the re-store must keep the mark.
test fn relay_restore_through_shared_keeps_the_mark():
    g := list_writer()
    c := Shared([g])
    r := Channel[str](1)
    parallel:
        spawn:
            h := c.get()[0]
            c.set([h])
            r.send(outcome(c.get()[0]))
    assert r.recv().contains(COPY_TAIL)

test fn relay_restore_through_channels_keeps_the_mark():
    g := list_writer()
    ch := Channel[fn() -> None](1)
    ch2 := Channel[fn() -> None](1)
    ch.send(g)
    h := ch.recv()
    ch2.send(h)
    assert outcome(ch2.recv()).contains(COPY_TAIL)

# C4: a closure received inside a box closure is stamped with the storing task, not the sender.
test fn recv_inside_box_closure_stamps_the_storing_task():
    ch := Channel[fn() -> None](1)
    b := Shared[List[fn() -> None]]([])
    r := Channel[str](1)
    parallel:
        spawn:
            xs := [1]
            ch.send(fn(): xs.push(2))
            while b.get().len() == 0:
                pass
            r.send(outcome(b.get()[0]))
        spawn:
            b.update(fn(s): s + [ch.recv()])
    assert r.recv().contains(COPY_TAIL)

# C3: a closure the box closure builds over FRESH state loses no write, so it must not fault.
fn make_logger() -> fn() -> None:
    log := [0]
    return fn(): log.push(1)

test fn box_built_closure_over_fresh_state_does_not_fault():
    c := Shared([1]).read(fn(s): make_logger())
    assert outcome(c) == "no-fault"

# TICKET-291 grid: route x reader x capture kind. Every cell faults except a module-global write
# by the task that stored the closure: a closure reads the globals of the task that runs it (D2),
# so that write is the owner's own and lands (`G` grows by one).
READERS := ["same task", "other task", "relay task"]
CAPTURES := ["captured list", "module global", "fresh box state", "box state"]

fn writer(capture: str) -> fn() -> None:
    match capture:
        "captured list":
            return list_writer()
        "module global":
            return global_writer()
        "fresh box state":
            return Shared([0]).read(fn(s): make_logger())
        "box state":
            return Shared([0]).read(fn(s): fn(): s.push(9))
        _: panic("no capture {capture}")

# The relay task reads the closure, stores it again behind a new `name` route, reads it back and
# calls it.
fn relay(name: str, read: fn() -> fn() -> None) -> str:
    r := Channel[str](1)
    parallel:
        spawn:
            r.send(outcome(route(name, read())()))
    return r.recv()

fn cell(name: str, reader: str, capture: str) -> str:
    read := route(name, writer(capture))
    match reader:
        "same task":
            return outcome(read())
        "other task":
            return in_task(read)
        "relay task":
            return relay(name, read)
        _: panic("no reader {reader}")

test fn closure_capture_grid_faults_except_the_owners_global_write():
    wrong: List[str] = []
    for name in ROUTES:
        for reader in READERS:
            for capture in CAPTURES:
                before := G.len()
                got := cell(name, reader, capture)
                if reader == "same task" and capture == "module global":
                    if got != "no-fault" or G.len() != before + 1:
                        wrong.push("{name}/{reader}/{capture}")
                elif not got.contains(COPY_TAIL):
                    wrong.push("{name}/{reader}/{capture}")
    assert wrong == []

struct Pair:
    put: fn() -> None
    size: fn() -> int

fn make_pair() -> Pair:
    log := [0]
    return Pair(fn(): log.push(1), fn() -> int: log.len())

fn over_state(s: List[int]) -> fn() -> None:
    log := [s]
    return fn(): log[0].push(5)

# C3 row: the closure a box call builds and returns. Over fresh state the caller holds the only
# live copy, so the write runs and a sibling closure over the same binding sees it. Over the box's
# state, or fresh state that holds it, the write would be lost, so it faults. `RwShared.read` runs
# its closure in the reader's heap over the reader's copy of the state (`03-shared.md`), so that
# write is the reader's own.
test fn box_call_result_marks_only_what_the_box_keeps():
    p := Shared([1]).read(fn(s): make_pair())
    assert outcome(p.put) == "no-fault"
    assert p.size() == 2
    q := RwShared([1]).read(fn(s): make_pair())
    assert outcome(q.put) == "no-fault"
    assert q.size() == 2
    b := Shared([1])
    assert outcome(b.read(fn(s): fn(): s.push(9))).contains(COPY_TAIL)
    assert outcome(b.read(fn(s): over_state(s))).contains(COPY_TAIL)
    assert b.get() == [1]
    rw := RwShared([1])
    assert outcome(rw.read(fn(s): fn(): s.push(9))) == "no-fault"
    assert rw.get() == [1]
