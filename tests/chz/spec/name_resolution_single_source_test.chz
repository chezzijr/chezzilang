# TICKET-180: the checker and the compiler must agree on what a name means.
# Expected values are the CPython / Rust meaning.

struct P:
    x: int

type Q = P

fn q_of(s: str) -> P:
    if s == "":
        return P(0)
    return q_of(s[1..])

fn local_shadows_builtin() -> int:
    ord := fn(s: str) -> int: 1000
    return ord("a")

fn param_shadows_struct(P: fn(int) -> str) -> str:
    return P(4)

test fn local_closure_shadows_builtin_ord():
    assert local_shadows_builtin() == 1000

test fn param_shadows_struct_ctor():
    assert param_shadows_struct(fn(n: int) -> str: "v{n}") == "v4"

test fn fn_beside_a_type_alias_is_a_fn():
    assert q_of("abc").x == 0

test fn type_alias_is_the_ctor():
    assert Q(x=3).x == 3
