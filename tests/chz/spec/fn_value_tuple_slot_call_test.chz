# W12-16(a)
fn dbl(x: int) -> int:
    return x * 2

w1216_hits := 0

fn w1216_bump(n: int) -> int:
    w1216_hits = w1216_hits + n
    return w1216_hits

fn w1216_go():
    t := (w1216_bump, 0)
    defer t.0(5)

test fn a_tuple_slot_fn_is_callable_directly():
    t := (dbl, 1)
    assert t.0(3) == 6, "got {t.0(3)}"
    assert (t.0)(4) == 8, "got {(t.0)(4)}"

test fn a_tuple_slot_fn_is_callable_from_defer():
    w1216_go()
    assert w1216_hits == 5, "got {w1216_hits}"

test fn a_tuple_slot_fn_is_callable_from_spawn():
    t2 := (dbl, 1)
    parallel:
        spawn t2.0(7)

fn dbl_s3(x: int) -> int:
    return x * 2

fn inc_s3(x: int) -> int:
    return x + 1

# S3-3 / U17: `t.0[i](5)` indexes the list in tuple slot 0, then calls. A tuple-index head
# (`t.0`) never takes type arguments, so `[i]` is an index, as in Rust and CPython.
test fn tuple_slot_list_index_then_call():
    fs: List[fn(int) -> int] = [dbl_s3, inc_s3]
    t := (fs, 7)
    i := 1
    assert t.0[i](5) == 6
    assert t.0[0](5) == 10
