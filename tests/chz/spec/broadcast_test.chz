# TICKET-288 — `std.concurrency.broadcast`: a pub/sub channel with the tokio `broadcast` contract.
# One test per contract line of the ticket; line 6 (worker counts) is this file run at
# `CHEZZI_THREADS` 1, 2 and the default. Every assertion holds at every worker count. Two tests drop
# values across tasks: `a_slow_subscriber_task_counts_every_value_it_missed` asserts the lag
# invariant, and `a_reader_that_drains_during_a_send_never_loses_the_newest_value` asserts the
# newest value arrives. Neither asserts which values were dropped.
#
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
import Broadcast, Receiver, Lagged from std.concurrency.broadcast
import Executor, AtomicInt from std.concurrency
import Iterable from std.iter

fn take_all(rx: Receiver[int]) -> List[str]:
    out: List[str] = []
    for r in rx:
        match r:
            ?v: out.push("{v}")
            !e: out.push("lag {e.missed}")
    return out

# 1. A receiver sees every value sent after its subscribe, in send order.
test fn a_receiver_sees_the_values_sent_after_its_subscribe_in_order():
    b := Broadcast[int].new(8)
    b.send(0)
    early := b.subscribe()
    b.send(1)
    b.send(2)
    late := b.subscribe()
    b.send(3)
    b.close()
    assert take_all(early) == ["1", "2", "3"]
    assert take_all(late) == ["3"]

# 2. `send` never blocks on a full mailbox, and every receiver gets the one value, by handle
# (M3.3; Go `handle/main.go`: `broadcast_shares 2 2`).
test fn send_never_blocks_and_every_receiver_gets_the_one_value():
    b := Broadcast[List[int]].new(2)
    a := b.subscribe()
    c := b.subscribe()
    for i in 0..10:
        b.send([i])
    b.close()
    xs := a.recv()
    match xs:
        !e: assert e.missed == 8
        ?_: assert false
    va := a.recv() ?? []
    vc := c.recv()
    match vc:
        !e: assert e.missed == 8
        ?_: assert false
    vc2 := c.recv() ?? []
    va.push(99)
    assert va == [8, 99]
    assert vc2 == [8, 99]

# 3. A receiver that falls behind gets `!Lagged(missed)`, then the oldest value still held.
test fn a_lagging_receiver_reports_the_missed_count_then_continues():
    b := Broadcast[int].new(2)
    rx := b.subscribe()
    for i in 1..6:
        b.send(i)
    first := rx.recv()
    match first:
        !e: assert e.missed == 3
        ?_: assert false
    assert (rx.recv() ?? 0) == 4
    assert (rx.recv() ?? 0) == 5
    assert rx.try_recv() == None
    b.send(6)
    b.send(7)
    b.send(8)
    b.close()
    assert take_all(rx) == ["lag 1", "7", "8"]

test fn try_recv_reports_the_lag_and_then_the_held_value():
    b := Broadcast[int].new(1)
    rx := b.subscribe()
    b.send(1)
    b.send(2)
    match rx.try_recv():
        ?r:
            match r:
                !e: assert e.missed == 1
                ?_: assert false
        None: assert false
    match rx.try_recv():
        ?r: assert (r ?? 0) == 2
        None: assert false
    assert rx.try_recv() == None

# 4. `close` ends every `for` after the values already sent; a later send faults.
test fn close_ends_every_loop_after_the_values_sent():
    b := Broadcast[int].new(4)
    r1 := b.subscribe()
    r2 := b.subscribe()
    b.send(1)
    b.send(2)
    b.close()
    b.close()
    assert take_all(r1) == ["1", "2"]
    assert take_all(r2) == ["1", "2"]
    assert r1.try_recv() == None
    after := b.subscribe()
    assert take_all(after) == []
    res := recover:
        b.send(3)
    match res:
        ?_: assert false
        !e: assert e.message() == "send on a closed Broadcast"

fn count_items(xs: Iterable[int!Lagged]) -> int:
    n := 0
    for _ in xs:
        n += 1
    return n

# `for` and the `Iterable` bound agree: a receiver is an `Iterable[T!Lagged]`.
test fn a_receiver_satisfies_the_iterable_bound_that_for_uses():
    b := Broadcast[int].new(4)
    rx := b.subscribe()
    b.send(1)
    b.send(2)
    b.close()
    assert count_items(rx) == 2

test fn a_capacity_below_one_faults():
    res := recover:
        Broadcast[int].new(0)
    match res:
        ?_: assert false
        !e: assert e.message() == "Broadcast capacity must be at least 1, got 0"

fn collect_into(rx: Receiver[int], out: Channel[List[str]]):
    out.send(take_all(rx))

fn publish(b: Broadcast[int], n: int):
    for i in 0..n:
        b.send(i)
    b.close()

# 5. Both handles cross `spawn`: a subscriber task and a publisher task share one broadcast.
test fn a_broadcast_and_its_receivers_cross_spawn():
    b := Broadcast[int].new(32)
    r1 := b.subscribe()
    r2 := b.subscribe()
    o1 := Channel[List[str]](1)
    o2 := Channel[List[str]](1)
    parallel:
        spawn:
            collect_into(r1, o1)
        spawn:
            collect_into(r2, o2)
        spawn:
            publish(b, 20)
    want: List[str] = []
    for i in 0..20:
        want.push("{i}")
    assert o1.recv() == want
    assert o2.recv() == want

fn sum_into(rx: Receiver[int], total: Channel[int]):
    s := 0
    for r in rx:
        s += r ?? 0
    total.send(s)

# 5. A closure handler submitted to an `Executor` runs the subscriber loop in its own task.
test fn a_receiver_crosses_an_executor_job():
    b := Broadcast[int].new(8)
    rx := b.subscribe()
    total := Channel[int](1)
    ex := Executor(2)
    _ := ex.submit(fn(): sum_into(rx, total))
    for i in 1..5:
        b.send(i)
    b.close()
    ex.shutdown()
    assert total.recv() == 10

# Busy work between two receives, so the publisher task outruns the subscriber task.
fn spin(k: int) -> int:
    acc := 0
    for i in 0..k:
        acc += i % 7
    return acc

# Read every result; send the values it got, then the sum of every `Lagged.missed`.
fn slow_reader(rx: Receiver[int], got: Channel[List[int]], missed: Channel[int]):
    vs: List[int] = []
    lost := 0
    for r in rx:
        match r:
            ?v: vs.push(v)
            !e: lost += e.missed
        _ := spin(200)
    got.send(vs)
    missed.send(lost)

# 3 across tasks. A publisher task sends 2000 values into mailboxes of 4 while a slow subscriber task
# reads: the values it gets rise strictly, and the missed counts plus the values it got add up to
# every value sent.
test fn a_slow_subscriber_task_counts_every_value_it_missed():
    n := 2000
    b := Broadcast[int].new(4)
    rx := b.subscribe()
    got := Channel[List[int]](1)
    missed := Channel[int](1)
    parallel:
        spawn:
            slow_reader(rx, got, missed)
        spawn:
            publish(b, n)
    vs := got.recv()
    lost := missed.recv()
    for i in 1..vs.len():
        assert vs[i - 1] < vs[i], "values out of order at {i}: {vs[i - 1]} then {vs[i]}"
    assert lost > 0, "the subscriber task never lagged"
    assert lost + vs.len() == n,"missed {lost} plus got {vs.len()} is not {n}"
    assert vs[vs.len() - 1] == n - 1

fn publish_range(b: Broadcast[int], start: int, n: int):
    for i in start..start + n:
        b.send(i)

fn publish_two_then_close(b: Broadcast[int]):
    parallel:
        spawn:
            publish_range(b, 0, 200)
        spawn:
            publish_range(b, 1000, 200)
    b.close()

# Decision 4. Two publisher tasks send disjoint values; two subscriber tasks with room for every
# value get the same list in the same order.
test fn two_publisher_tasks_reach_every_subscriber_in_one_order():
    b := Broadcast[int].new(400)
    r1 := b.subscribe()
    r2 := b.subscribe()
    o1 := Channel[List[str]](1)
    o2 := Channel[List[str]](1)
    parallel:
        spawn:
            collect_into(r1, o1)
        spawn:
            collect_into(r2, o2)
        spawn:
            publish_two_then_close(b)
    l1 := o1.recv()
    l2 := o2.recv()
    assert l1.len() == 400
    assert l1 == l2

fn one_lag_trial() -> List[str]:
    b := Broadcast[int].new(1)
    rx := b.subscribe()
    out := Channel[List[str]](1)
    parallel:
        spawn:
            collect_into(rx, out)
        spawn:
            publish(b, 2)
    return out.recv()

# 3 across tasks. Mailbox of 1, a reader task drains it while the publisher task sends 0, 1 and closes.
# The reader may drain between the hub's failed `try_send` and its `try_recv`; the newest value must
# still arrive. Valid runs: `0, 1`, or `lag 1, 1`. A run that ends without `1` lost a value silently.
test fn a_reader_that_drains_during_a_send_never_loses_the_newest_value():
    for t in 0..3000:
        got := one_lag_trial()
        ok := got == ["0", "1"] or got == ["lag 1", "1"]
        assert ok, "trial {t}: the reader got {got}"

fn shared_reader(rx: Receiver[int], out: Channel[List[int]]):
    got: List[int] = []
    for r in rx:
        match r:
            ?v: got.push(v)
            !e: got.push(-e.missed)
    out.send(got)

fn shared_publish(b: Broadcast[int], n: int):
    for i in 0..n:
        b.send(i)
    b.close()

# TICKET-292 rule 1. Two reader tasks share one `Receiver` with room for every value, so the hub
# drops nothing: each value reaches exactly one reader and no `Lagged` is reported.
test fn two_tasks_reading_one_receiver_share_each_value_once():
    n := 5000
    b := Broadcast[int].new(n)
    rx := b.subscribe()
    o1 := Channel[List[int]](1)
    o2 := Channel[List[int]](1)
    parallel:
        spawn:
            shared_reader(rx, o1)
        spawn:
            shared_reader(rx, o2)
        spawn:
            shared_publish(b, n)
    all := o1.recv() + o2.recv()
    count: List[int] = []
    for _ in 0..n:
        count.push(0)
    lags := 0
    for x in all:
        if x < 0:
            lags += 1
        else:
            count[x] += 1
    dups := 0
    values := 0
    for c in count:
        if c > 0:
            values += 1
        if c > 1:
            dups += c - 1
    assert lags == 0 and dups == 0 and values == n, "lags {lags} values {values} dups {dups}"

# Read until close; send the values this reader got, then the sum of its `Lagged.missed` reports.
fn lagging_shared_reader(rx: Receiver[int], slow: bool, got: Channel[List[int]], missed: Channel[int]):
    vs: List[int] = []
    lost := 0
    for r in rx:
        match r:
            ?v: vs.push(v)
            !e: lost += e.missed
        if slow:
            _ := spin(200)
    got.send(vs)
    missed.send(lost)

# Rules 2 and 3 for `readers` tasks on one receiver of cap 4; reader 0 is slow.
fn small_cap_shared_trial(readers: int) -> str:
    n := 2000
    b := Broadcast[int].new(4)
    rx := b.subscribe()
    got := Channel[List[int]](readers)
    missed := Channel[int](readers)
    parallel:
        for k in 0..readers:
            spawn:
                lagging_shared_reader(rx, k == 0, got, missed)
        spawn:
            shared_publish(b, n)
    seen: List[int] = []
    for _ in 0..n:
        seen.push(0)
    received := 0
    lost := 0
    for _ in 0..readers:
        vs := got.recv()
        lost += missed.recv()
        received += vs.len()
        for i in 0..vs.len():
            if i > 0 and vs[i - 1] >= vs[i]:
                return "values out of order: {vs[i - 1]} then {vs[i]}"
            seen[vs[i]] += 1
            if seen[vs[i]] > 1:
                return "value {vs[i]} reached two readers"
    if received + lost != n:
        return "received {received} plus missed {lost} is not {n}"
    return "ok"

# TICKET-292 rules 2 and 3. Readers that share one small mailbox never get a value twice, and a
# `Lagged` report counts only the values the hub dropped.
test fn readers_sharing_a_small_mailbox_count_every_value_once():
    two := small_cap_shared_trial(2)
    assert two == "ok", "2 readers: {two}"
    four := small_cap_shared_trial(4)
    assert four == "ok", "4 readers: {four}"

fn blocked_reader(rx: Receiver[int], started: Channel[int]) -> int:
    started.send(1)
    match rx.recv():
        ?v: return v
        !e: return 0 - e.missed

# TICKET-292 rule 5. `try_recv` never waits for the receive step. A reader parked in `recv` holds
# the step; `try_recv` returns `None` at once instead of queueing behind it, and the parked reader
# still gets the next value. (TICKET-289 sealed a std struct's `_` fields, so the test no longer
# takes the `_lock` token itself; it cannot hold the step while a value is ready.)
test fn try_recv_returns_none_while_another_reader_is_receiving():
    b := Broadcast[int].new(4)
    rx := b.subscribe()
    got := Channel[int](1)
    started := Channel[int](1)
    ex := Executor()
    _ := ex.submit(fn(): got.send(blocked_reader(rx, started)))
    started.recv()
    # The reader is now parked in `recv` or about to park. A `try_recv` that queued behind its
    # receive step would never return, since nothing is sent yet.
    for _ in 0..200:
        assert rx.try_recv() == None
    b.send(7)
    assert got.recv() == 7
    ex.shutdown()

fn taking_reader(rx: Receiver[int], taken: Channel[int]):
    for r in rx:
        match r:
            ?v: taken.send(v)
            !e: taken.send(0 - e.missed)

# Read `half` values out of `taken`, let the other nursery's reader start, then fault this nursery.
fn fault_after(half: int, taken: Channel[int], first: Channel[List[int]], go: Channel[int]):
    vs: List[int] = []
    for _ in 0..half:
        vs.push(taken.recv())
    first.send(vs)
    go.send(1)
    panic("reader nursery faults")

fn reader_after_go(rx: Receiver[int], go: Channel[int], out: Channel[List[int]]):
    _ := go.recv()
    shared_reader(rx, out)

fn faulting_nursery_then_rest(b: Broadcast[int], rx: Receiver[int], half: int, n: int, taken: Channel[int], first: Channel[List[int]], go: Channel[int]):
    res := recover:
        parallel:
            spawn:
                taking_reader(rx, taken)
            spawn:
                fault_after(half, taken, first, go)
    match res:
        ?_: assert false, "the reader nursery did not fault"
        !e: assert e.message() == "reader nursery faults"
    for i in half..n:
        b.send(i)
    b.close()

# TICKET-292 rule 6. A reader cancelled while it waits inside the receive step returns the token:
# the reader in the other nursery still gets every value the first reader did not take.
test fn a_reader_cancelled_inside_a_receive_does_not_block_the_other_reader():
    n := 1000
    half := 500
    b := Broadcast[int].new(n)
    rx := b.subscribe()
    for i in 0..half:
        b.send(i)
    taken := Channel[int](n)
    first := Channel[List[int]](1)
    go := Channel[int](1)
    rest := Channel[List[int]](1)
    parallel:
        spawn:
            reader_after_go(rx, go, rest)
        spawn:
            faulting_nursery_then_rest(b, rx, half, n, taken, first, go)
    all := first.recv() + rest.recv()
    seen: List[int] = []
    for _ in 0..n:
        seen.push(0)
    for x in all:
        assert x >= 0, "a reader reported a lag"
        seen[x] += 1
    for i in 0..n:
        assert seen[i] == 1, "value {i} arrived {seen[i]} times"

# `recv` on a closed and drained receiver faults with the `Channel.recv` message.
test fn recv_on_a_closed_and_drained_receiver_faults():
    b := Broadcast[int].new(2)
    rx := b.subscribe()
    b.close()
    res := recover:
        _ := rx.recv()
    match res:
        ?_: assert false
        !e: assert e.message() == "receive on a closed channel"
    assert rx.try_recv() == None

fn note(r: int!Lagged, got: List[int], taken: AtomicInt):
    match r:
        ?v: got.push(v)
        !e: got.push(0 - e.missed)
    _ := taken.add(1)

fn for_path_reader(rx: Receiver[int], taken: AtomicInt, out: Channel[List[int]]):
    got: List[int] = []
    for r in rx:
        note(r, got, taken)
    out.send(got)

fn recv_path_reader(rx: Receiver[int], taken: AtomicInt, out: Channel[List[int]]):
    got: List[int] = []
    res := recover:
        while true:
            note(rx.recv(), got, taken)
    match res:
        ?_: pass
        !e: assert e.message() == "receive on a closed channel"
    out.send(got)

# Polls until every value is taken: closed-and-drained and empty both give `None`.
fn try_recv_path_reader(rx: Receiver[int], n: int, taken: AtomicInt, out: Channel[List[int]]):
    got: List[int] = []
    while taken.load() < n:
        match rx.try_recv():
            ?r: note(r, got, taken)
            None: pass
    out.send(got)

# TICKET-292 rule 4. One reader per receive path (`for`, `recv`, `try_recv`) on one receiver with
# room for every value: each value reaches exactly one reader and no `Lagged` is reported.
test fn every_receive_path_shares_one_receiver_without_a_duplicate():
    n := 3000
    b := Broadcast[int].new(n)
    rx := b.subscribe()
    taken := AtomicInt(0)
    o1 := Channel[List[int]](1)
    o2 := Channel[List[int]](1)
    o3 := Channel[List[int]](1)
    parallel:
        spawn:
            for_path_reader(rx, taken, o1)
        spawn:
            recv_path_reader(rx, taken, o2)
        spawn:
            try_recv_path_reader(rx, n, taken, o3)
        spawn:
            shared_publish(b, n)
    all := o1.recv() + o2.recv() + o3.recv()
    seen: List[int] = []
    for _ in 0..n:
        seen.push(0)
    for x in all:
        assert x >= 0, "a reader reported a lag"
        seen[x] += 1
    for i in 0..n:
        assert seen[i] == 1, "value {i} arrived {seen[i]} times"
