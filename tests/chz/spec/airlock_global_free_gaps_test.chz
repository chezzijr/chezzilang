# TICKET-137 (owner decision D2) — supersedes TICKET-097/TICKET-051's install. A closure received
# from another task reads the module globals of the task that RUNS it: each task owns a deep copy
# of every module global (taken at its spawn), and a crossing carries captures only. The sender's
# write (`n = 100`, `xs = [1, 2]`, `ys.push(2)`) lands in the SENDER's copy and never reaches the
# receiver, whether the closure reads the global directly or through a called helper. To share a
# value across tasks, use `Shared`/`Channel`. Go and CPython read one live global (100 / 2); the
# divergence is the deliberate "module globals isolate per task" rule (docs/concurrency.md).
import std.concurrency

n: int = 1

fn helper() -> int:
    return n

fn producer_a(c1: Channel[fn() -> int], c2: Channel[fn() -> int]):
    n = 100
    c1.send(fn() -> int: helper())
    c2.send(fn() -> int: n)

test fn call_indirected_global_read_reads_the_receivers_copy():
    c1 := Channel[fn() -> int]()
    c2 := Channel[fn() -> int]()
    parallel:
        spawn producer_a(c1, c2)
    indirect := c1.recv()
    before := indirect()
    direct := c2.recv()
    after := indirect()
    assert before == 1, "indirect (call-indirected) read saw {before} before the unrelated recv"
    assert after == 1, "indirect (call-indirected) read saw {after} after the unrelated recv"
    assert direct() == 1, "direct read saw {direct()}"

xs: List[int] = [1]
ys: List[int] = [1]

fn producer_b(c: Channel[fn() -> int], c2: Channel[fn() -> int]):
    xs = [1, 2]
    ys.push(2)
    c.send(fn() -> int: xs.len())
    c2.send(fn() -> int: ys.len())

test fn in_place_mutated_global_reads_the_receivers_copy():
    c := Channel[fn() -> int]()
    c2 := Channel[fn() -> int]()
    parallel:
        spawn producer_b(c, c2)
    f := c.recv()
    g := c2.recv()
    assert f() == 1, "assigned global via closure saw {f()}"
    assert g() == 1, "in-place-mutated global via closure saw {g()}"
