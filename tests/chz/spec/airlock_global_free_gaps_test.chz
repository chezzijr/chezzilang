# TICKET-097 — `fill_global_free` (src/compiler/mod.rs) misses two ordinary spellings of "this
# closure reads a module global", so the airlock's carried set silently drops the global and a
# crossing closure answers a stale value.
#
# Defect A: the read is behind a CALL. `children[p]` is built only from `Op::MakeClosure` /
# `Op::SpawnBlock`, never `Op::Call`, so a closure whose body calls a helper that reads the global
# never has that global in its own `global_free`. Go and CPython both read the LIVE value (100).
#
# Defect B: the sender's write was an IN-PLACE mutation (`ys.push(2)`), not a `SetGlobalSlot`/
# `DefineGlobalSlot`, so the sending view's `assigned` bit is never set for `ys` and the install is
# skipped. Go and CPython both read the LIVE value (2).
import std.concurrency

n: int = 1

fn helper() -> int:
    return n

fn producer_a(c1: Channel[fn() -> int], c2: Channel[fn() -> int]):
    n = 100
    c1.send(fn() -> int: helper())
    c2.send(fn() -> int: n)

test fn call_indirected_global_read_is_carried():
    c1 := Channel[fn() -> int]()
    c2 := Channel[fn() -> int]()
    parallel:
        spawn producer_a(c1, c2)
    indirect := c1.recv()
    before := indirect()
    direct := c2.recv()
    after := indirect()
    assert before == 100, "indirect (call-indirected) read saw {before} before the unrelated recv"
    assert after == 100, "indirect (call-indirected) read saw {after} after the unrelated recv"
    assert direct() == 100, "direct read saw {direct()}"

xs: List[int] = [1]
ys: List[int] = [1]

fn producer_b(c: Channel[fn() -> int], c2: Channel[fn() -> int]):
    xs = [1, 2]
    ys.push(2)
    c.send(fn() -> int: xs.len())
    c2.send(fn() -> int: ys.len())

test fn in_place_mutated_global_is_carried():
    c := Channel[fn() -> int]()
    c2 := Channel[fn() -> int]()
    parallel:
        spawn producer_b(c, c2)
    f := c.recv()
    g := c2.recv()
    assert f() == 2, "assigned global via closure saw {f()}"
    assert g() == 2, "in-place-mutated global via closure saw {g()}"
