# tests/chz/spec/static_witness_test.chz — M24 slice A: a protocol's STATIC (no-`self`) requirement
# is callable through a generic bound.
#
# `fn reset[T: Default](old: T) -> T: return T.default()` used to be a hard checker error ("generics
# are erased, there is no concrete type to construct"). M24 threads the concrete type's runtime
# identity key as a hidden trailing argument on the generic fn, so `T.default()` dispatches to the
# real type. Rust is the ancestor here — `T::default()` under `fn reset<T: Default>(_: T) -> T` is
# the same program, and answers the same.
#
# This file is the RUNNING half. It is the only thing that proves the CHECKER's identity key equals
# the COMPILER's/VM's runtime key — a checker-only test passes even if the wrong type is
# constructed. The compile-time rejections (cross-module, forwarding, fn-as-value, unpinned `T`, a
# witness call inside a closure/`spawn:`/`defer:`/nested-fn/method) are `src/checker/tests.rs`
# (`// ===== M24` section), not here: they never reach a runtime.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import std.concurrency
# a module bind a PARAMETER can shadow — see the M24-2 section at the bottom of this file
import std.math
# a module bind a TYPE declared in this file shadows — see the M24-2 section at the bottom
import std.time
# the OTHER module a forward can point at — see the M24-1 section at the bottom of this file
import static_witness_lib as wlib

protocol Default:
    fn default() -> Self

# a second static requirement, so the shadowing tests at the bottom of this file can bound a type
# param whose name equals a real struct's and still name a method BOTH types answer differently
protocol Tagged:
    fn tag() -> int

struct Counter:
    n: int
    fn default() -> Counter:
        return Counter(0)
    fn tag() -> int:
        return 1

struct Tag:
    s: str
    fn default() -> Tag:
        return Tag("none")
    fn tag() -> int:
        return 3

fn greet(a: int, b: int) -> str:
    return "{a}-{b}"

enum Col:
    Red
    Blue
    fn default() -> Col:
        return Col.Blue

protocol Conv:
    fn conv(x: int) -> Self

struct Wrap:
    v: int
    fn conv(x: int) -> Wrap:
        return Wrap(x * 2)

struct Port:
    v: int
    fn convert(x: int) -> Port:
        return Port(x + 1)

fn reset[T: Default](old: T) -> T:
    return T.default()

fn empty[T: Default]() -> T:
    return T.default()

fn mk[T: Conv](seed: T, n: int) -> T:
    return T.conv(n)

fn make[T: Convert[int]](seed: T, n: int) -> T:
    return T.convert(n)

fn second_of[T: Default, U: Default](a: T, b: U) -> U:
    x := T.default()
    return U.default()

# ---- the driver shape ----

test fn a_static_requirement_dispatches_to_the_concrete_type():
    assert reset(Counter(9)).n == 0, "T.default() must build Counter, not the argument"

test fn two_different_concrete_types_flow_through_one_generic():
    # the identity key is per CALL SITE, so the same `reset` must answer differently here
    assert reset(Counter(9)).n == 0
    assert reset(Tag("hi")).s == "none"

test fn an_enum_can_host_the_static_requirement():
    assert reset(Col.Red) == Col.Blue

# ---- arguments, and the reserved `Convert[S]` bound ----

test fn a_static_requirement_takes_arguments():
    assert mk(Wrap(0), 21).v == 42

test fn the_reserved_convert_bound_dispatches_too():
    assert make(Port(0), 41).v == 42

# ---- pinning `T` without a value argument ----

test fn a_turbofish_pins_a_nullary_generic():
    assert empty[Counter]().n == 0
    assert empty[Tag]().s == "none"

test fn an_annotated_result_pins_a_nullary_generic():
    c: Counter = empty()
    assert c.n == 0

# ---- witness ORDER: two params, and the second one is the answer ----

test fn two_witness_params_keep_their_declaration_order():
    assert second_of(Counter(1), Tag("x")).s == "none", "U's witness must not be T's"
    assert second_of(Tag("x"), Counter(1)).n == 0

# ---- call sites the witness constant has to survive ----

test fn a_nested_call_site_gets_its_own_witness():
    assert reset(reset(Counter(9))).n == 0

test fn an_interpolation_fragment_is_a_real_call_site():
    assert "{reset(Counter(9)).n}" == "0"

test fn a_witness_call_site_inside_a_closure():
    f := fn(): reset(Counter(9)).n
    assert f() == 0

test fn a_witness_call_site_inside_a_spawn_block():
    ch := Channel[int](4)
    parallel:
        spawn:
            ch.send(reset(Counter(9)).n)
        spawn:
            ch.send(reset(Counter(5)).n)
    assert ch.recv() + ch.recv() == 0

test fn a_witness_call_site_inside_a_defer_block():
    seen := [1]
    fn body():
        defer:
            seen.push(reset(Counter(9)).n)
        seen.push(2)
    body()
    assert seen == [1, 2, 0]

# ---- the hidden parameter must not leak into anything that does not take one ----

fn biggest[T: Comparable](a: T, b: T) -> T:
    if a < b:
        return b
    return a

fn ident[T](x: T) -> T:
    return x

fn apply2(f: fn(int, int) -> int, a: int, b: int) -> int:
    return f(a, b)

test fn a_non_static_bound_is_untouched_and_still_a_function_value():
    assert biggest(3, 7) == 7
    assert apply2(biggest, 4, 1) == 4
    assert ident("hi") == "hi"

test fn a_nested_fn_does_not_inherit_a_module_fns_witness_arity():
    fn reset(k: int) -> int:
        return k * 10
    assert reset(4) == 40, "the nested `reset` is a plain 1-arg fn"

test fn a_keyword_argument_reaches_a_witness_call():
    # named args are normalized to positional by desugar BEFORE the witness lowering sees the call,
    # so the hidden trailing witness still lands last.
    assert reset(old=Counter(9)).n == 0

# ---- a witness is charged only to a body that uses one ----
#
# `Spawnable` carries a static requirement, but `tagged` never constructs — so it takes NO hidden
# param and keeps every position a plain generic fn has (value, HOF argument, `spawn`/`defer`).

protocol Spawnable:
    fn make() -> Self
    fn tag(self) -> str

struct Node:
    v: int
    fn make() -> Node:
        return Node(0)
    fn tag(self) -> str:
        return "node{self.v}"

fn tagged[T: Spawnable](x: T) -> str:
    return x.tag()

fn apply_tag(f: fn(Node) -> str, x: Node) -> str:
    return f(x)

test fn a_generic_that_never_constructs_stays_a_function_value():
    assert tagged(Node(2)) == "node2"
    # instantiated (`[Node]`), because a BARE `g := tagged` determines nothing — that binding is now
    # refused at the read, Go-style. The value position this test guards is the one that WORKS.
    g := tagged[Node]
    assert g(Node(4)) == "node4"
    assert apply_tag(tagged, Node(3)) == "node3"

test fn a_generic_that_never_constructs_can_be_a_spawn_or_defer_target():
    seen := [1]
    fn body():
        defer tagged(Node(1))
        seen.push(2)
    body()
    parallel:
        spawn tagged(Node(2))
    assert seen == [1, 2]

# ---- M24 slice 2: witness FORWARDING ----
#
# A generic fn passes its OWN still-abstract type param's witness into another generic fn: the
# hidden argument stops being a constant and becomes a load of the caller's `$w:T` local. What has
# to hold at runtime is that the key threaded all the way down is the OUTERMOST concrete type —
# which is why every assert below checks the CONSTRUCTED value, not just that it compiled. Rust is
# the ancestor: `fn twice<U: Default>(x: U) -> U { reset(reset(x)) }` answers the same.

fn twice[U: Default](x: U) -> U:
    return reset(reset(x))

test fn a_generic_forwards_its_own_witness_into_another_generic():
    assert twice(Counter(9)).n == 0
    # the SAME `twice` with a different outer type — the forwarded key follows the caller's argument
    assert twice(Tag("hi")).s == "none"

# three levels, the leaf declared LAST: the charge is a fixpoint over the module, not a source-order
# sweep, so `lvl1` must be charged even though `lvl3` is not yet known when `lvl1` is hoisted.
fn lvl1[T: Default](x: T) -> T:
    return lvl2(x)

fn lvl2[T: Default](x: T) -> T:
    return lvl3(x)

fn lvl3[T: Default](x: T) -> T:
    return T.default()

test fn a_witness_forwards_transitively_through_three_generics():
    assert lvl1(Counter(5)).n == 0
    assert lvl1(Tag("z")).s == "none"

# TWO witness params on one forwarding fn: the hidden args are positional, so the SECOND slot must
# reach the second type param.
fn first_of_two[T: Default, U: Default](a: T, b: U) -> T:
    return reset(a)

fn second_of_two[T: Default, U: Default](a: T, b: U) -> U:
    return reset(b)

test fn a_forward_picks_the_right_witness_slot_of_two():
    assert first_of_two(Counter(1), Tag("x")).n == 0
    assert second_of_two(Counter(1), Tag("x")).s == "none"
    # …and with the two hosts swapped, so a slot mix-up cannot pass by coincidence
    assert first_of_two(Tag("x"), Counter(1)).s == "none"
    assert second_of_two(Tag("x"), Counter(1)).n == 0

# a forwarding call whose callee ALSO takes real value args — the hidden witness must stay LAST
fn mk_fwd[T: Conv](seed: T, n: int) -> T:
    return mk(seed, n + 1)

test fn a_forwarded_witness_stays_after_the_real_arguments():
    assert mk_fwd(Wrap(0), 20).v == 42

# a fn forwarding its own witness to ITSELF
fn rec[T: Default](x: T, n: int) -> T:
    if n <= 0:
        return T.default()
    return rec(x, n - 1)

test fn a_recursive_generic_forwards_its_own_witness():
    assert rec(Counter(5), 3).n == 0
    assert rec(Tag("a"), 4).s == "none"

# mutual recursion between two forwarding fns
fn ping[T: Default](x: T, n: int) -> T:
    if n <= 0:
        return reset(x)
    return pong(x, n - 1)

fn pong[T: Default](x: T, n: int) -> T:
    return ping(x, n - 1)

test fn mutually_recursive_generics_forward_a_witness():
    assert ping(Counter(3), 5).n == 0
    assert ping(Tag("q"), 4).s == "none"

# ---- a witness call that is the ROOT of an interpolation fragment ----
#
# `"{reset(c)}"` (no trailing `.field`) keyed the witness under the STRING LITERAL's span in the
# checker — which re-anchors a fragment root there so errors point at the literal — while the
# compiler still looked it up under the fragment-relative span. `chezzi check` passed and the run
# died with `internal: no static-type witness recorded`. Both halves of the key must agree.

fn fwd_interp[T: Default](x: T) -> str:
    return "{reset(x)}"

test fn an_interpolation_fragment_root_is_a_real_call_site():
    c := Counter(9)
    assert "{reset(c)}" == "Counter(n=0)"
    assert fwd_interp(Tag("hi")) == "Tag(s='none')"

# ---- SIBLING nested interpolations must not alias their witness keys ----
#
# A `{…}` fragment is re-lexed from its own source against the enclosing literal's position map, so
# every fragment token span is the REAL physical source position of that char. Two distinct source
# chars are two distinct positions, so two fragments cannot share a `WitnessTable` key — the
# non-aliasing property is now a property of the FILE, not of any arithmetic.
#
# It was not always. When only the LINE was re-anchored, every fragment restarted at column 1, the
# two inner literals below shared a span, their two `reset` calls shared a key, and the second entry
# overwrote the first: `chezzi check` stayed green and the program printed
# `Tag(s='none')Tag(s='none')` — a SILENT WRONG VALUE, not a fault. Both orders are asserted so a
# last-one-wins alias cannot pass by coincidence.

fn sib_in_generic[T: Default](x: T, c: Counter) -> str:
    return "{ \"{reset(c)}\" }{ \"{T.default()}\" }"

test fn two_sibling_nested_fragments_keep_their_own_witness():
    c := Counter(5)
    t := Tag("z")
    assert "{ \"{reset(c)}\" }{ \"{reset(t)}\" }" == "Counter(n=0)Tag(s='none')"
    assert "{ \"{reset(t)}\" }{ \"{reset(c)}\" }" == "Tag(s='none')Counter(n=0)"

test fn a_double_nested_fragment_keeps_its_own_witness():
    c := Counter(5)
    t := Tag("z")
    assert "{ \"{ \\\"{reset(c)}\\\" }\" }{ \"{reset(t)}\" }" == "Counter(n=0)Tag(s='none')"

test fn sibling_nested_fragments_inside_a_generic_fn():
    assert sib_in_generic(Tag("z"), Counter(5)) == "Counter(n=0)Tag(s='none')"

test fn a_nested_fragment_past_a_newline_keeps_its_own_witness():
    # A fragment may span a newline — brackets suppress layout, so this lexes and runs. The two
    # inner literals sit on the same physical line here (the `\n` is an ESCAPE, one content char),
    # at different columns, so they key apart. Under the old fragment-relative column both second
    # halves landed on `(line + 1, col 1)`, shared a `WitnessTable` key, and both printed the last
    # one's type. Same silent-wrong-value class as the sibling case above, one line further in.
    assert "{['x',\n'{reset(Counter(5)).n}']}{['x',\n'{reset(Tag(\"z\")).s}']}" == "['x', '0']['x', 'none']"

test fn sibling_nested_fragments_separated_by_an_escape_keep_their_own_witness():
    # M24-6: an ESCAPE between two siblings is where a "record a position at newlines only" map
    # drifts — `\t` is TWO source chars for one content char, so the second sibling's real column is
    # one further right than any count over the post-escape payload says. Drift far enough and a
    # nested fragment lands on a neighbour's key. Both orders, for the same reason as above.
    c := Counter(5)
    t := Tag("z")
    assert "{ \"{reset(c)}\" }\t{ \"{reset(t)}\" }" == "Counter(n=0)\tTag(s='none')"
    assert "{ \"{reset(t)}\" }\t{ \"{reset(c)}\" }" == "Tag(s='none')\tCounter(n=0)"

test fn sibling_nested_fragments_across_a_real_newline_keep_their_own_witness():
    # …and a REAL newline between two siblings inside a `"""` literal: the second sibling's column
    # restarts at 1 on a NEW physical line, which is exactly the shape the old design could not
    # allow (resetting the column aliased the two). Real positions make the reset safe, because the
    # LINE differs. Both orders again.
    c := Counter(5)
    t := Tag("z")
    assert """{ "{reset(c)}" }
{ "{reset(t)}" }""" == "Counter(n=0)\nTag(s='none')"
    assert """{ "{reset(t)}" }
{ "{reset(c)}" }""" == "Tag(s='none')\nCounter(n=0)"

test fn a_keyword_argument_survives_a_nested_fragment():
    # `KeywordTable` is keyed by (string span, fragment ordinal) and rides the same re-lexed spans
    assert "{ \"{greet(1, b=2)}\" }" == "1-2"
    assert "{ \"{greet(1, b=2)}\" }{ \"{greet(3, b=4)}\" }" == "1-23-4"

# ---- two witness calls in ONE interpolation fragment ----
#
# `WitnessTable::calls` is keyed by the call node's span. The checker used to re-anchor a fragment's
# ROOT expression at the string literal's span for diagnostics, which (a) hid the root's own entry
# from the compiler and (b) COLLIDED with any nested call whose fragment-relative column equalled the
# literal's column — the nested call then silently took the root's witness under a green
# `chezzi check`. Nothing is re-anchored now and every span is a real physical position, so neither
# half of that can recur; the assert below keeps the exact layout that used to collide as the
# regression net (`    s := "` puts the literal at column 10; `reset` sat at fragment column 10).

fn outer_w[T: Default](x: T, ignored: Counter) -> str:
    y := T.default()
    return "{ignored.n}"

test fn two_witness_calls_in_one_interpolation_fragment_keep_their_own_witnesses():
    c := Counter(5)
    t := Tag("hi")
    s := "{outer_w(t, reset(c))}"
    assert s == "0", "the nested `reset(c)` must construct a Counter, not the outer call's Tag"

# ---- M24 Task 5: a witness for a type param declared BY A MEMBER ----
#
# `fn make[T: Default](self, old: T) -> T` declares `[T]` on the METHOD, so the hidden witness rides
# on the METHOD's own frame exactly as it does on a free fn's — instance methods, static methods
# (`Holder.build(x)`), enum hosts, and a generic host whose OWN param stays un-witnessed. Rust is the
# ancestor: `impl Holder { fn make<T: Default>(&self, _: T) -> T { T::default() } }` answers the same.
# Every case runs with TWO different concrete types, so a wrong witness cannot pass by coincidence.

struct Holder:
    v: int
    fn make[T: Default](self, old: T) -> T:
        return T.default()
    fn build[T: Default](old: T) -> T:
        return T.default()
    fn fwd[T: Default](self, x: T) -> T:
        return reset(x)
    fn tail[A, T: Default](self, a: A, t: T) -> T:
        return T.default()
    fn conv[T: Conv](self, n: int) -> T:
        return T.conv(n)

enum Host:
    One
    Two
    fn make[T: Default](self, old: T) -> T:
        return T.default()
    fn build[T: Default](old: T) -> T:
        return T.default()

struct Gen[K]:
    k: K
    fn make[T: Default](self, old: T) -> T:
        return T.default()
    fn build[T: Default](old: T) -> T:
        return T.default()

test fn a_generic_method_constructs_through_its_own_bound():
    h := Holder(1)
    assert h.make(Counter(9)).n == 0
    assert h.make(Tag("hi")).s == "none"

test fn a_generic_static_method_constructs_through_its_own_bound():
    assert Holder.build(Counter(9)).n == 0
    assert Holder.build(Tag("hi")).s == "none"

test fn a_method_turbofish_pins_the_witness():
    h := Holder(1)
    assert h.make[Counter](Counter(9)).n == 0
    assert Holder.build[Tag](Tag("hi")).s == "none"

test fn an_enum_hosts_a_witness_taking_member():
    e := Host.One
    assert e.make(Counter(9)).n == 0
    assert e.make(Tag("hi")).s == "none"
    assert Host.build(Counter(9)).n == 0
    assert Host.build(Tag("hi")).s == "none"

test fn a_generic_host_leaves_its_own_param_unwitnessed():
    g := Gen(7)
    assert g.make(Counter(9)).n == 0
    assert g.make(Tag("hi")).s == "none"
    assert g.k == 7
    assert Gen[int].build(Counter(9)).n == 0
    assert Gen[str].build(Tag("hi")).s == "none"

test fn a_witness_param_after_a_plain_one_keeps_its_slot():
    h := Holder(1)
    assert h.tail("a", Counter(9)).n == 0
    assert h.tail(5, Tag("hi")).s == "none"

test fn a_member_witness_takes_arguments():
    h := Holder(1)
    assert h.conv[Wrap](21).v == 42

test fn a_method_forwards_its_own_witness_into_a_free_generic():
    h := Holder(1)
    assert h.fwd(Counter(9)).n == 0
    assert h.fwd(Tag("hi")).s == "none"

test fn two_witness_method_calls_chain_without_sharing_a_key():
    h := Holder(1)
    assert h.make(Counter(9)).n == 0
    assert h.make(h.make(Tag("hi"))).s == "none"

# a member witness call inside an interpolation fragment — the fragment key seam broke twice in this
# milestone (once per half), and a member call keys on its own method-name token
struct Frag:
    v: int
    fn make[T: Default](self, old: T) -> T:
        return T.default()
    fn show[T: Default](self, x: T) -> str:
        return "{reset(x)}|{self.make(x)}"

test fn a_member_witness_call_inside_an_interpolation_fragment():
    f := Frag(1)
    assert "{f.make(Counter(9)).n}" == "0"
    assert f.show(Counter(9)) == "Counter(n=0)|Counter(n=0)"
    assert f.show(Tag("hi")) == "Tag(s='none')|Tag(s='none')"

# a member forwarding into ITSELF and into another instance's method: the witness stops being a
# constant and becomes a load of the member frame's own `$w:T`
struct Rec:
    v: int
    fn down[T: Default](self, x: T, n: int) -> T:
        if n <= 0:
            return T.default()
        return self.down(x, n - 1)
    fn hop[T: Default](self, x: T) -> T:
        y := T.default()
        return Rec(2).down(x, 1)

test fn a_member_forwards_its_own_witness_into_a_member():
    r := Rec(1)
    assert r.down(Counter(9), 3).n == 0
    assert r.down(Tag("hi"), 2).s == "none"
    assert r.hop(Counter(9)).n == 0
    assert r.hop(Tag("hi")).s == "none"

# TWO witness params on one member, on a GENERIC host: the hidden args are positional, so the second
# slot must reach the second type param — checked with the two hosts swapped
struct Pair[K]:
    a: K
    b: K
    fn both[T: Default, U: Default](self, x: T, y: U) -> str:
        p := T.default()
        q := U.default()
        return "{p}/{q}"

test fn two_member_witness_params_keep_their_declaration_order():
    p := Pair(1, 2)
    assert p.both(Counter(1), Tag("x")) == "Counter(n=0)/Tag(s='none')"
    assert p.both(Tag("x"), Counter(1)) == "Tag(s='none')/Counter(n=0)"

# a `defer`/`spawn` target that is a chained VALUE call (`f(a)(b)`): `parse_postfix` gives the outer
# link the same span as its head, so the head's own witness call must NOT be mistaken for the target.
# The head runs eagerly at the `defer`/`spawn` statement — before the body — and its witness is an
# ordinary constant pushed in this frame.
fn chain_sink[T: Default](old: T, sink: List[str]) -> fn(int) -> int:
    sink.push("{T.default()}")
    return fn(k: int) -> int: k

test fn a_deferred_value_call_keeps_its_head_links_witness():
    sink: List[str] = []
    fn body():
        defer chain_sink(Counter(9), sink)(5)
        sink.push("body")
    body()
    assert sink == ["Counter(n=0)", "body"]
    sink2: List[str] = []
    fn body2():
        defer chain_sink(Tag("hi"), sink2)(5)
        sink2.push("body")
    body2()
    assert sink2 == ["Tag(s='none')", "body"]

test fn a_spawned_value_call_keeps_its_head_links_witness():
    sink: List[str] = []
    parallel:
        spawn chain_sink(Counter(9), sink)(5)
    assert sink == ["Counter(n=0)"]

# ===== M24-5 — a witness-taking generic as the `spawn`/`defer` STATEMENT TARGET =====
#
# `defer reset(c)` / `spawn reset(c)` used to be REFUSED ("'reset' takes a static-protocol bound (T),
# so it cannot be the target of `defer` yet"): the four dedicated emit sites (`Op::SpawnCall` /
# `SpawnMethod` / `DeferCall` / `DeferMethod`) pushed no hidden argument, so the call would have
# lowered one `argc` short. They push it now — TRAILING, exactly as `Op::Call`/`CallMethod` do — and
# the VM needed nothing: `do_defer`/`do_spawn` are argc-generic and a witness is a plain `str`, so it
# deep-copies across the spawn airlock like any other sendable value.
#
# Go is the ancestor and accepts both (measured 2026-08-14, Go 1.26.5 — `defer reset(c, "defer")`
# plus `go reset(c, "go")` on `func reset[T Defaulter[T]]` print `go reset ran -> {7}`,
# `main body done`, `defer reset ran -> {7}`: the deferred call runs AFTER the body).
#
# Every case asserts the CONSTRUCTED value with TWO concrete types — a mis-ordered witness would
# still RUN the call and merely build the wrong type.

fn reset_into[T: Default](old: T, sink: List[str]) -> T:
    v := T.default()
    sink.push("{v}")
    return v

fn reset_send[T: Default](old: T, ch: Channel[str]):
    ch.send("{T.default()}")

struct Recorder:
    k: int
    fn note[T: Default](self, old: T, sink: List[str]) -> T:
        v := T.default()
        sink.push("{self.k}:{v}")
        return v
    fn emit[T: Default](self, old: T, ch: Channel[str]):
        ch.send("{self.k}:{T.default()}")

test fn a_deferred_witness_call_constructs_the_callers_type():
    sink: List[str] = []
    fn body():
        defer reset_into(Counter(9), sink)
        defer reset_into(Tag("hi"), sink)
        sink.push("body")
    body()
    # the body runs first (Go's ordering), then the deferrals LIFO
    assert sink == ["body", "Tag(s='none')", "Counter(n=0)"]

test fn a_spawned_witness_call_constructs_the_callers_type():
    ch := Channel[str](4)
    parallel:
        spawn reset_send(Counter(9), ch)
    assert ch.recv() == "Counter(n=0)"
    parallel:
        spawn reset_send(Tag("hi"), ch)
    assert ch.recv() == "Tag(s='none')"

test fn a_keyword_spelled_deferred_witness_call_keeps_its_witness_last():
    # the hidden argument is TRAILING, so it must land after the arguments have been permuted into
    # their declared slots — including when they are spelled out of order
    sink: List[str] = []
    fn body():
        defer reset_into(old=Counter(9), sink=sink)
        defer reset_into(sink=sink, old=Tag("hi"))
    body()
    assert sink == ["Tag(s='none')", "Counter(n=0)"]

test fn a_deferred_member_witness_call_constructs_the_callers_type():
    sink: List[str] = []
    r := Recorder(4)
    fn body():
        defer r.note(Counter(9), sink)
        defer r.note(Tag("hi"), sink)
        sink.push("body")
    body()
    assert sink == ["body", "4:Tag(s='none')", "4:Counter(n=0)"]

test fn a_spawned_member_witness_call_constructs_the_callers_type():
    ch := Channel[str](4)
    r := Recorder(7)
    parallel:
        spawn r.emit(Counter(9), ch)
    assert ch.recv() == "7:Counter(n=0)"
    parallel:
        spawn r.emit(Tag("hi"), ch)
    assert ch.recv() == "7:Tag(s='none')"

# …and the target inside a GENERIC body, where the witness stops being a constant and becomes a
# FORWARD of the enclosing frame's own `$w:T` — for `spawn`, across the airlock.

fn defer_forward[T: Default](x: T, sink: List[str]):
    defer reset_into(x, sink)
    sink.push("body")

fn spawn_forward[T: Default](x: T, ch: Channel[str]):
    parallel:
        spawn reset_send(x, ch)

test fn a_deferred_target_forwards_the_enclosing_witness():
    sink: List[str] = []
    defer_forward(Counter(9), sink)
    defer_forward(Tag("hi"), sink)
    assert sink == ["body", "Counter(n=0)", "body", "Tag(s='none')"]

test fn a_spawned_target_forwards_the_enclosing_witness_across_the_airlock():
    ch := Channel[str](4)
    spawn_forward(Counter(9), ch)
    assert ch.recv() == "Counter(n=0)"
    spawn_forward(Tag("hi"), ch)
    assert ch.recv() == "Tag(s='none')"

# ===== Task 4 — the witness REACHES a nested body =====
#
# A closure, a nested `fn`, a `spawn:` block and a `defer:` block each compile to their own proto and
# capture only the FREE VARIABLES of their source text; `$w:T` is unspellable, so it is never free.
# `with_witness_captures` appends it to those capture entries unconditionally, so the nested body
# reads the witness out of its own capture env. It travels BY VALUE (a `str`) — which is what the
# escaping-closure cases below prove: they construct AFTER the defining frame is gone. Rust is the
# ancestor: a closure inside `fn f<T: Default>()` may call `T::default()`.
#
# Every case runs with TWO concrete types, so a witness that leaked from the wrong frame (or was read
# off a real operand) cannot pass by coincidence.

# ---- 1: a closure, including one that ESCAPES its defining fn ----

fn build[T: Default](x: T) -> fn() -> T:
    return fn(): T.default()

test fn a_closure_reaches_the_witness():
    f := fn(): reset(Counter(9))
    assert f().n == 0

test fn an_escaping_closure_carries_its_witness_by_value():
    mk_counter := build(Counter(9))
    mk_tag := build(Tag("hi"))
    # both defining frames are gone; each closure still knows its own type
    assert mk_counter().n == 0
    assert mk_tag().s == "none"

# ---- 2: a nested `fn` ----

fn via_nested[T: Default](x: T) -> T:
    fn inner() -> T:
        return T.default()
    return inner()

test fn a_nested_fn_reaches_the_witness():
    assert via_nested(Counter(9)).n == 0
    assert via_nested(Tag("hi")).s == "none"

# ---- 3: a `defer:` block, and a `defer` of a closure that constructs ----

fn defer_block[T: Default](x: T, sink: List[str]):
    defer:
        sink.push("{T.default()}")
    sink.push("body")

fn defer_closure[T: Default](x: T, sink: List[str]):
    mk := fn() -> T: T.default()
    defer sink.push("{mk()}")
    sink.push("body")

test fn a_defer_block_reaches_the_witness():
    sink: List[str] = []
    defer_block(Counter(9), sink)
    defer_block(Tag("hi"), sink)
    assert sink == ["body", "Counter(n=0)", "body", "Tag(s='none')"]

test fn a_deferred_closure_reaches_the_witness():
    sink: List[str] = []
    defer_closure(Counter(9), sink)
    defer_closure(Tag("hi"), sink)
    assert sink == ["body", "Counter(n=0)", "body", "Tag(s='none')"]

# ---- 4: a `spawn:` block — the witness `str` deep-copies across the airlock ----

fn spawn_block[T: Default](x: T, ch: Channel[str]):
    parallel:
        spawn:
            ch.send("{T.default()}")

test fn a_spawn_block_reaches_the_witness():
    ch := Channel[str](4)
    spawn_block(Counter(9), ch)
    assert ch.recv() == "Counter(n=0)"
    spawn_block(Tag("hi"), ch)
    assert ch.recv() == "Tag(s='none')"

# a nested `fn` whose body spawns: the block reads the witness the nested fn itself only CAPTURED
# (`CapSrc::Captured`), one hop further from the declaring frame
fn spawn_from_nested[T: Default](x: T, ch: Channel[str]):
    fn go():
        parallel:
            spawn:
                ch.send("{T.default()}")
    go()

test fn a_spawn_block_two_frames_down_reaches_the_witness():
    ch := Channel[str](4)
    spawn_from_nested(Counter(9), ch)
    assert ch.recv() == "Counter(n=0)"
    spawn_from_nested(Tag("hi"), ch)
    assert ch.recv() == "Tag(s='none')"

# ---- 5: a closure that FORWARDS `T` into another generic instead of constructing ----

fn fwd_from_closure[T: Default](x: T) -> fn() -> T:
    return fn(): reset(x)

test fn a_closure_forwards_the_witness_into_another_generic():
    assert fwd_from_closure(Counter(9))().n == 0
    assert fwd_from_closure(Tag("hi"))().s == "none"

# ---- 6: TWO witnesses reachable inside ONE nested body (positional capture order) ----

fn both_in_one_closure[T: Default, U: Default](a: T, b: U) -> str:
    f := fn() -> str: "{T.default()}/{U.default()}"
    return f()

test fn two_witnesses_reach_one_nested_body_in_order():
    assert both_in_one_closure(Counter(1), Tag("x")) == "Counter(n=0)/Tag(s='none')"
    assert both_in_one_closure(Tag("x"), Counter(1)) == "Tag(s='none')/Counter(n=0)"

# ---- 7: a closure INSIDE a closure (the inner one reads a capture, not a local) ----

fn twice_nested[T: Default](x: T) -> fn() -> fn() -> T:
    return fn(): fn(): T.default()

test fn a_closure_inside_a_closure_reaches_the_witness():
    assert twice_nested(Counter(9))()().n == 0
    assert twice_nested(Tag("hi"))()().s == "none"

# ---- 8: a MEMBER-level `[T]` reaching a closure in that method's body ----

struct Nest:
    k: int
    fn go[T: Default](self, x: T) -> str:
        f := fn() -> str: "{T.default()}"
        return f()
    fn deep[T: Default](self, x: T, ch: Channel[str]):
        parallel:
            spawn:
                ch.send("{T.default()}")

test fn a_member_witness_reaches_a_closure_in_its_own_body():
    n := Nest(1)
    assert n.go(Counter(9)) == "Counter(n=0)"
    assert n.go(Tag("hi")) == "Tag(s='none')"

test fn a_member_witness_reaches_a_spawn_block_in_its_own_body():
    n := Nest(1)
    ch := Channel[str](4)
    n.deep(Counter(9), ch)
    assert ch.recv() == "Counter(n=0)"
    n.deep(Tag("hi"), ch)
    assert ch.recv() == "Tag(s='none')"

# ---- a generator: the `$w:T` local lives in a suspended frame, and its closure still reads it ----

fn gen_defaults[T: Default](x: T, n: int) -> Iterator[T]:
    f := fn() -> T: T.default()
    for i in range(n):
        yield f()

test fn a_generators_closure_reaches_the_witness():
    out: List[int] = []
    for c in gen_defaults(Counter(9), 2):
        out.push(c.n)
    assert out == [0, 0]
    names: List[str] = []
    for t in gen_defaults(Tag("hi"), 2):
        names.push(t.s)
    assert names == ["none", "none"]

# ---- the KEY is the CALLEE TOKEN, not the call node ----
#
# `WitnessKey`'s span component used to be the CALL NODE's span, on the premise that a witness call
# is always the head link of its postfix chain. `|>` breaks that premise: it desugars at PARSE time
# into a plain `Call` that inherits the WHOLE infix expression's span, so every link of
# `a |> f() |> g()` carried the same `(line, col)` and the second link silently took the first's
# witness — a wrong VALUE under a green `chezzi check`, invisible to two-engine parity because both
# engines read the same aliased table. The callee token is distinct per link, so it is the key.

# Each link STAMPS its own witness into the value, so a link that took its neighbour's witness
# changes the answer — an assert that only looked at the LAST link would pass on the aliased table.

fn tag_of[T: Default](x: T) -> Tag:
    return Tag("{T.default()}")

fn name_of[U: Default](u: U) -> str:
    return "{U.default()}+{u}"

test fn a_pipe_chain_gives_each_link_its_own_witness():
    # link 1 sees Counter (so its Tag carries "Counter(n=0)"), link 2 sees Tag
    assert (Counter(1) |> tag_of() |> name_of()) == "Tag(s='none')+Tag(s='Counter(n=0)')"
    # …and the same chain written as nested calls must answer identically
    assert name_of(tag_of(Counter(1))) == "Tag(s='none')+Tag(s='Counter(n=0)')"

test fn a_pipe_chain_with_two_different_protocols():
    # the harder half: link 2's bound is a protocol link 1's witness does not satisfy, so an aliased
    # key is not a wrong value but a hard fault ("type 'Wrap' has no static method 'default'").
    assert (Counter(1) |> to_wrap() |> conv_of()) == "Wrap(v=4)+Wrap(v=12)"

fn to_wrap[T: Default](x: T) -> Wrap:
    return Wrap("{T.default()}".len())

fn conv_of[U: Conv](u: U) -> str:
    return "{U.conv(2)}+{u}"

test fn a_pipe_chain_repeating_one_callee_keeps_both_links():
    # the same callee twice — two entries under one callee NAME, distinct callee TOKENS
    assert (Counter(1) |> reset() |> reset()).n == 0
    assert (Tag("hi") |> reset() |> reset()).s == "none"

test fn a_pipe_chain_inside_an_interpolation_fragment():
    assert "{Counter(1) |> tag_of() |> name_of()}" == "Tag(s='none')+Tag(s='Counter(n=0)')"

# ---- a type param that SHADOWS a real type name: the PARAM wins, in both halves ----
#
# `fn f[Item: Tagged](x: Item) -> int: return Item.tag()` next to a `struct Item` is Rust's
#   trait D { fn tag() -> i32; }
#   fn f<Item: D>(_x: Item) -> i32 { Item::tag() }
# which prints `1` for `f(Counter)` — the type parameter shadows the outer type (measured with
# rustc, 2026-08-10). Chezzi answered `7` (the struct) because the checker's struct arm ran before
# its type-param arm and the compiler's witness arm was moved last to match. Both halves agreeing on
# the answer the owning ancestor rejects is not a defense: the type param now wins in BOTH.

struct Shadowed:
    q: int
    fn tag() -> int:
        return 7
    fn default() -> Shadowed:
        return Shadowed(9)

fn shadowing[Shadowed: Tagged](x: Shadowed) -> int:
    return Shadowed.tag()

fn shadowing_builds[Shadowed: Default](x: Shadowed) -> Shadowed:
    return Shadowed.default()

test fn a_type_param_shadows_a_type_name_of_the_same_name():
    # `Counter.tag()` is 1, `Shadowed.tag()` is 7 — the argument's type decides, like Rust
    assert shadowing(Counter(1)) == 1
    assert shadowing(Tag("hi")) == 3
    # …and the ANNOTATION position binds the same `Shadowed` (the param), so passing a Counter fits
    assert shadowing_builds(Counter(1)).n == 0
    # the shadowed STRUCT is still reachable by its own name, from an unshadowed scope
    assert Shadowed.tag() == 7
    # …and a NESTED body resolves the same shadowing param — the checker's `type_params` and the
    # compiler's captured `$w:Shadowed` must agree there too, not just in the declaring frame
    assert shadowing_nested(Counter(1)) == 1

fn shadowing_nested[Shadowed: Tagged](x: Shadowed) -> int:
    f := fn() -> int: Shadowed.tag()
    return f()

# …and the shadow is a RULE that holds in EVERY type-name position, not one spelling. The type-level
# turbofish, the bare constructor and a nullary enum variant used to keep reaching the shadowed type,
# so `Item.tag() * 100 + Item[int].tag()` answered `107` — one name, two meanings, in one expression.
# All three are now the parameter, hence rejected (`src/checker/tests.rs`, which is where a
# compile-time rejection belongs). What RUNS here is the other half of the same rule: outside a
# shadowing scope every one of those spellings still reaches the type, unchanged.

struct Gsh[K]:
    q: K
    fn tag() -> int:
        return 7

fn gshadowing[Gsh: Tagged](x: Gsh) -> int:
    return Gsh.tag()

test fn the_shadow_rule_leaves_every_unshadowed_position_alone():
    # inside the shadowing scope the bound param answers, never the generic struct's 7
    assert gshadowing(Counter(1)) == 1
    assert gshadowing(Tag("hi")) == 3
    # outside it, the same three positions still name the struct/enum
    assert Gsh[int](3).q == 3
    assert Gsh[int].tag() == 7
    assert Col.Red != Col.Blue

# ---- a witness call inside a NESTED interpolation ----
#
# The fragment ROOT is re-anchored at the string literal for DIAGNOSTICS. When that anchor was
# written onto a cloned node's `span`, a fragment root that is ITSELF a string carried the outer
# literal's span into the inner interpolation's fragment key, while the compiler kept the inner
# literal's real span — `chezzi check` passed and the run died with `internal: no static-type
# witness recorded`. A span used as a cross-half table key must not double as a diagnostic anchor:
# the anchor is now carried beside the AST, never written into it.

test fn a_witness_call_inside_a_nested_interpolation_keeps_its_key():
    c := Counter(1)
    assert "{ \"{reset(c).n}\" }" == "0"
    # the same shape one level deeper still — the anchor is saved/restored per nesting level
    assert "{ \"{ \\\"{reset(c).n}\\\" }\" }" == "0"

test fn a_keyword_call_inside_a_nested_interpolation_keeps_its_key():
    # the KeywordTable twin of the case above — it keys off the same fragment context
    assert "{ \"{greet(1, b=2)}\" }" == "1-2"

# ---- M24-5b: a STATIC-METHOD head is an ordinary `defer` / `spawn` statement target ----
#
# `print(H.build(3))` worked, `defer print(H.build(4))` worked, `defer H.build(4)` did not — it
# panicked the compiler ("global 'H' has no slot"), because `Op::DeferMethod` holds a RECEIVER value
# and a type name is not one. That inconsistency is internal to Chezzi, and Go agrees with the side
# that works (`defer pkg.F(x)`, `defer Holder.Make(h, 2)` — both measured, go1.26.5). It now lowers
# through a wrapper proto that replays the call, so every static spelling reaches the same bytecode
# its eager form emits. A CONSTRUCTOR head (`defer Col.Red`-style variant ctors) stays rejected, by
# the CHECKER, with the message the bare `defer P(3)` rule already uses — `src/checker/tests.rs`.

struct Bumper:
    n: int
    fn bump(box: Shared[int], by: int) -> int:
        box.update(fn(v: int) -> int: v + by)
        return by

struct Gbump[T]:
    n: int
    fn bump(box: Shared[int], by: int) -> int:
        box.update(fn(v: int) -> int: v * by)
        return by

fn deferred_static(box: Shared[int]):
    defer Bumper.bump(box, 3)
    box.set(1)

test fn a_static_method_head_is_a_defer_target():
    box := Shared(0)
    deferred_static(box)
    # the deferred static ran at frame exit, on the box the enclosing fn had set to 1
    assert box.get() == 4

fn deferred_static_lifo(box: Shared[int]):
    # LIFO, like every other `defer`: the SECOND registration runs FIRST, so 0 -> *10 -> +3
    defer Bumper.bump(box, 3)
    defer Gbump[str].bump(box, 10)
    box.set(2)

test fn defer_of_a_static_head_keeps_lifo_order_and_reaches_a_turbofish_head():
    box := Shared(0)
    deferred_static_lifo(box)
    assert box.get() == 23

fn deferred_static_snapshots_args(box: Shared[int]) -> int:
    n := 1
    defer Bumper.bump(box, n)
    n = 99
    return n

test fn a_deferred_static_head_snapshots_its_arguments_eagerly():
    box := Shared(0)
    # the argument was evaluated AT the `defer` (Go semantics), so the later `n = 99` is not seen
    assert deferred_static_snapshots_args(box) == 99
    assert box.get() == 1

test fn a_static_method_head_is_a_spawn_target():
    box := Shared(0)
    parallel:
        spawn Bumper.bump(box, 5)
        spawn Gbump[int].bump(box, 1)
    # both spawned statics ran and were joined by the nursery; *1 and +5 commute
    assert box.get() == 5

fn spawned_static_snapshots_args(box: Shared[int]) -> int:
    n := 7
    parallel:
        spawn Bumper.bump(box, n)
        n = 99
    return n

test fn a_spawned_static_head_snapshots_its_arguments_eagerly():
    box := Shared(0)
    assert spawned_static_snapshots_args(box) == 99
    assert box.get() == 7

# …and the CONSTRUCTED value the deferred static returns is the real one: a generic static reached
# through a type-level turbofish still builds its own type.

struct Boxed[T]:
    v: int
    fn make(o: int) -> Boxed[T]:
        return Boxed[T](o)

fn deferred_ctor_witness(box: Shared[int]):
    defer box.set(Boxed[str].make(9).v)

test fn a_deferred_turbofish_static_constructs_its_own_type():
    box := Shared(0)
    deferred_ctor_witness(box)
    assert box.get() == 9
    assert Boxed[int].make(4).v == 4

# The WITNESS head — `T.default()` inside a generic fn — is the same statement target, reached
# through the enclosing frame's hidden `$w:T` (captured into the wrapper exactly as a `defer:` block
# captures it). Two concrete types, so a wrong witness cannot pass by coincidence.

fn deferred_witness_static[T: Default](x: T, box: Shared[str]):
    defer box.set("{T.default()}")
    box.set("body")

test fn a_witness_static_head_is_a_defer_target():
    box := Shared("")
    deferred_witness_static(Counter(1), box)
    assert box.get() == "Counter(n=0)"
    deferred_witness_static(Tag("hi"), box)
    assert box.get() == "Tag(s='none')"

# ---- M24-1: a forward whose arguments are ALL concrete forwards nothing ----
#
# `concrete_only` calls the witness-taking `reset`, but with a `Counter` it builds itself: none of
# its own `T` flows in, so it is charged no hidden parameter and keeps the function-VALUE position
# an ordinary generic has. The checker half is `src/checker/tests.rs`
# (`witness_forwarding_with_only_concrete_arguments_does_not_charge_ok`); this is the half that
# proves the COMPILED proto's arity agrees — a value call pushes no witness, so a fn still compiled
# with one would read a shifted argument or fault.

fn concrete_only[T: Default](x: T) -> int:
    return reset(Counter(1)).n + 100

fn apply_counter(f: fn(Counter) -> int, x: Counter) -> int:
    return f(x)

test fn a_forward_with_only_concrete_arguments_stays_a_function_value():
    assert concrete_only(Counter(3)) == 100
    assert concrete_only(Tag("hi")) == 100
    g := concrete_only[Counter]
    assert g(Counter(3)) == 100
    assert apply_counter(concrete_only, Counter(4)) == 100

# …and the same forward in `spawn` / `defer` STATEMENT position. Un-charging changed how these
# LOWER, which is why they are worth their own tests: M24-5 had already made a charged fn a legal
# statement target by pushing its hidden witness after the declared args, so both spellings ran
# before (measured on `8922fba9`, the commit just before the narrowing: the equivalent standalone
# programs print the same). Now the same call sites push NO witness, against a proto without one —
# argc agreement nothing else in this file exercises from a statement target. Each assertion checks
# the CONSTRUCTED value, not just that the call ran: the forward builds `Tag`, the type of its own
# concrete argument, never the caller's `T` (`Counter`), so a witness threaded from the wrong side
# cannot pass by coincidence.

fn defaults_into[T: Default](x: T, box: Shared[str]) -> int:
    box.set(reset(Tag("x")).s)
    return 1

test fn an_uncharged_forward_is_a_spawn_target():
    box := Shared("")
    parallel:
        spawn defaults_into(Counter(3), box)
    assert box.get() == "none"

fn deferred_forward(box: Shared[str]) -> int:
    defer defaults_into(Counter(3), box)
    box.set("body")
    return 1

test fn an_uncharged_forward_is_a_defer_target():
    box := Shared("")
    assert deferred_forward(box) == 1
    # the deferred forward ran at frame exit, AFTER the body's own write
    assert box.get() == "none"

# The callee may also live in ANOTHER module. `wlib.renew` takes a witness, so pre-change a
# qualified call to it charged this fn whatever it passed; the qualified half now resolves the module
# bind and the callee name as one pair and asks the same concrete-argument question, so `Seed(1)`
# forwards nothing of `T`. The fn-VALUE spelling is the half that really flips: on `8922fba9` the
# equivalent standalone program spawned this shape fine (M24-5) and was still refused at
# `g := <the fn>` with "cannot be used as a function value: its bound on T requires a static
# protocol method…".

struct Seed:
    v: int
    fn fresh() -> Seed:
        return Seed(42)

fn cross_module_forward[T: Default](x: T, box: Shared[int]) -> int:
    box.set(wlib.renew(Seed(1)).v)
    return 1

test fn a_cross_module_concrete_forward_keeps_every_position():
    box := Shared(0)
    parallel:
        spawn cross_module_forward(Counter(3), box)
    assert box.get() == 42
    direct := Shared(0)
    g := cross_module_forward[Counter]
    assert g(Counter(4), direct) == 1
    assert direct.get() == 42

# ===== M24-2 — a nested body's witness capture must see through a SHADOWED module bind =====
#
# The free-name walk records `math.make[T](x)` as `(Some("math"), "make")` whether `math` is the
# imported std module or a PARAMETER that shadows it — its `bound` set holds only the names bound
# INSIDE the nested body. A capture predicate that reads that pair as a module qualification looks
# `make` up as a module-level fn of `std.math`, misses, drops `$w:T`, and the program dies with
# "internal: no type witness in scope to forward as 'T' into the call to 'make'" under a clean
# `chezzi check`. Any of `math time os io fs net json path log rand csv cmp iter string regex` is a
# plausible variable name, and a USER module bind (`lib`) shadows the same way — the multi-file half
# is `src/vm/tests.rs::m24_2_a_parameter_shadowing_a_user_module_keeps_the_witness`.

fn shadowed_module_forward[T: Default](math: Holder, x: T) -> T:
    seed := T.default()           # this is what charges the frame its `$w:T`
    f := fn(): math.make[T](x)    # the head is the PARAMETER, not `std.math`
    return f()

test fn a_parameter_shadowing_a_std_module_keeps_the_witness():
    assert shadowed_module_forward(Holder(1), Counter(9)).n == 0
    assert shadowed_module_forward(Holder(1), Tag("hi")).s == "none"

# ===== M24-2 — …and a TYPE whose name equals a module bind is the same question =====
#
# The head of `time.make[T](x)` is a `struct`/`enum` DECLARED HERE, which wins the name over the
# `import std.time` bind. A capture predicate that asks "does an enclosing VALUE binding shadow this
# module?" sees nothing — a type is in no value table — reads the head as `std.time`, misses `make`
# in that module's fns, and drops `$w:T`: clean `chezzi check`, then "internal: no type witness in
# scope to forward as 'T' into the call to 'make'". That is why the predicate stopped
# classifying the head at all: every field-headed call keeps every witness. The USER-module spelling
# (`import Shape` beside `struct Shape`) is the multi-file half, in
# `src/vm/tests.rs::m24_2_a_type_named_like_a_user_module_keeps_the_witness`.

struct time:
    k: int
    fn make[T: Default](x: T) -> T:
        return T.default()

fn type_named_like_a_module_forward[T: Default](x: T) -> T:
    seed := T.default()          # this is what charges the frame its `$w:T`
    f := fn(): time.make[T](x)   # the head is the STRUCT above, not `std.time`
    return f()

test fn a_type_named_like_a_std_module_keeps_the_witness():
    assert type_named_like_a_module_forward(Counter(9)).n == 0
    assert type_named_like_a_module_forward(Tag("hi")).s == "none"

# ===== M24-2 — a body whose ONLY witness use is a MEMBER forward is CHARGED =====
#
# `h.make[T](x)` spells `T` as a type ARGUMENT (no free-name walk collects those) and heads the call
# with a RECEIVER (so it is no module-qualified `CallSite` either). Both of the forwarding charge's
# original channels are blind to it, so the fn was never charged a `$w:T` and its own call was then
# REJECTED — "no hidden type witness for 'T' is reachable at this call site" — leaving the program
# with no spelling at all. `Checker::witness_member_names` adds the member channel, keyed on the one
# coordinate the walk carries: the METHOD NAME. Both directions run below with TWO concrete types, so
# a wrong witness cannot pass by coincidence.

fn member_only_forward[T: Default](h: Holder, x: T) -> T:
    return h.make[T](x)

fn member_only_inferred[T: Default](h: Holder, x: T) -> T:
    return h.make(x)

fn member_only_in_a_closure[T: Default](h: Holder, x: T) -> T:
    f := fn(): h.make[T](x)
    return f()

test fn a_member_forward_is_charged_as_the_only_witness_use():
    assert member_only_forward(Holder(1), Counter(9)).n == 0
    assert member_only_forward(Holder(1), Tag("hi")).s == "none"
    # the same call without the turbofish — `T` is inferred from the ARGUMENT, still a forward
    assert member_only_inferred(Holder(1), Counter(9)).n == 0
    assert member_only_inferred(Holder(1), Tag("hi")).s == "none"
    # and through the M24-2 capture: the closure must carry the `$w:T` this charge created
    assert member_only_in_a_closure(Holder(1), Counter(9)).n == 0
    assert member_only_in_a_closure(Holder(1), Tag("hi")).s == "none"

# An argument does not have to BE the parameter — the charge reads every identifier in the argument
# expression at any depth, so `xs[0]` with `xs: List[T]` forwards too. Under-charging here is what
# the checker then has to refuse, so the reading is deliberately generous.

fn member_only_nested_arg[T: Default](h: Holder, xs: List[T]) -> T:
    return h.make(xs[0])

test fn a_member_forward_reads_idents_at_any_depth():
    assert member_only_nested_arg(Holder(1), [Counter(9)]).n == 0
    assert member_only_nested_arg(Holder(1), [Tag("hi")]).s == "none"

# The counterweight, and why the member channel is not just "any member call": a charge COSTS the fn
# its function-value / `spawn`-target positions, so a call that carries nothing of the CALLER's own
# — no type argument naming one of its type params, no argument mentioning a parameter annotated
# with one — must keep answering "not a forward", even though `make` is a witnessed method name on
# THREE other types in this file.

struct PlainMaker:
    v: int
    fn make(self, k: int) -> int:
        return k + self.v

fn concrete_member_call_keeps_its_value_position[T: Default](x: T, p: PlainMaker) -> int:
    return p.make(1)

fn apply_maker(f: fn(Counter, PlainMaker) -> int, p: PlainMaker) -> int:
    return f(Counter(1), p)

test fn a_concrete_member_call_does_not_charge_its_caller():
    assert apply_maker(concrete_member_call_keeps_its_value_position, PlainMaker(10)) == 11


# ===== M24-2 — the charge asks THIS call site, never a graph-wide method-name index =====
#
# `Bin.get` and `Sink.push` are witnessed methods whose names collide with BUILTIN methods on `Map`
# and `List`. A charge keyed on the method NAME, AND-folding pinnability across every declaration of
# that name, let one unpinnable `get` anywhere in the program poison `get` EVERYWHERE: `m.get("a")`
# — a `Map` lookup with no relation to any witness — charged `uses_builtin_get`, which then could
# not be read as a function value and the program stopped compiling ("'uses_builtin_get' cannot be
# used as a function value"). Nothing of the caller's own crosses either call, so neither charges.
# `Shared.get()` at the top of this file is the same collision, one builtin further away.

struct Bin:
    v: int
    fn get[T: Default](self) -> T:
        return T.default()

struct Sink:
    v: int
    fn push[T: Default](self) -> T:
        return T.default()

fn uses_builtin_get[T: Default](x: T, m: Map[str, int]) -> T:
    y := m.get("a")
    return x

fn uses_builtin_push[T: Default](x: T, xs: List[int]) -> T:
    xs.push(1)
    return x

fn apply_get(f: fn(Counter, Map[str, int]) -> Counter, m: Map[str, int]) -> int:
    return f(Counter(3), m).n

fn apply_push(f: fn(Counter, List[int]) -> Counter) -> int:
    return f(Counter(5), [1]).n

test fn a_builtin_member_call_does_not_charge_its_caller():
    assert apply_get(uses_builtin_get, {"a": 1}) == 3
    assert apply_push(uses_builtin_push) == 5
    # and the witnessed methods whose names they collide with still work
    assert Bin(1).get[Counter]().n == 0
    assert Sink(1).push[Tag]().s == "none"
