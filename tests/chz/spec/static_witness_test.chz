# tests/chz/spec/static_witness_test.chz — M24 slice A: a protocol's STATIC (no-`self`) requirement
# is callable through a generic bound.
#
# `fn reset[T: Default](old: T) -> T: return T.default()` used to be a hard checker error ("generics
# are erased, there is no concrete type to construct"). M24 threads the concrete type's runtime
# identity key as a hidden trailing argument on the generic fn, so `T.default()` dispatches to the
# real type. Rust is the ancestor here — `T::default()` under `fn reset<T: Default>(_: T) -> T` is
# the same program, and answers the same.
#
# This file is the RUNNING half. It is the only thing that proves the CHECKER's identity key equals
# the COMPILER's/VM's runtime key — a checker-only test passes even if the wrong type is
# constructed. The compile-time rejections (cross-module, forwarding, fn-as-value, unpinned `T`, a
# witness call inside a closure/`spawn:`/`defer:`/nested-fn/method) are `src/checker/tests.rs`
# (`// ===== M24` section), not here: they never reach a runtime.
# Serial==M:N is guarded by `test_runner::chz_suite_passes_both_engines`.

protocol Default:
    fn default() -> Self

struct Counter:
    n: int
    fn default() -> Counter:
        return Counter(0)

struct Tag:
    s: str
    fn default() -> Tag:
        return Tag("none")

enum Col:
    Red
    Blue
    fn default() -> Col:
        return Col.Blue

protocol Conv:
    fn conv(x: int) -> Self

struct Wrap:
    v: int
    fn conv(x: int) -> Wrap:
        return Wrap(x * 2)

struct Port:
    v: int
    fn convert(x: int) -> Port:
        return Port(x + 1)

fn reset[T: Default](old: T) -> T:
    return T.default()

fn empty[T: Default]() -> T:
    return T.default()

fn mk[T: Conv](seed: T, n: int) -> T:
    return T.conv(n)

fn make[T: Convert[int]](seed: T, n: int) -> T:
    return T.convert(n)

fn second_of[T: Default, U: Default](a: T, b: U) -> U:
    x := T.default()
    return U.default()

# ---- the driver shape ----

test fn a_static_requirement_dispatches_to_the_concrete_type():
    assert reset(Counter(9)).n == 0, "T.default() must build Counter, not the argument"

test fn two_different_concrete_types_flow_through_one_generic():
    # the identity key is per CALL SITE, so the same `reset` must answer differently here
    assert reset(Counter(9)).n == 0
    assert reset(Tag("hi")).s == "none"

test fn an_enum_can_host_the_static_requirement():
    assert reset(Col.Red) == Col.Blue

# ---- arguments, and the reserved `Convert[S]` bound ----

test fn a_static_requirement_takes_arguments():
    assert mk(Wrap(0), 21).v == 42

test fn the_reserved_convert_bound_dispatches_too():
    assert make(Port(0), 41).v == 42

# ---- pinning `T` without a value argument ----

test fn a_turbofish_pins_a_nullary_generic():
    assert empty[Counter]().n == 0
    assert empty[Tag]().s == "none"

test fn an_annotated_result_pins_a_nullary_generic():
    c: Counter = empty()
    assert c.n == 0

# ---- witness ORDER: two params, and the second one is the answer ----

test fn two_witness_params_keep_their_declaration_order():
    assert second_of(Counter(1), Tag("x")).s == "none", "U's witness must not be T's"
    assert second_of(Tag("x"), Counter(1)).n == 0

# ---- call sites the witness constant has to survive ----

test fn a_nested_call_site_gets_its_own_witness():
    assert reset(reset(Counter(9))).n == 0

test fn an_interpolation_fragment_is_a_real_call_site():
    assert "{reset(Counter(9)).n}" == "0"

test fn a_witness_call_site_inside_a_closure():
    f := fn(): reset(Counter(9)).n
    assert f() == 0

test fn a_witness_call_site_inside_a_spawn_block():
    ch := Channel[int](4)
    parallel:
        spawn:
            ch.send(reset(Counter(9)).n)
        spawn:
            ch.send(reset(Counter(5)).n)
    assert ch.recv() + ch.recv() == 0

test fn a_witness_call_site_inside_a_defer_block():
    seen := [1]
    fn body():
        defer:
            seen.push(reset(Counter(9)).n)
        seen.push(2)
    body()
    assert seen == [1, 2, 0]

# ---- the hidden parameter must not leak into anything that does not take one ----

fn biggest[T: Comparable](a: T, b: T) -> T:
    if a < b:
        return b
    return a

fn ident[T](x: T) -> T:
    return x

fn apply2(f: fn(int, int) -> int, a: int, b: int) -> int:
    return f(a, b)

test fn a_non_static_bound_is_untouched_and_still_a_function_value():
    assert biggest(3, 7) == 7
    assert apply2(biggest, 4, 1) == 4
    assert ident("hi") == "hi"

test fn a_nested_fn_does_not_inherit_a_module_fns_witness_arity():
    fn reset(k: int) -> int:
        return k * 10
    assert reset(4) == 40, "the nested `reset` is a plain 1-arg fn"

test fn a_keyword_argument_reaches_a_witness_call():
    # named args are normalized to positional by desugar BEFORE the witness lowering sees the call,
    # so the hidden trailing witness still lands last.
    assert reset(old=Counter(9)).n == 0

# ---- a witness is charged only to a body that uses one ----
#
# `Spawnable` carries a static requirement, but `tagged` never constructs — so it takes NO hidden
# param and keeps every position a plain generic fn has (value, HOF argument, `spawn`/`defer`).

protocol Spawnable:
    fn make() -> Self
    fn tag(self) -> str

struct Node:
    v: int
    fn make() -> Node:
        return Node(0)
    fn tag(self) -> str:
        return "node{self.v}"

fn tagged[T: Spawnable](x: T) -> str:
    return x.tag()

fn apply_tag(f: fn(Node) -> str, x: Node) -> str:
    return f(x)

test fn a_generic_that_never_constructs_stays_a_function_value():
    assert tagged(Node(2)) == "node2"
    g := tagged
    assert apply_tag(tagged, Node(3)) == "node3"

test fn a_generic_that_never_constructs_can_be_a_spawn_or_defer_target():
    seen := [1]
    fn body():
        defer tagged(Node(1))
        seen.push(2)
    body()
    parallel:
        spawn tagged(Node(2))
    assert seen == [1, 2]

# ---- M24 slice 2: witness FORWARDING ----
#
# A generic fn passes its OWN still-abstract type param's witness into another generic fn: the
# hidden argument stops being a constant and becomes a load of the caller's `$w:T` local. What has
# to hold at runtime is that the key threaded all the way down is the OUTERMOST concrete type —
# which is why every assert below checks the CONSTRUCTED value, not just that it compiled. Rust is
# the ancestor: `fn twice<U: Default>(x: U) -> U { reset(reset(x)) }` answers the same.

fn twice[U: Default](x: U) -> U:
    return reset(reset(x))

test fn a_generic_forwards_its_own_witness_into_another_generic():
    assert twice(Counter(9)).n == 0
    # the SAME `twice` with a different outer type — the forwarded key follows the caller's argument
    assert twice(Tag("hi")).s == "none"

# three levels, the leaf declared LAST: the charge is a fixpoint over the module, not a source-order
# sweep, so `lvl1` must be charged even though `lvl3` is not yet known when `lvl1` is hoisted.
fn lvl1[T: Default](x: T) -> T:
    return lvl2(x)

fn lvl2[T: Default](x: T) -> T:
    return lvl3(x)

fn lvl3[T: Default](x: T) -> T:
    return T.default()

test fn a_witness_forwards_transitively_through_three_generics():
    assert lvl1(Counter(5)).n == 0
    assert lvl1(Tag("z")).s == "none"

# TWO witness params on one forwarding fn: the hidden args are positional, so the SECOND slot must
# reach the second type param.
fn first_of_two[T: Default, U: Default](a: T, b: U) -> T:
    return reset(a)

fn second_of_two[T: Default, U: Default](a: T, b: U) -> U:
    return reset(b)

test fn a_forward_picks_the_right_witness_slot_of_two():
    assert first_of_two(Counter(1), Tag("x")).n == 0
    assert second_of_two(Counter(1), Tag("x")).s == "none"
    # …and with the two hosts swapped, so a slot mix-up cannot pass by coincidence
    assert first_of_two(Tag("x"), Counter(1)).s == "none"
    assert second_of_two(Tag("x"), Counter(1)).n == 0

# a forwarding call whose callee ALSO takes real value args — the hidden witness must stay LAST
fn mk_fwd[T: Conv](seed: T, n: int) -> T:
    return mk(seed, n + 1)

test fn a_forwarded_witness_stays_after_the_real_arguments():
    assert mk_fwd(Wrap(0), 20).v == 42

# a fn forwarding its own witness to ITSELF
fn rec[T: Default](x: T, n: int) -> T:
    if n <= 0:
        return T.default()
    return rec(x, n - 1)

test fn a_recursive_generic_forwards_its_own_witness():
    assert rec(Counter(5), 3).n == 0
    assert rec(Tag("a"), 4).s == "none"

# mutual recursion between two forwarding fns
fn ping[T: Default](x: T, n: int) -> T:
    if n <= 0:
        return reset(x)
    return pong(x, n - 1)

fn pong[T: Default](x: T, n: int) -> T:
    return ping(x, n - 1)

test fn mutually_recursive_generics_forward_a_witness():
    assert ping(Counter(3), 5).n == 0
    assert ping(Tag("q"), 4).s == "none"

# ---- a witness call that is the ROOT of an interpolation fragment ----
#
# `"{reset(c)}"` (no trailing `.field`) keyed the witness under the STRING LITERAL's span in the
# checker — which re-anchors a fragment root there so errors point at the literal — while the
# compiler still looked it up under the fragment-relative span. `chezzi check` passed and the run
# died with `internal: no static-type witness recorded`. Both halves of the key must agree.

fn fwd_interp[T: Default](x: T) -> str:
    return "{reset(x)}"

test fn an_interpolation_fragment_root_is_a_real_call_site():
    c := Counter(9)
    assert "{reset(c)}" == "Counter(n=0)"
    assert fwd_interp(Tag("hi")) == "Tag(s='none')"

# ---- two witness calls in ONE interpolation fragment ----
#
# `WitnessTable::calls` is keyed by the call node's span. The checker used to re-anchor a fragment's
# ROOT expression at the string literal's span for diagnostics, which (a) hid the root's own entry
# from the compiler and (b) COLLIDED with any nested call whose fragment-relative column equalled the
# literal's column — the nested call then silently took the root's witness under a green
# `chezzi check`. The trigger is column arithmetic, so the assert below pins the exact layout that
# used to collide (`    s := "` puts the literal at column 10; `reset` sits at fragment column 10).

fn outer_w[T: Default](x: T, ignored: Counter) -> str:
    y := T.default()
    return "{ignored.n}"

test fn two_witness_calls_in_one_interpolation_fragment_keep_their_own_witnesses():
    c := Counter(5)
    t := Tag("hi")
    s := "{outer_w(t, reset(c))}"
    assert s == "0", "the nested `reset(c)` must construct a Counter, not the outer call's Tag"

# ---- M24 Task 5: a witness for a type param declared BY A MEMBER ----
#
# `fn make[T: Default](self, old: T) -> T` declares `[T]` on the METHOD, so the hidden witness rides
# on the METHOD's own frame exactly as it does on a free fn's — instance methods, static methods
# (`Holder.build(x)`), enum hosts, and a generic host whose OWN param stays un-witnessed. Rust is the
# ancestor: `impl Holder { fn make<T: Default>(&self, _: T) -> T { T::default() } }` answers the same.
# Every case runs with TWO different concrete types, so a wrong witness cannot pass by coincidence.

struct Holder:
    v: int
    fn make[T: Default](self, old: T) -> T:
        return T.default()
    fn build[T: Default](old: T) -> T:
        return T.default()
    fn fwd[T: Default](self, x: T) -> T:
        return reset(x)
    fn tail[A, T: Default](self, a: A, t: T) -> T:
        return T.default()
    fn conv[T: Conv](self, n: int) -> T:
        return T.conv(n)

enum Host:
    One
    Two
    fn make[T: Default](self, old: T) -> T:
        return T.default()
    fn build[T: Default](old: T) -> T:
        return T.default()

struct Gen[K]:
    k: K
    fn make[T: Default](self, old: T) -> T:
        return T.default()
    fn build[T: Default](old: T) -> T:
        return T.default()

test fn a_generic_method_constructs_through_its_own_bound():
    h := Holder(1)
    assert h.make(Counter(9)).n == 0
    assert h.make(Tag("hi")).s == "none"

test fn a_generic_static_method_constructs_through_its_own_bound():
    assert Holder.build(Counter(9)).n == 0
    assert Holder.build(Tag("hi")).s == "none"

test fn a_method_turbofish_pins_the_witness():
    h := Holder(1)
    assert h.make[Counter](Counter(9)).n == 0
    assert Holder.build[Tag](Tag("hi")).s == "none"

test fn an_enum_hosts_a_witness_taking_member():
    e := Host.One
    assert e.make(Counter(9)).n == 0
    assert e.make(Tag("hi")).s == "none"
    assert Host.build(Counter(9)).n == 0
    assert Host.build(Tag("hi")).s == "none"

test fn a_generic_host_leaves_its_own_param_unwitnessed():
    g := Gen(7)
    assert g.make(Counter(9)).n == 0
    assert g.make(Tag("hi")).s == "none"
    assert g.k == 7
    assert Gen[int].build(Counter(9)).n == 0
    assert Gen[str].build(Tag("hi")).s == "none"

test fn a_witness_param_after_a_plain_one_keeps_its_slot():
    h := Holder(1)
    assert h.tail("a", Counter(9)).n == 0
    assert h.tail(5, Tag("hi")).s == "none"

test fn a_member_witness_takes_arguments():
    h := Holder(1)
    assert h.conv[Wrap](21).v == 42

test fn a_method_forwards_its_own_witness_into_a_free_generic():
    h := Holder(1)
    assert h.fwd(Counter(9)).n == 0
    assert h.fwd(Tag("hi")).s == "none"

test fn two_witness_method_calls_chain_without_sharing_a_key():
    h := Holder(1)
    assert h.make(Counter(9)).n == 0
    assert h.make(h.make(Tag("hi"))).s == "none"

# a member witness call inside an interpolation fragment — the fragment key seam broke twice in this
# milestone (once per half), and a member call keys on its own method-name token
struct Frag:
    v: int
    fn make[T: Default](self, old: T) -> T:
        return T.default()
    fn show[T: Default](self, x: T) -> str:
        return "{reset(x)}|{self.make(x)}"

test fn a_member_witness_call_inside_an_interpolation_fragment():
    f := Frag(1)
    assert "{f.make(Counter(9)).n}" == "0"
    assert f.show(Counter(9)) == "Counter(n=0)|Counter(n=0)"
    assert f.show(Tag("hi")) == "Tag(s='none')|Tag(s='none')"

# a member forwarding into ITSELF and into another instance's method: the witness stops being a
# constant and becomes a load of the member frame's own `$w:T`
struct Rec:
    v: int
    fn down[T: Default](self, x: T, n: int) -> T:
        if n <= 0:
            return T.default()
        return self.down(x, n - 1)
    fn hop[T: Default](self, x: T) -> T:
        y := T.default()
        return Rec(2).down(x, 1)

test fn a_member_forwards_its_own_witness_into_a_member():
    r := Rec(1)
    assert r.down(Counter(9), 3).n == 0
    assert r.down(Tag("hi"), 2).s == "none"
    assert r.hop(Counter(9)).n == 0
    assert r.hop(Tag("hi")).s == "none"

# TWO witness params on one member, on a GENERIC host: the hidden args are positional, so the second
# slot must reach the second type param — checked with the two hosts swapped
struct Pair[K]:
    a: K
    b: K
    fn both[T: Default, U: Default](self, x: T, y: U) -> str:
        p := T.default()
        q := U.default()
        return "{p}/{q}"

test fn two_member_witness_params_keep_their_declaration_order():
    p := Pair(1, 2)
    assert p.both(Counter(1), Tag("x")) == "Counter(n=0)/Tag(s='none')"
    assert p.both(Tag("x"), Counter(1)) == "Tag(s='none')/Counter(n=0)"

# a `defer`/`spawn` target that is a chained VALUE call (`f(a)(b)`): `parse_postfix` gives the outer
# link the same span as its head, so the head's own witness call must NOT be mistaken for the target.
# The head runs eagerly at the `defer`/`spawn` statement — before the body — and its witness is an
# ordinary constant pushed in this frame.
fn chain_sink[T: Default](old: T, sink: List[str]) -> fn(int) -> int:
    sink.push("{T.default()}")
    return fn(k: int) -> int: k

test fn a_deferred_value_call_keeps_its_head_links_witness():
    sink: List[str] = []
    fn body():
        defer chain_sink(Counter(9), sink)(5)
        sink.push("body")
    body()
    assert sink == ["Counter(n=0)", "body"]
    sink2: List[str] = []
    fn body2():
        defer chain_sink(Tag("hi"), sink2)(5)
        sink2.push("body")
    body2()
    assert sink2 == ["Tag(s='none')", "body"]

test fn a_spawned_value_call_keeps_its_head_links_witness():
    sink: List[str] = []
    parallel:
        spawn chain_sink(Counter(9), sink)(5)
    assert sink == ["Counter(n=0)"]

# ===== Task 4 — the witness REACHES a nested body =====
#
# A closure, a nested `fn`, a `spawn:` block and a `defer:` block each compile to their own proto and
# capture only the FREE VARIABLES of their source text; `$w:T` is unspellable, so it is never free.
# `with_witness_captures` appends it to those capture entries unconditionally, so the nested body
# reads the witness out of its own capture env. It travels BY VALUE (a `str`) — which is what the
# escaping-closure cases below prove: they construct AFTER the defining frame is gone. Rust is the
# ancestor: a closure inside `fn f<T: Default>()` may call `T::default()`.
#
# Every case runs with TWO concrete types, so a witness that leaked from the wrong frame (or was read
# off a real operand) cannot pass by coincidence.

# ---- 1: a closure, including one that ESCAPES its defining fn ----

fn build[T: Default](x: T) -> fn() -> T:
    return fn(): T.default()

test fn a_closure_reaches_the_witness():
    f := fn(): reset(Counter(9))
    assert f().n == 0

test fn an_escaping_closure_carries_its_witness_by_value():
    mk_counter := build(Counter(9))
    mk_tag := build(Tag("hi"))
    # both defining frames are gone; each closure still knows its own type
    assert mk_counter().n == 0
    assert mk_tag().s == "none"

# ---- 2: a nested `fn` ----

fn via_nested[T: Default](x: T) -> T:
    fn inner() -> T:
        return T.default()
    return inner()

test fn a_nested_fn_reaches_the_witness():
    assert via_nested(Counter(9)).n == 0
    assert via_nested(Tag("hi")).s == "none"

# ---- 3: a `defer:` block, and a `defer` of a closure that constructs ----

fn defer_block[T: Default](x: T, sink: List[str]):
    defer:
        sink.push("{T.default()}")
    sink.push("body")

fn defer_closure[T: Default](x: T, sink: List[str]):
    mk := fn() -> T: T.default()
    defer sink.push("{mk()}")
    sink.push("body")

test fn a_defer_block_reaches_the_witness():
    sink: List[str] = []
    defer_block(Counter(9), sink)
    defer_block(Tag("hi"), sink)
    assert sink == ["body", "Counter(n=0)", "body", "Tag(s='none')"]

test fn a_deferred_closure_reaches_the_witness():
    sink: List[str] = []
    defer_closure(Counter(9), sink)
    defer_closure(Tag("hi"), sink)
    assert sink == ["body", "Counter(n=0)", "body", "Tag(s='none')"]

# ---- 4: a `spawn:` block — the witness `str` deep-copies across the airlock ----

fn spawn_block[T: Default](x: T, ch: Channel[str]):
    parallel:
        spawn:
            ch.send("{T.default()}")

test fn a_spawn_block_reaches_the_witness():
    ch := Channel[str](4)
    spawn_block(Counter(9), ch)
    assert ch.recv() == "Counter(n=0)"
    spawn_block(Tag("hi"), ch)
    assert ch.recv() == "Tag(s='none')"

# a nested `fn` whose body spawns: the block reads the witness the nested fn itself only CAPTURED
# (`CapSrc::Captured`), one hop further from the declaring frame
fn spawn_from_nested[T: Default](x: T, ch: Channel[str]):
    fn go():
        parallel:
            spawn:
                ch.send("{T.default()}")
    go()

test fn a_spawn_block_two_frames_down_reaches_the_witness():
    ch := Channel[str](4)
    spawn_from_nested(Counter(9), ch)
    assert ch.recv() == "Counter(n=0)"
    spawn_from_nested(Tag("hi"), ch)
    assert ch.recv() == "Tag(s='none')"

# ---- 5: a closure that FORWARDS `T` into another generic instead of constructing ----

fn fwd_from_closure[T: Default](x: T) -> fn() -> T:
    return fn(): reset(x)

test fn a_closure_forwards_the_witness_into_another_generic():
    assert fwd_from_closure(Counter(9))().n == 0
    assert fwd_from_closure(Tag("hi"))().s == "none"

# ---- 6: TWO witnesses reachable inside ONE nested body (positional capture order) ----

fn both_in_one_closure[T: Default, U: Default](a: T, b: U) -> str:
    f := fn() -> str: "{T.default()}/{U.default()}"
    return f()

test fn two_witnesses_reach_one_nested_body_in_order():
    assert both_in_one_closure(Counter(1), Tag("x")) == "Counter(n=0)/Tag(s='none')"
    assert both_in_one_closure(Tag("x"), Counter(1)) == "Tag(s='none')/Counter(n=0)"

# ---- 7: a closure INSIDE a closure (the inner one reads a capture, not a local) ----

fn twice_nested[T: Default](x: T) -> fn() -> fn() -> T:
    return fn(): fn(): T.default()

test fn a_closure_inside_a_closure_reaches_the_witness():
    assert twice_nested(Counter(9))()().n == 0
    assert twice_nested(Tag("hi"))()().s == "none"

# ---- 8: a MEMBER-level `[T]` reaching a closure in that method's body ----

struct Nest:
    k: int
    fn go[T: Default](self, x: T) -> str:
        f := fn() -> str: "{T.default()}"
        return f()
    fn deep[T: Default](self, x: T, ch: Channel[str]):
        parallel:
            spawn:
                ch.send("{T.default()}")

test fn a_member_witness_reaches_a_closure_in_its_own_body():
    n := Nest(1)
    assert n.go(Counter(9)) == "Counter(n=0)"
    assert n.go(Tag("hi")) == "Tag(s='none')"

test fn a_member_witness_reaches_a_spawn_block_in_its_own_body():
    n := Nest(1)
    ch := Channel[str](4)
    n.deep(Counter(9), ch)
    assert ch.recv() == "Counter(n=0)"
    n.deep(Tag("hi"), ch)
    assert ch.recv() == "Tag(s='none')"

# ---- a generator: the `$w:T` local lives in a suspended frame, and its closure still reads it ----

fn gen_defaults[T: Default](x: T, n: int) -> Iterator[T]:
    f := fn() -> T: T.default()
    for i in range(n):
        yield f()

test fn a_generators_closure_reaches_the_witness():
    out: List[int] = []
    for c in gen_defaults(Counter(9), 2):
        out.push(c.n)
    assert out == [0, 0]
    names: List[str] = []
    for t in gen_defaults(Tag("hi"), 2):
        names.push(t.s)
    assert names == ["none", "none"]
