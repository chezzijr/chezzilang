# tests/chz/spec/conversions_test.chz — scalar constructor / conversion semantics.
#
# Ported from src/vm/parity_tests.rs (`scalar_ctor_conversions_parity`, `bool_ctor_parity`).
# Run: `cargo run -- test tests/chz/`. Gated by `test_runner::chz_suite_passes` (the M:N-engine gate).

test fn int_ctor():
    assert int("5") == 5
    assert int("-42") == -42
    assert int(3.9) == 3, "float -> int truncates toward zero"

test fn float_ctor():
    assert float("1.5") == 1.5
    assert float(2) == 2.0

test fn str_ctor():
    assert str(123) == "123"
    assert str(4.5) == "4.5"
    assert str(true) == "true"

test fn float_repr_breaks_an_exact_tie_to_even():
    # When the two shortest candidate reprs are EXACTLY equidistant from the value, CPython
    # (David Gay's dtoa) breaks the tie to EVEN. Rust's shortest formatter breaks it away from
    # zero, which used to leak straight into `str`/`print`/interpolation/`json.stringify`.
    # docs/gaps.md W7-32; every expected string below is a real CPython 3.14.6 `repr()`.
    assert str(771.5462036132812) == "771.5462036132812"     # exact 771.54620361328125
    assert str(1007730844620651.2) == "1007730844620651.2"   # exact 1007730844620651.25
    assert str(-887777373534812.25) == "-887777373534812.2"  # negative
    assert str(2.9802322387695312e-08) == "2.9802322387695312e-08"  # 2^-25, sci branch
    # NOT a tie: `5e-324`'s odd last digit is already CPython's answer even though `4e-324`
    # round-trips to the same float — it is farther from the value, so it must not be picked.
    assert str(5e-324) == "5e-324"
    assert str(0.1) == "0.1"
    # A tie whose EVEN candidate does not round-trip: 2^-24 is exactly 5.9604644775390625e-08,
    # but "5.960464477539062e-08" names a different float, so CPython keeps the odd digit.
    assert str(5.960464477539063e-8) == "5.960464477539063e-08"

test fn bytes_ctor():
    b := bytes([104, 105])
    assert b.len() == 2
    assert b[0] == 104
    assert b[1] == 105

test fn bytearray_ctor_and_push():
    ba := bytearray([65, 66])
    assert ba.len() == 2
    assert ba[0] == 65
    ba.push(67)
    assert ba.len() == 3
    assert ba[2] == 67

test fn bool_ctor():
    # int: 0 -> false, else true
    assert bool(0) == false
    assert bool(5) == true
    # float: 0.0 / -0.0 -> false; NaN -> true; else true
    assert bool(0.0) == false
    nz := 0.0
    assert bool(-nz) == false, "negative zero is falsy"
    nan := 0.0 / 0.0
    assert bool(nan) == true, "NaN is truthy (not a zero test)"
    assert bool(3.14) == true
    # bool: identity
    assert bool(true) == true
    assert bool(false) == false
    # str: "" -> false, any non-empty -> true (NOT a parse; " " is true)
    assert bool("") == false
    assert bool("x") == true
    assert bool(" ") == true, "whitespace is non-empty, so truthy"
