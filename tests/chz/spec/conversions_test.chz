# tests/chz/spec/conversions_test.chz — scalar constructor / conversion semantics.
#
# Ported from src/vm/golden_tests.rs (`scalar_ctor_conversions_parity`, `bool_ctor_parity`).
# Run: `cargo run -- test tests/chz/`. Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

test fn a_scalar_ctor_gives_the_zero_value():
    # Python `int()` 0, `float()` 0.0, `str()` '', `bool()` False, `bytes()` b''.
    assert int() == 0
    assert float() == 0.0
    assert str() == ""
    assert bool() == false
    assert bytes().len() == 0

test fn str_to_int():
    assert "5".to_int() == ?5
    assert "-42".to_int() == ?-42
    assert "x".to_int() == !"to_int: cannot parse 'x' as int"

test fn float_to_int_truncates_toward_zero():
    assert (3.9).to_int() == ?3
    assert (-3.9).to_int() == ?-3
    z := 0.0
    assert (z / z).to_int() == None, "NaN has no int"
    assert (1.0 / z).to_int() == None, "inf has no int"

test fn to_float():
    assert "1.5".to_float() == ?1.5
    assert (2).to_float() == 2.0

test fn interpolation_renders_a_scalar():
    n := 123
    assert "{n}" == "123"
    assert "{4.5}" == "4.5"
    assert "{true}" == "true"

test fn float_repr_breaks_an_exact_tie_to_even():
    # When the two shortest candidate reprs are EXACTLY equidistant from the value, CPython
    # (David Gay's dtoa) breaks the tie to EVEN. Rust's shortest formatter breaks it away from
    # zero, which used to leak straight into `str`/`print`/interpolation/`json.stringify`.
    # docs/contributing/gaps.md W7-32; every expected string below is a real CPython 3.14.6 `repr()`.
    assert "{771.5462036132812}" == "771.5462036132812"     # exact 771.54620361328125
    assert "{1007730844620651.2}" == "1007730844620651.2"   # exact 1007730844620651.25
    assert "{-887777373534812.25}" == "-887777373534812.2"  # negative
    assert "{2.9802322387695312e-08}" == "2.9802322387695312e-08"  # 2^-25, sci branch
    # NOT a tie: `5e-324`'s odd last digit is already CPython's answer even though `4e-324`
    # round-trips to the same float — it is farther from the value, so it must not be picked.
    assert "{5e-324}" == "5e-324"
    assert "{0.1}" == "0.1"
    # A tie whose EVEN candidate does not round-trip: 2^-24 is exactly 5.9604644775390625e-08,
    # but "5.960464477539062e-08" names a different float, so CPython keeps the odd digit.
    assert "{5.960464477539063e-8}" == "5.960464477539063e-08"

test fn bytes_ctor():
    b := bytes.from_iter([104, 105])
    assert b.len() == 2
    assert b[0] == 104
    assert b[1] == 105

test fn bytearray_ctor_and_push():
    ba := bytearray.from_iter([65, 66])
    assert ba.len() == 2
    assert ba[0] == 65
    ba.push(67)
    assert ba.len() == 3
    assert ba[2] == 67

test fn truth_is_an_explicit_test():
    # No bool conversion (Go, Rust): a number tests against zero, a str against its length.
    nz := 0.0
    assert not (-nz != 0.0), "negative zero equals zero"
    nan := 0.0 / 0.0
    assert nan != 0.0, "NaN is not zero"
    assert 3.14 != 0.0
    assert "".len() == 0
    assert " ".len() > 0, "whitespace is non-empty"
