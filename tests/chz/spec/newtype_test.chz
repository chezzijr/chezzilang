# tests/chz/spec/newtype_test.chz — numeric-newtype Comparable at runtime, dogfooded with `assert`.
#
# A numeric `newtype` satisfies `Comparable` (checker grants it for numeric underlyings), so
# `.sort()`/`.min()`/`.max()` on a `List[newtype]` must order by the wrapped scalar's NATIVE order —
# (`.min()`/`.max()`/`.min_by`/`.max_by` return `Option[T]`, so the `?? <sentinel>` unwraps below.)
# same as bare `<`/`>`. Regression guard for the value_order/compare newtype-unwrap fix.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import std.math

newtype UserId = int
newtype Score = float

# ---- sort orders a List[newtype=int] by the wrapped scalar ----

test fn sort_int_newtype():
    xs := [UserId(3), UserId(1), UserId(2), UserId(5), UserId(4)]
    xs.sort()
    assert [int(u) for u in xs] == [1, 2, 3, 4, 5]

# ---- min/max return the right element for a List[newtype=int] ----

test fn minmax_int_newtype():
    xs := [UserId(3), UserId(1), UserId(5), UserId(2)]
    assert int(xs.min() ?? UserId(0)) == 1
    assert int(xs.max() ?? UserId(0)) == 5
    # empty is `None`, not a fault — same family rule as `first`/`last`/`pop`
    es: List[UserId] = []
    assert es.min() == None
    assert es.max() == None

# ---- sort/min/max on a List[newtype=float] ----

test fn sort_minmax_float_newtype():
    ys := [Score(2.5), Score(1.0), Score(3.25), Score(0.5)]
    ys.sort()
    assert [float(s) for s in ys] == [0.5, 1.0, 2.5, 3.25]
    assert float(ys.min() ?? Score(0.0)) == 0.5
    assert float(ys.max() ?? Score(0.0)) == 3.25

# ---- must-preserve: bare `<`/`==` and explicit-key sort still correct ----

test fn newtype_positive_controls():
    assert UserId(1) < UserId(2)
    assert not (UserId(2) < UserId(1))
    assert UserId(3) == UserId(3)
    zs := [UserId(3), UserId(1), UserId(2)]
    zs.sort_by_key(fn(u): int(u))
    assert [int(u) for u in zs] == [1, 2, 3]

# ---- newtype=float NaN key at min/max: must match plain List[float] (order_key unwrap) ----

test fn minmax_nan_float_newtype():
    xs := [Score(1.0), Score(math.nan), Score(2.0)]
    assert float(xs.min() ?? Score(0.0)) == 1.0      # NaN sorts high via total_cmp, min is the 1.0 element
    assert math.is_nan(float(xs.max() ?? Score(0.0)))  # max is the NaN element

# ---- sort_by_key / min_by / max_by over a newtype=float NaN key: no fault, matches underlying ----

test fn by_key_nan_float_newtype():
    ws := [Score(3.0), Score(math.nan), Score(1.0)]
    ws.sort_by_key(fn(s): s)
    assert float(ws.min_by(fn(s): s) ?? Score(0.0)) == 1.0
    assert math.is_nan(float(ws.max_by(fn(s): s) ?? Score(0.0)))

# ---- numeric-newtype `%` arm (`Vm::arith_scalar`, Task 2 / docs/gaps.md:1950) ----
#
# `MIN % -1` is the one input `checked_rem` misreports as an overflow (the true remainder IS `0`, the
# x86 `IDIV` trap guard, not a real overflow — see `tests/chz/spec/intrinsic_proto_methods_test.chz`
# for the general non-newtype arms). Same-type newtype arithmetic unwraps to `arith_scalar`, a THIRD,
# separate `checked_rem` call site that needs its own fix.

test fn min_mod_neg_one_on_a_numeric_newtype():
    MIN := -9223372036854775807 - 1
    a := UserId(MIN)
    b := UserId(-1)
    assert int(a % b) == 0

# ---- sum over a List[numeric newtype] returns the NEWTYPE (docs/gaps.md:1954) ----
#
# Go owns named scalar types: `type Cents int` sums to a `main.Cents`, and Chezzi's `newtype` is a
# REAL runtime wrapper (not Python `NewType`'s erased alias), so `sum` re-wraps. The EMPTY list is
# the load-bearing case — nothing at runtime carries the element's `type_key`, so the checker records
# the `T(0)` seed and the compiler pushes it (`NewtypeSumTable`).

test fn sum_int_newtype():
    xs := [UserId(3), UserId(1), UserId(2)]
    assert xs.sum() == UserId(6)
    assert int(xs.sum()) == 6          # a raw-int regression cannot pass this AND the line above

test fn sum_empty_int_newtype():
    es: List[UserId] = []
    assert es.sum() == UserId(0)
    assert int(es.sum()) == 0

test fn sum_float_newtype():
    ys := [Score(1.5), Score(2.25)]
    assert ys.sum() == Score(3.75)
    assert float(ys.sum()) == 3.75
    fs: List[Score] = []
    assert fs.sum() == Score(0.0)
    assert float(fs.sum()) == 0.0

# The checked add is the underlying's own — `sum` must still FAULT, never wrap.

test fn sum_newtype_overflow_still_faults():
    MAX := 9223372036854775807
    xs := [UserId(MAX), UserId(1)]
    r := recover: xs.sum()
    assert r != Ok(UserId(0))
    match r:
        Ok(v): assert false
        Err(e): assert e.message() == "integer overflow in Add"

# Two `.sum()` sites with DIFFERENT verdicts in one statement / one interpolated string: the side
# table is keyed on the method-NAME token, so the sites cannot alias (see `CarrierKey`). An aliased
# key would either mis-apply one site's seed or hard-error `internal:`.

test fn two_sums_one_line_keep_distinct_verdicts():
    cs := [UserId(3), UserId(1)]
    ns := [3, 1]
    assert "{cs.sum()} {ns.sum()}" == "UserId(4) 4"
    assert "{ns.sum()} {cs.sum()}" == "4 UserId(4)"
    ec: List[UserId] = []
    en: List[int] = []
    assert "{ec.sum()} {en.sum()}" == "UserId(0) 0"
    assert [int(cs.sum()), ns.sum(), int(ec.sum()), en.sum()] == [4, 4, 0, 0]

# `defer`/`spawn` dispatch a member call through their OWN opcodes (`Op::DeferMethod` /
# `Op::SpawnMethod`), not `Op::CallMethod` — three opcodes, one seed. A seed emitted at only the
# eager one leaves these two CHECK-clean and RUN-faulting ("sum() expects a numeric list, got an
# element of type newtype") on a non-empty list, and silently answering a raw int on an empty one.
# LIMITATION, stated plainly: both opcodes DISCARD the result, so what these assert is the ABSENCE
# of the fault plus clean completion — the returned VALUE is pinned by the eager tests above, which
# is the only place it is observable at all.

fn deferred_sum(xs: List[UserId], ys: List[Score]) -> int:
    defer xs.sum()
    defer ys.sum()
    return xs.len() + ys.len()

test fn defer_sum_newtype_does_not_fault():
    assert deferred_sum([UserId(3), UserId(1)], [Score(1.5)]) == 3
    ex: List[UserId] = []
    ey: List[Score] = []
    assert deferred_sum(ex, ey) == 0

fn spawned_sum(xs: List[UserId], ys: List[Score]) -> int:
    spawn xs.sum()
    spawn ys.sum()
    return xs.len() + ys.len()

test fn spawn_sum_newtype_does_not_fault():
    assert spawned_sum([UserId(3), UserId(1)], [Score(1.5)]) == 3
    ex: List[UserId] = []
    ey: List[Score] = []
    assert spawned_sum(ex, ey) == 0

# Plain numeric lists are untouched.

test fn sum_plain_lists_unchanged():
    assert [1, 2, 3].sum() == 6
    ei: List[int] = []
    assert ei.sum() == 0
    assert [1.5, 2.5].sum() == 4.0
    ef: List[float] = []
    assert ef.sum() == 0.0
