# TICKET-137 (owner decision D2) — a closure received from another task reads the module globals of
# the task that RUNS it. The airlock must not install the sender's value into the receiver's copy,
# and must not replace the receiver's slot object (which detaches its aliases).
# TICKET-169 (D4 layer C) supersedes the write half: the sending task's `g.push(2)`/`w.push(2)` below
# now FAULTS instead of silently writing a copy the receiver never sees, so the receiver's read stays
# unchanged for the same reason as before (D2), now enforced at the write.
import std.concurrency
import std.time

g: List[int] = [1]

fn alias_case(fr: Channel[str]) -> str:
    a := g
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            res := recover:
                g.push(2)
            match res:
                Ok(_): fr.send("no-fault")
                Err(e): fr.send(e.message())
            c.send(fn() -> str: "{g}")
    f := c.recv()
    before := "{f()} {a}"
    a.push(3)
    return "{before} {f()} {a}"

test fn received_closure_reads_receiver_global_and_keeps_alias():
    fr := Channel[str](1)
    got := alias_case(fr)
    fault := fr.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    assert got == "[1] [1] [1, 3] [1, 3]", "got {got}"

fn nums() -> Iterator[int]:
    i := 0
    while true:
        yield i
        i += 1

g1 := nums()
g2 := g1

test fn aliased_generator_globals_do_not_become_nil_in_a_task():
    r := recover:
        parallel:
            spawn:
                x := g1.next() ?? -1
                y := g2.next() ?? -1
                print("{x} {y}")
    msg := "{r}"
    assert not msg.contains("type nil"), "got {msg}"

w: List[int] = [1]

fn w_case(fr: Channel[str]) -> str:
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            res := recover:
                w.push(2)
            match res:
                Ok(_): fr.send("no-fault")
                Err(e): fr.send(e.message())
            c.send(fn() -> str: "{w}")
    f := c.recv()
    return "{f()} {w}"

test fn received_closure_reads_the_receivers_in_place_copy():
    fr := Channel[str](1)
    got := w_case(fr)
    fault := fr.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    assert got == "[1] [1]", "got {got}"

fn rnums() -> Iterator[int]:
    yield 1
    yield rhelper()
    yield 3

rg := rnums()

fn rhelper() -> int:
    c := Channel[int](1)
    parallel:
        spawn:
            c.send(rg.next() ?? -7)
    return c.recv()

test fn a_running_module_generator_faults_clearly_in_a_task():
    r := recover:
        for v in rg:
            pass
    msg := "{r}"
    assert msg.contains("was running when this task was spawned"), "got {msg}"
    assert not msg.contains("type nil"), "got {msg}"

struct DeepL:
    kids: List[DeepL]

fn build_deep(d: int) -> DeepL:
    n := DeepL([])
    for _ in range(d):
        n = DeepL([n])
    return n

deep_glob := build_deep(2000)

test fn deep_module_global_nursery_opens_stay_linear():
    t0 := time.monotonic()
    for i in range(6):
        parallel:
            spawn:
                pass
    d := time.monotonic() - t0
    assert d < 3.0, "6 nursery opens over a depth-2000 module global took {d}s, expected < 3s"
