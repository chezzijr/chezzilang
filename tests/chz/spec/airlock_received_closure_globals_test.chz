# TICKET-137 (owner decision D2) — a closure received from another task reads and writes the module
# globals of the task that RUNS it. The airlock must not install the sender's value into the
# receiver's copy, and must not replace the receiver's slot object (which detaches its aliases).
import std.concurrency

g: List[int] = [1]

fn alias_case() -> str:
    a := g
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            g.push(2)
            c.send(fn() -> str: "{g}")
    f := c.recv()
    before := "{f()} {a}"
    a.push(3)
    return "{before} {f()} {a}"

test fn received_closure_reads_receiver_global_and_keeps_alias():
    got := alias_case()
    assert got == "[1] [1] [1, 3] [1, 3]", "got {got}"

fn nums() -> Iterator[int]:
    i := 0
    while true:
        yield i
        i += 1

g1 := nums()
g2 := g1

test fn aliased_generator_globals_do_not_become_nil_in_a_task():
    r := recover:
        parallel:
            spawn:
                x := g1.next() ?? -1
                y := g2.next() ?? -1
                print("{x} {y}")
    msg := "{r}"
    assert not msg.contains("type nil"), "got {msg}"
