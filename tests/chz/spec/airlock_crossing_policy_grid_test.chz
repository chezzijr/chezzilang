    r := T189R(n=1)
    out := Channel[str](4)
    parallel:
        spawn r.w([1], out)
    assert out.recv() == "ok 2"

test fn grid_policy_r24_method_default_fill():
    r := T189R(n=1)
    out := Channel[str](4)
    parallel:
        spawn r.dflt(out)
    assert out.recv() == "ok 1"

test fn grid_policy_r25_method_variadic():
    r := T189R(n=1)
    out := Channel[str](4)
    parallel:
        spawn r.pack(out, 1, 2)
    assert out.recv() == "ok 3"

test fn grid_policy_r26_method_keyword_fresh():
    r := T189R(n=1)
    out := Channel[str](4)
    parallel:
        spawn r.w(out=out, xs=[1])
    assert out.recv() == "ok 2"

test fn grid_policy_r27_method_named():
    xs := [1]
    r := T189R(n=1)
    out := Channel[str](4)
    parallel:
        spawn r.w(xs, out)
    assert out.recv() == "fault"
