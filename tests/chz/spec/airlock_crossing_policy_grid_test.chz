# ---- spawn value() ----

test fn grid_policy_r9_value_fresh_literal():
    g := t189_w
    out := Channel[str](4)
    parallel:
        spawn g([1], out)
    assert out.recv() == "ok 2"

test fn grid_policy_r39_value_default_fill():
    # The omitted slot is filled by the callee, inside the task.
    g := t189_dflt
    out := Channel[str](4)
    parallel:
        spawn g(out)
    assert out.recv() == "ok 1"

test fn grid_policy_r40_value_variadic():
    g := t189_pack
    out := Channel[str](4)
    parallel:
        spawn g(out, 1, 2)
    assert out.recv() == "ok 3"

test fn grid_policy_r41_value_named():
    xs := [1]
    g := t189_w
    out := Channel[str](4)
    parallel:
        spawn g(xs, out)
    assert out.recv() == "fault"
    assert xs == [1]

test fn grid_policy_r42_value_keyword_named():
    xs := [1]
    g := t189_w
    out := Channel[str](4)
    parallel:
        spawn g(out=out, xs=xs)
    assert out.recv() == "fault"
    assert xs == [1]

# ---- spawn: block (a capture is always a copy) ----

test fn grid_policy_r43_block_fresh_literal():
    # The literal is built inside the task.
    out := Channel[str](4)
    parallel:
        spawn: t189_w([1], out)
    assert out.recv() == "ok 2"

test fn grid_policy_r44_block_copy():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn: t189_w(xs.copy(), out)
    assert out.recv() == "ok 2"
    assert xs == [1]

test fn grid_policy_r45_block_named_capture():
    xs := [1]
    h := t189_w
    out := Channel[str](4)
    parallel:
        spawn: h(xs, out)
    assert out.recv() == "fault"
    assert xs == [1]

# ---- Executor (the job's captures are a copy; its root is a hand-off) ----

test fn grid_policy_r16_executor_submit_fresh():
    out := Channel[str](4)
    ex := Executor()
    ex.submit(fn(): t189_w([1], out))
    ex.shutdown()
    assert out.recv() == "ok 2"

test fn grid_policy_r17_executor_submit_named():
    xs := [1]
    h := t189_w
    out := Channel[str](4)
    ex := Executor()
    ex.submit(fn(): h(xs, out))
    ex.shutdown()
    assert out.recv() == "fault"
    assert xs == [1]

test fn grid_policy_r46_executor_submit_result_named():
    xs := [1]
    ex := Executor()
    got := ex.submit_result(fn() -> str: t189_try(xs)).recv()
    ex.shutdown()
    assert got == "fault"
    assert xs == [1]

test fn grid_policy_r47_executor_submit_result_fresh():
    ex := Executor()
    got := ex.submit_result(fn() -> str: t189_try([1])).recv()
    ex.shutdown()
    assert got == "ok 2"

# ---- Channel (a receive is never marked, fresh or named send alike) ----

test fn grid_policy_r18_channel_named_send():
    ys := [1]
    ch := Channel[List[int]](1)
    out := Channel[str](4)
    ch.send(ys)
    parallel:
        spawn: out.send(t189_try(ch.recv()))
    assert out.recv() == "ok 2"
    assert ys == [1]

test fn grid_policy_r48_channel_fresh_send():
    ch := Channel[List[int]](1)
    out := Channel[str](4)
    ch.send([1])
    parallel:
        spawn: out.send(t189_try(ch.recv()))
    assert out.recv() == "ok 2"

test fn grid_policy_r49_channel_task_to_parent():
    xs := [1]
    ch := Channel[List[int]](1)
    parallel:
        spawn: ch.send(xs)
    assert t189_try(ch.recv()) == "ok 2"
    assert xs == [1]

# ---- Shared / RwShared / Atomic (a read is never marked) ----

test fn grid_policy_r21_shared_get():
    s := Shared[List[int]]([1])
    out := Channel[str](4)
    parallel:
        spawn: out.send(t189_try(s.get()))
    assert out.recv() == "ok 2"
    assert s.get() == [1]

test fn grid_policy_r50_rwshared_get():
    s := RwShared[List[int]]([1])
    out := Channel[str](4)
    parallel:
        spawn: out.send(t189_try(s.get()))
    assert out.recv() == "ok 2"
    assert s.get() == [1]

test fn grid_policy_r51_atomic_load():
    a := Atomic[List[int]]([1])
    out := Channel[str](4)
    parallel:
        spawn: out.send(t189_try(a.load()))
    assert out.recv() == "ok 2"
    assert a.load() == [1]

test fn grid_policy_r52_shared_store():
    s := Shared[List[int]]([])
    parallel:
        spawn: s.set([1])
    assert t189_try(s.get()) == "ok 2"

# ---- module global (the spawn snapshot is always a copy) ----

t189_g: List[int] = [1]

fn t189_gpush(out: Channel[str]):
    out.send(t189_try(t189_g))

test fn grid_policy_r22_module_global():
    h := t189_gpush
    out := Channel[str](4)
    parallel:
        spawn h(out)
    assert out.recv() == "fault"
    assert t189_g == [1]

# ---- closure capture (a copy across heaps, the enclosing mark in the same heap) ----

fn t189_call(c: Channel[fn() -> int], out: Channel[str]):
    f := c.recv()
    res := recover:
        f()
    out.send(t189_out(res))

test fn grid_policy_r19_closure_other_heap():
    xs := [1]
    c := Channel[fn() -> int](1)
    out := Channel[str](4)
    c.send(fn() -> int: t189_add(xs))
    parallel:
        spawn t189_call(c, out)
    assert out.recv() == "fault"
    assert xs == [1]

test fn grid_policy_r20_closure_same_heap():
    # The received closure is not marked, so its write runs. The send copied its captures by value,
    # so the parent's `xs` is unchanged.
    xs := [1]
    c := Channel[fn() -> int](1)
    c.send(fn() -> int: t189_add(xs))
    f := c.recv()
    assert f() == 2
    assert xs == [1]
