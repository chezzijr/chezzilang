# TICKET-189 -- the crossing-policy grid (D4, docs/decision-d4-airlock.md): "can the parent observe
# this operand after the join?" is decided ONCE per bound slot by the checker and read by every
# non-generator crossing route.
#
# Axes: route x argument source (explicit, keyword, default fill, variadic) x operand shape (fresh
# literal, .copy(), named, call result, fresh holding a named) x callee body (writes, conditional).
# Routes (every consumer of the fact, ticket `## Single source` item 1b): spawn f(), spawn obj.m(),
# spawn lib.f(), spawn lib.K.f(), spawn value(), spawn: block, Executor submit/submit_result,
# Channel receive, Shared/RwShared get, Atomic load, Shared store, module global (the spawn
# snapshot), closure capture. `Executor.map` does not exist (`std/concurrency.chz`). A hand-off read
# (Channel/Shared/RwShared/Atomic) is never marked, so those routes have no fresh-operand axis.
# Generator rows belong to TICKET-190.
#
# Each row sends "ok <len>" when the task's push succeeded, or "fault" when the task wrote its copy
# of parent data (layer C).

import std.concurrency
import airlock_crossing_policy_lib as lib

fn t189_out(res: Result[int]) -> str:
    match res:
        Ok(n): return "ok {n}"
        Err(_): return "fault"

fn t189_try(xs: List[int]) -> str:
    res := recover:
        xs.push(3)
        xs.len()
    return t189_out(res)

fn t189_w(xs: List[int], out: Channel[str]):
    out.send(t189_try(xs))

fn t189_dflt(out: Channel[str], acc: List[int] = []):
    out.send(t189_try(acc))

fn t189_pack(out: Channel[str], ...rest: int):
    res := recover:
        rest.push(3)
        rest.len()
    out.send(t189_out(res))

fn t189_nested(xss: List[List[int]], out: Channel[str]):
    res := recover:
        xss.push([2])
        xss.len()
    out.send(t189_out(res))
    out.send(t189_try(xss[0]))

fn t189_cond(xs: List[int], out: Channel[str], c: bool):
    res := recover:
        if c:
            xs.push(3)
        xs.len()
    out.send(t189_out(res))

fn t189_id(xs: List[int]) -> List[int]:
    return xs

fn t189_add(xs: List[int]) -> int:
    xs.push(2)
    return xs.len()

struct T189R:
    n: int

    fn w(self, xs: List[int], out: Channel[str]):
        t189_w(xs, out)

    fn dflt(self, out: Channel[str], acc: List[int] = []):
        out.send(t189_try(acc))

    fn pack(self, out: Channel[str], ...rest: int):
        out.send(t189_try(rest))

struct T189C:
    n: int

    fn bump(self, out: Channel[str]):
        res := recover:
            self.n += 1
            self.n
        out.send(t189_out(res))

fn t189_mk() -> T189C:
    return T189C(n=1)

# ---- spawn f() ----

test fn grid_policy_r1_fn_fresh_literal():
    out := Channel[str](4)
    parallel:
        spawn t189_w([1], out)
    assert out.recv() == "ok 2"

test fn grid_policy_r2_fn_copy():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_w(xs.copy(), out)
    assert out.recv() == "ok 2"
    assert xs == [1]

test fn grid_policy_r3_fn_call_result():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_w(t189_id(xs), out)
    assert out.recv() == "fault"
    assert xs == [1]

test fn grid_policy_r4_fn_fresh_holding_named():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_nested([xs], out)
    assert out.recv() == "ok 2"
    assert out.recv() == "fault"
    assert xs == [1]

test fn grid_policy_r5_fn_keyword_fresh():
    out := Channel[str](4)
    parallel:
        spawn t189_w(out=out, xs=[1])
    assert out.recv() == "ok 2"

test fn grid_policy_r6_fn_default_fill():
    out := Channel[str](4)
    parallel:
        spawn t189_dflt(out)
    assert out.recv() == "ok 1"

test fn grid_policy_r7_fn_variadic():
    out := Channel[str](4)
    parallel:
        spawn t189_pack(out, 1, 2)
    assert out.recv() == "ok 3"

fn t189_pack_elem(out: Channel[str], ...rest: List[int]):
    out.send(t189_try(rest[0]))

test fn grid_policy_r8_fn_variadic_element_named():
    # The pack list is fresh; its element is the parent's list, so it stays a copy.
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_pack_elem(out, xs)
    assert out.recv() == "fault"
    assert xs == [1]

fn t189_rebind(ys: List[int], out: Channel[str]):
    ys = [1, 2]
    ys.push(3)
    out.send("ok {ys.len()}")

test fn grid_policy_r23_fn_rebound_param():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_rebind(xs, out)
    assert out.recv() == "ok 3"
    assert xs == [1]

t189_dg: List[int] = [1]

fn t189_dg_get() -> List[int]:
    return t189_dg

fn t189_dprov(out: Channel[str], acc: List[int] = t189_dg_get()):
    out.send(t189_try(acc))

test fn grid_policy_r53_fn_provider_default_is_copy():
    # Ceiling: a provider default is a call result, which may return a parent global.
    out := Channel[str](4)
    parallel:
        spawn t189_dprov(out)
    assert out.recv() == "fault"
    assert t189_dg == [1]

test fn grid_policy_r14_fn_conditional_named():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_cond(xs, out, true)
    assert out.recv() == "fault"
    assert xs == [1]

test fn grid_policy_r15_fn_conditional_fresh():
    out := Channel[str](4)
    parallel:
        spawn t189_cond([1], out, true)
    assert out.recv() == "ok 2"

