# tests/chz/spec/eq_func_test.chz — W7-54: a function value satisfies `Eq`.
#
# `Ty::Func` had no `intrinsic_recv_kind` classification, so the D1 `Eq` grant excluded it: `==`
# (the structural derive, `Vm::values_equal`, IDENTITY for a function value) already worked, while
# `.eq()` and a `[T: Eq]` bound both answered "does not satisfy Eq" — one relation, three spellings,
# three answers. **CPython 3.14, measured:** `f == g` (two loads of one `def`) -> `True`;
# `f.__eq__(g)` -> `True`; `mk() == mk()` (two calls to a factory returning a nested `def`) -> `False`;
# two closures with equal captures -> `False`; `r == r` -> `True`. **rustc 1.97.0, measured:**
# `#[derive(PartialEq, Eq)] struct Boxy<T: Eq>(T)` over a `fn(i32) -> i32` payload builds clean and
# prints `true` — fn pointers implement `PartialEq`. Go is the one ancestor that differs: it rejects
# `f == g` outright (`func can only be compared to nil`). Chezzi now matches CPython/Rust on all four
# spellings. Gated by `test_runner::chz_suite_passes` (the M:N-engine gate).
#
# `Ty::BuiltinFn` (a first-class universe builtin value — `ord`/`chr`/`panic`/`print`) is a SEPARATE
# `Ty` variant from `Ty::Func` (kept apart only for sendability) but renders identically in
# diagnostics ("fn(str) -> int") and was the SAME defect: missed by the first W7-54 pass because the
# D1 gate's exclusion list never named it. It now shares `Ty::Func`'s `"func"` `intrinsic_recv_kind`,
# so it is covered by the same rows below (`two_loads_of_one_builtin_fn_are_equal` etc.) — CPython:
# `ord == ord` -> `True`, matching.
#
# The `.eq()` method spelling is exercised through `eqm`'s ERASED `[T: Eq]` bound, not called bare on
# a concrete receiver — that mirrors every other intrinsically-granted kind (int/list/tuple/…): the
# `Eq` grant makes `.eq()` callable from an erased generic body, not a new bare instance method, so
# `(1).eq(1)` / `[1].eq([1])` are (and stay) `has no method 'eq'` too. `an_erased_eq_bound_can_call_
# eq_on_every_granted_receiver` in `eq_protocol_test.chz` pins the same shape for the other kinds.

fn g(x: int) -> int:
    return x

fn h(x: int) -> int:
    return x

fn eqm[T: Eq](a: T, b: T) -> bool:
    return a.eq(b)

test fn two_loads_of_one_toplevel_fn_are_equal():
    a := g
    b := g
    assert (a == b) == true
    assert eqm(a, b) == true, "the method spelling now agrees with the operator"

test fn two_different_toplevel_fns_are_unequal():
    assert (g == h) == false
    assert eqm(g, h) == false

fn mk() -> fn(int) -> int:
    fn inner(x: int) -> int:
        return x
    return inner

test fn two_calls_to_a_factory_are_unequal():
    assert (mk() == mk()) == false, "each call mints its own nested fn"
    assert eqm(mk(), mk()) == false

fn mklam(n: int) -> fn() -> int:
    return fn() -> int: n

test fn two_closures_with_equal_captures_are_unequal():
    a := mklam(1)
    b := mklam(1)
    assert (a == b) == false, "equal captures, but distinct closure instances"
    assert eqm(a, b) == false

test fn a_closure_equals_itself():
    r := mklam(1)
    assert (r == r) == true
    assert eqm(r, r) == true

# ---- W7-41's regressed spelling, restored: `Box[T]` over a function payload ----
#
# The body genuinely DISPATCHES `self.val == o.val` (a `==` on a function value, inside a
# `where T: Eq` body — the exact path W7-41's guard governs) rather than returning a constant, so
# the assertions below can tell "the user `eq` ran and used the payload" apart from "it fell back to
# structural equality" (two `Box(g)` structs holding the same handle would be structurally equal
# either way, so a `return true` stub could not distinguish them).

struct Box[T]:
    val: T
    fn eq(self, o: Box[T]) -> bool where T: Eq:
        return self.val == o.val

test fn box_over_a_function_payload_satisfies_eq():
    assert (Box(g) == Box(g)) == true
    assert (Box(g) == Box(h)) == false, "different functions, so the dispatched eq must say false"

# ---- W7-54 follow-up: `Ty::BuiltinFn` (ord/chr/panic/print) is the same defect, same fix ----
#
# `Ty::BuiltinFn` is a distinct `Ty` variant from `Ty::Func` (kept apart only so it can be sendable
# across `spawn`), but it renders identically ("fn(str) -> int") and was excluded from the D1 `Eq`
# gate for the same reason `Ty::Func` was: no `intrinsic_recv_kind` classification. It now shares
# `Ty::Func`'s `"func"` kind, so `==`, the erased `[T: Eq]` `.eq()` spelling, and `Box[T]` all agree.

test fn two_loads_of_one_builtin_fn_are_equal():
    a := ord
    b := ord
    assert (a == b) == true
    assert eqm(a, b) == true, "the method spelling now agrees with the operator for a builtin too"

test fn chr_loads_are_equal_too():
    # `chr` has a different signature from `ord` (so the two can't be compared to EACH OTHER — Chezzi
    # is statically typed and they're different `fn(...)` types), but the same identity relation
    # holds for it independently, proving the fix isn't `ord`-specific.
    a := chr
    b := chr
    assert (a == b) == true
    assert eqm(a, b) == true

fn u(s: str) -> int:
    return s.len()

test fn a_user_fn_and_a_builtin_of_the_same_type_are_unequal():
    # The only FALSE-direction row available for a builtin, and it pins the cross-variant case the
    # shared `"func"` kind creates: `u` is a `Ty::Func`, `ord` a `Ty::BuiltinFn`, same rendered type
    # `fn(str) -> int`. Before the follow-up these DISAGREED — `u == ord` was `false` while
    # `eqm(u, ord)` was a type error. CPython agrees they are unequal: a user `def` vs `ord` -> False.
    assert (u == ord) == false
    assert eqm(u, ord) == false

test fn a_builtin_fn_equals_itself():
    r := ord
    assert (r == r) == true
    assert eqm(r, r) == true

test fn box_over_a_builtin_fn_payload_satisfies_eq():
    assert (Box(ord) == Box(ord)) == true
