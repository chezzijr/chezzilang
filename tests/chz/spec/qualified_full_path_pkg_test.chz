# TICKET-175: a user package module imported as `import qualified_path_pkg.deep` is usable through
# its full path, with the same identity as the bare `deep.X` reading.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import qualified_path_pkg.deep

fn build[T: qualified_path_pkg.deep.Factory]() -> T:
    return T.make()

test fn full_path_function_and_global():
    assert qualified_path_pkg.deep.double(4) == 8
    assert qualified_path_pkg.deep.limit == 3

test fn full_path_constructor_static_and_annotation():
    p: qualified_path_pkg.deep.Point = qualified_path_pkg.deep.Point(1)
    assert p.x == 1
    assert qualified_path_pkg.deep.Point.zero().x == 0
    q: deep.Point = p
    assert q.x == 1

test fn full_path_variant_and_pattern():
    c := qualified_path_pkg.deep.Color.Blue(5)
    got := 0
    match c:
        qualified_path_pkg.deep.Color.Blue(n):
            got = n
        qualified_path_pkg.deep.Color.Red:
            got = 0
    assert got == 5

test fn full_path_protocol_bound():
    p: deep.Point = build[deep.Point]()
    assert p.x == 7
