# tests/chz/spec/struct_copy_test.chz — a struct's `copy()` exists only when the struct declares it
# (wave 24 F4, owner 2026-11-09; TICKET-030's intrinsic `copy()` is deleted). One method set per
# type: a declared `copy` answers a direct call, a protocol bound and the type path alike, and an
# undeclared one is "no method 'copy'" in every use (`tests/method_set_grid.rs`). A fn-typed field
# named `copy` is a field, called through member syntax. `List.copy` (shallow) stays.
#
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

protocol Dup:
    fn copy(self) -> Self

struct P:
    x: int
    tag: str = "none"

    fn copy(self) -> P:
        return P(self.x, self.tag)

struct Own:
    x: int

    fn copy(self) -> int:
        return self.x + 100

struct FnField:
    copy: fn(int) -> int

fn twice[T: Dup](v: T) -> T:
    return v.copy()

test fn a_declared_copy_is_independent():
    p := P(1, "hi")
    q := p.copy()
    q.x = 99
    assert p.x == 1
    assert q.x == 99
    assert q.tag == "hi"

test fn a_declared_copy_meets_a_protocol_bound():
    assert "{twice(P(2, "b"))}" == "P(x=2, tag='b')"

test fn a_declared_copy_is_a_type_path_value():
    f := P.copy
    assert f(P(3)).x == 3
    assert P.copy(P(4)).x == 4

test fn a_declared_copy_method_keeps_its_own_signature():
    assert Own(7).copy() == 107

test fn a_fn_typed_copy_field_still_calls():
    f := FnField(fn(n): n * 2)
    assert f.copy(21) == 42

test fn list_copy_stays_shallow():
    inner := [1]
    xs := [inner]
    ys := xs.copy()
    ys.push([2])
    ys[0].push(3)
    assert xs.len() == 1
    assert xs[0] == [1, 3], "a shallow copy shares the element"
