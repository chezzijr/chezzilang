# tests/chz/spec/struct_copy_test.chz — TICKET-030: every struct gets an intrinsic `copy()`.
#
# `copy()` is a SHALLOW duplicate: each field's VALUE is copied, so a `List`/`Map`/`Set`/nested-struct/
# handle field is referenced by BOTH the original and the copy. It is resolved MISS-ONLY, after a
# declared method and after a fn-typed field of the same name, so either keeps priority over the
# intrinsic. Structs only — enums and newtypes get nothing (see `src/checker/tests.rs`).
#
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import std.regex

struct P:
    x: int
    tag: str = "none"

struct Big:
    a: int
    b: int
    c: int
    d: int
    e: int = 5

struct Nest:
    xs: List[int]
    inner: P

struct Holder:
    ch: Channel[int]
    n: int

struct Box[T]:
    v: T

struct Own:
    x: int

    fn copy(self) -> int:
        return self.x + 100

struct FnField:
    copy: fn(int) -> int

test fn copy_is_independent():
    p := P(1, "hi")
    q := p.copy()
    q.x = 99
    assert p.x == 1
    assert q.x == 99
    assert q.tag == "hi"

test fn copy_carries_a_defaulted_field():
    p := P(1, "hi")
    assert str(P(p.x)) == "P(x=1, tag='none')"
    assert str(p.copy()) == "P(x=1, tag='hi')", "copy() must carry a field a hand-written duplicate drops"

test fn copy_covers_the_spill_field_layout():
    b := Big(1, 2, 3, 4, 9)
    c := b.copy()
    c.a = 50
    assert str(c) == "Big(a=50, b=2, c=3, d=4, e=9)"
    assert str(b) == "Big(a=1, b=2, c=3, d=4, e=9)"

test fn copy_shares_a_list_field():
    n := Nest([1, 2], P(4, "z"))
    m := n.copy()
    m.xs.push(3)
    assert n.xs.len() == 3, "a shallow copy shares the List field"

test fn copy_shares_a_nested_struct_field():
    n := Nest([1, 2], P(4, "z"))
    m := n.copy()
    m.inner.x = 77
    assert n.inner.x == 77, "a shallow copy shares the nested struct field"

test fn copy_shares_a_channel_field():
    h := Holder(Channel[int](1), 3)
    g := h.copy()
    g.ch.send(5)
    assert h.ch.recv() == 5, "a shallow copy shares the Channel handle"
    assert g.n == 3

test fn copy_preserves_a_type_argument():
    b := Box[int](7)
    c := b.copy()
    c.v = 8
    assert b.v == 7
    assert c.v == 8

test fn a_declared_copy_method_wins():
    assert Own(7).copy() == 107, "a declared copy method keeps priority over the intrinsic"

test fn a_fn_typed_copy_field_still_calls():
    f := FnField(fn(n): n * 2)
    assert f.copy(21) == 42, "a fn-typed copy field keeps priority over the intrinsic"

test fn copy_works_on_a_native_struct():
    r := regex.find("[0-9]+", "a1b22c")
    match r:
        Ok(o):
            match o:
                Some(mm):
                    d := mm.copy()
                    d.start = 9
                    assert mm.start == 1
                    assert str(d) == "Match(text='1', start=9, end=2, groups=[])"
                None:
                    assert false, "regex.find must match the digit run"
        Err(e):
            assert false, "regex.find must not error"
