# tests/chz/spec/ord_chr_test.chz — `ord`/`chr`, the two universe builtins that bridge str ↔ codepoint.
#
# Every expected value/fault below is measured against CPython 3.14.7 (docs/stdlib.md fault table).
# `ord("ab")` used to return 97 SILENTLY where CPython raises `TypeError` — a plausible wrong answer
# with rc=0, the defect class this suite exists to catch.
# Run: `cargo run -- test tests/chz/`. Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

test fn ord_accepts_exactly_one_character():
    assert ord("a") == 97
    assert ord("é") == 233, "one CHARACTER, two bytes — the count is codepoints, not bytes"
    assert ord(chr(1114111)) == 1114111, "the top of the Unicode range is still one character"

test fn ord_faults_on_anything_but_one_character():
    # CPython: TypeError: ord() expected a character, but string of length 2 found. The multi-BYTE
    # spelling ("éa" — 3 bytes, 2 characters) must fault the same way: the count is codepoints.
    cases := [("ab", 2), ("éa", 2), ("abc", 3)]
    for s, n in cases:
        r := recover: ord(s)
        match r:
            Ok(_):  assert false, "a multi-character str must fault, not return the first codepoint"
            Err(e): assert e.message() == "ord() expects a 1-character str, got {n} characters"
    # The empty case was already guarded; it keeps its own message.
    re := recover: ord("")
    match re:
        Ok(_):  assert false, "expected a fault"
        Err(e): assert e.message() == "ord() of an empty string"

test fn chr_round_trips_ord():
    assert chr(97) == "a"
    assert chr(233) == "é"
    assert ord(chr(1114111)) == 1114111

test fn chr_faults_outside_the_unicode_range():
    # CPython: ValueError: chr() arg not in range(0x110000) for both.
    for bad in [-1, 1114112]:
        r := recover: chr(bad)
        match r:
            Ok(_):  assert false, "chr() must reject a codepoint outside range(0x110000)"
            Err(e): assert e.message().contains("not a valid Unicode codepoint")
    # DIVERGENCE, recorded not fixed (docs/stdlib.md): CPython returns a lone surrogate here,
    # Chezzi faults — `str` is UTF-8 and cannot hold one. A loud fault, not a wrong value.
    rs := recover: chr(55296)
    match rs:
        Ok(_):  assert false, "a lone surrogate has no UTF-8 encoding"
        Err(e): assert e.message().contains("55296")
