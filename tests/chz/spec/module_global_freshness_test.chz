# Module-global FRESHNESS across nurseries (gaps.md W6-2 + W6-19).
#
# M3.1 (Go model): a task reads and writes the run's one copy of each module global, at EVERY
# depth — including a global first initialized AFTER an earlier nursery and a value mutated between
# two nurseries. A race is the user's bug, so a row that reads a global another party writes orders
# the two with a channel or a join. Goldens: the equivalent Go program (`var` globals, goroutines,
# `sync.WaitGroup`), go1.27.0.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
import AtomicInt, Executor, Shared from std.concurrency

# --- W6-2 repro: a first nursery BEFORE `n` is initialized ------------------------------------
tot := AtomicInt(0)
parallel:
    spawn: tot.add(1)

n: int = 42

# Per-test mutable globals — each test owns its OWN, so no test's absolute expectation depends on
# another having run first (the runner drives free tests sequentially in declaration order, which is
# NOT something a test should lean on).
m: int = 1
exg: int = 1
exg2: int = 1
bsg: int = 1
egg: int = 1

q: List[int] = [1]
mp: Map[str, int] = {"a": 1}

struct P:
    x: int
p := P(1)

f: int = 1
fn set_f(v: int):
    f = v

loopg: int = 0
esc: int = 1

fn d4_set_esc():
    esc = 2
tg: int = 1
xg: int = 1

# --- the repro ---------------------------------------------------------------------------------

# A global declared AFTER the first nursery used to replay as `None` inside every later task.
test fn task_sees_global_declared_after_first_nursery():
    seen := Shared(0)
    parallel:
        spawn: seen.set(n)
    assert seen.get() == 42, "task saw {seen.get()}"

# --- staleness between nurseries ---------------------------------------------------------------

# A scalar global mutated by sequential parent code BETWEEN two nurseries: the second nursery's task
# sees the NEW value (it used to see the frozen first-nursery copy).
test fn global_mutated_between_nurseries():
    a := Shared(0)
    b := Shared(0)
    parallel:
        spawn: a.set(m)
    m = 42
    parallel:
        spawn: b.set(m)
    assert a.get() == 1, "first task saw {a.get()}"
    assert b.get() == 42, "second task saw {b.get()}"

# The same, but the global is written by a FUNCTION rather than at top level.
test fn global_written_by_a_function():
    a := Shared(0)
    b := Shared(0)
    parallel:
        spawn: a.set(f)
    set_f(77)
    parallel:
        spawn: b.set(f)
    assert a.get() == 1, "first task saw {a.get()}"
    assert b.get() == 77, "second task saw {b.get()}"

# --- in-place mutation of an aggregate global (never writes the module slot) --------------------

test fn aggregate_mutated_in_place_between_nurseries():
    a := Shared(0)
    b := Shared(0)
    parallel:
        spawn: a.set(q.len())
    q.push(2)
    parallel:
        spawn: b.set(q.len())
    assert a.get() == 1, "first task saw len {a.get()}"
    assert b.get() == 2, "second task saw len {b.get()}"

test fn map_and_struct_globals_in_place():
    a := Shared(0)
    b := Shared(0)
    mp["b"] = 2
    p.x = 7
    parallel:
        spawn: a.set(mp.len())
        spawn: b.set(p.x)
    assert a.get() == 2, "task saw map len {a.get()}"
    assert b.get() == 7, "task saw p.x {b.get()}"

# --- a task reads the live value -------------------------------------------------------------
#
# The first task reads before the parent's in-place push (it signals after its read), the second
# after it. Go: 1, 2, parent 2.
aq: List[int] = [1]

test fn in_place_mutation_between_two_spawns_of_one_nursery():
    a := Shared(0)
    b := Shared(0)
    read := Channel[int]()
    parallel:
        spawn:
            a.set(aq.len())
            read.send(0)
        read.recv()
        aq.push(2)
        spawn: b.set(aq.len())
    assert a.get() == 1, "first task saw len {a.get()}"
    assert b.get() == 2, "second task saw len {b.get()}"
    assert aq.len() == 2, "parent saw len {aq.len()}"

# The same shape one level down — a nursery NESTED inside a task, which on M:N with >= 2 hardware
# threads is the EAGER per-connection path (the `std.net` `serve` shape: accept, spawn a handler, append
# to a log global). The nested child reads before the task's push; the push lands in the run's
# copy. Go: 1, then 2.
nq: List[int] = [1]

fn nested_pin_worker(out: Shared[int]):
    read := Channel[int]()
    parallel:
        spawn:
            out.set(nq.len())
            read.send(0)
        read.recv()
        nq.push(2)

test fn nested_nursery_in_a_task_pins_at_its_first_spawn():
    out := Shared(0)
    parallel:
        spawn nested_pin_worker(out)
    assert out.get() == 1, "nested task saw len {out.get()}"
    assert nq.len() == 2, "the task's push is in the run's copy: {nq.len()}"

# A global ASSIGNMENT between two spawns of one nursery: the first task reads before it (it
# signals after its read), the second after it. Go: 1, 2.
sg: int = 1

test fn assignment_between_two_spawns_refreshes_the_view():
    a := Shared(0)
    b := Shared(0)
    read := Channel[int]()
    parallel:
        spawn:
            a.set(sg)
            read.send(0)
        read.recv()
        sg = 2
        spawn: b.set(sg)
    assert a.get() == 1, "first task saw {a.get()}"
    assert b.get() == 2, "second task saw {b.get()}"

# --- a task's write lands --------------------------------------------------------------------

# A task's write through a fn value reaches the parent (the run has one `xg`). Go: 5.
test fn task_side_mutation_reaches_parent():
    xg = 1
    parallel:
        spawn:
            write_xg := set_x
            write_xg(5)
    assert xg == 5, "the task's write is lost: {xg}"

fn set_x(v: int):
    xg = v

# --- the NESTED rule ---------------------------------------------------------------------------

# A task writes the global, then opens a nested `parallel:`: its child reads the write, and so
# does the parent after the join. Also exercises W6-19 (a task whose FIRST module-global access is
# a WRITE used to panic the M:N pool). Go: 99, 99.
fn nested_worker(out: Shared[int]):
    tg = 99
    parallel:
        spawn: out.set(tg)

test fn nested_nursery_sees_the_tasks_current_view():
    out := Shared(0)
    parallel:
        spawn nested_worker(out)
    assert out.get() == 99, "nested task saw {out.get()}"
    assert tg == 99, "the task's write is lost: {tg}"

# --- Executor ----------------------------------------------------------------------------------

# A submitted job sees the globals as of the instant it STARTS — which, under eager execution, is its
# `submit` (the job is already running by the time `submit` returns). The documented test shape for an
# `Executor` still holds: **assert after `shutdown()`, never between**. That instant itself is pinned
# in Rust (`executor_job_sees_globals_as_of_the_submit_on_mn`).
#
# What this catches: a job that snapshots a global at DECLARATION time (`1`) rather than at its start
# would read `1` here.
test fn executor_task_sees_globals_as_of_its_start():
    seen := Shared(0)
    exg = 123
    ex := Executor()
    _ := ex.submit(fn(): seen.set(exg))
    ex.shutdown()
    assert seen.get() == 123, "executor job saw {seen.get()}"

# An `Executor` job writes the run's globals in place, and a nursery task spawned after
# `shutdown()` joined the job reads its writes, as the parent does. Go: 1, 5, 1, 5.
eq: List[int] = []
eqn: int = 0

fn eq_job():
    eq.push(7)
    eqn = 5

test fn an_executor_jobs_mutation_reaches_a_later_nursery_task():
    seenq := Shared(-1)
    seenn := Shared(-1)
    ex := Executor()
    parallel:
        _ := ex.submit(eq_job)
        ex.shutdown()
        spawn: seenq.set(eq.len())
        spawn: seenn.set(eqn)
    assert seenq.get() == 1, "task missed the job's push: len {seenq.get()}"
    assert seenn.get() == 5, "task missed the job's write: {seenn.get()}"
    assert eq.len() == 1, "the job's push is lost: {eq.len()}"
    assert eqn == 5, "the job's write is lost: {eqn}"

# An `Executor` job and a nursery task side by side. Before eager execution these pinned DIFFERENT
# instants — the task at its `spawn`, the job at the later drain — and the test's job was to contrast
# them. Eager execution collapsed that difference (a job starts at its `submit`, so both now pin
# "when this work started"), so the contrast is gone. What survives as the property: BOTH paths must
# read the CURRENT value of the global (M3.1: the run's one copy), never its declaration-time one — a
# stale read in either path reads `1` here.
test fn executor_alongside_a_nursery():
    a := Shared(0)
    b := Shared(0)
    exg2 = 5
    ex := Executor()
    _ := ex.submit(fn(): a.set(exg2))
    parallel:
        spawn: b.set(exg2)
    ex.shutdown()
    assert a.get() == 5, "executor job saw {a.get()}"
    assert b.get() == 5, "nursery task saw {b.get()}"

# --- bare `spawn` (the IMPLICIT nursery) -------------------------------------------------------

# A bare `spawn` binds to the implicit nursery the compiler opens at the TOP of the body and joins at
# its end. The first task reads before the write (it signals after its read), the second after it.
# Go: 1, 42.
fn bare_spawn_pair(a: Shared[int], b: Shared[int]):
    read := Channel[int]()
    spawn:
        a.set(bsg)
        read.send(0)
    read.recv()
    bsg = 42
    spawn: b.set(bsg)

test fn bare_spawns_see_the_global_live_at_their_own_spawn():
    a := Shared(0)
    b := Shared(0)
    bare_spawn_pair(a, b)
    assert a.get() == 1, "first bare spawn saw {a.get()}"
    assert b.get() == 42, "second bare spawn saw {b.get()}"

# A bare `spawn` with an explicit `parallel:` after it: the inner join is where M:N EARLY-ENLISTS the
# outer implicit nursery's task, so the task pins there and a LATER write reaches neither task.
fn bare_then_nested(a: Shared[int], b: Shared[int]):
    spawn: a.set(egg)
    parallel:
        spawn: b.set(egg)
    egg = 7

test fn bare_spawn_alongside_a_nested_nursery():
    a := Shared(0)
    b := Shared(0)
    bare_then_nested(a, b)
    assert a.get() == 1, "outer (bare) task saw {a.get()}"
    assert b.get() == 1, "inner task saw {b.get()}"
    assert egg == 7, "parent saw {egg}"

# --- teardown / cancel matrix (this subsystem produced the N1–N9 cascade) ----------------------

fn boom():
    panic("task blew up")

# A task fault still propagates with its own message.
test fn a_faulting_task_still_propagates():
    r := recover:
        parallel:
            spawn boom()
    match r:
        ?_: assert false, "expected a fault"
        !e: assert e.message().contains("task blew up"), "got {e.message()}"

# A `?`-style escape out of a nursery: the escape propagates and the scope tears down cleanly.
# TICKET-169 (D4 layer C): `esc = 2` runs inside the spawned task, so it now faults instead of
# silently mutating a copy the parent never sees — wrapped so it cannot race the escape.
fn escape_out() -> int!Error:
    parallel:
        spawn:
            write_esc := d4_set_esc
            _ := recover: write_esc()
        return !"bail"
    return ?0

test fn escape_out_of_a_nursery_tears_down():
    r := escape_out()
    match r:
        ?_: assert false, "expected the escape"
        !e: assert e.message() == "bail"

# A nested nursery inside a task that then faults: teardown must not desync the per-nursery pin.
fn nested_then_fault(out: Shared[int]):
    parallel:
        spawn: out.set(n)
    panic("after nested")

test fn nested_nursery_inside_a_faulting_task():
    out := Shared(0)
    r := recover:
        parallel:
            spawn nested_then_fault(out)
    match r:
        ?_: assert false, "expected a fault"
        !e: assert e.message().contains("after nested"), "got {e.message()}"
    assert out.get() == 42, "nested task saw {out.get()}"

# A `defer` that reads a module global while running during teardown.
fn defer_reads_global(out: Shared[int]):
    defer out.set(n)
    parallel:
        spawn: tot.add(1)

test fn defer_reads_a_global_during_teardown():
    out := Shared(0)
    parallel:
        spawn defer_reads_global(out)
    assert out.get() == 42, "defer saw {out.get()}"

# A nursery in a LOOP: each iteration's task is pinned at its own spawn, so it sees that
# iteration's value.
test fn nursery_in_a_loop_pins_per_iteration():
    seen := Shared(0)
    total := 0
    for i in 0..10:
        loopg = i
        parallel:
            spawn: seen.set(loopg)
        total = total + seen.get()
    assert total == 45, "sum of per-iteration views was {total}"

# Every in-place mutation door: each row mutates in the parent, then a task (joined before the
# next row) reads every global. Each task sees every mutation made before it. Go: the same 11 views.
struct Box213:
    n: int
    xs: List[int]

g_nested: List[List[int]] = [[1]]
g_map: Map[str, int] = {"a": 1}
g_set: Set[int] = {1}
g_box := Box213(1, [1])
g_boxes: List[Box213] = [Box213(1, [1])]
g_pop: List[int] = [1, 2]
g_idx: List[int] = [1]

fn view213() -> str:
    return "{g_nested[0].len()} {g_map.len()} {g_set.len()} {g_box.n} {g_box.xs.len()} {g_boxes[0].n} {g_boxes[0].xs.len()} {g_pop.len()} {g_idx[0]}"

fn read213(seen: Channel[str]):
    parallel:
        spawn: seen.send(view213())

test fn every_in_place_mutation_door_refreshes_the_next_tasks_view():
    seen := Channel[str](32)
    read213(seen)
    g_nested[0].push(2)
    read213(seen)
    g_map["b"] = 2
    read213(seen)
    g_set.insert(2)
    read213(seen)
    g_box.n = 2
    read213(seen)
    g_box.xs.push(2)
    read213(seen)
    g_boxes[0].n = 2
    read213(seen)
    g_boxes[0].xs.push(2)
    read213(seen)
    _ := g_pop.pop()
    read213(seen)
    g_idx[0] = 2
    read213(seen)
    read213(seen)
    got: List[str] = []
    for _ in 0..11:
        got.push(seen.recv())
    want := ["1 1 1 1 1 1 1 2 1", "2 1 1 1 1 1 1 2 1", "2 2 1 1 1 1 1 2 1", "2 2 2 1 1 1 1 2 1", "2 2 2 2 1 1 1 2 1", "2 2 2 2 2 1 1 2 1", "2 2 2 2 2 2 1 2 1", "2 2 2 2 2 2 2 2 1", "2 2 2 2 2 2 2 1 1", "2 2 2 2 2 2 2 1 2", "2 2 2 2 2 2 2 1 2"]
    assert got == want, "views were {got}"
