# Module-global FRESHNESS across nurseries (gaps.md W6-2 + W6-19).
#
# A task sees the module globals as they were when IT was spawned, at EVERY depth — including a
# global first initialized AFTER an earlier nursery (which used to replay as `nil`) and a value
# mutated between two nurseries (which used to replay the frozen first-nursery copy). Per-task
# ISOLATION is unchanged: a task mutates its OWN deep copy and never writes through to the parent;
# `Shared`/`RwShared`/`Atomic`/`Channel` stay the only real sharing. A NESTED `parallel:` inside a
# task sees the TASK's current view, not the parent module's.
# Gated by `test_runner::chz_suite_passes` (the M:N-engine gate).
import std.concurrency

# --- W6-2 repro: a first nursery BEFORE `n` is initialized ------------------------------------
tot := AtomicInt(0)
parallel:
    spawn: tot.add(1)

n: int = 42

# Per-test mutable globals — each test owns its OWN, so no test's absolute expectation depends on
# another having run first (the runner drives free tests sequentially in declaration order, which is
# NOT something a test should lean on).
m: int = 1
exg: int = 1
exg2: int = 1
bsg: int = 1
egg: int = 1

q: List[int] = [1]
mp: Map[str, int] = {"a": 1}

struct P:
    x: int
p := P(1)

f: int = 1
fn set_f(v: int):
    f = v

loopg: int = 0
esc: int = 1
tg: int = 1
xg: int = 1

# --- the repro ---------------------------------------------------------------------------------

# A global declared AFTER the first nursery used to replay as `nil` inside every later task.
test fn task_sees_global_declared_after_first_nursery():
    seen := Shared(0)
    parallel:
        spawn: seen.set(n)
    assert seen.get() == 42, "task saw {seen.get()}"

# --- staleness between nurseries ---------------------------------------------------------------

# A scalar global mutated by sequential parent code BETWEEN two nurseries: the second nursery's task
# sees the NEW value (it used to see the frozen first-nursery copy).
test fn global_mutated_between_nurseries():
    a := Shared(0)
    b := Shared(0)
    parallel:
        spawn: a.set(m)
    m = 42
    parallel:
        spawn: b.set(m)
    assert a.get() == 1, "first task saw {a.get()}"
    assert b.get() == 42, "second task saw {b.get()}"

# The same, but the global is written by a FUNCTION rather than at top level.
test fn global_written_by_a_function():
    a := Shared(0)
    b := Shared(0)
    parallel:
        spawn: a.set(f)
    set_f(77)
    parallel:
        spawn: b.set(f)
    assert a.get() == 1, "first task saw {a.get()}"
    assert b.get() == 77, "second task saw {b.get()}"

# --- in-place mutation of an aggregate global (never writes the module slot) --------------------

test fn aggregate_mutated_in_place_between_nurseries():
    a := Shared(0)
    b := Shared(0)
    parallel:
        spawn: a.set(q.len())
    q.push(2)
    parallel:
        spawn: b.set(q.len())
    assert a.get() == 1, "first task saw len {a.get()}"
    assert b.get() == 2, "second task saw len {b.get()}"

test fn map_and_struct_globals_in_place():
    a := Shared(0)
    b := Shared(0)
    mp["b"] = 2
    p.x = 7
    parallel:
        spawn: a.set(mp.len())
        spawn: b.set(p.x)
    assert a.get() == 2, "task saw map len {a.get()}"
    assert b.get() == 7, "task saw p.x {b.get()}"

# --- the pin instant is a SOURCE POSITION (one build per epoch, both engines) -------------------
#
# In-place mutation writes no module slot, so nothing REFRESHES a task's view mid-nursery: every spawn
# between two cache invalidations (a global assignment, or a nursery open) replays ONE build. Both
# tasks below therefore see len 1 — the view built at the first spawn — on serial AND M:N, at every
# `--threads`. An earlier cut refreshed the view at "the next slot write, else the join" instead, which
# made the M:N EAGER per-connection path pin at the spawn and the lazy path pin later: `--serial`
# printed 2, bare `run` 1, and `--threads=1` flipped it back to 2.
aq: List[int] = [1]

test fn in_place_mutation_between_two_spawns_of_one_nursery():
    a := Shared(0)
    b := Shared(0)
    parallel:
        spawn: a.set(aq.len())
        aq.push(2)
        spawn: b.set(aq.len())
    assert a.get() == 1, "first task saw len {a.get()}"
    assert b.get() == 1, "second task saw len {b.get()}"
    assert aq.len() == 2, "parent saw len {aq.len()}"

# The same shape one level down — a nursery NESTED inside a task, which on M:N with >= 2 hardware
# threads is the EAGER per-connection path (the `std.net` `serve` shape: accept, spawn a handler, append
# to a log global). The eager path prepares the task AT the spawn, so its pin must be taken there too.
nq: List[int] = [1]

fn nested_pin_worker(out: Shared[int]):
    parallel:
        spawn: out.set(nq.len())
        nq.push(2)

test fn nested_nursery_in_a_task_pins_at_its_first_spawn():
    out := Shared(0)
    parallel:
        spawn nested_pin_worker(out)
    assert out.get() == 1, "nested task saw len {out.get()}"
    assert nq.len() == 1, "task mutation leaked: {nq.len()}"

# A global ASSIGNMENT between two spawns of one nursery DOES refresh the view (rule 1 — the slot write
# drops the cache), so the second task sees the new value. Same on both engines: the write is a source
# position, not a scheduling artifact.
sg: int = 1

test fn assignment_between_two_spawns_refreshes_the_view():
    a := Shared(0)
    b := Shared(0)
    parallel:
        spawn: a.set(sg)
        sg = 2
        spawn: b.set(sg)
    assert a.get() == 1, "first task saw {a.get()}"
    assert b.get() == 2, "second task saw {b.get()}"

# --- ISOLATION control (must stay green: the fix removes staleness, NOT isolation) -------------

test fn task_side_mutation_does_not_reach_parent():
    xg = 1
    parallel:
        spawn: set_x(5)
    assert xg == 1, "task mutation leaked: {xg}"

fn set_x(v: int):
    xg = v

# --- the NESTED rule ---------------------------------------------------------------------------

# A task mutates its OWN copy, then opens a nested `parallel:`: its children must see the TASK's
# current view (99), not the parent module's (1). Also exercises W6-19 (a task whose FIRST module-
# global access is a WRITE used to panic the M:N pool on an unfaulted module).
fn nested_worker(out: Shared[int]):
    tg = 99
    parallel:
        spawn: out.set(tg)

test fn nested_nursery_sees_the_tasks_current_view():
    out := Shared(0)
    parallel:
        spawn nested_worker(out)
    assert out.get() == 99, "nested task saw {out.get()}"
    assert tg == 1, "nested task mutation leaked: {tg}"

# --- Executor ----------------------------------------------------------------------------------

# A submitted job sees the globals as of the instant it STARTS. That instant is engine-specific: the
# `submit` on the default engine (eager execution — the job is already running) and the drain on
# `--serial`, which still queues at `submit` (decision D3). The two agree whenever nothing mutates in
# between, which is exactly the documented test shape for an `Executor`: **assert after `shutdown()`,
# never between**. The engine-specific instant itself is pinned in Rust, where a per-engine
# expectation is expressible (`executor_job_sees_globals_as_of_the_submit_on_mn`).
#
# What this still catches on both engines: a job that snapshots a global at DECLARATION time (`1`)
# rather than at its start would read `1` here.
test fn executor_task_sees_globals_as_of_its_start():
    seen := Shared(0)
    exg = 123
    ex := Executor()
    ex.submit(fn(): seen.set(exg))
    ex.shutdown()
    assert seen.get() == 123, "executor job saw {seen.get()}"

# An `Executor` job runs against its OWN private module view (the same deep copy a task gets), so its
# in-place mutation must never reach a sibling nursery task. It used to: the view-refresh hook fired
# while the job's private view was installed but the PARENT's task list was still pending, handing the
# job's view to a parent task (`--serial` saw the job's `push`, M:N did not — a parity break AND an
# isolation break).
eq: List[int] = []
eqn: int = 0

fn eq_job():
    eq.push(7)
    eqn = 5

test fn an_executor_jobs_private_mutation_never_reaches_a_nursery_task():
    seenq := Shared(-1)
    seenn := Shared(-1)
    ex := Executor()
    parallel:
        spawn: seenq.set(eq.len())
        spawn: seenn.set(eqn)
        ex.submit(eq_job)
        ex.shutdown()
    assert seenq.get() == 0, "task saw the job's private push: len {seenq.get()}"
    assert seenn.get() == 0, "task saw the job's private write: {seenn.get()}"
    assert eq.len() == 0, "job mutation leaked to the parent: {eq.len()}"
    assert eqn == 0, "job write leaked to the parent: {eqn}"

# An `Executor` job and a nursery task side by side. Before eager execution these pinned DIFFERENT
# instants — the task at its `spawn`, the job at the later drain — and the test's job was to contrast
# them. Eager execution collapses that difference on the default engine (a job starts at its `submit`,
# so both now pin "when this work started"), and `--serial` still drains late, so the contrast is no
# longer an engine-agnostic property. What is: BOTH paths must snapshot the CURRENT value of the
# global, never its declaration-time one — a stale snapshot in either path reads `1` here.
test fn executor_alongside_a_nursery():
    a := Shared(0)
    b := Shared(0)
    exg2 = 5
    ex := Executor()
    ex.submit(fn(): a.set(exg2))
    parallel:
        spawn: b.set(exg2)
    ex.shutdown()
    assert a.get() == 5, "executor job saw {a.get()}"
    assert b.get() == 5, "nursery task saw {b.get()}"

# --- bare `spawn` (the IMPLICIT nursery) -------------------------------------------------------

# A bare `spawn` binds to the implicit nursery the compiler opens at the TOP of the body and joins at
# its end — so the snapshot instant has to be the SPAWN, not the nursery: a per-nursery pin would
# freeze the whole body at its first bare `spawn` and replay every later global as `nil`.
fn bare_spawn_pair(a: Shared[int], b: Shared[int]):
    spawn: a.set(bsg)
    bsg = 42
    spawn: b.set(bsg)

test fn bare_spawns_see_the_global_live_at_their_own_spawn():
    a := Shared(0)
    b := Shared(0)
    bare_spawn_pair(a, b)
    assert a.get() == 1, "first bare spawn saw {a.get()}"
    assert b.get() == 42, "second bare spawn saw {b.get()}"

# A bare `spawn` with an explicit `parallel:` after it: the inner join is where M:N EARLY-ENLISTS the
# outer implicit nursery's task, so both engines pin there and a LATER write reaches neither task.
fn bare_then_nested(a: Shared[int], b: Shared[int]):
    spawn: a.set(egg)
    parallel:
        spawn: b.set(egg)
    egg = 7

test fn bare_spawn_alongside_a_nested_nursery():
    a := Shared(0)
    b := Shared(0)
    bare_then_nested(a, b)
    assert a.get() == 1, "outer (bare) task saw {a.get()}"
    assert b.get() == 1, "inner task saw {b.get()}"
    assert egg == 7, "parent saw {egg}"

# --- teardown / cancel matrix (this subsystem produced the N1–N9 cascade) ----------------------

fn boom():
    panic("task blew up")

# A task fault still propagates with its own message.
test fn a_faulting_task_still_propagates():
    r := recover:
        parallel:
            spawn boom()
    match r:
        Ok(_): assert false, "expected a fault"
        Err(e): assert e.message().contains("task blew up"), "got {e.message()}"

# A `?`-style escape out of a nursery: the escape propagates and the scope tears down cleanly.
fn escape_out() -> Result[int, Error]:
    parallel:
        spawn: esc = 2
        return Err("bail")
    return Ok(0)

test fn escape_out_of_a_nursery_tears_down():
    r := escape_out()
    match r:
        Ok(_): assert false, "expected the escape"
        Err(e): assert e.message() == "bail"

# A nested nursery inside a task that then faults: teardown must not desync the per-nursery pin.
fn nested_then_fault(out: Shared[int]):
    parallel:
        spawn: out.set(n)
    panic("after nested")

test fn nested_nursery_inside_a_faulting_task():
    out := Shared(0)
    r := recover:
        parallel:
            spawn nested_then_fault(out)
    match r:
        Ok(_): assert false, "expected a fault"
        Err(e): assert e.message().contains("after nested"), "got {e.message()}"
    assert out.get() == 42, "nested task saw {out.get()}"

# A `defer` that reads a module global while running during teardown.
fn defer_reads_global(out: Shared[int]):
    defer out.set(n)
    parallel:
        spawn: tot.add(1)

test fn defer_reads_a_global_during_teardown():
    out := Shared(0)
    parallel:
        spawn defer_reads_global(out)
    assert out.get() == 42, "defer saw {out.get()}"

# A nursery in a LOOP: each iteration's task is pinned at its own spawn, so it sees that
# iteration's value.
test fn nursery_in_a_loop_pins_per_iteration():
    seen := Shared(0)
    total := 0
    for i in range(10):
        loopg = i
        parallel:
            spawn: seen.set(loopg)
        total = total + seen.get()
    assert total == 45, "sum of per-iteration views was {total}"
