# TICKET-142 (W14-32): `_` is Go's blank identifier in `:=`, `=` and destructuring, at every scope.
# `_ := e` / `_ = e` evaluate `e` and discard it; `_` is never declared, so it has no type to freeze
# and no module global slot.
#
# This file must NEVER gain a top-level `_ :=`: `collect_globals` pre-scans every top-level `Let`, so
# one such line would give `_` a global slot and hide a missing `_ =` discard in the compiler. The
# top-level `_ :=` shape lives in `blank_identifier_toplevel_let_test.chz`.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
fn f() -> int?:
    return None

fn g() -> str?:
    return None

_ = f()
_ = g()

test fn blank_assign_in_fn_without_decl():
    _ = g()
    assert true

test fn blank_in_nested_fn():
    fn inner() -> int:
        _ = g()
        return 1
    assert inner() == 1

test fn blank_in_destructure():
    a, _ := (1, "x")
    b, _ := ("y", 2)
    assert a == 1
    assert b == "y"

test fn blank_let_twice_in_fn():
    _ := f()
    _ := g()
    assert true

# A `_` element of a multi-target `=` discards its element, as in Python and Go (`a, _ = 1, 2`).
test fn blank_element_in_tuple_assign():
    a := 0
    b := [0]
    a, _ = (1, 2)
    _, b[0] = (3, 4)
    _, _ = (5, 6)
    assert a == 1
    assert b == [4]

test fn blank_element_in_tuple_assign_inside_nested_fn():
    fn inner() -> int:
        x := 0
        x, _ = (7, 8)
        return x
    assert inner() == 7
