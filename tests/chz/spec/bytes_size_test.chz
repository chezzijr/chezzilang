# `bytes.zeroed(n)` gives `n` zero bytes, as `bytearray.zeroed(n)` does (owner decision 2026-11-03, U5). CPython
# prints `b'\x00\x00'` for `bytes(2)` and faults `negative count` for `bytes(-1)`. The capacity rule
# is in `alloc_fault_grid_test.chz`.

fn fault(op: fn() -> int) -> str:
    r := recover: op()
    match r:
        ?n: return "ok {n}"
        !e: return e.message()

test fn bytes_of_a_size_is_that_many_zero_bytes():
    assert bytes.zeroed(2) == b"\x00\x00"
    assert bytes.zeroed(0) == b""
    assert bytes.zeroed(3).len() == 3
    assert bytes.zeroed(2) == bytes.from_iter(bytearray.zeroed(2))

test fn a_negative_size_faults_as_for_bytearray():
    assert fault(fn() -> int: bytes.zeroed(-1).len()) == "bytes.zeroed() size -1 must be non-negative"
    assert fault(fn() -> int: bytearray.zeroed(-1).len()) == "bytearray.zeroed() size -1 must be non-negative"

test fn the_other_forms_are_unchanged():
    assert bytes.from_iter([1, 2]) == b"\x01\x02"
    assert bytes.from_iter(b"ab") == b"ab"
    assert bytes.from_iter(bytearray.from_iter([7])) == b"\x07"
