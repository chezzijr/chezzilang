# tests/chz/spec/protocol_overload_test.chz: ANY parameterized protocol keys overloads of its
# method, not only `std.convert`'s four. `Parse[S]` declares `parse(x: S) -> Self`, so a type
# may declare one `parse` per source `S` (Rust: `impl Parse<i64> for W` beside
# `impl Parse<&str> for W`), and `W.parse(3)` runs the overload the argument picks. The module
# that declares the overloads sees the protocol (declares or imports it); a caller needs neither.
#
# The rejects (no protocol in scope is "already defined", two protocols that key one name
# differently) are Rust checker tests (`src/checker/tests/from_overloads.rs`).
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import Tag from protocol_overload_lib

protocol Parse[S]:
    fn parse(x: S) -> Self

struct W:
    n: int
    fn parse(x: int) -> W:
        return W(x)
    fn parse(x: str) -> W:
        return W(x.len() * 10)

fn make[S, T: Parse[S]](x: S) -> T:
    return T.parse(x)

test fn the_argument_picks_the_overload():
    assert W.parse(3).n == 3
    assert W.parse("ab").n == 20

test fn a_bound_call_picks_the_same_overload():
    a: W = make(4)
    b: W = make("abc")
    assert a.n == 4
    assert b.n == 30

test fn an_importer_of_the_struct_alone_calls_the_overloads():
    assert Tag.parse(7).s == "int 7"
    assert Tag.parse("x").s == "str x"
