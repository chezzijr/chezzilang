# tests/chz/spec/nursery_escape_defer_order_test.chz — W14-4: an escape (`return`) from `parallel:`
# must let the nursery's cancelled children finish unwinding (their defers run) BEFORE any
# enclosing block's defer runs. Go twin: cancel + wg.Wait() before return.
import std.time
import std.concurrency


fn flushed() -> int:
    log := Channel[str](10)
    count := Shared(0)
    fn inner() -> int:
        defer:
            log.close()
            while true:
                match log.try_recv():
                    Some(m): count.update(fn(c: int) -> int: c + 1)
                    None: break
        parallel:
            spawn:
                defer log.send("worker cleanup")
                time.sleep_ms(3000)
            return 1
        return 0
    inner()
    return count.get()

test fn return_from_nursery_runs_child_defers_before_enclosing_defers():
    assert flushed() == 1
