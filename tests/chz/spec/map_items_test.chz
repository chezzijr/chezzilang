# tests/chz/spec/map_items_test.chz — TICKET-160: `Map.items()` returns `List[(K, V)]` in insertion order.

test fn items_round_trips_through_the_map_ctor():
    m := {"a": 1, "b": 2}
    assert Map(m.items()) == m, "Map(m.items()) round-trips"
    assert m.items() == [("a", 1), ("b", 2)], "items() is insertion-ordered pairs"
