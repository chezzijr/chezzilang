# Helper MODULE for `spawn_module_target_test.chz` — the thing that gets spawned INTO.
#
# Not a `*_test.chz`, so `chezzi test` never picks it up on its own; it exists so the test next door
# can spell a module-qualified `spawn` target whose effect is observable.
import std.concurrency

# Add `by` to the shared box. The box is a `Shared` handle, so the write is visible to the spawner
# after the nursery joins — which is what makes "the spawned call actually RAN" assertable.
fn bump(box: Shared[int], by: int) -> int:
    box.update(fn(v: int) -> int: v + by)
    return by
