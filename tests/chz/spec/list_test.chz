# tests/chz/spec/list_test.chz — List behavior spec, dogfooded with `assert`.
#
# Ported from the Rust string-goldens in src/vm/tests.rs (`list_*_parity`) and
# src/vm/golden_tests.rs (`parity_list_*`): those printed a value and matched stdout; here we
# assert the value directly. Run: `cargo run -- test tests/chz/`. Every test here is asserted to
# pass by the `cargo test` gate `chz_suite_passes` (`tests/chz_suite.rs`).
#
# Fault-path cases (empty min()/max(), OOB remove_at, non-positive chunk(), overflow sum) stay in
# Rust — `assert` cannot catch a runtime fault's message, so they have no in-language equivalent.

# ---- first / last / reversed (non-mutating) ----

test fn first_last_reversed():
    xs := [3, 1, 2]
    match xs.first():
        Some(v): assert v == 3
        None: assert false, "first of non-empty"
    match xs.last():
        Some(v): assert v == 2
        None: assert false, "last of non-empty"
    assert xs.reversed() == [2, 1, 3]
    assert xs == [3, 1, 2], "reversed() does not mutate"

test fn first_last_empty_none():
    empty: List[int] = []
    match empty.first():
        Some(_): assert false, "empty first must be None"
        None: assert true
    match empty.last():
        Some(_): assert false, "empty last must be None"
        None: assert true

# ---- insert / remove_at (Python-clamp / Python-relative) ----

test fn insert_remove_at():
    xs := [1, 2, 3]
    xs.insert(0, 9)
    assert xs == [9, 1, 2, 3]
    xs.insert(2, 8)
    assert xs == [9, 1, 8, 2, 3]
    xs.insert(100, 7)
    assert xs == [9, 1, 8, 2, 3, 7], "i>len appends"
    xs.insert(-1, 5)
    assert xs == [9, 1, 8, 2, 3, 5, 7], "negative is Python-relative"
    assert xs.remove_at(0) == 9
    assert xs == [1, 8, 2, 3, 5, 7]
    assert xs.remove_at(-1) == 7, "negative index removes from the end"
    assert xs == [1, 8, 2, 3, 5]

# ---- min / max ----

test fn min_max_scalar():
    assert [3, 1, 2].min() == Some(1)
    assert [3, 1, 2].max() == Some(3)
    assert [1.5, 0.5, 2.5].min() == Some(0.5)
    assert [1.5, 0.5, 2.5].max() == Some(2.5)
    assert ["pear", "apple", "kiwi"].min() == Some("apple")
    assert ["pear", "apple", "kiwi"].max() == Some("pear")

# Empty is `None`, NOT a fault — the whole family (`min`/`max`/`min_by`/`max_by`) matches its
# `first`/`last`/`pop` siblings (Rust's `Iterator::min`), so no `recover:` is needed.
test fn min_max_empty_is_none():
    xs: List[int] = []
    assert xs.min() == None
    assert xs.max() == None
    assert xs.min_by(fn(x: int) -> int: x) == None
    assert xs.max_by(fn(x: int) -> int: x) == None
    fs: List[float] = []
    assert fs.min() == None
    assert fs.max() == None
    ss: List[str] = []
    assert ss.min() == None
    assert ss.max() == None
    # `??` is the terse caller spelling (there is no `.unwrap()` by design)
    assert (xs.min() ?? -1) == -1
    assert (xs.max_by(fn(x: int) -> int: x) ?? -2) == -2

# `min_by`/`max_by` return the ELEMENT whose key is extremal, wrapped in `Some`; first-seen ties.
test fn min_max_by_scalar():
    xs := [3, 1, 2]
    assert xs.min_by(fn(x: int) -> int: -x) == Some(3)
    assert xs.max_by(fn(x: int) -> int: -x) == Some(1)
    # equal keys never displace the earlier element
    ys := ["bb", "aa", "cc"]
    assert ys.min_by(fn(s: str) -> int: s.len()) == Some("bb")
    assert ys.max_by(fn(s: str) -> int: s.len()) == Some("bb")

struct P:
    k: int
    tag: str
    fn compare(self, o: P) -> int:
        return self.k - o.k
    fn eq(self, o: P) -> bool:
        return self.k == o.k

test fn min_max_comparable_struct():
    # first-seen tie-break for equal minima (P(1,"b") before P(1,"c"))
    xs := [P(2, "a"), P(1, "b"), P(1, "c"), P(3, "d")]
    match xs.min():
        Some(p): assert p.tag == "b"
        None: assert false, "min of a non-empty list is Some"
    match xs.max():
        Some(p): assert p.tag == "d"
        None: assert false, "max of a non-empty list is Some"
    # …and a Comparable-struct element list that IS empty still answers None, no fault
    es: List[P] = []
    assert es.min() == None
    assert es.max() == None

# ---- unique / dedup ----

test fn unique_dedup():
    assert [3, 1, 3, 2, 1].unique() == [3, 1, 2]
    assert [1, 1, 2, 2, 2, 1, 3, 3].dedup() == [1, 2, 1, 3]
    empty: List[int] = []
    assert empty.unique() == []
    assert [2, 2, 2].unique() == [2]
    assert [1.5, 1.5, 2.5].dedup() == [1.5, 2.5]
    xs := [3, 1, 3, 2, 1]
    u := xs.unique()
    assert xs == [3, 1, 3, 2, 1], "unique() does not mutate"

# ---- chunk / windows ----

test fn chunk_windows():
    assert [1, 2, 3, 4, 5].chunk(2) == [[1, 2], [3, 4], [5]]
    assert [1, 2, 3].chunk(3) == [[1, 2, 3]]
    assert [1, 2].chunk(5) == [[1, 2]], "chunk > len yields one short chunk"
    assert [1, 2, 3, 4].windows(2) == [[1, 2], [2, 3], [3, 4]]
    assert [1, 2].windows(5) == [], "window > len yields empty"

# ---- take_while / drop_while ----

test fn take_drop_while():
    lt3 := fn(x: int) -> bool: x < 3
    assert [1, 2, 3, 4, 1].take_while(lt3) == [1, 2]
    assert [1, 2, 3, 4, 1].drop_while(lt3) == [3, 4, 1]
    assert [5, 1].take_while(lt3) == [], "empty prefix"
    assert [5, 1].drop_while(lt3) == [5, 1]

# ---- count / position ----

test fn count_position():
    is2 := fn(x: int) -> bool: x == 2
    assert [1, 2, 3, 2, 1].count(is2) == 2
    assert [1, 2, 3].count(fn(x: int) -> bool: false) == 0
    match [1, 2, 3, 2].position(is2):
        Some(i): assert i == 1, "position is first-hit-wins"
        None: assert false, "should find a match"
    match [1, 3].position(is2):
        Some(_): assert false, "no match must be None"
        None: assert true

# ---- pop / contains / index_of / sum / reverse ----

test fn pop():
    xs := [1, 2, 3]
    match xs.pop():
        Some(v): assert v == 3
        None: assert false, "pop non-empty"
    assert xs.len() == 2
    ys := [1]
    _ := ys.pop()
    match ys.pop():
        Some(_): assert false, "pop empty must be None"
        None: assert true

test fn contains_index_of_sum():
    assert [1, 2, 3].contains(2) == true
    assert [1, 2, 3].contains(9) == false
    assert [10, 20, 30].index_of(20) == 1
    assert [1, 2].index_of(9) == -1, "not found is -1"
    assert [1, 2, 3, 4].sum() == 10

test fn reverse_mutates():
    xs := [3, 1, 2]
    xs.reverse()
    assert xs == [2, 1, 3], "reverse() mutates in place (unlike reversed())"

# ---- sort / sort_by ----

test fn sort():
    xi := [3, 1, 2]
    xi.sort()
    assert xi == [1, 2, 3]
    xs := ["banana", "apple", "cherry"]
    xs.sort()
    assert xs == ["apple", "banana", "cherry"]
    xf := [3.5, 1.1, 2.2]
    xf.sort()
    assert xf == [1.1, 2.2, 3.5]

test fn sort_by():
    xs := ["ccc", "a", "dd", "b"]
    xs.sort_by(fn(a: str, b: str) -> int: a.len() - b.len())
    assert xs == ["a", "b", "dd", "ccc"], "stable sort by length"
    ns := [[3, 0], [1, 0], [2, 0]]
    ns.sort_by(fn(a: List[int], b: List[int]) -> int: a[0] - b[0])
    assert ns == [[1, 0], [2, 0], [3, 0]]

# ---- map / filter / fold ----

test fn map_filter_fold():
    assert [1, 2, 3].map(fn(x: int) -> int: x * 2) == [2, 4, 6]
    assert [1, 2, 3].map(fn(x: int) -> str: "n{x}") == ["n1", "n2", "n3"]
    assert [1, 2, 3, 4].filter(fn(x: int) -> bool: x % 2 == 0) == [2, 4]
    assert ["a", "b", "c"].fold("", fn(a: str, x: str) -> str: a + x) == "abc"
    assert [1, 2, 3, 4].fold(0, fn(a: int, x: int) -> int: a + x) == 10

# ---- a bare GENERIC fn passed as a higher-order argument ----
#
# The rule is "every type parameter must be determined at every position the fn is READ as a value",
# and the argument position's verdict is DEFERRED to the end of the call — `[1,2,3].fold(0, dup)`
# pins `dup`'s `T` from the FIRST argument (the accumulator) while `dup` is the SECOND, so a
# per-argument eager check would refuse a program Go accepts. This is the RUNNING half: it proves
# the pin the checker records is the one the erased fn actually runs with. The rejections (`pred`
# whose `T` appears nowhere, `mk` whose `T` is return-only) are `src/checker/tests.rs`
# (`undetermined_generic_fn_value_rejected_in_argument_position`) — they never reach a runtime.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

fn gid[T](x: T) -> T:
    return x

fn gsecond[T](a: T, b: T) -> T:
    return b

fn geven[T](x: T) -> bool:
    return true

struct Applier:
    n: int
    # the fn slot BEFORE the argument that pins it — the order no builtin can spell
    fn fn_first[U](self, f: fn(U) -> U, x: U) -> U:
        return f(x)
    fn fn_last[U](self, x: U, f: fn(U) -> U) -> U:
        return f(x)

test fn a_generic_fn_as_a_higher_order_argument():
    # pinned by the RECEIVER's element type
    assert [1, 2, 3].map(gid) == [1, 2, 3]
    assert ["a", "b"].map(gid) == ["a", "b"]
    assert [1, 2, 3].filter(geven) == [1, 2, 3]
    # THE ordering case: the accumulator is argument 0, the generic fn is argument 1
    assert [1, 2, 3].fold(0, gsecond) == 3
    assert ["a", "b", "c"].fold("", gsecond) == "c"
    # …and both orders on a user generic method, where the pin can come from the LATER argument too
    a := Applier(0)
    assert a.fn_first(gid, 5) == 5
    assert a.fn_last(5, gid) == 5
    assert a.fn_first(gid, "s") == "s"
    # a turbofish pins a return-only type param the slot cannot
    assert [1, 2].map(empty_of[str]) == [[], []]
    # an EMPTY receiver suppresses the REPORT, never the PIN: `fold`'s slot reads `fn(A, ?) -> A`,
    # non-concrete because there is no element type — but argument ZERO determines `T` outright, and
    # Go's `Fold([]int{}, 0, add)` returns `0`. `map`'s slot has no concrete parameter, so only
    # `fold` catches a pin that the empty receiver killed.
    assert [].fold(0, gsum) == 0
    assert [].fold("", gsecond) == ""
    assert [1, 2, 3].fold(0, gsum) == 6

fn empty_of[T](n: int) -> List[T]:
    return []

fn gsum[T: Add](a: T, b: T) -> T:
    return a + b

# ---- …and when the HOF is itself GENERIC ----
#
# One level up from the block above: the slot belongs to a generic callee, so the callee's OWN type
# parameter has to be pinned by the other arguments (or the turbofish, or the annotation) FIRST, and
# only then can the passed fn's parameters unify against the now-concrete slot. The same end-of-call
# deferral does it — the free-fn path just has more sources to wait for. Measured this session, Go
# 1.26.5 and Rust 1.97 both print `5` for every one of these; Chezzi refused them until the deferral
# ran here too. The shapes that must KEEP being refused (`nopin(gid)`, `applyg(empty_of, 5)`,
# `twop(empty_of, 5)` — Go: `cannot infer U` / shape mismatch / `cannot infer B`) are in
# `src/checker/tests.rs`; they never reach a runtime. This is the RUNNING half, and it is the whole
# point of the tests: a widening that type-checks but yields a value of unresolved type would be far
# worse than the false reject it replaces, so every assert below pins the VALUE.

fn applyg[U](f: fn(U) -> U, n: U) -> U:
    return f(n)

fn applyr[U](n: U, f: fn(U) -> U) -> U:
    return f(n)

fn twop[A, B](f: fn(A) -> B, a: A) -> B:
    return f(a)

fn gtext[T](x: T) -> str:
    return "{x}"

fn gfirst[T, S](a: T, b: S) -> T:
    return a

fn app2[U](f: fn(U, U) -> U, a: U) -> U:
    return f(a, a)

fn mklist[U](f: fn(U) -> U) -> List[U]:
    return []

test fn a_generic_fn_argument_to_a_generic_hof():
    # the callee's `U` comes from a LATER argument, then pins `gid`'s `T`
    assert applyg(gid, 5) == 5
    assert applyg(gid, "s") == "s"
    # …and from an EARLIER one
    assert applyr(5, gid) == 5
    # two callee parameters: `A` from the value argument, `B` only through the passed fn's return
    assert twop(gid, 5) == 5
    assert twop(gtext, 5) == "5"
    # nested generic HOFs, and one fn value used at TWO types in one call (each pin gets a fresh map)
    assert applyg(gid, applyg(gid, 5)) == 5
    assert applyg(gid, 1) + applyg(gid, 2) == 3
    assert applyg(gid, "a") + twop(gtext, 2) == "a2"
    # a turbofish on the CALL pins the callee with no value argument in sight …
    assert applyg[int](gid, 5) == 5
    # … and one on the ARGUMENT is not a bare read at all
    assert applyg(gid[int], 5) == 5
    # a passed fn with TWO type parameters, both reachable from the slot
    assert app2(gfirst, 5) == 5
    # the enclosing annotation pins the callee's return-only `U`, which then pins the fn
    xs: List[int] = mklist(gid)
    assert xs == []
    # the inferred type is REAL, not an unresolved placeholder: these only compile as `int`/`str`
    assert applyg(gid, 5) * 2 == 10
    assert applyg(gid, "s").upper() == "S"
    assert twop(gtext, 5).upper() == "5"
