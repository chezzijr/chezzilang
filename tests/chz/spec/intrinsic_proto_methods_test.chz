# tests/chz/spec/intrinsic_proto_methods_test.chz — an intrinsic protocol method is CALLABLE.
#
# Bug-hunt wave-6 W6-3: the checker grants built-ins intrinsic conformance to Add/Sub/Mul/Div/Mod/
# Neg/Hashable/Comparable/Stringable/Index/IndexSet/Slice with NO user method, so an erased generic
# body may call `a.add(b)` / `x.hash()` / `c.index(k)` on a concrete built-in. Every arm must be
# OBSERVATIONALLY IDENTICAL to its operator form (same value, same fault message).
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

# ---- erased generic bodies (the shape under test) ----

fn total[T: Add](xs: List[T], zero: T) -> T:
    acc := zero
    for x in xs:
        acc = acc.add(x)
    return acc

fn add_m[T: Add](a: T, b: T) -> T:
    return a.add(b)

fn sub_m[T: Sub](a: T, b: T) -> T:
    return a.sub(b)

fn mul_m[T: Mul](a: T, b: T) -> T:
    return a.mul(b)

fn div_m[T: Div](a: T, b: T) -> T:
    return a.div(b)

fn mod_m[T: Mod](a: T, b: T) -> T:
    return a.mod(b)

fn neg_m[T: Neg](a: T) -> T:
    return a.neg()

fn hash_m[T: Hashable](a: T) -> int:
    return a.hash()

fn cmp_m[T: Comparable](a: T, b: T) -> int:
    return a.compare(b)

fn eq_m[T: Eq](a: T, b: T) -> bool:
    return a.eq(b)

fn str_m[T: Stringable](a: T) -> str:
    return a.str()

# ---- helpers ----

fn msg_of[T](r: Result[T, Error], where_: str) -> str:
    match r:
        Ok(_): assert false, where_ + " must fault"
        Err(e): return e.message()
    return ""

# ---- int / float arithmetic methods == the operator forms ----

test fn int_arith_methods_match_operators():
    assert total([1, 2, 3], 0) == 6, "the filed W6-3 repro"
    assert add_m(2, 3) == 2 + 3
    assert sub_m(7, 2) == 7 - 2
    assert mul_m(6, 7) == 6 * 7
    assert div_m(7, 2) == 7 / 2
    assert mod_m(7, 2) == 7 % 2
    assert neg_m(5) == -5
    assert neg_m(-5) == -(-5)
    # mixed-sign int div/mod must match the operator exactly (truncation direction)
    assert div_m(-7, 2) == -7 / 2
    assert mod_m(-7, 2) == -7 % 2

test fn float_arith_methods_match_operators():
    assert add_m(1.5, 2.25) == 1.5 + 2.25
    assert sub_m(1.5, 2.25) == 1.5 - 2.25
    assert mul_m(1.5, 2.25) == 1.5 * 2.25
    assert div_m(1.5, 2.5) == 1.5 / 2.5
    assert mod_m(7.5, 2.0) == 7.5 % 2.0
    assert neg_m(2.5) == -2.5
    # 1.0/0.0 is inf (NOT a fault) on both forms; -0.0 renders identically
    assert str(div_m(1.0, 0.0)) == str(1.0 / 0.0)
    assert str(neg_m(0.0)) == str(-0.0)
    assert str(neg_m(-0.0)) == str(-(-0.0))

test fn arith_method_faults_match_operator_faults():
    big := 9223372036854775807
    small := -big - 1
    rm := recover: add_m(big, 1)
    ro := recover: big + 1
    assert msg_of(rm, "add_m") == msg_of(ro, "+")
    rm = recover: sub_m(small, 1)
    ro = recover: small - 1
    assert msg_of(rm, "sub_m") == msg_of(ro, "-")
    rm = recover: mul_m(big, 2)
    ro = recover: big * 2
    assert msg_of(rm, "mul_m") == msg_of(ro, "*")
    rm = recover: div_m(1, 0)
    ro = recover: 1 / 0
    assert msg_of(rm, "div_m") == msg_of(ro, "/")
    assert msg_of(rm, "div_m") == "division by zero"
    rm = recover: mod_m(1, 0)
    ro = recover: 1 % 0
    assert msg_of(rm, "mod_m") == msg_of(ro, "%")
    rm = recover: neg_m(small)
    ro = recover: -small
    assert msg_of(rm, "neg_m") == msg_of(ro, "unary -")
    assert msg_of(rm, "neg_m") == "integer overflow in negation"

# ---- MIN % -1 is representable (0), unlike MIN / -1 — Task 2 fix, docs/gaps.md:1950 ----
#
# `i64::MIN % -1` mathematically IS `0`; Rust's `checked_rem` returns `None` there only to dodge the
# x86 `IDIV` hardware trap, not because the answer overflows. `MIN / -1` is a REAL overflow (the true
# quotient 2^63 doesn't fit an i64) and keeps its fault. Three runtime arms compute `%`: `fast_int_bin`
# (both operands inline, i.e. within ±2^62), the general `arith` path (at least one boxed operand —
# `MIN` itself is ALWAYS boxed, since `Value::INT_MIN_INLINE` is `-(2^62)`, far above `i64::MIN`, so a
# plain local `%` and a peephole-declined constant expression both land here), and `arith_scalar` (the
# numeric-newtype same-type path, arm 3 — see `tests/chz/spec/newtype_test.chz`). `MIN` can never be
# an inline `Value`, so arm 1's own overflow branch is UNREACHABLE from Chezzi source — the regression
# test below only covers arm 1 with ordinary (non-overflowing) values.

test fn min_mod_neg_one_is_representable_zero():
    MIN := -9223372036854775807 - 1
    # plain local-variable `%` — MIN is always boxed, so this lands in the general `arith` path
    a := MIN
    b := -1
    assert a % b == 0
    # constant expression: the peephole DECLINES to fold this (`checked_rem` gives `None` there), so
    # the runtime `%` computes it — same general `arith` path, reached via the un-fused `Op::Mod`
    assert (-9223372036854775807 - 1) % -1 == 0

test fn mod_fast_path_ordinary_values_still_correct():
    # arm 1 (`fast_int_bin`) only ever sees operands within ±2^62 (never MIN — see the note above), so
    # this is a regression check, not an overflow-boundary one: `wrapping_rem` must still match
    # `checked_rem` for every representable input, run through the BinLocalLocal-fused local/local `%`.
    total := 0
    for i in range(1, 6):
        x := 17
        total = total + (x % i)
    assert total == 17 % 1 + 17 % 2 + 17 % 3 + 17 % 4 + 17 % 5

test fn min_mod_zero_and_min_div_neg_one_still_fault():
    MIN := -9223372036854775807 - 1
    rm := recover: MIN % 0
    match rm:
        Ok(_): assert false, "MIN % 0 must still fault"
        Err(e): assert e.message() == "modulo by zero"
    rd := recover: MIN / -1
    match rd:
        Ok(_): assert false, "MIN / -1 must still fault — the real overflow, unchanged"
        Err(e): assert e.message() == "integer overflow in Div"

test fn ordinary_mod_sign_unaffected():
    # pinned against measured Go 1.26 / this project's documented policy (docs/spec.md's integer
    # overflow policy note): `%` follows the DIVIDEND's sign (Rust/C/Go), NOT Python's floored `%`
    # (which follows the divisor — measured -7 % 3 == 2, 7 % -3 == -2 in Python on this box). This task
    # must never move the sign.
    assert 7 % 3 == 1
    assert -7 % 3 == -1
    assert 7 % -3 == 1

# ---- Hashable: the method must agree with real container hashing ----

test fn hash_method_agrees_with_container_hashing():
    # equal values hash equal, distinct values (almost surely) differ
    assert hash_m(3) == hash_m(3)
    assert hash_m("a") == hash_m("a")
    assert hash_m("a") != hash_m("b")
    assert hash_m(true) == hash_m(true)
    assert hash_m(true) != hash_m(false)
    assert hash_m(b"xy") == hash_m(b"xy")
    assert hash_m(b"xy") != hash_m(b"zz")
    # agreement with real container use (the same hash backs Map/Set lookup)
    m: Map[int, int] = {}
    m[5] = 1
    assert m.has(5)
    assert hash_m(5) == hash_m(5)
    s := Set(["k"])
    assert s.has("k")
    assert hash_m("k") == hash_m("k")

test fn hash_method_reachable_through_a_protocol_value():
    # the non-generic entry point into the same dispatch
    x: Hashable = 5
    assert x.hash() == hash_m(5)
    y: Hashable = "a"
    assert y.hash() == hash_m("a")

struct Unit:
    pass

struct OwnHash:
    fn hash(self) -> int:
        return 42

test fn zero_field_struct_hash_and_user_hash_control():
    # a zero-field struct is intrinsically Hashable (constant hash, no user method)
    assert hash_m(Unit()) == hash_m(Unit())
    assert Set([Unit()]).has(Unit()), "self-consistent with Set membership"
    # control: a struct that DEFINES `hash` still gets ITS method
    assert hash_m(OwnHash()) == 42
    assert OwnHash().hash() == 42

# ---- Index / IndexSet / Slice on built-in containers ----

fn ix_li[T: Index[int, int]](c: T, k: int) -> int:
    return c.index(k)

fn ix_map[T: Index[str, int]](c: T, k: str) -> int:
    return c.index(k)

fn ix_str[T: Index[int, str]](c: T, k: int) -> str:
    return c.index(k)

fn si_li[T: IndexSet[int, int]](c: T, k: int, v: int):
    c.set_index(k, v)

fn si_map[T: IndexSet[str, int]](c: T, k: str, v: int):
    c.set_index(k, v)

fn sl_li[T: Slice[List[int]]](c: T, a: int?, b: int?, st: int?) -> List[int]:
    return c.slice(a, b, st)

fn sl_str[T: Slice[str]](c: T, a: int?, b: int?, st: int?) -> str:
    return c.slice(a, b, st)

test fn list_index_and_slice_methods_match_operators():
    xs := [7, 8, 9]
    assert ix_li(xs, 0) == xs[0]
    assert ix_li(xs, 2) == xs[2]
    assert ix_li(xs, -1) == xs[-1], "negative indexing identical to the operator"
    assert sl_li(xs, Some(0), Some(2), None) == xs[0:2]
    assert sl_li(xs, None, None, None) == xs[:]
    assert sl_li(xs, None, None, Some(-1)) == xs[::-1], "reversed slice"
    assert sl_li(xs, Some(-2), None, None) == xs[-2:]
    # fault messages identical to the operator form
    rm := recover: ix_li(xs, 9)
    ro := recover: xs[9]
    assert msg_of(rm, "list.index") == msg_of(ro, "xs[9]")
    assert msg_of(rm, "list.index") == "index 9 out of bounds (len 3)"

test fn list_set_index_method_matches_operator():
    a := [1, 2, 3]
    b := [1, 2, 3]
    si_li(a, 0, 99)
    b[0] = 99
    assert a == b
    si_li(a, -1, 77)
    b[-1] = 77
    assert a == b
    rm := recover: si_li(a, 9, 0)
    ro := recover:
        b[9] = 0
    assert msg_of(rm, "list.set_index") == msg_of(ro, "b[9]=")

test fn map_index_and_set_index_methods_match_operators():
    m := {"a": 1, "b": 2}
    assert ix_map(m, "a") == m["a"]
    si_map(m, "c", 3)
    assert m == {"a": 1, "b": 2, "c": 3}
    si_map(m, "a", 9)
    assert m["a"] == 9
    n := {"a": 1}
    rm := recover: ix_map(n, "zz")
    ro := recover: n["zz"]
    assert msg_of(rm, "map.index") == msg_of(ro, "n[zz]")

test fn str_index_and_slice_methods_match_operators():
    s := "hello"
    assert ix_str(s, 0) == s[0]
    assert ix_str(s, -1) == s[-1]
    assert sl_str(s, Some(1), Some(3), None) == s[1:3]
    assert sl_str(s, None, None, Some(-1)) == s[::-1]
    rm := recover: ix_str(s, 9)
    ro := recover: s[9]
    assert msg_of(rm, "str.index") == msg_of(ro, "s[9]")

test fn bytes_and_bytearray_index_slice_methods():
    bs := b"abc"
    assert ix_li(bs, 0) == bs[0]
    assert ix_li(bs, -1) == bs[-1]
    ba := bytearray(b"abc")
    assert ix_li(ba, 1) == ba[1]
    si_li(ba, 0, 122)
    assert ba[0] == 122
    rm := recover: ix_li(bs, 9)
    ro := recover: bs[9]
    assert msg_of(rm, "bytes.index") == msg_of(ro, "bs[9]")

# ---- numeric newtype: intrinsic operator protocols ----

newtype Meters = float
newtype Count = int

test fn numeric_newtype_operator_methods():
    a := Meters(1.5)
    b := Meters(2.5)
    assert float(add_m(a, b)) == float(a + b)
    assert float(sub_m(a, b)) == float(a - b)
    assert float(mul_m(a, b)) == float(a * b)
    assert float(div_m(a, b)) == float(a / b)
    assert float(mod_m(Meters(7.5), Meters(2.0))) == float(Meters(7.5) % Meters(2.0))
    p := Count(7)
    q := Count(2)
    assert int(add_m(p, q)) == int(p + q)
    assert int(div_m(p, q)) == int(p / q)
    assert int(mod_m(p, q)) == int(p % q)

# ---- `Eq`: the method form and the `==` operator are ONE dispatch (M23) ----
#
# `.eq()` was already the structural equality `==` used; M23 made `==` route through a user `eq` too,
# so the two spellings must still answer identically for EVERY receiver — the intrinsic scalar grants,
# a numeric newtype (whose `==` auto-flows to the underlying), and a struct with its own `eq`.

struct Tol:
    n: int
    fn eq(self, o: Tol) -> bool:
        # deliberately unstructural: equal within ±1, so a structural answer is distinguishable
        d := self.n - o.n
        return d == 0 or d == 1 or d == -1

test fn eq_method_matches_the_equality_operator():
    assert eq_m(3, 3) == (3 == 3)
    assert eq_m(3, 4) == (3 == 4)
    assert eq_m(1.5, 1.5) == (1.5 == 1.5)
    assert eq_m("a", "a") == ("a" == "a")
    assert eq_m("a", "b") == ("a" == "b")
    assert eq_m(true, true) == (true == true)
    assert eq_m(true, false) == (true == false)
    wide := 4611686018427387900
    assert eq_m(wide, wide) == (wide == wide)
    assert eq_m(wide, wide + 1) == (wide == wide + 1)
    # a numeric newtype: `==` auto-flows to the underlying, and so does the method
    assert eq_m(Meters(1.5), Meters(1.5)) == (Meters(1.5) == Meters(1.5))
    assert eq_m(Count(1), Count(2)) == (Count(1) == Count(2))
    # a USER `eq` wins over the intrinsic in both spellings, and they still agree
    assert eq_m(Tol(5), Tol(6)) == (Tol(5) == Tol(6))
    assert (Tol(5) == Tol(6)) == true, "the user `eq` really is what answers"
    assert eq_m(Tol(5), Tol(9)) == (Tol(5) == Tol(9))
    assert (Tol(5) == Tol(9)) == false

test fn newtype_compare_matches_operator():
    a := Meters(1.5)
    b := Meters(2.5)
    assert (cmp_m(a, b) < 0) == (a < b)
    assert (cmp_m(b, a) < 0) == (b < a)
    assert cmp_m(b, b) == 0
    assert (cmp_m(Count(1), Count(2)) < 0) == (Count(1) < Count(2))

# ---- boxed (wide) scalars reach the same arms ----

test fn boxed_scalar_receivers():
    wide := 4611686018427387900
    assert add_m(wide, 100) == wide + 100
    assert sub_m(wide, 100) == wide - 100
    assert neg_m(wide) == -wide
    assert hash_m(wide) == hash_m(wide)
    assert cmp_m(wide, 1) == cmp_m(wide, 1)
    assert (cmp_m(wide, 1) > 0) == (wide > 1)

# ---- controls: the already-working arms must stay working ----

test fn scalar_compare_and_str_controls():
    assert (cmp_m(1, 2) < 0) == (1 < 2)
    assert cmp_m(2, 2) == 0
    assert (cmp_m("a", "b") < 0) == ("a" < "b")
    assert str_m(5) == "5"
    assert str_m(1.5) == str(1.5)
    assert str_m(true) == "true"
    assert str_m("hi") == "hi"

struct Vec2:
    x: int
    fn add(self, other: Vec2) -> Vec2:
        return Vec2(self.x + other.x)
    fn neg(self) -> Vec2:
        return Vec2(-self.x)

test fn user_struct_methods_still_win():
    assert add_m(Vec2(1), Vec2(2)).x == 3
    assert neg_m(Vec2(4)).x == -4
    assert total([Vec2(1), Vec2(2)], Vec2(0)).x == 3

struct Cell:
    xs: List[int]
    fn index(self, k: int) -> int:
        return self.xs[k]
    fn set_index(self, k: int, v: int):
        self.xs[k] = v

test fn user_struct_index_methods_still_win():
    c := Cell([1, 2, 3])
    assert ix_li(c, 1) == 2
    si_li(c, 1, 9)
    assert c.xs == [1, 9, 3]

# ---- NaN: `.compare()` is TOTAL, the operators stay IEEE (W6-3c) ----
#
# ONE order, one documented divergence. `.compare()` on a NaN operand answers the SAME total order
# `sort()` / `sort_by_key` / `.min()` / `.max()` already use (`f64::total_cmp`, NaN deterministically at
# one end) — it never faults. The operators `<`/`<=`/`>`/`>=` stay IEEE-754/Python/Rust: every NaN
# comparison is `false`. So the only rule to remember is "the method uses the total order, the
# operators use IEEE" — not that plus a value-domain fault.
#
# The NaN END is deliberately NOT hardcoded: the signbit of `0.0/0.0` is target-dependent (negative on
# x86 SSE2 ⇒ NaN ranks below `-inf` ⇒ sorts FIRST, `compare < 0`). The asserts below pin the ordering
# RELATIVE to `sort()` plus antisymmetry, which is the actual guarantee.

fn nan() -> float:
    z := 0.0
    return z / z

test fn compare_on_nan_uses_the_total_order():
    n := nan()
    # the operator form stays IEEE — false, never a fault
    assert (n < 1.0) == false
    assert (n > 1.0) == false
    assert (n <= 1.0) == false
    assert (n >= 1.0) == false
    # the method form is TOTAL: a strict ordering int, never a fault
    c := cmp_m(n, 1.0)
    assert c == -1 or c == 1, "compare answers a strict ordering of magnitude 1"
    assert cmp_m(1.0, n) == -c, "the total order is antisymmetric"
    # THE POINT: `compare` and `sort()` share ONE order — NaN lands on the same side of 1.0 in both
    xs := [1.0, n]
    xs.sort()
    assert (xs[0] != 1.0) == (c < 0), "compare and sort share ONE order"
    # `total_cmp` on identical bits is Equal, while IEEE `==` on NaN stays false — the total order's
    # definition, not a bug
    assert cmp_m(n, n) == 0
    assert (n == n) == false
    # a numeric newtype over float behaves identically, both spellings (order_key unwraps it)
    m := Meters(nan())
    assert (m < Meters(1.0)) == false
    assert cmp_m(m, Meters(1.0)) == c
    # unchanged: non-NaN floats, ints, and the ±0.0 pair (only NaN routes to the total order)
    assert (cmp_m(1.0, 2.0) < 0) == (1.0 < 2.0)
    assert cmp_m(3, 3) == 0
    assert cmp_m(2, 1) == 1
    nz := -1.0 * 0.0
    assert cmp_m(nz, 0.0) == 0, "non-NaN pairs unchanged: ±0.0 stay IEEE-Equal"

# ---- a numeric newtype may NOT define an operator-named method (W6-3d, RESOLVED 2026-07-27) ----
#
# This used to pin a real divergence: the intrinsic numeric grant is unconditional on such a method
# existing and intrinsic dispatch is miss-only, so `a.add(b)` dispatched the USER method (99) while
# `a + b` auto-flowed to the underlying's native op (3) — two spellings of one protocol operation
# disagreeing for the same receiver, silently. Ruling (a) resolved it by making that state
# UNREPRESENTABLE: `newtype Score = int:` with an `add`/`sub`/`mul`/`div`/`mod`/`neg`/`compare`
# method is now a CHECKER ERROR at the decl site, so the program below no longer compiles and the
# assertions it made are moot. The reject is a compile-time diagnostic, so it is pinned in Rust
# (`checker::tests::numeric_newtype_operator_named_method_is_rejected`) — `assert` cannot express it.
# What stays asserted HERE is the other half of the ruling: the operator still auto-flows for a
# numeric newtype that defines NO such method, and ordinary methods on one are still fine.
#
# (b) — dispatching the method as the operator — was implemented and rejected: it makes `<`
# intransitive under a heterogeneous `List[Comparable]`. See docs/gaps.md W6-3d.
#
# `eq` is rejected on EVERY newtype, numeric or not (gaps.md L5, closed 2026-08-08): W6-3d's
# "a non-numeric newtype has no operator to disagree with" is true for `+`/`<` and false for `==`,
# which every underlying defines. That reject is also a checker diagnostic
# (`checker::tests::newtype_eq_method_rejected_at_decl`); what stays asserted here is the behavior
# that remains — a newtype's `==` IS the underlying's equality, on both engines.

newtype Score = int:
    fn doubled(self) -> Score:
        return Score(int(self) * 2)

newtype Tag = str:
    fn shout(self) -> str:
        return str(self) + "!"

test fn newtype_equality_is_the_underlyings():
    assert (Tag("a") == Tag("a")) == true, "a non-numeric newtype's == unwraps to str equality"
    assert (Tag("a") == Tag("b")) == false, "…including when the values differ"
    assert (Tag("a") != Tag("b")) == true, "!= is the same dispatch, negated"
    assert (Score(1) == Score(1)) == true
    assert (Score(1) == Score(2)) == false
    assert Tag("a").shout() == "a!", "an ordinary method on a newtype is unaffected"

test fn numeric_newtype_operator_auto_flows_and_ordinary_methods_still_work():
    a := Score(1)
    b := Score(2)
    assert int(a + b) == 3, "the operator auto-flows to the underlying's native op"
    assert (a < b) == true, "the operator orders by the underlying"
    assert cmp_m(a, b) == -1, "the intrinsic Comparable grant answers the operator's verdict"
    assert int(a.doubled()) == 2, "an ordinary method on a numeric newtype is unaffected"
    assert int(add_m(a, b)) == 3, "the [T: Add] bound uses the intrinsic grant, not a user method"

# ---- `Iterator` = a cursor, `Iterable` = anything you can iterate (W6-3b) ----
#
# `next` is STATEFUL, so the `Iterator` bound only accepts something that HOLDS a position: a `.iter()`
# cursor, a generator's `Iterator[T]`, or a user struct with `next(self) -> Option[T]`. A raw collection
# used to satisfy it too and then faulted with `type list has no method 'next'`; it now satisfies only
# `Iterable`, and `[S: Iterable[T], T]` is the bound that accepts everything. The reject side is a
# checker diagnostic (`checker::tests::raw_collection_does_not_satisfy_iterator`); what is asserted here
# is that every ACCEPTED form really works on both engines.

fn next_m[S: Iterator[T], T](it: S) -> Option[T]:
    return it.next()

fn n_of[S: Iterable[T], T](xs: S) -> int:
    n := 0
    for _ in xs:
        n = n + 1
    return n

fn ones() -> Iterator[int]:
    yield 1
    yield 1

struct Down:
    n: int
    fn next(self) -> Option[int]:
        if self.n <= 0:
            return None
        self.n = self.n - 1
        return Some(self.n)

test fn iterator_bound_is_cursors_iterable_bound_is_collections():
    # a cursor minted from a raw list — `.next()` advances it
    c := [10, 20].iter()
    assert next_m(c) == Some(10)
    assert next_m(c) == Some(20)
    assert next_m(c) == None
    # a generator result is a cursor too
    g := ones()
    assert next_m(g) == Some(1)
    # …and so is a user struct with `next`
    d := Down(2)
    assert next_m(d) == Some(1)
    assert next_m(d) == Some(0)
    assert next_m(d) == None
    # a RAW collection goes through the `Iterable` bound, which recovers its element type
    assert n_of([1, 2, 3]) == 3
    assert n_of("abc") == 3
    assert n_of({1, 2}) == 2
    assert n_of(ones()) == 2, "every Iterator IS Iterable"
    # `for` over a raw collection is unchanged
    s := 0
    for x in [1, 2, 3]:
        s = s + x
    assert s == 6

# ---- `Iterable[T]` in TYPE position (an annotated param), not only as a bound ----
#
# The narrower `Iterator[T]` already worked as a value type (it is what a generator returns); the
# broader `Iterable[T]` did not — the checker accepted the annotation AND the `List[int]` argument,
# then refused the one operation the protocol promises (`cannot iterate over Iterable[int]`).
# Reject side (bare `Iterable`, `for i, v in`, `.next()`, the invariance fences) is in
# `checker::tests::iterable_type_position_*`; what is asserted here is that every accepted shape
# really iterates, on both engines.

struct Wrap:
    xs: List[int]
    fn iter(self) -> Iterator[int]:
        return self.xs.iter()

fn sum_it(xs: Iterable[int]) -> int:
    n := 0
    for v in xs:
        n = n + v
    return n

fn count_it(xs: Iterable[str]) -> int:
    n := 0
    for v in xs:
        n = n + 1
    return n

fn doubled(xs: Iterable[int]) -> List[int]:
    return [v * 2 for v in xs]

fn copied(xs: Iterable[int]) -> List[int]:
    return List(xs)

fn to_cursor(xs: Iterable[int]) -> Iterator[int]:
    return xs.iter()

test fn iterable_in_type_position_iterates_every_shape():
    assert sum_it([1, 2, 3]) == 6, "List"
    assert sum_it({1, 2, 3}) == 6, "Set"
    assert sum_it([1, 2].iter()) == 3, "a cursor"
    assert sum_it(ones()) == 2, "a generator"
    assert sum_it(Down(3)) == 3, "a struct with next (2 + 1 + 0)"
    assert sum_it(Wrap([4, 5])) == 9, "a struct with only iter"
    assert count_it({"a": 1, "b": 2}) == 2, "a Map iterates its keys"
    assert count_it("abc") == 3, "a str"
    # the same value type drives a comprehension and a `List()` ctor, not just `for`
    assert doubled([1, 2]) == [2, 4]
    assert copied([7]) == [7]

test fn iterable_typed_cursor_is_stateful_once():
    # a cursor behind an `Iterable[T]` annotation is still ONE position: iterating it drains it.
    c := [1, 2, 3].iter()
    assert sum_it(c) == 6
    assert sum_it(c) == 0, "the cursor is drained; a second pass yields nothing"
    # a raw collection, by contrast, is re-iterable
    xs := [1, 2, 3]
    assert sum_it(xs) == 6
    assert sum_it(xs) == 6

test fn iterable_typed_value_still_mints_a_cursor():
    # the pre-fix workaround (`.iter()` first) keeps working and still yields a real cursor
    c := to_cursor([8, 9])
    assert c.next() == Some(8)
    assert c.next() == Some(9)
    assert c.next() == None

# ---- the CROSS PRODUCT: every `Iterable`-consuming ctor x the `iter`-only-struct witness ----
#
# `iter_elem` gates `for` AND `List()`/`Set()`/`Map()`/`.iter()`, but only the `for` lowering emits
# `Op::IterableToCursor`. So the ctors type-checked an `Iterable[T]`-annotated value and then faulted
# ("cannot iterate over struct (no `next` method)") whenever the runtime witness was a struct with
# `iter` and no `next` — check-OK-then-broken on BOTH engines. `drain_iterable` now does the same
# one-time conversion, so checker-accepts stays a subset of runtime-can-lower.

struct Pairs:
    xs: List[(str, int)]
    fn iter(self) -> Iterator[(str, int)]:
        return self.xs.iter()

fn as_set(xs: Iterable[int]) -> Set[int]:
    return Set(xs)

fn as_map(xs: Iterable[(str, int)]) -> Map[str, int]:
    return Map(xs)

fn cursor_of(xs: Iterable[int]) -> Iterator[int]:
    return xs.iter()

test fn iterable_typed_iter_only_struct_feeds_every_consumer():
    assert copied(Wrap([1, 2])) == [1, 2], "List() over an iter-only struct"
    assert as_set(Wrap([3, 3, 4])) == {3, 4}, "Set() over an iter-only struct"
    assert as_map(Pairs([("a", 1), ("b", 2)])) == {"a": 1, "b": 2}, "Map() over an iter-only struct"
    assert doubled(Wrap([5])) == [10], "a comprehension over an iter-only struct"
    c := cursor_of(Wrap([6, 7]))
    assert c.next() == Some(6), ".iter() over an iter-only struct"
    assert c.next() == Some(7)
    assert c.next() == None
    # the ctors are unchanged for every other witness
    assert as_set([1, 1, 2]) == {1, 2}
    assert as_map([("k", 9)]) == {"k": 9}

# ---- checker↔runtime PROTOCOL SELECTION agrees on a struct with BOTH `next` and `iter` ----
#
# The runtime picks by NAME PRESENCE (`next` present ⇒ drive `next`, never convert via `iter`); the
# checker's `iterable_elem` puts `struct_iter_elem` (`next`) first for the same reason. `Both`'s two
# methods deliberately yield DIFFERENT elements, so every consumer of one `Iterable[int]` value must
# agree on `next`'s 2,1,0 — never `iter`'s [9]. (A struct whose `next` is MALFORMED is rejected at
# check time now; that fence is `checker::tests::struct_with_nonconforming_next_is_not_iterable`.)

struct Both:
    n: int
    ys: List[int]
    fn next(self) -> Option[int]:
        if self.n <= 0:
            return None
        self.n = self.n - 1
        return Some(self.n)
    fn iter(self) -> Iterator[int]:
        return self.ys.iter()

test fn next_wins_over_iter_for_every_iterable_consumer():
    assert sum_it(Both(3, [9])) == 3, "for: 2 + 1 + 0, not 9"
    assert copied(Both(3, [9])) == [2, 1, 0], "List()"
    assert as_set(Both(3, [9])) == {0, 1, 2}, "Set()"
    assert doubled(Both(2, [9])) == [2, 0], "a comprehension"
