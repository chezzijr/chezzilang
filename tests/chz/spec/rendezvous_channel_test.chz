# TICKET-028 — `Channel[T](0)` is Chezzi's rendezvous channel (Go's `make(chan T)`), while
# `Channel[T]()` keeps its existing UNBOUNDED meaning. `cap()` reports -1 for unbounded, 0 for
# rendezvous, the bound for bounded.
import std.concurrency
import std.time

fn fault_msg[T](r: T!Error) -> str:
    match r:
        ?_: return "NO FAULT"
        !e: return e.message()
    return ""

fn poll_after_delay(rz: Channel[int], got: Shared[int]):
    time.sleep_ms(150)
    match rz.try_recv():
        ?v: got.set(v)
        None: got.set(-1)

test fn rendezvous_cap_is_zero_and_unbounded_is_minus_one():
    assert Channel[int](0).cap() == 0
    assert Channel[int]().cap() == -1

# TICKET-042(b) — a channel's stored capacity above 2^62 wraps through the 63-bit inline `Value::int`
# encoding instead of boxing, so `cap()` returns a negative sentinel for a channel that is BOUNDED.
test fn cap_does_not_wrap_above_2_pow_62():
    assert Channel[int](4611686018427387904).cap() == 4611686018427387904

test fn cap_reports_int_max():
    assert Channel[int](9223372036854775807).cap() == 9223372036854775807

# TICKET-042(a) — `try_recv` polls only the internal queue, which is always empty on a rendezvous
# channel (cap 0), so it can never see a sender that is already parked waiting to hand off. The
# value is unambiguously deliverable: a plain blocking `recv()` right after takes it.
test fn try_recv_sees_a_parked_rendezvous_sender():
    rz := Channel[int](0)
    got := Shared(-1)
    parallel:
        spawn: rz.send(7)
        spawn:
            time.sleep_ms(150)
            match rz.try_recv():
                ?v: got.set(v)
                None:
                    got.set(-1)
                    # bug present: the value is still parked with the sender — drain it with a
                    # blocking recv so the nursery can finish instead of deadlocking.
                    rz.recv()
    assert got.get() == 7, "try_recv missed a parked rendezvous sender"

test fn rendezvous_try_send_declines_with_no_receiver():
    assert Channel[int](0).try_send(1) == false
    assert Channel[int]().try_send(1) == true

test fn rendezvous_send_hands_off_to_a_waiting_receiver():
    ch := Channel[int](0)
    total := Shared(0)
    parallel:
        spawn:
            i := 0
            while i < 5:
                ch.send(i)
                i = i + 1
        spawn:
            i := 0
            while i < 5:
                v := ch.recv()
                total.update(fn(t: int) -> int: t + v)
                i = i + 1
    assert total.get() == 10

test fn rendezvous_send_never_queues_ahead():
    ch := Channel[int](0)
    max_len := Shared(0)
    parallel:
        spawn:
            i := 0
            while i < 5:
                ch.send(i)
                max_len.update(fn(m: int) -> int: if ch.len() > m: ch.len() else: m)
                i = i + 1
        spawn:
            i := 0
            while i < 5:
                ch.recv()
                i = i + 1
    assert max_len.get() <= 1

# TICKET-042(a) — a `wait:` recv arm polls exactly like `try_recv` under the hood; it must take a
# parked rendezvous sender's value too, matching Go's `select`/`default` on the same shape.
test fn wait_else_takes_a_parked_rendezvous_sender():
    rz := Channel[int](0)
    got := Shared(-1)
    parallel:
        spawn: rz.send(7)
        spawn:
            time.sleep_ms(150)
            wait:
                v := rz.recv(): got.set(v)
                else: got.set(-1)
    assert got.get() == 7, "wait: recv arm must take a parked rendezvous sender's value"

# TICKET-042(a) — a deposit is invisible to `len()`, matching Go's `len: 0` on an unbuffered
# channel with a parked sender.
test fn len_is_zero_while_a_rendezvous_sender_is_parked():
    rz := Channel[int](0)
    observed_len := Shared(-1)
    parallel:
        spawn: rz.send(7)
        spawn:
            time.sleep_ms(150)
            observed_len.set(rz.len())
            rz.recv()
    assert observed_len.get() == 0, "len() must exclude a parked rendezvous sender's deposit"

# TICKET-042(a) — a taken deposit must not re-enter the normal send path and enqueue a second
# copy: a second `try_recv` right after the first must see nothing.
test fn a_parked_rendezvous_value_is_delivered_exactly_once():
    rz := Channel[int](0)
    first_some := Shared(false)
    first_val := Shared(-1)
    second_none := Shared(false)
    parallel:
        spawn: rz.send(7)
        spawn:
            time.sleep_ms(150)
            match rz.try_recv():
                ?v:
                    first_some.set(true)
                    first_val.set(v)
                None: first_some.set(false)
            match rz.try_recv():
                ?_: second_none.set(false)
                None: second_none.set(true)
    assert first_some.get(), "the first try_recv must take the deposit"
    assert first_val.get() == 7
    assert second_none.get(), "a second try_recv must not see the same deposit again"

# TICKET-042(a) — `close()` must withdraw a parked sender's deposit before anyone takes it. Go
# measured: the sender panics `send on closed channel` and a later receive sees nothing.
test fn close_withdraws_a_parked_rendezvous_senders_value():
    rz := Channel[int](0)
    sender_result := Shared("NO FAULT")
    after_close_none := Shared(false)
    parallel:
        spawn:
            r := recover: rz.send(7)
            sender_result.set(fault_msg(r))
        spawn:
            time.sleep_ms(150)
            rz.close()
            time.sleep_ms(150)
            match rz.try_recv():
                ?_: after_close_none.set(false)
                None: after_close_none.set(true)
    assert sender_result.get() == "send on a closed channel"
    assert after_close_none.get(), "try_recv after close must not see a withdrawn deposit"

# TICKET-042(a) — the BLOCK-IN-PLACE sender path (an eager `Executor` job, or `main` blocked in a
# rendezvous send with no scheduler under it) must publish its value too, exactly like the M:N
# park path. Measured before the fix: `job try_recv: None` then `job recv: 7`.
test fn try_recv_sees_a_blocked_in_place_rendezvous_sender():
    rz := Channel[int](0)
    got := Shared(-1)
    ex := Executor()
    ex.submit(fn(): poll_after_delay(rz, got))
    rz.send(7)
    ex.shutdown()
    assert got.get() == 7, "try_recv must see a block-in-place rendezvous sender"

# TICKET-185 — a send inside a native callback (`map`) demotes and blocks until a receiver takes
# the value, as Go blocks it. Before, the in-callback send could not block and faulted
# `send on a rendezvous channel: deadlock` (TICKET-136's message, still used where nothing can block).
fn send_one(rz: Channel[int], x: int) -> int:
    rz.send(x)
    return x

test fn rendezvous_send_in_a_callback_blocks_until_a_receiver_takes_it():
    rz := Channel[int](0)
    out := Shared("")
    got := Shared(0)
    parallel:
        spawn:
            out.set("{[1].map(fn(x: int) -> int: send_one(rz, x))}")
        spawn: got.set(rz.recv())
    assert out.get() == "[1]", out.get()
    assert got.get() == 1

# TICKET-185 (H2) — a receiver takes one value from a cap-1 channel, closes it, and drains it. A
# second `send` that returned has delivered its value (Go: a receive that frees a place completes
# the parked sender's send, `sent both`); one that faulted `send on a closed channel` delivered
# nothing. The spin only shapes the usual order (the sender parks in `send(2)` first); the rule
# holds in either order. It used to break: the woken sender retried after the close and pushed its
# value into the closed channel, so `send(2)` returned but `2` was never received.
test fn a_parked_bounded_sender_completes_when_the_receiver_takes_then_closes():
    ch := Channel[int](1)
    status := Shared("")
    out := Channel[int]()
    parallel:
        spawn:
            i := 0
            while i < 200000:
                i += 1
            out.send(ch.recv())
            ch.close()
            for v in ch:
                out.send(v)
        ch.send(1)
        r := recover: ch.send(2)
        status.set(fault_msg(r))
    assert out.try_recv() == ?1
    if status.get() == "NO FAULT":
        assert out.try_recv() == ?2, "a completed send's value must be received"
    else:
        assert status.get() == "send on a closed channel", status.get()
    assert out.try_recv() == None

fn pool_worker(done: Channel[bool], work: Channel[int], n: AtomicInt):
    while true:
        wait:
            _ := done.recv():
                return
            v := work.recv():
                n.add(v)

# TICKET-185 (H1) — the worker-pool idiom: every rendezvous value reaches a `wait:` worker and none
# is left in the channel (Go: 0 of 200 runs bad). It used to strand values: a `send` returned while
# its value still sat in the channel.
test fn a_wait_receiver_never_strands_a_rendezvous_value():
    done := Channel[bool]()
    work := Channel[int](0)
    n := AtomicInt(0)
    parallel:
        for _ in 0..4:
            spawn pool_worker(done, work, n)
        spawn:
            for _ in 0..100:
                work.send(1)
            done.trip()
    assert n.load() == 100, "received {n.load()}"
    assert work.len() == 0

# TICKET-185 — `try_send` succeeds once a receiver is parked on a rendezvous channel (Go:
# `try_send true` / `got 5`): the receiver's slot takes the value. It returns `false` until then,
# so the spin ends exactly when the receiver is parked.
test fn try_send_hands_off_to_a_parked_receiver():
    ch := Channel[int](0)
    got := Shared(0)
    tries := Shared(0)
    parallel:
        spawn: got.set(ch.recv())
        spawn:
            n := 1
            while not ch.try_send(5):
                n += 1
            tries.set(n)
    assert tries.get() >= 1
    assert got.get() == 5
