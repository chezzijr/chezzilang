# ---- the receiver: named, constructed or a call result, the task holds it by handle (M3.4) ----

test fn grid_policy_r28_receiver_named():
    c := T189C(n=1)
    out := Channel[str](4)
    parallel:
        spawn c.bump(out)
    assert out.recv() == ?"ok 2"
    assert c.n == 2

test fn grid_policy_r29_receiver_constructor():
    out := Channel[str](4)
    parallel:
        spawn T189C(n=1).bump(out)
    assert out.recv() == ?"ok 2"

# A NAMED list in a constructed field is the parent's list (M3.4).
struct T190H:
    xs: List[int]
    fn push_inner(self, out: Channel[str]):
        got := 0
        res := recover:
            self.xs.push(2)
            got = self.xs.len()
        out.send(t189_out(res, got))

test fn grid_policy_r29b_constructor_holding_a_named_list():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn T190H(xs=xs).push_inner(out)
    assert out.recv() == ?"ok 2"
    assert xs == [1, 2]

test fn grid_policy_r30_receiver_call_result():
    out := Channel[str](4)
    parallel:
        spawn t189_mk().bump(out)
    assert out.recv() == ?"ok 2"

