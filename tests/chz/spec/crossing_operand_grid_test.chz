# ---- spawn value() ----

test fn grid_policy_r9_value_fresh_literal():
    g := t189_w
    out := Channel[str](4)
    parallel:
        spawn g([1], out)
    assert out.recv() == ?"ok 2"

test fn grid_policy_r39_value_default_fill():
    # The omitted slot is filled by the callee, inside the task.
    g := t189_dflt
    out := Channel[str](4)
    parallel:
        spawn g(out)
    assert out.recv() == ?"ok 1"

test fn grid_policy_r40_value_variadic():
    g := t189_pack
    out := Channel[str](4)
    parallel:
        spawn g(out, 1, 2)
    assert out.recv() == ?"ok 3"

test fn grid_policy_r41_value_named():
    xs := [1]
    g := t189_w
    out := Channel[str](4)
    parallel:
        spawn g(xs, out)
    assert out.recv() == ?"ok 2"
    assert xs == [1, 3]

test fn grid_policy_r42_value_keyword_named():
    xs := [1]
    g := t189_w
    out := Channel[str](4)
    parallel:
        spawn g(out=out, xs=xs)
    assert out.recv() == ?"ok 2"
    assert xs == [1, 3]

# ---- spawn: block (a capture is the parent's binding, M3.4) ----

test fn grid_policy_r43_block_fresh_literal():
    # The literal is built inside the task.
    out := Channel[str](4)
    parallel:
        spawn: t189_w([1], out)
    assert out.recv() == ?"ok 2"

test fn grid_policy_r44_block_copy():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn: t189_w(xs.copy(), out)
    assert out.recv() == ?"ok 2"
    assert xs == [1]

test fn grid_policy_r45_block_named_capture():
    xs := [1]
    h := t189_w
    out := Channel[str](4)
    parallel:
        spawn: h(xs, out)
    assert out.recv() == ?"ok 2"
    assert xs == [1, 3]

# ---- Executor (the job holds its captures by handle, M3.4) ----

test fn grid_policy_r16_executor_submit_fresh():
    out := Channel[str](4)
    ex := concurrency.Executor()
    _ := ex.submit(fn(): t189_w([1], out))
    ex.shutdown()
    assert out.recv() == ?"ok 2"

test fn grid_policy_r17_executor_submit_named():
    xs := [1]
    h := t189_w
    out := Channel[str](4)
    ex := concurrency.Executor()
    _ := ex.submit(fn(): h(xs, out))
    ex.shutdown()
    assert out.recv() == ?"ok 2"
    assert xs == [1, 3]

test fn grid_policy_r46_executor_submit_get_named():
    xs := [1]
    ex := concurrency.Executor()
    got := must(ex.submit(fn() -> str: t189_try(xs)).get())
    ex.shutdown()
    assert got == "ok 2"
    assert xs == [1, 3]

test fn grid_policy_r47_executor_submit_get_fresh():
    ex := concurrency.Executor()
    got := must(ex.submit(fn() -> str: t189_try([1])).get())
    ex.shutdown()
    assert got == "ok 2"

# ---- Channel (a receive is never marked, fresh or named send alike) ----
# M3.2: a channel holds the list itself, so the receiver's push lands on the sender's list (Go
# `policy.go`, M3.2 report: `r18 ok 2 [1 3]`).

test fn grid_policy_r18_channel_named_send():
    ys := [1]
    ch := Channel[List[int]](1)
    out := Channel[str](4)
    ch.send(ys)
    parallel:
        spawn:
            v := ch.recv() else: panic("ch closed")
            out.send(t189_try(v))
    assert out.recv() == ?"ok 2"
    assert ys == [1, 3]

test fn grid_policy_r48_channel_fresh_send():
    ch := Channel[List[int]](1)
    out := Channel[str](4)
    ch.send([1])
    parallel:
        spawn:
            v := ch.recv() else: panic("ch closed")
            out.send(t189_try(v))
    assert out.recv() == ?"ok 2"

# The task's `xs` is the parent's list (M3.4), and the channel hands it back, so the parent's push
# lands. Go (`m34go/policy/main.go`): `r49_channel_task_to_parent ok 2 [1 3]`.
test fn grid_policy_r49_channel_task_to_parent():
    xs := [1]
    ch := Channel[List[int]](1)
    parallel:
        spawn: ch.send(xs)
    v := ch.recv() else: panic("ch closed")
    assert t189_try(v) == "ok 2"
    assert xs == [1, 3]

# ---- Shared / RwShared / Atomic (a read is never marked) ----

# M3.3: a box holds the list itself, as an `Atomic` does (Go `policy.go`: `r51 ok 2 [1 3]`).
test fn grid_policy_r21_shared_get():
    s := concurrency.Shared[List[int]]([1])
    out := Channel[str](4)
    parallel:
        spawn: out.send(t189_try(s.get()))
    assert out.recv() == ?"ok 2"
    assert s.get() == [1, 3]

test fn grid_policy_r50_rwshared_get():
    s := concurrency.RwShared[List[int]]([1])
    out := Channel[str](4)
    parallel:
        spawn: out.send(t189_try(s.get()))
    assert out.recv() == ?"ok 2"
    assert s.get() == [1, 3]

# M3.2: an `Atomic` holds the list itself (Go `policy.go`: `r51 ok 2 [1 3]`).
test fn grid_policy_r51_atomic_load():
    a := concurrency.Atomic[List[int]]([1])
    out := Channel[str](4)
    parallel:
        spawn: out.send(t189_try(a.load()))
    assert out.recv() == ?"ok 2"
    assert a.load() == [1, 3]

test fn grid_policy_r52_shared_store():
    s := concurrency.Shared[List[int]]([])
    parallel:
        spawn: s.set([1])
    assert t189_try(s.get()) == "ok 2"

# ---- module global (M3.1: the run's one copy, so a task's push lands; Go: `ok 2`, `[1 3]`) ----

t189_g: List[int] = [1]

fn t189_gpush(out: Channel[str]):
    out.send(t189_try(t189_g))

test fn grid_policy_r22_module_global():
    h := t189_gpush
    out := Channel[str](4)
    parallel:
        spawn h(out)
    assert out.recv() == ?"ok 2"
    assert t189_g == [1, 3]

# ---- closure capture through a channel (M3.2: the closure itself, so its push lands; Go
# `policy.go`: `r19 ok 2 [1 2]`, `r20 2 [1 2]`) ----

fn t189_call(c: Channel[fn() -> int], out: Channel[str]):
    f := c.recv() else: panic("c closed")
    got := 0
    res := recover:
        got = f()
    out.send(t189_out(res, got))

test fn grid_policy_r19_closure_other_heap():
    xs := [1]
    c := Channel[fn() -> int](1)
    out := Channel[str](4)
    c.send(fn() -> int: t189_add(xs))
    parallel:
        spawn t189_call(c, out)
    assert out.recv() == ?"ok 2"
    assert xs == [1, 2]

test fn grid_policy_r20_closure_same_heap():
    xs := [1]
    c := Channel[fn() -> int](1)
    c.send(fn() -> int: t189_add(xs))
    f := c.recv() else: panic("c closed")
    assert f() == 2
    assert xs == [1, 2]
