    assert out.recv() == ?"ok 3"

test fn grid_policy_r33_qualified_keyword_fresh():
    out := Channel[str](4)
    parallel:
        spawn lib.push_len(out=out, xs=[1])
    assert out.recv() == ?"ok 2"

