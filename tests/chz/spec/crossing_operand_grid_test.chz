# TICKET-189: the crossing operand grid. A task pushes to a list it received; every row checks that
# the push lands on the parent's list.
#
# Axes: route x argument source (explicit, keyword, default fill, variadic) x operand shape (fresh
# literal, .copy(), named, call result, fresh holding a named) x callee body (writes, conditional).
# Routes: spawn f(), spawn obj.m(), spawn lib.f(), spawn lib.K.f(), spawn value(), spawn: block,
# Executor submit (dropped or read), Channel receive, Shared/RwShared get, Atomic load, Shared store,
# module global, closure capture. `Executor.map` does not exist (`std/concurrency.chz`). A hand-off
# read (Channel/Shared/RwShared/Atomic) has no fresh-operand axis. Generator rows are in
# `crossing_generator_route_test.chz` (TICKET-190).
#
# Each row sends "ok <len>" when the task's push succeeded, or "fault" when it faulted. M3.4: a
# spawn, a `spawn:` capture and an Executor job hold the parent's values by handle, so no row faults
# and the parent sees the push (Go `m34go/policy/main.go`, go1.27.0: every named row `ok 2 [1 3]`,
# `r28_receiver_named ok 2 2`, `r29b_ctor_holding_named ok 2 [1 2]`, `r30_receiver_call_result ok 2`).

import std.concurrency
import crossing_operand_lib as lib

# A handle carries a `T!E`; these tests read a job that did not fault.
fn must[T](r: T!) -> T:
    match r:
        ?v: return v
        !e: panic(e.message())

fn t189_out(res: !, got: int) -> str:
    match res:
        ?_: return "ok {got}"
        !_: return "fault"

fn t189_try(xs: List[int]) -> str:
    got := 0
    res := recover:
        xs.push(3)
        got = xs.len()
    return t189_out(res, got)

fn t189_w(xs: List[int], out: Channel[str]):
    out.send(t189_try(xs))

fn t189_dflt(out: Channel[str], acc: List[int] = []):
    out.send(t189_try(acc))

fn t189_pack(out: Channel[str], ...rest: int):
    got := 0
    res := recover:
        rest.push(3)
        got = rest.len()
    out.send(t189_out(res, got))

fn t189_nested(xss: List[List[int]], out: Channel[str]):
    got := 0
    res := recover:
        xss.push([2])
        got = xss.len()
    out.send(t189_out(res, got))
    out.send(t189_try(xss[0]))

fn t189_cond(xs: List[int], out: Channel[str], c: bool):
    got := 0
    res := recover:
        if c:
            xs.push(3)
        got = xs.len()
    out.send(t189_out(res, got))

fn t189_id(xs: List[int]) -> List[int]:
    return xs

fn t189_add(xs: List[int]) -> int:
    xs.push(2)
    return xs.len()

struct T189R:
    n: int

    fn w(self, xs: List[int], out: Channel[str]):
        t189_w(xs, out)

    fn dflt(self, out: Channel[str], acc: List[int] = []):
        out.send(t189_try(acc))

    fn pack(self, out: Channel[str], ...rest: int):
        out.send(t189_try(rest))

struct T189C:
    n: int

    fn bump(self, out: Channel[str]):
        got := 0
        res := recover:
            self.n += 1
            got = self.n
        out.send(t189_out(res, got))

fn t189_mk() -> T189C:
    return T189C(n=1)

# ---- spawn f() ----

test fn grid_policy_r1_fn_fresh_literal():
    out := Channel[str](4)
    parallel:
        spawn t189_w([1], out)
    assert out.recv() == ?"ok 2"

test fn grid_policy_r2_fn_copy():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_w(xs.copy(), out)
    assert out.recv() == ?"ok 2"
    assert xs == [1]

test fn grid_policy_r3_fn_call_result():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_w(t189_id(xs), out)
    assert out.recv() == ?"ok 2"
    assert xs == [1, 3]

test fn grid_policy_r4_fn_fresh_holding_named():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_nested([xs], out)
    assert out.recv() == ?"ok 2"
    assert out.recv() == ?"ok 2"
    assert xs == [1, 3]

test fn grid_policy_r5_fn_keyword_fresh():
    out := Channel[str](4)
    parallel:
        spawn t189_w(out=out, xs=[1])
    assert out.recv() == ?"ok 2"

test fn grid_policy_r6_fn_default_fill():
    out := Channel[str](4)
    parallel:
        spawn t189_dflt(out)
    assert out.recv() == ?"ok 1"

test fn grid_policy_r7_fn_variadic():
    out := Channel[str](4)
    parallel:
        spawn t189_pack(out, 1, 2)
    assert out.recv() == ?"ok 3"

fn t189_pack_elem(out: Channel[str], ...rest: List[int]):
    out.send(t189_try(rest[0]))

test fn grid_policy_r8_fn_variadic_element_named():
    # The pack list is fresh; its NAMED element is the parent's list.
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_pack_elem(out, xs)
    assert out.recv() == ?"ok 2"
    assert xs == [1, 3]

fn t189_rebind(ys: List[int], out: Channel[str]):
    ys = [1, 2]
    ys.push(3)
    out.send("ok {ys.len()}")

test fn grid_policy_r23_fn_rebound_param():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_rebind(xs, out)
    assert out.recv() == ?"ok 3"
    assert xs == [1]

t189_dg: List[int] = [1]

fn t189_dg_get() -> List[int]:
    return t189_dg

fn t189_dprov(out: Channel[str], acc: List[int] = t189_dg_get()):
    out.send(t189_try(acc))

test fn grid_policy_r53_fn_provider_default_is_the_global():
    # A provider default is a call result: here the parent's global itself.
    out := Channel[str](4)
    parallel:
        spawn t189_dprov(out)
    assert out.recv() == ?"ok 2"
    assert t189_dg == [1, 3]

test fn grid_policy_r14_fn_conditional_named():
    xs := [1]
    out := Channel[str](4)
    parallel:
        spawn t189_cond(xs, out, true)
    assert out.recv() == ?"ok 2"
    assert xs == [1, 3]

test fn grid_policy_r15_fn_conditional_fresh():
    out := Channel[str](4)
    parallel:
        spawn t189_cond([1], out, true)
    assert out.recv() == ?"ok 2"

