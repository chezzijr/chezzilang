# TICKET-196: a module exports one record per slot, and an importer calls it through that slot.
import module_export_slot_lib
import f from module_export_slot_lib

test fn a_let_slot_runs_its_closure():
    assert module_export_slot_lib.f(1, 2) == "12"
    assert f(1, 2) == "12"

test fn a_value_beside_a_struct_is_the_call():
    assert module_export_slot_lib.S(2) == 200

test fn single_fn_keeps_labels_and_defaults():
    assert module_export_slot_lib.g(b=2, a=1) == "12"
    assert module_export_slot_lib.g(1) == "15"
