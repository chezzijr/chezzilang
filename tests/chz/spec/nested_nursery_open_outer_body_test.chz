# TICKET-159 (W13-27) — a nursery inside a spawned task registers a fiber-owned scope on that
# task's own sched (TICKET-131). While the ENCLOSING nursery's body is still open (main blocks on
# `recv`), `farm_outermost_eager_helpers` has not run yet, so the inner nursery's children run on
# the outer drainer alone: 1.75 s vs 0.95 s once the outer body is closed (release, 8 children of
# burn(1500000), measured at CHEZZI_THREADS=2 and 8). The bound is one absolute wall-clock ceiling
# with headroom between the two, never a quotient of two samples.
#
# The ceiling only discriminates on a RELEASE build: one `burn(1500000)` takes ~0.2 s on the
# release binary and ~0.5 s on the debug binary `cargo test` runs this suite with (chezzi-vm at
# opt-level 1; ~2 s at opt-level 0). `can_fan_out()` reads the build mode that the Rust runners set
# (`CHEZZI_TEST_DEBUG_BINARY=1`, from their `cfg!(debug_assertions)`), and each test returns early
# (passes without asserting) on a debug build, so the debug gates stay green and the release run
# (`chezzi test` on the release binary, the ticket's declared command, var unset) asserts.
# The fan-out also needs two workers: at `CHEZZI_THREADS=1` the 8 children run one after another
# (~1.7 s on release), so `can_fan_out()` returns early there too.
import std.concurrency
import std.os
import std.time

fn burn(n: int) -> int:
    x := 0
    i := 0
    while i < n:
        x = x + i * i - i
        i += 1
    return x

fn can_fan_out() -> bool:
    if (os.env("CHEZZI_THREADS") ?? "") == "1":
        return false
    return (os.env("CHEZZI_TEST_DEBUG_BINARY") ?? "") != "1"

fn fan_open() -> int:
    ch := Channel[int](0)
    got := 0
    parallel:
        spawn:
            parallel:
                spawn: burn(1500000)
                spawn: burn(1500000)
                spawn: burn(1500000)
                spawn: burn(1500000)
                spawn: burn(1500000)
                spawn: burn(1500000)
                spawn: burn(1500000)
                spawn: burn(1500000)
            ch.send(1)
        v := ch.recv() else: panic("ch closed")
        got = v
    return got

test fn nested_nursery_fans_out_while_outer_body_is_open():
    if not can_fan_out():
        return
    t0 := time.monotonic()
    got := fan_open()
    ms := (time.monotonic() - t0) * 1000.0
    assert got == 1
    assert ms < 1350.0, "fan_open took {ms} ms; the outer-closed shape takes ~950 ms"

# The flat shape: the body spawns every task BEFORE it blocks on `recv`, so no injection follows the
# block and only a hook at the block itself can farm runners for it.
fn fan_flat() -> int:
    ch := Channel[int](0)
    got := 0
    parallel:
        spawn: burn(1500000)
        spawn: burn(1500000)
        spawn: burn(1500000)
        spawn: burn(1500000)
        spawn: burn(1500000)
        spawn: burn(1500000)
        spawn: burn(1500000)
        spawn:
            burn(1500000)
            ch.send(1)
        v := ch.recv() else: panic("ch closed")
        got = v
    return got

test fn flat_nursery_fans_out_while_body_is_blocked():
    if not can_fan_out():
        return
    t0 := time.monotonic()
    got := fan_flat()
    ms := (time.monotonic() - t0) * 1000.0
    assert got == 1
    assert ms < 1350.0, "fan_flat took {ms} ms; the outer-closed shape takes ~950 ms"
