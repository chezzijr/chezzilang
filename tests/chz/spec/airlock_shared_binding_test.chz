# W7-4 — a captured local is ONE BINDING, so two sibling closures over it must still share ONE cell
# after crossing the airlock. `docs/reference/syntax/` says a write through a capture is visible "across
# sibling closures", and a crossing snapshot-copies the binding into ONE independent per-task cell —
# per BINDING, not per reference. The serializer used to re-serialize an off-DFS-stack cell as a fresh
# `WireValue::Cell`, so `d.inc()` and `d.get()` landed on TWO cells and the shared binding silently
# split (`d.get()` read 1 where 2 was written).
#
# TICKET-100: a DATA DAG alias (`pair := [xs, xs]`) now crosses as ONE object too, same as a cell —
# both a data alias and a cell alias mean the same source object stays one object per crossing.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
import Iterator from std.iter
import std.concurrency
import ConcurrentList, ConcurrentMap from std.concurrency.collection

struct Ctr:
    inc: fn() -> None
    get: fn() -> int

fn make() -> Ctr:
    n := 0
    fn inc():
        n = n + 1
    fn get() -> int:
        return n
    return Ctr(inc, get)

# TICKET-291: true when `g()` faults because it writes a binding it holds only a copy of.
fn copy_fault(g: fn() -> None) -> bool:
    res := recover: g()
    match res:
        ?_: return false
        !e: return e.message().contains("is this task's copy")

fn copy_fault_int(g: fn() -> int) -> bool:
    res := recover: g()
    match res:
        ?_: return false
        !e: return e.message().contains("is this task's copy")

# Two closures over one binding in a cursor, built by a box call: the caller holds the only copy.
fn pair_cursor() -> Iterator[fn() -> int]:
    c := make()
    fn bump() -> int:
        c.inc()
        return 0
    return [bump, c.get].iter()

# Module globals: two closures over ONE function-local cell, reached through the module SNAPSHOT path.
_w74c := make()
_w74i := _w74c.inc
_w74g := _w74c.get

# A module-global generator inside a REFERENCE CYCLE (it is parked in the very list it closes over), so
# its snapshot walk is DISCARDED (`to_wire` Errs → inert Nil) AFTER it has already reached the local
# cell holding `_w74cyc`'s list. `_w74size` then reaches that same cell. If the discarded walk's cell
# ids are not rolled back out of the shared per-module memo, `_w74size` emits a `Backref` to an id no
# `WireValue::Cell` ever defines and the replay panics on `from_wire_memo`'s `.expect`.
struct CycPair:
    it: Iterator[int]
    size: fn() -> int

fn _w74mk() -> CycPair:
    xs: List[Iterator[int]] = []
    fn g() -> Iterator[int]:
        yield xs.len()
    fn size() -> int:
        return xs.len()
    it := g()
    xs.push(it)
    return CycPair(it, size)

_w74pair := _w74mk()
_w74cyc := _w74pair.it
_w74size := _w74pair.size

# W7-4 REVIEW — fixtures for `spawn_serializes_args_before_the_callee` (below): a struct chain deeper
# than the 10000 structural cap (a non-crossable ARG), and a generator parked on a reference cycle
# through the module-global list it reads (a non-crossable CALLEE CAPTURE). Two DIFFERENT reject
# messages, so serialization ORDER is observable.
struct _W74Deep:
    next: List[_W74Deep]

_w74hold: List[Iterator[int]] = []

fn _w74deep(k: int) -> _W74Deep:
    n := _W74Deep([])
    i := 0
    while i < k:
        n = _W74Deep([n])
        i = i + 1
    return n

fn _w74gen() -> Iterator[int]:
    me := _w74hold[0]
    yield 1
    yield 2

# Headline repro — no concurrency at all, just a Channel round-trip inside one task.
# Owner decision 2026-10-22 (TICKET-291, reversing the 2026-09-23 ruling): a same-task round trip
# is a crossing. `recv` rebuilds the closure over a copy of its captures, so a write through it
# would be lost and faults, and the sender's binding is unchanged. One binding per crossing is
# still observable where a write runs: a box call's result over fresh state (`sole` captures).
test fn channel_send_keeps_one_binding():
    c := make()
    c.inc()
    assert c.get() == 1
    ch := Channel[Ctr](1)
    ch.send(c)
    d := ch.recv()
    assert d.get() == 1
    assert copy_fault(d.inc)
    assert c.get() == 1
    e := concurrency.Shared(0).read(fn(s): make())
    e.inc()
    e.inc()
    assert e.get() == 2

# The pair reached through a STRUCT FIELD after crossing (same cell, two field-held closures).
# Same-task round-trip — see the owner decision above `channel_send_keeps_one_binding`.
test fn struct_field_keeps_one_binding():
    ch := Channel[Ctr](1)
    ch.send(make())
    d := ch.recv()
    assert copy_fault(d.inc)
    assert d.get() == 0
    e := concurrency.Shared(0).read(fn(s): make())
    e.inc()
    e.inc()
    e.inc()
    assert e.get() == 3

# A cursor snapshot carrying both closures — the `Obj::Iter` airlock arm.
# Same-task round-trip — see the owner decision above `channel_send_keeps_one_binding`.
test fn cursor_keeps_one_binding():
    ch := Channel[Iterator[fn() -> int]](1)
    ch.send(pair_cursor())
    fs: List[fn() -> int] = []
    for f in ch.recv():
        fs.push(f)
    assert copy_fault_int(fs[0])
    assert fs[1]() == 0
    gs: List[fn() -> int] = []
    for g in concurrency.Shared(0).read(fn(s): pair_cursor()):
        gs.push(g)
    gs[0]()
    gs[0]()
    assert gs[1]() == 2

# A `Shared` box is a cross-heap VALUE STORE (its own airlock arm).
# Same-task round-trip — see the owner decision above `channel_send_keeps_one_binding`.
test fn shared_keeps_one_binding():
    box := concurrency.Shared(make())
    d := box.get()
    assert copy_fault(d.inc)
    assert d.get() == 0
    assert box.read(fn(c): c.get()) == 0

# D4 layer C, the genuine cross-task counterpart: the closure crosses INTO a different task's
# heap (a real airlock copy), so the receiving task's write is lost at the join and must fault
# instead — the owner ruling above distinguishes this from a same-task round-trip.
test fn channel_send_to_a_different_task_faults():
    c := make()
    ch := Channel[Ctr](1)
    done := Channel[str](1)
    parallel:
        spawn:
            d := ch.recv()
            res := recover:
                d.inc()
            match res:
                ?_: done.send("no-fault")
                !e: done.send(e.message())
        ch.send(c)
    msg := done.recv()
    assert msg.starts_with("this value is this task's copy:"), msg

# `spawn f(g, h)` — two closures arriving as two SEPARATE spawn args. TICKET-169: the task's write
# through either now faults (its captures crossed the airlock and are marked), so the shared-binding
# question this used to probe no longer arises for a WRITE — the read half (D2) is untouched.
test fn spawn_named_args_keep_one_binding():
    c := make()
    r := Channel[str](1)
    fn work(i: fn() -> None, g: fn() -> int, out: Channel[str]):
        res := recover:
            i()
        match res:
            ?_: out.send("no-fault")
            !e: out.send(e.message())
    parallel:
        spawn work(c.inc, c.get, r)
    got := r.recv()
    assert got.starts_with("this value is this task's copy:"), got

# `spawn:` block with TWO separate captured locals over one cell — same fault, from inside the block.
test fn spawn_block_two_captures_keeps_one_binding():
    c := make()
    gi := c.inc
    gg := c.get
    r := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                gi()
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
    got := r.recv()
    assert got.starts_with("this value is this task's copy:"), got

# M3.1: two module globals over one factory-local cell are the run's closures, so a task's write
# through one lands and the other reads it, in the task and in the parent. Go: +1 both ways.
test fn module_global_snapshot_keeps_one_binding():
    before := _w74g()
    r := Channel[str](1)
    seen := Channel[int](1)
    parallel:
        spawn:
            res := recover:
                _w74i()
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
            seen.send(_w74g())
    got := r.recv()
    assert got == "no-fault", got
    assert seen.recv() == before + 1, "the sibling global closure missed the write"
    assert _w74g() == before + 1, "the parent missed the task's write"

# W7-4 — a module global beside a cycle-parked generator (see `_w74mk` above): the task calls the
# sibling closure over the same local, which reads the run's one copy (M3.1).
test fn discarded_snapshot_walk_rolls_back_its_cell_ids():
    r := Channel[int](1)
    parallel:
        spawn:
            r.send(_w74size())
    assert r.recv() == 1

# FENCE — TICKET-100 inverted the DATA DAG rule: an acyclic alias reached twice is now ONE object on
# the far side, same as a cell (docs/reference/concurrency/). Goes red if a store ever stops back-referencing
# an off-stack alias.
test fn data_dag_alias_is_one_object():
    xs := [1]
    pair := [xs, xs]
    ch := Channel[List[List[int]]](1)
    ch.send(pair)
    p := ch.recv()
    p[0].push(2)
    assert p[0].len() == 2
    assert p[1].len() == 2

# FENCE — the OTHER boundary of the new rule: identity is preserved within ONE crossing, never BETWEEN
# crossings. TICKET-169: the first task's write now faults (its captured cell crossed the airlock and
# is marked), so it can never reach the parent OR a second task either way; a second task's own read
# still sees the parent's unwritten `0` (F1 per-task isolation, docs/reference/syntax/ rule 2). Goes red if the
# cell memo is ever widened to Vm-lived state.
test fn separate_tasks_each_get_their_own_binding():
    c := make()
    r := Channel[str](1)
    r2 := Channel[int](1)
    parallel:
        spawn:
            res := recover:
                c.inc()
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
    parallel:
        spawn:
            r2.send(c.get())
    got := r.recv()
    assert got.starts_with("this value is this task's copy:"), got
    assert r2.recv() == 0
    assert c.get() == 0

# W7-4c — a task-local binding of a module global's closure and the global itself are one
# binding: the task's `_w74i()` writes and its `gg()` reads the same cell (M3.1: the run's). The
# alias is made in the task; a parent-made alias the task captures is a crossing copy until M3.4.
# Go: the read sees the write.
test fn module_global_plus_local_capture_shares_its_binding():
    before := _w74g()
    r := Channel[str](2)
    parallel:
        spawn:
            gg := _w74c.get
            res := recover:
                _w74i()
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
            r.send("{gg()}")
    got := r.recv()
    assert got == "no-fault", got
    read := r.recv()
    assert read == "{before + 1}", "read after the write saw {read}"

# W7-4 REGRESSION — `RwShared`'s zero-copy read views DRAIN one stored wire through many independent
# `from_wire` rebuilds, so the persistent cell memo made a `Backref` reach across sibling elements for
# the first time and every one of these methods hit a host PANIC (`a wire Backref always targets an
# already-reconstructed node id`), not a catchable fault. A whole-container `get()` is ONE crossing and
# still shares the binding; a per-element copy-out view is an independent copy, EXCEPT that a looping
# view (`for_each`/`fold`) now takes one snapshot under one map, so siblings share within one walk
# (CPython 3.14.7 and Go 1.27 both fold to 2; TICKET-154). Two `at()` calls are two crossings and can
# never share, and `slice` — one call returning a container — shares within itself.
# Owner decision 2026-10-22 (TICKET-291): every one of these views is a same-task round trip, and
# a round trip is a crossing, so a write through any view's `inc` copy faults and `n` stays 0. The
# W7-4 regression this guards was a host PANIC: each view must still decode, and fault cleanly.
test fn rwshared_views_over_sibling_closures():
    n := 0
    fn inc() -> int:
        n = n + 1
        return n
    fn get() -> int:
        return n
    s := ConcurrentList(concurrency.RwShared([inc, get]))
    both := s.inner.get()          # whole container, one crossing
    assert copy_fault_int(both[0])
    assert both[1]() == 0
    # per-element view (`at` is the SAFE index: `E?`)
    match s.at(1):
        ?f: assert f() == 0
        None: assert false, "at(1) on a 2-element list must be Some"
    sl := s[0..2]      # one call, one container
    assert copy_fault_int(sl[0])
    assert sl[1]() == 0
    calls := 0
    fn tick(f: fn() -> int):
        calls = calls + 1
    s.for_each(tick)
    assert calls == 2
    # one walk: the `inc` copy faults inside the fold.
    assert copy_fault_int(fn() -> int: s.fold(0, fn(a: int, f: fn() -> int) -> int: a + f()))
    m := ConcurrentMap(concurrency.RwShared({"i": inc, "g": get}))
    assert m.contains("i")
    match m.get("g"):
        ?f: assert f() == 0
        None: assert false
    assert copy_fault(fn(): m.for_each_entry(fn(k: str, f: fn() -> int): f()))
    assert m.fold_entries(0, fn(a: int, k: str, f: fn() -> int) -> int: a + 1) == 2
    assert n == 0
    # (`contains` shares the code path but is unreachable with closures — a `fn` is not Hashable, so a
    # Set can never hold two sibling closures.)

# FENCE — TICKET-100: same inverted rule across two SEPARATE spawn args (the seam a shared serialize
# memo could collapse the wrong way). TICKET-169: the task's write now faults (a spawn arg crossed
# the airlock and is marked).
test fn data_dag_alias_across_spawn_args_faults():
    xs := [1]
    r := Channel[str](1)
    fn work(a: List[int], b: List[int], out: Channel[str]):
        res := recover:
            a.push(2)
        match res:
            ?_: out.send("no-fault")
            !e: out.send(e.message())
    parallel:
        spawn work(xs, xs, r)
    got := r.recv()
    assert got.starts_with("this value is this task's copy:"), got

# W7-4 REVIEW (charge 1/5/7) — a `RwShared` read VIEW run CONCURRENTLY with a writer. The first cut
# resolved a piece's `Backref` by RE-READING `core.v` after dropping the read guard, so a `set` in that
# window swapped the stored wire for a fresh serialization whose ids are unrelated: the piece's backref
# then hit `from_wire_memo`'s `.expect` — a HOST PANIC on a legal program (write-preferring `RwLock`,
# so the queued writer wins the window: reproduced at every thread count). Stored wires are now
# self-contained per element, so a view never needs a second read. The reader's `at(1)` copy is its own
# binding either way; what is asserted is that the program completes at all.
test fn rwshared_view_survives_a_concurrent_writer():
    n := 0
    fn inc() -> int:
        n = n + 1
        return n
    fn get() -> int:
        return n
    fn zero() -> int:
        return 0
    s := ConcurrentList(concurrency.RwShared([inc, get]))
    d := Channel[int](2)
    parallel:
        spawn:
            for i in 0..20000:
                s.inner.set([zero, zero])
                s.inner.set([inc, get])
            d.send(1)
        spawn:
            hits := 0
            for i in 0..20000:
                match s.at(1):
                    ?f: hits = hits + f()
                    None: assert false, "the writer always stores a 2-element list"
            d.send(2)
    assert d.recv() + d.recv() == 3

# W7-4 REVIEW (charge 3) — SPAWN FAULT ORDERING. `do_spawn` batches the callee/receiver and the args
# into ONE serialization; the args must still be serialized FIRST, as they were before the batch, or a
# non-crossable callee pre-empts a non-crossable argument and the reported message changes. Here the
# ARG trips the depth cap and the CALLEE's capture is a generator in a reference cycle: the arg's fault
# is the one that must surface.
test fn spawn_serializes_args_before_the_callee():
    it := _w74gen()
    _w74hold.push(it)
    for x in it:
        break
    fn callee(d: _W74Deep):
        for y in it:
            break
    d := _w74deep(11000)
    r := recover:
        parallel:
            spawn callee(d)
    match r:
        ?_: assert false
        !e: assert e.message() == "maximum structural depth (10000) exceeded (cyclic data structure?)"
