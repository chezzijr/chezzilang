# tests/chz/spec/reserved_method_tables_test.chz — behavior spec for the reserved-type METHOD tables
# whose checker sigs are now file-backed in std/prelude.chz (channel/str/bytes/bytearray), replacing the
# retired bespoke Rust `*_method_sig` fns. These are REGRESSION guards: the migration is checker-only
# (sigs byte-match the retired arms, runtime dispatch untouched), so every assertion below must hold
# exactly as before. Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
#
# The Channel tests stay single-task + unbounded so `recv`/for-drain never block the serial oracle.

# ---- Channel: send / recv / len / cap ----

test fn channel_send_recv_len_cap():
    ch := Channel[int]()
    assert ch.cap() == 0, "unbounded channel cap is 0"
    ch.send(1)
    ch.send(2)
    assert ch.len() == 2
    assert ch.recv() == 1
    assert ch.recv() == 2
    assert ch.len() == 0

# ---- Channel: try_send / try_recv ----

test fn channel_try_send_try_recv():
    ch := Channel[int]()
    assert ch.try_send(10) == true, "unbounded try_send always succeeds"
    match ch.try_recv():
        Some(v): assert v == 10
        None: assert false, "queued value must be Some"
    match ch.try_recv():
        Some(_): assert false, "empty channel try_recv is None"
        None: assert true

# ---- Channel: close + for-drain ----

test fn channel_close_drain():
    ch := Channel[int]()
    ch.send(1)
    ch.send(2)
    ch.close()
    total := 0
    for v in ch:
        total = total + v
    assert total == 3, "for-drain after close yields every queued value"

# ---- Channel: trip (permanent ready latch) ----

test fn channel_trip():
    ch := Channel[bool]()   # trip() is `where T: bool` — the level-trigger latch only delivers `true`
    ch.trip()
    match ch.try_recv():
        Some(v): assert v, "a tripped channel delivers true"
        None: assert false, "a tripped channel reports ready forever"

# ---- str: representative methods (len / upper / split / replace / to_int / parse_int / message) ----

test fn str_methods():
    assert "hello".len() == 5
    assert "hi".upper() == "HI"
    assert "a,b,c".split(",") == ["a", "b", "c"]
    assert "foobar".replace("o", "0") == "f00bar"
    match "42".to_int():
        Some(n): assert n == 42
        None: assert false, "valid int parses"
    match "nope".to_int():
        Some(_): assert false, "bad int is None"
        None: assert true

test fn str_count_empty_sub():
    # Python/Go: count("") == codepoint-len + 1 (matches sibling std.string.count).
    assert "abc".count("") == 4
    assert "".count("") == 1
    assert "héllo".count("") == 6
    # non-empty controls unchanged.
    assert "aaa".count("aa") == 1
    assert "abc".count("b") == 1

test fn str_split_empty_sep_faults():
    # Python raises / std.string.split panics on empty sep — native method must fault too.
    r := recover: "abc".split("")
    match r:
        Ok(_): assert false, "empty sep must fault"
        Err(e): assert e.message().contains("sep must not be empty")
    # positive controls: empty receiver stays [""], non-empty split unchanged.
    assert "a,b,c".split(",") == ["a", "b", "c"]
    assert "".split(",").len() == 1

test fn str_parse_int_result():
    match "7".parse_int():
        Ok(n): assert n == 7
        Err(_): assert false, "valid parse is Ok"
    match "x".parse_int():
        Ok(_): assert false, "bad parse is Err"
        Err(msg): assert msg.len() > 0, "error carries a str message"

test fn str_message_is_error():
    # `str` conforms to Error: message() returns the string itself.
    assert "boom".message() == "boom"

# ---- bytes: decode / len ----

test fn bytes_methods():
    b := "hi".encode()
    assert b.len() == 2
    assert b.decode() == "hi", "encode/decode round-trip"

# ---- bytearray: push / pop / decode / extend (all three arg shapes) ----

test fn bytearray_push_pop():
    ba := bytearray()
    ba.push(104)
    ba.push(105)
    assert ba.len() == 2
    assert ba.decode() == "hi"
    match ba.pop():
        Some(n): assert n == 105
        None: assert false, "non-empty pop is Some"

test fn bytearray_extend_shapes():
    # extend accepts bytes, bytearray, or List[int] — the special-case branch preserved in the checker.
    ba := bytearray()
    ba.extend("ab".encode())          # bytes
    ba.extend(bytearray("cd".encode()))  # bytearray
    ba.extend([101, 102])             # List[int]
    assert ba.decode() == "abcdef"
