fn ops_ptr(a: ptr, b: ptr, c: ptr) -> List[str]:
    bad: List[str] = []
    if not (a == b):
        bad.push("==")
    if a != b:
        bad.push("!=")
    if not (b in [a]):
        bad.push("in")
    if not [a].contains(b):
        bad.push("contains")
    if [a].index_of(b) != 0:
        bad.push("index_of")
    if [a, b].unique().len() != 1:
        bad.push("unique")
    if (a, 1) != (b, 1):
        bad.push("tuple")
    if HBox(a) != HBox(b):
        bad.push("struct")
    if HOne.One(a) != HOne.One(b):
        bad.push("enum")
    if Some(a) != Some(b):
        bad.push("option")
    if not (HKey(b) in {HKey(a): 1}):
        bad.push("map-probe")
    if not {HKey(a)}.has(HKey(b)):
        bad.push("set-probe")
    if not Atomic(a).cas(b, a):
        bad.push("cas")
    # No distinct cells: every `ffi.null()` is address 0; a distinct ptr needs an extern allocator.
    return bad

test fn channel_identity_grid():
    bad := grid("Channel", Channel[int](), Channel[int](), ops_channel)
    assert bad.len() == 0, " ".join(bad)

test fn shared_identity_grid():
    bad := grid("Shared", Shared(0), Shared(0), ops_shared)
    assert bad.len() == 0, " ".join(bad)

test fn rwshared_identity_grid():
    bad := grid("RwShared", RwShared(0), RwShared(0), ops_rwshared)
    assert bad.len() == 0, " ".join(bad)

test fn atomic_identity_grid():
    bad := grid("Atomic", Atomic(0), Atomic(0), ops_atomic)
    assert bad.len() == 0, " ".join(bad)

test fn atomic_int_identity_grid():
    bad := grid("AtomicInt", AtomicInt(0), AtomicInt(0), ops_atomic_int)
    assert bad.len() == 0, " ".join(bad)

test fn executor_identity_grid():
    bad := grid("Executor", Executor(), Executor(), ops_executor)
    assert bad.len() == 0, " ".join(bad)

test fn socket_identity_grid():
    bad := grid("Socket", a_socket(), a_socket(), ops_socket)
    assert bad.len() == 0, " ".join(bad)

test fn listener_identity_grid():
    bad := grid("Listener", a_listener(), a_listener(), ops_listener)
    assert bad.len() == 0, " ".join(bad)

test fn writer_identity_grid():
    bad := grid("Writer", io.stdout(), io.stdout(), ops_writer)
    assert bad.len() == 0, " ".join(bad)

test fn reader_identity_grid():
    bad := grid("Reader", a_reader("a"), a_reader("c"), ops_reader)
    assert bad.len() == 0, " ".join(bad)

test fn ptr_identity_grid():
    bad := grid("ptr", ffi.null(), ffi.null(), ops_ptr)
    assert bad.len() == 0, " ".join(bad)
