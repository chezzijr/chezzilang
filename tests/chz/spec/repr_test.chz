# tests/chz/spec/repr_test.chz — a string NESTED inside something else renders as its `repr`.
#
# CPython's `str` vs `repr` split: `print("a")` is the bare characters, but a string inside a
# list/tuple/map/set, a struct field, or an enum payload is quoted and escaped. Before this,
# `["a", "b"]` and `["a, b"]` both printed `[a, b]` and `[""]` printed `[]` — different values with
# identical output, which is worse here than in most languages because printed output is what the
# golden corpus compares (`docs/contributing/gaps.md` §W7-25).

import Shared from std.concurrency

# ---- the motivating ambiguity ----

test fn different_lists_no_longer_print_the_same():
    a := ["a", "b"]
    b := ["a, b"]
    assert a != b
    assert "{a}" != "{b}", "display must distinguish values that != distinguishes"
    assert "{a}" == "['a', 'b']"
    assert "{b}" == "['a, b']"

test fn empty_string_element_is_visible():
    assert "{[""]}" == "['']"
    assert "{["", ""]}" == "['', '']"
    assert [""].len() == 1

# ---- containers ----

test fn containers_quote_their_string_elements():
    assert "{["a"]}" == "['a']"
    assert "{("x", 1)}" == "('x', 1)"
    assert "{ {"k": "v"} }" == "{{'k': 'v'}}"
    assert "{ {"a": [1, 2]} }" == "{{'a': [1, 2]}}"
    assert "{[["a"], ["b"]]}" == "[['a'], ['b']]"

test fn a_bare_string_is_not_quoted():
    assert "a" == "a"
    assert "{'a'}" == "a"
    assert "" == ""

# ---- quote choice + escapes (CPython rules) ----

test fn quote_choice_and_escapes():
    # A `'` in the string flips the quote to `"`; with both quotes present, `'` wins and escapes.
    assert "{["it's"]}" == "[\"it's\"]"
    assert "{["a\nb"]}" == "['a\\nb']"
    assert "{["a\tb"]}" == "['a\\tb']"
    assert "{["back\\slash"]}" == "['back\\\\slash']"

# ---- structs, enum payloads ----

struct S:
    name: str
    n: int

test fn struct_fields_are_quoted():
    assert "{S(name="hi", n=1)}" == "S(name='hi', n=1)"
    assert "{[S(name="hi", n=1)]}" == "[S(name='hi', n=1)]"

# A carrier prints as the user writes it: its payload is bare at the top level and quoted when
# the carrier itself is nested.
test fn carrier_payload_is_quoted_only_when_nested():
    assert "{?"h"}" == "h"
    assert "{[?"h"]}" == "['h']"
    r := recover: [1][5]
    match r:
        ?_: assert false, "expected a fault"
        !e:
            assert "{r}".starts_with("!index 5"), "a top-level error payload is bare: {r}"
            assert "{[r]}".starts_with("[!'index 5"), "a nested error payload is quoted: {[r]}"

# ---- a display hook's own output is NOT a nested value ----

struct Tag:
    v: int

    fn str(self) -> str:
        return "<{self.v}>"

test fn display_hook_output_is_never_quoted():
    assert "{Tag(v=7)}" == "<7>"
    assert "{[Tag(v=7)]}" == "[<7>]", "the hook renders the object; it is not a nested string"

# ---- the OTHER renderer: a wrapper box must agree with the value it holds ----

test fn shared_box_renders_like_its_contents():
    # `print(Shared(x))` goes through a different renderer (`display_box`) than `print(x)`; both
    # must quote, or one value has two spellings and the ambiguity survives in half the program.
    s := Shared([" ", "a, b", ""])
    assert "{s}" == "Shared([' ', 'a, b', ''])"
    assert "{s.get()}" == "[' ', 'a, b', '']"
    t := Shared("hi")
    assert "{t}" == "Shared('hi')"

test fn shared_box_renders_a_cycle_and_an_alias_like_its_contents():
    # M3.5: the box renders the live value, so a back edge prints CPython's `[...]` (CPython 3.14:
    # `xs.append(xs); print([xs])` is `[[[...]]]`) and one list reached twice prints twice
    # (`[[1], [1]]`). The deleted wire form printed `<cycle>` for both.
    xs: List[Any] = []
    xs.push(xs)
    s := Shared(xs)
    assert "{s}" == "Shared([[...]])", "{s}"
    assert "{xs}" == "[[...]]"
    x := [1]
    t := Shared([x, x])
    assert "{t}" == "Shared([[1], [1]])", "{t}"

# ---- non-printable characters ----

test fn non_printable_characters_escape():
    # Otherwise a no-break space is indistinguishable from a space, and a zero-width space from "" —
    # the same defect, one alphabet over. Widths + lowercase hex are CPython's.
    assert "{["\u{00a0}", " "]}" == "['\\xa0', ' ']"
    assert "{["\u{200b}", ""]}" == "['\\u200b', '']"
    assert "{["\u{1d173}"]}" == "['\\U0001d173']"
    # Printable non-ASCII stays literal.
    assert "{["é", "😀"]}" == "['é', '😀']"

# Combining marks (Mn/Mc/Me) are the VISIBLE content of Devanagari/Hebrew/Arabic/Thai text, not
# invisible whitespace like U+00A0/U+200B above — `char::escape_debug` wrongly lumps them in with
# those, so a nested Devanagari string renders as escaped hex instead of literal text (TICKET-081/
# TICKET-088, `docs/contributing/gaps.md` W7-25). CPython's `repr` prints them literally.
test fn combining_marks_stay_literal_in_nested_repr():
    assert "{["नमस्ते"]}" == "['नमस्ते']"

# A 1-tuple keeps its comma inside a box too (S2-7, TICKET-273): the box renderer and `print(x)`
# read one rule, `tuple_text` (`base/words.rs`).
test fn a_boxed_one_tuple_keeps_its_comma():
    s := Shared((1,))
    assert "{s}" == "Shared((1,))"
    m := Shared([(2,)])
    assert "{m}" == "Shared([(2,)])"
    assert "{(3,)}" == "(3,)"
