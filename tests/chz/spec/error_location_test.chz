# tests/chz/spec/error_location_test.chz — a caught Error's origin span (W8-22, TICKET-026).
#
# A fault caught by `recover:` carries where it happened (`line()`/`col()`/`file()`), and so does a
# user `!...`: where it was first made an error, kept through `?`. `message()` stays byte-identical
# in both cases. The full grid is `error_origin_grid_test.chz`.

test fn a_runtime_fault_carries_its_origin():
    xs := [1]
    r := recover: xs[9]
    match r:
        ?_: assert false, "expected a fault"
        !e:
            assert e.message() == "index 9 out of bounds (len 1)"
            assert e.line() != None

test fn a_user_err_through_question_mark_carries_its_origin():
    fn inner() -> int!:
        return !"boom"
    fn outer() -> int!:
        x := inner()?
        return ?x
    match outer():
        ?_: assert false, "expected Err"
        !e:
            assert e.message() == "boom"
            assert e.line() == ?18
            match e.file():
                None: assert false, "expected a recorded file"
                ?p: assert p.ends_with("error_location_test.chz")

test fn a_fault_inside_a_helper_names_this_file():
    fn helper():
        xs := [1]
        print(xs[9])
    r := recover: helper()
    match r:
        ?_: assert false, "expected a fault"
        !e:
            path := e.file()
            match path:
                None: assert false, "expected a recorded file"
                ?p: assert p.ends_with("error_location_test.chz")

struct MyErr:
    code: int
    fn message(self) -> str:
        return "code {self.code}"

test fn a_struct_error_with_only_message_carries_its_origin():
    fn boom() -> int!:
        return !MyErr(7)
    match boom():
        ?_: assert false, "expected Err"
        !e:
            assert e.message() == "code 7"
            assert e.line() == ?51
