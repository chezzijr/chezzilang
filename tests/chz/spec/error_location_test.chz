# tests/chz/spec/error_location_test.chz — a caught Error's origin span (W8-22, TICKET-026).
#
# A fault caught by `recover:` carries where it happened (`origin()`), and so does a
# user `!...`: where it was first made an error, kept through `?`. `error()` stays byte-identical
# in both cases. The full grid is `error_origin_grid_test.chz`.

test fn a_runtime_fault_carries_its_origin():
    xs := [1]
    r := recover: xs[9]
    match r:
        ?_: assert false, "expected a fault"
        !e:
            assert e.error() == "index 9 out of bounds (len 1)"
            assert e.origin() != None

test fn a_user_err_through_question_mark_carries_its_origin():
    fn inner() -> int!:
        return !"boom"
    fn outer() -> int!:
        x := inner()?
        return ?x
    match outer():
        ?_: assert false, "expected Err"
        !e:
            assert e.error() == "boom"
            match e.origin():
                None: assert false, "expected a recorded origin"
                ?o:
                    assert o.line == 18 and o.file.ends_with("error_location_test.chz"), "{o}"

test fn a_fault_inside_a_helper_names_this_file():
    fn helper():
        xs := [1]
        print(xs[9])
    r := recover: helper()
    match r:
        ?_: assert false, "expected a fault"
        !e:
            loc := e.origin()
            match loc:
                None: assert false, "expected a recorded origin"
                ?o: assert o.file.ends_with("error_location_test.chz"), o.file

struct MyErr:
    code: int
    fn error(self) -> str:
        return "code {self.code}"

test fn a_struct_error_with_only_message_carries_its_origin():
    fn boom() -> int!:
        return !MyErr(7)
    match boom():
        ?_: assert false, "expected Err"
        !e:
            assert e.error() == "code 7"
            match e.origin():
                None: assert false, "expected the origin of `!MyErr(7)`"
                ?o: assert o.line == 51, "line: {o.line}"
