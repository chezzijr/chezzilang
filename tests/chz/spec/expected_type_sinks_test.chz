# TICKET-054: three positions hold a statically known expected type at the position -- an
# annotation on a binding, a closure's own declared return, a protocol's declared parameter type --
# and used to ignore it, falsely rejecting a program every ancestor accepts. These assert the
# RUNTIME value, not just that the checker accepts. D3 (TICKET-138): an int never widens into a
# `float` slot, so every `float` slot below is written `N.0`; `/ 2` still reads back a real float.

protocol Sh:
    fn area(self) -> int

struct Sq:
    s: int
    fn area(self) -> int: self.s * self.s

struct Tr:
    b: int
    fn area(self) -> int: self.b

test fn if_expr_annotation_picks_protocol_slot():
    x: Sh = if true: Sq(2) else: Tr(9)
    assert x.area() == 4
    y: Sh = if false: Sq(2) else: Tr(9)
    assert y.area() == 9
    z: Sh = match 1:
        1: Sq(3)
        _: Tr(4)
    assert z.area() == 9

test fn closure_own_float_return_holds_a_float():
    g := fn() -> float: 3.0
    assert g() == 3.0
    assert g() / 2 == 1.5

type F = float

test fn closure_float_return_through_alias_holds_a_float():
    h := fn() -> F: 3.0
    assert h() / 2 == 1.5

protocol P:
    fn m(self, x: float) -> float

struct S:
    fn m(self, x: float) -> float:
        return x

fn viabound[T: P](t: T) -> float:
    return t.m(1.0)

test fn protocol_receiver_takes_a_float_arg():
    p: P = S()
    assert p.m(1.0) / 2 == 0.5
    assert viabound(S()) / 2 == 0.5

protocol Q:
    fn n(self, xs: List[float]) -> float

struct SQ:
    fn n(self, xs: List[float]) -> float:
        return xs[0]

test fn protocol_receiver_takes_a_float_list_element():
    q: Q = SQ()
    assert q.n([1.0, 2.0]) / 2 == 0.5

# A GENERIC struct witness declares its own param as the type parameter `T`, not literally `float`.
protocol P2:
    fn m2(self, x: float) -> float

struct GS[T]:
    v: T
    fn m2(self, x: T) -> T:
        return x

test fn protocol_receiver_takes_a_float_arg_through_generic_witness():
    p2: P2 = GS(1.0)
    assert p2.m2(1.0) / 2 == 0.5
