# TICKET-116 (W13-2) — the "push before the nursery opens" control from the wave-13 airlock column
# (`d20_receiver_push_before_nursery.chz`). It must stay clean: `Vm::slot_changed_since_baseline`
# compares against `root_baseline`, which is fixed at the ROOT view's FIRST-EVER nursery for the
# whole VM's life. Kept in its OWN file so this test's nursery is genuinely the first one the VM
# opens — any earlier `parallel:`/`spawn` sharing the VM (as every other test in
# `airlock_alias_root_gaps_test.chz` does) would fix `root_baseline` before this push runs and
# make the control fail for a reason unrelated to the fix under test.
import std.concurrency

g20: List[int] = [1]

fn producer_w13_2_control(c: Channel[fn() -> str]):
    g20.push(2)
    c.send(fn() -> str: "{g20}")

test fn receiver_push_before_the_nursery_still_merges():
    g20.push(9)
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2_control(c)
    f := c.recv()
    got := f()
    assert "{g20}" == "[1, 9, 2]", "pre-nursery push stopped merging: {got} {g20}"
