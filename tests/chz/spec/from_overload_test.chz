# tests/chz/spec/from_overload_test.chz: a type may declare several static `fn from(x: S)`
# overloads, one per source type `S` (Rust's several `impl From<S>`). A direct call
# `Rat.from(3)` picks the overload whose parameter fits the argument, and runs THAT body. A
# fallible conversion is `try_from` (Rust `impl TryFrom<S>`), overloaded the same way.
#
# Rust is the ancestor: `impl From<i64> for Rat` beside `impl From<&str> for Rat`, then
# `Rat::from(3)` and `Rat::from("ab")`, each run their own `from`. The declaration rejects
# (overlap, shape) and the call rejects (no overload for the argument, an argument that fits two)
# are Rust checker tests (`src/checker/tests/from_overloads.rs`): they never reach a runtime.
# A fault inside an overload names the frame `from` in its trace: a Rust VM test
# (`src/vm/tests/goldens_display.rs`), since a `.chz` test cannot read a trace.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import from_overload_lib as lib
import From, TryFrom from std.convert

struct Rat:
    n: int
    d: int
    fn from(x: int) -> Rat:
        return Rat(x, 1)
    fn from(x: str) -> Rat:
        return Rat(x.len(), 3)
    fn from(x: Rat) -> Rat:
        return Rat(x.n * 2, x.d * 2)

enum Sign:
    Pos
    Neg
    fn from(x: int) -> Sign:
        if x < 0:
            return Sign.Neg
        return Sign.Pos
    fn from(x: bool) -> Sign:
        if x:
            return Sign.Pos
        return Sign.Neg

struct Opt:
    v: int
    fn from(x: int?) -> Opt:
        return Opt(x ?? -1)
    fn from(x: str) -> Opt:
        return Opt(x.len() * 100)

struct Pos:
    v: int
    fn try_from(x: int) -> Pos!str:
        if x < 0:
            return !"negative"
        return Pos(x)
    fn try_from(x: str) -> Pos!str:
        if x == "":
            return !"empty"
        return Pos(x.len())

fn pos_of_int(n: int) -> int!str:
    p := Pos.try_from(n)?
    return p.v

fn pos_of_str(s: str) -> int!str:
    p := Pos.try_from(s)?
    return p.v

fn text(r: int!str) -> str:
    match r:
        ?v: return "ok {v}"
        !e: return e.message()

fn seven() -> int:
    return 7

fn abc() -> str:
    return "abc"

# Each overload has a computed default for `x`, so each gets a default PROVIDER function: the two
# must be distinct functions (one owner per overload), not one name declared twice.
struct Dflt:
    v: int
    fn from(x: int = seven()) -> Dflt:
        return Dflt(x)
    fn from(x: str = abc()) -> Dflt:
        return Dflt(x.len() * 10)

test fn each_struct_overload_runs_its_own_body():
    a := Rat.from(3)
    assert a.n == 3 and a.d == 1, "the int body"
    b := Rat.from("abcd")
    assert b.n == 4 and b.d == 3, "the str body"
    c := Rat.from(Rat(5, 7))
    assert c.n == 10 and c.d == 14, "the Rat body"

test fn each_enum_overload_runs_its_own_body():
    assert Sign.from(-4) == Sign.Neg
    assert Sign.from(4) == Sign.Pos
    assert Sign.from(false) == Sign.Neg
    assert Sign.from(true) == Sign.Pos

test fn an_optional_overload_takes_none_and_a_plain_value():
    assert Opt.from(None).v == -1
    assert Opt.from(5).v == 5, "`5` fits `int?`, not `str`"
    assert Opt.from("ab").v == 200

test fn a_try_from_overload_propagates_with_try():
    assert text(pos_of_int(4)) == "ok 4"
    assert text(pos_of_int(-1)) == "negative"
    assert text(pos_of_str("abc")) == "ok 3"
    assert text(pos_of_str("")) == "empty"

test fn overloads_with_defaults_keep_their_own_providers():
    assert Dflt.from(1).v == 1
    assert Dflt.from("ab").v == 20
    assert Dflt.from(x=5).v == 5, "a named argument picks the overload too"
    assert Dflt.from(x="abcd").v == 40

test fn an_imported_type_picks_its_overload_across_modules():
    assert lib.Temp.from(3).c == 3
    assert lib.Temp.from(2.5).c == -1
    assert lib.Level.from(20) == lib.Level.High
    assert lib.Level.from("low") == lib.Level.Low
    assert lib.Level.from("high") == lib.Level.High

# ---- through a bound: the CALLER picks the overload (Rust: `T: From<S>` picks the impl at the
# call, where `T` and `S` are known). The witness carries the chosen method; a generic caller
# forwards its own witness for the same requirement. ----

# A type with ONE from: every bound shape below must keep working.
struct One:
    v: int
    fn from(x: int) -> One:
        return One(x + 1000)

fn from_int[T: From[int]](n: int) -> T:
    return T.from(n)

fn make[S, T: From[S]](x: S) -> T:
    return T.from(x)

fn h[U, S: From[U]](x: U) -> S:
    return make(x)

fn both[T: From[int] + From[str]](n: int, s: str) -> List[T]:
    return [T.from(n), T.from(s)]

test fn a_bound_with_a_concrete_source_runs_that_overload():
    r: Rat = from_int(3)
    assert r.n == 3 and r.d == 1, "the int body"
    o: One = from_int(3)
    assert o.v == 1003

test fn a_bound_with_a_generic_source_picks_by_the_callers_source():
    a: Rat = make(5)
    assert a.n == 5 and a.d == 1, "the int body"
    b: Rat = make("ab")
    assert b.n == 2 and b.d == 3, "the str body"
    o: One = make(5)
    assert o.v == 1005

test fn a_generic_forwarder_passes_its_own_witness_on():
    a: Rat = h(5)
    assert a.n == 5 and a.d == 1, "the int body"
    b: Rat = h("abc")
    assert b.n == 3 and b.d == 3, "the str body"
    o: One = h(6)
    assert o.v == 1006

test fn two_from_bounds_on_one_type_param_each_pick_their_own():
    rs: List[Rat] = both(4, "abcde")
    assert rs[0].n == 4 and rs[0].d == 1, "the int body"
    assert rs[1].n == 5 and rs[1].d == 3, "the str body"
    ls: List[lib.Level] = both(20, "low")
    assert ls[0] == lib.Level.High
    assert ls[1] == lib.Level.Low

# ---- as a value: `Rat.from` names several fns, so the position's fn type picks one (Rust
# `E0283` without it: `let g = Rat::from;` needs an annotation). The checker test owns the reject. ----

fn apply(f: fn(str) -> Rat) -> int:
    return f("ab").n

test fn an_annotated_method_value_picks_its_overload():
    f: fn(int) -> Rat = Rat.from
    a := f(3)
    assert a.n == 3 and a.d == 1, "the int body"
    g: fn(str) -> Rat = Rat.from
    b := g("abcd")
    assert b.n == 4 and b.d == 3, "the str body"
    assert "{f}" == "<fn from>", "the internal name never shows"
    assert apply(Rat.from) == 2, "a typed parameter picks it too"
    o := One.from
    assert o(1).v == 1001, "a single from reads as before"

fn app_int[T](f: fn(int) -> T, n: int) -> T:
    return f(n)

test fn a_generic_slot_picks_the_method_value_by_its_param():
    rs := [1, 2].map(Rat.from)
    assert rs[1].n == 2 and rs[1].d == 1, "the int body"
    r := app_int(Rat.from, 7)
    assert r.n == 7 and r.d == 1, "the int body"

# ---- a source with holes (`[]`, `None`): the witness picks the one overload the source fits,
# the direct call's rule, whatever the declaration order (Rust: `make(vec![])` with
# `From<String>` + `From<Vec<i32>>` infers `Vec<i32>` and runs it). ----

struct ListFirst:
    v: int
    fn from(x: List[int]) -> ListFirst:
        return ListFirst(x.len())
    fn from(x: str) -> ListFirst:
        return ListFirst(100)

struct ListLast:
    v: int
    fn from(x: str) -> ListLast:
        return ListLast(100)
    fn from(x: List[int]) -> ListLast:
        return ListLast(x.len())

struct OptLast:
    v: int
    fn from(x: str) -> OptLast:
        return OptLast(x.len() * 100)
    fn from(x: int?) -> OptLast:
        return OptLast(x ?? -1)

test fn a_bound_source_with_holes_picks_the_one_overload_it_fits():
    a: ListFirst = make([])
    assert a.v == 0, "the List[int] body"
    b: ListLast = make([])
    assert b.v == 0, "the List[int] body"
    c: Opt = make(None)
    assert c.v == -1, "the int? body"
    d: OptLast = make(None)
    assert d.v == -1, "the int? body"
