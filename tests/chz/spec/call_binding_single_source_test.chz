# TICKET-182: call-argument binding must follow the checker's resolution of the call head.
# Desugar binds named/defaulted arguments before the checker runs, through its own resolver.

fn f(a: int, b: int = 10) -> int:
    return a + b

test fn nested_fn_shadows_defaulted_toplevel_fn():
    fn f(n: int) -> str:
        return "B{n}"
    assert f(1) == "B1"
