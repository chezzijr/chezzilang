# W8-30: `None!E`'s success value is spelled zero-arg `success` — see TICKET-017 `## Decisions`.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
fn done() -> None!str:
    return

test fn ok_zero_arg_constructs_a_result_nil():
    r := done()
    assert str(r) == "None"
    match r:
        ?_:
            assert true
        !e:
            assert false
