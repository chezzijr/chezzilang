# TICKET-285: a closure read out of a route, and a write through its captures. Grid: closure x readout route x capture
# kind. Every route a closure can be read out of is one `route` row: the box routes (`Shared.get`,
# `Shared.read`, `RwShared.get`, `RwShared.read`, the ConcurrentList / ConcurrentMap read views and
# `remove`), the Task route and the two handle routes (Channel, Atomic). M3.1: a module global is
# the run's one copy, so a write to it lands on every route and in every reader. M3.2: a Channel and
# an Atomic hold the closure itself. M3.3: a box holds the closure itself too, and a box closure
# runs in its caller's task, so a write through a capture lands on the one binding, in any reader
# (Go `closures.go`, M3.3 report: `box_route_other_task 2`, `box_route_same_task 3`,
# `box_built_closure [1 9]`, `job_closure_over_box [0 1]`). M3.4: an Executor job holds its
# submitter's locals by handle, so the `Task.get` route lands too (Go `m34go/readout/main.go`:
# `task_get_submitter_local 2`, `task_get_other_task 3`).
import Shared, RwShared, Atomic, Executor from std.concurrency
import ConcurrentList, ConcurrentMap from std.concurrency.collection

ROUTES := ["Shared.get", "Shared.read", "RwShared.get", "RwShared.read", "ConcurrentList.at", "ConcurrentMap.get", "ConcurrentMap.remove", "Channel.recv", "Atomic.load", "Task.get"]
BOX_ROUTES := ["Shared.get", "Shared.read", "RwShared.get", "RwShared.read", "ConcurrentList.at", "ConcurrentMap.get"]
G := [1]

fn some(o: (fn() -> None)?) -> fn() -> None:
    match o:
        ?v: return v
        None: panic("the route holds no closure")

fn ok(o: (fn() -> None)!) -> fn() -> None:
    match o:
        ?v: return v
        !e: panic(e.message())

# The fault message of `g()`, or "no-fault".
fn outcome(g: fn() -> None) -> str:
    res := recover: g()
    match res:
        ?_: return "no-fault"
        !e: return e.message()

# Store `f` behind `name` and return the reader that takes it back out.
fn route(name: str, f: fn() -> None) -> fn() -> fn() -> None:
    match name:
        "Shared.get":
            b := Shared([f])
            return fn(): b.get()[0]
        "Shared.read":
            b := Shared([f])
            return fn(): b.read(fn(s): s[0])
        "RwShared.get":
            b := RwShared([f])
            return fn(): b.get()[0]
        "RwShared.read":
            b := RwShared([f])
            return fn(): b.read(fn(s): s[0])
        "ConcurrentList.at":
            cl := ConcurrentList[fn() -> None].new()
            cl.push(f)
            return fn(): some(cl.at(0))
        "ConcurrentMap.get":
            cm := ConcurrentMap[int, fn() -> None].new()
            _ := cm.insert(1, f)
            return fn(): some(cm.get(1))
        "ConcurrentMap.remove":
            cm := ConcurrentMap[int, fn() -> None].new()
            _ := cm.insert(1, f)
            return fn(): some(cm.remove(1))
        "Channel.recv":
            ch := Channel[fn() -> None](1)
            ch.send(f)
            return fn(): ok(ch.recv())
        "Atomic.load":
            a := Atomic(f)
            return fn(): a.load()
        "Task.get":
            ex := Executor(1)
            t := ex.submit(fn(): f)
            ex.shutdown()
            return fn(): ok(t.get())
        _: panic("no route {name}")

# Read the closure out in a spawned task and call it there.
fn in_task(read: fn() -> fn() -> None) -> str:
    r := Channel[str](1)
    parallel:
        spawn:
            r.send(outcome(read()))
    v := r.recv() else: panic("r closed")
    return v

fn list_writer() -> fn() -> None:
    xs := [1]
    return fn(): xs.push(2)

fn global_writer() -> fn() -> None:
    return fn(): G.push(2)

# The routes whose reader task did NOT fault, for a closure from `make`.
fn silent_routes(make: fn() -> fn() -> None) -> List[str]:
    out: List[str] = []
    for name in ROUTES:
        if in_task(route(name, make())) == "no-fault":
            out.push(name)
    return out

# The routes on which `call` ran a closure over a fresh list with no fault, and its push reached
# that list.
fn landed_routes(call: fn(fn() -> fn() -> None) -> str) -> List[str]:
    out: List[str] = []
    for name in ROUTES:
        xs := [1]
        if call(route(name, fn(): xs.push(2))) == "no-fault" and xs == [1, 2]:
            out.push(name)
    return out

test fn shared_get_closure_capture_write_lands():
    assert in_task(route("Shared.get", list_writer())) == "no-fault"

test fn rwshared_get_closure_capture_write_lands():
    assert in_task(route("RwShared.get", list_writer())) == "no-fault"

test fn shared_read_result_closure_capture_write_lands():
    assert in_task(route("Shared.read", list_writer())) == "no-fault"

test fn rwshared_read_closure_capture_write_lands():
    assert in_task(route("RwShared.read", list_writer())) == "no-fault"

test fn concurrent_list_at_closure_capture_write_lands():
    assert in_task(route("ConcurrentList.at", list_writer())) == "no-fault"

test fn concurrent_map_get_closure_capture_write_lands():
    assert in_task(route("ConcurrentMap.get", list_writer())) == "no-fault"

test fn concurrent_map_remove_closure_capture_write_lands():
    assert in_task(route("ConcurrentMap.remove", list_writer())) == "no-fault"

test fn channel_recv_closure_capture_write_lands():
    assert in_task(route("Channel.recv", list_writer())) == "no-fault"

test fn list_capture_write_lands_on_every_route():
    assert landed_routes(in_task) == ROUTES

test fn global_write_lands_on_every_route():
    before := G.len()
    assert silent_routes(global_writer) == ROUTES
    assert G.len() == before + ROUTES.len(), "a route lost a global write: {G.len() - before}"

# The task that stored the closure reads it back: it is the closure itself.
test fn self_read_back_lands_on_every_box_route():
    for name in BOX_ROUTES:
        assert outcome(route(name, list_writer())()) == "no-fault", name

test fn a_task_reads_back_its_own_stored_closure_and_the_write_lands():
    r := Channel[str](1)
    parallel:
        spawn:
            r.send(outcome(route("Shared.get", list_writer())()))
    assert r.recv() == ?"no-fault"

# A closure a task built and stored, read by main after the join.
test fn task_built_closure_read_by_main_lands():
    b := Shared[List[fn() -> None]]([])
    parallel:
        spawn:
            b.set([list_writer()])
    assert outcome(b.get()[0]) == "no-fault"

# `update` stores a captured closure: every reader calls that closure, the updating task included.
test fn update_stored_closure_read_by_task_lands():
    g := list_writer()
    b := Shared[List[fn() -> None]]([])
    b.update(fn(s): s + [g])
    assert outcome(b.get()[0]) == "no-fault"
    assert in_task(fn(): b.get()[0]) == "no-fault"

# A closure built inside `read` captures the box's own live value, so its write lands in the box
# (Go `box_built_closure [1 9]`).
test fn box_built_closure_capture_write_lands_in_the_box():
    b := Shared([1])
    built := b.read(fn(s): fn(): s.push(9))
    assert outcome(built) == "no-fault"
    assert b.get() == [1, 9]

# TICKET-291 C1: a same-task round trip lands on every route (M3.4: no route copies).
test fn same_task_round_trip_lands_on_every_route():
    assert landed_routes(fn(read): outcome(read())) == ROUTES

# C2: a relay task re-stores the closure; it is still the one closure.
test fn relay_restore_through_shared_is_the_one_closure():
    g := list_writer()
    c := Shared([g])
    r := Channel[str](1)
    parallel:
        spawn:
            h := c.get()[0]
            c.set([h])
            r.send(outcome(c.get()[0]))
    assert r.recv() == ?"no-fault"

# M3.2: a relay through two channels hands on the one closure (Go `closures.go`: `relay 2`).
test fn relay_through_channels_is_the_one_closure():
    g := list_writer()
    ch := Channel[fn() -> None](1)
    ch2 := Channel[fn() -> None](1)
    ch.send(g)
    h := ch.recv() else: panic("ch closed")
    ch2.send(h)
    h2 := ch2.recv() else: panic("ch2 closed")
    assert outcome(h2) == "no-fault"

# C4: a closure received inside a box closure is the sender's closure.
test fn recv_inside_box_closure_is_the_senders_closure():
    ch := Channel[fn() -> None](1)
    b := Shared[List[fn() -> None]]([])
    r := Channel[str](1)
    parallel:
        spawn:
            xs := [1]
            ch.send(fn(): xs.push(2))
            while b.get().len() == 0:
                pass
            r.send(outcome(b.get()[0]))
        spawn:
            b.update(fn(s): s + [ok(ch.recv())])
    assert r.recv() == ?"no-fault"

# C3: a closure the box closure builds over FRESH state loses no write, so it must not fault.
fn make_logger() -> fn() -> None:
    log := [0]
    return fn(): log.push(1)

test fn box_built_closure_over_fresh_state_does_not_fault():
    c := Shared([1]).read(fn(s): make_logger())
    assert outcome(c) == "no-fault"

# TICKET-291 grid: route x reader x capture kind. Every cell lands (M3.4: the `Task.get` route
# too). A module-global write lands for every reader (`G` grows by one).
READERS := ["same task", "other task", "relay task"]
CAPTURES := ["captured list", "module global", "fresh box state", "box state"]

fn writer(capture: str) -> fn() -> None:
    match capture:
        "captured list":
            return list_writer()
        "module global":
            return global_writer()
        "fresh box state":
            return Shared([0]).read(fn(s): make_logger())
        "box state":
            return Shared([0]).read(fn(s): fn(): s.push(9))
        _: panic("no capture {capture}")

# The relay task reads the closure, stores it again behind a new `name` route, reads it back and
# calls it.
fn relay(name: str, read: fn() -> fn() -> None) -> str:
    r := Channel[str](1)
    parallel:
        spawn:
            r.send(outcome(route(name, read())()))
    v := r.recv() else: panic("r closed")
    return v

fn cell(name: str, reader: str, capture: str) -> str:
    read := route(name, writer(capture))
    match reader:
        "same task":
            return outcome(read())
        "other task":
            return in_task(read)
        "relay task":
            return relay(name, read)
        _: panic("no reader {reader}")

test fn closure_capture_grid_lands_on_every_route():
    wrong: List[str] = []
    for name in ROUTES:
        for reader in READERS:
            for capture in CAPTURES:
                before := G.len()
                got := cell(name, reader, capture)
                if capture == "module global":
                    if got != "no-fault" or G.len() != before + 1:
                        wrong.push("{name}/{reader}/{capture}")
                elif got != "no-fault":
                    wrong.push("{name}/{reader}/{capture}")
    assert wrong == []

struct Pair:
    put: fn() -> None
    size: fn() -> int

fn make_pair() -> Pair:
    log := [0]
    return Pair(fn(): log.push(1), fn() -> int: log.len())

fn over_state(s: List[int]) -> fn() -> None:
    log := [s]
    return fn(): log[0].push(5)

# C3 row: the closure a box call builds and returns runs on what it captured, by handle: a write
# over fresh state is seen by a sibling closure over the same binding, and a write over the box's
# live value lands in the box (Go `box_built_closure [1 9]`).
test fn box_call_result_closure_writes_land():
    p := Shared([1]).read(fn(s): make_pair())
    assert outcome(p.put) == "no-fault"
    assert p.size() == 2
    q := RwShared([1]).read(fn(s): make_pair())
    assert outcome(q.put) == "no-fault"
    assert q.size() == 2
    b := Shared([1])
    assert outcome(b.read(fn(s): fn(): s.push(9))) == "no-fault"
    assert outcome(b.read(fn(s): over_state(s))) == "no-fault"
    assert b.get() == [1, 9, 5]
    rw := RwShared([1])
    assert outcome(rw.read(fn(s): fn(): s.push(9))) == "no-fault"
    assert rw.get() == [1, 9]

fn first_pair(s: List[(int, int)]) -> fn() -> None:
    xs := [s[0]]
    return fn(): xs.push((9, 9))

fn first_holder(s: List[List[int]]) -> fn() -> None:
    xs := [s]
    return fn(): xs.push(s)

fn fresh_logger() -> fn() -> None:
    log := [0]
    return fn(): log.push(1)

fn shared_logger(box: Shared[List[int]]) -> fn() -> None:
    return box.read(fn(s): fn(): s.push(1))

# TICKET-295 F1: a fresh capture that holds only an immutable object the box keeps loses no write.
test fn box_call_fresh_capture_over_kept_immutable_does_not_fault():
    b := Shared([(1, 2)])
    assert outcome(b.read(fn(s): first_pair(s))) == "no-fault"
    assert b.get() == [(1, 2)]

# F1: a fresh capture that holds a MUTABLE object of the box lands too: the box holds it by handle.
test fn box_call_fresh_capture_over_kept_mutable_lands():
    b := Shared([[1]])
    assert outcome(b.read(fn(s): first_holder(s))) == "no-fault"

# F2: a job result closure over fresh state: the job heap ends with the job, so the caller holds the only copy.
test fn task_result_closure_over_fresh_state_does_not_fault():
    ex := Executor(1)
    t := ex.submit(fresh_logger)
    ex.shutdown()
    assert outcome(ok(t.get())) == "no-fault"

# F2: a job result closure over the live state of a Shared the job shares: the write lands in the
# box (Go `job_closure_over_box [0 1]`).
test fn task_result_closure_over_shared_state_lands():
    box := Shared[List[int]]([0])
    ex := Executor(1)
    t := ex.submit(fn(): shared_logger(box))
    ex.shutdown()
    assert outcome(ok(t.get())) == "no-fault"
    assert box.get() == [0, 1]

# TICKET-295 grid: one cell per kind of box element that a fresh capture holds. M3.3: the box holds
# each by handle, so no cell faults.
struct Pt:
    x: int

enum Hold:
    Num(int)
    Items(List[int])

# The cell `name` when its outcome `got` is a fault, else nothing.
fn miss(name: str, got: str) -> List[str]:
    if got == "no-fault":
        return []
    return [name]

fn hold_first[T](s: List[T]) -> fn() -> None:
    xs := [s[0]]
    return fn(): xs.push(xs[0])

test fn fresh_capture_over_a_kept_element_grid():
    wrong: List[str] = []
    wrong.extend(miss("str", outcome(Shared(["a"]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("tuple of ints", outcome(Shared([(1, 2)]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("option of tuple", outcome(Shared[List[(int, int)?]]([?(1, 2)]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("enum of int", outcome(Shared([Hold.Num(1)]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("tuple holding a list", outcome(Shared([(1, [2])]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("option of list", outcome(Shared[List[List[int]?]]([?[2]]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("enum holding a list", outcome(Shared([Hold.Items([2])]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("struct", outcome(Shared([Pt(1)]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("list", outcome(Shared([[1]]).read(fn(s): hold_first(s)))))
    wrong.extend(miss("map", outcome(Shared([{1: 2}]).read(fn(s): hold_first(s)))))
    assert wrong == []

fn list_capture(l: List[int]) -> fn() -> None:
    return fn(): l.push(1)

# The outcome of a write through the closure an Executor job built with `f`.
fn job_closure(f: fn() -> fn() -> None) -> str:
    ex := Executor(1)
    t := ex.submit(f)
    ex.shutdown()
    return outcome(ok(t.get()))

# TICKET-295 grid: a job result closure faults on no capture (M3.4: a submitter local is the
# submitter's one list, Go `task_get_submitter_local 2`). Box state is the box's live value (M3.3).
test fn task_result_closure_capture_grid():
    xs := [1]
    box := Shared[List[int]]([0])
    wrong: List[str] = []
    wrong.extend(miss("fresh state", job_closure(fresh_logger)))
    wrong.extend(miss("module global", job_closure(global_writer)))
    wrong.extend(miss("submitter local", job_closure(fn(): list_capture(xs))))
    wrong.extend(miss("box state", job_closure(fn(): shared_logger(box))))
    assert wrong == []
    assert xs == [1, 1]
