    inner := gl3[0]
    c := Channel[str](1)
    parallel:
        spawn:
            write_inner := d4_push2
            res := recover:
                write_inner(inner)
            match res:
                ?_: c.send("no-fault")
                !e: c.send(e.message())
    got := c.recv()
    assert got == "no-fault", got
    assert gl3 == [[1, 2]]

gl4: List[List[int]] = [[1]]

fn w4(xs: List[int], c: Channel[str]):
    res := recover:
        xs.push(2)
    match res:
        ?_: c.send("no-fault")
        !e: c.send(e.message())

test fn spawn_arg_alias_write_lands():
    c := Channel[str](1)
    parallel:
        spawn w4(gl4[0], c)
    got := c.recv()
    assert got == "no-fault", got
    assert gl4 == [[1, 2]]

