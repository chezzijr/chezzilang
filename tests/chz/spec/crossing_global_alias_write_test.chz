    p.n = 5

gm116: Map[str, P116] = {"k": P116(1)}

test fn struct_in_map_alias_write_lands():
    p := gm116["k"]
    c := Channel[str](1)
    parallel:
        spawn:
            write_p := d4_set_p116
            res := recover:
                write_p(p)
