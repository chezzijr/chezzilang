# A write in a task through an alias of a module global lands on the run's one copy of the global,
# and a closure that another task receives reads the live global (M3.1, Go model). The aliases: a
# task-local alias, a callee param alias, a spawn-adopted alias, an element alias, and an alias the
# PARENT made and the task captured (M3.4). Goldens: the equivalent Go program, go1.27.0
# (`m34go/aliasroot/main.go`: `element_alias [1 2]`, `whole_global_alias [1 2]`,
# `struct_in_map_alias 5`, `spawn_adopted_alias [1 2]`, `spawn_arg_alias [1 2]`, `two_hop [1 2]`).
# History: TICKET-105/116 (carry-and-install), TICKET-137 (D2, per-task global copies) and
# TICKET-169 (D4 layer C, a fault on the write) gave other answers; M3 deleted that copy model.
# TICKET-111 (docs/contributing/gaps.md W12-5): a task-local alias of a global is the SAME object
# as the global.
import Iterator from std.iter
import std.concurrency

fn d4_push2(xs: List[int]):
    xs.push(2)

gl: List[List[int]] = [[1]]

test fn local_alias_of_global_element_write_through_alias_lands():
    inner := gl[0]
    r := Channel[str](1)
    parallel:
        spawn:
            write_inner := d4_push2
            res := recover:
                write_inner(inner)
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
    got := r.recv()
    assert got == "no-fault", got
    assert gl == [[1, 2]]

g: List[int] = [1]

fn producer_alias(c: Channel[fn() -> str], fr: Channel[str]):
    xs := g
    res := recover:
        xs.push(2)
    match res:
        ?_: fr.send("no-fault")
        !e: fr.send(e.message())
    c.send(fn() -> str: "{g}")

test fn write_through_local_alias_of_global_lands_and_the_received_closure_reads_it():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_alias(c, fr)
    fault := fr.recv()
    assert fault == "no-fault", fault
    f := c.recv()
    got := f()
    assert got == "[1, 2]", "received closure missed the sender's alias write: {got}"

h: List[int] = [1]

fn add(xs: List[int], fr: Channel[str]):
    res := recover:
        xs.push(2)
    match res:
        ?_: fr.send("no-fault")
        !e: fr.send(e.message())

fn producer_param(c: Channel[fn() -> str], fr: Channel[str]):
    add(h, fr)
    c.send(fn() -> str: "{h}")

test fn write_through_param_alias_of_global_lands_and_the_received_closure_reads_it():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_param(c, fr)
    fault := fr.recv()
    assert fault == "no-fault", fault
    f := c.recv()
    got := f()
    assert got == "[1, 2]", "received closure missed the sender's param-alias write: {got}"

gw: List[List[int]] = [[1]]

test fn local_alias_of_a_whole_global_write_through_alias_lands():
    a := gw
    r := Channel[str](1)
    parallel:
        spawn:
            write_a := d4_push2
            res := recover:
                write_a(a[0])
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
    got := r.recv()
    assert got == "no-fault", got
    assert gw == [[1, 2]]

struct P:
    n: int

fn d4_set_p(p: P):
    p.n = 5

gm: Map[str, P] = {"k": P(1)}

test fn local_alias_of_a_struct_in_a_global_map_write_through_alias_lands():
    k := "k"
    p := gm[k]
    r := Channel[str](1)
    parallel:
        spawn:
            write_p := d4_set_p
            res := recover:
                write_p(p)
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
    got := r.recv()
    assert got == "no-fault", got
    assert gm["k"].n == 5

fn count3() -> Iterator[int]:
    yield 1
    yield 2
    yield 3

gg: List[Iterator[int]] = [count3()]

# The alias is made in the task. Go: one iterator, `1 2`.
test fn local_alias_of_a_global_generator_is_one_generator():
    r := Channel[str](1)
    parallel:
        spawn:
            it := gg[0]
            a := it.next()
            b := gg[0].next()
            r.send("{a} {b}")
    got := r.recv()
    assert got == "1 2", "generator alias is two live copies: {got}"

# W13-1 (docs/contributing/gaps.md) — a spawn-ADOPTED alias of a module global (`a := gl` in the parent,
# `a.push(2)` in the task). M3.4: the adopted alias IS the global, so the write lands.
gl2: List[int] = [1]

test fn write_through_spawn_adopted_alias_lands():
    a := gl2
    c := Channel[str](1)
    parallel:
        spawn:
            write_a := d4_push2
            res := recover:
                write_a(a)
            match res:
                ?_: c.send("no-fault")
                !e: c.send(e.message())
    got := c.recv()
    assert got == "no-fault", got
    assert gl2 == [1, 2]

# W13-1 neighbours (TICKET-116) — the same shape across container kinds, closure timings and
# forwarding hops. Each write lands on the global (M3.4).
gl3: List[List[int]] = [[1]]

