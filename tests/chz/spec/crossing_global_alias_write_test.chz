gl5: List[int] = [1]

test fn closure_built_before_the_alias_push_lands():
    a := gl5
    c := Channel[str](1)
    parallel:
        spawn:
            _f := fn() -> str: "{gl5}"
            write_a := d4_push2
            res := recover:
                write_a(a)
            match res:
                ?_: c.send("no-fault")
                !e: c.send(e.message())
    got := c.recv()
    assert got == "no-fault", got
    assert gl5 == [1, 2]

gl6: List[int] = [1]

test fn nested_nursery_send_lands():
    a := gl6
    c := Channel[str](1)
    parallel:
        spawn:
            write_a := d4_push2
            res := recover:
                write_a(a)
            match res:
                ?_: c.send("no-fault")
                !e: c.send(e.message())
            parallel:
                spawn:
                    pass
    got := c.recv()
    assert got == "no-fault", got
    assert gl6 == [1, 2]

gl8: List[int] = [1]

test fn executor_job_reads_the_tasks_alias_write():
    r := Channel[str](1)
    ex := concurrency.Executor()
    parallel:
        spawn:
            a := gl8
            res := recover:
                d4_push2(a)
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
            _ := ex.submit(fn(): r.send("{gl8}"))
    fault := r.recv()
    assert fault == "no-fault", fault
    got := r.recv()
    assert got == "[1, 2]", "executor job read {got}"

gl9: List[int] = [1]

test fn two_hop_closure_alias_write_lands():
    a := gl9
    c := Channel[str](1)
    fc := Channel[fn() -> str](1)
    d := Channel[fn() -> str](1)
    parallel:
        spawn:
            write_a := d4_push2
            res := recover:
                write_a(a)
            match res:
                ?_: c.send("no-fault")
                !e: c.send(e.message())
            fc.send(fn() -> str: "{gl9}")
        spawn:
            f := fc.recv()
            d.send(f)
    fault := c.recv()
    assert fault == "no-fault", fault
    got := d.recv()()
    assert got == "[1, 2]", "two-hop forwarded closure read {got}"

# W13-2 (docs/contributing/gaps.md) — a receiver's OWN in-place mutation of a module global used to be silently
# overwritten by an arriving closure whose sender also mutated it. M3.1: both writes land in the
# run's one copy. The receiver writes after the sender's signal, so the two never race. Go: the
# sender's `2`, then the receiver's `9`.
g2: List[int] = [1]

fn producer_w13_2(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g2.push(2)
    match res:
        ?_: fr.send("no-fault")
        !e: fr.send(e.message())
    c.send(fn() -> str: "{g2}")

test fn receiver_own_write_survives_arriving_closure_write():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    fault := ""
    parallel:
        spawn producer_w13_2(c, fr)
        fault = fr.recv()
        g2.push(9)
    assert fault == "no-fault", fault
    f := c.recv()
    got := "{f()} {g2}"
    assert got == "[1, 2, 9] [1, 2, 9]", "receiver's own write to the global was lost: {got}"

# W13-2 neighbours (TICKET-116) — the receiver's own in-place write must survive an arriving
# closure, across write shapes, sibling receivers, and the pre-nursery control. `g2.push(9)`/
# `g18[1] = 9`/`g22.b = 9` run on the ROOT task, after the producer's signal.
g18: List[int] = [1, 0]

fn producer_w13_2_index(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g18.push(2)
    match res:
        ?_: fr.send("no-fault")
        !e: fr.send(e.message())
    c.send(fn() -> str: "{g18}")

test fn receiver_index_assign_survives_arriving_closure():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    fault := ""
    parallel:
        spawn producer_w13_2_index(c, fr)
        fault = fr.recv()
        g18[1] = 9
    assert fault == "no-fault", fault
    f := c.recv()
    got := "{f()} {g18}"
    assert got == "[1, 9, 2] [1, 9, 2]", "receiver's own index write was lost: {got}"

struct Q116:
    a: int
    b: int

g22: Q116 = Q116(0, 0)

fn producer_w13_2_field(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g22.a = 2
    match res:
        ?_: fr.send("no-fault")
        !e: fr.send(e.message())
    c.send(fn() -> str: "{g22.a}")

test fn receiver_field_write_survives_arriving_closure():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    fault := ""
    parallel:
        spawn producer_w13_2_field(c, fr)
        fault = fr.recv()
        g22.b = 9
    assert fault == "no-fault", fault
    f := c.recv()
    got := "{f()} {g22.a} {g22.b}"
    assert got == "2 2 9", "receiver's own field write was lost: {got}"

g21: List[int] = [1]

fn producer_w13_2_sibling(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g21.push(2)
    match res:
        ?_: fr.send("no-fault")
        !e: fr.send(e.message())
    c.send(fn() -> str: "{g21}")

fn consumer_w13_2_sibling(c: Channel[fn() -> str], r: Channel[str], fr: Channel[str]):
    f := c.recv()
    res := recover:
        g21.push(9)
    match res:
        ?_: fr.send("no-fault")
        !e: fr.send(e.message())
    r.send("{f()} {g21}")

# The consumer writes after it received the producer's closure, so the two never race.
# Go: `[1 2 9] [1 2 9]`.
test fn sibling_task_receiver_own_write_lands():
    c := Channel[fn() -> str](1)
    r := Channel[str](1)
    fr1 := Channel[str](1)
    fr2 := Channel[str](1)
    parallel:
        spawn producer_w13_2_sibling(c, fr1)
        spawn consumer_w13_2_sibling(c, r, fr2)
    fault1 := fr1.recv()
    fault2 := fr2.recv()
    assert fault1 == "no-fault", fault1
    assert fault2 == "no-fault", fault2
    got := r.recv()
    assert got == "[1, 2, 9] [1, 2, 9]", "a sibling's write is lost: {got}"

g20: List[int] = [1]

fn producer_w13_2_control(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g20.push(2)
    match res:
        ?_: fr.send("no-fault")
        !e: fr.send(e.message())
    c.send(fn() -> str: "{g20}")

# TICKET-137 — the receiver's `9` is pushed BEFORE the nursery, on the ROOT task; the sender's `2`
# lands after it in the run's one copy. Go: `[1 9 2]`.
test fn receiver_push_before_the_nursery_and_the_senders_push_both_land():
    g20.push(9)
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_w13_2_control(c, fr)
    fault := fr.recv()
    assert fault == "no-fault", fault
    f := c.recv()
    got := f()
    assert got == "[1, 9, 2]", "received closure read {got}"
    assert "{g20}" == "[1, 9, 2]", "the parent read {g20}"
