# TICKET-169 rows: a task reads a captured value, writes its own object or a `.copy()`, or writes
# through a handle (Shared, RwShared, Atomic, Channel, a listener), and no row faults. The writes
# to a parent's value land too (`crossing_task_write_lands_test.chz`).
import std.concurrency
import std.net

gl_read := [1, 2]

test fn a_task_reading_a_captured_list_is_silent():
    r := Channel[str](1)
    parallel:
        spawn:
            r.send("{gl_read}")
    assert r.recv() == ?"[1, 2]"

test fn a_task_reading_a_module_global_is_silent():
    r := Channel[int](1)
    parallel:
        spawn:
            r.send(gl_read.len())
    assert r.recv() == ?2

test fn a_task_pushing_to_its_own_new_list_is_silent():
    r := Channel[str](1)
    parallel:
        spawn:
            ys := [1]
            ys.push(2)
            r.send("{ys}")
    assert r.recv() == ?"[1, 2]"

test fn copy_then_push_in_a_task_is_silent():
    xs := [1]
    r := Channel[str](1)
    parallel:
        spawn:
            ys := xs.copy()
            ys.push(2)
            r.send("{ys}")
    assert r.recv() == ?"[1, 2]"

test fn a_shared_set_from_a_task_is_silent():
    s := concurrency.Shared(1)
    r := Channel[str](1)
    parallel:
        spawn:
            s.set(9)
            r.send("ok")
    _ := r.recv()
    assert s.get() == 9

test fn a_shared_update_from_a_task_is_silent():
    s := concurrency.Shared(1)
    r := Channel[str](1)
    parallel:
        spawn:
            s.update(fn(v: int) -> int: v + 1)
            r.send("ok")
    _ := r.recv()
    assert s.get() == 2

test fn an_rw_shared_write_from_a_task_is_silent():
    s := concurrency.RwShared(1)
    r := Channel[str](1)
    parallel:
        spawn:
            s.write(fn(v: int) -> int: v + 1)
            r.send("ok")
    _ := r.recv()
    assert s.get() == 2

test fn an_atomic_store_from_a_task_is_silent():
    a := concurrency.Atomic(1)
    r := Channel[str](1)
    parallel:
        spawn:
            a.store(9)
            r.send("ok")
    _ := r.recv()
    assert a.load() == 9

test fn an_atomic_int_add_from_a_task_is_silent():
    a := concurrency.AtomicInt(0)
    r := Channel[str](1)
    parallel:
        spawn:
            a.add(1)
            r.send("ok")
    _ := r.recv()
    assert a.load() == 1

test fn a_channel_send_from_a_task_is_silent():
    c := Channel[int](1)
    r := Channel[str](1)
    parallel:
        spawn:
            c.send(5)
            r.send("ok")
    _ := r.recv()
    assert c.recv() == ?5

test fn closing_a_listener_from_a_task_is_silent():
    ln := net.listen("127.0.0.1:0")
    match ln:
        ?l:
            r := Channel[str](1)
            parallel:
                spawn:
                    res := recover:
                        l.close()
                    match res:
                        ?_: r.send("no-fault")
                        !e: r.send(e.message())
            assert r.recv() == ?"no-fault"
        !_: assert false, "setup failed: could not bind a listener"

gl_before_after := [1, 2]

test fn a_root_task_writes_its_globals_before_and_after_a_nursery_is_silent():
    gl_before_after.push(3)
    assert gl_before_after == [1, 2, 3]
    done := Channel[bool](1)
    parallel:
        spawn:
            done.send(true)
    _ := done.recv()
    gl_before_after.push(4)
    assert gl_before_after == [1, 2, 3, 4]

fn produce(c: Channel[List[int]]):
    xs := [1]
    c.send(xs)

test fn a_channel_received_list_pushed_by_the_receiver_is_silent():
    c := Channel[List[int]](1)
    parallel:
        spawn produce(c)
    xs := c.recv() else: panic("c closed")
    xs.push(2)
    assert xs == [1, 2]

test fn shared_get_temporary_pushed_by_the_receiver_is_silent():
    s := concurrency.Shared([1])
    v := s.get()
    v.push(1)
    assert v == [1, 1]

test fn an_outer_task_pushing_after_an_inner_nursery_read_is_silent():
    r := Channel[str](1)
    parallel:
        spawn:
            ys := [1]
            parallel:
                spawn:
                    r.send("{ys}")
            _ := r.recv()
            ys.push(2)
            assert ys == [1, 2]

struct Tally:
    s: concurrency.Shared[int]

    fn index(self, k: int) -> int:
        return self.s.get()

    fn set_index(self, k: int, v: int):
        self.s.update(fn(x: int) -> int: x + v)

test fn a_copied_struct_set_index_writing_through_a_shared_field_is_silent():
    t := Tally(concurrency.Shared(0))
    r := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                t[0] = 5
            match res:
                ?_: r.send("no-fault")
                !e: r.send(e.message())
    assert r.recv() == ?"no-fault"
    assert t.s.get() == 5

# A tuple (xs, f), f capturing xs, sent over a Channel: M3.2 moves the tuple itself, so neither
# f()'s push nor the direct write to the tuple's own xs faults, and both land on the one list (Go
# `tuple.go`, M3.2 report: `xs_first 3`). The mirror order (f, xs) is in
# crossing_task_write_lands_test.chz's a_closure_visited_first_in_one_channel_send_shares_the_capture.
test fn a_list_visited_first_in_one_channel_send_shares_the_capture():
    xs := [1]
    f := fn() -> None: xs.push(2)
    ch := Channel[(List[int], fn() -> None)](1)
    ch.send((xs, f))
    r1 := Channel[str](1)
    r2 := Channel[str](1)
    parallel:
        spawn:
            p := ch.recv() else: panic("ch closed")
            res1 := recover:
                p.1()
            match res1:
                ?_: r1.send("no-fault")
                !e: r1.send(e.message())
            res2 := recover:
                p.0.push(3)
            match res2:
                ?_: r2.send("no-fault")
                !e: r2.send(e.message())
    assert r1.recv() == ?"no-fault"
    assert r2.recv() == ?"no-fault"
    assert xs == [1, 2, 3]
