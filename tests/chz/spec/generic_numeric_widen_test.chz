# W12-15 (TICKET-106): a generic call widens a bare `T` slot's untyped int constant to `float`
# beside a sibling `float`-binding argument, and the widened constant is REALLY coerced at the call
# site (`Op::CoerceFloat`), not just accepted at check time.
fn mx[T: Comparable](a: T, b: T) -> T:
    if a > b:
        return a
    return b

test fn widened_call_produces_a_real_float():
    assert mx(1, 2.5) == 2.5
    assert mx(1, 2.5) / 2 == 1.25
    assert str(mx(3, 2.5)) == "3.0"

test fn widen_fires_either_argument_order():
    assert mx(2.5, 1) == 2.5

test fn fold_widens_its_untyped_zero_seed():
    assert str([1.5, 2.5].fold(0, fn(a: float, b: float) -> float: a + b)) == "4.0"
    empty: List[float] = []
    assert str(empty.fold(0, fn(a: float, b: float) -> float: a + b)) == "0.0"
