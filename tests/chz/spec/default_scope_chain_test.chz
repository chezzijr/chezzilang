# tests/chz/spec/default_scope_chain_test.chz — W7-51: a non-literal default argument is compiled
# ONCE, as a hidden zero-arg function in the module that DECLARES it, and the omitting call site
# calls that function instead of receiving a clone of the expression.
#
# What that buys, and what this file pins:
#
#   • **Chains compose to any depth.** `fn a(x = b())` over `fn b(y = c())` over `fn c(z = 1)` used
#     to fail at depth 3 with `'c' expects 1 argument(s), got 0` — the old pass spliced the default
#     into the tail of `walk_expr_inner`, after that node's children had been walked, and the driver
#     ran exactly two passes, so the third link never got normalized. Verified on the pre-change
#     binary: depth 2 printed `1`, depth 3 errored, depth 4 errored twice. Python prints `1` at
#     every depth.
#   • **Per-call evaluation is preserved.** Chezzi deliberately re-evaluates a default on every
#     omitting call (Python evaluates it once, at def time — the classic mutable-default footgun).
#     A provider is a plain function call, so that stays true: three omitting calls run the body
#     three times.
#   • **A self-contained literal is still cloned inline** (`= 1 + 2`, `= None`, `= []`, `= -1`, a
#     brace-free string). That class records no checker→compiler side-table entry, so cloning it
#     into many call sites cannot alias a span key (W7-49), and it costs no call.
#
# The cross-MODULE half — a default resolving in the DEFINER's namespace rather than the caller's —
# is inherently multi-file and lives in `src/vm/tests.rs`
# (`a_cross_module_default_resolves_in_its_definer_not_the_caller` and siblings).
#
# Serial==M:N is guarded by `test_runner::chz_suite_passes_both_engines`.

# --- chained defaults, depth 3, 4 and 5 -------------------------------------------------------

fn c5(v: int = 5) -> int:
    return v

fn c4(v: int = c5()) -> int:
    return v

fn c3(v: int = c4()) -> int:
    return v

fn c2(v: int = c3()) -> int:
    return v

fn c1(v: int = c2()) -> int:
    return v

test fn a_default_chain_resolves_at_depth_three_four_and_five():
    assert c3() == 5, "depth 3 — got {c3()}"
    assert c2() == 5, "depth 4 — got {c2()}"
    assert c1() == 5, "depth 5 — got {c1()}"
    # …and supplying the argument still bypasses every link.
    assert c1(9) == 9, "got {c1(9)}"
    assert c3(7) == 7, "got {c3(7)}"

# --- per-call evaluation ----------------------------------------------------------------------

counter := 0

fn bump() -> int:
    counter = counter + 1
    return counter

fn takes_bumped(n: int = bump()) -> int:
    return n

test fn a_default_is_evaluated_once_per_omitting_call():
    # Python would freeze this at 1 (defaults evaluate at def time); Chezzi's documented choice is
    # to run it per call, which is what a provider CALL preserves.
    assert takes_bumped() == 1, "first call"
    assert takes_bumped() == 2, "second call"
    assert takes_bumped() == 3, "third call"
    # An explicit argument does not run the default at all.
    assert takes_bumped(100) == 100, "explicit argument"
    assert counter == 3, "the default must not have run a fourth time — got {counter}"

# --- the inline (cloned, not provided) class ----------------------------------------------------

fn lit_arith(n: int = 1 + 2) -> int:
    return n

fn lit_neg(n: int = -1) -> int:
    return n

fn lit_none(o: Option[int] = None) -> int:
    match o:
        Some(v): return v
        None: return -7

fn lit_empty(xs: List[int] = []) -> int:
    return xs.len()

fn lit_str(s: str = "hi") -> str:
    return s

test fn a_self_contained_literal_default_still_evaluates():
    assert lit_arith() == 3, "got {lit_arith()}"
    assert lit_neg() == -1, "got {lit_neg()}"
    assert lit_none() == -7, "got {lit_none()}"
    assert lit_none(Some(4)) == 4, "got {lit_none(Some(4))}"
    assert lit_empty() == 0, "got {lit_empty()}"
    assert lit_empty([1, 2, 3]) == 3, "got {lit_empty([1, 2, 3])}"
    assert lit_str() == "hi", "got {lit_str()}"

test fn an_empty_list_default_is_fresh_per_call():
    # The inline clone is a fresh `[]` literal at each call site, so Python's shared-mutable-default
    # footgun cannot happen here either.
    a := lit_empty_ref()
    a.push(1)
    b := lit_empty_ref()
    assert b.len() == 0, "the second call must get its own list — got {b}"

fn lit_empty_ref(xs: List[int] = []) -> List[int]:
    return xs

# --- defaults on struct fields and methods ------------------------------------------------------

BASE := 10

fn scale() -> int:
    return BASE * 3

struct Cfg:
    a: int = scale()
    b: int = 1 + 1

struct Runner:
    tag: str

    fn go(self, n: int = scale()) -> int:
        return n

test fn a_field_and_method_default_resolve_through_their_provider():
    c := Cfg()
    assert c.a == 30, "got {c.a}"
    assert c.b == 2, "got {c.b}"
    assert Cfg(1, 2).a == 1, "explicit ctor args still win"
    r := Runner("r")
    assert r.go() == 30, "got {r.go()}"
    assert r.go(4) == 4, "got {r.go(4)}"

# --- a chain that runs THROUGH a constructor and THROUGH a method ---------------------------------
#
# The depth-3 chain above is fn→fn→fn. This one alternates the kinds of declaration a provider can
# be synthesized for: a struct FIELD default (`Wrap.inner`) calls a fn whose parameter default is a
# CONSTRUCTOR call (`Base()`), whose own field default is a literal — and a METHOD default takes the
# same route. Measured on `b1307258`: 3 type errors, all `'Base' expects 1 argument(s), got 0` (the
# nested ctor call in a spliced default was never normalized). Here, and in CPython: 5 / 10 / 3.

struct Base:
    v: int = 5

fn from_base(b: Base = Base()) -> int:
    return b.v

struct Wrap:
    inner: int = from_base()

    fn peek(self, n: int = from_base()) -> int:
        return n + self.inner

test fn a_default_chain_runs_through_a_ctor_and_a_method():
    assert Wrap().inner == 5, "field ← fn default ← ctor ← literal — got {Wrap().inner}"
    assert Wrap().peek() == 10, "the method default takes the same route — got {Wrap().peek()}"
    assert Wrap(2).peek(1) == 3, "explicit args bypass both — got {Wrap(2).peek(1)}"

# --- a variadic call as a default, in the PRE-SLOT and in the keyword-only TAIL -------------------
#
# A v1 limit rejected a variadic CALL used as a default (`x: int = sum_all(1, 2, 3)`): the surplus-
# positional collapse was gated to desugar's first pass while the default was spliced raw after it,
# so the spliced call never collapsed. A provider body is walked exactly once, like any other body,
# so the collapse fires normally — and exactly once, which is what the `[8, 7]` below pins (a second
# collapse would nest the List).
#
# Measured on `b1307258`: **6 type errors** (`'sum_all' expects 1 argument(s), got 2` +
# `argument 1 of 'sum_all': expected List[int], found int`, once for the pre-slot and twice for the
# tail). Here — and byte for byte in CPython 3.14 with `def f(a=sum_all(1,2), *xs, tail=sum_all(3,4))`
# — `3|[]|7`, `9|[8, 7]|7`, `9|[8, 7]|1`.

fn sum_all(...xs: int) -> int:
    total := 0
    for x in xs:
        total = total + x
    return total

fn slots(a: int = sum_all(1, 2), ...xs: int, tail: int = sum_all(3, 4)) -> str:
    return "{a}|{xs}|{tail}"

test fn a_variadic_call_default_fills_a_pre_slot_and_a_keyword_only_tail():
    assert slots() == "3|[]|7", "got {slots()}"
    assert slots(9, 8, 7) == "9|[8, 7]|7", "the collapse must fire ONCE — got {slots(9, 8, 7)}"
    assert slots(9, 8, 7, tail=1) == "9|[8, 7]|1", "got {slots(9, 8, 7, tail=1)}"

# --- the non-propagating carriers, and the ONE `?` shape that is accepted -------------------------
#
# `?` cannot propagate OUT of a default (see the header of `default_splice_keys_test.chz`), but
# neither Option-mode `?.` nor `??` propagates, so both still evaluate — and a `?` INSIDE a
# Result-typed parameter's default is fine, because the provider is declared `-> int!str` and the
# `?` early-returns within the provider, handing the parameter the `Err`. That accepted half is the
# widening the narrowing came with, and it is pinned here because a widening is structurally
# untested by the suite that passed before it. Measured on `b1307258`, and on `e2d9bd4e` before the
# diagnostic was tailored: `'?' used in a function that returns int, not Result or Option`, 1 error.
# Here: `4` and `-1`.

fn geto2() -> Option[int]:
    return Some(3)

fn getr() -> str!str:
    return Ok("wxyz")

fn coalesced(x: int = geto2() ?? 0) -> int:
    return x

fn res_param(x: int!str = Ok(getr()?.len())) -> int:
    match x:
        Ok(v): return v
        Err(e): return -1

test fn a_null_coalescing_default_still_evaluates():
    assert coalesced() == 3, "got {coalesced()}"
    assert coalesced(9) == 9, "got {coalesced(9)}"

test fn a_result_typed_parameters_default_may_use_try_inside_the_provider():
    assert res_param() == 4, "the `?` resolves INSIDE the provider — got {res_param()}"
    e := res_param(Err("no"))
    assert e == -1, "got {e}"
    assert res_param(Ok(7)) == 7, "got {res_param(Ok(7))}"

# --- a cycle the compile-time check cannot see ----------------------------------------------------
#
# A DIRECT cycle (`fn f(x: int = f())`) is a compile error naming the parameter (pinned in
# `src/desugar/mod.rs`). A cycle routed through an ORDINARY function is invisible to that check —
# the provider's only outgoing edge is `mk`, not another provider — so it is check-clean and then a
# clean runtime fault, the same shape as CPython's `RecursionError` on the equivalent program. A
# documented limit, not a defect.

struct Cyc:
    n: int = mk_cyc().n

fn mk_cyc() -> Cyc:
    return Cyc()

test fn a_default_cycle_routed_through_an_ordinary_fn_faults_cleanly():
    r := recover: Cyc().n
    match r:
        Ok(v): assert false, "expected a fault, got {v}"
        Err(e): assert e.message().contains("maximum call depth"), "got {e.message()}"
