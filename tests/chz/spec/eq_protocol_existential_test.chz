# tests/chz/spec/eq_protocol_existential_test.chz — W7-52: comparing a PROTOCOL-typed value defers
# the witness's `eq` to runtime, exactly as Go's interface `==` does, and faults cleanly (never a
# silent wrong answer, never an abort) when the concrete witness cannot satisfy the bound.
#
# `docs/gaps.md` W7-52 once framed this as a checker "blind spot" in two places: (a) the `Eq` bound
# walk grants `Ty::Protocol` via its permissive catch-all, and (b) `may_be_equal`'s
# `(Protocol, Protocol) => true` arm short-circuits before either operand's witness is visible. Both
# are load-bearing, not bugs — see the row for the full argument. Go measured, 1.26:
#
#     type Sized interface{ Size() int }
#     type Tag struct{ ns []int }          // uncomparable: holds a slice
#     func (t Tag) Size() int { return len(t.ns) }
#     var x Sized = Tag{[]int{1}}
#     var y Sized = Tag{[]int{2}}
#     fmt.Println(x == y)
#
#     panic: runtime error: comparing uncomparable type main.Tag
#
# Go compiles the comparison and panics at the point it actually runs — it cannot reject at compile
# time because it does not know which concrete type inhabits the interface at this call site. Chezzi
# does the same thing at the same point for the same reason (the checker deliberately erases
# existentials): a clean, catchable runtime fault, not a silent wrong answer and not an abort.
#
# The verdict left ONE spelling of this relation disagreeing with the rest: `x == y` on two
# protocol-typed operands never asked the protocol system at all (it went through `may_be_equal`),
# but a `[T: Eq]` bound fed a protocol-typed value was rejected at CHECK time — *"does not satisfy
# Eq"* — because `Ty::Protocol` had no `intrinsic_recv_kind` classification (the same hole `Ty::Func`
# had, closed the same way in W7-54). Go 1.20+ widened `comparable` to admit interface types
# (measured, 1.26): `func eqg[T comparable](a, b T) bool { return a == b }` fed two `Sized` values
# compiles and runs; fed an uncomparable witness it compiles and panics at the comparison — the exact
# shape this file already pins for the bare operator. `Ty::Protocol` now classifies as receiver kind
# `"protocol"` and `("Eq", "eq", "protocol")` is a registered intrinsic grant, so `[T: Eq]` now agrees
# with `==`/`.eq()` too — see the `a_generic_eq_bound_…` tests below. Only `Eq` was widened: every
# other protocol (`Stringable`/`Hashable`/`Comparable`/…) still correctly rejects a
# protocol-typed value that does not structurally provide it — pinned in
# `checker::tests::protocol_typed_value_does_not_satisfy_other_protocols` and
# `checker::tests::protocol_typed_value_rejects_comparable_on_the_real_reason` (Rust-side, since
# these are compile-time REJECTIONS, not runtime behavior this suite pins).

fn msg_of[T](r: Result[T, Error], where_: str) -> str:
    match r:
        Ok(_): assert false, where_ + " must fault"
        Err(e): return e.message()
    return ""

protocol Sized_:
    fn size(self) -> int

# `Tag` has no `compare` — the "uncomparable" witness, Go's slice-holding `Tag` twin.
struct Tag:
    n: int
    fn size(self) -> int:
        return self.n

# `Box[T]`'s `eq` genuinely USES the `Comparable` bound (not `self.val == other.val`, which would
# fall back to structural equality and return a wrong-but-not-faulting answer instead of faulting).
# `tag` is a SECOND field `eq` deliberately ignores — `struct K` in eq_protocol_containers_test.chz's
# shape — so the positive control below can prove dispatch really reaches the WITNESS's `eq` rather
# than silently falling back to structural `Box` equality: two `Box`es differing only in `tag` must
# compare EQUAL, which plain field-by-field comparison would get wrong.
struct Box[T]:
    val: T
    tag: str
    fn eq(self, o: Box[T]) -> bool where T: Comparable:
        return self.val.compare(o.val) == 0
    fn size(self) -> int:
        return 1

# ---- negative: `Box[Tag]`'s witness cannot satisfy `Comparable` (Tag has no `compare`) ----

test fn protocol_typed_operator_eq_faults_on_an_unsatisfied_witness():
    x: Sized_ = Box(Tag(1), "x")
    y: Sized_ = Box(Tag(2), "y")
    r := recover: x == y
    msg := msg_of(r, "protocol-typed `==`")
    assert msg.contains("has no method 'compare'"), "the fault names the failing method: " + msg

test fn protocol_typed_contains_faults_on_an_unsatisfied_witness():
    x: Sized_ = Box(Tag(1), "x")
    y: Sized_ = Box(Tag(2), "y")  # distinct from x — [a].contains(a) would hit the identity shortcut
    xs: List[Sized_] = [x]
    r := recover: xs.contains(y)
    msg := msg_of(r, "protocol-typed `.contains()`")
    assert msg.contains("has no method 'compare'"), "the fault names the failing method: " + msg

# ---- positive control: `Box[int]`'s witness DOES satisfy `Comparable` (int has it intrinsically) —
# the same protocol-typed `==` must give the right answer and must NOT fault. `b` differs from `a`
# only in `tag`, which `eq` never looks at — so this is a genuine dispatch-through-the-witness proof,
# not just an agreement-with-structural-equality coincidence: a silently-stopped dispatch that fell
# back to structural `Box` equality would call `a == b` FALSE (tag differs) and fail this assertion.

test fn protocol_typed_operator_eq_succeeds_on_a_satisfied_witness():
    a: Sized_ = Box(5, "a")
    b: Sized_ = Box(5, "different-tag")
    c: Sized_ = Box(6, "a")
    assert (a == b) == true, "eq ignores tag and agrees only on val — disagrees with structural equality"
    assert (a == c) == false, "distinct val compares unequal regardless of tag"

test fn protocol_typed_contains_succeeds_on_a_satisfied_witness():
    a: Sized_ = Box(5, "a")
    b: Sized_ = Box(5, "different-tag")
    c: Sized_ = Box(6, "a")
    xs: List[Sized_] = [a]
    assert xs.contains(b) == true, "membership dispatches through the same eq the operator does"
    assert xs.contains(c) == false

# ---- the CRITICAL fix: a `[T: Eq]` bound now agrees with the bare `==` over a protocol-typed value
# ---- (previously `check` rejected it — "does not satisfy Eq" — while `==` compiled and ran)

fn generic_eq[T: Eq](a: T, b: T) -> bool:
    return a == b

test fn a_generic_eq_bound_agrees_with_the_bare_operator_on_a_protocol_typed_value():
    a: Sized_ = Tag(1)
    b: Sized_ = Tag(2)
    assert (a == b) == false
    assert generic_eq(a, b) == false, "a [T: Eq] bound must give the SAME answer as `==` itself"
    c: Sized_ = Tag(1)
    d: Sized_ = Tag(1)
    assert generic_eq(c, d) == true

# ---- the same generic-bound spelling, on the uncomparable `Box[Tag]` witness, must fault cleanly —
# ---- Go's `eqg[T comparable]` fed an uncomparable witness compiles and panics at the comparison,
# ---- the identical shape ----

test fn a_generic_eq_bound_faults_on_an_unsatisfied_witness_same_as_the_operator():
    x: Sized_ = Box(Tag(1), "x")
    y: Sized_ = Box(Tag(2), "y")
    r := recover: generic_eq(x, y)
    msg := msg_of(r, "a [T: Eq] bound over a protocol-typed value")
    assert msg.contains("has no method 'compare'"), "the fault names the failing method: " + msg
