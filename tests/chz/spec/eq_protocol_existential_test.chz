# tests/chz/spec/eq_protocol_existential_test.chz — W7-52: comparing a PROTOCOL-typed value defers a
# SATISFIED witness's `eq` to runtime, exactly as Go's interface `==` does.
#
# TICKET-053 corrects this file's earlier claim that an UNSATISFIED witness's `eq` — one whose own
# `where` bound cannot hold for this instantiation — is deferred the same way and faults cleanly at
# the comparison. It is not: Chezzi can see the concrete witness at the point it is ERASED into the
# protocol-typed slot, and since TICKET-053 that erasure is refused at compile time when the witness's
# `eq` carries an unmet `where` bound, naming the bound (e.g. ``Box[Tag]'s `eq` requires Tag:
# Comparable``). That is Rust's compile-time model, not Go's runtime one — Rust, measured (rustc
# 1.97.0): `struct Box<T>(T); impl<T: PartialEq> PartialEq for Box<T> { .. }` fed a non-`PartialEq` `T`
# through a `dyn Trait`-erasing call site is `error[E0369]` at the erasure, not a runtime panic. The
# three tests this used to pin (an operator, `.contains()`, and a `[T: Eq]` bound each faulting on an
# unsatisfied witness) no longer compile — `x: Sized_ = Box(Tag(1), "x")` itself is now a type error —
# and moved to `checker::tests::protocol_erasure_eq_where_bound_boundaries` as compile-time rejections.
#
# What THIS file still pins is the SATISFIED half: a witness whose `eq` bound genuinely holds still
# dispatches through it once erased into the protocol slot, rather than falling back to structural
# equality — the same relation Go's interface `==` defers to the dynamic type for, measured 1.26:
#
#     type Sized interface{ Size() int }
#     type Tag struct{ n int }
#     func (t Tag) Size() int { return t.n }
#     var x Sized = Tag{1}
#     var y Sized = Tag{1}
#     fmt.Println(x == y)   // true — Go dispatches the interface comparison to the concrete Tag
#
# `x == y` on two protocol-typed operands never asked the protocol system at all (it goes through
# `may_be_equal`), and a `[T: Eq]` bound fed a protocol-typed value now agrees with it: `Ty::Protocol`
# classifies as receiver kind `"protocol"` and `("Eq", "eq", "protocol")` is a registered intrinsic
# grant, so `[T: Eq]` and `==`/`.eq()` give the same answer — see the `a_generic_eq_bound_…` test
# below. Only `Eq` was widened this way: every other protocol (`Stringable`/`Hashable`/`Comparable`/…)
# still correctly rejects a protocol-typed value that does not structurally provide it — pinned in
# `checker::tests::protocol_typed_value_does_not_satisfy_other_protocols` and
# `checker::tests::protocol_typed_value_rejects_comparable_on_the_real_reason` (Rust-side, since
# these are compile-time REJECTIONS, not runtime behavior this suite pins).

protocol Sized_:
    fn size(self) -> int

# `Tag` has no `compare` — the "uncomparable" witness, Go's slice-holding `Tag` twin.
struct Tag:
    n: int
    fn size(self) -> int:
        return self.n

# `Box[T]`'s `eq` genuinely USES the `Comparable` bound (not `self.val == other.val`, which would
# fall back to structural equality and give the same answer without proving dispatch). The `eq` body
# must call the BOUNDED `compare` so the positive control below proves dispatch really reaches the
# witness's `eq`, not a structural coincidence. `tag` is a SECOND field `eq` deliberately ignores —
# `struct K` in eq_protocol_containers_test.chz's shape — so the positive control below can prove
# dispatch really reaches the WITNESS's `eq` rather than silently falling back to structural `Box`
# equality: two `Box`es differing only in `tag` must compare EQUAL, which plain field-by-field
# comparison would get wrong.
struct Box[T]:
    val: T
    tag: str
    fn eq(self, o: Box[T]) -> bool where T: Comparable:
        return self.val.compare(o.val) == 0
    fn size(self) -> int:
        return 1

# ---- positive control: `Box[int]`'s witness DOES satisfy `Comparable` (int has it intrinsically) —
# the same protocol-typed `==` must give the right answer and must NOT fault. `b` differs from `a`
# only in `tag`, which `eq` never looks at — so this is a genuine dispatch-through-the-witness proof,
# not just an agreement-with-structural-equality coincidence: a silently-stopped dispatch that fell
# back to structural `Box` equality would call `a == b` FALSE (tag differs) and fail this assertion.

test fn protocol_typed_operator_eq_succeeds_on_a_satisfied_witness():
    a: Sized_ = Box(5, "a")
    b: Sized_ = Box(5, "different-tag")
    c: Sized_ = Box(6, "a")
    assert (a == b) == true, "eq ignores tag and agrees only on val — disagrees with structural equality"
    assert (a == c) == false, "distinct val compares unequal regardless of tag"

test fn protocol_typed_contains_succeeds_on_a_satisfied_witness():
    a: Sized_ = Box(5, "a")
    b: Sized_ = Box(5, "different-tag")
    c: Sized_ = Box(6, "a")
    xs: List[Sized_] = [a]
    assert xs.contains(b) == true, "membership dispatches through the same eq the operator does"
    assert xs.contains(c) == false

# ---- the CRITICAL fix: a `[T: Eq]` bound now agrees with the bare `==` over a protocol-typed value
# ---- (previously `check` rejected it — "does not satisfy Eq" — while `==` compiled and ran)

fn generic_eq[T: Eq](a: T, b: T) -> bool:
    return a == b

test fn a_generic_eq_bound_agrees_with_the_bare_operator_on_a_protocol_typed_value():
    a: Sized_ = Tag(1)
    b: Sized_ = Tag(2)
    assert (a == b) == false
    assert generic_eq(a, b) == false, "a [T: Eq] bound must give the SAME answer as `==` itself"
    c: Sized_ = Tag(1)
    d: Sized_ = Tag(1)
    assert generic_eq(c, d) == true
