# A parameterized protocol bound's type args are recovered from the type that witnesses it, so
# `fn produce_as[R, T: Produces[R]](x: T) -> R` no longer needs an annotation to pin `R` — this
# generalizes the recovery that `Iterator[T]` / `Index[K, V]` bounds already had. Rust infers the
# same program (`impl Produces<i32> for IntProducer`); Chezzi used to reject it, blaming the
# perfectly valid `produce` for having "the wrong signature".

protocol Produces[R]:
    fn produce(self) -> R

protocol Pair[A, B]:
    fn first(self) -> A
    fn second(self) -> B

struct IntProducer:
    fn produce(self) -> int:
        return 7

struct StrProducer:
    fn produce(self) -> str:
        return "hi"

struct P:
    fn first(self) -> int:
        return 1
    fn second(self) -> str:
        return "two"

struct Wrapper:
    fn produce_as[R, T: Produces[R]](self, x: T) -> R:
        return x.produce()

fn produce_as[R, T: Produces[R]](x: T) -> R:
    return x.produce()

fn first_of[A, B, T: Pair[A, B]](x: T) -> A:
    return x.first()

fn second_of[A, B, T: Pair[A, B]](x: T) -> B:
    return x.second()

test fn recovers_the_bound_arg_from_the_witnessing_method():
    # The result is the CONCRETE type, not an Unknown that merely stops the complaint — the
    # arithmetic and the str method are what a laundered Unknown would sail through.
    assert produce_as(IntProducer()) + 1 == 8
    assert produce_as(StrProducer()).upper() == "HI"

test fn recovers_every_param_independently():
    assert first_of(P()) + 1 == 2
    assert second_of(P()).len() == 3

test fn recovery_also_works_on_the_generic_method_path():
    # This path has no annotation-seeding at all, so before the recovery only turbofish worked
    # here — a result annotation could not pin `R`.
    w := Wrapper()
    assert w.produce_as(IntProducer()) * 2 == 14
    assert w.produce_as(StrProducer()).len() == 2

test fn explicit_type_arguments_still_win():
    assert produce_as[int, IntProducer](IntProducer()) == 7
    assert Wrapper().produce_as[str, StrProducer](StrProducer()) == "hi"

struct Popped:
    fn pop(self) -> int:
        return 5

struct Taker:
    fn take[R, T: Produces[R]](self, x: T) -> R:
        return x.produce()

test fn a_result_annotation_pins_the_param_on_the_method_path():
    # The method path had no annotation seeding at all before: this reported a false conformance
    # error PLUS "cannot assign R to variable of type int". Only a turbofish worked.
    v: int = Taker().take(IntProducer())
    assert v == 7
    s: str = Taker().take(StrProducer())
    assert s == "hi"

test fn method_and_free_fn_agree():
    assert produce_as(IntProducer()) == Taker().take(IntProducer())
    assert produce_as(StrProducer()) == Taker().take(StrProducer())

fn empty_of[T]() -> List[T]:
    return []

test fn a_generic_empty_producer_is_pinned_by_a_later_use():
    # `T` cannot be bound AT the call, but the result is `List[Unknown]` — the same type `[]`
    # produces — so the next statement pins the element, exactly as it does for a bare literal.
    # Rust infers the identical program from the later use.
    xs := empty_of()
    xs.push(1)
    xs.push(2)
    assert xs == [1, 2]

    ys := empty_of()
    ys.push("a")
    assert ys == ["a"]

test fn the_generic_producer_matches_the_literal():
    a := empty_of()
    a.push(7)
    b := []
    b.push(7)
    assert a == b
