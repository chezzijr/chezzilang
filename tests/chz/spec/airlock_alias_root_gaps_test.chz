gl6: List[int] = [1]

test fn nested_nursery_send_faults():
    a := gl6
    c := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                a.push(2)
            match res:
                Ok(_): c.send("no-fault")
                Err(e): c.send(e.message())
            parallel:
                spawn:
                    pass
    got := c.recv()
    assert got.starts_with("this value is this task's copy:"), got

gl8: List[int] = [1]

test fn executor_job_alias_write_faults():
    r := Channel[str](1)
    ex := Executor()
    parallel:
        spawn:
            a := gl8
            res := recover:
                a.push(2)
            match res:
                Ok(_): r.send("no-fault")
                Err(e): r.send(e.message())
            ex.submit(fn(): r.send("{gl8}"))
    fault := r.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    got := r.recv()
    assert got == "[1]", "executor job read {got}"

gl9: List[int] = [1]

test fn two_hop_closure_alias_write_faults():
    a := gl9
    c := Channel[str](1)
    fc := Channel[fn() -> str](1)
    d := Channel[fn() -> str](1)
    parallel:
        spawn:
            res := recover:
                a.push(2)
            match res:
                Ok(_): c.send("no-fault")
                Err(e): c.send(e.message())
            fc.send(fn() -> str: "{gl9}")
        spawn:
            f := fc.recv()
            d.send(f)
    fault := c.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    got := d.recv()()
    assert got == "[1]", "two-hop forwarded closure read {got}"

# W13-2 (docs/gaps.md) — a receiver's OWN in-place mutation of a module global used to be silently
# overwritten by an arriving closure whose sender also mutated it. TICKET-169: the SENDER's mutation
# now faults (a spawned task may not write its global copy), so it can no longer overwrite anything;
# the receiver's own write (also inside a spawned task, so it faults identically) is asserted to
# fault too — both writes are refused, not raced.
g2: List[int] = [1]

fn producer_w13_2(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g2.push(2)
    match res:
        Ok(_): fr.send("no-fault")
        Err(e): fr.send(e.message())
    c.send(fn() -> str: "{g2}")

test fn receiver_own_write_survives_arriving_closure_write():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_w13_2(c, fr)
        g2.push(9)
    fault := fr.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    f := c.recv()
    got := "{f()} {g2}"
    assert 9 in g2, "receiver's own write to the global was lost: {got}"

# W13-2 neighbours (TICKET-116) — the receiver's own in-place write must survive an arriving
# closure's install, across write shapes, sibling receivers, and the pre-nursery control that must
# stay clean. `g2.push(9)`/`g18[1] = 9`/`g22.b = 9` above and below run on the ROOT task (the
# statement beside `spawn` in a `parallel:` block runs in the opening task, never in the spawned
# child), so they are untouched by D4 — only the SPAWNED producer's write faults.
g18: List[int] = [1, 0]

fn producer_w13_2_index(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g18.push(2)
    match res:
        Ok(_): fr.send("no-fault")
        Err(e): fr.send(e.message())
    c.send(fn() -> str: "{g18}")

test fn receiver_index_assign_survives_arriving_closure():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_w13_2_index(c, fr)
        g18[1] = 9
    fault := fr.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    f := c.recv()
    got := "{f()} {g18}"
    assert g18[1] == 9, "receiver's own index write was lost: {got}"

struct Q116:
    a: int
    b: int

g22: Q116 = Q116(0, 0)

fn producer_w13_2_field(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g22.a = 2
    match res:
        Ok(_): fr.send("no-fault")
        Err(e): fr.send(e.message())
    c.send(fn() -> str: "{g22.a}")

test fn receiver_field_write_survives_arriving_closure():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_w13_2_field(c, fr)
        g22.b = 9
    fault := fr.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    f := c.recv()
    got := "{f()} {g22.a} {g22.b}"
    assert g22.b == 9, "receiver's own field write was lost: {got}"

g21: List[int] = [1]

fn producer_w13_2_sibling(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g21.push(2)
    match res:
        Ok(_): fr.send("no-fault")
        Err(e): fr.send(e.message())
    c.send(fn() -> str: "{g21}")

fn consumer_w13_2_sibling(c: Channel[fn() -> str], r: Channel[str], fr: Channel[str]):
    res := recover:
        g21.push(9)
    match res:
        Ok(_): fr.send("no-fault")
        Err(e): fr.send(e.message())
    f := c.recv()
    r.send("{f()} {g21}")

test fn sibling_task_receiver_own_write_faults():
    c := Channel[fn() -> str](1)
    r := Channel[str](1)
    fr1 := Channel[str](1)
    fr2 := Channel[str](1)
    parallel:
        spawn producer_w13_2_sibling(c, fr1)
        spawn consumer_w13_2_sibling(c, r, fr2)
    fault1 := fr1.recv()
    fault2 := fr2.recv()
    assert fault1.starts_with("this value is this task's copy:"), fault1
    assert fault2.starts_with("this value is this task's copy:"), fault2
    got := r.recv()
    assert "1" in got, "expected each sibling's own (unwritten) copy: {got}"

g20: List[int] = [1]

fn producer_w13_2_control(c: Channel[fn() -> str], fr: Channel[str]):
    res := recover:
        g20.push(2)
    match res:
        Ok(_): fr.send("no-fault")
        Err(e): fr.send(e.message())
    c.send(fn() -> str: "{g20}")

# TICKET-137 — the receiver's `9` is pushed BEFORE the nursery, on the ROOT task, so it lands
# untouched by D4 (`module_snapshot.is_none()` there) and is in the task's snapshot; the sender's
# `2` now faults instead of landing only in the sender's copy. (Its nursery is not the first the VM
# opens — every test above it already opened one — so it also covers a re-snapshot after earlier
# nurseries.)
test fn receiver_push_before_the_nursery_is_in_the_receivers_copy():
    g20.push(9)
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_w13_2_control(c, fr)
    fault := fr.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    f := c.recv()
    got := f()
    assert got == "[1, 9]", "received closure read {got}, expected the receiver's [1, 9]"
    assert "{g20}" == "[1, 9]", "receiver's own copy read {g20}"
