gl5: List[int] = [1]

test fn closure_built_before_the_alias_push_faults():
    a := gl5
    c := Channel[str](1)
    parallel:
        spawn:
            _f := fn() -> str: "{gl5}"
            res := recover:
                a.push(2)
            match res:
                Ok(_): c.send("no-fault")
                Err(e): c.send(e.message())
    got := c.recv()
