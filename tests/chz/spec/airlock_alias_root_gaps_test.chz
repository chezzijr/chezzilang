# TICKET-137 (owner decision D2) — supersedes TICKET-105/TICKET-116's carry-and-install. A
# closure received from another task reads the module globals of the task that RUNS it: each task
# owns a deep copy of every module global, and a crossing carries captures only.
# TICKET-169 (D4 layer C) supersedes the write half: a sender's write to a global (directly,
# through a local alias, a callee param alias, a spawn-adopted alias, or an element alias) now
# FAULTS instead of silently landing in the sender's own copy. Since the write never lands, the
# receiver's closure still reads its own (unwritten) value — D2's isolation still holds, now
# enforced at the write instead of by a silent drop. CPython threading and Go see one shared
# object; the divergence is the deliberate "module globals isolate per task, and a task may not
# write one" rule (docs/concurrency.md) — use `Shared`/`Channel` to share.
# TICKET-111 (docs/gaps.md W12-5) — a task-local alias of a global is the SAME object as the
# task's copy of the global (adoption), not a second copy. That still holds; a write through
# either the alias or the global now faults identically (both denote the one copied object).
import std.concurrency

gl: List[List[int]] = [[1]]

test fn local_alias_of_global_element_write_through_alias_faults():
    inner := gl[0]
    r := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                inner.push(2)
            match res:
                Ok(_): r.send("no-fault")
                Err(e): r.send(e.message())
    got := r.recv()
    assert got.starts_with("this value is this task's copy:"), got

g: List[int] = [1]

fn producer_alias(c: Channel[fn() -> str], fr: Channel[str]):
    xs := g
    res := recover:
        xs.push(2)
    match res:
        Ok(_): fr.send("no-fault")
        Err(e): fr.send(e.message())
    c.send(fn() -> str: "{g}")

test fn write_through_local_alias_of_global_faults_and_read_stays_the_receivers_copy():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_alias(c, fr)
    fault := fr.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    f := c.recv()
    got := f()
    assert got == "[1]", "received closure read the sender's alias write: {got}"

h: List[int] = [1]

fn add(xs: List[int], fr: Channel[str]):
    res := recover:
        xs.push(2)
    match res:
        Ok(_): fr.send("no-fault")
        Err(e): fr.send(e.message())

fn producer_param(c: Channel[fn() -> str], fr: Channel[str]):
    add(h, fr)
    c.send(fn() -> str: "{h}")

test fn write_through_param_alias_of_global_faults_and_read_stays_the_receivers_copy():
    c := Channel[fn() -> str](1)
    fr := Channel[str](1)
    parallel:
        spawn producer_param(c, fr)
    fault := fr.recv()
    assert fault.starts_with("this value is this task's copy:"), fault
    f := c.recv()
    got := f()
    assert got == "[1]", "received closure read the sender's param-alias write: {got}"

