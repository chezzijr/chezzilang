struct P:
    n: int

gm: Map[str, P] = {"k": P(1)}

test fn local_alias_of_a_struct_in_a_global_map_write_through_alias_faults():
    k := "k"
    p := gm[k]
    r := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                p.n = 5
            match res:
                Ok(_): r.send("no-fault")
                Err(e): r.send(e.message())
    got := r.recv()
    assert got.starts_with("this value is this task's copy:"), got

fn count3() -> Iterator[int]:
    yield 1
    yield 2
    yield 3

gg: List[Iterator[int]] = [count3()]

test fn local_alias_of_a_global_generator_is_one_generator():
    it := gg[0]
    r := Channel[str](1)
    parallel:
        spawn:
            a := it.next()
            b := gg[0].next()
            r.send("{a} {b}")
    got := r.recv()
    assert got == "Some(1) Some(2)", "generator alias is two live copies: {got}"

# W13-1 (docs/gaps.md) — a spawn-ADOPTED alias of a module global (`a := gl` in the parent,
# `a.push(2)` in the task). Under D2/TICKET-111 the adopted alias IS the task's copy of the global.
# TICKET-169: writing it now faults instead of silently landing only in the sender's copy.
gl2: List[int] = [1]

test fn write_through_spawn_adopted_alias_faults():
    a := gl2
    c := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                a.push(2)
            match res:
                Ok(_): c.send("no-fault")
                Err(e): c.send(e.message())
    got := c.recv()
    assert got.starts_with("this value is this task's copy:"), got

# W13-1 neighbours (TICKET-116) — the same shape across container kinds, closure timings and
# forwarding hops. Each write now faults instead of landing only in the sender's copy.
gl3: List[List[int]] = [[1]]

test fn element_alias_write_faults():
    inner := gl3[0]
    c := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                inner.push(2)
            match res:
                Ok(_): c.send("no-fault")
                Err(e): c.send(e.message())
    got := c.recv()
    assert got.starts_with("this value is this task's copy:"), got

