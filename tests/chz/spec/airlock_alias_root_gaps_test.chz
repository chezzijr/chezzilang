# TICKET-137 (owner decision D2) — supersedes TICKET-105/TICKET-116's carry-and-install. A
# closure received from another task reads the module globals of the task that RUNS it: each task
# owns a deep copy of every module global, and a crossing carries captures only. A sender's write
# to a global (directly, through a local alias, a callee param alias, a spawn-adopted alias, or an
# element alias) lands in the SENDER's copy, so the receiver's closure still reads its own value.
# CPython threading and Go see one shared object; the divergence is the deliberate "module globals
# isolate per task" rule (docs/concurrency.md) — use `Shared`/`Channel` to share.
# TICKET-111 (docs/gaps.md W12-5) — a task-local alias of a global is the SAME object as the
# task's copy of the global (adoption), not a second copy. That still holds and the tests below
# that assert it (`*_is_not_a_second_copy`) are unchanged.
import std.concurrency

gl: List[List[int]] = [[1]]

test fn local_alias_of_global_element_is_not_a_second_copy():
    inner := gl[0]
    r := Channel[str](1)
    parallel:
        spawn:
            inner.push(2)
            r.send("{inner} {gl[0]}")
    got := r.recv()
    assert got == "[1, 2] [1, 2]", "alias/global diverged: {got}"

g: List[int] = [1]

fn producer_alias(c: Channel[fn() -> str]):
    xs := g
    xs.push(2)
    c.send(fn() -> str: "{g}")

test fn write_through_local_alias_of_global_reads_the_receivers_copy():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_alias(c)
    f := c.recv()
    got := f()
    assert got == "[1]", "received closure read the sender's alias write: {got}"

h: List[int] = [1]

fn add(xs: List[int]):
    xs.push(2)

fn producer_param(c: Channel[fn() -> str]):
    add(h)
    c.send(fn() -> str: "{h}")

test fn write_through_param_alias_of_global_reads_the_receivers_copy():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_param(c)
    f := c.recv()
    got := f()
    assert got == "[1]", "received closure read the sender's param-alias write: {got}"

gw: List[List[int]] = [[1]]

test fn local_alias_of_a_whole_global_is_not_a_second_copy():
    a := gw
    r := Channel[str](1)
    parallel:
        spawn:
            a[0].push(2)
            r.send("{a} {gw}")
    got := r.recv()
    assert got == "[[1, 2]] [[1, 2]]", "whole alias diverged: {got}"

struct P:
    n: int

gm: Map[str, P] = {"k": P(1)}

test fn local_alias_of_a_struct_in_a_global_map_is_not_a_second_copy():
    k := "k"
    p := gm[k]
    r := Channel[str](1)
    parallel:
        spawn:
            p.n = 5
            r.send("{p.n} {gm[k].n}")
    got := r.recv()
    assert got == "5 5", "struct alias diverged: {got}"

fn count3() -> Iterator[int]:
    yield 1
    yield 2
    yield 3

gg: List[Iterator[int]] = [count3()]

test fn local_alias_of_a_global_generator_is_one_generator():
    it := gg[0]
    r := Channel[str](1)
    parallel:
        spawn:
            a := it.next()
            b := gg[0].next()
            r.send("{a} {b}")
    got := r.recv()
    assert got == "Some(1) Some(2)", "generator alias is two live copies: {got}"

# W13-1 (docs/gaps.md) — a spawn-ADOPTED alias of a module global (`a := gl` in the parent,
# `a.push(2)` in the task). Under D2 the adopted alias IS the task's copy of the global, so the
# task's own `gl2` reads `[1, 2]`, but the closure it sends back is read by the RECEIVER against
# the receiver's copy of `gl2`: `[1]`. CPython threading and Go see one shared list: `[1, 2]`.
gl2: List[int] = [1]

test fn write_through_spawn_adopted_alias_reads_the_receivers_copy():
    a := gl2
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            a.push(2)
            c.send(fn() -> str: "{gl2}")
    got := c.recv()()
    assert got == "[1]", "received closure read the sender's adopted-alias write: {got}"

# W13-1 neighbours (TICKET-116) — the same shape across container kinds, closure timings and
# forwarding hops. Each received closure reads the receiver's own copy of the global.
gl3: List[List[int]] = [[1]]

test fn element_alias_write_reads_the_receivers_copy():
    inner := gl3[0]
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            inner.push(2)
            c.send(fn() -> str: "{gl3[0]}")
    got := c.recv()()
    assert got == "[1]", "received closure read the sender's element-alias write: {got}"

gl4: List[List[int]] = [[1]]

fn w4(xs: List[int], c: Channel[fn() -> str]):
    xs.push(2)
    c.send(fn() -> str: "{gl4[0]}")

test fn spawn_arg_alias_write_reads_the_receivers_copy():
    c := Channel[fn() -> str](1)
    parallel:
        spawn w4(gl4[0], c)
    got := c.recv()()
    assert got == "[1]", "received closure read the sender's spawn-arg alias write: {got}"

struct P116:
    n: int

gm116: Map[str, P116] = {"k": P116(1)}

test fn struct_in_map_alias_write_reads_the_receivers_copy():
    p := gm116["k"]
    c := Channel[fn() -> int](1)
    parallel:
        spawn:
            p.n = 5
            c.send(fn() -> int: gm116["k"].n)
    got := c.recv()()
    assert got == 1, "received closure read the sender's struct-alias write: {got}"

gl5: List[int] = [1]

test fn closure_built_before_the_alias_push_reads_the_receivers_copy():
    a := gl5
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            f := fn() -> str: "{gl5}"
            a.push(2)
            c.send(f)
    got := c.recv()()
    assert got == "[1]", "received closure read the sender's push: {got}"

gl6: List[int] = [1]

test fn nested_nursery_send_reads_the_receivers_copy():
    a := gl6
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            a.push(2)
            parallel:
                spawn:
                    c.send(fn() -> str: "{gl6}")
    got := c.recv()()
    assert got == "[1]", "received closure read the sender's nested-nursery write: {got}"

gl8: List[int] = [1]

test fn executor_job_reads_the_receivers_copy():
    r := Channel[str](1)
    ex := Executor()
    parallel:
        spawn:
            a := gl8
            a.push(2)
            ex.submit(fn(): r.send("{gl8}"))
    got := r.recv()
    assert got == "[1]", "executor job read the sender's write: {got}"

gl9: List[int] = [1]

test fn two_hop_closure_reads_the_receivers_copy():
    a := gl9
    c := Channel[fn() -> str](1)
    d := Channel[fn() -> str](1)
    parallel:
        spawn:
            a.push(2)
            c.send(fn() -> str: "{gl9}")
        spawn:
            f := c.recv()
            d.send(f)
    got := d.recv()()
    assert got == "[1]", "two-hop forwarded closure read the sender's write: {got}"

# W13-2 (docs/gaps.md) — a receiver's OWN in-place mutation of a module global is silently
# overwritten by an arriving closure whose sender also mutated it, instead of both writes
# landing. Go (mutex) sees `[1, 9, 2]`, CPython sees `[1, 2, 9]`; either order is acceptable,
# but the receiver's own `9` must never be lost.
g2: List[int] = [1]

fn producer_w13_2(c: Channel[fn() -> str]):
    g2.push(2)
    c.send(fn() -> str: "{g2}")

test fn receiver_own_write_survives_arriving_closure_write():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2(c)
        g2.push(9)
    f := c.recv()
    got := "{f()} {g2}"
    assert 9 in g2, "receiver's own write to the global was lost: {got}"

# W13-2 neighbours (TICKET-116) — the receiver's own in-place write must survive an arriving
# closure's install, across write shapes, sibling receivers, and the pre-nursery control that must
# stay clean.
g18: List[int] = [1, 0]

fn producer_w13_2_index(c: Channel[fn() -> str]):
    g18.push(2)
    c.send(fn() -> str: "{g18}")

test fn receiver_index_assign_survives_arriving_closure():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2_index(c)
        g18[1] = 9
    f := c.recv()
    got := "{f()} {g18}"
    assert g18[1] == 9, "receiver's own index write was lost: {got}"

struct Q116:
    a: int
    b: int

g22: Q116 = Q116(0, 0)

fn producer_w13_2_field(c: Channel[fn() -> str]):
    g22.a = 2
    c.send(fn() -> str: "{g22.a}")

test fn receiver_field_write_survives_arriving_closure():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2_field(c)
        g22.b = 9
    f := c.recv()
    got := "{f()} {g22.a} {g22.b}"
    assert g22.b == 9, "receiver's own field write was lost: {got}"

g21: List[int] = [1]

fn producer_w13_2_sibling(c: Channel[fn() -> str]):
    g21.push(2)
    c.send(fn() -> str: "{g21}")

fn consumer_w13_2_sibling(c: Channel[fn() -> str], r: Channel[str]):
    g21.push(9)
    f := c.recv()
    r.send("{f()} {g21}")

test fn sibling_task_receiver_own_write_survives():
    c := Channel[fn() -> str](1)
    r := Channel[str](1)
    parallel:
        spawn producer_w13_2_sibling(c)
        spawn consumer_w13_2_sibling(c, r)
    got := r.recv()
    assert "9" in got, "sibling receiver's own write was lost: {got}"

g20: List[int] = [1]

fn producer_w13_2_control(c: Channel[fn() -> str]):
    g20.push(2)
    c.send(fn() -> str: "{g20}")

# TICKET-137 — the receiver's `9` is pushed BEFORE the nursery, so it is in the task's snapshot
# and in the receiver's own copy; the sender's `2` lands only in the sender's copy. The received
# closure reads the receiver's `[1, 9]`. (Its nursery is not the first the VM opens — every test
# above it already opened one — so it also covers a re-snapshot after earlier nurseries.)
test fn receiver_push_before_the_nursery_is_in_the_receivers_copy():
    g20.push(9)
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2_control(c)
    f := c.recv()
    got := f()
    assert got == "[1, 9]", "received closure read {got}, expected the receiver's [1, 9]"
    assert "{g20}" == "[1, 9]", "receiver's own copy read {g20}"

