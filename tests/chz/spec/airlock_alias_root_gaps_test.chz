# TICKET-105 (docs/gaps.md W12-6) — the airlock carries a module global only when the
# crossing closure names the global itself. A write through a LOCAL ALIAS of the global
# (`xs := g; xs.push(2)`) or a callee PARAM ALIAS (`fn add(xs): xs.push(2)`) is not carried by
# a crossing closure: the write reaches no op that names the global, so it is lost across the
# airlock. CPython threading and Go both see one shared object through the alias.
# TICKET-111 (docs/gaps.md W12-5) — even where TICKET-105's mechanism carries a changed global,
# a task-local alias of it crosses as its OWN copy, separate from the module snapshot's copy:
# the two diverge instead of denoting one object. Source at 40b9a276.
# TICKET-111 also covers a whole-global alias, a struct inside a global Map, and a global generator.
import std.concurrency

gl: List[List[int]] = [[1]]

test fn local_alias_of_global_element_is_not_a_second_copy():
    inner := gl[0]
    r := Channel[str](1)
    parallel:
        spawn:
            inner.push(2)
            r.send("{inner} {gl[0]}")
    got := r.recv()
    assert got == "[1, 2] [1, 2]", "alias/global diverged: {got}"

g: List[int] = [1]

fn producer_alias(c: Channel[fn() -> str]):
    xs := g
    xs.push(2)
    c.send(fn() -> str: "{g}")

test fn write_through_local_alias_of_global_is_carried():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_alias(c)
    f := c.recv()
    got := f()
    assert got == "[1, 2]", "write through local alias lost: {got}"

h: List[int] = [1]

fn add(xs: List[int]):
    xs.push(2)

fn producer_param(c: Channel[fn() -> str]):
    add(h)
    c.send(fn() -> str: "{h}")

test fn write_through_param_alias_of_global_is_carried():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_param(c)
    f := c.recv()
    got := f()
    assert got == "[1, 2]", "write through param alias lost: {got}"

gw: List[List[int]] = [[1]]

test fn local_alias_of_a_whole_global_is_not_a_second_copy():
    a := gw
    r := Channel[str](1)
    parallel:
        spawn:
            a[0].push(2)
            r.send("{a} {gw}")
    got := r.recv()
    assert got == "[[1, 2]] [[1, 2]]", "whole alias diverged: {got}"

struct P:
    n: int

gm: Map[str, P] = {"k": P(1)}

test fn local_alias_of_a_struct_in_a_global_map_is_not_a_second_copy():
    k := "k"
    p := gm[k]
    r := Channel[str](1)
    parallel:
        spawn:
            p.n = 5
            r.send("{p.n} {gm[k].n}")
    got := r.recv()
    assert got == "5 5", "struct alias diverged: {got}"

fn count3() -> Iterator[int]:
    yield 1
    yield 2
    yield 3

gg: List[Iterator[int]] = [count3()]

test fn local_alias_of_a_global_generator_is_one_generator():
    it := gg[0]
    r := Channel[str](1)
    parallel:
        spawn:
            a := it.next()
            b := gg[0].next()
            r.send("{a} {b}")
    got := r.recv()
    assert got == "Some(1) Some(2)", "generator alias is two live copies: {got}"

# W13-1 (docs/gaps.md) — a spawn-ADOPTED alias of a module global (`a := gl` in the parent,
# `a.push(2)` in the task) is not carried by a closure the task sends back: the closure
# reads the module global's own snapshot, which never saw the write through the adopted alias.
# CPython threading and Go both see one shared object through the alias: `[1, 2]`.
gl2: List[int] = [1]

test fn write_through_spawn_adopted_alias_of_global_is_carried():
    a := gl2
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            a.push(2)
            c.send(fn() -> str: "{gl2}")
    got := c.recv()()
    assert got == "[1, 2]", "write through spawn-adopted alias lost: {got}"

# W13-1 neighbours (TICKET-116) — the same shape across container kinds, closure timings and
# forwarding hops. All must reach the ancestor answer once the home module faults at MakeClosure.
gl3: List[List[int]] = [[1]]

test fn element_alias_write_in_task_is_carried():
    inner := gl3[0]
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            inner.push(2)
            c.send(fn() -> str: "{gl3[0]}")
    got := c.recv()()
    assert got == "[1, 2]", "element alias write lost: {got}"

gl4: List[List[int]] = [[1]]

fn w4(xs: List[int], c: Channel[fn() -> str]):
    xs.push(2)
    c.send(fn() -> str: "{gl4[0]}")

test fn spawn_arg_alias_write_is_carried():
    c := Channel[fn() -> str](1)
    parallel:
        spawn w4(gl4[0], c)
    got := c.recv()()
    assert got == "[1, 2]", "spawn-arg alias write lost: {got}"

struct P116:
    n: int

gm116: Map[str, P116] = {"k": P116(1)}

test fn struct_in_map_alias_write_is_carried():
    p := gm116["k"]
    c := Channel[fn() -> int](1)
    parallel:
        spawn:
            p.n = 5
            c.send(fn() -> int: gm116["k"].n)
    got := c.recv()()
    assert got == 5, "struct-in-map alias write lost: {got}"

gl5: List[int] = [1]

test fn closure_built_before_the_alias_push_is_carried():
    a := gl5
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            f := fn() -> str: "{gl5}"
            a.push(2)
            c.send(f)
    got := c.recv()()
    assert got == "[1, 2]", "closure built before the push lost the write: {got}"

gl6: List[int] = [1]

test fn nested_nursery_send_carries_the_alias_write():
    a := gl6
    c := Channel[fn() -> str](1)
    parallel:
        spawn:
            a.push(2)
            parallel:
                spawn:
                    c.send(fn() -> str: "{gl6}")
    got := c.recv()()
    assert got == "[1, 2]", "nested nursery send lost the write: {got}"

gl8: List[int] = [1]

test fn executor_job_sees_the_alias_write():
    r := Channel[str](1)
    ex := Executor()
    parallel:
        spawn:
            a := gl8
            a.push(2)
            ex.submit(fn(): r.send("{gl8}"))
    got := r.recv()
    assert got == "[1, 2]", "executor job lost the write: {got}"

gl9: List[int] = [1]

test fn two_hop_closure_carries_the_alias_write():
    a := gl9
    c := Channel[fn() -> str](1)
    d := Channel[fn() -> str](1)
    parallel:
        spawn:
            a.push(2)
            c.send(fn() -> str: "{gl9}")
        spawn:
            f := c.recv()
            d.send(f)
    got := d.recv()()
    assert got == "[1, 2]", "two-hop forwarded closure lost the write: {got}"

# W13-2 (docs/gaps.md) — a receiver's OWN in-place mutation of a module global is silently
# overwritten by an arriving closure whose sender also mutated it, instead of both writes
# landing. Go (mutex) sees `[1, 9, 2]`, CPython sees `[1, 2, 9]`; either order is acceptable,
# but the receiver's own `9` must never be lost.
g2: List[int] = [1]

fn producer_w13_2(c: Channel[fn() -> str]):
    g2.push(2)
    c.send(fn() -> str: "{g2}")

test fn receiver_own_write_survives_arriving_closure_write():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2(c)
        g2.push(9)
    f := c.recv()
    got := "{f()} {g2}"
    assert 9 in g2, "receiver's own write to the global was lost: {got}"

# W13-2 neighbours (TICKET-116) — the receiver's own in-place write must survive an arriving
# closure's install, across write shapes, sibling receivers, and the pre-nursery control that must
# stay clean.
g18: List[int] = [1, 0]

fn producer_w13_2_index(c: Channel[fn() -> str]):
    g18.push(2)
    c.send(fn() -> str: "{g18}")

test fn receiver_index_assign_survives_arriving_closure():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2_index(c)
        g18[1] = 9
    f := c.recv()
    got := "{f()} {g18}"
    assert g18[1] == 9, "receiver's own index write was lost: {got}"

struct Q116:
    a: int
    b: int

g22: Q116 = Q116(0, 0)

fn producer_w13_2_field(c: Channel[fn() -> str]):
    g22.a = 2
    c.send(fn() -> str: "{g22.a}")

test fn receiver_field_write_survives_arriving_closure():
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2_field(c)
        g22.b = 9
    f := c.recv()
    got := "{f()} {g22.a} {g22.b}"
    assert g22.b == 9, "receiver's own field write was lost: {got}"

g21: List[int] = [1]

fn producer_w13_2_sibling(c: Channel[fn() -> str]):
    g21.push(2)
    c.send(fn() -> str: "{g21}")

fn consumer_w13_2_sibling(c: Channel[fn() -> str], r: Channel[str]):
    g21.push(9)
    f := c.recv()
    r.send("{f()} {g21}")

test fn sibling_task_receiver_own_write_survives():
    c := Channel[fn() -> str](1)
    r := Channel[str](1)
    parallel:
        spawn producer_w13_2_sibling(c)
        spawn consumer_w13_2_sibling(c, r)
    got := r.recv()
    assert "9" in got, "sibling receiver's own write was lost: {got}"

g20: List[int] = [1]

fn producer_w13_2_control(c: Channel[fn() -> str]):
    g20.push(2)
    c.send(fn() -> str: "{g20}")

# TICKET-116 (W13-2) review fix — this control's own nursery is NOT the first one the VM opens
# (every test above it already opened one), so it also proves the receive-side guard's boundary
# is the CURRENT snapshot, not the root's frozen first-ever one (review finding on `8cff19c2`).
test fn receiver_push_before_the_nursery_still_merges():
    g20.push(9)
    c := Channel[fn() -> str](1)
    parallel:
        spawn producer_w13_2_control(c)
    f := c.recv()
    got := f()
    assert "{g20}" == "[1, 9, 2]", "pre-nursery push stopped merging: {got} {g20}"

