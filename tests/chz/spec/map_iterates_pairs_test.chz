# tests/chz/spec/map_iterates_pairs_test.chz — a Map iterates (key, value) pairs and satisfies
# Iterable[(K, V)] (TICKET-257, owner U9). Keys are m.keys(); membership stays the key.

fn pairs(xs: Iterable[(str, int)]) -> int:
    t := 0
    for k, v in xs:
        t += v + k.len()
    return t

test fn a_comprehension_over_a_map_gives_pairs():
    assert [kv for kv in {"a": 1}] == [("a", 1)]

test fn list_of_a_map_gives_pairs():
    assert List({"a": 1}) == [("a", 1)]

test fn two_names_unpack_each_pair():
    m := {"a": 1, "b": 2}
    total := 0
    for k, v in m:
        total += v + k.len()
    assert total == 5

test fn one_name_binds_the_pair():
    m := {"a": 1}
    for kv in m:
        assert kv == ("a", 1)

test fn map_of_a_map_round_trips():
    m := {"a": 1, "b": 2}
    assert Map(m) == m

test fn a_tuple_key_stays_one_value():
    m := {(1, 2): "x"}
    assert [kv for kv in m] == [((1, 2), "x")]
    for k, v in m:
        assert k == (1, 2)
        assert v == "x"

test fn a_map_passes_where_iterable_of_pairs_is_asked():
    assert pairs({"ab": 1}) == 3

test fn keys_are_m_keys_and_membership_is_the_key():
    m := {"a": 1}
    assert m.keys() == ["a"]
    assert "a" in m

test fn a_body_that_mutates_the_map_does_not_disturb_the_snapshot():
    m := {"a": 1, "b": 2}
    seen := 0
    for k, v in m:
        m[k + "x"] = v
        seen += 1
    assert seen == 2
    assert m.len() == 4
