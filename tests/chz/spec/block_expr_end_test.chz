# TICKET-249: indentation ends a block expression. The line after a `match` / `recover:` value is a
# new statement or a new arm, whatever its first token. Ancestor values (run): Rust prints
# `-1` in its present-value wrapper, `10 20 30 40`, `a b c` and `division by zero` in its error
# wrapper; CPython prints `True` for `callable(f)`.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

struct Ctr:
    v: int
    fn bump(self) -> int:
        self.v += 1
        return self.v

fn opt(n: int) -> int?:
    if n == 0: return None
    return n

test fn some_arm_after_a_nested_match_arm_runs():
    fn f(n: int, m: int) -> int:
        r: int? = match opt(n):
            None: match m:
                1: opt(10)
                _: opt(0)
            ?_: opt(1)
        return r ?? -1
    assert f(0, 1) == 10
    assert f(0, 2) == -1
    assert f(7, 2) == 1

test fn some_arm_after_a_nested_recover_arm_runs():
    fn f(n: int, m: int) -> str:
        q := 0
        r := match opt(n):
            None: recover:
                q = 10 / m
            ?_: recover:
                q = 77
        match r:
            !e: return e.message()
            _: return "ok {q}"
    assert f(0, 0) == "division by zero"
    assert f(0, 5) == "ok 2"
    assert f(3, 5) == "ok 77"

test fn parenthesized_line_after_a_match_value_is_a_statement():
    c := Ctr(0)
    n := 1
    k := match n:
        1: 2
        _: 3
    (c.bump())
    assert c.v == 1
    assert k == 2

test fn tuple_and_negative_arms_after_a_nested_match_arm():
    fn f(t: (int, int)) -> str:
        r := match t:
            (0, y): match y:
                1: "a"
                _: "b"
            (x, _): "c"
        return r
    fn g(n: int, m: int) -> int:
        r := match n:
            0: match m:
                1: 10
                _: 20
            -1: 30
            _: 40
        return r
    assert f((0, 1)) == "a"
    assert f((0, 2)) == "b"
    assert f((5, 5)) == "c"
    assert g(0, 1) == 10
    assert g(0, 5) == 20
    assert g(-1, 0) == 30
    assert g(7, 0) == 40

test fn negative_arm_after_an_inline_statement_arm():
    fn f(n: int, m: int) -> int:
        match n:
            0: _x := match m:
                1: 10
                _: 20
            -1: return 30
            _: return 40
        return -1
    assert f(0, 1) == -1
    assert f(-1, 1) == 30
    assert f(5, 0) == 40

test fn negative_literal_line_after_a_nested_recover():
    fn f() -> int:
        n := 0
        r := recover:
            _y := recover:
                n = 1
            -1
            n = 2
        match r:
            !_: return -9
            _: return n
    assert f() == 2

test fn else_after_an_inline_wait_arm_block_is_the_waits():
    fn drain(ch: Channel[int]) -> int:
        n := 0
        q := 0
        while true:
            wait:
                v := ch.recv(): _r := recover:
                    d := v else: panic("ch closed")
                    q = 10 / d
                else: break
            n += 1
        return n
    ch := Channel[int](3)
    ch.send(1)
    ch.send(0)
    ch.send(2)
    assert drain(ch) == 3

test fn else_after_an_inline_if_return_block_is_the_ifs():
    fn f(n: int) -> int:
        if n > 0: return match n:
            1: 10
            _: 20
        else:
            return 3
    assert f(1) == 10
    assert f(5) == 20
    assert f(0) == 3

test fn else_after_an_inline_if_let_block_is_the_ifs():
    fn h(n: int) -> int:
        if n > 0: _x := match n:
            1: opt(1)
            _: opt(0)
        else:
            return 3
        return 0
    assert h(1) == 0
    assert h(5) == 0
    assert h(0) == 3
