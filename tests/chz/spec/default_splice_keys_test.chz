# tests/chz/spec/default_splice_keys_test.chz — W7-49: a default-parameter expression is SPLICED
# into every caller that omits it, so the three checker→compiler side tables (the keyword-argument
# permutation, the `?.` lowering, the static witness) see ONE source position compiled many times.
#
# The cross-MODULE aliasing the fix actually closes is inherently multi-file, so it is pinned in
# `src/vm/tests.rs` (`a_spliced_default_does_not_alias_the_callers_keyword_call` and its carrier /
# witness siblings). What lives here is the other half: the two guards that shipped with the fix
# both have an OVER-fire mode, and neither over-fire is visible to the suite that passed before
# them (project memory, "a widening is untested by its own suite" — a guard that starts REJECTING
# is structurally untested by the tests that already passed).
#
#   • The compiler now hard-errors on a MISSING keyword permutation instead of falling through to a
#     positional `Op::Call(args.len())` that silently DROPPED every named argument. The one path
#     that deliberately leaves `named` populated with no table entry is `print(sep=…, end=…)`, so
#     that must still compile and run.
#   • The checker now refuses to OVERWRITE a side-table key already bound to a DIFFERENT value. It
#     compares VALUES, never mere presence: two call sites omitting the SAME default re-insert the
#     same decision under the same key, which is normal and benign. A presence-checking guard would
#     reject every program with a same-module default — i.e. most of this file.
#
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

fn ab(a: int, b: int) -> int:
    return a * 100 + b

g := ab

fn geto() -> Option[str]:
    return Some("abc")

# A keyword call INSIDE a default (a `KeywordTable` entry recorded from a spliced clone), and a `?.`
# carrier inside a default over BOTH carrier kinds (two `CarrierTable` entries, one per mode).
fn kw_default(x: int = g(a=7, b=9)) -> int:
    return x

fn opt_default(x: Option[int] = geto()?.len()) -> int:
    match x:
        Some(n): return n
        None: return -1

test fn the_same_default_omitted_at_two_call_sites():
    # Two splices of one default → the same key, the same permutation. Benign, and the case a
    # presence-checking backstop would have rejected.
    assert kw_default() == 709, "got {kw_default()}"
    assert kw_default() == 709, "the second splice must resolve identically"
    # …and supplying it positionally still bypasses the splice entirely.
    assert kw_default(1) == 1, "got {kw_default(1)}"

test fn a_keyword_call_inside_a_default_binds_by_label_not_position():
    # `g(a=7, b=9)` through a fn VALUE is lowered by the checker-recorded PERMUTATION. If the
    # permutation were dropped (the old missing-entry fall-through) the args would go in source
    # order — which is the same order here, so pin the reversed spelling too, where they differ.
    assert kw_default() == ab(7, 9), "label binding must match the positional call"
    r := g(b=9, a=7)
    assert r == 709, "reversed labels must still fill a=7, b=9 — got {r}"

test fn a_carrier_inside_a_default_over_both_kinds():
    # Option mode: `geto()?.len()` is `Some(3)`.
    assert opt_default() == 3, "got {opt_default()}"
    assert opt_default(Some(9)) == 9, "an explicit argument bypasses the splice"
    assert opt_default(None) == -1, "got {opt_default(None)}"
    # W7-51 — the Result-MODE carrier that used to sit here (`x: int = getr()?.len()`, omitted from
    # an `int!str` caller so the `?` early-returned out of the CALLER) is now a compile error: a
    # default is compiled once, in its defining module, which has no caller frame to propagate into.
    # The rejection is pinned in `src/checker/tests.rs`
    # (`a_try_inside_a_default_is_rejected_with_the_defining_module_reason`); the Option-mode carrier
    # above is unaffected, which is the whole distinction.

test fn print_keyword_arguments_still_compile():
    # The keyword-miss guard must NOT fire here: desugar deliberately leaves `named` populated for
    # `print` and the checker records NO permutation, so a presence-blind guard would break every
    # `print(sep=…)` in the corpus. Empty strings keep the suite's own output clean — the guard
    # cares about the call SHAPE, not the values (`print(1, 2, sep="-")` is verified on the CLI).
    print("", "", sep="", end="")
    assert true, "print(sep=, end=) must still compile"
