# TICKET-226 (generics design R4, grid 2): a fn value is (item, type args), and every consumer takes
# every callable kind. Kind {plain fn, method path, `T.m`, `json.decode[T]`, closure,
# native, builtin, extern} x consumer {call, spawn direct callee, spawn argument, Executor.submit,
# submit with a result, channel round trip, == (same site, two sites, two modules, across a spawn), repr,
# global snapshot}. The zero-arg consumers (submit, submit with a result) take the kinds that have a
# zero-arg member: plain, method path, closure, native, extern. A `T.m` and
# `json.decode[T]` always take an argument, and so does every builtin value (`print` as a value is
# `fn(...Any) -> None`, so `ex.submit(print)` is a type error). A closure is one value per
# binding, and a crossing or a Channel rebuilds it (DEC-215), so its only `==` row is same-site.
# The second module is `fn_value_grid_lib.chz`. Go `g := math.Sqrt; go g(9.0)` runs; CPython
# `ex.submit(time.time)` runs; Rust `decode::<i32> == decode::<i32>` is true.
import std.json
import std.math
import std.time
import fn_value_grid_lib
import Executor from std.concurrency
import int32 from std.ffi

extern "libm":
    fn cos(x: float) -> float

extern "libc":
    fn getpid() -> int32

struct P:
    n: int
    fn mk(n: int) -> P:
        return P(n)
    fn zero() -> int:
        return 0

protocol Named:
    fn name(self) -> str

struct N:
    s: str
    fn name(self) -> str:
        return self.s

fn plain(n: int) -> int:
    return n

fn plain0() -> int:
    return 7

fn tm[T: Named]() -> fn(T) -> str:
    return T.name

GP := plain
GM := P.mk
GD := json.decode[int]
GN := math.sqrt
GB := ord
GX := cos

fn cell(bad: List[str], name: str, ok: bool):
    if not ok:
        bad.push(name)

fn ran[T](bad: List[str], name: str, r: T!):
    match r:
        ?_:
            pass
        !e:
            bad.push(name + ": " + e.message())

fn isok[T](r: T!) -> bool:
    match r:
        ?_:
            return true
        !_:
            return false

fn via[A, R](f: fn(A) -> R, a: A, out: Channel[R]):
    out.send(f(a))

fn run_in[A, R](f: fn(A) -> R, a: A):
    parallel:
        spawn f(a)

test fn grid_call():
    bad: List[str] = []
    a := plain
    cell(bad, "plain", a(2) == 2)
    b := P.mk
    cell(bad, "method path", b(3).n == 3)
    cell(bad, "T.m", tm[N]()(N("x")) == "x")
    d := json.decode[int]
    cell(bad, "json.decode[T]", d("5") == ?5)
    k := 1
    cl := fn(n: int) -> int: n + k
    cell(bad, "closure", cl(1) == 2)
    g := math.sqrt
    cell(bad, "native", g(9.0) == 3.0)
    o := ord
    cell(bad, "builtin", o("a") == 97)
    x := cos
    cell(bad, "extern", x(0.0) == 1.0)
    assert bad.len() == 0, ", ".join(bad)

test fn grid_spawn_direct_callee():
    bad: List[str] = []
    a := plain
    r := recover: run_in(a, 2)
    ran(bad, "plain", r)
    r := recover: run_in(P.mk, 3)
    ran(bad, "method path", r)
    r := recover: run_in(tm[N](), N("x"))
    ran(bad, "T.m", r)
    r := recover: run_in(json.decode[int], "5")
    ran(bad, "json.decode[T]", r)
    k := 1
    r := recover: run_in(fn(n: int) -> int: n + k, 1)
    ran(bad, "closure", r)
    r := recover: run_in(math.sqrt, 9.0)
    ran(bad, "native", r)
    r := recover: run_in(ord, "a")
    ran(bad, "builtin", r)
    r := recover: run_in(cos, 0.0)
    ran(bad, "extern", r)
    assert bad.len() == 0, ", ".join(bad)

test fn grid_spawn_argument():
    bad: List[str] = []
    ci := Channel[int](9)
    cp := Channel[P](1)
    cs := Channel[str](2)
    cd := Channel[int!](1)
    cf := Channel[float](2)
    k := 1
    parallel:
        spawn via(plain, 2, ci)
        spawn via(P.mk, 3, cp)
        spawn via(tm[N](), N("x"), cs)
        spawn via(json.decode[int], "5", cd)
        spawn via(fn(n: int) -> int: n + k, 1, ci)
        spawn via(math.sqrt, 9.0, cf)
        spawn via(ord, "a", ci)
        spawn via(cos, 0.0, cf)
    i1 := ci.recv() else: panic("ci closed")
    i2 := ci.recv() else: panic("ci closed")
    i3 := ci.recv() else: panic("ci closed")
    ints := [i1, i2, i3]
    ints.sort()
    cell(bad, "plain, closure, builtin", ints == [2, 2, 97])
    p := cp.recv() else: panic("cp closed")
    cell(bad, "method path", p.n == 3)
    cell(bad, "T.m", cs.recv() == ?"x")
    d := cd.recv() else: panic("cd closed")
    cell(bad, "json.decode[T]", d == ?5)
    f1 := cf.recv() else: panic("cf closed")
    f2 := cf.recv() else: panic("cf closed")
    floats := [f1, f2]
    floats.sort()
    cell(bad, "native, extern", floats == [1.0, 3.0])
    assert bad.len() == 0, ", ".join(bad)

test fn grid_executor_submit():
    bad: List[str] = []
    k := 1
    r := recover: Executor().submit(plain0)
    ran(bad, "plain", r)
    r := recover: Executor().submit(P.zero)
    ran(bad, "method path", r)
    r := recover: Executor().submit(fn() -> int: k)
    ran(bad, "closure", r)
    r := recover: Executor().submit(time.now_ms)
    ran(bad, "native", r)
    r := recover: Executor().submit(getpid)
    ran(bad, "extern", r)
    assert bad.len() == 0, ", ".join(bad)

test fn grid_submit_value():
    bad: List[str] = []
    ex := Executor()
    k := 1
    cell(bad, "plain", ex.submit(plain0).get() == ?7)
    cell(bad, "method path", ex.submit(P.zero).get() == ?0)
    cell(bad, "closure", ex.submit(fn() -> int: k).get() == ?1)
    cell(bad, "native", isok(ex.submit(time.now_ms).get()))
    cell(bad, "extern", isok(ex.submit(getpid).get()))
    ex.shutdown()
    assert bad.len() == 0, ", ".join(bad)

test fn grid_channel_round_trip():
    bad: List[str] = []
    c1 := Channel[fn(int) -> int](1)
    c1.send(plain)
    g1 := c1.recv() else: panic("c1 closed")
    cell(bad, "plain", g1 == plain)
    c2 := Channel[fn(int) -> P](1)
    c2.send(P.mk)
    g2 := c2.recv() else: panic("c2 closed")
    cell(bad, "method path", g2 == P.mk)
    t := tm[N]()
    c4 := Channel[fn(N) -> str](1)
    c4.send(t)
    g4 := c4.recv() else: panic("c4 closed")
    cell(bad, "T.m", g4 == t)
    c5 := Channel[fn(str) -> int!](1)
    c5.send(json.decode[int])
    g5 := c5.recv() else: panic("c5 closed")
    cell(bad, "json.decode[T]", g5 == json.decode[int])
    c6 := Channel[fn(float) -> float](1)
    c6.send(math.sqrt)
    g6 := c6.recv() else: panic("c6 closed")
    cell(bad, "native", g6 == math.sqrt)
    c7 := Channel[fn(str) -> int](1)
    c7.send(ord)
    g7 := c7.recv() else: panic("c7 closed")
    cell(bad, "builtin", g7 == ord)
    c6.send(cos)
    g8 := c6.recv() else: panic("c6 closed")
    cell(bad, "extern", g8 == cos)
    assert bad.len() == 0, ", ".join(bad)

test fn grid_eq_same_site():
    bad: List[str] = []
    cell(bad, "plain", plain == plain)
    cell(bad, "method path", P.mk == P.mk)
    cell(bad, "T.m", tm[N]() == tm[N]())
    cell(bad, "json.decode[T]", json.decode[int] == json.decode[int])
    k := 1
    cl := fn(n: int) -> int: n + k
    cell(bad, "closure", cl == cl)
    cell(bad, "native", math.sqrt == math.sqrt)
    cell(bad, "builtin", ord == ord)
    cell(bad, "extern", cos == cos)
    cell(bad, "decode targets differ", not (json.decode[int] == json.decode[float]))
    assert bad.len() == 0, ", ".join(bad)

test fn grid_eq_two_sites():
    bad: List[str] = []
    a := plain
    cell(bad, "plain", a == plain)
    b := P.mk
    cell(bad, "method path", b == P.mk)
    d := json.decode[int]
    cell(bad, "json.decode[T]", d == json.decode[int])
    g := math.sqrt
    cell(bad, "native", g == math.sqrt)
    o := ord
    cell(bad, "builtin", o == ord)
    x := cos
    cell(bad, "extern", x == cos)
    assert bad.len() == 0, ", ".join(bad)

test fn grid_eq_two_modules():
    bad: List[str] = []
    cell(bad, "json.decode[T]", fn_value_grid_lib.read_decode() == json.decode[int])
    cell(bad, "native", fn_value_grid_lib.read_sqrt() == math.sqrt)
    assert bad.len() == 0, ", ".join(bad)

test fn grid_eq_across_a_spawn():
    bad: List[str] = []
    c1 := Channel[fn(int) -> int](1)
    c2 := Channel[fn(int) -> P](1)
    c5 := Channel[fn(str) -> int!](1)
    c6 := Channel[fn(float) -> float](2)
    c7 := Channel[fn(str) -> int](1)
    parallel:
        spawn:
            c1.send(plain)
            c2.send(P.mk)
            c5.send(json.decode[int])
            c6.send(math.sqrt)
            c7.send(ord)
            c6.send(cos)
    g1 := c1.recv() else: panic("c1 closed")
    cell(bad, "plain", g1 == plain)
    g2 := c2.recv() else: panic("c2 closed")
    cell(bad, "method path", g2 == P.mk)
    g5 := c5.recv() else: panic("c5 closed")
    cell(bad, "json.decode[T]", g5 == json.decode[int])
    g6 := c6.recv() else: panic("c6 closed")
    cell(bad, "native", g6 == math.sqrt)
    g7 := c7.recv() else: panic("c7 closed")
    cell(bad, "builtin", g7 == ord)
    g8 := c6.recv() else: panic("c6 closed")
    cell(bad, "extern", g8 == cos)
    assert bad.len() == 0, ", ".join(bad)

test fn grid_repr():
    bad: List[str] = []
    cell(bad, "plain", "{plain}" == "<fn plain>")
    cell(bad, "json.decode[T]", "{json.decode[int]}" == "<fn json.decode>")
    k := 1
    cell(bad, "closure", "{(fn(n: int) -> int: n + k)}" == "<closure>")
    cell(bad, "native", "{math.sqrt}" == "<native fn sqrt>")
    cell(bad, "builtin", "{ord}" == "<builtin fn ord>")
    cell(bad, "extern", "{cos}" == "<extern fn cos>")
    assert bad.len() == 0, ", ".join(bad)

test fn grid_global_snapshot():
    out := Channel[List[str]](1)
    parallel:
        spawn:
            bad: List[str] = []
            cell(bad, "plain", GP == plain)
            cell(bad, "method path", GM == P.mk)
            cell(bad, "json.decode[T]", GD == json.decode[int])
            cell(bad, "native", GN == math.sqrt)
            cell(bad, "builtin", GB == ord)
            cell(bad, "extern", GX == cos)
            out.send(bad)
    bad := out.recv() else: panic("out closed")
    assert bad.len() == 0, ", ".join(bad)
