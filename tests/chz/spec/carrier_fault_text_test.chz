# TICKET-248: a runtime fault names a `T?` / `T!E` value by its kind in plain words and by the way
# the user writes its type, never as `enum`. Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
test fn a_fault_names_an_optional_as_the_user_writes_it():
    o: int? = ?5
    x: Any = o
    r := recover: bool(x)
    match r:
        !e: assert e.message() == "bool() cannot convert an optional value (`T?`)"
        ?_: assert false

test fn a_fault_names_a_result_as_the_user_writes_it():
    o: int!str = ?5
    x: Any = o
    r := recover: bool(x)
    match r:
        !e: assert e.message() == "bool() cannot convert a result value (`T!E`)"
        ?_: assert false
