# TICKET-124 — the expected-type / untyped-constant widening TICKET-106 wired into one sink now
# reaches its neighbours too: a generic ctor's own expected type, a nested ctor argument, a
# reassignment/index-assign/field-assign target, and a `float`-slot collection-method argument. Every
# assert here reads back a genuine widened value (`str()`, never `/`, per DEC-122's one-member-per-line
# rule for the struct/enum preludes). Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

protocol Named:
    fn name(self) -> str

struct A:
    fn name(self) -> str:
        return "a"

struct Box[T]:
    v: T

struct Pair[T]:
    a: T
    b: T

enum E[T]:
    V(T, T)

fn id[T](x: T) -> T:
    return x

test fn generic_ctor_constants_become_real_floats():
    assert str(Pair(1, 2.5)) == "Pair(a=1.0, b=2.5)"
    r: Pair[float] = Pair(1, 2)
    assert str(r) == "Pair(a=1.0, b=2.0)"
    assert str(Pair[float](1, 2.5)) == "Pair(a=1.0, b=2.5)"
    assert str(E.V(1, 2.5)) == "V(1.0, 2.5)"
    assert str(id[float](1)) == "1.0"

test fn nested_ctor_holds_the_declared_protocol():
    bb: Box[Box[Named]] = Box(Box(A()))
    assert bb.v.v.name() == "a"

test fn reassignment_takes_the_target_type():
    l: List[Named] = [A()]
    l = [A(), A()]
    assert l.len() == 2

struct S:
    f: float
    fn set_one(self):
        self.f = 1

g: float = 1.5

fn set_g():
    g = 1

test fn float_slots_coerce_reassigned_and_pushed_constants():
    x: float = 1.5
    x = 1
    assert str(x) == "1.0"

    set_g()
    assert str(g) == "1.0"

    c: float = 1.5
    fn bump():
        c = 1
    bump()
    assert str(c) == "1.0"

    s := S(2.5)
    s.set_one()
    assert str(s.f) == "1.0"

    xs: List[float] = [1.5]
    xs[0] = 1
    assert str(xs[0]) == "1.0"

    m: Map[str, float] = {}
    m["a"] = 1
    assert str(m["a"]) == "1.0"

    l: List[float] = [1.5]
    l.push(3)
    assert str(l) == "[1.5, 3.0]"
