# TICKET-124 — expected-type PROTOCOL widening: a generic ctor's own expected type reaches a nested
# ctor argument (`Box[Box[Named]] = Box(Box(A()))`), and a reassignment takes the target's declared
# type. Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

protocol Named:
    fn name(self) -> str

struct A:
    fn name(self) -> str:
        return "a"

struct Box[T]:
    v: T

test fn nested_ctor_holds_the_declared_protocol():
    bb: Box[Box[Named]] = Box(Box(A()))
    assert bb.v.v.name() == "a"

test fn reassignment_takes_the_target_type():
    l: List[Named] = [A()]
    l = [A(), A()]
    assert l.len() == 2
