# tests/chz/spec/map_set_test.chz — Map / Set behavior spec, dogfooded with `assert`.
#
# Ported from src/vm/golden_tests.rs (`parity_map_*` / `parity_set_struct_algebra`) and
# src/vm/tests.rs (map/set comprehensions + equality). Run: `cargo run -- test tests/chz/`.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).
#
# Compound-assign / missing-hash fault-path and gc-stress rooting stay in Rust (`recover:` ports a
# missing-key READ fault's message, below — see `missing_key_names_the_key`).

# ---- literal, display, insertion order, dup-key-last-wins ----

test fn literal_and_display():
    assert str({"a": 1, "b": 2}) == "{{'a': 1, 'b': 2}}", "insertion-ordered display ({{ }} = literal braces)"
    assert str({}) == "{{}}"
    assert {"a": 1, "a": 9} == {"a": 9}, "duplicate key -> last wins"

# ---- index read / insert / update / compound-assign ----

test fn index_ops():
    m := {"a": 1, "b": 2}
    assert m["b"] == 2
    m["c"] = 3
    m["a"] = 9
    assert m == {"a": 9, "b": 2, "c": 3}
    m["a"] += 5
    assert m["a"] == 14

# ---- a missing-key read names the key it missed (Python `KeyError: 'zz'` shape) ----

test fn missing_key_names_the_key():
    sm := {"a": 1}
    r1 := recover: sm["zz"]
    match r1:
        Ok(_): assert false, "expected a fault"
        Err(e): assert e.message() == "key not found: 'zz'"

    im := {1: 10}
    r2 := recover: im[99]
    match r2:
        Ok(_): assert false, "expected a fault"
        Err(e): assert e.message() == "key not found: 99"

# ---- methods: len / has / get / keys / values ----

test fn methods():
    m := {"a": 1, "b": 2}
    assert m.len() == 2
    assert m.has("a") == true
    assert m.has("z") == false
    match m.get("a"):
        Some(v): assert v == 1
        None: assert false, "present key"
    match m.get("z"):
        Some(_): assert false, "absent key must be None"
        None: assert true
    assert m.keys() == ["a", "b"]
    assert m.values() == [1, 2]

# ---- remove ----

test fn remove():
    m := {"a": 1, "b": 2}
    match m.remove("a"):
        Some(v): assert v == 1
        None: assert false, "present key returns the value"
    assert m == {"b": 2}
    match m.remove("z"):
        Some(_): assert false, "missing key -> None"
        None: assert true
    assert m == {"b": 2}, "removing a missing key leaves the map unchanged"

# ---- key iteration order + int/bool keys ----

test fn keys_iteration():
    m := {"a": 1, "b": 2, "c": 3}
    out := []
    for k in m.keys():
        out.push(k)
    assert out == ["a", "b", "c"], "insertion order"

test fn int_and_bool_keys():
    assert {1: "x", 2: "y"}[2] == "y"
    assert {true: 1, false: 0}[false] == 0

# ---- equality is order-independent, value-sensitive ----

test fn equality():
    assert ({1: 10, 2: 20} == {2: 20, 1: 10}) == true, "order-independent"
    assert ({1: 10} == {1: 99}) == false, "value-sensitive"
    assert ({1: 10} == {1: 10, 2: 20}) == false, "size-sensitive"

# ---- comprehensions ----

test fn comprehensions():
    assert {x: x * x for x in [1, 2, 3]} == {1: 1, 2: 4, 3: 9}
    m := {"a": 1, "b": 2}
    assert {k: v * 10 for k, v in m} == {"a": 10, "b": 20}
    assert {x % 3 for x in [0, 1, 2, 3, 4, 5]} == {0, 1, 2}, "set comprehension dedupes"

# ---- Hashable struct keys + set algebra ----

struct P:
    x: int
    y: int = 0
    fn hash(self) -> int:
        return self.x * 31 + self.y

test fn struct_key_map():
    m: Map[P, str] = {}
    m[P(1, 2)] = "a"
    m[P(3, 4)] = "b"
    m[P(1, 2)] = "z"                    # structurally-equal key updates in place
    assert m.len() == 2
    assert m[P(3, 4)] == "b"
    assert m.has(P(1, 2)) == true
    assert m.has(P(9, 9)) == false
    match m.get(P(3, 4)):
        Some(v): assert v == "b"
        None: assert false, "present"
    match m.remove(P(1, 2)):
        Some(v): assert v == "z", "last write wins"
        None: assert false, "present"
    assert m.len() == 1

test fn struct_set_algebra():
    a: Set[P] = Set([P(1), P(2), P(2), P(3)])   # P(2) deduped by hash
    b: Set[P] = Set([P(2), P(3), P(4)])
    assert a.len() == 3
    assert a.union(b).len() == 4
    assert a.intersection(b).len() == 2
    assert a.difference(b).len() == 1
    assert a.has(P(2)) == true
    a.remove(P(2))
    assert a.has(P(2)) == false

# ---- cyclic-key equality faults recoverably (matches `==` / Python RecursionError) ----
# A struct with a custom `hash` used as a Set/Map key that holds a genuine reference cycle:
# container membership / key-equality is DEFINED by `==`, so it must fault the SAME way `==`
# does (structural-depth cap) instead of silently swallowing the fault into a wrong `false`.

struct Cyc:
    x: int
    next: List[Cyc] = []
    fn hash(self) -> int:
        return self.x

fn assert_depth_fault[T](r: Result[T, Error], where_: str):
    match r:
        Ok(_): assert false, where_ + " must fault on a cyclic key"
        Err(e): assert e.message().contains("maximum structural depth"), where_ + ": " + e.message()

test fn cyclic_key_faults_everywhere():
    # two DISTINCT self-cyclic keys with the same hash (x=1) -> a candidate collision that
    # forces a structural `==` that never terminates -> the depth cap fires (recoverable).
    a1 := Cyc(1)
    a1.next.push(a1)
    a2 := Cyc(1)
    a2.next.push(a2)
    # sanity: `==` itself faults (the behavior we are matching)
    r := recover: a1 == a2
    assert_depth_fault(r, "==")
    # Set.has / `in` / Set([...]) collide-construct / add
    s := Set([a1])
    r := recover: s.has(a2)
    assert_depth_fault(r, "Set.has")
    r := recover: (a2 in s)
    assert_depth_fault(r, "in Set")
    r := recover: Set([a1, a2])
    assert_depth_fault(r, "Set([...]) construct")
    r := recover: s.add(a2)
    assert_depth_fault(r, "Set.add")
    # set algebra (operator + method forms must both fault)
    r := recover: (Set([a1]) | Set([a2]))
    assert_depth_fault(r, "Set |")
    r := recover: Set([a1]).union(Set([a2]))
    assert_depth_fault(r, "Set.union")
    r := recover: Set([a1]).difference(Set([a2]))
    assert_depth_fault(r, "Set.difference")
    # Map: collide-construct / get / insert / `in` / remove
    m: Map[Cyc, int] = {}
    m[a1] = 1
    r := recover: m[a2]
    assert_depth_fault(r, "Map get")
    r := recover: m.has(a2)
    assert_depth_fault(r, "Map.has")
    r := recover: (a2 in m)
    assert_depth_fault(r, "in Map")
    n: Map[Cyc, int] = {}
    n[a1] = 1
    r := recover: n.remove(a2)
    assert_depth_fault(r, "Map.remove")
    p: Map[Cyc, int] = {}
    p[a1] = 1
    r := recover: assign_map(p, a2)
    assert_depth_fault(r, "Map insert")
    # List membership / index
    r := recover: [a1].contains(a2)
    assert_depth_fault(r, "List.contains")
    r := recover: [a1].index_of(a2)
    assert_depth_fault(r, "List.index_of")

fn assign_map(m: Map[Cyc, int], k: Cyc):
    m[k] = 2

# ---- positive controls: non-cyclic keys stay byte-identical (no new fault) ----

test fn noncyclic_controls():
    # plain scalars
    assert Set([1, 2, 3]).has(2) == true
    assert Set([1, 2, 3]).has(9) == false
    assert {"a": 1}["a"] == 1
    assert [1, 2, 3].contains(2) == true
    assert [1, 2, 3].index_of(2) == 1
    # non-cyclic Cyc keys (empty `next`) still work across Set/Map ops
    k1 := Cyc(1)
    k2 := Cyc(2)
    s: Set[Cyc] = Set([k1, k2])
    assert s.has(Cyc(1)) == true
    assert s.has(Cyc(9)) == false
    s.add(Cyc(3))
    assert s.len() == 3
    s.remove(Cyc(1))
    assert s.has(Cyc(1)) == false
    m: Map[Cyc, int] = {}
    m[Cyc(1)] = 10
    m[Cyc(1)] = 20
    assert m.has(Cyc(1)) == true
    assert m[Cyc(1)] == 20
    match m.remove(Cyc(1)):
        Some(v): assert v == 20
        None: assert false, "present"
