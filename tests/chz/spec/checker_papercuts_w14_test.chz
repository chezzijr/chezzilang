# TICKET-142 (W14-33): two checker papercuts, RUN end to end.
#  - `Channel(1)` takes its element type from the let annotation (as `l: List[float] = []` does).
#  - a nested `fn`'s default parameter applies at its call sites and through a value alias.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

test fn channel_element_type_from_annotation():
    ch: Channel[float] = Channel(1)
    ch.send(1.5)
    assert ch.recv() == 1.5

test fn nested_fn_default_applies():
    fn f(x: int = 3) -> int:
        return x
    assert f() == 3
    assert f(4) == 4
    h := f
    assert h(5) == 5

# A nested default is evaluated in MODULE scope, so it may read a module-level binding.
K := 7

test fn nested_fn_default_reads_module_global():
    fn f(x: int = K, y: int = 2) -> int:
        return x + y
    assert f() == 9
    assert f(1) == 3
    assert f(1, 1) == 2
    g := f
    assert g() == 9
    assert g(1) == 3

test fn nested_fn_default_is_fresh_per_call():
    fn push(v: int, xs: List[int] = []) -> int:
        xs.push(v)
        return xs.len()
    assert push(1) == 1
    assert push(2) == 1

test fn nested_fn_default_recursive():
    fn f(n: int, acc: int = 0) -> int:
        if n == 0:
            return acc
        return f(n - 1, acc + n)
    assert f(4) == 10
