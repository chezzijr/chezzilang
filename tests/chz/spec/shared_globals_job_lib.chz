# The module `shared_globals_test.chz` reaches first: two Executor jobs submitted at its own top
# level, each waiting for a closure from a module that initializes LATER (M3.1 fix round 1).
import Executor, Task from std.concurrency

CH1 := Channel[fn() -> int](1)
CH2 := Channel[fn() -> int](1)

fn job1() -> int:
    f := CH1.recv() else: panic("CH1 closed")
    return f()

fn job2() -> int:
    f := CH2.recv() else: panic("CH2 closed")
    return f()

EX := Executor()
T1: Task[int] = EX.submit(job1)
T2: Task[int] = EX.submit(job2)
