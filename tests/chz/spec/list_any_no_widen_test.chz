# tests/chz/spec/list_any_no_widen_test.chz -- a `List[Any]` annotation keeps int elements.
#
# `Any` is the EMPTY top protocol, not a numeric type, so the element stays an `int`, exactly as
# CPython's `[1, 3.0]` keeps it. D3 (TICKET-138): an int never widens into a `float` slot either, so
# the `List[float]` slots below are written `1.0`.
#
# `Any` carries no methods, so an element cannot be interrogated directly; `str()` of the whole list
# is the observable that separates `1` from `1.0`.

test fn list_any_keeps_int_element():
    xs: List[Any] = [1, 3.0]
    assert str(xs) == "[1, 3.0]", "List[Any] must not widen the int (CPython prints [1, 3.0])"

test fn list_any_keeps_int_element_float_first():
    xs: List[Any] = [3.0, 1]
    assert str(xs) == "[3.0, 1]"

test fn list_float_annotation_takes_float_literals():
    ys: List[float] = [1.0, 3.0]
    assert str(ys) == "[1.0, 3.0]"

test fn list_any_homogeneous_and_non_numeric_unchanged():
    a: List[Any] = [1, 2]
    assert str(a) == "[1, 2]"
    b: List[Any] = [1, "a"]
    assert str(b) == "[1, 'a']"
    c: List[Any] = [1, 3.0, "a"]
    assert str(c) == "[1, 3.0, 'a']"

# --- the SLOT, not the `let`: every position an expected `List[Any]` reaches a literal ---

fn take_any(xs: List[Any]) -> str:
    return str(xs)

fn vari_any(...xs: Any) -> str:
    return str(xs)

fn ret_any() -> List[Any]:
    return [1, 3.0]

fn take_float(xs: List[float]) -> str:
    return str(xs)

fn vari_float(...xs: float) -> str:
    return str(xs)

fn ret_float() -> List[float]:
    return [1.0, 3.0]

struct AnyBox:
    v: List[Any]

test fn list_any_call_argument_keeps_int_element():
    assert take_any([1, 3.0]) == "[1, 3.0]"

test fn variadic_any_pack_keeps_int_element():
    # `...xs: Any` desugars to a synthesized `List` literal at the variadic slot, so it is the same
    # site as the call argument above -- and must answer the same.
    assert vari_any(1, 3.0) == "[1, 3.0]"

test fn list_any_return_keeps_int_element():
    assert str(ret_any()) == "[1, 3.0]"

test fn list_any_struct_ctor_argument_keeps_int_element():
    b := AnyBox([1, 3.0])
    assert str(b.v) == "[1, 3.0]"

test fn list_float_slots_all_take_float_literals():
    assert take_float([1.0, 3.0]) == "[1.0, 3.0]"
    assert vari_float(1.0, 3.0) == "[1.0, 3.0]"
    assert str(ret_float()) == "[1.0, 3.0]"

test fn list_any_slots_homogeneous_and_non_numeric_unchanged():
    assert take_any([1, 2]) == "[1, 2]"
    assert take_any([1, "a"]) == "[1, 'a']"

test fn alias_of_any_element_keeps_int_element():
    # The slot is judged on its RESOLVED type, so an alias spelling of the top type decides the same
    # way the bare one does.
    xs: List[AnyAlias] = [1, 3.0]
    assert str(xs) == "[1, 3.0]"

type AnyAlias = Any

# --- The synthesized variadic pack has no source text of its own, so it carries the CALL's span --
# and a pipe gives every link of `a |> f() |> g()` the LHS primary's span. Each test below asserts
# the piped form equals the form it desugars to.

fn vari_head_float(xs: List[float], ...rest: Any) -> float:
    return xs[0] / 2

fn vari_any_tail_float(a: str, ...ys: float) -> str:
    return a + "|" + str(ys)

test fn piped_variadic_pack_does_not_alias_the_piped_literal():
    assert ([1.0, 3.0] |> vari_any(2.5, 1)) == vari_any([1.0, 3.0], 2.5, 1)
    assert ([1.0, 3.0] |> vari_any(2.5, 1)) == "[[1.0, 3.0], 2.5, 1]"

test fn piped_literal_into_a_typed_first_param_takes_floats():
    assert ([1.0, 3.0] |> vari_head_float(2.5, 1)) == vari_head_float([1.0, 3.0], 2.5, 1)
    assert ([1.0, 3.0] |> vari_head_float(2.5, 1)) == 0.5

test fn two_variadic_packs_in_one_pipe_chain_do_not_alias():
    piped := [1.0, 3.0] |> vari_any(2.5, 7) |> vari_any_tail_float(1.0, 2.0)
    assert piped == vari_any_tail_float(vari_any([1.0, 3.0], 2.5, 7), 1.0, 2.0)
    assert piped == "[[1.0, 3.0], 2.5, 7]|[1.0, 2.0]"

test fn list_any_slot_reaches_an_if_arm_literal():
    # An `if`/`match` ARM inherits the expected hint, so a `List[Any]` slot reaches the arm literal
    # and it keeps its ints like any other `List[Any]` literal.
    assert take_any(if true: [1, 3.0] else: [2, 4.0]) == "[1, 3.0]"
    s: Any = if true: 1 else: 2.0
    assert str(s) == "1"
