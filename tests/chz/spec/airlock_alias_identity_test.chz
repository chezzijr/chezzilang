# TICKET-100 — the airlock's cross-heap copy is identity-preserving: one source object stays one
# object per crossing, for containers as well as cells (`b := a` inside a task means the same thing it
# means outside one). `outer := [inner, inner]` holds ONE list reached twice.
# TICKET-169 (D4 layer C) supersedes the write half: a spawned task's write to that copy, through
# EITHER alias, now faults instead of silently landing (and silently being visible through the other
# alias). Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

test fn container_alias_write_through_one_alias_faults():
    inner := [1]
    outer := [inner, inner]
    r := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                outer[0].push(99)
            match res:
                Ok(_): r.send("no-fault")
                Err(e): r.send(e.message())
    got := r.recv()
    assert got.starts_with("this value is this task's copy:"), got

struct Box:
    n: int

test fn struct_alias_write_through_one_alias_faults():
    box := Box(1)
    pair := [box, box]
    r := Channel[str](1)
    parallel:
        spawn:
            res := recover:
                pair[0].n = 9
            match res:
                Ok(_): r.send("no-fault")
                Err(e): r.send(e.message())
    got := r.recv()
    assert got.starts_with("this value is this task's copy:"), got
