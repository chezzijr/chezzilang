# TICKET-175: `import a.b` also binds the Python full path `a.b.X`, and `import b from a` binds `b`.
# Ancestor: CPython `import os.path` then `os.path.join('a', 'b')` -> `a/b`.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

import std.math

test fn std_full_path_calls_the_module_member():
    assert std.math.sqrt(9.0) == 3.0

test fn go_reading_still_binds_last_segment():
    assert math.sqrt(16.0) == 4.0
