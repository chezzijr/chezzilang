# A module-level name is bound once (Go: `x redeclared in this block`; Rust: no top-level `let`, a
# `static` twice is E0428). A second top-level `:=` of a name is a check error, so the rejecting half
# lives in `src/checker/tests/statements.rs` (`a_module_level_name_is_bound_once`); what runs here is
# what stays legal: `=` reassigns the one slot, and a binding inside a fn or block body is a fresh
# shadow (Rust's `let`) that may change type.
# Gated by `chz_suite_passes` (`tests/chz_suite.rs`).

gx := 1
gseen := fn() -> int: gx
gx = 2

test fn module_reassign_shares_one_slot():
    # Late binding through the one global slot: the closure predates the assignment.
    assert gseen() == 2, "closure saw {gseen()}"
    assert gx == 2, "global is {gx}"

test fn fn_local_redeclare_is_a_fresh_slot():
    # The fn-local path is a genuine shadow: `peek` keeps reading the FIRST `y`, and the second may
    # even change type (Rust, measured: `let x = 1; let f = move || x; let x = "9";` prints `1 9`).
    y := 1
    peek := fn() -> int: y
    y := "9"
    assert peek() == 1, "fn-local closure saw {peek()}"
    assert y == "9", "shadowed local is {y}"

test fn fn_local_destructuring_redeclare_is_a_fresh_slot():
    n := 1
    peek := fn() -> int: n
    n, m := ("s", 2)
    assert peek() == 1, "fn-local closure saw {peek()}"
    assert n == "s", "shadowed local is {n}"
    assert m == 2, "second name is {m}"

gb := 1
gbseen := fn() -> int: gb
if true:
    gb := "s"

fn gfn() -> int:
    return 7
gfnseen := fn() -> int: gfn()

test fn a_top_level_fn_is_read_through_its_slot():
    assert gfnseen() == 7, "closure saw {gfnseen()}"

test fn block_scope_redeclare_does_not_touch_the_global():
    # A top-level `if:` body is scope > 1, so `gb := "s"` inside it is a fresh LOCAL shadow; it may
    # change type and it leaves the module slot alone.
    assert gb == 1, "global is {gb}"
    assert gbseen() == 1, "closure saw {gbseen()}"
