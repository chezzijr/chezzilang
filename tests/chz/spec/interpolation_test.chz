# tests/chz/spec/interpolation_test.chz — `"{…}"` interpolation behavior spec.
#
# Two classes of bug live here:
#  1. The fragment SCANNER must be quote- and depth-aware — a `}` inside a nested string literal or
#     inside `([{` belongs to the expression, not to the fragment (CPython f-string parity).
#  2. A fragment is a first-class expression: named/default/variadic call arguments are normalized
#     for it exactly as they are outside a string (they are desugared with the rest of the module).
#
# The still-a-compile-error cases (a bare unmatched `}`, a genuinely wrong-arity fragment call) stay
# in Rust — `assert` cannot observe a checker diagnostic.

# ---- scanner: quotes and nesting ----

test fn brace_inside_quoted_index():
    # The key is `a}b`. EVERY Chezzi string interpolates (there is no `f` prefix), so the nested
    # literal spells a literal brace `}}` too. The point here is the fragment SCANNER: it stays
    # inside `'…'` instead of cutting the fragment at the first quoted `}`.
    d := {"a}}b": 7}
    assert "val = {d['a}}b']}" == "val = 7"

test fn brace_inside_quoted_index_with_spec():
    d := {"a}}b": 7}
    assert "{d['a}}b']:>3}" == "  7"

test fn nested_string_literal_in_fragment():
    n := 5
    # Chezzi interpolates every string, so the nested literal interpolates too (no `f` prefix here).
    assert "outer {'inner {n}'}" == "outer inner 5"

test fn three_nesting_levels_still_render():
    # `desugar` re-enters its own expression walk on each parsed fragment, which is what makes
    # `parser::MAX_AST_DEPTH` a GLOBAL bound (W7-50: before that, each level bought a fresh budget
    # and three deep levels SIGABRTed `chezzi run`). Shallow here on purpose — the depth REFUSAL is
    # a compile-time resolve error, which `recover:` cannot catch, so it is pinned in Rust by
    # `check_errors_json::composed_interp_depth_is_bounded_globally`. What this pins is that the
    # walk that now carries the counter still renders every level. Each level needs its own quote
    # style, or the fragment fails to lex.
    n := 5
    assert "L1 {'L2 {\"L3 {n}\"}'}" == "L1 L2 L3 5"
    # …and the value still flows back out as an int through `.len()`, the shape the depth fixture uses.
    assert "{ \"{ 1+1 }\".len() }" == "1"

test fn set_literal_in_fragment():
    assert "{ {1, 2}.len() }" == "2"

test fn map_literal_in_fragment():
    assert "{ {'a': 1}['a'] }" == "1"

test fn spec_fill_char_may_be_a_quote_or_bracket():
    # Past the top-level `:` the fragment is literal SPEC text, so the scanner's quote/bracket
    # tracking must stop there — `'`, `(` and `)` are legal fill chars (CPython prints the same).
    x := 7
    assert "{x:'>5}" == "''''7"
    assert "{x:(>5}" == "((((7"
    assert "{x:)>5}" == "))))7"
    assert "{x:*>5}" == "****7"
    assert "{x:\">5}" == "\"\"\"\"7"

test fn colon_in_quoted_key_is_not_a_spec():
    m := {"a:b": 4}
    assert "{m['a:b']}" == "4"
    assert "{m['a:b']:>3}" == "  4"

# ---- a fragment is a first-class expression: call arguments are normalized ----
#
# `desugar` rewrites an interpolated literal into parsed fragments BEFORE it normalizes calls, so
# named args, defaults, and variadic sweeping reach a fragment call exactly as they reach any other
# (W7-24). Before that, every one of these was a type error inside a string and worked outside it.

fn with_default(a: int, b: int = 2) -> int:
    return a + b

fn sub(x: int, y: int) -> int:
    return x - y

fn sum_all(...xs: int) -> int:
    t := 0
    for x in xs:
        t = t + x
    return t

struct Point:
    x: int
    y: int = 5

struct Counter:
    v: int

    fn bump(self, n: int, m: int = 3) -> int:
        return self.v + n + m

test fn fragment_free_fn_default():
    assert "{with_default(1)}" == "3"
    assert "{with_default(1, 10)}" == "11"

test fn fragment_named_args():
    assert "{sub(y=1, x=10)}" == "9"
    assert "{sub(x=10, y=1)}" == "9"
    assert "{with_default(b=10, a=1)}" == "11"

test fn fragment_struct_ctor_default():
    assert "{Point(x=1).y}" == "5"

test fn fragment_method_default():
    c := Counter(v=1)
    assert "{c.bump(2)}" == "6"

test fn fragment_variadic():
    assert "{sum_all(1, 2, 3)}" == "6"
    assert "{sum_all()}" == "0"

test fn fragment_nested_call_defaults():
    assert "{with_default(with_default(1))}" == "5"

test fn fragment_local_shadows_fn_name():
    # A local binding shadows the module fn, so the call is a plain closure call — normalization
    # must NOT splice `with_default`'s default into it. Same rule inside a string as outside.
    with_default := fn(a: int) -> int: a * 100
    assert with_default(1) == 100
    assert "{with_default(1)}" == "100"

# ---- M24-6: the lexer's per-literal position map is RUNTIME-INERT ----
#
# A `{…}` fragment is re-lexed against a `PosMap` so its token spans are real source positions. That
# is a diagnostics/table-key change and it must not move a single rendered char. These are pure
# value assertions over exactly the shapes the map has to reason about: an escape that is many
# source chars for one content char, a fragment spanning a real newline, and `{{`/`}}` (which the
# fragment scanner consumes as content, keeping the raw index it keys on true).

test fn an_astral_escape_before_a_fragment_renders():
    n := 7
    assert "\u{1F600}{n}" == "😀7"
    assert "a\u{1F600}b{n}c" == "a😀b7c"

test fn a_fragment_spanning_a_real_newline_renders():
    x := 2
    assert """{[1,
x]}""" == "[1, 2]"

test fn doubled_braces_adjacent_to_a_fragment_render():
    # (The expected sides double their braces too — there is no `f` prefix in Chezzi, so EVERY
    # string literal interpolates.)
    n := 7
    assert "{{{n}}}" == "{{7}}"
    assert "{{ {n} }}" == "{{ 7 }}"
    assert "{n}}}" == "7}}"
    assert "{{{n}" == "{{7"

test fn a_bare_int_literal_hole_does_not_eat_a_regex_quantifier():
    # W8-1: interpolation is always on, so `{4}` in a would-be regex pattern is read as a hole
    # and silently rendered as digits instead of surviving as a literal `{4}` quantifier.
    p := "\\d{4}-\\d{2}"
    assert p == r"\d{4}-\d{2}"
