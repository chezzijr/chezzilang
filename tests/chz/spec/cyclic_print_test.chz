struct SelfRef:
    me: Any

struct CycNode:
    next: List[CycNode]

test fn a_self_referencing_list_renders_its_back_edge_as_ellipsis():
    xs: List[Any] = [1]
    xs.push(xs)
    assert "{xs}" == "[1, [...]]", "{xs}"
    assert "{xs}" == "[1, [...]]", "{xs}"

test fn a_self_referencing_map_renders_its_back_edge_as_braces():
    m: Map[str, Any] = {}
    m["a"] = m
    assert "{m}" == "{{'a': {{...}}}}", "{m}"

test fn a_cycle_through_a_tuple_stops_at_the_list():
    t: List[Any] = [1]
    t.push((t,))
    assert "{t}" == "[1, ([...],)]", "{t}"

test fn a_cycle_through_a_map_and_a_list_renders_both_sides():
    l: List[Any] = []
    m: Map[str, Any] = {"k": l}
    l.push(m)
    assert "{l}" == "[{{'k': [...]}}]", "{l}"
    assert "{m}" == "{{'k': [{{...}}]}}", "{m}"

test fn a_shared_but_acyclic_list_prints_in_full():
    x: List[Any] = []
    assert "{[x, x]}" == "[[], []]", "{[x, x]}"

test fn a_self_referencing_struct_renders_its_back_edge_as_dots():
    s := SelfRef(1)
    s.me = s
    assert "{s}" == "SelfRef(me=...)", "{s}"

test fn a_struct_cycle_through_lists_matches_the_dataclass_rendering():
    a := CycNode([])
    b := CycNode([])
    a.next.push(b)
    b.next.push(a)
    assert "{a}" == "CycNode(next=[CycNode(next=[...])])", "{a}"

test fn a_deep_acyclic_nest_still_faults_recoverably():
    x: Any = 0
    for _ in 0..12000:
        x = [x]
    r := recover: "{x}"
    match r:
        ?_: assert false, "a 12000-deep nest must hit the structural depth cap"
        !e: assert e.message().contains("maximum structural depth"), e.message()

test fn a_faulted_render_leaves_no_open_object_behind():
    x: Any = 0
    for _ in 0..12000:
        x = [x]
    first := recover: "{x}"
    match first:
        ?_: assert false, "a 12000-deep nest must hit the structural depth cap"
        !_: pass
    second := recover: "{x}"
    match second:
        ?s: assert false, "a stale open entry rendered the nest instead of faulting: " + s
        !e: assert e.message().contains("maximum structural depth"), e.message()
