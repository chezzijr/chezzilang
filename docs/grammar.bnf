# Chezzi grammar — canonical reference (M2)
#
# This is the single source of truth for Chezzi's syntax. It is NOT decorative:
# `cargo test conformance` executes it (via the `bnf` crate, a dev-dependency) and
# differential-tests its accept/reject decisions against the hand-written parser in
# `src/parser/mod.rs` on the corpus under `tests/corpus/`. If the code and this file
# disagree, the test fails.
#
# IMPORTANT — this grammar is written over the LEXER'S TOKEN STREAM, not raw source text.
# Every terminal (e.g. WALRUS, IDENT, NEWLINE) is a `Token` class emitted by the lexer
# (`src/lexer/mod.rs`). That is what makes indentation expressible: INDENT / DEDENT / NEWLINE
# are ordinary terminals the lexer produces. Terminal *values* (the 5 in INT, the name in
# IDENT) are abstracted away — the grammar cares only about token class.
#
# Notation: pure BNF. `<x>` nonterminal, "TOK" terminal (a token class), `::=`, `|`.
# No `*`/`?` — repetition is written with right-recursion, optionals as explicit alternatives.
# The expression rules form a precedence cascade (loosest first) mirroring `infix_op`'s binding
# powers in the parser (see docs/syntax.md §4); the hand parser realizes the same precedence via
# Pratt binding powers rather than literal cascade recursion.
#
# Terminals = exactly the `Token` enum variants, one class each. PIPE ("|>") drives the pipe
# operator (see <pipeExpr>, M6).
#
# Because terminals are token classes (not source forms), several lexical spellings collapse to
# one terminal and need NO production here: FLOAT covers scientific notation (`1e3`, `1.5e-9`,
# `6.022e23` — any exponent makes the literal a float); STR covers both `"…"` and `'…'` quoting
# and all string escapes including `\u{HEX}` unicode. The exact lexical grammar lives in
# `src/lexer/mod.rs` + `docs/syntax.md §2/§10`.

# ===== top level =====
# A file is zero or more statements then EOF. The lexer always emits a trailing NEWLINE before
# EOF when the last line had content, and one DEDENT per still-open block; blank/comment-only
# lines emit no tokens, so no stray NEWLINEs appear between statements.
# `extern "lib":` is a TOP-LEVEL-only declaration: the checker's hoist + the compiler's eager
# `MakeCffi` only walk module-level statements, so an extern nested in a block would silently skip
# marshallability validation. It therefore appears in <topLevelStmt> but NOT in <compoundStmt> (the
# latter feeds <stmts>, which a <block> uses) — so a nested extern is a parse error.
# `import` is TOP-LEVEL-only for the same reason: the resolver only scans module-level statements,
# so an import nested in a block would parse + check clean and be a complete NO-OP (never resolved,
# never bound, never run). It therefore lives in <topLevelStmt>, NOT in <simpleStmt> — a nested
# import is a parse error.
<module>        ::= "EOF" | <topLevelStmts> "EOF"
<topLevelStmts> ::= <topLevelStmt> | <topLevelStmt> <topLevelStmts>
<topLevelStmt>  ::= <stmt> | <importStmt> | <externDecl> | <nativeDecl> | <nativeStructDecl> | <nativeEnumDecl>
<stmts>         ::= <stmt> | <stmt> <stmts>

<stmt>         ::= <simpleStmt> | <compoundStmt>
<compoundStmt> ::= <fnDecl> | <testFnDecl> | <structDecl> | <enumDecl> | <newtypeDecl> | <protocolDecl> | <ifStmt> | <forStmt> | <whileStmt> | <matchStmt> | <parallelStmt> | <spawnStmt> | <waitStmt> | <deferStmt>

# Line-oriented statements each consume their terminating NEWLINE.
<simpleStmt> ::= <letStmt> | <assignStmt> | <returnStmt> | <yieldStmt> | <breakStmt> | <continueStmt> | <passStmt> | <typeAliasDecl> | <assertStmt> | <exprStmt>

# ===== simple statements =====
# The third form is a destructuring binding: `a, b, … := expr` binds a tuple's elements positionally.
# Only `:=` introduces destructuring binds (`a, b = …` is multi-target *re*assignment — see below).
# An optional `REF` before the typed-let's <type> is the `ref T` by-reference binding modifier
# (`r: ref int = 0`) — sugar that lowers to a `Ref[T]` box. Legal ONLY here and on a <param> type;
# rejected in every other type position (return type, generic arg, collection element, struct field,
# tuple element — none of which admit REF before <type>) and on a destructuring (<identList>) let.
<letStmt> ::= "IDENT" "WALRUS" <expr> "NEWLINE"
            | "IDENT" "COLON" <type> "ASSIGN" <expr> "NEWLINE"
            | "IDENT" "COLON" "REF" <type> "ASSIGN" <expr> "NEWLINE"
            | <identList> "WALRUS" <expr> "NEWLINE"
            # A block-valued RHS (`r := recover:` …) is terminated by the block's DEDENT, not a
            # trailing NEWLINE (mirrors the parser's `expect_stmt_end`).
            | "IDENT" "WALRUS" <recoverExpr>
<identList> ::= "IDENT" "COMMA" "IDENT" | "IDENT" "COMMA" <identList>

# Assignment target is restricted to a name / field / index (the parser's lvalue guard):
# an lvalue is a bare IDENT, or any postfix expression that *ends* in `.field` or `[index]`
# (so `f().x` and `xs[0]` are lvalues, but `f()` and `1` are not). Compound forms `OP=` desugar to
# `lvalue = lvalue OP expr`. The last two alts are multi-target (tuple) assignment, `=` only:
# either a same-arity value list (`a, b = b, a`) or a single tuple-valued RHS (`a, b = f()`).
<assignStmt> ::= <lvalue> "ASSIGN" <expr> "NEWLINE"
               | <lvalue> "PLUSEQ" <expr> "NEWLINE"
               | <lvalue> "MINUSEQ" <expr> "NEWLINE"
               | <lvalue> "STAREQ" <expr> "NEWLINE"
               | <lvalue> "SLASHEQ" <expr> "NEWLINE"
               | <lvalue> "PERCENTEQ" <expr> "NEWLINE"
               | <lvalue> "AMPEQ" <expr> "NEWLINE"
               | <lvalue> "PIPEEQ" <expr> "NEWLINE"
               | <lvalue> "CARETEQ" <expr> "NEWLINE"
               | <lvalue> "SHLEQ" <expr> "NEWLINE"
               | <lvalue> "SHREQ" <expr> "NEWLINE"
               | <lvalueList> "ASSIGN" <exprList> "NEWLINE"
<lvalueList> ::= <lvalue> "COMMA" <lvalue> | <lvalue> "COMMA" <lvalueList>
<lvalue> ::= "IDENT"
           | <postfix> "DOT" "IDENT"
           | <postfix> "LBRACKET" <expr> "RBRACKET"

<returnStmt> ::= "RETURN" "NEWLINE" | "RETURN" <expr> "NEWLINE"

# `yield <expr>` (generators) — always carries a value. Legal only inside a generator
# function (one that uses `yield`; the `-> Iterator[T]` return type is optional — inferred from the
# first yield when omitted). Checker-enforced, not grammar. Suspends the generator.
<yieldStmt> ::= "YIELD" <expr> "NEWLINE"

# `defer <call>` (form 1) — the call-only restriction is enforced by the checker
# (context-sensitive), not the grammar. `defer:` (form 2) takes an indented block whose body runs
# top-to-bottom at scope exit; it is block-ending (terminated by the block's DEDENT), hence compound.
<deferStmt> ::= "DEFER" <expr> "NEWLINE" | "DEFER" <block>

# `break` / `continue` are bare line-oriented statements; "inside a loop" is enforced by the
# checker (context-sensitive), not the grammar.
<breakStmt>    ::= "BREAK" "NEWLINE"
<continueStmt> ::= "CONTINUE" "NEWLINE"
# `pass` is a no-op statement (an empty fn/method/control-flow body; an alternative to a bare `return`).
# As the SOLE line of a `struct`/`protocol` body it is instead an empty-body marker (see <structDecl> /
# <protocolDecl>); in an `enum` body it is a parse error (an enum needs at least one variant).
<passStmt>     ::= "PASS" "NEWLINE"

<importStmt> ::= "IMPORT" <dottedPath> "NEWLINE"
               | "IMPORT" <dottedPath> "AS" "IDENT" "NEWLINE"
               | "IMPORT" <importNames> "FROM" <dottedPath> "NEWLINE"
<importNames> ::= <importName> | <importName> "COMMA" <importNames>
<importName>  ::= "IDENT" | "IDENT" "AS" "IDENT"
<dottedPath>  ::= "IDENT" | "IDENT" "DOT" <dottedPath>

# `assert <cond>` faults with its source span when `cond` is false; the optional second operand is
# a custom str message. `cond` must be bool and `msg` (if given) str — enforced by the checker.
<assertStmt> ::= "ASSERT" <expr> "NEWLINE" | "ASSERT" <expr> "COMMA" <expr> "NEWLINE"

<exprStmt> ::= <expr> "NEWLINE"

# ===== blocks =====
# Indented block: ':' NEWLINE INDENT stmts DEDENT. Inline block: ':' followed by ONE simple
# statement on the same line (its NEWLINE terminates the line). Inline bodies exclude compound
# statements, so `if a: if b: x` cannot parse inline — a trailing `else` would be ambiguous.
<block> ::= "COLON" "NEWLINE" "INDENT" <stmts> "DEDENT"
          | "COLON" <simpleStmt>

# ===== declarations =====
# An omitted "ARROW" <type> is not "returns nothing": the checker infers the return type from
# the body. Param types remain required.
# A MULTILINE body is a sequence of STATEMENTS: its return type comes from the body's `return`s
# (nil when no value is returned), and a DECLARED non-void "ARROW" <type> whose multiline body can
# fall off the end without a value `return` is rejected (add a `return`).
# The INLINE-expr body (`<block> ::= COLON <simpleStmt>` where the simpleStmt is a bare exprStmt)
# IMPLICITLY RETURNS that expression — exactly like a closure `fn(x): expr`. So `fn a(): 10` infers
# `-> int`, and `fn a() -> int: 10` is valid (the expr is the implicit return, so the fall-off check
# does not fire). An inline NON-expr statement (`fn a(): x = 5`, `fn a(): return e`) is not an
# implicit return. A declaration with no "ARROW" infers its type and is exempt from the fall-off check.
# A function may carry generic type parameters after its name: `fn max[T: Comparable](…)`. The
# optional bound names a protocol the instantiating type must structurally satisfy. A generic fn may
# ALSO carry a `where T: Bound, …` clause after the return type (an alternative spelling of the same
# bounds, merged into the matching type parameter by the checker) — see <whereClause>.
<fnDecl> ::= "FN" "IDENT" "LPAREN" "RPAREN" <block>
           | "FN" "IDENT" "LPAREN" <params> "RPAREN" <block>
           | "FN" "IDENT" "LPAREN" "RPAREN" "ARROW" <type> <block>
           | "FN" "IDENT" "LPAREN" <params> "RPAREN" "ARROW" <type> <block>
           | "FN" "IDENT" <typeParams> "LPAREN" "RPAREN" <block>
           | "FN" "IDENT" <typeParams> "LPAREN" <params> "RPAREN" <block>
           | "FN" "IDENT" <typeParams> "LPAREN" "RPAREN" "ARROW" <type> <block>
           | "FN" "IDENT" <typeParams> "LPAREN" <params> "RPAREN" "ARROW" <type> <block>
           | "FN" "IDENT" <typeParams> "LPAREN" "RPAREN" <whereClause> <block>
           | "FN" "IDENT" <typeParams> "LPAREN" <params> "RPAREN" <whereClause> <block>
           | "FN" "IDENT" <typeParams> "LPAREN" "RPAREN" "ARROW" <type> <whereClause> <block>
           | "FN" "IDENT" <typeParams> "LPAREN" <params> "RPAREN" "ARROW" <type> <whereClause> <block>

# A `where T: Bound, U: Add + Mul, …` clause: a comma-separated list of `IDENT (: bound (+ bound)*)`
# entries (each the shape of one <typeParam>), reusing <boundList>. Attaches after a fn/native-fn
# signature; the checker merges each entry's bounds into the matching declared type parameter.
<whereClause> ::= "WHERE" <whereList>
<whereList>   ::= <typeParam> | <typeParam> "COMMA" <whereList>
# A `test` modifier before `fn` marks a test (`chezzi test` discovers it). A free `test fn` is an
# independent test (no params, returns nothing); a `test fn name(self)` in a struct is a suite test.
# The no-params/only-self + returns-nothing shape is enforced by the checker, not the grammar.
<testFnDecl> ::= "TEST" <fnDecl>

# A parameter may carry a default value (`x: int = expr`). Free `fn` declarations and struct methods
# accept it; closures and protocol signatures reject it. The default may be any expression that does
# not reference another parameter (a desugar-pass rule). These are rules the permissive grammar does
# not model.
# An optional trailing comma before the closing `)` is permitted (`fn g(a, b,)`).
<params> ::= <param> | <param> "COMMA" | <param> "COMMA" <params>
# A `ref T` param (`fn f(x: ref int)`) — the by-reference binding modifier, lowered to a `Ref[T]`
# box. The optional `REF` sits between the `COLON` and the <type>, the same as a typed-let.
# A leading `...` marks a VARIADIC param (`fn f(...xs: T)`) — it collects surplus trailing positional
# args into a `List[T]`; everything after it is keyword-only. Parser-level rules the permissive grammar
# does not model: at most one variadic, it must carry an element type, it may not carry a default, and
# it is legal only where defaults are (free fns / methods / native decls — not closures / extern).
<param>  ::= "IDENT" | "IDENT" "COLON" <type> | "IDENT" "COLON" "REF" <type>
           | "IDENT" "ASSIGN" <expr> | "IDENT" "COLON" <type> "ASSIGN" <expr>
           | "DOTDOTDOT" "IDENT" "COLON" <type>

# Generic type parameters on a fn/struct declaration: `[T]`, `[T: Comparable]`, `[A, B]`, or a
# parameterized bound `[S: Iterator[T]]` (only `Iterator` gives its type args meaning).
<typeParams>    ::= "LBRACKET" <typeParamList> "RBRACKET"
<typeParamList> ::= <typeParam> | <typeParam> "COMMA" <typeParamList>
<typeParam>     ::= "IDENT" | "IDENT" "COLON" <boundList>
<boundList>     ::= <bound> | <bound> "PLUS" <boundList>
<bound>         ::= "IDENT" | "IDENT" "LBRACKET" <typeList> "RBRACKET"

<structDecl>    ::= "STRUCT" "IDENT" "COLON" "NEWLINE" "INDENT" <structBody> "DEDENT"
                  | "STRUCT" "IDENT" <typeParams> "COLON" "NEWLINE" "INDENT" <structBody> "DEDENT"
# The body is either one-or-more members OR a SOLE `pass` line = an empty struct (zero fields, zero
# methods; the ctor `S()` takes no args). Encoding `pass` as a whole-body alternative (not folded into
# <structMember>) is what makes `pass`+member and `pass pass` both parse errors, matching the parser.
<structBody>    ::= <structMembers> | "PASS" "NEWLINE"
<structMembers> ::= <structMember> | <structMember> <structMembers>
<structMember>  ::= <field> | <fnDecl> | <testFnDecl>
# A field may carry a constant-literal default (`port: int = 8080`), used to fill omitted args in a
# constructor call. Const-ness and the "no required field after a default" rule are parser-level.
<field>         ::= "IDENT" "COLON" <type> "NEWLINE"
                  | "IDENT" "COLON" <type> "ASSIGN" <expr> "NEWLINE"

# A protocol is a Go-style structural interface: a block of body lines, each EITHER a body-less method
# signature OR an embed line (M22). An embed line is one-or-more protocol refs joined by `+`
# (`Add + Sub`, `Iterator[T]`) — it pulls in those (super-)protocols' requirements. Embeds and `fn`
# sigs interleave in any order; a body of only embed lines is a bundle (`Arithmetic: Add + Sub + Mul +
# Div`). A type satisfies the protocol by satisfying every embed (transitively) AND every own method.
# It may carry type parameters (`protocol Container[T]:`); a bound supplies concrete args
# (`[X: Container[int]]`). An embed ref reuses <boundList>/<bound>.
<protocolDecl> ::= "PROTOCOL" "IDENT" "COLON" "NEWLINE" "INDENT" <protoBody> "DEDENT"
                 | "PROTOCOL" "IDENT" <typeParams> "COLON" "NEWLINE" "INDENT" <protoBody> "DEDENT"
# A SOLE `pass` line = an empty protocol (zero methods, zero embeds): an accept-all TOP type
# (structural ⇒ every type satisfies it, like the reserved `Any`). As with <structBody>, `pass` is a
# whole-body alternative so `pass`+member and `pass pass` are parse errors, matching the parser.
<protoBody>    ::= <protoLines> | "PASS" "NEWLINE"
<protoLines>   ::= <protoLine> | <protoLine> <protoLines>
<protoLine>    ::= <fnSig> | <embedLine>
<embedLine>    ::= <boundList> "NEWLINE"
<fnSig>        ::= "FN" "IDENT" "LPAREN" "RPAREN" "NEWLINE"
                 | "FN" "IDENT" "LPAREN" <params> "RPAREN" "NEWLINE"
                 | "FN" "IDENT" "LPAREN" "RPAREN" "ARROW" <type> "NEWLINE"
                 | "FN" "IDENT" "LPAREN" <params> "RPAREN" "ARROW" <type> "NEWLINE"

# A dynamic C-ABI FFI block: a body-less list of C function signatures bound to a shared library
# (`extern "libm.so.6":`). Each `fn` becomes a module-global callable dispatched via dlopen+libffi.
# v1 marshals scalars (int/float/bool/str→char*), fixed-width ints (int8..uint64), opaque `ptr`
# (↔ void*), and a flat-scalar struct by value (a `struct` <type> named in an extern sig) — all are
# ordinary <type> forms recognized only inside an extern sig (no new grammar).
<externDecl> ::= "EXTERN" "STR" "COLON" "NEWLINE" "INDENT" <externFns> "DEDENT"
              | "EXTERN" "RAWSTR" "COLON" "NEWLINE" "INDENT" <externFns> "DEDENT"
<externFns>  ::= <externFn> | <externFn> <externFns>
<externFn>   ::= "FN" "IDENT" "LPAREN" "RPAREN" "NEWLINE"
              | "FN" "IDENT" "LPAREN" <params> "RPAREN" "NEWLINE"
              | "FN" "IDENT" "LPAREN" "RPAREN" "ARROW" <type> "NEWLINE"
              | "FN" "IDENT" "LPAREN" <params> "RPAREN" "ARROW" <type> "NEWLINE"

# `native fn`/`native ctor` — a body-less universe-builtin SIGNATURE, PRELUDE/STD-ONLY (the checker
# rejects it in a user module) and TOP-LEVEL-only. The body is bound natively (name-keyed dispatch);
# the front-end reads only the signature. `native fn` is a first-class function intrinsic; `native
# ctor` a non-first-class scalar/type constructor. `ctor` is a plain IDENT (not a keyword). An
# UNANNOTATED param = dynamic ("accepts anything"); a missing `-> ret` = native-controlled/never.
# The universe builtins ord/chr/panic/int/float/str/bytes/bytearray are declared this way in
# std/prelude.chz. (`ctor` shows as IDENT below; the checker enforces the exact spelling.)
<nativeDecl>  ::= "NATIVE" <nativeHead> "IDENT" "LPAREN" "RPAREN" "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" "LPAREN" <params> "RPAREN" "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" "LPAREN" "RPAREN" "ARROW" <type> "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" "LPAREN" <params> "RPAREN" "ARROW" <type> "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" "LPAREN" "RPAREN" "ARROW" <type> <whereClause> "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" "LPAREN" <params> "RPAREN" "ARROW" <type> <whereClause> "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" <typeParams> "LPAREN" "RPAREN" "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" <typeParams> "LPAREN" <params> "RPAREN" "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" <typeParams> "LPAREN" "RPAREN" "ARROW" <type> "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" <typeParams> "LPAREN" <params> "RPAREN" "ARROW" <type> "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" <typeParams> "LPAREN" "RPAREN" "ARROW" <type> <whereClause> "NEWLINE"
               | "NATIVE" <nativeHead> "IDENT" <typeParams> "LPAREN" <params> "RPAREN" "ARROW" <type> <whereClause> "NEWLINE"
<nativeHead>  ::= "FN" | "IDENT"

# `native struct` — the TYPE-level analog of `native fn`/`native ctor` (phase 4a). A body-less
# `native struct NAME[T…]:` declares a native type's checker SIGNATURE (its field layout + method
# table) in Chezzi; the runtime layout + method dispatch stay native (name-keyed). PRELUDE/STD-ONLY
# (the checker rejects it in a user module) and TOP-LEVEL-only. The body is a sequence of members, each
# a field (`IDENT COLON <type>`, no `= default` — a native layout carries no default) OR a bodyless
# `native fn` INSTANCE method (phase 4c). A `native fn` method MUST declare a leading bare `self` as
# its first parameter (mirroring a user-struct method; harvest strips it) — a self-less body `native
# fn` is a parse error (the form is reserved for a future native static method). A plain `fn`/`test`
# method (with a body) is a parse error. A method sig may reference the struct's type params
# (`native fn get(self) -> T`), e.g. `std/concurrency.chz`'s `Shared[T]`. A `native struct` maps
# ADDITIVELY onto an EXISTING reserved type (its method table only, never a fresh nominal struct): the
# import-gated opaque handles (`Shared`/`Socket`/…) AND the always-in-scope UNIVERSE containers
# (`std/prelude.chz`'s `List[T]`/`Map[K: Hashable, V]`/`Set[T: Hashable]`, phase 5a) keep resolving to
# `Ty::List`/`Ty::Map`/`Ty::Set`/etc — literal syntax + turbofish ctor stay compiler-wired. A type param
# may carry a bound (`Map[K: Hashable, V]`) via `<typeParams>`.
<nativeStructDecl> ::= "NATIVE" "STRUCT" "IDENT" "COLON" "NEWLINE" "INDENT" <nativeStructMembers> "DEDENT"
                     | "NATIVE" "STRUCT" "IDENT" <typeParams> "COLON" "NEWLINE" "INDENT" <nativeStructMembers> "DEDENT"
<nativeStructMembers> ::= <nativeStructMember> | <nativeStructMember> <nativeStructMembers>
<nativeStructMember> ::= <nativeFieldDecl> | <nativeMethodDecl>
<nativeFieldDecl>  ::= "IDENT" "COLON" <type> "NEWLINE"
# A native instance method: `<params>` must begin with the bare receiver `self` (checker/parser rule,
# not expressible in the grammar); harvest drops it so the recorded sig is the call-arg shape.
# A native method may declare its OWN generic params after the name (`native fn map[U](self, …)`);
# these are the method's own `[U]`, distinct from the enclosing native struct's `[T]`, and the harvest
# routes the sig through the generic-method inference path (e.g. `List.map`/`fold`/`sort_by_key`).
<nativeMethodDecl> ::= "NATIVE" "FN" "IDENT" "LPAREN" <params> "RPAREN" "NEWLINE"
                     | "NATIVE" "FN" "IDENT" "LPAREN" <params> "RPAREN" "ARROW" <type> "NEWLINE"
                     | "NATIVE" "FN" "IDENT" "LPAREN" <params> "RPAREN" "ARROW" <type> <whereClause> "NEWLINE"
                     | "NATIVE" "FN" "IDENT" <typeParams> "LPAREN" <params> "RPAREN" "NEWLINE"
                     | "NATIVE" "FN" "IDENT" <typeParams> "LPAREN" <params> "RPAREN" "ARROW" <type> "NEWLINE"
                     | "NATIVE" "FN" "IDENT" <typeParams> "LPAREN" <params> "RPAREN" "ARROW" <type> <whereClause> "NEWLINE"

# `native enum` — the ENUM analog of `native struct` (phase 5b). A body-less `native enum NAME[T…]:`
# declares a RESERVED builtin enum's variant SHAPE (variant names + payload types) in Chezzi; it maps
# ADDITIVELY onto an EXISTING reserved type (`Ty::Option`/`Ty::Result`), never a fresh nominal enum, and
# the `?` operator / exhaustive `match` / top-level error propagation / `Ok`/`Err`/`Some`/`None`
# construction all stay Rust-wired (the decl is a drift-guarded shape MIRROR). PRELUDE/STD-ONLY (the
# checker rejects it in a user module) and TOP-LEVEL-only. The body is its variants (`<variant>` — an
# IDENT with an optional `(typeList)` payload), optionally followed by body-less `native fn` methods
# (variants must precede methods, mirroring `<enumDecl>`); a plain `fn`/`test` method is a parse error.
# A `native fn` method MUST declare a leading bare `self` as its first parameter (harvest strips it) — a
# self-less body `native fn` is a parse error. The only native enums are `std/prelude.chz`'s `Option[T]`
# (`Some(T)`/`None`) and `Result[T, E]` (`Ok(T)`/`Err(E)`). A type param may carry a bound via
# `<typeParams>`.
<nativeEnumDecl> ::= "NATIVE" "ENUM" "IDENT" "COLON" "NEWLINE" "INDENT" <nativeEnumMembers> "DEDENT"
                   | "NATIVE" "ENUM" "IDENT" <typeParams> "COLON" "NEWLINE" "INDENT" <nativeEnumMembers> "DEDENT"
<nativeEnumMembers> ::= <variants> | <variants> <nativeEnumMethods>
<nativeEnumMethods> ::= <nativeMethodDecl> | <nativeMethodDecl> <nativeEnumMethods>

# An enum body is its variants, optionally followed by methods (`fn` only — unlike a struct, an enum
# may NOT carry `test fn`: enum test suites aren't wired, so the parser rejects them).
# Methods must come AFTER all variants (the parser rejects a variant after a method).
<enumDecl> ::= "ENUM" "IDENT" "COLON" "NEWLINE" "INDENT" <enumMembers> "DEDENT"
            | "ENUM" "IDENT" <typeParams> "COLON" "NEWLINE" "INDENT" <enumMembers> "DEDENT"
<enumMembers> ::= <variants> | <variants> <enumMethods>
<enumMethods> ::= <enumMethod> | <enumMethod> <enumMethods>
<enumMethod>  ::= <fnDecl>
<variants> ::= <variant> | <variant> <variants>
<variant>  ::= "IDENT" "NEWLINE"
             | "IDENT" "LPAREN" <typeList> "RPAREN" "NEWLINE"

# A transparent type alias: `type Name = <type>`. `Name` is interchangeable with the aliased type.
<typeAliasDecl> ::= "TYPE" "IDENT" "ASSIGN" <type> "NEWLINE"

# A nominal `newtype`: a DISTINCT type wrapping <type> (NOT interchangeable with it — only an explicit
# construct `Name(x)` or cast-unwrap `int(n)` crosses). May carry generic type params
# (`newtype Stack[T] = List[T]`): the underlying + method signatures may then reference them, and a
# type-parameterized newtype is METHODS-ONLY (no native operator auto-flow — operators come only from
# its own methods + protocol satisfaction). The method-less one-liner is the common case; an optional
# trailing-colon block adds `fn` methods (no `test fn`, like enums). Contrast `<typeAliasDecl>` above,
# which is transparent (structurally identical to its body).
<newtypeDecl> ::= "NEWTYPE" "IDENT" "ASSIGN" <type> "NEWLINE"
               | "NEWTYPE" "IDENT" "ASSIGN" <type> "COLON" "NEWLINE" "INDENT" <newtypeMethods> "DEDENT"
               | "NEWTYPE" "IDENT" <typeParams> "ASSIGN" <type> "NEWLINE"
               | "NEWTYPE" "IDENT" <typeParams> "ASSIGN" <type> "COLON" "NEWLINE" "INDENT" <newtypeMethods> "DEDENT"
<newtypeMethods> ::= <fnDecl> | <fnDecl> <newtypeMethods>

# ===== control flow =====
<ifStmt> ::= "IF" <expr> <block>
           | "IF" <expr> <block> <elseChain>
# zero+ `elif` branches, optionally a final `else`; at least one clause here.
<elseChain> ::= <elseIf> | <elseFinal> | <elseIf> <elseChain>
<elseIf>    ::= "ELIF" <expr> <block>
<elseFinal> ::= "ELSE" <block>

<forStmt>   ::= "FOR" "IDENT" "IN" <expr> <block>
            | "FOR" <identList> "IN" <expr> <block>
<whileStmt> ::= "WHILE" <expr> <block>

# Concurrency (C1): a `parallel:` nursery and the two `spawn` forms. `parallel:` and the block form
# of `spawn` are block-ending (no trailing NEWLINE); the call form of `spawn` is line-oriented and
# consumes its NEWLINE, like `defer`. The call-only restriction on the form-1 expression and the
# "spawn only inside a parallel:" rule are enforced by the parser/checker, not the grammar.
<parallelStmt> ::= "PARALLEL" <block>
<spawnStmt>    ::= "SPAWN" <expr> "NEWLINE" | "SPAWN" <block>

# Concurrency (C6d): `wait:` — Chezzi's `select`, racing channel `recv`s. Each recv-arm is
# `<target> (":=" | "=") <chanExpr> ".recv()" <block>`; the optional `else:` arm is the non-blocking
# fallback. The grammar accepts any `<expr>` on both sides of `:=`/`=` — the "RHS must be a bare
# `.recv()`", "`:=` LHS must be a name / `=` LHS must be an lvalue", "`else` is last", and "≥1 recv-arm"
# rules are enforced by the parser/checker, not the grammar (like `spawn`'s call-only restriction).
<waitStmt> ::= "WAIT" "COLON" "NEWLINE" "INDENT" <waitArms> "DEDENT"
<waitArms> ::= <waitArm> | <waitArm> <waitArms>
<waitArm>  ::= <expr> "WALRUS" <expr> <block>
             | <expr> "ASSIGN" <expr> <block>
             | "ELSE" <block>

<matchStmt> ::= "MATCH" <expr> "COLON" "NEWLINE" "INDENT" <arms> "DEDENT"
<arms>      ::= <arm> | <arm> <arms>
# An arm may carry an optional `if <expr>` guard: the arm matches only if the pattern binds AND the
# guard (a bool, evaluated with the pattern's bindings in scope) is true.
<arm>       ::= <pattern> <block>
                | <pattern> "IF" <expr> <block>
# A top-level arm pattern: one-or-more primaries joined by "|" (BITOR) — an or-pattern matches if
# ANY alternative matches (first match wins). A single primary parses unchanged. Every alternative
# must bind the same variables (checker-enforced). A primary: a bare "IDENT" is a BINDING (or, for the
# built-in Ok/Err/Some/None, a variant); a QUALIFIED "IDENT" "DOT" "IDENT" names a user variant
# (nullary, or with "LPAREN" a payload-carrying one); "(" … ")" a tuple pattern; an int/str/bool
# literal; or a half-open integer range "INT" ".." "INT" (matches `start <= v < end`). Sub-patterns
# nest (gap #15): a variant payload slot or tuple element is itself a <subpattern>. The SAME
# `"IDENT" "LPAREN" <subpatterns> "RPAREN"` primary ALSO destructures a USER STRUCT positionally when
# the scrutinee is that struct type (L2 — `Point(x, y)` binds the fields in declaration order). A
# module-qualified struct pattern `geo.Point(x, y)` (the whole-module-import spelling) reuses the same
# `"IDENT" "DOT" "IDENT" "LPAREN" …` production as a qualified variant; the productions already admit
# both, so only the disambiguation is checker-side (module-qualified struct vs `Enum.Variant`).
<pattern>     ::= <patternPrimary>
                | <patternPrimary> "BITOR" <pattern>
# A leading "IDENT" "DOT" "IDENT" is a QUALIFIED variant `Enum.Variant`. User variants are scoped
# under their enum (two enums may share a variant name) and MUST be written qualified; the checker
# rejects a bare user-variant name. Resolution keys on the `(enum, variant)` pair. (Built-in
# Result/Option variants Ok/Err/Some/None stay bare.) An OPTIONAL leading module qualifier
# `module.Enum.Variant` ("IDENT" "DOT" "IDENT" "DOT" "IDENT") mirrors module-qualified construction
# (`geo.Color.Red`): the module binder is the bound module name (last path segment or `as` alias),
# validated by the checker (module bound, owns the enum) then dropped — runtime keys on the same
# `(enum, variant)` identity as the bare/from-import form.
<patternPrimary> ::= "IDENT"
                | "IDENT" "LPAREN" "RPAREN"
                | "IDENT" "LPAREN" <subpatterns> "RPAREN"
                | "IDENT" "DOT" "IDENT"
                | "IDENT" "DOT" "IDENT" "LPAREN" "RPAREN"
                | "IDENT" "DOT" "IDENT" "LPAREN" <subpatterns> "RPAREN"
                | "IDENT" "DOT" "IDENT" "DOT" "IDENT"
                | "IDENT" "DOT" "IDENT" "DOT" "IDENT" "LPAREN" "RPAREN"
                | "IDENT" "DOT" "IDENT" "DOT" "IDENT" "LPAREN" <subpatterns> "RPAREN"
                | <tuplePattern>
                | "INT" | "STR" | "RAWSTR" | "TRUE" | "FALSE"
                | "INT" "DOTDOT" "INT"
# A leading "MINUS" makes the int literal / range bound negative (int-only — there is no float
# pattern, so a "MINUS" before a float is a parse error, exactly like a bare float). Either range
# bound may independently be negative (`-10..-5`, `-10..5`, `0..-5`).
                | "MINUS" "INT"
                | "MINUS" "INT" "DOTDOT" "MINUS" "INT"
                | "MINUS" "INT" "DOTDOT" "INT"
                | "INT" "DOTDOT" "MINUS" "INT"
# A sub-pattern (nested position) is itself an or-alternation of primaries. A bare "IDENT" here is a
# binding name OR — when it names a nullary variant of the matched type — a refutable variant match
# (checker-promoted; e.g. the `None` in `Some(None)`). Same surface grammar either way.
<subpattern>  ::= <subpatternPrimary>
                | <subpatternPrimary> "BITOR" <subpattern>
<subpatternPrimary> ::= "IDENT"
                | "IDENT" "LPAREN" "RPAREN"
                | "IDENT" "LPAREN" <subpatterns> "RPAREN"
                | "IDENT" "DOT" "IDENT"
                | "IDENT" "DOT" "IDENT" "LPAREN" "RPAREN"
                | "IDENT" "DOT" "IDENT" "LPAREN" <subpatterns> "RPAREN"
                | "IDENT" "DOT" "IDENT" "DOT" "IDENT"
                | "IDENT" "DOT" "IDENT" "DOT" "IDENT" "LPAREN" "RPAREN"
                | "IDENT" "DOT" "IDENT" "DOT" "IDENT" "LPAREN" <subpatterns> "RPAREN"
                | <tuplePattern>
                | "INT" | "STR" | "RAWSTR" | "TRUE" | "FALSE"
                | "INT" "DOTDOT" "INT"
<subpatterns> ::= <subpattern> | <subpattern> "COMMA" <subpatterns>
<tuplePattern> ::= "LPAREN" <subpatterns> "RPAREN"

# ===== types =====
# Postfix sugar on a base type: `T?` = Option[T], `T!` = Result[T, Error], `T!E` = Result[T, E]
# (stacks left-to-right). A parenthesized type is grouping when it has one element (`(T)` ⇒ `T`)
# and a tuple type when it has two or more (`(T1, T2, …)`).
# A `IDENT.IDENT` (optionally with `[typeList]`) is a MODULE-QUALIFIED type (`geo.Point`,
# `geo.Box[int]`): the first ident is a bound module name (the same name `geo.func()` uses), the
# second is a type in that module. Types are module-scoped — a type declared in one module is
# reachable elsewhere only via import (qualified `m.Type` or bare after `import Type from m`).
<type>     ::= "IDENT" | "IDENT" "LBRACKET" <typeList> "RBRACKET"
             | "IDENT" "DOT" "IDENT" | "IDENT" "DOT" "IDENT" "LBRACKET" <typeList> "RBRACKET"
             | "FN" "LPAREN" "RPAREN" "ARROW" <type>
             | "FN" "LPAREN" <fnParamList> "RPAREN" "ARROW" <type>
             | "LPAREN" <typeList> "RPAREN"
             | <type> "QUESTION" | <type> "BANG" | <type> "BANG" <type>
<typeList> ::= <type> | <type> "COMMA" <typeList>
# A `fn(...)` TYPE parameter may carry an OPTIONAL Swift-style LABEL (`IDENT ":"`) before its type
# (`fn(name: str, greeting: str) -> nil`), enabling keyword arguments through a function VALUE
# (`g := greet; g(name="Bob")`). Labels are SURFACE-ONLY: `fn(str)->nil` and `fn(name:str)->nil` are
# the same type (mutually assignable). A bare param (no label) is still valid.
<fnParamList> ::= <fnParam> | <fnParam> "COMMA" <fnParamList>
<fnParam>     ::= <type> | "IDENT" "COLON" <type>

# A declaration-site type-application HEAD: a bare TYPE name applied to a MULTI type-arg list
# (`Result[int, str]`, `Pair[int, str]`). Only ever the receiver of a `.member` access / call. The
# multi-arg requirement (≥2 types, i.e. a comma) is what makes it unambiguous against a plain index
# `arr[i]` — a single-arg `Type[int].member` rides the index path and the checker reinterprets it.
<typeApply>     ::= "IDENT" "LBRACKET" <typeListMulti> "RBRACKET"
<typeListMulti> ::= <type> "COMMA" <typeList>

# ===== expressions (precedence cascade, loosest -> tightest) =====
<expr>     ::= <pipeExpr>
# pipe `|>` (M6) is the loosest operator: it threads its left value as the first argument of the
# call on its right, so the right side must end in a call. Left-associative. (The hand parser
# desugars `a |> f(x)` to `f(a, x)` at parse time.)
# LAYOUT CONTINUATION (lexer, not grammar): a line whose first token is `|>` CONTINUES the previous
# logical line — the lexer emits no NEWLINE/INDENT/DEDENT for it, so a multi-line chain
# (`xs\n    |> f()\n    |> g()`) reaches the parser as the single token stream `xs |> f() |> g()`
# and needs no production of its own. A TRAILING `|>` (line ending in `|>`) is NOT a continuation:
# it stays a parse error. Only the exact two-char `|>` continues (`|`, `||`, `|=` do not).
# The offside rule still binds: the `|>` line must be indented at least as deep as the currently
# open block. A SHALLOWER `|>` line dedents out of that block (and is then a parse error) — it is
# never absorbed into the body it sits outside of.
<pipeExpr> ::= <orExpr> | <pipeExpr> "PIPE" <pipeCall>
<pipeCall> ::= <postfix> "LPAREN" "RPAREN" | <postfix> "LPAREN" <exprList> "RPAREN"
<orExpr>   ::= <coalesceExpr> | <orExpr> "OR" <coalesceExpr>
# null-coalescing `??` (gap): looser than `and`/comparisons, tighter than `or`. RIGHT-associative
# (`a ?? b ?? c` = `a ?? (b ?? c)`) — modeled by right-recursion. Lowered to a `match` at desugar.
<coalesceExpr> ::= <andExpr> | <andExpr> "QUESTIONQUESTION" <coalesceExpr>
<andExpr>  ::= <eqExpr>  | <andExpr> "AND" <eqExpr>
# `in` membership sits at the equality level (same precedence as `==`/`!=`); yields a bool.
<eqExpr>   ::= <relExpr> | <eqExpr> "EQEQ" <relExpr> | <eqExpr> "NOTEQ" <relExpr> | <eqExpr> "IN" <relExpr>
<relExpr>  ::= <bitOrExpr>
             | <relExpr> "LT" <bitOrExpr>   | <relExpr> "LTEQ" <bitOrExpr>
             | <relExpr> "GT" <bitOrExpr>   | <relExpr> "GTEQ" <bitOrExpr>
# Bitwise / shift cascade (gap #13), Python's relative order: `|` looser than `^` looser than `&`
# looser than the shifts, which sit just above range. Int-only on int operands; `| & ^` ALSO do set
# algebra (union/intersection/symmetric-difference) on two `Set[T]` (gap #3). `<< >>` stay int-only.
# (Type-directed by the checker; same tokens, no grammar change.)
<bitOrExpr> ::= <bitXorExpr> | <bitOrExpr> "BITOR" <bitXorExpr>
<bitXorExpr>::= <bitAndExpr> | <bitXorExpr> "CARET" <bitAndExpr>
<bitAndExpr>::= <shiftExpr>  | <bitAndExpr> "AMP" <shiftExpr>
<shiftExpr> ::= <rangeExpr>  | <shiftExpr> "SHL" <rangeExpr> | <shiftExpr> "SHR" <rangeExpr>
<rangeExpr>::= <addExpr> | <rangeExpr> "DOTDOT" <addExpr>
<addExpr>  ::= <mulExpr> | <addExpr> "PLUS" <mulExpr> | <addExpr> "MINUS" <mulExpr>
<mulExpr>  ::= <unary>
             | <mulExpr> "STAR" <unary> | <mulExpr> "SLASH" <unary> | <mulExpr> "PERCENT" <unary>
<unary>    ::= <postfix> | "NOT" <unary> | "MINUS" <unary>

# postfix chain: calls, field access, indexing, the `?` try operator, explicit call-site type
# arguments `name[Type, …](args)`, and the scoped `.decode[Type](arg)` form (JSON decode). The
# `[types](` form is parsed speculatively — when the callee is a bare IDENT, OR a `DOT IDENT` field
# over ANY receiver (`recv.method[Type](args)` on any postfix receiver, not just a bare ident — the
# broadened steal), and the `[types](` shape is present; otherwise `LBRACKET … RBRACKET` is plain
# indexing. Uniform rule: `recv.name[X](args)` always parses as a method turbofish on any receiver;
# index-then-call of a fn-valued field therefore requires parens — `(recv.field[k])(args)`.
#
# DECLARATION-SITE TURBOFISH (the whole rule: explicit type args go at the site the generic is
# DECLARED). For a generic TYPE (enum variant ctor or static method) they go ON THE TYPE, uniformly:
#   `Type[T, …].Variant(args)` / `Type[T, …].Variant`   — enum-variant constructor / nullary value
#   `Type[T, …].method(args)`                            — generic static (associated) method
# The OLD gliding form `Enum.Variant[T](args)` (type args on the VARIANT) is REMOVED — the checker
# emits a redirect to the type-side form. STATIC (associated) calls and the type-side turbofish reuse
# the existing postfix shapes, reinterpreted by the checker/compiler when the head is a known
# struct/enum TYPE name; the MULTI-arg head needs one new production (the `<typeApply>` carrier):
#   `Type.method(args)`        — `<postfix> "DOT" "IDENT" "LPAREN" <argList>? "RPAREN"` where the
#                                 leading IDENT is a known struct/enum and `method` is a static method
#                                 (its first param is not `self` — the "no self ⇒ static" rule). For
#                                 an enum a same-named VARIANT wins (so variant/static names are
#                                 disjoint, enforced at decl time).
#   `Type[targ].member(args)?` — SINGLE type arg: parses as `<postfix> "LBRACKET" <subscript>
#                                 "RBRACKET" "DOT" "IDENT" ("LPAREN" <argList>? "RPAREN")?` — the
#                                 parser cannot tell `Type[int].member` from `arr[i].field`, so it
#                                 stays a plain index and the checker reinterprets the single index as
#                                 one type argument (VARIANT-first, else static).
#   `Type[T, …].member(args)?` — MULTI type arg: the disambiguating comma lets the parser commit a
#                                 `<typeApply>` head (real parsed types); the trailing `.member` /
#                                 `(args)` attach via the postfix loop. VARIANT-first, else static.
# The method-level form `Type.method[T](...)` is reserved (rejected by the checker) — turbofish is
# type-level only.
<postfix> ::= <primary>
            | <postfix> "LPAREN" "RPAREN"
            | <postfix> "LPAREN" <argList> "RPAREN"
            | <postfix> "DOT" "IDENT"
            | <postfix> "DOT" "INT"
            | <postfix> "LBRACKET" <subscript> "RBRACKET"   # plain index (no colon) or a Python slice
            | <postfix> "LBRACKET" <typeList> "RBRACKET" "LPAREN" "RPAREN"
            | <postfix> "LBRACKET" <typeList> "RBRACKET" "LPAREN" <exprList> "RPAREN"
            # declaration-site turbofish on a generic TYPE — MULTI type-arg head (`<typeApply>`),
            # followed by a member access / call (`Result[int, str].Ok(5)`) or nullary value
            # (`Pair[int, str].Neither`). The comma is what disambiguates from a plain index.
            | <typeApply> "DOT" "IDENT"
            | <typeApply> "DOT" "IDENT" "LPAREN" "RPAREN"
            | <typeApply> "DOT" "IDENT" "LPAREN" <argList> "RPAREN"
            # member-side declaration-site turbofish — a method's OWN type args (`xs.map[str](f)`,
            # `s.first[int, str](1, "x")`). The receiver is ANY postfix expression: a bare ident, a call
            # result (`W(1).cast[str]("a")`), a field (`h.w.cast[str](x)`), or an index (`xs[0].cast[U](x)`).
            # The parser steals the type list + arg list whenever the receiver is a member access and the
            # `[ <typeList> ] (` shape is present (SPECULATIVE: a non-type-then-call subscript such as
            # `obj.items[0]` or the numeric `arr[0].h[0](x)` backtracks and keeps its plain index meaning).
            # UNIFORM RULE: `recv.name[X](args)` always parses as a method turbofish on ANY receiver, so
            # index-then-call of a fn-VALUED field needs parens — `(recv.name[k])(args)` — on any receiver
            # (this matches the bare-ident receiver, which already required parens). The COMBINED form
            # `Box[int].make[str](x)` (enclosing-type args from PART 1 + this method `[str]`) likewise
            # parses through these productions (the receiver `Box[int]` is itself a postfix) and the
            # CHECKER threads both arg sets; a method turbofish on a generic VARIANT ctor is an error.
            | <postfix> "DOT" "IDENT" "LBRACKET" <typeList> "RBRACKET" "LPAREN" "RPAREN"
            | <postfix> "DOT" "IDENT" "LBRACKET" <typeList> "RBRACKET" "LPAREN" <argList> "RPAREN"
            | <postfix> "QUESTION"
            # optional chaining `?.` (gap): field, tuple-element, or method call through an Option.
            | <postfix> "QUESTIONDOT" "IDENT"
            | <postfix> "QUESTIONDOT" "INT"
            | <postfix> "QUESTIONDOT" "IDENT" "LPAREN" "RPAREN"
            | <postfix> "QUESTIONDOT" "IDENT" "LPAREN" <argList> "RPAREN"

# The inside of a subscript `[ … ]`. With no colon it is a plain index expression; one or two colons
# make it a Python slice `start:end:step`, each component optional (`xs[:]`, `xs[1:]`, `xs[::-1]`,
# `xs[a:b:c]`). The colon is unambiguous here — map-literal / type-annotation / match-arm colons never
# occur inside a subscript bracket — so the parser owns it directly (see parser::parse_subscript),
# replacing the old "parse one expr then check if it's a `..` range" rewrite. The Range operator `..`
# is untouched: it stays the for-loop / match-pattern range (see <rangeExpr>, <patternPrimary>).
<subscript> ::= <expr>
              | "COLON"
              | "COLON" <expr>
              | <expr> "COLON"
              | <expr> "COLON" <expr>
              | "COLON" "COLON"
              | "COLON" "COLON" <expr>
              | "COLON" <expr> "COLON"
              | "COLON" <expr> "COLON" <expr>
              | <expr> "COLON" "COLON"
              | <expr> "COLON" "COLON" <expr>
              | <expr> "COLON" <expr> "COLON"
              | <expr> "COLON" <expr> "COLON" <expr>

# A parenthesized expression is grouping when it holds one expr (`(e)`); a comma makes it a tuple
# — `(e,)` is a 1-element tuple and `(e1, e2, …)` an N-tuple. The empty `()` is not valid.
# Collection literals and the parenthesised forms accept ONE optional trailing comma before the
# closer (`[1, 2,]`, `{1, 2,}`, `{a: 1,}`, `(1, 2,)`). A `(e)` is grouping; a lone `(e,)` (comma
# then `)`) is a 1-element tuple. Comprehension forms take no trailing comma.
#
# A "STR" token is the whole string literal (the lexer has already stripped quotes + resolved
# backslash escapes). Its `{expr}` / `{expr:spec}` interpolations — including the Python-style format
# mini-language after a `:` (see syntax.md §10, implemented in src/fmtspec.rs) — are parsed in a
# SEPARATE post-lexer pass over the STR token's contents (compiler::parse_interpolation),
# so they need NO production here.
# A "BYTES" token is a whole `b"..."` / `b'...'` byte-string literal (the lexer stripped the `b`
# prefix + quotes and resolved escapes, incl. `\xHH`; no `\u`, no interpolation — see syntax.md).
# A "RAWSTR" token is a whole `r"..."` / `r'...'` (or triple `r"""..."""` / `r'''...'''`) raw-string
# literal: VERBATIM contents (the lexer stripped the `r` prefix + quotes only). Unlike STR there is
# NO escape processing (`\n` is backslash-n, `\` is a literal backslash) and NO `{expr}` interpolation
# (braces are literal) — so the post-lexer interpolation pass never sees it. Its type is plain `str`.
# The short form cannot contain its closing quote; the triple form embeds lone quotes (e.g. JSON).
<primary> ::= "INT" | "FLOAT" | "STR" | "BYTES" | "RAWSTR" | "TRUE" | "FALSE" | "IDENT"
            | "LPAREN" <expr> "RPAREN"
            | "LPAREN" <expr> "COMMA" "RPAREN"
            | "LPAREN" <expr> "COMMA" <exprList> "RPAREN"
            | "LPAREN" <expr> "COMMA" <exprList> "COMMA" "RPAREN"
            | "LBRACKET" "RBRACKET"
            | "LBRACKET" <exprList> "RBRACKET"
            | "LBRACKET" <exprList> "COMMA" "RBRACKET"
            | "LBRACKET" <expr> <compClauses> "RBRACKET"
            | "LBRACE" "RBRACE"
            | "LBRACE" <mapEntries> "RBRACE"
            | "LBRACE" <mapEntries> "COMMA" "RBRACE"
            | "LBRACE" <exprList> "RBRACE"
            | "LBRACE" <exprList> "COMMA" "RBRACE"
            | "LBRACE" <expr> <compClauses> "RBRACE"
            | "LBRACE" <mapEntry> <compClauses> "RBRACE"
            | <closure>
            | <matchExpr>
            | <ifExpr>
            | <recoverExpr>

# Brace literals: `{}` is the empty map; `{k: v, …}` (entries with COLON) is a map; `{a, b, …}`
# (bare exprs, no COLON) is a set. The empty set is `Set()`, since `{}` is taken by the map.
<mapEntries> ::= <mapEntry> | <mapEntry> "COMMA" <mapEntries>
<mapEntry>   ::= <expr> "COLON" <expr>

# Comprehensions: `[elem for x in it]` (list), `{elem for x in it}` (set), `{k: v for x in it}`
# (map). One or more `for` clauses (nested/cartesian iteration, first clause outermost — later
# clauses see earlier clauses' bindings); each clause binds one name (or two, for `for k, v in m`)
# and may be followed by zero or more `if` guards (an `if` may follow any clause, even a chain).
<compClauses> ::= <compClause> | <compClause> <compClauses>
<compClause>  ::= "FOR" "IDENT" "IN" <expr>
                | "FOR" "IDENT" "IN" <expr> <compGuards>
                | "FOR" <identList> "IN" <expr>
                | "FOR" <identList> "IN" <expr> <compGuards>
<compGuards>  ::= "IF" <expr> | "IF" <expr> <compGuards>

# Expression-position `match`/`if` (value-producing, distinct from the statement forms above).
# `matchExpr` arms are value-expressions (not blocks); it is multiline + exhaustive. A simple
# statement whose value is a `matchExpr` is terminated by the arm block's DEDENT, not a trailing
# NEWLINE (see the parser's expect_stmt_end). `ifExpr` is inline and requires `else`; the tail may
# chain `elif` (right-associative), so the final `else:` stays mandatory at the end of the chain.
<matchExpr> ::= "MATCH" <expr> "COLON" "NEWLINE" "INDENT" <exprArms> "DEDENT"
<exprArms>  ::= <exprArm> | <exprArm> <exprArms>
<exprArm>   ::= <pattern> "COLON" <expr> "NEWLINE"
                | <pattern> "IF" <expr> "COLON" <expr> "NEWLINE"
<ifExpr>    ::= "IF" <expr> "COLON" <expr> <ifExprTail>
<ifExprTail> ::= "ELSE" "COLON" <expr> | "ELIF" <expr> "COLON" <expr> <ifExprTail>
# Panic-recovery boundary: runs a block, yields `Result[T, Error]` (Ok = trailing value, Err = a
# caught runtime fault). Reuses <block> (inline or indented).
<recoverExpr> ::= "RECOVER" <block>

<closure> ::= "FN" "LPAREN" "RPAREN" "COLON" <expr>
            | "FN" "LPAREN" <params> "RPAREN" "COLON" <expr>
            | "FN" "LPAREN" "RPAREN" "ARROW" <type> "COLON" <expr>
            | "FN" "LPAREN" <params> "RPAREN" "ARROW" <type> "COLON" <expr>

<exprList> ::= <expr> | <expr> "COMMA" <exprList>

# A call argument list: zero or more positional args, then zero or more named args (`name = expr`).
# Positional must precede named — `f(y=2, 1)` is rejected by both the grammar and the parser. Used
# only for ordinary calls; pipe (`|>`) and explicit-type-arg calls take positional <exprList> only.
# An optional trailing comma is permitted after the final argument (`f(1, 2,)`, `f(x=1,)`).
<argList>       ::= <posArgList>
                  | <namedArgList>
                  | <posArgList> "COMMA" <namedArgList>
                  | <posArgList> "COMMA"
                  | <namedArgList> "COMMA"
                  | <posArgList> "COMMA" <namedArgList> "COMMA"
<posArgList>    ::= <expr> | <expr> "COMMA" <posArgList>
<namedArgList>  ::= <namedArg> | <namedArg> "COMMA" <namedArgList>
<namedArg>      ::= "IDENT" "ASSIGN" <expr>
