# std.str — string helpers written in Chezzi (M6c dogfooding).
#
# Built entirely on the core-type str methods (len/split/...) and indexing — no native code. This
# is the "some written in Chezzi" half of the stdlib: it imports nothing native itself, but proves
# Chezzi std modules coexist with the native ones (std.io/math/os) in the same program.

# Is the string empty?
fn is_empty(s: str) -> bool:
    return s.len() == 0

# `s` repeated `n` times ("ab", 3 -> "ababab"). n <= 0 yields "".
fn repeat(s: str, n: int) -> str:
    out := ""
    i := 0
    while i < n:
        out = out + s
        i += 1
    return out

# `s` reversed ("hello" -> "olleh").
fn reverse(s: str) -> str:
    out := ""
    i := s.len() - 1
    while i >= 0:
        out = out + s[i]
        i -= 1
    return out

# Left-pad `s` with `fill` to exactly `width` codepoints ("7", 3, "0" -> "007"). Never shrinks: a
# `width` at or below `s.len()` returns `s` unchanged. A multi-char `fill` is a repeating cycle
# truncated to fit ("a", 4, "xy" -> "xyxa"). An empty `fill` can never reach `width`, so it faults
# rather than looping forever.
fn pad_left(s: str, width: int, fill: str) -> str:
    if fill.len() == 0:
        panic("pad_left: fill must not be empty")
    # Early-out BEFORE the subtraction: Chezzi `-` is checked, so `width - s.len()` on a very
    # negative `width` (down to i64::MIN) would fault instead of returning `s` unchanged.
    if width <= s.len():
        return s
    need := width - s.len()
    pad := ""
    while pad.len() < need:
        pad = pad + fill
    return pad[0 : need] + s

# Split `s` on newlines into a list of lines.
fn split_lines(s: str) -> List[str]:
    return s.split("\n")

# Does `s` end with `suffix`? (mirror of the native `starts_with`). The empty suffix ends every
# string. A suffix longer than `s` can't match, so guard before slicing the tail.
fn ends_with(s: str, suffix: str) -> bool:
    if suffix.len() > s.len():
        return false
    return s[s.len() - suffix.len() : s.len()] == suffix

# First index at which `sub` occurs in `s`, or -1 if absent (mirrors the native list `index_of`).
# The empty substring is found at 0.
fn index_of(s: str, sub: str) -> int:
    m := sub.len()
    if m == 0:
        return 0
    i := 0
    while i + m <= s.len():
        if s[i : i + m] == sub:
            return i
        i += 1
    return -1

# Number of non-overlapping occurrences of `sub` in `s` (`count("aaa", "aa") == 1`). The empty
# substring counts as 0 (no progress would be made enumerating it).
fn count(s: str, sub: str) -> int:
    m := sub.len()
    if m == 0:
        return 0
    n := 0
    i := 0
    while i + m <= s.len():
        if s[i : i + m] == sub:
            n += 1
            i += m
        else:
            i += 1
    return n

# Replace every non-overlapping occurrence of `old` in `s` with `new`, left to right. An empty
# `old` returns `s` unchanged (replacing it would loop forever). Replaced text is never re-scanned.
fn replace(s: str, old: str, new: str) -> str:
    m := old.len()
    if m == 0:
        return s
    out := ""
    i := 0
    while i < s.len():
        if i + m <= s.len() and s[i : i + m] == old:
            out = out + new
            i += m
        else:
            out = out + s[i]
            i += 1
    return out

# Remove `p` from the front of `s` if present, else return `s` unchanged.
fn strip_prefix(s: str, p: str) -> str:
    if s.starts_with(p):
        return s[p.len() : s.len()]
    return s

# Remove `p` from the end of `s` if present, else return `s` unchanged.
fn strip_suffix(s: str, p: str) -> str:
    if ends_with(s, p):
        return s[0 : s.len() - p.len()]
    return s
