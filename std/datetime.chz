# std.datetime — pure-Chezzi civil-calendar date/time on top of native std.time (clock only).
#
# A pure-Chezzi dogfood module: NO native Rust, NO seam. The only system dependency is the clock —
# `std.time.now() -> int` (Unix epoch SECONDS, UTC). Everything else is pure integer arithmetic
# (Howard Hinnant's branch-free civil-calendar algorithms), so it is identical across all three
# engines (interp / VM / --parallel).
#
# ===== CONTRACT (read this — these are load-bearing semantics) =====
# * UTC-ONLY (v1). There is NO timezone or DST handling and NO tz database. Every DateTime is UTC.
#   Timezones/DST are explicitly DEFERRED to a future milestone.
# * WEEKDAY ORIGIN = Sunday=0, Monday=1, ..., Saturday=6. This is CONTRACTUAL and matches the native
#   `std.time` civil math: epoch 0 (1970-01-01) is a Thursday == weekday 4. (NOTE: this differs from
#   Python's `datetime.weekday()` which uses Monday=0 — chosen for consistency with std.time, not
#   Python.)
# * NEGATIVE EPOCHS (pre-1970) are handled correctly. Chezzi `/` and `%` truncate toward zero, which
#   is WRONG for splitting a negative epoch into days+seconds, so every such split routes through the
#   `fdiv`/`fmod` floor-division helpers below — never raw `/`/`%`.
# * DURATION arithmetic operates on epoch INTS (seconds), not DateTime: add_seconds/add_days/
#   diff_seconds/diff_days. Calendar-aware work goes through from_epoch/to_epoch (decompose/recompose).
#
# See docs/stdlib.md §5 for the full contract.

import std.time as time
import std.string as s

# ---- floor-division helpers (Chezzi /,% truncate toward zero; we need floor for negative epochs) ----

# Floor division: fdiv(-7, 2) == -4  (vs -7/2 == -3 which truncates toward zero).
fn fdiv(a: int, b: int) -> int:
    q := a / b
    # if signs differ and the truncated division left a remainder, round down by one
    if (a % b != 0) and ((a < 0) != (b < 0)):
        return q - 1
    return q

# Floored modulo: result has the sign of `b` (always 0..b-1 for positive b).
# fmod(-1, 7) == 6, fmod(-7, 2) == 1.
fn fmod(a: int, b: int) -> int:
    return a - fdiv(a, b) * b

# ---- the DateTime value (a user-defined struct in this module; access as datetime.DateTime) ----

struct DateTime:
    year: int
    month: int
    day: int
    hour: int
    minute: int
    second: int
    weekday: int    # 0=Sunday .. 6=Saturday (contractual)

# ---- leap year / month length ----

# Proleptic Gregorian leap year: divisible by 4, except centuries unless divisible by 400.
fn is_leap_year(y: int) -> bool:
    return (y % 4 == 0) and ((y % 100 != 0) or (y % 400 == 0))

# Number of days in month `m` (1..12) of year `y`. February is leap-aware. A month outside 1..12 is a
# domain violation, not a value: it FAULTS (recoverable via `recover:`), matching Python's
# `calendar.monthrange` IllegalMonthError. Without the guard the fall-through `return 31` made
# `days_in_month(y, 13)` a plausible-looking 31 — silently wrong for a date-validating caller.
fn days_in_month(y: int, m: int) -> int:
    if m < 1 or m > 12:
        panic("days_in_month: month out of range: " + str(m))
    if m == 2:
        if is_leap_year(y):
            return 29
        return 28
    # Apr, Jun, Sep, Nov have 30; the rest 31.
    if m == 4 or m == 6 or m == 9 or m == 11:
        return 30
    return 31

# ---- civil <-> days-since-epoch (Howard Hinnant, proleptic Gregorian, exact incl. negatives) ----

# Days since 1970-01-01 for the civil date (y, m, d). Inverse of civil_from_days.
# days_from_civil(1970,1,1) == 0, (1969,12,31) == -1.
fn days_from_civil(y: int, m: int, d: int) -> int:
    yy := y
    if m <= 2:
        yy = y - 1
    era := fdiv(yy, 400)
    yoe := yy - era * 400                                   # [0, 399]
    mp := m - 3
    if m <= 2:
        mp = m + 9                                          # [0, 11]
    doy := (153 * mp + 2) / 5 + d - 1                       # [0, 365]
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy            # [0, 146096]
    return era * 146097 + doe - 719468

# Civil (year, month, day) for `z` days since 1970-01-01. Inverse of days_from_civil.
fn civil_from_days(z: int) -> (int, int, int):
    zz := z + 719468
    era := fdiv(zz, 146097)
    doe := zz - era * 146097                                # [0, 146096]
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365   # [0, 399]
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)         # [0, 365]
    mp := (5 * doy + 2) / 153                               # [0, 11]
    d := doy - (153 * mp + 2) / 5 + 1                       # [1, 31]
    m := mp + 3
    if mp >= 10:
        m = mp - 9                                          # [1, 12]
    yr := y
    if m <= 2:
        yr = y + 1
    return (yr, m, d)

# ---- weekday ----

# Weekday for `z` days since 1970-01-01: 0=Sunday .. 6=Saturday. Epoch day 0 (Thursday) -> 4.
fn weekday_from_days(z: int) -> int:
    return fmod(z + 4, 7)

# Weekday (0=Sunday..6=Saturday) for an epoch-seconds value.
fn weekday(epoch: int) -> int:
    return weekday_from_days(fdiv(epoch, 86400))

# Full English weekday name for a weekday index (0=Sunday..6=Saturday).
fn weekday_name(wd: int) -> str:
    assert wd >= 0 and wd <= 6, "weekday_name: wd must be 0..6 (0=Sunday)"
    names := ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    return names[wd]

# ---- epoch <-> DateTime ----

# Decompose a Unix epoch-seconds value (UTC) into a DateTime. Negative epochs handled via floor-div.
fn from_epoch(epoch: int) -> DateTime:
    days := fdiv(epoch, 86400)
    tod := fmod(epoch, 86400)
    y, m, d := civil_from_days(days)
    hh := tod / 3600
    mm := (tod % 3600) / 60
    ss := tod % 60
    wd := weekday_from_days(days)
    return DateTime(y, m, d, hh, mm, ss, wd)

# Recompose a DateTime back into Unix epoch-seconds (UTC). Round-trips from_epoch.
fn to_epoch(dt: DateTime) -> int:
    days := days_from_civil(dt.year, dt.month, dt.day)
    return days * 86400 + dt.hour * 3600 + dt.minute * 60 + dt.second

# Current UTC date/time from the system clock (the only system dependency).
fn now() -> DateTime:
    return from_epoch(time.now())

# ---- fixed formatters (no strftime pattern; v1 keeps it tight) ----

# ISO-8601 UTC: "YYYY-MM-DDTHH:MM:SSZ".
fn to_iso8601(dt: DateTime) -> str:
    return to_date_string(dt) + "T" + to_time_string(dt) + "Z"

# Zero-pad a year to >=4 digits, keeping the sign in front for proleptic negative (BCE) years:
# 2024 -> "2024", 999 -> "0999", 0 -> "0000", -44 -> "-0044" (pad_left is sign-unaware).
fn pad_year(y: int) -> str:
    if y < 0:
        return "-" + s.pad_left(str(-y), 4, "0")
    return s.pad_left(str(y), 4, "0")

# Date only: "YYYY-MM-DD".
fn to_date_string(dt: DateTime) -> str:
    yr := pad_year(dt.year)
    mo := s.pad_left(str(dt.month), 2, "0")
    dy := s.pad_left(str(dt.day), 2, "0")
    return yr + "-" + mo + "-" + dy

# Time only: "HH:MM:SS".
fn to_time_string(dt: DateTime) -> str:
    hh := s.pad_left(str(dt.hour), 2, "0")
    mm := s.pad_left(str(dt.minute), 2, "0")
    ss := s.pad_left(str(dt.second), 2, "0")
    return hh + ":" + mm + ":" + ss

# std.time.format style: "YYYY-MM-DD HH:MM:SS".
fn to_string(dt: DateTime) -> str:
    return to_date_string(dt) + " " + to_time_string(dt)

# ---- ISO-8601 / RFC-3339 parsing (string -> DateTime; the inverse of to_iso8601) ----
#
# Accepts "YYYY-MM-DD" (date-only, midnight), "YYYY-MM-DDTHH:MM:SS" (naive == UTC), an optional
# '.fff' fractional part (validated then TRUNCATED — DateTime.second is an int, no sub-second storage),
# and an optional trailing 'Z' or '+HH:MM' / '-HH:MM' offset (normalized to UTC, per RFC-3339 / Go
# time.Parse). Date and time may be separated by 'T' (to_iso8601) or ' ' (to_string), matching Python
# datetime.fromisoformat. A malformed / out-of-range string is a clean Err — never a fault/abort.
# Round-trips: parse_iso8601(to_iso8601(dt)) == dt (weekday included, rebuilt via from_epoch).

# True iff x is one or more ASCII digits (no sign, no whitespace) — strict guard before any to_uint.
fn all_digits(x: str) -> bool:
    if x.len() == 0:
        return false
    for c in x:
        if c < "0" or c > "9":
            return false
    return true

# ASCII digits -> non-negative int. Caller MUST all_digits-guard first (no sign/ws handling, unlike
# int(), which trims whitespace + accepts a leading +/- — too lenient for a fixed-width ISO field).
fn to_uint(x: str) -> int:
    n := 0
    for c in x:
        n = n * 10 + (ord(c) - 48)
    return n

# Exactly-2-ASCII-digit field -> int, else Err (guards every fixed-width ISO field before conversion).
fn field2(x: str) -> Result[int]:
    if x.len() != 2 or not all_digits(x):
        return Err("invalid 2-digit field '" + x + "'")
    return Ok(to_uint(x))

fn parse_iso8601(input: str) -> Result[DateTime]:
    # 1. split date from time on the first 'T' (to_iso8601) or ' ' (to_string); no separator = date-only
    date_part := input
    time_part := ""
    has_time := false
    dt_parts := input.split("T")
    if dt_parts.len() == 1:
        dt_parts = input.split(" ")
    if dt_parts.len() == 2:
        date_part = dt_parts[0]
        time_part = dt_parts[1]
        has_time = true
    elif dt_parts.len() != 1:
        return Err("malformed date/time separator in '" + input + "'")

    # 2. date: optional leading '-' (proleptic negative year, as pad_year emits), then YYYY-MM-DD
    neg := false
    dp := date_part
    if dp.starts_with("-"):
        neg = true
        dp = dp[1:]
    dc := dp.split("-")
    if dc.len() != 3:
        return Err("date must be YYYY-MM-DD, got '" + date_part + "'")
    if not all_digits(dc[0]):
        return Err("invalid year '" + dc[0] + "'")
    # Enforce the year's WIDTH like every other field (month/day/… go through `field2`'s exact-2).
    # The lower bound MIRRORS the emitter: `pad_year` writes >=4 digits ("0999", "-0044"), and more
    # for an extended year — so >=4 (not ==4, which would break the round-trip on what this module
    # itself emits). Without it "24-01-01" silently parsed as year 24.
    if dc[0].len() < 4:
        return Err("year must be 4+ digits, got '" + dc[0] + "'")
    # Bound the year before conversion: an oversized all-digit year would overflow i64 in `to_uint`
    # or downstream `to_epoch` (days * 86400) — a fault, not the clean Err the contract requires.
    # <=9 digits (max 999_999_999) can never overflow to_epoch; every realistic/padded year fits.
    if dc[0].len() > 9:
        return Err("year out of range '" + dc[0] + "'")
    y := to_uint(dc[0])
    if neg:
        y = -y
    m := field2(dc[1])?
    d := field2(dc[2])?

    # 3. time (default midnight); optional tz offset + fractional seconds
    hh := 0
    mm := 0
    ss := 0
    off := 0
    if has_time:
        tp := time_part
        # 3a. peel a trailing tz: 'Z' (UTC) or '+HH:MM' / '-HH:MM' offset. The time itself has only
        #     digits, ':' and '.', so the first '+'/'-' unambiguously marks the offset.
        if tp.ends_with("Z"):
            tp = tp[0 : tp.len() - 1]
        else:
            pi := s.index_of(tp, "+")
            sign := 1
            if pi < 0:
                pi = s.index_of(tp, "-")
                sign = -1
            if pi >= 0:
                oc := tp[pi + 1 :].split(":")
                tp = tp[0:pi]
                if oc.len() != 2:
                    return Err("offset must be +HH:MM / -HH:MM")
                oh := field2(oc[0])?
                om := field2(oc[1])?
                if oh > 23 or om > 59:
                    return Err("offset field out of range")
                off = sign * (oh * 3600 + om * 60)
        # 3b. peel + DISCARD fractional seconds (no sub-second storage — a real ceiling)
        fc := tp.split(".")
        if fc.len() == 2:
            if not all_digits(fc[1]):
                return Err("invalid fractional seconds")
            tp = fc[0]
        elif fc.len() != 1:
            return Err("malformed fractional seconds")
        # 3c. HH:MM:SS
        tc := tp.split(":")
        if tc.len() != 3:
            return Err("time must be HH:MM:SS, got '" + time_part + "'")
        hh = field2(tc[0])?
        mm = field2(tc[1])?
        ss = field2(tc[2])?

    # 4. range-validate BEFORE any civil math (days_from_civil computes garbage for month 13 / day 32).
    #    field2/to_uint are non-negative, so only upper bounds (+ the m<1 / d<1 zero cases) need checks.
    if m < 1 or m > 12:
        return Err("month out of range: " + str(m))
    if d < 1 or d > days_in_month(y, m):
        return Err("day out of range: " + str(d))
    if hh > 23:
        return Err("hour out of range: " + str(hh))
    if mm > 59:
        return Err("minute out of range: " + str(mm))
    if ss > 59:
        return Err("second out of range: " + str(ss))

    # 5. reuse to_epoch/from_epoch: normalizes any non-Z offset to UTC + fills the contractual weekday.
    epoch := to_epoch(DateTime(y, m, d, hh, mm, ss, 0)) - off
    return Ok(from_epoch(epoch))

# ---- duration arithmetic (epoch ints, seconds) ----

# Add `n` seconds to an epoch value.
fn add_seconds(epoch: int, n: int) -> int:
    return epoch + n

# Add `n` whole days (n*86400 seconds) to an epoch value. Negative `n` subtracts.
fn add_days(epoch: int, n: int) -> int:
    return epoch + n * 86400

# Seconds from `b` to `a` (a - b); negative if `a` is earlier.
fn diff_seconds(a: int, b: int) -> int:
    return a - b

# Whole days from `b` to `a`, floored (so a one-second-before is -1 day, not 0).
fn diff_days(a: int, b: int) -> int:
    return fdiv(a - b, 86400)
