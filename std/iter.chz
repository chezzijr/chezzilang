# std.iter — small iterator helpers as generic functions over lists.
#
# `shuffle`/`choice`/`sample` are the generic random-collection helpers: they live here (not under
# `rand.*`) because the native FFI seam carries only engine-neutral scalars — it cannot return a
# generic `List[T]` — so they are written in pure Chezzi and call the native `rand.int` for their
# randomness. (Seed the stream via `rand.seed(n)` for deterministic output.)
#
# Written entirely in Chezzi: these return `List[(...)]`, so they compose with the
# tuple-destructuring `for` (`for i, x in iter.enumerate(xs)`) and comprehensions
# (`[a + b for a, b in iter.zip(xs, ys)]`). No builtin special-casing — ordinary library funcs.
# The empty accumulator `out := []` recovers its element type from each function's return
# annotation (`-> List[(int, T)]`), so the first `push` of a tuple type-checks.

import std.rand

# Pair each element with its 0-based index: `[a, b]` → `[(0, a), (1, b)]`.
fn enumerate[T](xs: List[T]) -> List[(int, T)]:
    out := []
    i := 0
    for x in xs:
        out.push((i, x))
        i = i + 1
    return out

# Zip two lists into a list of pairs, truncating to the shorter length.
fn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]:
    out := []
    n := xs.len()
    if ys.len() < n:
        n = ys.len()
    for i in 0..n:
        out.push((xs[i], ys[i]))
    return out

# The HOFs below are deliberately written in Chezzi (not native Rust) so the per-element callback
# runs through pure VM frames. Under `--parallel` a fiber parks by snapshotting its VM frames; a
# native Rust loop frame (the builtin `xs.map`) can't be snapshotted, so a blocking `recv` / `sleep`
# / socket op inside the callback faults `deadlock`. Reached through these functions the same
# callback parks fine — this is the language-level fix for D5 owe #3 (BEAM's `Enum.map` over a NIF).
# Use `iter.map` (not `xs.map`) when the callback may block under `--parallel`; the native methods
# stay the faster non-blocking path.

# Apply `f` to each element, collecting the results into a new list (BEAM `Enum.map`).
fn map[T, U](xs: List[T], f: fn(T) -> U) -> List[U]:
    out := []
    for x in xs:
        out.push(f(x))
    return out

# Keep the elements for which `pred` returns true, preserving order.
fn filter[T](xs: List[T], pred: fn(T) -> bool) -> List[T]:
    out := []
    for x in xs:
        if pred(x):
            out.push(x)
    return out

# Left-fold: thread `acc` through `f(acc, x)` for each element, starting from `init`.
fn fold[T, A](xs: List[T], init: A, f: fn(A, T) -> A) -> A:
    acc := init
    for x in xs:
        acc = f(acc, x)
    return acc

# (`each` deferred: a void fn-type param `fn(T)` does not yet parse — the grammar requires a `->`
# return on a function type. For side-effecting iteration use a bare `for x in xs:` or `iter.fold`
# threading a dummy accumulator; revisit when void function types land.)

# Left-fold with no seed: the accumulator starts at the first element, `f` combines the rest.
# `xs` must be non-empty — with no seed there is no accumulator to start from, so an empty list
# faults with `reduce: empty list with no initial value` (recoverable; Python raises the same-shaped
# TypeError). Seed it with `iter.fold(xs, init, f)` if the list can be empty.
fn reduce[T](xs: List[T], f: fn(T, T) -> T) -> T:
    if xs.len() == 0:
        panic("reduce: empty list with no initial value")
    acc := xs[0]
    for i in 1..xs.len():
        acc = f(acc, xs[i])
    return acc

# Sum of a list of ints — the free-function form of the `xs.sum()` method, so it can sit on the
# right of a pipe (`xs |> iter.sum()`). Empty list → `0`, exactly like `[].sum()`.
# int-only: the native `sum` method is gated on a numeric element type, so a generic
# `sum[T](xs: List[T]) -> T where T: Add` cannot delegate to it (and has no typed zero for the
# empty case). For a float list use the method: `xs.sum()`.
fn sum(xs: List[int]) -> int:
    return xs.sum()

# The first `n` elements (clamped: `n <= 0` → `[]`, `n >= len` → the whole list).
fn take[T](xs: List[T], n: int) -> List[T]:
    out := []
    i := 0
    while i < n and i < xs.len():
        out.push(xs[i])
        i += 1
    return out

# All but the first `n` elements (clamped: `n <= 0` → the whole list, `n >= len` → `[]`).
fn drop[T](xs: List[T], n: int) -> List[T]:
    out := []
    i := n
    if i < 0:
        i = 0
    while i < xs.len():
        out.push(xs[i])
        i += 1
    return out

# Does `pred` hold for at least one element? (false for the empty list.)
fn any[T](xs: List[T], pred: fn(T) -> bool) -> bool:
    for x in xs:
        if pred(x):
            return true
    return false

# Does `pred` hold for every element? (true for the empty list.)
fn all[T](xs: List[T], pred: fn(T) -> bool) -> bool:
    for x in xs:
        if not pred(x):
            return false
    return true

# The first element for which `pred` holds, `Some(x)`, or `None` if there is none.
fn find[T](xs: List[T], pred: fn(T) -> bool) -> Option[T]:
    for x in xs:
        if pred(x):
            return Some(x)
    return None

# Concatenate a list of lists into one list (one level of nesting, order-preserving).
fn flatten[T](xss: List[List[T]]) -> List[T]:
    out := []
    for xs in xss:
        out.extend(xs)
    return out

# --- Lazy iterator adapters (generators) ---
# These return a lazy `Iterator[T]` (a generator, `yield`), pulling from their source only as the
# consumer pulls — so an infinite source (`count`, `repeat`, `cycle`) composed under `islice`
# terminates. Python `itertools` lineage. The lazy `map`/`filter` are named `imap`/`ifilter`
# because the eager `map`/`filter` above already own those names (Chezzi has no overloading).

# Infinite arithmetic counter: start, start+step, start+2*step, … (Python `itertools.count`).
fn count(start: int = 0, step: int = 1) -> Iterator[int]:
    i := start
    while true:
        yield i
        i = i + step

# `x` forever (`n < 0`) or exactly `n` times (Python `itertools.repeat`).
fn repeat[T](x: T, n: int = -1) -> Iterator[T]:
    if n < 0:
        while true:
            yield x
    else:
        i := 0
        while i < n:
            yield x
            i = i + 1

# Endlessly repeat a list's elements (Python `itertools.cycle`). Empty list = empty/immediately-done
# iterator (the `while` guard never enters), NOT an infinite spin.
fn cycle[T](xs: List[T]) -> Iterator[T]:
    while xs.len() > 0:
        for x in xs:
            yield x

# Yield all of `a`, then all of `b` (Python `itertools.chain`).
# ponytail: two-arg only in v1; varargs / list-of-iters is the follow-up.
fn chain[T](a: List[T], b: List[T]) -> Iterator[T]:
    for x in a:
        yield x
    for x in b:
        yield x

# The first `stop` elements of an iterator, lazily (a prefix; `stop <= 0` = empty). Pulls at most
# `stop` elements from its source, so it terminates an infinite source (Python `itertools.islice`).
fn islice[S: Iterator[T], T](it: S, stop: int) -> Iterator[T]:
    i := 0
    for x in it:
        if i >= stop:
            break
        yield x
        i = i + 1

# Lazy `map`: apply `f` to each element of an iterator, yielding results (the lazy sibling of the
# eager list `map`). Named `imap` because `map` is taken.
fn imap[S: Iterator[T], T, U](it: S, f: fn(T) -> U) -> Iterator[U]:
    for x in it:
        yield f(x)

# Lazy `filter`: keep the elements for which `pred` holds, yielding them (the lazy sibling of the
# eager list `filter`). Named `ifilter` because `filter` is taken.
fn ifilter[S: Iterator[T], T](it: S, pred: fn(T) -> bool) -> Iterator[T]:
    for x in it:
        if pred(x):
            yield x

# --- Random helpers (call native rand.int; seed with rand.seed(n) for deterministic output) ---

# Return a NEW list with the elements of `xs` randomly permuted (Fisher–Yates). Non-mutating:
# `xs` is left untouched (matches std.iter's copy-and-return idiom).
fn shuffle[T](xs: List[T]) -> List[T]:
    out := []
    for x in xs:
        out.push(x)
    # Walk from the high index down, swapping each element with a uniformly-chosen earlier-or-self.
    i := out.len() - 1
    while i > 0:
        j := rand.int(0, i + 1)
        tmp := out[i]
        out[i] = out[j]
        out[j] = tmp
        i -= 1
    return out

# A uniformly-random element of `xs`, `Some(x)`, or `None` if `xs` is empty.
fn choice[T](xs: List[T]) -> Option[T]:
    if xs.len() == 0:
        return None
    return Some(xs[rand.int(0, xs.len())])

# `k` elements drawn WITHOUT replacement (a random subset, in random order). `k` is clamped to
# `[0, len]`. Uses a partial Fisher–Yates on a copy, then takes the first `k`. Non-mutating.
fn sample[T](xs: List[T], k: int) -> List[T]:
    n := xs.len()
    take_n := k
    if take_n > n:
        take_n = n
    if take_n < 0:
        take_n = 0
    pool := []
    for x in xs:
        pool.push(x)
    out := []
    i := 0
    while i < take_n:
        # Pick from the unshuffled tail [i, n), swap into position i, then take it.
        j := rand.int(i, n)
        tmp := pool[i]
        pool[i] = pool[j]
        pool[j] = tmp
        out.push(pool[i])
        i += 1
    return out
