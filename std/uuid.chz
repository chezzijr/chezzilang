# std.uuid — random UUID generation, declared in Chezzi (phase 4e).
#
# FILE-BACKED, IMPORT-GATED native module (same pattern as std/regex.chz). Its functions are in scope
# ONLY after `import std.uuid` (or a `from std.uuid import …`). The resolver loads this real file
# (keeping the `native` marker), and the checker harvests the `native fn` declarations below as the
# module's SIGNATURE source — retiring the hand-built `native_module_sig` uuid arm.
#
# Every declaration is BODY-LESS: the implementations stay native (name-keyed in `src/native/uuid.rs`,
# dispatched via `native_members("std.uuid")`). `v4()` → random UUID str; `uuid_seed(n)` → deterministic
# reseed of the process-global RNG (for golden runs), returning nil.

native fn v4() -> str
native fn uuid_seed(n: int) -> nil
