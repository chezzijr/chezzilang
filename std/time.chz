# std.time — wall-clock + monotonic time, declared in Chezzi (phase 4e).
#
# FILE-BACKED, IMPORT-GATED native module (same pattern as std/regex.chz). Its functions are in scope
# ONLY after `import std.time` (or an `import … from std.time`). The resolver loads this real file
# (keeping the `native` marker), and the checker harvests the `native fn` declarations below as the
# module's SIGNATURE source — retiring the callable half of the hand-built `native_module_sig` time arm.
#
# Every declaration is BODY-LESS: the implementations stay native (name-keyed in `src/native/time.rs`,
# dispatched via `native_members("std.time")`). The backends compile NOTHING for a `native fn` — the
# front-end reads ONLY the signature. `timer` is an ordinary member too: the engine builds its
# channel (`Kind::InterceptTimer`).

native fn now() -> int
native fn now_ms() -> int
native fn monotonic() -> float
native fn sleep_ms(ms: int) -> None
native fn format(ts: int) -> str
native fn timer(ms: int) -> Channel[bool]
