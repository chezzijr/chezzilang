# std.ref — Ref[T], a one-field mutable box.
#
# Written entirely in Chezzi. Capture-by-value snapshots a bare scalar (`int`/`str`/...) when a
# closure captures it, so accumulating into a captured `int` is invisible to the caller. A struct,
# by contrast, is a shared reference (`Rc<RefCell>`), so a closure that closes over a `Ref[T]` and
# mutates it through a method sees — and persists — the change. This is the idiomatic "mutable scalar
# to close over / pass by reference": one box instead of hand-rolling a struct each time.

struct Ref[T]:
    value: T

    # The current value.
    fn get(self) -> T:
        return self.value

    # Replace the value with `v`.
    fn set(self, v: T):
        self.value = v

    # Replace the value with `f(value)`.
    fn update(self, f: fn(T) -> T):
        self.value = f(self.value)
