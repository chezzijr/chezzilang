# std.concurrency.task — result handles for `Executor`-submitted work. Pure Chezzi over existing
# primitives (a cap-1 bounded `Channel[T]` result slot, a `Channel[str]` fault slot, and one
# `Shared` state core) plus one airlock query (`concurrency.is_task_copy`).
#
# WHY: `Executor.submit(f)` is fire-and-forget — it returns nothing, so the only way to get a value
# back is to hand-plumb a result `Channel` and `recv` it yourself. `submit_task` bakes that in: it
# returns a `Task[T]` handle whose `.get()` hands you the value once the work has run.
#
# DETERMINISM / PARITY: a `Task`'s VALUE is deterministic (it is `f()`); only the TIMING of when the
# task runs varies between engines. So `.get()` is byte-identical serial vs M:N **as long as you await
# in a fixed order** (e.g. submission order) — never "whichever finishes first". There is deliberately
# NO `join_next()`/select-on-completion API: completion order is nondeterministic and would break
# parity. Await your tasks in the order you submitted them (or any fixed order) and both engines agree.
#
# MODEL: `submit_task` builds ONE `Shared[TaskState[T]]` core and wraps `f` so the job records
# `Done(v)` in the core before `run_outcome` sends `v`. Every copy of the handle (the parent's, a
# spawned task's, an Executor job's) points at that core, so `done()` and `get()` give the same
# answer in every task: one future, many readers (CPython `Future`, Go channel + `sync.Once`). A job
# fault's message is latched into the core as `Failed(m)` the first time any copy sees it. The job
# is routed through `Executor.submit_outcome`, so on a fault `ch` is CLOSED rather than left empty.
# Like a bare `Executor.submit`, the work STARTS at the submit and is waited for by `shutdown()` (or
# the program-exit join). The canonical shape is: submit every task, `shutdown()`, then `.get()` each.
#
# IDENTITY: the task that holds the original handle caches the value in `cached`, so its repeated
# `get()` returns the SAME object (CPython `fut.result() is fut.result()`). A copy of the handle (a
# spawned task's, an Executor job's) carries `cached` as it was at the crossing, so its `get()`
# returns the value as of the crossing, as every other captured value does (owner decision
# 2026-10-02, TICKET-203); a write to it there faults (D4), as for any captured value. A copy whose
# owner had not called `get()` reads a fresh snapshot from the core. `concurrency.is_task_copy(self)`
# gates only the `cached` write; it reads the same predicate as the D4 write check, so `get()` never
# attempts a write that would fault.

import std.concurrency

# A task's outcome. Shared by every copy of its handle through `Task.core`.
enum TaskState[T]:
    Pending
    Done(T)
    Failed(str)

# A future handle. `core` is the one record of the outcome; `ch`/`err` are the channels
# `run_outcome` settles; `cached` holds the owner's value object; a copy carries it as of the crossing.
# Never block inside `core.update`: a guard held across `ch.recv()` turns a deadlock fault into a hang.
struct Task[T]:
    ch: Channel[T]
    err: Channel[str]
    core: Shared[TaskState[T]]
    cached: Option[T]

    # Block until the result is available, then return it, or re-raise the job's fault (CPython
    # `Future.result()`). Idempotent. `cached` answers first in every task: the owner's alias, or in a
    # copy that alias as it was at the crossing. Only the owner fills it, so a copy whose owner had not
    # called `get()` before the crossing reads a fresh snapshot from the core on each call.
    fn get(self) -> T:
        match self.cached:
            Some(v): return v
            None: pass
        v := _outcome(self)
        if not concurrency.is_task_copy(self):
            self.cached = Some(v)
        return v

    # True once the job has finished, faulted or cancelled. Never blocks.
    fn done(self) -> bool:
        self.core.update(fn(s: TaskState[T]) -> TaskState[T]: _latch_fault(self.err, s))
        match self.core.get():
            TaskState.Pending: return self.ch.len() > 0
            _: return true

# Read `t`'s outcome from the core, waiting on `ch` while it is `Pending`. Returns a fresh snapshot
# of the value, or re-raises the job's fault. Writes nothing to `t` itself.
fn _outcome[T](t: Task[T]) -> T:
    match t.core.get():
        TaskState.Done(v): return v
        TaskState.Failed(m): panic(m)
        TaskState.Pending: pass
    r := recover: t.ch.recv()
    match r:
        Ok(v):
            # Put the value back so the next waiter's `recv` wakes too.
            t.ch.try_send(v)
            return v
        Err(e):
            t.core.update(fn(s: TaskState[T]) -> TaskState[T]: _latch_fault(t.err, s))
            match t.core.get():
                TaskState.Done(v): return v
                TaskState.Failed(m): panic(m)
                TaskState.Pending: panic(e.message())

# Move a `Pending` core to `Failed(m)` when the job's fault message is waiting in `err`. It runs
# under the core's update guard, so it only ever polls (`try_recv`), never blocks.
fn _latch_fault[T](err: Channel[str], s: TaskState[T]) -> TaskState[T]:
    match s:
        TaskState.Pending:
            match err.try_recv():
                Some(m): return TaskState.Failed(m)
                None: return s
        _: return s

# The job body: run `f`, record `Done(v)` in the core, then return `v` for `run_outcome` to send.
fn _record[T](f: fn() -> T, core: Shared[TaskState[T]]) -> T:
    v := f()
    core.set(TaskState.Done(v))
    return v

# Submit `f` to `ex` for detached execution and return a `Task[T]` handle for its result. The work
# starts at the submit and is waited for by `shutdown()` (or exit); `task.get()` then yields `f()`'s
# value, or re-raises the job's fault. Await the handles AFTER `shutdown()`, in a fixed (e.g.
# submission) order, to stay byte-identical across engines.
fn submit_task[T](ex: Executor, f: fn() -> T) -> Task[T]:
    ch := Channel[T](1)
    err := Channel[str](1)
    core := Shared(TaskState[T].Pending)
    ex.submit_outcome(fn() -> T: _record(f, core), ch, err)
    return Task(ch=ch, err=err, core=core, cached=None)
