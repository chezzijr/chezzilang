# std.concurrency.task — result handles for `Executor`-submitted work. Pure Chezzi over existing
# primitives (a cap-1 bounded `Channel[T]` as a one-shot result slot) — it has no native scheduler
# surface of its own.
#
# WHY: `Executor.submit(f)` is fire-and-forget — it returns nothing, so the only way to get a value
# back is to hand-plumb a result `Channel` and `recv` it yourself. `submit_task` bakes that in: it
# returns a `Task[T]` handle whose `.get()` hands you the value once the work has run.
#
# DETERMINISM / PARITY: a `Task`'s VALUE is deterministic (it is `f()`); only the TIMING of when the
# task runs varies between engines. So `.get()` is byte-identical serial vs M:N **as long as you await
# in a fixed order** (e.g. submission order) — never "whichever finishes first". There is deliberately
# NO `join_next()`/select-on-completion API: completion order is nondeterministic and would break
# parity. Await your tasks in the order you submitted them (or any fixed order) and both engines agree.
#
# MODEL: `submit_task` wraps the closure so it sends its result into a private cap-1 channel, then
# hands you a `Task` over that channel. Like a bare `Executor.submit`, the work STARTS at the submit
# and is waited for by `shutdown()` (or the program-exit join). The canonical shape is: submit every
# task, `shutdown()`, then
# `.get()` each. Calling `.get()` BEFORE `shutdown()` is the one shape to avoid — there is no runnable
# sender from the caller's point of view, so it faults `deadlock` rather than waiting.

import std.concurrency

# A future handle over a one-shot cap-1 result channel. `get()` MEMOIZES the value, so it is idempotent
# and cheap to call repeatedly; `done()` polls whether the result has landed without consuming it.
struct Task[T]:
    ch: Channel[T]
    cached: Option[T]

    # Block until the task's result is available, then return it. Idempotent: the first call `recv`s the
    # one-shot channel and caches the value; later calls return the cache (no second `recv`, which would
    # block forever on the now-empty channel).
    fn get(self) -> T:
        match self.cached:
            Some(v):
                return v
            None:
                v := self.ch.recv()
                self.cached = Some(v)
                return v

    # True once the result is available (already fetched, or sitting in the channel). Never blocks.
    fn done(self) -> bool:
        match self.cached:
            Some(_):
                return true
            None:
                return self.ch.len() > 0

# Submit `f` to `ex` for detached execution and return a `Task[T]` handle for its result. The work
# starts at the submit and is waited for by `shutdown()` (or exit); `task.get()` then yields `f()`'s
# value. Await the handles AFTER `shutdown()`, in a fixed (e.g. submission) order, to stay
# byte-identical across engines.
fn submit_task[T](ex: Executor, f: fn() -> T) -> Task[T]:
    # `Executor.submit_result` IS this primitive: submit `f` and hand back a cap-1 `Channel[T]` that
    # carries its one result. `Task` just adds memoization/`done()` over that channel.
    return Task(ch=ex.submit_result(f), cached=None)
