# std.flag — a Go-`flag`-style CLI argument parser, written entirely in Chezzi over `os.args()`.
#
# Build a `FlagSet` with `flag.new()`, register `str`/`bool`/`int` flags on it, then `parse` a
# `List[str]` (typically `os.args()`, which is already the program args WITHOUT argv[0] — the direct
# Go `flag.Parse(os.Args[1:])` analog). Read values back with `get_str`/`get_bool`/`get_int`, the
# leftover positionals with `positionals()`, and print a Go-`PrintDefaults`-style help with `usage()`.
#
# Recognised syntax (Go conventions):
#   --name value      # str/int consume the NEXT token
#   --name=value      # or an inline `=` value
#   --verbose         # a bool flag is presence => true
#   --verbose=false   # ...or set explicitly
#   --                # terminator: every later token is a positional, even if it starts with `-`
# A leading run of dashes is stripped, so a flag named `n` answers to BOTH `-n` and `--n` (a
# deliberate v1 simplification vs strict Go, which registers each spelling separately — add explicit
# short-alias params only if a real need appears). A lone `-` (len 1) is a positional.
#
# Bad USER input never faults: an unknown flag, a missing value, or a non-int for an int flag all
# return a clean `Err`. `get_*` on an UNREGISTERED name is a programmer error and panics — the closer
# analogue is Python's `argparse`, which raises `AttributeError` from `getattr(args, name)` on an
# unregistered destination. (NOT Go-parity: Go's `flag.Lookup` on an unknown name returns `nil`, no
# panic, and has no name-keyed typed getter at all — measured, Go 1.26.)
#
# ponytail: v1 scope is str/bool/int + long/short + `=`-form + positionals + `--` + a usage line.
# Deferred (add when a real need appears): required-flag enforcement, subcommands, duplicate-
# registration detection.

struct FlagSet:
    names: List[str]        # registration order → deterministic usage()
    kind: Map[str, str]     # name -> "str" | "bool" | "int" (also the "is registered?" set)
    help: Map[str, str]     # name -> help text
    strs: Map[str, str]     # str values (seeded with the default at registration)
    bools: Map[str, bool]
    ints: Map[str, int]
    pos: List[str]          # filled by parse() (the leftover non-flag args)

    # Register a string flag with a default value and help text.
    fn str_flag(self, name: str, default: str, help: str):
        self.names.push(name)
        self.kind[name] = "str"
        self.help[name] = help
        self.strs[name] = default

    # Register a bool flag (presence => true) with a default value and help text.
    fn bool_flag(self, name: str, default: bool, help: str):
        self.names.push(name)
        self.kind[name] = "bool"
        self.help[name] = help
        self.bools[name] = default

    # Register an int flag with a default value and help text.
    fn int_flag(self, name: str, default: int, help: str):
        self.names.push(name)
        self.kind[name] = "int"
        self.help[name] = help
        self.ints[name] = default

    # Parse `args` into the registered flags. Returns `Ok(positionals)` on success (folding Go's
    # `Parse()` + `Args()` into one), or a clean `Err` on an unknown flag / missing value / non-int.
    # Never faults on bad input.
    fn parse(self, args: List[str]) -> Result[List[str]]:
        only_pos := false
        i := 0
        n := args.len()
        while i < n:
            tok := args[i]
            if only_pos:
                self.pos.push(tok)
                i += 1
                continue
            if tok == "--":
                only_pos = true
                i += 1
                continue
            if tok.len() > 1 and tok.starts_with("-"):
                body := tok
                while body.starts_with("-"):
                    body = body[1 : body.len()]
                name := body
                inline := ""
                has_inline := false
                eq := body.index_of("=")
                if eq >= 0:
                    name = body[0 : eq]
                    inline = body[eq + 1 : body.len()]
                    has_inline = true
                kind := ""
                match self.kind.get(name):
                    Some(k): kind = k
                    None: return Err("unknown flag --" + name)
                if kind == "bool":
                    if has_inline:
                        # Go strconv.ParseBool accepted set (matches Go flag.Bool).
                        if ["1", "t", "T", "TRUE", "true", "True"].contains(inline):
                            self.bools[name] = true
                        elif ["0", "f", "F", "FALSE", "false", "False"].contains(inline):
                            self.bools[name] = false
                        else:
                            return Err("flag --" + name + ": invalid bool '" + inline + "'")
                    else:
                        self.bools[name] = true
                    i += 1
                    continue
                # str / int: needs a value — inline `=` form, or consume the next token.
                val := ""
                if has_inline:
                    val = inline
                    i += 1
                else:
                    if i + 1 >= n:
                        return Err("flag --" + name + ": missing value")
                    val = args[i + 1]
                    i += 2
                if kind == "int":
                    match val.parse_int():
                        Ok(iv): self.ints[name] = iv
                        Err(m): return Err("flag --" + name + ": " + m)
                else:
                    self.strs[name] = val
                continue
            # a bare non-flag token is a positional
            self.pos.push(tok)
            i += 1
        return Ok(self.pos)

    # The string value of registered flag `name` (its default until parse overwrites it). Panics on
    # an unregistered name — a programmer error, closer to Python argparse's `AttributeError` than
    # to Go (which returns `nil` from `flag.Lookup` on an unknown name, never panics).
    fn get_str(self, name: str) -> str:
        match self.strs.get(name):
            Some(v): return v
            None: panic("flag: unregistered str flag --" + name)

    # The bool value of registered flag `name`. Panics on an unregistered name.
    fn get_bool(self, name: str) -> bool:
        match self.bools.get(name):
            Some(v): return v
            None: panic("flag: unregistered bool flag --" + name)

    # The int value of registered flag `name`. Panics on an unregistered name.
    fn get_int(self, name: str) -> int:
        match self.ints.get(name):
            Some(v): return v
            None: panic("flag: unregistered int flag --" + name)

    # The leftover non-flag arguments, in order (Go `flag.Args()`).
    fn positionals(self) -> List[str]:
        return self.pos

    # The default value of `name` (of kind `kind`) rendered as a string, for `usage()`.
    fn default_str(self, name: str, kind: str) -> str:
        if kind == "str":
            match self.strs.get(name):
                Some(v): return v
                None: return ""
        if kind == "int":
            match self.ints.get(name):
                Some(v): return str(v)
                None: return "0"
        match self.bools.get(name):
            Some(v):
                if v:
                    return "true"
                return "false"
            None: return "false"

    # A Go-`PrintDefaults`-style help block: one line per registered flag, in registration order.
    fn usage(self) -> str:
        lines := []
        for name in self.names:
            kind := ""
            match self.kind.get(name):
                Some(k): kind = k
                None: kind = ""
            h := ""
            match self.help.get(name):
                Some(x): h = x
                None: h = ""
            lines.push("  --" + name + " (" + kind + ") default=" + self.default_str(name, kind) + ": " + h)
        return "\n".join(lines)

# Construct a fresh, empty FlagSet.
fn new() -> FlagSet:
    return FlagSet([], {}, {}, {}, {}, {}, [])
