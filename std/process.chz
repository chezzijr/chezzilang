# std.process — subprocess execution, declared in Chezzi (phase 4f).
#
# FILE-BACKED, IMPORT-GATED native module (like std/regex.chz). Its native TYPE (`ProcResult`) +
# functions are in scope ONLY after `import std.process` (bare `ProcResult`) or a `from std.process
# import …`. The resolver loads this real file (keeping the `native` marker), and the checker harvests
# the `native struct` + `native fn` declarations below as the module's SIGNATURE source — retiring both
# the hand-built `native_module_sig` process arm AND its `export_struct` ProcResult arm.
#
# Every declaration is BODY-LESS: the runtime layout + implementations stay native (name-keyed in
# `src/native/process.rs`, dispatched via `native_members("std.process")`). The backends compile
# NOTHING for a `native fn`/`native struct` — the front-end reads ONLY the signature.
#
# FIELD ORDER IS LOAD-BEARING: `ProcResult`'s field order is positional across the remaining hand-built
# runtime layout copies (compiler `Compiler::new`, interp finalize, `native/process.rs` proc_result_ret,
# and seed_stdlib_structs), drift-guarded by a checker test. Do not reorder without updating all copies.

native struct ProcResult:
    stdout: str
    stderr: str
    code: int

native fn cmd(command: str) -> Result[str]
native fn run(command: str) -> Result[ProcResult]
native fn run_args(command: str, args: List[str]) -> Result[ProcResult]

# W6-4 — binary-capture twins. The `str` forms above NEVER decode lossily: an undecodable stream is a
# clean `Err` naming the twin (`cmd_bytes` for the shell form, `run_args_bytes` for the argv form), the
# ratified B1/R1 answer. Go `cmd.Output()` shape: `Ok(stdout)` on a zero exit, `Err` on a non-zero exit
# or a spawn failure — stderr and the exit code are NOT carried on the bytes path (use `run` for those).
native fn cmd_bytes(command: str) -> Result[bytes]
native fn run_args_bytes(command: str, args: List[str]) -> Result[bytes]
