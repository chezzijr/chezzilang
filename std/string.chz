# std.string — string helpers written in Chezzi (M6c dogfooding).
#
# Built entirely on the core-type str methods (len/split/...) and indexing — no native code. This
# is the "some written in Chezzi" half of the stdlib: it imports nothing native itself, but proves
# Chezzi std modules coexist with the native ones (std.io/math/os) in the same program.

# Is the string empty?
fn is_empty(s: str) -> bool:
    return s.len() == 0

# `s` repeated `n` times ("ab", 3 -> "ababab"). n <= 0 yields "".
fn repeat(s: str, n: int) -> str:
    out := ""
    i := 0
    while i < n:
        out = out + s
        i += 1
    return out

# `s` reversed ("hello" -> "olleh").
fn reverse(s: str) -> str:
    out := ""
    i := s.len() - 1
    while i >= 0:
        out = out + s[i]
        i -= 1
    return out

# Left-pad `s` with `fill` to exactly `width` codepoints ("7", 3, "0" -> "007"). Never shrinks: a
# `width` at or below `s.len()` returns `s` unchanged. A multi-char `fill` is a repeating cycle
# truncated to fit ("a", 4, "xy" -> "xyxa"). An empty `fill` can never reach `width`, so it faults
# rather than looping forever.
fn pad_left(s: str, width: int, fill: str) -> str:
    if fill.len() == 0:
        panic("pad_left: fill must not be empty")
    # Early-out BEFORE the subtraction: Chezzi `-` is checked, so `width - s.len()` on a very
    # negative `width` (down to i64::MIN) would fault instead of returning `s` unchanged.
    if width <= s.len():
        return s
    need := width - s.len()
    pad := ""
    while pad.len() < need:
        pad = pad + fill
    return pad[0 : need] + s

# Split `s` on newlines into a list of lines.
fn split_lines(s: str) -> List[str]:
    return s.split("\n")

# Does `s` end with `suffix`? (mirror of the native `starts_with`). The empty suffix ends every
# string. A suffix longer than `s` can't match, so guard before slicing the tail.
fn ends_with(s: str, suffix: str) -> bool:
    if suffix.len() > s.len():
        return false
    return s[s.len() - suffix.len() : s.len()] == suffix

# First index at which `sub` occurs in `s`, or -1 if absent (mirrors the native list `index_of`).
# The empty substring is found at 0. Thin wrapper over `find` (the generalized from-index search).
fn index_of(s: str, sub: str) -> int:
    return find(s, sub, 0)

# Number of non-overlapping occurrences of `sub` in `s` (`count("aaa", "aa") == 1`). The empty
# substring counts as 0 (no progress would be made enumerating it).
fn count(s: str, sub: str) -> int:
    m := sub.len()
    if m == 0:
        return 0
    n := 0
    i := 0
    while i + m <= s.len():
        if s[i : i + m] == sub:
            n += 1
            i += m
        else:
            i += 1
    return n

# Replace every non-overlapping occurrence of `old` in `s` with `new`, left to right. An empty
# `old` returns `s` unchanged (replacing it would loop forever). Replaced text is never re-scanned.
fn replace(s: str, old: str, new: str) -> str:
    m := old.len()
    if m == 0:
        return s
    out := ""
    i := 0
    while i < s.len():
        if i + m <= s.len() and s[i : i + m] == old:
            out = out + new
            i += m
        else:
            out = out + s[i]
            i += 1
    return out

# Remove `p` from the front of `s` if present, else return `s` unchanged.
fn strip_prefix(s: str, p: str) -> str:
    if s.starts_with(p):
        return s[p.len() : s.len()]
    return s

# Remove `p` from the end of `s` if present, else return `s` unchanged.
fn strip_suffix(s: str, p: str) -> str:
    if ends_with(s, p):
        return s[0 : s.len() - p.len()]
    return s

# Is codepoint `c` cased? (has distinct upper/lower forms). ASCII letters + accented letters are
# cased; digits, punctuation and whitespace are not. Reused by title/swapcase for case-detection.
fn is_cased(c: str) -> bool:
    return c.upper() != c.lower()

# Python `str.capitalize`: first char upper, the rest lower ("hello WORLD" -> "Hello world").
# Empty string is unchanged.
# ponytail: ASCII-guaranteed; exotic case-folding follows Rust Unicode (ß->SS, dotted-I), may differ
# from Python's codepoint behavior on those.
fn capitalize(s: str) -> str:
    if s.len() == 0:
        return s
    return s[0 : 1].upper() + s[1 : s.len()].lower()

# Python `str.title`: upper-case the first cased char of each word, lower-case the rest. A "word"
# boundary is any uncased char (space, digit, apostrophe): "they're" -> "They'Re".
# ponytail: ASCII-guaranteed; full-Unicode case-folding follows Rust, may differ from Python.
fn title(s: str) -> str:
    out := ""
    prev_cased := false
    i := 0
    while i < s.len():
        c := s[i : i + 1]
        if is_cased(c):
            if prev_cased:
                out = out + c.lower()
            else:
                out = out + c.upper()
            prev_cased = true
        else:
            out = out + c
            prev_cased = false
        i += 1
    return out

# Python `str.swapcase`: upper-case chars become lower and vice-versa; uncased chars unchanged.
# ponytail: ASCII-guaranteed; full-Unicode case-folding follows Rust, may differ from Python.
fn swapcase(s: str) -> str:
    out := ""
    i := 0
    while i < s.len():
        c := s[i : i + 1]
        if is_cased(c):
            if c == c.lower():
                out = out + c.upper()
            else:
                out = out + c.lower()
        else:
            out = out + c
        i += 1
    return out

# First index at which `sub` occurs in `s` at or after `from_index`, or -1 if absent (Python
# `str.find` with a start). A negative `from_index` counts from the end (`len + from_index`), clamped
# to 0 if still negative; a `from_index` past the end returns -1 (except the empty substring, found at
# a `from_index` == len). `index_of` is `find(s, sub, 0)`.
fn find(s: str, sub: str, from_index: int) -> int:
    n := s.len()
    start := from_index
    if start < 0:
        start = n + start
        if start < 0:
            start = 0
    if start > n:
        return -1
    m := sub.len()
    if m == 0:
        return start
    i := start
    while i + m <= n:
        if s[i : i + m] == sub:
            return i
        i += 1
    return -1

# Split `s` on `sep` into at most `maxsplit + 1` pieces, from the left (Python `str.split(sep,
# maxsplit)`). `maxsplit < 0` (the default) is unlimited. Consecutive separators yield empty pieces.
# An empty `sep` faults (Python raises ValueError; mirrors `pad_left`'s empty-fill panic).
fn split(s: str, sep: str, maxsplit: int = -1) -> List[str]:
    if sep.len() == 0:
        panic("split: sep must not be empty")
    parts := s.split(sep)
    if maxsplit < 0 or maxsplit >= parts.len() - 1:
        return parts
    out: List[str] = []
    i := 0
    while i < maxsplit:
        out.push(parts[i])
        i += 1
    out.push(sep.join(parts[maxsplit : parts.len()]))
    return out

# Split `s` on `sep` from the RIGHT, at most `maxsplit + 1` pieces (Python `str.rsplit(sep,
# maxsplit)`). `maxsplit < 0` (default) is unlimited and identical to `split`. Empty `sep` faults.
fn rsplit(s: str, sep: str, maxsplit: int = -1) -> List[str]:
    if sep.len() == 0:
        panic("rsplit: sep must not be empty")
    parts := s.split(sep)
    if maxsplit < 0 or maxsplit >= parts.len() - 1:
        return parts
    keep := parts.len() - maxsplit
    out: List[str] = []
    out.push(sep.join(parts[0 : keep]))
    i := keep
    while i < parts.len():
        out.push(parts[i])
        i += 1
    return out

# Split `s` on runs of whitespace, dropping empty pieces (Python no-arg `str.split()`):
# "  a  b " -> ["a", "b"], "" -> []. Whitespace is what the native `trim` treats as blank.
# ponytail: whitespace class is Rust's Unicode White_Space (native trim), not byte-identical to
# Python's str.isspace on a few exotic codepoints; ASCII whitespace is identical.
fn split_whitespace(s: str) -> List[str]:
    out: List[str] = []
    cur := ""
    i := 0
    while i < s.len():
        c := s[i : i + 1]
        if c.trim() == "":
            if cur.len() > 0:
                out.push(cur)
                cur = ""
        else:
            cur = cur + c
        i += 1
    if cur.len() > 0:
        out.push(cur)
    return out
