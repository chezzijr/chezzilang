# std.io — basic input/output, declared in Chezzi (phase 4d).
#
# FILE-BACKED, IMPORT-GATED native module (like std.regex). Functions are in scope ONLY after
# `import std.io` (or a `from std.io import …`) or qualified as `io.print`. The resolver loads this
# real file (keeping the `native` marker); the checker harvests the `native fn` decls below as the
# module's SIGNATURE source — retiring the hand-built `native_module_sig` io arm.
#
# Every declaration is BODY-LESS: the implementations stay native (name-keyed in `src/native/io.rs`,
# dispatched via `native_members("std.io")`). The backends compile NOTHING for a `native fn`.

native fn print(s: str) -> nil
native fn eprint(s: str) -> nil
native fn read_line() -> Option[str]
native fn flush() -> nil
native fn input(prompt: str) -> Option[str]
native fn read_file(path: str) -> Result[str]
native fn write_file(path: str, text: str) -> Result[nil]
# Binary whole-file I/O (R1). `read_file` DECODES UTF-8, so it errs on a binary file — `read_bytes`
# is the escape hatch. Same 64 MB read cap as `read_file`; `write_bytes` (like `write_file`) has none.
# `write_bytes` takes a `bytes` — convert a `bytearray` buffer with `bytes(ba)` (an explicit copy,
# like CPython's `bytes(ba)`; `bytearray` is deliberately NOT assignable to a `bytes` sink).
native fn read_bytes(path: str) -> Result[bytes]
native fn write_bytes(path: str, data: bytes) -> Result[nil]

# Writer / file-handle type (R2) — buffered + streaming write-only output. `Writer` is a RESERVED
# opaque VM handle (`Ty::Writer`, NOT a nominal struct — no field layout), and the openers + methods
# stay VM-intercepted at runtime (they allocate a handle over an `Arc`'d core). The backends compile
# NOTHING for a `native fn`/`native struct` — the front-end reads ONLY the signature.
#
# Two verbs, not a mode string: `create` = truncate+create, `append` = append (create-if-absent,
# never truncates) — Go-consistent (`os.Create`). Text vs binary is per-CALL: `write(str)` UTF-8-
# encodes, `write_bytes(bytes)` is raw. `stdout()`/`stderr()` route through the SAME sink as
# `io.print` (byte-identical to `io.print(s, end="")`), NOT a raw fd. `buffered(w, size = 8192)` is
# the Go `bufio.NewWriter` escape hatch: it accumulates in the VM and does ONE host/fd write per
# `flush` / buffer-full / `close` (8 KiB default). Forgetting `flush`/`close` on a buffered writer
# loses the tail (Go's footgun) — mitigated by a best-effort flush on the handle's drop, but explicit
# `close()` is the contract. `flush()` on unbuffered `stdout` is an honest no-op; `buffered(...).flush()`
# is the real thing. Every fallible entry returns a `Result` (open: perms/missing dir; write: ENOSPC).
native struct Writer:
    native fn write(self, data: str) -> Result[int]
    native fn write_bytes(self, data: bytes) -> Result[int]
    native fn flush(self) -> Result[nil]
    native fn close(self) -> Result[nil]

native fn create(path: str) -> Result[Writer]
native fn append(path: str) -> Result[Writer]
native fn stdout() -> Writer
native fn stderr() -> Writer
native fn buffered(w: Writer, size: int = 8192) -> Writer

# Reader / file-handle type (R2b) — the READ twin of `Writer`: line/chunk streaming of a large file,
# so a big file need not be slurped whole (unlike `read_file`/`read_bytes`, capped at 64 MiB). `Reader`
# is a RESERVED opaque VM handle (`Ty::Reader`, NOT a nominal struct) opened read-only by `open(path)`.
#
# `read_line()` yields one line at a time — trailing `\n` (and a preceding `\r`) STRIPPED, `None` at
# EOF — matching the module-level `read_line()` shape. It is `Option[str]`, NOT a `Result`: a mid-read
# I/O error or a non-UTF-8 file surfaces as a runtime FAULT pointing at `read_bytes` (mirroring
# `read_file`'s non-UTF-8 fault); `read_bytes(n) -> Result[bytes]` is the binary + error-distinguishing
# escape hatch (at-most-n bytes; empty bytes = EOF; `Err` on a closed reader / I/O). `close()` releases
# the fd (idempotent). A method on a closed reader is clean: `read_bytes`/`close` return `Result::Err` /
# `Ok`, `read_line` faults cleanly (an `Option` can't carry the error).
#
# `lines() -> Iterator[str]` is deliberately NOT provided yet: the cursor model snapshots eagerly (would
# read the whole file, defeating streaming), so a lazy file-backed cursor is a distinct follow-up. Loop
# `read_line()` in a `while` for now.
native struct Reader:
    native fn read_line(self) -> Option[str]
    native fn read_bytes(self, n: int) -> Result[bytes]
    native fn close(self) -> Result[nil]

native fn open(path: str) -> Result[Reader]
