# std.io — basic input/output, declared in Chezzi (phase 4d).
#
# FILE-BACKED, IMPORT-GATED native module (like std.regex). Functions are in scope ONLY after
# `import std.io` (or an `import … from std.io`) or qualified as `io.print`. The resolver loads this
# real file (keeping the `native` marker); the checker harvests the `native fn` decls below as the
# module's SIGNATURE source — retiring the hand-built `native_module_sig` io arm.
#
# Every declaration is BODY-LESS: the implementations stay native (name-keyed in `src/native/io.rs`,
# dispatched via `native_members("std.io")`). The backends compile NOTHING for a `native fn`.

native fn print(s: str) -> nil
native fn eprint(s: str) -> nil
native fn read_line() -> Option[str]
# Drain ALL remaining stdin to EOF as one str (Python `sys.stdin.read()`); "" at a clean EOF. Shares
# the ONE stdin source with `read_line` (a later read then sees EOF). Non-UTF-8 real stdin is a
# runtime FAULT — there is no stdin `read_bytes` hatch.
native fn read_all() -> str
# Read one Unicode scalar as a 1-char str (Chezzi has no `char` scalar); None at a clean EOF, a
# runtime FAULT on a partial/invalid UTF-8 sequence at EOF.
native fn read_char() -> Option[str]
native fn flush() -> nil
# TTY detection (gaps §6) — true when the given stream is a real terminal, false when piped/redirected
# (Python `sys.stdout.isatty()`, Go `isatty`-equivalent). Lets a CLI colorize only when not piped.
native fn isatty() -> bool
native fn isatty_stdin() -> bool
native fn isatty_stderr() -> bool
native fn input(prompt: str) -> Option[str]
# W7-8 — the INTERNAL byte seam (raw OS `bytes` path in); see std/fs.chz for the convention. The
# PUBLIC wrappers below take a `PathLike`, so a bare `str` literal still works with no annotation.
native fn _read_file(path: bytes) -> Result[str]
native fn _write_file(path: bytes, text: str) -> Result[nil]
native fn _read_bytes(path: bytes) -> Result[bytes]
native fn _write_bytes(path: bytes, data: bytes) -> Result[nil]

fn read_file(p: PathLike) -> Result[str]:
    return _read_file(p.as_path())

fn write_file(p: PathLike, text: str) -> Result[nil]:
    return _write_file(p.as_path(), text)

# Binary whole-file I/O (R1). `read_file` DECODES UTF-8, so it errs on a binary file — `read_bytes`
# is the escape hatch. Same 64 MB read cap as `read_file`; `write_bytes` (like `write_file`) has none.
# `write_bytes` takes a `bytes` DATA arg — convert a `bytearray` buffer with `bytes(ba)` (an explicit
# copy, like CPython's `bytes(ba)`; `bytearray` is deliberately NOT assignable to a `bytes` sink).
fn read_bytes(p: PathLike) -> Result[bytes]:
    return _read_bytes(p.as_path())

fn write_bytes(p: PathLike, data: bytes) -> Result[nil]:
    return _write_bytes(p.as_path(), data)

# Writer / file-handle type (R2) — buffered + streaming write-only output. `Writer` is a RESERVED
# opaque VM handle (`Ty::Writer`, NOT a nominal struct — no field layout), and the openers + methods
# stay VM-intercepted at runtime (they allocate a handle over an `Arc`'d core). The backends compile
# NOTHING for a `native fn`/`native struct` — the front-end reads ONLY the signature.
#
# Two verbs, not a mode string: `create` = truncate+create, `append` = append (create-if-absent,
# never truncates) — Go-consistent (`os.Create`). Text vs binary is per-CALL: `write(str)` UTF-8-
# encodes, `write_bytes(bytes)` is raw — byte-exact on EVERY backing, console included (W6-9), like
# Python's `sys.stdout.buffer.write` / Go's `os.Stdout.Write`. `stdout()`/`stderr()` route through the SAME sink as
# `io.print` (byte-identical to `io.print(s, end="")`), NOT a raw fd. `buffered(w, size = 8192)` is
# the Go `bufio.NewWriter` escape hatch: it accumulates in the VM and does ONE host/fd write per
# `flush` / buffer-full / `close` (8 KiB default). Forgetting `flush`/`close` on a buffered writer
# loses the tail (Go's footgun) — mitigated by a best-effort flush on the handle's drop, but explicit
# `close()` is the contract. `flush()` on unbuffered `stdout` is an honest no-op; `buffered(...).flush()`
# is the real thing. Every fallible entry returns a `Result` (open: perms/missing dir; write: ENOSPC).
native struct Writer:
    native fn write(self, data: str) -> Result[int]
    native fn write_bytes(self, data: bytes) -> Result[int]
    native fn flush(self) -> Result[nil]
    native fn close(self) -> Result[nil]

native fn _create(path: bytes) -> Result[Writer]
native fn _append(path: bytes) -> Result[Writer]

fn create(p: PathLike) -> Result[Writer]:
    return _create(p.as_path())

fn append(p: PathLike) -> Result[Writer]:
    return _append(p.as_path())

native fn stdout() -> Writer
native fn stderr() -> Writer
native fn buffered(w: Writer, size: int = 8192) -> Writer

# Reader / file-handle type (R2b) — the READ twin of `Writer`: line/chunk streaming of a large file,
# so a big file need not be slurped whole (unlike `read_file`/`read_bytes`, capped at 64 MiB). `Reader`
# is a RESERVED opaque VM handle (`Ty::Reader`, NOT a nominal struct) opened read-only by `open(path)`.
#
# `read_line()` has THREE outcomes, not two — the `Option[str]` in the signature only spells two of
# them. `Some(line)` (trailing `\n`, and a preceding `\r`, STRIPPED — the module-level `read_line()`
# shape), `None` at EOF, and a recoverable FAULT on a mid-read I/O error or an undecodable line. It is
# `Option[str]`, NOT a `Result`: a mid-read
# I/O error or a non-UTF-8 file surfaces as a runtime FAULT pointing at `read_bytes` (mirroring
# `read_file`'s non-UTF-8 fault); `read_bytes(n) -> Result[bytes]` is the binary + error-distinguishing
# escape hatch (at-most-n bytes; empty bytes = EOF; `Err` on a closed reader / I/O). `close()` releases
# the fd (idempotent). A method on a closed reader is clean: `read_bytes`/`close` return `Result::Err` /
# `Ok`, `read_line` faults cleanly (an `Option` can't carry the error).
#
# The non-UTF-8 fault is NON-DESTRUCTIVE (W7-9): the line `read_line` could not decode is CARRIED —
# its raw bytes, terminator included — and `read_bytes` hands them back byte-exactly as a carry-only
# SHORT read (the fd is untouched until the carry drains), exactly like `Socket.read`'s carry. So the
# fault's advice actually works. The carry makes the fault STICKY (a re-read re-decodes and re-faults,
# it never skips the bad line — draining it with `read_bytes`, or `close`, is how you move on) and
# SELF-HEALING (a partial drain leaves a remainder that, if it decodes, becomes the next line).
# `close()` discards the carry; a carry is never served after close nor resurrected after EOF.
#
# The stickiness is DELIBERATE and ancestor-checked (measured 2026-08-17 on `b"alpha\nbad\xff\xfebytes\n
# gamma\n"`; the full transcripts are in the W8 dogfood session log). CPython 3.14 `open(...,'r')` is
# WORSE, not better: the very first `readline()` raises `UnicodeDecodeError` — losing the valid line
# BEFORE the bad one, because `TextIOWrapper` decodes a whole chunk — and every subsequent `readline()`
# then returns `''`, i.e. a SILENT EOF claim over data that is still in the file. Go `bufio.Scanner`
# advances and hands back the raw bytes, but only because a Go `string` may hold invalid UTF-8; a Chezzi
# `str` may not, so that option does not exist here. Chezzi's fault therefore loses nothing and stays
# loud (`correct > silent > wrong`) — do NOT "fix" it into a skip.
#
# `lines()` (Python `for l in f` / Go `bufio.Scanner` / Rust `BufRead::lines`) is the idiomatic method
# form of line-streaming: a BODIED Chezzi generator method on the native handle (mixing Rust-backed
# `native fn` sigs with a pure-Chezzi `fn` on one native struct). It streams lazily over `read_line()`
# — the file is NOT snapshotted; the generator suspends between lines. A mid-read non-UTF-8 fault
# surfaces from the underlying `read_line()` exactly as the `while` form — carry and stickiness
# included, so a `lines()` loop cannot step over an undecodable line (drain it with `read_bytes`).
native struct Reader:
    native fn read_line(self) -> Option[str]
    native fn read_bytes(self, n: int) -> Result[bytes]
    native fn close(self) -> Result[nil]
    fn lines(self) -> Iterator[str]:
        while true:
            match self.read_line():
                Some(l): yield l
                None: break

native fn _open(path: bytes) -> Result[Reader]

fn open(p: PathLike) -> Result[Reader]:
    return _open(p.as_path())
