# std.json — JSON parse / stringify, written in Chezzi (dogfoods the language).
#
# `Json` is the dynamic representation: every JSON value is exactly one of six shapes.
# Use `parse` to read a string into a `Json` tree, `stringify` to serialize one back, and
# the `as_*` / `get` / `at` accessors to pull typed values out without a full `match`.
# (For decoding straight into a struct or typed map, see `json.decode[T]` — built on top.)

enum Json:
    Null
    Bool(bool)
    # An integer-shaped numeral stays an integer end-to-end (docs/gaps.md W8-35): Chezzi has no
    # bignum, so this covers the i64 window; a numeral outside it falls back to `Num`.
    Int(int)
    # A fractional or exponent-form numeral, or an integer numeral outside the i64 window.
    Num(float)
    Str(str)
    Arr(List[Json])
    Obj(Map[str, Json])

# Opcode-backed runtime seam for `encode`, exactly like `std.time.timer` — the compiler lowers this
# bare call to `Op::JsonToValue` at its one call site below. Module-private: the module-export pass
# has no `StmtKind::Native` arm, so `json._to_json` is unreachable from user code. `std.json`
# deliberately stays a NON-native module (`harvest_native_module` has no pass for a plain `enum` or
# a plain `struct`, and this module declares both), so this is the seam instead of a native member.
native fn _to_json(x: Any) -> Json

# The `dumps`-shaped inverse of `decode[T]` (docs/gaps.md W8-20): `encode(x)` walks a struct/list/
# map/scalar value into `Json` and serializes it in one call, so `decode[T](encode(x))` gives back
# `x`. An int encodes as `Json.Int` and never passes through f64 (the W8-35 split this ticket also
# fixes). A non-encodable value (a `Result`, a non-`Option` enum, a function, …) faults recoverably;
# see `_to_json`'s runtime walk (`Vm::json_of`) for the exact fault messages.
fn encode(x: Any) -> str:
    return stringify(_to_json(x))

# ----- parsing -------------------------------------------------------------------------------

# A cursor over the input's codepoints. Fields mutate in place across method calls.
# `depth` tracks array/object nesting: `parse_value` is recursive-descent, so nesting depth in the
# INPUT becomes call-stack depth in the program. Attacker-controlled input could otherwise recurse
# past the VM's `maximum call depth` guard and abort the whole process — a fault `Result` can't
# express, so a caller who correctly matched `Ok`/`Err` would still need to remember to wrap the
# call in `recover:` to survive it. `MAX_NEST_DEPTH` keeps parsing inside that budget so a too-deep
# document instead returns a clean `Err` on its own, no `recover:` needed — matching Go's
# `encoding/json` and CPython's `json.loads`, both total. Measured on the release binary
# (2026-08-18): a `[`-only document dies at nesting depth 5000 with no surrounding call frames (each
# level costs 2 VM frames against the 10 000 cap); depth 2000 leaves ample headroom for caller frames
# above `parse` and is still >6x deeper than any realistic document.
MAX_NEST_DEPTH := 2000

struct Parser:
    src: List[str]
    pos: int
    len: int
    depth: int

    fn peek(self) -> str:
        if self.pos >= self.len:
            return ""
        return self.src[self.pos]

    fn bump(self) -> str:
        c := self.peek()
        self.pos += 1
        return c

    fn skip_ws(self):
        while self.pos < self.len:
            c := self.src[self.pos]
            if c == " " or c == "\t" or c == "\n" or c == "\r":
                self.pos += 1
            else:
                return

    # The message with the exact spot in the input it was raised at appended: ` at line L column C
    # (char N)` — CPython's `json.loads` shape. Uses the CURRENT position.
    fn at(self, msg: str) -> str:
        return self.at_pos(msg, self.pos)

    fn at_pos(self, msg: str, pos: int) -> str:
        p := pos
        if p > self.len:
            p = self.len
        if p < 0:
            p = 0
        line := 1
        col := 1
        for i in 0..p:
            if self.src[i] == "\n":
                line += 1
                col = 1
            else:
                col += 1
        return msg + " at line " + str(line) + " column " + str(col) + " (char " + str(pos) + ")"

    fn parse_value(self) -> Result[Json]:
        self.skip_ws()
        c := self.peek()
        if c == "":
            return Err(self.at("unexpected end of input"))
        if c == "{{":
            return self.parse_object()
        if c == "[":
            return self.parse_array()
        if c == "\"":
            s := self.parse_string()?
            return Ok(Json.Str(s))
        if c == "t":
            return self.parse_lit("true", Json.Bool(true))
        if c == "f":
            return self.parse_lit("false", Json.Bool(false))
        if c == "n":
            return self.parse_lit("null", Json.Null)
        if c == "-" or (c >= "0" and c <= "9"):
            return self.parse_number()
        return Err(self.at("unexpected character '" + c + "'"))

    fn parse_lit(self, word: str, val: Json) -> Result[Json]:
        start := self.pos
        for expected in word:
            if self.bump() != expected:
                return Err(self.at_pos("invalid literal, expected '" + word + "'", start))
        return Ok(val)

    fn parse_string(self) -> Result[str]:
        open_quote := self.pos
        self.pos += 1                       # consume the opening quote
        out := ""
        while true:
            if self.pos >= self.len:
                # The OPENING quote: CPython's json.loads and docs/gaps.md M24-7 both point an
                # unterminated delimiter at its opener.
                return Err(self.at_pos("unterminated string", open_quote))
            c := self.bump()
            if c == "\"":
                return Ok(out)
            if c == "\\":
                e := self.bump()
                match e:
                    "\"": out = out + "\""
                    "\\": out = out + "\\"
                    "/": out = out + "/"
                    "n": out = out + "\n"
                    "t": out = out + "\t"
                    "r": out = out + "\r"
                    "b": out = out + chr(8)
                    "f": out = out + chr(12)
                    "u": out = out + self.parse_unicode()?
                    _: return Err(self.at_pos("invalid escape '\\" + e + "'", self.pos - 1))
            elif ord(c) < 32:
                # RFC-8259: raw control chars U+0000..U+001F must be `\u`-escaped, never literal.
                return Err(self.at_pos("invalid control character in string", self.pos - 1))
            else:
                out = out + c

    # A `\uXXXX` escape, combining a high+low surrogate pair into one codepoint.
    fn parse_unicode(self) -> Result[str]:
        hi := self.parse_hex4()?
        if hi >= 55296 and hi <= 56319:                 # high surrogate
            if self.bump() != "\\" or self.bump() != "u":
                return Err(self.at("expected low surrogate"))
            lo := self.parse_hex4()?
            if lo < 56320 or lo > 57343:
                return Err(self.at("invalid low surrogate"))
            cp := 65536 + (hi - 55296) * 1024 + (lo - 56320)
            return Ok(chr(cp))
        if hi >= 56320 and hi <= 57343:
            return Err(self.at("unexpected low surrogate"))
        return Ok(chr(hi))

    fn parse_hex4(self) -> Result[int]:
        n := 0
        for i in 0..4:
            c := self.bump()
            match hex_val(c):
                Ok(d): n = n * 16 + d
                # `hex_val` is a free fn with no `self`, so the location wraps here instead.
                Err(m): return Err(self.at_pos(m.message(), self.pos - 1))
        return Ok(n)

    fn parse_number(self) -> Result[Json]:
        # Scan a JSON number, validating its shape FIRST so `float(raw)` below only ever sees a
        # well-formed numeral (a bad numeral would otherwise abort the program, not return Err).
        start := self.pos
        if self.peek() == "-":
            self.pos += 1
        int_digits := 0
        zero_first := (self.peek() == "0")
        while is_digit(self.peek()):
            self.pos += 1
            int_digits += 1
        if int_digits == 0:
            return Err(self.at_pos("invalid number: expected a digit", start))
        # RFC-8259: the integer part is either a single `0` or a nonzero digit followed by more —
        # a leading `0` before another digit (`01`, `007`) is invalid.
        if zero_first and int_digits > 1:
            return Err(self.at_pos("invalid number: leading zero", start))
        # An integer-shaped numeral stays integer-shaped until a `.`/`e`/`E` proves otherwise.
        is_int := true
        if self.peek() == ".":
            is_int = false
            dot := self.pos
            self.pos += 1
            frac := 0
            while is_digit(self.peek()):
                self.pos += 1
                frac += 1
            if frac == 0:
                return Err(self.at_pos("invalid number: digits required after '.'", dot))
        if self.peek() == "e" or self.peek() == "E":
            is_int = false
            # The e/E itself, not self.pos - 1: this branch may consume a '+'/'-' sign after it.
            exp_at := self.pos
            self.pos += 1
            if self.peek() == "+" or self.peek() == "-":
                self.pos += 1
            exp := 0
            while is_digit(self.peek()):
                self.pos += 1
                exp += 1
            if exp == 0:
                return Err(self.at_pos("invalid number: digits required in exponent", exp_at))
        raw := ""
        for i in start..self.pos:
            raw = raw + self.src[i]
        if is_int:
            match raw.to_int():
                Some(i): return Ok(Json.Int(i))
                # Outside the i64 window: Chezzi has no bignum, so fall back to the lossy f64 path.
                None: return self.num_float(raw, start)
        return self.num_float(raw, start)

    fn num_float(self, raw: str, start: int) -> Result[Json]:
        f := float(raw)
        # Go's `encoding/json` rejects a numeral that overflows f64 (`1e400` → +inf) AT DECODE, so we
        # never manufacture a `Json.Num(inf/-inf/NaN)` that our own `stringify` (num_str) would then
        # refuse to serialize. `f - f` is `0.0` for every finite `f` and NaN for a non-finite one.
        # (Underflow like `1e-400` → `0.0` is finite and stays accepted.)
        if f - f != 0.0:
            return Err(self.at_pos("invalid number: value out of range", start))
        return Ok(Json.Num(f))

    fn parse_array(self) -> Result[Json]:
        # `?` on a nested `parse_value` propagates an `Err` straight out of the whole `parse()`
        # call (no mid-parse recovery reuses this `Parser`), so `depth` only needs decrementing on
        # the SUCCESS paths below — a sibling array at the same nesting level must see `depth` back
        # where it started, not inflated by an earlier sibling's subtree.
        self.depth += 1
        if self.depth > MAX_NEST_DEPTH:
            return Err("exceeded max depth")
        self.pos += 1                       # consume '['
        items := []
        self.skip_ws()
        if self.peek() == "]":
            self.pos += 1
            self.depth -= 1
            return Ok(Json.Arr(items))
        while true:
            v := self.parse_value()?
            items.push(v)
            self.skip_ws()
            c := self.bump()
            if c == "]":
                self.depth -= 1
                return Ok(Json.Arr(items))
            if c != ",":
                return Err(self.at_pos("expected ',' or ']' in array", self.pos - 1))

    fn parse_object(self) -> Result[Json]:
        self.depth += 1
        if self.depth > MAX_NEST_DEPTH:
            return Err("exceeded max depth")
        self.pos += 1                       # consume '{'
        obj := {}
        self.skip_ws()
        if self.peek() == "}}":
            self.pos += 1
            self.depth -= 1
            return Ok(Json.Obj(obj))
        while true:
            self.skip_ws()
            if self.peek() != "\"":
                return Err(self.at("expected string key in object"))
            key := self.parse_string()?
            self.skip_ws()
            if self.bump() != ":":
                return Err(self.at_pos("expected ':' after object key", self.pos - 1))
            v := self.parse_value()?
            obj[key] = v
            self.skip_ws()
            c := self.bump()
            if c == "}}":
                self.depth -= 1
                return Ok(Json.Obj(obj))
            if c != ",":
                return Err(self.at_pos("expected ',' or '}}' in object", self.pos - 1))

fn is_digit(c: str) -> bool:
    return c >= "0" and c <= "9"

fn hex_val(c: str) -> Result[int]:
    if c >= "0" and c <= "9":
        return Ok(ord(c) - ord("0"))
    if c >= "a" and c <= "f":
        return Ok(ord(c) - ord("a") + 10)
    if c >= "A" and c <= "F":
        return Ok(ord(c) - ord("A") + 10)
    return Err("invalid hex digit '" + c + "'")

# Parse a JSON document into a `Json` tree. Trailing non-whitespace is an error.
fn parse(s: str) -> Result[Json]:
    p := Parser(s.chars(), 0, s.len(), 0)
    v := p.parse_value()?
    p.skip_ws()
    if p.pos < p.len:
        return Err(p.at("trailing characters after JSON value"))
    return Ok(v)

# ----- serializing ---------------------------------------------------------------------------

fn escape(s: str) -> str:
    # Control chars U+0000..U+001F with no shorthand escape become `\u00XX` (Go `encoding/json`
    # / RFC-8259 policy); emitting the raw byte would produce invalid JSON that `json.parse`
    # (and Python) reject as an "invalid control character".
    hex := "0123456789abcdef"
    out := "\""
    for c in s:
        n := ord(c)
        if c == "\"":
            out = out + "\\\""
        elif c == "\\":
            out = out + "\\\\"
        elif n == 10:
            out = out + "\\n"
        elif n == 9:
            out = out + "\\t"
        elif n == 13:
            out = out + "\\r"
        elif n == 8:
            out = out + "\\b"
        elif n == 12:
            out = out + "\\f"
        elif n < 32:
            out = out + "\\u00" + hex[n / 16] + hex[n % 16]
        else:
            out = out + c
    return out + "\""

# Render a `Json.Num` float. `Json.Int` (a separate variant) covers the integer case, so a `Num`
# always renders as a float — CPython prints `3.0` for `json.dumps(3.0)` and `3` for
# `json.dumps(3)`; the same split holds here since `str(f)` matches CPython's `repr(f)` shape.
fn num_str(f: float) -> str:
    # Standard JSON has no NaN/Infinity. A non-finite float (NaN / +inf / -inf) can never round-trip
    # through valid JSON (Chezzi's own `json.parse` rejects the bare tokens), so FAULT loudly rather
    # than emit malformed output. `f - f` is `0.0` for every finite `f` and NaN for non-finite `f`
    # (inf-inf, -inf - -inf and NaN-NaN are all NaN), and NaN != 0.0 — so this fires iff `f` is
    # non-finite.
    if f - f != 0.0:
        panic("cannot serialize non-finite float to JSON")
    return str(f)

# Serialize a `Json` tree to a JSON document. `Arr`/`Obj` recurse structurally, so a tree built
# directly (no `parse` involved — `j = Json.Arr([j])` in a loop) can nest past the VM's `maximum
# call depth` guard just like `parse` can (`docs/gaps.md` W8-5). Unlike `parse`, `stringify` has no
# `Result` to put an error in and CPython's `json.dumps` also raises `RecursionError` here — so this
# stays a fault, just a LEGIBLE one naming the cause instead of an opaque VM message pointing at a
# `std/json.chz` line the caller never opened. Same measured depth limit as `parse` (`MAX_NEST_DEPTH`).
fn stringify(j: Json) -> str:
    return stringify_depth(j, 0)

fn stringify_depth(j: Json, depth: int) -> str:
    if depth > MAX_NEST_DEPTH:
        panic("json.stringify: exceeded max depth")
    match j:
        Json.Null: return "null"
        Json.Bool(b):
            if b:
                return "true"
            return "false"
        Json.Int(i): return str(i)
        Json.Num(n): return num_str(n)
        Json.Str(s): return escape(s)
        Json.Arr(xs):
            out := "["
            first := true
            for x in xs:
                if not first:
                    out = out + ","
                out = out + stringify_depth(x, depth + 1)
                first = false
            return out + "]"
        Json.Obj(m):
            out := "{{"
            first := true
            for k in m.keys():
                if not first:
                    out = out + ","
                out = out + escape(k) + ":" + stringify_depth(m[k], depth + 1)
                first = false
            return out + "}}"

# ----- accessors -----------------------------------------------------------------------------
# (Enums can't carry methods yet, so these are free functions: `json.as_int(j)`.)

fn is_null(j: Json) -> bool:
    match j:
        Json.Null: return true
        _: return false

fn as_bool(j: Json) -> Option[bool]:
    match j:
        Json.Bool(b): return Some(b)
        _: return None

fn as_float(j: Json) -> Option[float]:
    match j:
        Json.Int(i): return Some(float(i))
        Json.Num(n): return Some(n)
        _: return None

fn as_int(j: Json) -> Option[int]:
    match j:
        Json.Int(i): return Some(i)
        Json.Num(n):
            # JSON stores every number as f64; `int()` faults on out-of-range/non-finite. Keep
            # this a total function: gate on the i64 window and return None when unrepresentable.
            # `n == 2^63` (== i64::MAX after f64 rounding) is special-cased since int(2^63) faults.
            if n == 9223372036854775808.0:
                return Some(9223372036854775807)
            if n >= -9223372036854775808.0 and n < 9223372036854775808.0:
                return Some(int(n))
            return None
        _: return None

fn as_str(j: Json) -> Option[str]:
    match j:
        Json.Str(s): return Some(s)
        _: return None

# The object's underlying `Map[str, Json]` (None if `j` is not an object).
fn as_object(j: Json) -> Option[Map[str, Json]]:
    match j:
        Json.Obj(m): return Some(m)
        _: return None

# The array's underlying `List[Json]` (None if `j` is not an array).
fn as_array(j: Json) -> Option[List[Json]]:
    match j:
        Json.Arr(xs): return Some(xs)
        _: return None

# Look up a key in an object (None if not an object or key is absent).
fn get(j: Json, key: str) -> Option[Json]:
    match j:
        Json.Obj(m): return m.get(key)
        _: return None

# Index into an array (None if not an array or out of bounds).
fn at(j: Json, i: int) -> Option[Json]:
    match j:
        Json.Arr(xs):
            if i < 0 or i >= xs.len():
                return None
            return Some(xs[i])
        _: return None

# Element count: array length, object size, or string length. Faults on `Null`/`Bool`/`Num` — a
# scalar has no length, and returning `0` was indistinguishable from an empty array/object/string
# (a caller writing `if json.len(j) == 0` to mean "empty array" got `true` for a `null`). CPython's
# `len(None)` raises `TypeError: object of type 'NoneType' has no len()`; same shape here.
fn len(j: Json) -> int:
    match j:
        Json.Arr(xs): return xs.len()
        Json.Obj(m): return m.len()
        Json.Str(s): return s.len()
        Json.Null: panic("json.len: Null has no length")
        Json.Bool(_): panic("json.len: Bool has no length")
        Json.Int(_): panic("json.len: Int has no length")
        Json.Num(_): panic("json.len: Num has no length")
