# std.fs — filesystem operations, declared in Chezzi (phase 4d).
#
# FILE-BACKED, IMPORT-GATED native module (like std.regex). Functions are in scope ONLY after
# `import std.fs` (or a `from std.fs import …`) or qualified as `fs.exists`. The resolver loads this
# real file (keeping the `native` marker); the checker harvests the `native fn` decls below as the
# module's SIGNATURE source — retiring the hand-built `native_module_sig` fs arm.
#
# Every declaration is BODY-LESS: the implementations stay native (name-keyed in `src/native/fs.rs`,
# dispatched via `native_members("std.fs")`). The backends compile NOTHING for a `native fn`.
#
# Mutations are all `Result[nil]`. `mkdir` is recursive (mkdir -p); `remove_dir` is non-recursive
# (faults on a non-empty dir); `append` creates-if-absent + never truncates.

# FileInfo — filesystem metadata read by `stat`. FIELD ORDER IS LOAD-BEARING: it is positional across
# the hand-built runtime layout copies (compiler `Compiler::new`, checker `seed_stdlib_structs`,
# `native/fs.rs` stat builder). `mode` is the raw unix st_mode (perm + type bits; 0 on non-unix);
# `mtime` is UNIX-epoch seconds (0 if pre-epoch/unsupported).
native struct FileInfo:
    size: int
    mtime: int
    mode: int
    is_dir: bool
    is_file: bool
    is_symlink: bool

native fn list_dir(path: str) -> Result[List[str]]
native fn exists(path: str) -> bool
native fn is_file(path: str) -> bool
native fn is_dir(path: str) -> bool
native fn size(path: str) -> Result[int]
# stat reads filesystem metadata into a FileInfo (FOLLOWS symlinks like `stat`/os.stat; is_symlink is
# reported separately). Errs (recoverable) on a missing/unreadable path.
native fn stat(path: str) -> Result[FileInfo]
# walk recursively lists every entry (files + dirs) under `path` as full path strings, in a
# deterministic per-directory-sorted, dir-before-children order. Does NOT follow symlinked dirs.
native fn walk(path: str) -> Result[List[str]]
native fn glob(pattern: str) -> Result[List[str]]
# canonicalize resolves symlinks + `.`/`..` against the REAL filesystem (unlike the purely lexical
# path.normalize) → an absolute real path; the path must EXIST (errs otherwise).
native fn canonicalize(path: str) -> Result[str]
native fn mkdir(path: str) -> Result[nil]
native fn remove_file(path: str) -> Result[nil]
native fn remove_dir(path: str) -> Result[nil]
native fn rename(src: str, dst: str) -> Result[nil]
native fn copy(src: str, dst: str) -> Result[nil]
native fn append(path: str, text: str) -> Result[nil]
# chmod sets unix permission bits (e.g. 0o755); unix-only (errs "chmod is unix-only" elsewhere).
native fn chmod(path: str, mode: int) -> Result[nil]
# atomic_write = write a same-dir temp then rename over `path` (a concurrent reader sees old-or-new,
# never a half-written file; preserves the target's mode). Not fsync'd — no crash-durability guarantee.
native fn atomic_write(path: str, contents: str) -> Result[nil]
