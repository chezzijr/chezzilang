# std.cancel — cooperative task cancellation & timeouts (a Go `context`-inspired token, adapted to
# Chezzi). A `Token` is an explicit, sendable handle you thread down a call tree: poll `cancelled()`
# in CPU loops, race `done()` in a `wait:` for IO loops, and `cancel()` it from anywhere.
#
# Written entirely in Chezzi over existing primitives: `Shared[bool]` (the manual-cancel bit),
# `monotonic()` (the deadline, checked AT POLL TIME so it is deterministic on every engine — no
# background canceller task), and a level-triggered channel for `done()` (`timer(ms)` for a timeout,
# a `trip()`-able `Channel[bool]` for manual cancel). See docs/concurrency.md §6e.
#
# Cooperative contract: a token SIGNALS cancellation; it cannot forcibly interrupt. A CPU loop must
# poll `cancelled()`; an IO loop must `wait:` on `done()`. A self-polling timeout loop stops on time
# on every engine; a manual cancel of a non-polling pure-CPU sibling is only preempted on the default
# OS-thread engine (the `--serial`/`--interp` oracles run it to completion).
#
# TREE-STRUCTURED. A child token is `derive()`d from a parent (Go `context.WithCancel`): cancelling
# or timing out the parent cancels every transitively-derived child, recursively down the tree, while
# cancelling a child never touches the parent (one-directional, root-to-leaves). The link is LIVE — a
# parent flip is observed by an already-derived child, including one that crossed the `spawn`/
# `parallel:`/`Channel` airlock — because the link is the parent's `Shared` flag + `Shared` registry,
# which cross as live cores (exactly like the flat token's `flag`). Deadlines inherit TIGHTEST-WINS:
# a child clamps to the soonest absolute deadline of itself and its ancestors. See docs/concurrency.md §6e.
import std.time

struct Token:
    flag: Shared[bool]     # manual-cancel bit (sendable, owner-serialized)
    deadline: float        # absolute monotonic() secs; 0.0 == no deadline; checked at POLL TIME
    dl: Channel[bool]      # done(): a timer channel (timeout) or a trip()-able latch channel (manual)
    parent: Token?         # the live derivation link (None for a root); cancelled()/reason() recurse it
    kids: Shared[list[Channel[bool]]]  # done()-channels of ALL transitive descendants (each derive()
                                       # registers into every ancestor) — cancel() trips each (fan-out)

    # True once this token is cancelled (manually) or its deadline has passed, OR any ancestor is —
    # the cascade is transitive up the parent chain and one-directional (an ancestor never reads us).
    # Never blocks.
    fn cancelled(self) -> bool:
        if self.flag.get():
            return true
        if self.deadline > 0.0 and time.monotonic() >= self.deadline:
            return true
        match self.parent:
            Some(p): return p.cancelled()
            None:    return false

    # Why this token is done: "cancelled" (manual), "timeout" (deadline), or None (still live). Nearest
    # cause wins — self's own cause first, else the inherited ancestor's. Agrees with cancelled().
    fn reason(self) -> str?:
        if self.flag.get():
            return Some("cancelled")
        if self.deadline > 0.0 and time.monotonic() >= self.deadline:
            return Some("timeout")
        match self.parent:
            Some(p): return p.reason()
            None:    return None

    # Manual cancel, callable anytime, from any task (the handle is shared). Idempotent. Trips the
    # done() channel so a sibling parked in `wait:` wakes, and fans out to EVERY transitive descendant's
    # done() — derive() registers each descendant's done() into all of its ancestors' kids, so this one
    # fan-out reaches grandchildren and below directly (the cascade is transitive, not immediate-only).
    fn cancel(self):
        self.flag.set(true)
        self.dl.trip()
        for ch in self.kids.get():
            ch.trip()

    # A channel that becomes ready (recv -> true) when this token is done. Use in a `wait:` arm.
    # Same handle every call, so re-polling in a loop is stable and a later cancel() reaches a waiter.
    fn done(self) -> Channel[bool]:
        return self.dl

    # Absolute deadline (monotonic seconds), or 0.0 if none.
    fn deadline_at(self) -> float:
        return self.deadline

    # Derive a CHILD token linked to this one (Go `context.WithCancel`). The child is cancelled when
    # IT is cancelled OR when this token (or any ancestor) is — but cancelling the child never touches
    # this token. The child inherits the TIGHTEST deadline (the soonest of its own — none here — and
    # this token's). Its done() fires on an ancestor timeout via its own deterministic timer (armed to
    # the remaining deadline at derive time), and on a manual ancestor cancel via the registry fan-out.
    fn derive(self) -> Token:
        # Tightest deadline = this token's (the child has none of its own).
        d := self.deadline
        # Arm the child's done() channel: a timer to the remaining deadline (timeout inheritance), or
        # a trip()-able latch (manual). A non-positive remaining ms means "already expired" (timer(0)).
        cdl := Channel[bool]()
        if d > 0.0:
            rem_ms := int((d - time.monotonic()) * 1000.0)
            if rem_ms < 0:
                rem_ms = 0
            cdl = timer(rem_ms)
        child := Token(flag=Shared(false), deadline=d, dl=cdl, parent=Some(self),
                       kids=Shared([]))
        # Register the child's done() into EVERY ancestor's kids registry — walk the parent chain up
        # from self to the root — so a manual cancel() at ANY depth above trips this child's done()
        # directly (the cascade is transitive, not just immediate-parent). Each registration is an
        # ATOMIC read-modify-write via update(): two tasks deriving from the same ancestor concurrently
        # (a shared handle across the spawn/parallel airlock) both append without a lost-update race.
        anc := Some(self)
        while true:
            match anc:
                Some(a):
                    a.kids.update(fn(xs): xs.concat([cdl]))
                    anc = a.parent
                None:
                    break
        # If any ancestor is ALREADY cancelled at derive time, trip the child's done() now so it is
        # ready immediately (cancelled() polls the whole parent chain).
        if self.cancelled():
            cdl.trip()
        return child

# A manually-cancellable token with no deadline. `cancel()` is the only thing that trips it.
fn manual() -> Token:
    return Token(flag=Shared(false), deadline=0.0, dl=Channel[bool](), parent=None,
                 kids=Shared([]))

# A token that auto-cancels `ms` milliseconds after creation, and is also manually cancellable. A
# non-positive `ms` means "already expired" (cancelled() is true at once, done() fires immediately).
fn timeout(ms: int) -> Token:
    m := ms
    if m < 0:
        m = 0
    return Token(flag=Shared(false), deadline=time.monotonic() + float(m) / 1000.0, dl=timer(m),
                 parent=None, kids=Shared([]))

# Derive a child token from `parent` (the free-function form of `parent.derive()`, for a pipe / when
# the parent is the obvious subject). Identical semantics: tightest deadline, live link, one-directional.
fn derive(parent: Token) -> Token:
    return parent.derive()
