# std.cancel — cooperative task cancellation & timeouts (a Go `context`-inspired token, adapted to
# Chezzi). A `Token` is an explicit, sendable handle you thread down a call tree: poll `cancelled()`
# in CPU loops, race `done()` in a `wait:` for IO loops, and `cancel()` it from anywhere.
#
# Written entirely in Chezzi over existing primitives: `Shared[bool]` (the manual-cancel bit),
# `monotonic()` (the deadline, checked AT POLL TIME so it is deterministic on every engine — no
# background canceller task), and a level-triggered channel for `done()` (`timer(ms)` for a timeout,
# a `trip()`-able `Channel[bool]` for manual cancel). See docs/concurrency.md §6e.
#
# Cooperative contract: a token SIGNALS cancellation; it cannot forcibly interrupt. A CPU loop must
# poll `cancelled()`; an IO loop must `wait:` on `done()`. A self-polling timeout loop stops on time;
# a manual cancel of a non-polling pure-CPU sibling is preempted only because the M:N engine runs the
# sibling on a real OS thread.
#
# TREE-STRUCTURED, REGISTERED LIKE GO'S. A child token is `derive()`d from a parent (Go
# `context.WithCancel`): cancelling or timing out the parent cancels every transitively-derived child,
# while cancelling a child never touches the parent (one-directional, root-to-leaves). The
# REGISTRATION is Go's: `derive()` sends the child into its IMMEDIATE parent's `kids` channel — O(1),
# no ancestor walk — and `cancel()` cascades DOWN, draining each node's `kids` and marking every
# descendant it reaches (an explicit work-list, so tree depth is not stack depth). Registering into
# every ancestor instead, with a copy-per-`Shared.update`, made `derive()` cubic in chain depth (400
# derives = 6.0 s vs Go's 0.08 ms) and quadratic in fan-out; the channel core is O(1) on both.
# A token holds NO parent link, so it also encodes in O(1) across the airlock at any tree depth.
# The link is LIVE — a parent flip is observed by an already-derived child, including one that crossed
# the `spawn`/`parallel:`/`Channel` airlock — because the link is the `kids` channel plus each node's
# `Shared` flag, which cross as live cores (exactly like the flat token's `flag`). Deadlines inherit
# TIGHTEST-WINS: a child clamps to the soonest absolute deadline of itself and its ancestors, and
# `derive()` materialises it into the child's OWN `deadline`, so a timeout needs no cascade at all.
# See docs/concurrency.md §6e.
import std.time
# Depend on std.concurrency explicitly (phase 4c-concurrency): the `Shared` name is usable license-free
# in a stdlib module, but this import makes the file-backed native module a graph DEPENDENCY, so it is
# harvested (and its `Shared` method table seeded) BEFORE this module is checked — regardless of the
# entry program's import order. Without it, `self.flag.get()`/`.set()`/`.update()` can fail to resolve.
import std.concurrency

struct Token:
    flag: Shared[bool]     # cancel bit (sendable, owner-serialized)
    deadline: float        # absolute monotonic() secs; 0.0 == no deadline; checked at POLL TIME
    dl: Channel[bool]      # done(): a timer channel (timeout) or a trip()-able latch channel (manual)
    kids: Channel[Token]   # IMMEDIATE children only (Go context.WithCancel) — cancel() drains + recurses
    # ponytail: an uncancelled long-lived parent still retains its children's handles (the registry only
    # grows until cancel drains it) — same SHAPE as v1 but HEAVIER entries: v1 retained one
    # Channel[bool] per descendant, this retains whole Tokens (flag + dl + kids cores). Same
    # reachability count, more bytes each; tokens are request-scoped.

    # True once this token is cancelled (manually or by an ancestor's cascade) or its deadline has
    # passed. O(1) — an ancestor cancel is PUSHED into this token's own flag, so there is nothing to
    # walk up. Never blocks.
    fn cancelled(self) -> bool:
        if self.flag.get():
            return true
        return self.deadline > 0.0 and time.monotonic() >= self.deadline

    # Why this token is done: "cancelled" (manual/cascaded), "timeout" (deadline), or None (still
    # live). The FIRST cause LATCHES (Go): whatever set this token's own state stays its answer. (v1
    # said "nearest cause wins" because it walked up a parent chain to find one — with `parent` gone
    # there is nothing to be nearer than self, so that phrasing is vestigial, not a second rule.)
    fn reason(self) -> str?:
        if self.flag.get():
            return Some("cancelled")
        if self.deadline > 0.0 and time.monotonic() >= self.deadline:
            return Some("timeout")
        return None

    # Mark a DESCENDANT done: set its cancel bit, then trip its done() — UNLESS its own deadline has
    # already elapsed, in which case its own "timeout" cause stays nearest (Go latches the first
    # cause). cancel() sets SELF's bit unconditionally before the cascade, which is v1's behaviour.
    # THE ORDER IS LOAD-BEARING (C5, the Go-context invariant "once done() unblocks, the token is
    # cancelled"): trip() wakes a task parked in `wait: tok.done().recv()`, so anything the woken task
    # must be able to observe has to be true BEFORE the trip. Tripping first is a real, measured race —
    # 141/400 rounds read cancelled()==false at CHEZZI_THREADS=8. When the guard SKIPS flag.set the
    # order is still safe: the skip only happens when this token's own deadline has already elapsed,
    # so cancelled() is already true on the deadline arm. Do not swap these two lines back.
    fn _mark(self):
        if self.deadline == 0.0 or time.monotonic() < self.deadline:
            self.flag.set(true)
        self.dl.trip()

    # Manual cancel, callable anytime, from any task (the handle is shared). Idempotent. Trips the
    # done() channel so a sibling parked in `wait:` wakes, then cascades DOWN: drain this token's
    # immediate children, mark each, and recurse into theirs, so every transitive descendant is
    # reached. An explicit work-list, not recursion — a 12 000-deep tree would blow the call stack.
    # ponytail: cancel() cascades EAGERLY — if the cancelling task is torn down mid-cascade at a
    # cancellation checkpoint, a deep subtree can be left unmarked. Go has the same shape. Revisit only
    # if a real teardown loses a subtree.
    fn cancel(self):
        self.flag.set(true)          # BEFORE the drain — closes the derive-vs-cancel race
        work := [self]
        while work.len() > 0:
            match work.pop():
                Some(t):
                    t._mark()
                    while true:
                        match t.kids.try_recv():
                            Some(k): work.push(k)
                            None:    break
                None:
                    break

    # A channel that becomes ready (recv -> true) when this token is done. Use in a `wait:` arm.
    # Same handle every call, so re-polling in a loop is stable and a later cancel() reaches a waiter.
    fn done(self) -> Channel[bool]:
        return self.dl

    # Absolute deadline (monotonic seconds), or 0.0 if none.
    fn deadline_at(self) -> float:
        return self.deadline

    # Derive a CHILD token linked to this one (Go `context.WithCancel`). The child is cancelled when
    # IT is cancelled OR when this token (or any ancestor) is — but cancelling the child never touches
    # this token. The child inherits the TIGHTEST deadline (the soonest of its own — none here — and
    # this token's), materialised into its own field, so a timeout fires without any cascade; a manual
    # ancestor cancel reaches it through the registration below.
    fn derive(self) -> Token:
        # Tightest deadline = this token's (the child has none of its own).
        d := self.deadline
        # Arm the child's done() channel: a timer to the remaining deadline (timeout inheritance), or
        # a trip()-able latch (manual). A non-positive remaining ms means "already expired" (timer(0)).
        cdl := Channel[bool]()
        if d > 0.0:
            # Round the remaining ms UP (the `+ 1` margin): int() truncates toward zero, which would
            # arm done() up to ~1ms BEFORE the absolute deadline `d`, while cancelled()/reason() poll
            # `d` directly — so a task woken by done() could still read cancelled()==false. That breaks
            # the Go-context invariant "once done() unblocks, the token is cancelled". Over-arming by
            # ≤1ms keeps done() at-or-after `d` (Go timers fire at-or-after too), never early.
            rem_ms := int((d - time.monotonic()) * 1000.0) + 1
            if rem_ms < 0:
                rem_ms = 0
            cdl = timer(rem_ms)
        child := Token(flag=Shared(false), deadline=d, dl=cdl, kids=Channel[Token]())
        # Register into the IMMEDIATE parent only (Go). O(1) — an unbounded channel send never blocks.
        self.kids.send(child)
        # Derive-vs-cancel race: cancel() flips the flag BEFORE it drains, and we send BEFORE we read
        # it. So either the send landed before the drain (the cascade marks the child) or it landed
        # after — in which case the flag was already true here. This check MUST stay after the send.
        if self.cancelled():
            child._mark()
        return child

# A manually-cancellable token with no deadline. `cancel()` is the only thing that trips it.
fn manual() -> Token:
    return Token(flag=Shared(false), deadline=0.0, dl=Channel[bool](), kids=Channel[Token]())

# A token that auto-cancels `ms` milliseconds after creation, and is also manually cancellable. A
# non-positive `ms` means "already expired" (cancelled() is true at once, done() fires immediately).
fn timeout(ms: int) -> Token:
    m := ms
    if m < 0:
        m = 0
    return Token(flag=Shared(false), deadline=time.monotonic() + float(m) / 1000.0, dl=timer(m),
                 kids=Channel[Token]())

# Derive a child token from `parent` (the free-function form of `parent.derive()`, for a pipe / when
# the parent is the obvious subject). Identical semantics: tightest deadline, live link, one-directional.
fn derive(parent: Token) -> Token:
    return parent.derive()
