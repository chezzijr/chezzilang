# std.math — floating-point math, declared in Chezzi (phase 4d).
#
# FILE-BACKED, IMPORT-GATED native module (like std.regex). Its functions are in scope ONLY after
# `import std.math` (bare `sqrt` needs an `import sqrt from std.math`) or qualified as `math.sqrt`.
# The resolver loads this real file (keeping the `native` marker); the checker harvests the
# `native fn` decls below as the module's SIGNATURE source — retiring the hand-built
# `native_module_sig` math arm.
#
# Every declaration is BODY-LESS: the implementations stay native (name-keyed in `src/native/math.rs`,
# dispatched via `native_members("std.math")`). The backends compile NOTHING for a `native fn` — the
# front-end reads ONLY the signature.
#
# The language has no implicit int→float, so params are `float` (callers pass floats). `abs`/`sign`
# are `[T: Num]` generics (int->int, float->float); every other param is `float`. The module
# constants below (`math.pi`) are ordinary `NAME: const T = value` lets: the checker harvests each as a
# const member, and running this module's toplevel binds its value.

pi: const float = 3.141592653589793
e: const float = 2.718281828459045
inf: const float = float("inf")
nan: const float = float("nan")

native fn abs[T: Num](x: T) -> T
native fn floor(x: float) -> float
native fn ceil(x: float) -> float
native fn round(x: float) -> float
native fn pow(base: float, exp: float) -> float
native fn sqrt(x: float) -> float
native fn sin(x: float) -> float
native fn cos(x: float) -> float
native fn tan(x: float) -> float
native fn asin(x: float) -> float
native fn acos(x: float) -> float
native fn atan(x: float) -> float
native fn atan2(y: float, x: float) -> float
native fn exp(x: float) -> float
native fn ln(x: float) -> float
native fn log2(x: float) -> float
native fn log10(x: float) -> float
native fn log(value: float, base: float) -> float
native fn is_nan(x: float) -> bool
native fn is_inf(x: float) -> bool
native fn is_finite(x: float) -> bool

# Number theory / integer math (Python `math` semantics). `sign` is a `[T: Num]` generic like `abs`
# (int->int / float->float). `factorial`/`comb`/`perm`/
# `parse_int_base` return `int!` — a clean `!e` (never a fault) on a bad domain or i64 overflow.
# `gcd`/`lcm` (and `abs` on an `int`) are NOT in that `T!E`-returning group: an i64 overflow there
# faults recoverably (`integer overflow in gcd` / `integer overflow in lcm` / `integer overflow in abs`)
# — CPython's `math.gcd`/`math.lcm`/`abs` never overflow (arbitrary precision), so this is the same
# upward divergence as the language-wide integer-overflow fault, not a new rule.
native fn gcd(a: int, b: int) -> int
native fn lcm(a: int, b: int) -> int
# `divmod` is a BODIED Chezzi fn living alongside the native decls in this same file (the hybrid
# native+Chezzi module form — Rust-backed `native fn` sigs and a pure-Chezzi `fn` in one `.chz`).
# Returns the pair `(a / b, a % b)` using Chezzi's own C-style `/` and `%` — TRUNCATING toward zero,
# remainder carries the DIVIDEND's sign (NOT Python's floor-`divmod`: `divmod(-7, 2)` is `(-3, -1)`
# here, `(-4, 1)` in Python). `b == 0` faults cleanly like `a / b`.
fn divmod(a: int, b: int) -> (int, int):
    return (a / b, a % b)
native fn sign[T: Num](x: T) -> T
# Truncate toward zero to an `int` (Python `math.trunc`). Faults recoverably on a non-finite `x`
# (`trunc(): NaN is out of integer range` / `trunc(): inf is out of integer range`) or one outside i64
# range (`trunc(): 9223372036854776000 is out of integer range`) — CPython raises `ValueError`/
# `OverflowError` at the same two boundaries.
native fn trunc(x: float) -> int
native fn hypot(x: float, y: float) -> float
native fn cbrt(x: float) -> float
native fn factorial(n: int) -> int!
native fn comb(n: int, k: int) -> int!
native fn perm(n: int, k: int) -> int!
native fn parse_int_base(s: str, base: int) -> int!
