# std.convert -- the From protocol (Rust From).
#
# `from(x: S) -> Self` is STATIC (the first param is `x`, not `self`), so it is called
# `Target.from(src)` and produces a fresh `Self`. `S`, the source type, is the one arity param, so
# the bound reads `[T: From[str]]`. The bound needs `import From from std.convert`.
protocol From[S]:
    fn from(x: S) -> Self
