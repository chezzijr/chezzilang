# std.os — operating-system interface, declared in Chezzi (phase 4d).
#
# FILE-BACKED, IMPORT-GATED native module (like std.regex). Functions are in scope ONLY after
# `import std.os` (or a `from std.os import …`) or qualified as `os.getcwd`. The resolver loads this
# real file (keeping the `native` marker); the checker harvests the `native fn` decls below as the
# module's SIGNATURE source — retiring the hand-built `native_module_sig` os arm.
#
# Every declaration is BODY-LESS: the implementations stay native (name-keyed in `src/native/os.rs`,
# dispatched via `native_members("std.os")`). The backends compile NOTHING for a `native fn`.
#
# `exit(code)` never returns, but the checker has no `never` type; `nil` is the closest void-ish
# result and lets (unreachable) statements follow it.

import std.path

native fn args() -> List[str]
native fn env(key: str) -> Option[str]
native fn exit(code: int) -> nil

# W7-8 — the INTERNAL byte seam (raw OS `bytes` in/out); see std/fs.chz for the convention.
native fn _getcwd() -> Result[bytes]
native fn _chdir(path: bytes) -> Result[nil]

# `getcwd()` hands back a `path.Path` — the raw cwd bytes, NOT a lossily-decoded `str` (a non-UTF-8
# cwd used to come back U+FFFD-substituted, naming nothing). CONCRETE return type: no type argument,
# no turbofish, no `getcwd_bytes` twin.
fn getcwd() -> Result[path.Path]:
    match _getcwd():
        Ok(b): return Ok(path.Path(b))
        Err(e): return Err(e)

# System queries (gaps §6). getpid/platform/hostname/temp_dir are engine-agnostic process reads;
# home_dir reads the HostConfig `HOME` (same source as `env`), so it's None when unset.
native fn getpid() -> int
native fn platform() -> str
native fn hostname() -> str
native fn home_dir() -> Option[str]
native fn temp_dir() -> str
# `environ()` (sorted by key) reads the SAME HostConfig env map `env` reads, and `setenv` WRITES it —
# so a `setenv` is observed by both `env` and `environ` (no third disagreeing source). The map is
# shared across M:N workers, so a `setenv` from inside a task is visible to the parent + siblings
# (process-global, like Python/Go). Children spawned via `std.process.cmd` still inherit the REAL
# process env (that axis is unchanged).
native fn environ() -> Map[str, str]
native fn setenv(key: str, value: str) -> nil
# `chdir` mutates the REAL process cwd (like `getcwd` reads it). Process-global: shared by all M:N
# workers, so a task's `chdir` affects sibling tasks' relative paths (Python/Go have the same ceiling).
fn chdir(p: PathLike) -> Result[nil]:
    return _chdir(p.as_path())
