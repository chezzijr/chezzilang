# std.crypto — hand-rolled digests, declared in Chezzi (phase 4e).
#
# FILE-BACKED, IMPORT-GATED native module (same pattern as std/regex.chz). Its functions are in scope
# ONLY after `import std.crypto` (or a `from std.crypto import …`). The resolver loads this real file
# (keeping the `native` marker), and the checker harvests the `native fn` declarations below as the
# module's SIGNATURE source — retiring the hand-built `native_module_sig` crypto arm.
#
# Every declaration is BODY-LESS: the implementations stay native (name-keyed in `src/native/crypto.rs`,
# dispatched via `native_members("std.crypto")`). Each fn hashes the str's UTF-8 bytes → lowercase-hex
# `str` (infallible).

native fn sha256(s: str) -> str
# SHA-256 of raw binary data — e.g. io.read_bytes(p) |> sha256_bytes. Takes a `bytes`; convert a
# `bytearray` buffer with `bytes(ba)`.
native fn sha256_bytes(b: bytes) -> str
# SHA-1 (FIPS 180-4). NOT collision-resistant (SHAttered, 2017) — for git object ids / legacy
# protocol interop / non-security checksums only, never signatures or integrity vs an adversary.
native fn sha1(s: str) -> str
native fn sha1_bytes(b: bytes) -> str
# SHA-512 (FIPS 180-4).
native fn sha512(s: str) -> str
native fn sha512_bytes(b: bytes) -> str
native fn md5(s: str) -> str
# HMAC-SHA-256 (RFC 2104) — keyed message authentication. Both args are raw `bytes`; convert a
# `str` with `bytes(s.encode())` or use a `b"..."` byte literal.
native fn hmac_sha256(key: bytes, msg: bytes) -> str
# CSPRNG (Python `secrets`). Draws from the OS entropy source — Linux `getrandom(2)`, falling back to
# `/dev/urandom` on the other unixes (macOS, the BSDs, Android, iOS) — and FAILS CLOSED: if the OS has
# no entropy (or the target is non-unix) it faults recoverably (catchable by `recover:`), NEVER
# weak/degraded bytes. `n` must be 0..=1048576 (1 MiB cap); a negative or oversized `n` faults.
native fn secure_bytes(n: int) -> bytes
# `n` secure random bytes, lowercase-hex encoded → a `2n`-char `str` (Python `secrets.token_hex`).
native fn token_hex(n: int) -> str
