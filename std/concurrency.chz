# std.concurrency — the cross-task box + executor primitives, declared in Chezzi (phase 4c-concurrency).
#
# FILE-BACKED, IMPORT-GATED native module (like std/net.chz). Its native TYPES (`Shared`/`RwShared`/
# `Atomic`/`Executor`) are in scope ONLY after `import std.concurrency` (bare `Shared`/`RwShared`/
# `Atomic`/`Executor`) or an `import … from std.concurrency`. The resolver loads this real file (keeping
# the `native` marker), and the checker harvests the `native struct` declarations below as the module's
# SIGNATURE source — retiring the hand-built `native_module_sig` concurrency arm AND the bespoke
# `shared_method_sig`/`rwshared_method_sig`/`atomic_method_sig`/`executor_method_sig` method arms (their
# sigs now come from the `native fn` methods below, harvested into each type's method table — the
# phase-4c native-method-binding capability, EXTENDED here to GENERIC native structs).
#
# Every declaration is BODY-LESS: `Shared`/`RwShared`/`Atomic`/`Executor` stay the RESERVED opaque VM
# handles `Ty::Shared`/`Ty::RwShared`/`Ty::Atomic`/`Ty::Executor` (NOT nominal structs — no field
# layout), and the ctors STILL lower to `Op::NewShared`/`NewRwShared`/`NewAtomic`/`NewExecutor` by NAME
# via the compiler's name→opcode dispatch (NOT off-heap host natives). The method calls stay VM-
# intercepted at runtime by name. The backends compile NOTHING for a `native fn`/`native struct` — the
# front-end reads ONLY the signature.
#
# TWO method sigs a plain harvested sig cannot express (ported as post-harvest metadata in the checker's
# `attach_native_module_metadata`): `RwShared.read(f)` recovers its return type R from the closure
# argument's return type (`read(fn(T) -> R) -> R`), so `f` is declared UNANNOTATED and the metadata step
# retypes it to `fn(T) -> ?` (any return); `Executor.submit(f)` accepts any zero-arg closure regardless
# of its return, so `f` is declared UNANNOTATED and retyped to `fn() -> ?`. `Atomic.add`/`sub` exist
# only for a numeric `T` — a dispatch-time constraint the `Ty::Atomic` arm keeps as a residual gate.

native struct Shared[T]:
    native fn get(self) -> T
    native fn set(self, v: T) -> nil
    native fn update(self, f: fn(T) -> T) -> nil

# A `RwShared[T]` whose element `T` is a CONTAINER ALSO gains ZERO-COPY read-view methods (checker
# arm-resolved, NOT harvested here — E/K/V are not nameable in the `RwShared[T]` surface). Gated by a
# constructor-kind `where T: List/Map/Set` bound to the container HEAD (Tuple EXCLUDED — heterogeneous):
#   `RwShared[List[E]]`: `len(self) -> int`, `at(self, i: int) -> Option[E]` (the SAFE index — out of
#     range is `None`, never a fault; negative index normalizes like `xs[i]`), `slice(self, lo, hi) -> List[E]`,
#     `for_each(self, f: fn(E) -> _) -> nil`, `fold(self, init: R, f: fn(R, E) -> R) -> R`.
#   `RwShared[Map[K,V]]`: `len(self) -> int`, `get_key(self, k: K) -> Option[V]`, `has(self, k: K) -> bool`,
#     `for_each_entry(self, f: fn(K, V) -> _) -> nil`, `fold_entries(self, init: R, f: fn(R, K, V) -> R) -> R`,
#     and the single-entry WRITERS (TICKET-192) `set_key(self, k: K, v: V) -> nil`,
#     `remove_key(self, k: K) -> Option[V]`, `get_or_insert(self, k: K, v: V) -> V`: each takes the box's
#     update guard (the one `set`/`write` take) and splices one entry, never re-encoding the map. The stored
#     map keeps the heap map's hash index, so lookups and inserts are O(1) expected; `remove_key` is O(n).
#   `RwShared[Set[E]]`: `len(self) -> int`, `contains(self, e: E) -> bool`,
#     `for_each(self, f: fn(E) -> _) -> nil`, `fold(self, init: R, f: fn(R, E) -> R) -> R`.
# (`fold*`'s R is inferred from `init`.) They walk the stored heap-independent wire container and
# materialize ONE entry at a time, so a worker can scan/reduce a shared large container in O(1) memory
# instead of `get`/`read` copying the WHOLE inner into the caller's heap. Every walk RE-ACQUIRES the
# shared read guard PER ENTRY and DROPS it before running the closure (and before any `has`/`get_key`/
# `contains` hash+eq probe) — never held across user code — so a nested read OR write of the same box,
# and a GC pass inside the closure, are all deadlock-free (unlike a guard held for the whole walk
# against a write-preferring RwLock). The trade-off: the walk is NOT one atomic snapshot — a concurrent
# (or in-closure) `set`/`write` to the same box may be observed mid-walk (entries are read fresh each
# step); use `read`/`get` if you need a stable snapshot. Reduce into a DIFFERENT box (an `AtomicInt`/
# local accumulator), the real fan-out use case. On a non-container `T` (or a Tuple) they cleanly report
# "no method".
native struct RwShared[T]:
    native fn get(self) -> T
    native fn set(self, v: T) -> nil
    native fn write(self, f: fn(T) -> T) -> nil
    native fn read(self, f)

native struct Atomic[T]:
    native fn load(self) -> T
    native fn store(self, v: T) -> nil
    native fn exchange(self, v: T) -> T
    native fn cas(self, expected: T, new: T) -> bool
    # An `int` `T` FAULTS `integer overflow in Add`/`integer overflow in Sub` on i64 overflow (same
    # checked path `AtomicInt` uses below). Go's `atomic.Int64.Add` WRAPS and never panics — a stated
    # divergence for concurrency specifically, justified by Chezzi's language-wide recoverable-overflow
    # rule (measured, Go 1.26: `add(i64::MAX, 1)` wraps to `i64::MIN`).
    native fn add(self, v: T) -> T
    native fn sub(self, v: T) -> T

# `AtomicInt` — the monomorphic, LOCK-FREE int atomic (Rust `AtomicI64` / Java `AtomicInteger` /
# Go `atomic.Int64` style). Distinct from the generic reference cell `Atomic[T]` (Mutex-backed): no
# `[T]`, nothing to widen, so it is ALWAYS a lock-free `std::sync::atomic::AtomicI64`. `add`/`sub` are
# ALWAYS valid (int is always numeric — no residual numeric gate) and keep the i64-overflow FAULT via a
# checked compare_exchange CAS-loop (NOT raw fetch_add, which wraps silently).
native struct AtomicInt:
    native fn load(self) -> int
    native fn store(self, v: int) -> nil
    native fn exchange(self, v: int) -> int
    native fn cas(self, expected: int, new: int) -> bool
    native fn add(self, v: int) -> int
    native fn sub(self, v: int) -> int

native struct Executor:
    native fn submit(self, f) -> nil
    native fn shutdown(self) -> nil
    native fn shutdown_now(self) -> nil
    # A std internal (TICKET-219): submit `f` as a handle job whose result channel is `out`. The
    # job transition seals `out` with the cancel `Err` when it drops or cuts the job. Its only
    # caller is `submit_result`, with the fresh cap-1 channel it created.
    native fn _submit_settled(self, f: fn() -> nil, out) -> nil
    # A BODIED generic method (the first on a native struct): submit `f` and hand back a cap-1
    # `Channel[Result[T]]` that carries its outcome: `Ok(value)`, or `Err(message)` for exactly
    # what `recover:` catches. The job itself never faults, so `shutdown()` raises nothing for it
    # and its siblings keep running (CPython `Future.result()`). The channel is SEALED once: every
    # `recv` returns the same outcome and takes nothing, so do not iterate it with `for`. The
    # primitive `submit_task`/`Task[T]` wraps.
    fn submit_result[T](self, f: fn() -> T) -> Channel[Result[T]]:
        ch := Channel[Result[T]](1)
        self._submit_settled(fn(): run_outcome(f, ch), ch)
        return ch

# Chezzi closures are single-expression only, so a multi-statement job body must be a named
# top-level fn the lambda calls.
#
# `recover:` decides what becomes an `Err`; there is no second list. What it cannot catch
# (`os.exit`, `--timeout`, `--max-heap`, a deadlock verdict) ends the run with its own report.
#
# A handle job's outcome is written ONCE into its channel by a seal (TICKET-219); the first writer
# wins under the channel's lock. Two writers exist:
# 1. this body, for the value of `recover: f()`;
# 2. the job transition (`SchedCore::job_event`), for the cancel `Err` when it drops a held job
#    or a job ends cut: by `shutdown_now()`, a creator cancel, or a fire-and-forget job fault,
#    after which every `defer` still runs and may read the handle (CPython
#    `shutdown(cancel_futures=True)`). An `os.exit` settles nothing: it runs no `defer`, and no
#    reader runs after it.
# A slot never carries a job's return value, so the body is the value's writer. `_submit_settled`
# and `_settle` are std internals; the only channel they seal is the fresh cap-1 one
# `submit_result` creates.
fn run_outcome[T](f: fn() -> T, out: Channel[Result[T]]):
    r := recover: f()
    _settle(out, r)

# True when `v` is an airlock copy in the calling task: a write to it would fault `this value is
# this task's copy`. Reads the same predicate as that write check (`Heap::is_copied`), so std code
# can pick write-or-share without attempting the write. A scalar is never a copy (TICKET-191).
native fn is_task_copy(v) -> bool

# Marks `v` and everything it reaches as this task's copy; called by std code on a value a task
# copy read from a shared core (`Task.get`, a `memoize1` wrapper), so a write to it faults instead
# of vanishing (TICKET-213). The mark stops at a module, so a function inside `v` leaves the
# module's globals unmarked. Not for a general read path: a plain `Shared.get()` or `ch.recv()` is
# a handoff, and the receiver owns it.
native fn mark_task_copy(v) -> nil

# Returns `v` rebuilt as this task's copy (`Route::CopyRead`): the rebuild every crossing runs, so
# a write to it faults instead of vanishing, a function inside it leaves its module's globals
# unmarked, and a generator's private frame slots stay writable (TICKET-190). For std code reading
# a shared core on behalf of a handle its owner aliases (`Task.get`, a `memoize1` wrapper). Not for
# a general read path: a plain `Shared.get()` or `ch.recv()` is a handoff, and the receiver owns it.
native fn task_copy_of[T](v: T) -> T

# A std internal (TICKET-219): seal the handle channel `ch` with the outcome `v`. The first seal
# wins; a later one changes nothing. Called only by `run_outcome`.
native fn _settle(ch, v) -> nil

# True once the handle channel `ch` holds its outcome. Never blocks, and never reads false after
# true: a sealed channel stays sealed. `Task.done()` reads it.
native fn is_settled(ch) -> bool
