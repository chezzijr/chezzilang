# std.prelude — the universe builtins' SIGNATURES, declared in Chezzi (phase 3a).
#
# ALWAYS-LINKED into every program's module graph, but with UNIVERSE semantics: these
# names are always in scope, NOT an importable module namespace. Each `native fn`/`native ctor` is a
# body-less signature whose implementation is bound natively (name-keyed `do_builtin` in the VM)
# — the front-end reads ONLY the signature; the backends compile no
# bytecode for a native decl (it is never a callable user fn).
#
# DYNAMIC-PARAM CONVENTION (native-decl-scoped — Chezzi stays statically typed for user code, this
# introduces NO user-facing `any`/`never`): an UNANNOTATED param means the dynamic "accepts anything"
# type; a native decl with NO `-> ret` means native-controlled/never (both map to the internal `?`).
#
# `native fn`  => a FIRST-CLASS universe function (bindable, passable, `defer`-able as a bare call).
# `native ctor` => a NON-first-class scalar/type constructor (value-position use is rejected, uniform
#                  with `f := Point` / `f := List`).
#
# print: variadic display fn — `...args: Any` (the `Any` top type accepts every value); the
# keyword-only `sep`/`end` follow the variadic. This decl is the one authority: the checker binds
# every `print` call (direct or through a value) from its slots, the compiler reads its `sep`/`end`
# defaults into `Program.print_defaults`, and the VM joins with them. The VALUE form (`p := print`)
# is `fn(...Any) -> None`, as a call through it packs like the direct call. range + List/Map/Set:
# phase 2b (still hard-coded).

native fn print(...args: Any, sep: str = " ", end: str = "\n") -> None
native fn ord(c: str) -> int
native fn chr(n: int) -> str
native fn panic(msg: str)

# A call on a scalar type's name sets no field, so it gives the zero value (`int()` is `0`, Python
# `int()`, Rust `i64::default()`). A conversion is a method on the source value (`n.to_float()`,
# `f.to_int()`, `s.to_int()`), and display is interpolation (`"{x}"`, Go `fmt.Sprint`).
native ctor int() -> int
native ctor float() -> float
native ctor bool() -> bool
native ctor str() -> str
native ctor bytes() -> bytes
native ctor bytearray() -> bytearray

# The three builtin container types' METHOD surface (phase 5a-containers). List/Map/Set are RESERVED
# UNIVERSE types (`Ty::List`/`Ty::Map`/`Ty::Set` — always in scope, not import-gated), and their LITERAL
# syntax (`[...]`/`{k:v}`/`{1,2}`) + turbofish ctor (`List[int]()`) stay COMPILER-WIRED (the type-arg-
# driven element identity is not a flat `FnSig`, so it lives in `resolve_type`/`builtin_container_sig`,
# NOT here). Only the METHOD tables are file-backed: each body-less `native fn` (leading bare `self`, which
# the harvest STRIPS) supplies the exact sig the retired bespoke `list_method_sig`/`map_method_sig`/
# `set_method_sig` arms carried. The checker harvests these into each reserved type's method table (seeded
# by `seed_stdlib_structs` into `self.structs`) and routes `Ty::List`/`Ty::Map`/`Ty::Set` method
# resolution through them (behavior-preserving; the sigs BYTE-MATCH the retired arms).
#
# The closure-driven HOFs are now ALSO file-backed here: `map[U]`/`fold[U]`/`sort_by_key[K: Comparable]`
# declare their OWN method type param (recovered from the closure body by the generic solver's
# closure-return LOOP-BACK — routed through `infer_generic_method`), and `filter`/`sort_by` are flat
# closure-typed sigs. This retired the bespoke `infer_list_hof` arm. `sort` is file-backed via
# `where T: Comparable` (a generic bound enforced at each call site by the Ty::List arm's
# `enforce_bounds`). `sum` carries `where T: Add` as documentation, but its true requirement is MONOID
# (Add + zero) and both runtimes are numeric-only, so a residual `!elem.is_numeric()` gate survives in the
# arm (a struct with a structural `add` still errors at CHECK time). `Map`/`Set`'s key/element type params
# carry a `Hashable` bound so the internal `Map[K, V]`/`Set[T]` return types resolve at harvest.

# A builtin type builds a value from an iterable with its static `from_iter` (Rust
# `FromIterator::from_iter`, Python `list(xs)`): `T(...)` makes only an empty value (`List[int]()`).
# `from_iter` takes any iterable whose elements are the type's elements: a list, a `Range`, a
# generator, `m.items()`, a Map (its `(k, v)` pairs), a str (its chars), bytes (its ints).

native struct List[T]:
    native fn from_iter[S: Iterable[T]](xs: S) -> List[T]
    native fn len(self) -> int
    native fn push(self, v: T) -> None
    native fn pop(self) -> Option[T]
    native fn reverse(self) -> None
    native fn contains(self, item: T) -> bool
    # SENTINEL, NOT A CARRIER — `-1` on a miss, the shape of Python's `str.find` (`'hi'.find('zz')` is
    # `-1`, measured). HAZARD: indexing is Python-negative, so `xs[xs.index_of(v)]` on a miss silently
    # returns the LAST element instead of faulting — Python has the identical trap
    # (`'hello'['hello'.find('zz')]` is `'o'`, measured). Use `position(pred) -> int?` below, or
    # `contains`, when a miss must be visible. NOTE Python's LIST twin, `list.index(x)`, raises
    # `ValueError` rather than returning `-1`: the sentinel here is the uniform Chezzi choice across
    # `List` and `str`, kept because changing it is a breaking API change, not because lists inherit it.
    native fn index_of(self, v: T) -> int
    native fn concat(self, other: List[T]) -> List[T]
    native fn extend(self, other: List[T]) -> None
    native fn sort(self) -> None where T: Comparable
    # Fold `T`'s `+` across the list (empty list -> `T`'s zero). An `int` list FAULTS `integer overflow
    # in Add` if the running total overflows i64 — CPython's `sum()` never overflows (arbitrary
    # precision), so this is the same upward divergence as the language-wide integer-overflow fault.
    native fn sum(self) -> T where T: Add
    native fn map[U](self, f: fn(T) -> U) -> List[U]
    native fn filter(self, p: fn(T) -> bool) -> List[T]
    native fn fold[U](self, init: U, f: fn(U, T) -> U) -> U
    native fn sort_by(self, cmp: fn(T, T) -> int) -> None
    native fn sort_by_key[K: Comparable](self, f: fn(T) -> K) -> None
    native fn min(self) -> Option[T] where T: Comparable
    native fn max(self) -> Option[T] where T: Comparable
    native fn min_by[K: Comparable](self, f: fn(T) -> K) -> Option[T]
    native fn max_by[K: Comparable](self, f: fn(T) -> K) -> Option[T]
    native fn first(self) -> Option[T]
    native fn last(self) -> Option[T]
    native fn reversed(self) -> List[T]
    # A new list that holds `n` copies of the elements, in order (Rust `vec.repeat(n)`, the rules of
    # `str.repeat`): `n <= 0` is `[]`, and a total that cannot be allocated faults
    # `list repeat capacity overflow`. `*` on a List is not a repeat: it means multiply only.
    native fn repeat(self, n: int) -> List[T]
    native fn insert(self, i: int, x: T) -> None
    # TICKET-278 — remove the element at index `i` and return it (Rust `Vec::remove`); `i` follows the
    # `xs[i]` negative-index rule and a bad index faults like `xs[i]` does.
    native fn remove(self, i: int) -> T
    native fn unique(self) -> List[T]
    native fn dedup(self) -> List[T]
    native fn chunk(self, n: int) -> List[List[T]]
    native fn windows(self, n: int) -> List[List[T]]
    native fn take_while(self, pred: fn(T) -> bool) -> List[T]
    native fn drop_while(self, pred: fn(T) -> bool) -> List[T]
    native fn count(self, pred: fn(T) -> bool) -> int
    # The CARRIER twin of `index_of`: a miss is `None`, not a `-1` that indexes as the last element.
    # Reach for this (or `Map.get`, the same shape for keys) when a miss must not be silently usable.
    native fn position(self, pred: fn(T) -> bool) -> Option[int]
    # TICKET-160 — shallow: a new container holding the same element handles (Python list/dict/set.copy()).
    native fn copy(self) -> List[T]

native struct Map[K: Hashable, V]:
    # Last wins on a repeated key, as in the `{k: v}` literal; `Map.from_iter(m)` copies `m`.
    native fn from_iter[S: Iterable[(K, V)]](pairs: S) -> Map[K, V]
    native fn len(self) -> int
    native fn contains(self, k: K) -> bool
    native fn get(self, k: K) -> Option[V]
    native fn keys(self) -> List[K]
    native fn values(self) -> List[V]
    native fn remove(self, k: K) -> Option[V]
    # TICKET-278 — store `v` under `k` and return the value it replaced (Rust `HashMap::insert`).
    native fn insert(self, k: K, v: V) -> Option[V]
    native fn merge(self, other: Map[K, V]) -> Map[K, V]
    native fn update(self, other: Map[K, V]) -> None
    # TICKET-160 — insertion order, identical to keys(); Map.from_iter(m.items()) == m.
    native fn items(self) -> List[(K, V)]
    native fn copy(self) -> Map[K, V]

native struct Set[T: Hashable]:
    native fn from_iter[S: Iterable[T]](xs: S) -> Set[T]
    native fn len(self) -> int
    native fn contains(self, v: T) -> bool
    # TICKET-278 — `true` when `v` was new (Rust `HashSet::insert`).
    native fn insert(self, v: T) -> bool
    native fn remove(self, v: T) -> bool
    native fn union(self, other: Set[T]) -> Set[T]
    native fn intersection(self, other: Set[T]) -> Set[T]
    native fn difference(self, other: Set[T]) -> Set[T]
    native fn copy(self) -> Set[T]

# `Channel[T]` — the reserved concurrency primitive. Identity stays the reserved `Ty::Channel(T)`
# (`resolve_type` reserved arm; the `Channel[T](cap)` ctor stays compiler-wired), and runtime dispatch
# stays Rust-inline (`vm/netio.rs channel_method`). Only the METHOD-TABLE sigs are file-backed here —
# harvested into the reserved type's method table (re-seeded by `seed_stdlib_structs`), looked up via
# `native_handle_method` with the channel's element type substituted for `Ty::Param("T")` — the
# file-backed replacement for the retired bespoke `channel_method_sig` arm.
native struct Channel[T]:
    # `send(v)` hands `v` to the receiver by handle (Go `chan T`).
    # Faults `send on a closed channel` after `close()` (Go: `panic: send on closed channel`,
    # identical). `try_send` is the non-faulting sibling.
    native fn send(self, v: T) -> None
    # `try_send` is the non-blocking partner of `send` (mirrors `try_recv` vs `recv`): returns `false`
    # when the send can't proceed — the channel is CLOSED, a BOUNDED channel is FULL, or a RENDEZVOUS
    # channel (`Channel[T](0)`) has no receiver already waiting — and `true` once the value is queued.
    # (An unbounded channel is never full, so its only `false` there is closed.)
    native fn try_send(self, v: T) -> bool
    # `?v` for the next value; `!RecvError` once the channel is closed AND drained, on every later
    # receive too, with no fault (Rust `mpsc::Receiver::recv` gives a `RecvError`, Go's
    # `v, ok := <-ch` gives `ok` false). `try_recv` (below) is the non-blocking, `T?` sibling.
    native fn recv(self) -> T!RecvError
    native fn try_recv(self) -> Option[T]
    # `close()` marks the channel closed (idempotent); a later `send` faults, `recv` drains then gives
    # `!RecvError`, and `for v in ch:` ends cleanly once drained.
    native fn close(self) -> None
    # `trip()` flips a permanent level-trigger latch: the channel then reports ready (`true`) on every
    # `recv`/`try_recv`/`wait`, fanning out to any number of receivers (the primitive behind
    # `std.cancel`'s `done()`). Idempotent; takes no args.
    native fn trip(self) -> None where T: bool
    native fn len(self) -> int
    # `cap()` reports the channel's capacity: `-1` for an unbounded `Channel[T]()`, `0` for a
    # rendezvous `Channel[T](0)`, or the bound passed to `Channel[T](cap)`.
    native fn cap(self) -> int

# The reserved scalar METHOD tables (`str`/`bytes`/`bytearray`). Identity stays the reserved
# `Ty::Str`/`Ty::Bytes`/`Ty::ByteArray` (`resolve_type`) and the `str()`/`bytes()`/`bytearray()`
# CTORS stay the `native ctor` decls above; runtime dispatch stays Rust-inline (`vm/mod.rs core_method` /
# `bytes_method`). Only the METHOD-TABLE sigs are file-backed here — harvested into each scalar's method
# table (re-seeded by `seed_stdlib_structs`), looked up via `native_handle_method` with no type args (the
# scalars are non-generic) — the file-backed replacement for the retired bespoke `str_method_sig` /
# `bytes_method_sig` / `bytearray_method_sig` arms.
native struct str:
    native fn len(self) -> int
    native fn upper(self) -> str
    native fn lower(self) -> str
    native fn trim(self) -> str
    # `str` conforms to `Error`: `message()` returns the string itself.
    native fn message(self) -> str
    native fn split(self, sep: str) -> List[str]
    native fn chars(self) -> List[str]
    native fn join(self, parts: List[str]) -> str
    native fn starts_with(self, prefix: str) -> bool
    native fn contains(self, item: str) -> bool
    native fn ends_with(self, suffix: str) -> bool
    # `encode()` -> `bytes`: UTF-8 encode (str is UTF-8 internally; copies the bytes out). No
    # encoding-name argument — UTF-8 only (other codecs are an explicit future non-goal).
    native fn encode(self) -> bytes
    # Receiver methods forwarding to the `std.string` free fns (no import needed); byte-identical to the
    # std.string codepoint-loop oracle for valid inputs (`repeat` raises a recoverable capacity-overflow
    # fault instead of aborting on a huge count).
    native fn replace(self, old: str, new: str) -> str
    native fn repeat(self, n: int) -> str
    # A NEW string with the codepoints in reverse order (`s[::-1]` is removed). `str` is immutable, so
    # there is no in-place `reverse`: `reversed()` returns a new value on `List`, `str`, `bytes` and
    # `bytearray`; `reverse()` changes in place and exists on `List` and `bytearray` only.
    native fn reversed(self) -> str
    native fn pad_left(self, width: int, fill: str) -> str
    native fn pad_right(self, width: int, fill: str) -> str
    # SENTINEL, NOT A CARRIER — `-1` on a miss, exactly Python's `str.find`. Same hazard as
    # `List.index_of`: `s[s.index_of(t)]` on a miss silently yields the LAST character, and Python does
    # the same (`'hello'['hello'.find('zz')]` is `'o'`, measured). `contains` is the miss-visible check;
    # there is no `T?` twin on `str` (`List.position` is the list one).
    native fn index_of(self, needle: str) -> int
    native fn count(self, needle: str) -> int
    native fn strip_prefix(self, prefix: str) -> str
    native fn strip_suffix(self, suffix: str) -> str
    native fn split_lines(self) -> List[str]
    # `strip` is a trim alias.
    native fn strip(self) -> str
    # Numeric parse (trims, like Python `int()` / `float()`): a bad input gives an error that names
    # the cause (`!"to_int: cannot parse 'x' as int"`), never a fault.
    native fn to_int(self) -> int!
    native fn to_float(self) -> float!

# The numeric conversions. `int` to `float` is total (Rust `n as f64`: past 2^53 it rounds to the
# nearest float). `float` to `int` truncates toward zero and gives `None` for NaN, the infinities and
# a value outside i64 (Rust `f64::to_i64` in `num-traits`), so no NaN becomes a silent number.
native struct int:
    native fn to_float(self) -> float
    # The int as `len` bytes (1 to 8), big- or little-endian (Rust `to_be_bytes`, Python
    # `n.to_bytes(len, "big")`). Unsigned by default, as Python: a negative int needs `signed=true`
    # (two's complement). A value that does not fit gives an error that names it.
    native fn to_be_bytes(self, len: int, signed: bool = false) -> bytes!
    native fn to_le_bytes(self, len: int, signed: bool = false) -> bytes!
    # The int that 0 to 8 bytes hold (`b""` is 0, Python `int.from_bytes`). Unsigned by default: an
    # 8-byte value above i64::MAX gives an error that names `signed=true`.
    native fn from_be_bytes(b: bytes, signed: bool = false) -> int!
    native fn from_le_bytes(b: bytes, signed: bool = false) -> int!
    # Rust `i64::from(true)`: `true` is 1, `false` is 0.
    fn from(x: bool) -> int:
        return if x: 1 else: 0
    # Rust `i64::try_from` / `"5".parse::<i64>()`: `str.to_int`, the one parse.
    fn try_from(x: str) -> int!:
        return x.to_int()

native struct float:
    native fn to_int(self) -> Option[int]
    # Rust `f64::from(true)`: `true` is 1.0, `false` is 0.0. No `float.from(int)`: an int past
    # 2^53 does not round-trip (rustc: `f64: From<i64>` is E0277); write `n.to_float()`.
    fn from(x: bool) -> float:
        return if x: 1.0 else: 0.0
    # Rust `"1.5".parse::<f64>()`: `str.to_float`, the one parse.
    fn try_from(x: str) -> float!:
        return x.to_float()

# `bytes` (immutable byte sequence): `decode() -> str!` (UTF-8; invalid UTF-8 gives an error that
# names the byte, `!"decode: invalid UTF-8 at byte 2 (0xff)"`) and `len()` (byte count). `extend` is
# NOT a bytes method (bytes is immutable).
native struct bytes:
    # Each element is one byte, an int in 0..=255 (a fault names any other).
    native fn from_iter[S: Iterable[int]](xs: S) -> bytes
    # `n` zero bytes (Python `bytes(n)`); a negative `n` faults.
    native fn zeroed(n: int) -> bytes
    native fn decode(self) -> str!
    # W7-8 — the DISPLAY twin of `decode()`: each maximal invalid UTF-8 subsequence becomes one U+FFFD
    # (Python `b.decode(errors="replace")`), so it cannot fail. `path.Path.str()` is built on it.
    native fn decode_lossy(self) -> str
    native fn len(self) -> int
    native fn reversed(self) -> bytes

# `bytearray` (mutable byte buffer): `len`, `push(int)` (appends one byte, 0-255 validated at runtime),
# `pop() -> int?` (removes the last), `decode() -> str!` (UTF-8, as `bytes.decode()`),
# `copy() -> bytearray` (a new buffer), `extend(bytes|bytearray|List[int])`.
native struct bytearray:
    native fn from_iter[S: Iterable[int]](xs: S) -> bytearray
    native fn zeroed(n: int) -> bytearray
    native fn len(self) -> int
    native fn push(self, b: int) -> None
    # Takes any byte-sequence shape (bytes|bytearray|List[int]); the checker types the argument before the table lookup.
    native fn extend(self, other) -> None
    native fn pop(self) -> Option[int]
    native fn decode(self) -> str!
    native fn copy(self) -> bytearray
    native fn reverse(self) -> None
    native fn reversed(self) -> bytearray

# The two carrier ENUMS. These decls ARE the enums behind `T?` and `T!E`: the checker harvests them
# (`harvest_native_enums`) into its ordinary enum tables, so variants, patterns and exhaustiveness
# read them like any user enum. The checker's two carrier `Ty` variants are only their type spelling.
# The error carrier has two slots; the surface `T!` means `T!Error` in type position only. Neither declares a method. The `?` operator, error propagation and native
# construction stay runtime-wired on the fixed variant ids.

native enum Option[T]:
    Some(T)
    None

native enum Result[T, E]:
    Ok(T)
    Err(E)

# The four bare variant names every module reads are ordinary variant imports of the two enums
# above. A declaration, a global or a local of the same name shadows them; an explicit
# `import V from E` may not rebind them.
import Some, None from Option
import Ok, Err from Result

# The two GLOBAL protocols, in scope in every module with no import (Go keeps `any` and `error` global
# the same way). Every other std protocol is declared in the `std.*` module that owns its topic
# (`std.ops`, `std.cmp`, `std.iter`, `std.string`, `std.path`, `std.convert`) and a bound on it needs an
# import. These `protocol` declarations are the only source of each shape: `Checker::seed_std_protocols`
# harvests them. Conformance and operator lowering stay checker-wired (`satisfies`, `iter_elem`,
# `check_bounds`).

# `Any` -- the accept-all TOP type: an EMPTY structural protocol (zero methods, zero embeds), so every
# type satisfies it. Written with the `pass` empty-body marker.
protocol Any:
    pass

protocol Error:
    fn message(self) -> str

# `RecvError` — what `Channel.recv` returns once the channel is closed and drained (Rust std
# `mpsc::RecvError`, same message). Like `Range`, every module sees it with no import.
struct RecvError:
    fn message(self) -> str:
        return "receiving on a closed channel"

# `Range` — a range of ints as a VALUE (TICKET-253). `a..b`, `a..=b`, `..b`, `a..` and `..` build one; so
# does `Range(a, b)` / `Range(a, b, step)` (the constructor is the only place for a step; a negative step
# counts down). It is an ordinary struct: `iter` makes it `Iterable[int]` (NOT an `Iterator`: one value
# iterates any number of times), `contains` makes it `Contains[int]`, `hash` + structural `==` make it a
# map key, `str` is the source form. A slice takes a `Range`: `xs[a..b]`, `xs[Range(0, 10, 2)]`.
struct Range:
    start: int?
    end: int?
    step: int = 1
    inclusive: bool = false

    # True when `cur` is inside the end bound `e` for this direction.
    fn _in(self, cur: int, e: int) -> bool:
        if self.inclusive and cur == e:
            return true
        if self.step > 0:
            return cur < e
        return cur > e

    # True when `cur + step` is inside the end bound. No expression here can overflow:
    # opposite signs add toward zero, equal signs subtract toward zero.
    fn _has_next(self, cur: int, e: int) -> bool:
        if self.step > 0:
            if cur < 0 and e > 0:
                return self._in(cur + self.step, e)
            gap := e - cur
            return gap - self.step > 0 or (self.inclusive and gap - self.step == 0)
        if cur > 0 and e < 0:
            return self._in(cur + self.step, e)
        gap := cur - e
        return gap + self.step > 0 or (self.inclusive and gap + self.step == 0)

    fn iter(self) -> Iterator[int]:
        if self.step == 0:
            panic("Range() step cannot be zero")
        cur := 0
        match self.start:
            ?s:
                cur = s
            None:
                panic("a range with no start cannot be iterated")
        match self.end:
            ?e:
                if self.step == 1:
                    # The common case with no method call per step: `cur < e` bounds `cur + 1`, so
                    # the add cannot overflow.
                    if self.inclusive:
                        if cur <= e:
                            yield cur
                            while cur < e:
                                cur = cur + 1
                                yield cur
                    else:
                        while cur < e:
                            yield cur
                            cur = cur + 1
                elif self._in(cur, e):
                    yield cur
                    while self._has_next(cur, e):
                        cur = cur + self.step
                        yield cur
            None:
                while true:
                    yield cur
                    cur = cur + self.step

    fn len(self) -> int:
        n := 0
        match self.end:
            ?e:
                match self.start:
                    ?s:
                        if self.step == 0:
                            panic("Range() step cannot be zero")
                        if self._in(s, e):
                            span := e - s
                            if self.step < 0:
                                span = s - e
                            mag := self.step
                            if mag < 0:
                                mag = 0 - mag
                            n = span / mag
                            if span % mag != 0 or self.inclusive:
                                n = n + 1
                    None:
                        panic("len() needs a range with a start and an end")
            None:
                panic("len() needs a range with a start and an end")
        return n

    # True when `item` is `s` plus a whole number of steps. Both operands are reduced by `step` first:
    # `item - s` overflows for an item and a start of opposite signs, and the two remainders cannot.
    # A remainder keeps the sign of its operand. Remainders of opposite signs match when they differ
    # by exactly one step; `a + step` and `b + step` below add opposite signs, so they cannot overflow.
    fn _aligned(self, item: int, s: int) -> bool:
        if self.step == 1 or self.step == -1:
            return true
        a := item % self.step
        b := s % self.step
        if a == b:
            return true
        if a > 0 and b < 0:
            if self.step > 0:
                return a == b + self.step
            return a + self.step == b
        if a < 0 and b > 0:
            if self.step > 0:
                return b == a + self.step
            return b + self.step == a
        return false

    fn contains(self, item: int) -> bool:
        if self.step == 0:
            panic("Range() step cannot be zero")
        up := self.step > 0
        match self.start:
            ?s:
                if (up and item < s) or (not up and item > s):
                    return false
            None:
                pass
        # The end bound is tested before the step alignment, so `_aligned` below only runs for an
        # item between the bounds.
        match self.end:
            ?e:
                if not self._in(item, e):
                    return false
            None:
                pass
        match self.start:
            ?s:
                return self._aligned(item, s)
            None:
                return true

    fn hash(self) -> int:
        h := (self.start ?? 0) ^ (self.end ?? 0) ^ self.step
        if self.inclusive:
            h = h ^ 1
        return h

    # The `Eq` hook a map key needs beside `hash` (TICKET-280): field by field, as `==` was.
    fn eq(self, other: Self) -> bool:
        return self.start == other.start and self.end == other.end and self.step == other.step and self.inclusive == other.inclusive

    fn str(self) -> str:
        a := ""
        match self.start:
            ?s:
                a = "{s}"
            None:
                pass
        b := ""
        match self.end:
            ?e:
                b = "{e}"
            None:
                pass
        if self.step == 1 and self.inclusive:
            return "{a}..={b}"
        if self.step == 1:
            return "{a}..{b}"
        if a == "":
            a = "None"
        if b == "":
            b = "None"
        if self.inclusive:
            return "Range({a}, {b}, {self.step}, true)"
        return "Range({a}, {b}, {self.step})"
