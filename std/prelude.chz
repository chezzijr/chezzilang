# std.prelude — the universe builtins' SIGNATURES, declared in Chezzi (phase 3a).
#
# ALWAYS-LINKED into every program's module graph, but with UNIVERSE semantics: these
# names are always in scope, NOT an importable module namespace. Each `native fn`/`native ctor` is a
# body-less signature whose implementation is bound natively (name-keyed `do_builtin` in the VM /
# `builtins::call` in the interp) — the front-end reads ONLY the signature; the backends compile no
# bytecode for a native decl (it is never a callable user fn).
#
# DYNAMIC-PARAM CONVENTION (native-decl-scoped — Chezzi stays statically typed for user code, this
# introduces NO user-facing `any`/`never`): an UNANNOTATED param means the dynamic "accepts anything"
# type; a native decl with NO `-> ret` means native-controlled/never (both map to the internal `?`).
#
# `native fn`  => a FIRST-CLASS universe function (bindable, passable, `defer`-able as a bare call).
# `native ctor` => a NON-first-class scalar/type constructor (value-position use is rejected, uniform
#                  with `f := Point` / `f := List`).
#
# print: variadic display fn — `...args: Any` (the `Any` top type accepts every value); the
# keyword-only `sep`/`end` follow the variadic. Its lowering stays on the specialized
# `CallPrint`/`CallPrintSep` opcodes (a direct `print(...)` call), so this decl is the checker-only
# SIGNATURE authority (retired the last synthetic Rust sig). The VALUE form (`p := print`) is a fixed
# 1-arg function (the specialized opcodes are unreachable through a bound value). range + List/Map/Set:
# phase 2b (still hard-coded).

native fn print(...args: Any, sep: str = " ", end: str = "\n") -> nil
native fn ord(c: str) -> int
native fn chr(n: int) -> str
native fn panic(msg: str)

native ctor int(x) -> int
native ctor float(x) -> float
native ctor bool(x) -> bool
native ctor str(x) -> str
native ctor bytes(x) -> bytes
native ctor bytearray(x) -> bytearray

# The three builtin container types' METHOD surface (phase 5a-containers). List/Map/Set are RESERVED
# UNIVERSE types (`Ty::List`/`Ty::Map`/`Ty::Set` — always in scope, not import-gated), and their LITERAL
# syntax (`[...]`/`{k:v}`/`{1,2}`) + turbofish ctor (`List[int]()`) stay COMPILER-WIRED (the type-arg-
# driven element identity is not a flat `FnSig`, so it lives in `resolve_type`/`builtin_container_sig`,
# NOT here). Only the METHOD tables are file-backed: each body-less `native fn` (leading bare `self`, which
# the harvest STRIPS) supplies the exact sig the retired bespoke `list_method_sig`/`map_method_sig`/
# `set_method_sig` arms carried. The checker harvests these into each reserved type's method table (seeded
# by `seed_stdlib_structs` into `self.structs`) and routes `Ty::List`/`Ty::Map`/`Ty::Set` method
# resolution through them (behavior-preserving; the sigs BYTE-MATCH the retired arms).
#
# The closure-driven HOFs are now ALSO file-backed here: `map[U]`/`fold[U]`/`sort_by_key[K: Comparable]`
# declare their OWN method type param (recovered from the closure body by the generic solver's
# closure-return LOOP-BACK — routed through `infer_generic_method`), and `filter`/`sort_by` are flat
# closure-typed sigs. This retired the bespoke `infer_list_hof` arm. `sort` is file-backed via
# `where T: Comparable` (a generic bound enforced at each call site by the Ty::List arm's
# `enforce_bounds`). `sum` carries `where T: Add` as documentation, but its true requirement is MONOID
# (Add + zero) and both runtimes are numeric-only, so a residual `!elem.is_numeric()` gate survives in the
# arm (a struct with a structural `add` still errors at CHECK time). `Map`/`Set`'s key/element type params
# carry a `Hashable` bound so the internal `Map[K, V]`/`Set[T]` return types resolve at harvest.

native struct List[T]:
    native fn len(self) -> int
    native fn push(self, v: T) -> nil
    native fn pop(self) -> Option[T]
    native fn reverse(self) -> nil
    native fn contains(self, v: T) -> bool
    native fn index_of(self, v: T) -> int
    native fn concat(self, other: List[T]) -> List[T]
    native fn extend(self, other: List[T]) -> nil
    native fn sort(self) -> nil where T: Comparable
    native fn sum(self) -> T where T: Add
    native fn map[U](self, f: fn(T) -> U) -> List[U]
    native fn filter(self, p: fn(T) -> bool) -> List[T]
    native fn fold[U](self, init: U, f: fn(U, T) -> U) -> U
    native fn sort_by(self, cmp: fn(T, T) -> int) -> nil
    native fn sort_by_key[K: Comparable](self, f: fn(T) -> K) -> nil
    native fn min(self) -> T where T: Comparable
    native fn max(self) -> T where T: Comparable
    native fn min_by[K: Comparable](self, f: fn(T) -> K) -> T
    native fn max_by[K: Comparable](self, f: fn(T) -> K) -> T
    native fn first(self) -> Option[T]
    native fn last(self) -> Option[T]
    native fn reversed(self) -> List[T]
    native fn insert(self, i: int, x: T) -> nil
    native fn remove_at(self, i: int) -> T
    native fn unique(self) -> List[T]
    native fn dedup(self) -> List[T]
    native fn chunk(self, n: int) -> List[List[T]]
    native fn windows(self, n: int) -> List[List[T]]
    native fn take_while(self, pred: fn(T) -> bool) -> List[T]
    native fn drop_while(self, pred: fn(T) -> bool) -> List[T]
    native fn count(self, pred: fn(T) -> bool) -> int
    native fn position(self, pred: fn(T) -> bool) -> Option[int]

native struct Map[K: Hashable, V]:
    native fn len(self) -> int
    native fn has(self, k: K) -> bool
    native fn get(self, k: K) -> Option[V]
    native fn keys(self) -> List[K]
    native fn values(self) -> List[V]
    native fn remove(self, k: K) -> Option[V]
    native fn merge(self, other: Map[K, V]) -> Map[K, V]
    native fn update(self, other: Map[K, V]) -> nil

native struct Set[T: Hashable]:
    native fn len(self) -> int
    native fn has(self, v: T) -> bool
    native fn add(self, v: T) -> nil
    native fn remove(self, v: T) -> bool
    native fn union(self, other: Set[T]) -> Set[T]
    native fn intersection(self, other: Set[T]) -> Set[T]
    native fn difference(self, other: Set[T]) -> Set[T]

# `Channel[T]` — the reserved concurrency primitive. Identity stays the reserved `Ty::Channel(T)`
# (`resolve_type` reserved arm; the `Channel[T](cap)` ctor stays compiler-wired), and runtime dispatch
# stays Rust-inline (`vm/netio.rs channel_method`). Only the METHOD-TABLE sigs are file-backed here —
# harvested into the reserved type's method table (re-seeded by `seed_stdlib_structs`), looked up via
# `native_handle_method` with the channel's element type substituted for `Ty::Param("T")` — the
# file-backed replacement for the retired bespoke `channel_method_sig` arm.
native struct Channel[T]:
    # `send(v)` moves `v` across the airlock (well-typed `send` is always sendable — the element type is
    # sendable-checked at the channel's construction).
    native fn send(self, v: T) -> nil
    # `try_send` is the non-blocking partner of `send` (mirrors `try_recv` vs `recv`): returns `false`
    # when the send can't proceed — the channel is CLOSED, or a BOUNDED channel is FULL — and `true`
    # once the value is queued. (An unbounded channel is never full, so its only `false` there is closed.)
    native fn try_send(self, v: T) -> bool
    native fn recv(self) -> T
    native fn try_recv(self) -> Option[T]
    # `close()` marks the channel closed (idempotent); a later `send` faults, `recv` drains then faults,
    # and `for v in ch:` ends cleanly once drained.
    native fn close(self) -> nil
    # `trip()` flips a permanent level-trigger latch: the channel then reports ready (`true`) on every
    # `recv`/`try_recv`/`wait`, fanning out to any number of receivers (the primitive behind
    # `std.cancel`'s `done()`). Idempotent; takes no args.
    native fn trip(self) -> nil
    native fn len(self) -> int
    # `cap()` reports the channel's capacity: the bound passed to `Channel[T](cap)`, or `0` for an
    # unbounded `Channel[T]()`.
    native fn cap(self) -> int

# The two builtin generic ENUMS' variant SHAPE (phase 5b-native-enum). `Option`/`Result` are the most
# deeply-wired builtin types — the `?` operator, top-level error propagation, exhaustive `match`, and
# native construction (`Ok`/`Err`/`Some`/`None` from `NativeRet`) are all RESERVED and stay RUST-WIRED:
# their identity is `Ty::Option`/`Ty::Result` (resolved in `resolve_type`, NOT a nominal enum), their
# variant set is synthesized INLINE from that `Ty` shape (`variants_of`/`match_kind`), and construction
# is native. Only the declarable VARIANT SHAPE is file-backed here, as an ADDITIVE, DRIFT-GUARDED
# MIRROR: the checker harvests these decls (`harvest_native_enum_table`) and asserts the parsed variant
# set BYTE-MATCHES the inline maps, so the `.chz` source-of-truth can never silently drift from the Rust
# wiring — but nothing at runtime consults the harvested table. `Result` is spelled in its faithful
# two-slot form `Result[T, E]` with `Err(E)` (`Ty::Result` always carries a T and an E); the surface
# `Result[T]` → `E = Error`-protocol DEFAULT is injected by `resolve_type`, NOT encoded in the variant.
# Neither carries any bespoke method (there is no `Ty::Option`/`Ty::Result` arm in method resolution), so
# both bodies are variants-only.

native enum Option[T]:
    Some(T)
    None

native enum Result[T, E]:
    Ok(T)
    Err(E)

# The builtin/reserved STRUCTURAL PROTOCOLS' shape (phase 5c-protocols). These 16 are UNIVERSE protocols
# (always in scope, usable as a generic bound — `[T: Comparable]` / `[T: Arithmetic]` — but never
# redeclarable by a user program: `is_reserved_protocol` rejects a user `protocol Comparable:`). Only the
# SHAPE (method sigs + `+`-joined embeds) is file-backed here, as an ADDITIVE, DRIFT-GUARDED MIRROR: the
# live runtime source stays the Rust `prebuilt_protocols` seed (installed at `Checker::new`, BEFORE any
# module), and the checker asserts (`assert_native_protocol_shape_matches`, debug-only) that the parsed
# shape BYTE-MATCHES the seed so the two can't silently drift. Everything that DECIDES conformance +
# operator binding stays RUST-WIRED and is untouched: `satisfies` (int/float satisfy Add/Comparable/Neg
# INTRINSICALLY with no method; a user struct satisfies structurally via its methods), `iter_elem`
# (Iterator conformance), operator lowering (`+`→add, `<`→compare, `for`→Iterator, `[]`→Index,
# `[:]`→Slice, `?`/interpolation/Map-keys), and `check_bounds`. The reserved-protocol hoist is
# VALIDATE-AND-NO-OP in a stdlib module (never inserted into the protocol table), so these decls register
# no user symbol — they are shape documentation the drift guard pins to the Rust seed.
#
# All 17 reserved protocols are mirrored here, including `Iterable` — its `iter(self) -> Iterator[Elem]`
# return type resolves via `resolve_type`'s dedicated `Iterator[T]` value arm to the same
# `Ty::Struct("Iterator",[Elem])` the seed uses, so the shape ports cleanly like every other one.

# `Any` — the accept-all TOP type: an EMPTY structural protocol (zero methods, zero embeds), so every
# type satisfies it. Written with the `pass` empty-body marker. A user empty protocol behaves
# identically. Users cannot redeclare `Any` (`is_reserved_protocol`); this prelude mirror is exempt via
# the always-injected-stub / validate-and-no-op stdlib hoist path.
protocol Any:
    pass

protocol Comparable:
    fn compare(self, other: Self) -> int

protocol Stringable:
    fn str(self) -> str

protocol Error:
    fn message(self) -> str

protocol Hashable:
    fn hash(self) -> int

protocol Add:
    fn add(self, other: Self) -> Self

protocol Sub:
    fn sub(self, other: Self) -> Self

protocol Mul:
    fn mul(self, other: Self) -> Self

protocol Div:
    fn div(self, other: Self) -> Self

protocol Mod:
    fn mod(self, other: Self) -> Self

protocol Neg:
    fn neg(self) -> Self

protocol Arithmetic:
    Add + Sub + Mul + Div

# `Iterator[Elem]` carries one type param (the element) so the generic-arity check treats `Iterator[T]`
# uniformly, but its `next` sig is `-> Option[Self]` (Elem is arity-only, unused in the sig — matching the
# Rust seed); real element recovery + conformance stay special-cased (`iter_elem`).
protocol Iterator[Elem]:
    fn next(self) -> Option[Self]

# `Iterable[Elem]` — "can produce a fresh cursor" — its `iter(self) -> Iterator[Elem]` returns the
# reserved `Iterator[T]` value type (`Ty::Struct("Iterator",[Elem])`), which `resolve_type` accepts
# in return position (the dedicated `Iterator[T]` value arm), so the SHAPE ports cleanly. Conformance
# stays special-cased (`satisfies_args`: built-in collections + any `Iterator[T]` intrinsically — every
# Iterator IS Iterable via `iter() == self` — plus a user struct with a structural `iter`), and the
# bound's `[Elem]` recovers the element type at call sites (`infer_method_call`'s `Iterable.iter` case).
protocol Iterable[Elem]:
    fn iter(self) -> Iterator[Elem]

protocol Index[K, V]:
    fn index(self, k: K) -> V

# `IndexSet` embeds no protocol but has TWO methods in ORDER (index before set_index — `methods` is an
# ordered Vec, and the drift guard pins the order).
protocol IndexSet[K, V]:
    fn index(self, k: K) -> V
    fn set_index(self, k: K, v: V) -> nil

# Python-style slicing: three `int?` (Option[int]) components (start/end/step), each None when omitted;
# both engines always pass all three explicitly. `R` is the slice result type, recovered at call sites.
protocol Slice[R]:
    fn slice(self, start: int?, end: int?, step: int?) -> R

# `Convert[S]` — the extensible type-conversion protocol (Rust `From`, target-keyed). Its sole method
# `convert(x: S) -> Self` is STATIC (first param is `x`, NOT `self`), so it is called `Target.convert(src)`
# and produces a fresh `Self`. `S` (the source type) is the one arity param, so the bound reads
# `[T: Convert[str]]`. Slice 1 (this): the protocol is declared + reserved + bound-parseable only —
# structural witnessing (a concrete type SATISFYING it) is slice 2, and `T.convert(..)` through a bound is
# slice 3. The shape mirrors the Rust seed in `prebuilt_protocols` (`is_static`, `[S]`).
protocol Convert[S]:
    fn convert(x: S) -> Self

# `Contains[Item]` — the membership protocol (Python `__contains__`, L5): `x in obj` dispatches to
# `contains(self, item) -> bool`. Built-in list/set/map/str test membership intrinsically; a user
# struct/enum satisfies it structurally. `Item` (the element type) is recovered at the `in` site.
protocol Contains[Item]:
    fn contains(self, item: Item) -> bool
