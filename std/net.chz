# std.net — minimal TCP client/server, declared in Chezzi (phase 4c-net).
#
# FILE-BACKED, IMPORT-GATED native module (like std/regex.chz). Its native TYPES (`Socket`/`Listener`)
# + functions are in scope ONLY after `import std.net` (bare `Socket`/`Listener`) or a `from std.net
# import …`. The resolver loads this real file (keeping the `native` marker), and the checker harvests
# the `native struct` + `native fn` declarations below as the module's SIGNATURE source — retiring the
# hand-built `native_module_sig` net arm AND the bespoke `socket_method_sig`/`listener_method_sig`
# method arms (their sigs now come from the `native fn` methods below, harvested into each type's method
# table — the phase-4c native-method-binding capability).
#
# Every declaration is BODY-LESS: `Socket`/`Listener` stay the RESERVED opaque VM handles `Ty::Socket`/
# `Ty::Listener` (NOT nominal structs — no field layout), and the `connect`/`listen`/`read`/`write`/
# `accept`/`close` calls stay VM-intercepted at runtime by name (they allocate a handle + register
# netpoller interest, parking the fiber on a would-block op). The backends compile NOTHING for a
# `native fn`/`native struct` — the front-end reads ONLY the signature.
#
# The socket seam is **`str`-only** (B1/R1): `read` returns `Result[str]`, so it DECODES. It never
# lossily decodes: a chunk that ends mid-codepoint retains its ≤3-byte tail on the socket and prepends
# it to the next read (so `read(n)` may return up to `n + 3` bytes, and a byte-at-a-time read of valid
# text reassembles exactly); genuinely-invalid bytes — i.e. a BINARY payload — return
# `Err("invalid utf-8 on the socket: …")`, and an incomplete codepoint left when the peer closes returns
# `Err("invalid utf-8 at eof: …")`. An invalid-utf-8 Err is NON-DESTRUCTIVE and STICKY: the valid text
# before the bad byte is delivered first, the undecodable bytes stay carried, and every later read re-errs
# the same way — so a caller cannot silently shred the stream; it must `close()`. A read blocks until it
# has a whole character (Go `ReadRune` / Python text-mode); `timeout_ms` bounds the whole call, and a
# poll-once `read(n, 0)` that took a partial codepoint says `Err("incomplete utf-8: …")`, not
# `Err("timeout")` (= nothing arrived). `read(0)` is a no-op `Ok("")` (it never touches the socket and
# keeps any carried tail) but still errs on a CLOSED socket. Binary sockets need `read_bytes`/
# `write_bytes`, which need the `bytes` native seam (docs/gaps.md R1) — not implemented yet.
#
# `read`/`write`/`accept` carry an OPTIONAL trailing `timeout_ms: int` (`Err("timeout")` if no data /
# not writable / no connection within it). Spelled as a trailing `= 0` default: harvest lowers a
# trailing-default param to an optional-tail sig (min_params = len - 1). The `= 0` is a MARKER only —
# desugar never injects a native-fn default at a call site, so the supplied arg count stays truthful.

native struct Socket:
    native fn read(self, n: int, timeout_ms: int = 0) -> Result[str]
    native fn write(self, data: str, timeout_ms: int = 0) -> Result[int]
    native fn close(self) -> nil

native struct Listener:
    native fn accept(self, timeout_ms: int = 0) -> Result[Socket]
    native fn addr(self) -> Result[str]
    native fn close(self) -> nil

native fn connect(addr: str) -> Result[Socket]
native fn listen(addr: str) -> Result[Listener]
