# std.cmp — comparison helpers as generic functions over the `Comparable` protocol (M7-G3).
#
# Written entirely in Chezzi: `<` dispatches through `Comparable.compare`, so these work for every
# Comparable type — int, float, str, AND any user struct that implements BOTH `compare(self, other)
# -> int` and `eq(self, other) -> bool` (M23: `Comparable` embeds `Eq`).
# This replaces the old numeric-only `std.math.min`/`max` (the gap-#12 ad-hoc int/float overload)
# with one real, extensible implementation.

# The larger of `a` and `b`. On a tie (neither is smaller) returns the first argument, `a`
# — matches `min`, and is Python's rule, so a `NaN` operand propagates.
fn max[T: Comparable](a: T, b: T) -> T:
    if a < b:
        return b
    return a

# The smaller of `a` and `b`. On a tie (neither is smaller) returns the first argument, `a`
# — Python's rule, so a `NaN` operand propagates.
fn min[T: Comparable](a: T, b: T) -> T:
    if b < a:
        return b
    return a

# `x` clamped to the inclusive range `[lo, hi]`. Faults when `lo > hi` (Rust `clamp` panics there
# too).
fn clamp[T: Comparable](x: T, lo: T, hi: T) -> T:
    if hi < lo:
        panic("cmp.clamp: inverted bounds (lo > hi)")
    if x < lo:
        return lo
    if hi < x:
        return hi
    return x
