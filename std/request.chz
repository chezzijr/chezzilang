# std.request — HTTP client, declared in Chezzi (phase 4f).
#
# FILE-BACKED, IMPORT-GATED native module (like std/regex.chz). Its native TYPE (`Response`) +
# functions are in scope ONLY after `import std.request` (bare `Response`) or an `import … from std.request`.
# The resolver loads this real file (keeping the `native` marker), and the checker harvests
# the `native struct` + `native fn` declarations below as the module's SIGNATURE source — retiring both
# the hand-built `native_module_sig` request arm AND its `export_struct` Response arm.
#
# Every declaration is BODY-LESS: the runtime layout + implementations stay native (name-keyed in
# `src/native/request.rs`, dispatched via `native_members("std.request")`). The backends compile
# NOTHING for a `native fn`/`native struct` — the front-end reads ONLY the signature.
#
# `get`/`get_bytes`/`post`/`request` take an optional `timeout_ms: int? = None`: a positive value is
# the limit for that call; `None`, `0` and a negative value keep the agent's default limits. Like
# every native default, the call site (or, through a fn value, the callee) fills `None` from this
# decl. The verb wrappers (put/patch/delete/head) are plain.
#
# FIELD ORDER IS LOAD-BEARING: `Response`'s field order is positional across the remaining hand-built
# runtime layout copies (compiler `Compiler::new`, `native/request.rs` response_ret,
# and seed_stdlib_structs), drift-guarded by a checker test. Do not reorder without updating all copies.

native struct Response:
    status: int
    body: str
    headers: Map[str, str]

native fn get(url: str, timeout_ms: int? = None) -> Response!
native fn get_bytes(url: str, timeout_ms: int? = None) -> bytes!
native fn post(url: str, body: str, timeout_ms: int? = None) -> Response!
native fn request(method: str, url: str, body: str, headers: Map[str, str], timeout_ms: int? = None) -> Response!
native fn put(url: str, body: str) -> Response!
native fn patch(url: str, body: str) -> Response!
native fn delete(url: str) -> Response!
native fn head(url: str) -> Response!
