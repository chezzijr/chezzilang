# examples/for_tuple.chz — tuple-destructuring `for` (gap) + std.iter enumerate/zip.

import std.iter

# Destructure a list of pairs directly.
pairs := [(1, "one"), (2, "two"), (3, "three")]
for n, name in pairs:
    print("{n} = {name}")

# One loop variable still binds the whole tuple.
for p in pairs:
    print("{p.0}:{p.1}")

# Triples destructure into three names.
points := [(1, 2, 3), (4, 5, 6)]
for x, y, z in points:
    print(x + y + z)

# enumerate: pair each element with its index.
fruits := ["apple", "banana", "cherry"]
for i, f in iter.enumerate(fruits):
    print("{i}: {f}")

# zip: combine two lists, truncating to the shorter.
names := ["ann", "bob", "cy"]
ages := [30, 25, 40, 99]
for name, age in iter.zip(names, ages):
    print("{name} is {age}")

# Composes with comprehensions.
xs := [1, 2, 3]
ys := [10, 20, 30]
sums := [a + b for a, b in iter.zip(xs, ys)]
print(sums)
