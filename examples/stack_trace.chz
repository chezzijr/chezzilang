# examples/stack_trace.chz — a runtime fault reports a stack trace: the error file:line:col, then
# the call chain (innermost first) with the file:line:col of each call. Run it from the repo root:
#
#   runtime error (examples/stack_trace.chz:12:12): division by zero
#     at divide (called at examples/stack_trace.chz:15:12)
#     at compute (called at examples/stack_trace.chz:18:11)
#     at main (called at examples/stack_trace.chz:20:1)
#
# (This program intentionally faults — it exits non-zero. The trace is deterministic.)

fn divide(a: int, b: int) -> int:
    return a / b

fn compute(x: int) -> int:
    return divide(x, 0)

fn main():
    print(compute(10))

main()
