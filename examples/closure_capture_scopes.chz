# Closure capture across scopes: capture is now UNIFORMLY BY REFERENCE — a closure shares the
# closest binding of a captured name and sees later writes to it. A local, a global, and a `ref`
# local all behave the same way here (the `ref` annotation is now only needed for by-reference
# *params*, not for capture). See docs/syntax.md for the full rule.
import std.ref

g := 10                          # module global

fn local_shared() -> int:
    x := 10
    f := fn() -> int: x          # captures the local BY REFERENCE (shares the binding)
    x = 20
    return f()                   # 20 — the closure sees the later write

fn ref_shared() -> int:
    x: ref int = 10              # a `ref` local: also a shared box
    f := fn() -> int: x
    x = 20
    return f()                   # 20 — the closure sees the write through the box

fn read_global() -> int:
    f := fn() -> int: g          # `g` is global: referenced live
    return f()

print(local_shared())            # 20
print(ref_shared())              # 20
g = 20                           # mutate the global after the closure was created
print(read_global())             # 20 — live read of the current global value
