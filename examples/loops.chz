# break / continue in for and while loops.

# for-range: skip odd numbers, stop at 8.
for i in 0..100:
    if i == 8: break
    if i % 2 == 1: continue
    print(i)

# for-list: continue past a sentinel value.
for x in [10, -1, 20, -1, 30]:
    if x == -1: continue
    print(x)

# while: break out once the counter reaches a limit.
n := 0
while true:
    n += 1
    if n == 4: break
print(n)

# while + continue: still makes progress (increment before continue).
total := 0
i := 0
while i < 6:
    i += 1
    if i == 3: continue
    total += i
print(total)
