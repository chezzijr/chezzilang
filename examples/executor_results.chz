# The Executor handle contract: a job submitted through `submit_task` never ends the run by its
# fault. Its `Task.get()` returns `!message`, `shutdown()` raises nothing for it, and every
# sibling runs (CPython `Future.result()`, with a `T!E` in place of a raise). Results are read
# back through the handles in submission order, so the printed order is fixed however the jobs
# interleave. A fire-and-forget `ex.submit(f)` fault is different: it ends the run at once (Go).
# Run with: chezzi run examples/executor_results.chz

import std.concurrency
import std.concurrency.task

fn score(row: str) -> int:
    if row == "":
        panic("empty row")
    return row.len()

fn main():
    rows := ["alpha", "", "beta", "gamma"]
    ex := Executor()

    handles := []
    for r in rows:
        handles.push(task.submit_task(ex, fn() -> int: score(r)))

    ex.shutdown()

    for i in 0..rows.len():
        match handles[i].get():
            ?v:  print("{rows[i]} -> {v}")
            !e: print("{rows[i]} -> fault: {e.message()}")

main()
