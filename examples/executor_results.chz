# The Executor handle contract: `ex.submit(f)` returns a `Task[T]`, and a job's fault never ends the
# run. `Task.get()` returns `!message`, `shutdown()` raises nothing for it, and every sibling runs
# (CPython `Future.result()`, with a `T!E` in place of a raise). Results are read back through the
# handles in submission order, so the printed order is fixed however the jobs interleave.
# Run with: chezzi run examples/executor_results.chz

import Executor, Task from std.concurrency

fn score(row: str) -> int:
    if row == "":
        panic("empty row")
    return row.len()

fn main():
    rows := ["alpha", "", "beta", "gamma"]
    ex := Executor()

    handles: List[Task[int]] = []
    for r in rows:
        handles.push(ex.submit(fn() -> int: score(r)))

    ex.shutdown()

    for i in 0..rows.len():
        match handles[i].get():
            ?v:  print("{rows[i]} -> {v}")
            !e: print("{rows[i]} -> fault: {e.message()}")

main()
