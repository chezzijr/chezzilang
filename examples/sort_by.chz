# examples/sort_by.chz — sort_by(comparator): custom, non-natural orderings (gap #11).

# Descending ints.
xs := [3, 1, 4, 1, 5, 9, 2, 6]
xs.sort_by(fn(a: int, b: int) -> int: b - a)
print(xs)

# Sort strings by length — stable: equal lengths keep their input order.
words := ["bb", "a", "cccc", "dd", "e"]
words.sort_by(fn(a: str, b: str) -> int: a.len() - b.len())
print(words)

# Top-N by a tuple field: (word, count) pairs ranked by count, descending.
pairs := [("apple", 3), ("pear", 7), ("fig", 1), ("kiwi", 7)]
pairs.sort_by(fn(a: (str, int), b: (str, int)) -> int: b.1 - a.1)
for p in pairs:
    print("{p.0}: {p.1}")
