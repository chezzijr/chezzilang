# examples/enum_methods.chz — methods on enums (mirrors struct-method machinery).
#
# Covers: a plain enum with a `match self` method; a method returning a NEW variant; a generic
# enum method using its type param T; an enum `str(self)` satisfying Stringable (overriding the
# built-in `Variant(payload)` repr); and an enum satisfying `Add`/`Comparable` bounds passed to a
# generic fn, plus the `+`/`<` operator overloads dispatching to its methods.

# --- plain enum: a method matching on self, and one returning a new variant ---
enum Light:
    Red
    Yellow
    Green
    # area-style method: returns an int by matching on self.
    fn cost(self) -> int:
        match self:
            Light.Red: return 0
            Light.Yellow: return 1
            Light.Green: return 2
    # returns a NEW variant of the same enum.
    fn next(self) -> Light:
        match self:
            Light.Red: return Light.Green
            Light.Yellow: return Light.Red
            Light.Green: return Light.Yellow

# --- generic enum method using T ---
enum Box[T]:
    Empty
    Val(T)
    fn get_or(self, fallback: T) -> T:
        match self:
            Box.Empty: return fallback
            Box.Val(x): return x

# --- enum str(self) satisfying Stringable (overrides the default repr) ---
enum Color:
    Crimson
    Teal
    fn str(self) -> str:
        match self:
            Color.Crimson: return "crimson"
            Color.Teal: return "teal"

# --- enum satisfying Add + Comparable, used through a generic bound and direct operators ---
enum Money:
    Cents(int)
    fn amount(self) -> int:
        match self:
            Money.Cents(c): return c
    fn add(self, o: Money) -> Money:
        return Money.Cents(self.amount() + o.amount())
    fn compare(self, o: Money) -> int:
        a := self.amount()
        b := o.amount()
        if a < b: return -1
        if a > b: return 1
        return 0
    fn eq(self, o: Money) -> bool:
        return self.amount() == o.amount()

fn twice[T: Add](x: T) -> T:
    return x + x

fn main():
    g := Light.Green
    print("cost: {g.cost()}")
    print("next.next.cost: {g.next().next().cost()}")

    b: Box[int] = Box.Val(5)
    e: Box[int] = Box.Empty
    print("get_or: {b.get_or(0)} {e.get_or(-1)}")

    # str(self) drives interpolation / print.
    print("color: {Color.Crimson}")
    print(Color.Teal)

    three := Money.Cents(3)
    print("sum amount: {three.add(three).amount()}")
    six := twice(three)
    print("twice amount: {six.amount()}")
    print("eq: {six == Money.Cents(6)}")
    print("lt: {Money.Cents(1) < Money.Cents(2)}")
    print("direct add: {(Money.Cents(4) + Money.Cents(5)).amount()}")

main()
