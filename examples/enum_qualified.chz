# examples/enum_qualified.chz — qualified enum-variant access `Enum.Variant`: user-defined enum
# variants must be written qualified everywhere — construction (nullary + payload) and `match` arms —
# and the runtime output must match the golden. A generic enum is included to pin that
# the qualifier resolves to the right variant across type parameters.

enum Color:
    Red
    Green
    Blue

enum Shape:
    Circle(int)
    Rect(int, int)
    Dot

enum Tree[T]:
    Leaf
    Node(T, Tree[T], Tree[T])

fn color_name(c: Color) -> str:
    return match c:
        Color.Red: "red"
        Color.Green: "green"
        Color.Blue: "blue"

fn shape_area(s: Shape) -> int:
    return match s:
        Shape.Circle(r): r * r
        Shape.Rect(w, h): w * h
        Shape.Dot: 0

fn tree_sum(t: Tree[int]) -> int:
    return match t:
        Tree.Leaf: 0
        Tree.Node(v, l, r): tree_sum(l) + v + tree_sum(r)

fn main():
    # Qualified construction (nullary + payload).
    print(color_name(Color.Red))
    print(color_name(Color.Green))
    print(shape_area(Shape.Circle(5)))
    print(shape_area(Shape.Rect(3, 4)))
    print(shape_area(Shape.Dot))
    # Generic enum, qualified constructors.
    t: Tree[int] = Tree.Node(2, Tree.Node(1, Tree.Leaf, Tree.Leaf), Tree.Node(3, Tree.Leaf, Tree.Leaf))
    print(tree_sum(t))
    # Equal values compare equal.
    print(Color.Red == Color.Red)
    print(Shape.Circle(7) == Shape.Circle(7))

main()
