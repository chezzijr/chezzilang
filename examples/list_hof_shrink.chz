# examples/list_hof_shrink.chz — map/filter/fold over a SNAPSHOT: a callback that mutates (shrinks)
# the receiver list does NOT perturb the iteration sequence. (Regression: VM used to index the live
# list and panic with an out-of-bounds when a callback popped the receiver. Fixed now.)

xs := [1, 2, 3, 4, 5]
fn dbl(x: int) -> int:
    _ := xs.pop()
    return x * 2
print(xs.map(dbl))   # snapshot of original 5 elems -> [2, 4, 6, 8, 10]

ys := [1, 2, 3, 4, 5]
fn even(x: int) -> bool:
    _ := ys.pop()
    return x % 2 == 0
print(ys.filter(even))   # original 1..5 -> evens kept -> [2, 4]

zs := [1, 2, 3, 4, 5]
fn add(acc: int, x: int) -> int:
    _ := zs.pop()
    return acc + x
print(zs.fold(0, add))   # sum of original 1..5 -> 15

# Growing the receiver during the callback also does not extend iteration (snapshot).
gs := [1, 2, 3]
fn grow(x: int) -> int:
    gs.push(99)
    return x
print(gs.map(grow))   # still only the original 3 elems -> [1, 2, 3]
