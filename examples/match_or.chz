# examples/match_or.chz — or-patterns (`p | q | ...`) and nested nullary-variant patterns.
#
# An or-pattern matches if ANY alternative matches (first match wins). Every alternative must bind
# the same variables (so the body sees them regardless of which alternative hit). A nested bare
# capitalized name like the `None` in `?None` is a refutable variant match, not a binding.

# --- or-pattern without bindings: literals ---
fn size(n: int) -> str:
    return match n:
        0 | 1 | 2: "small"
        3 | 4 | 5: "medium"
        _: "large"

print(size(1))
print(size(4))
print(size(9))

# --- or-pattern without bindings: a 3-variant enum is exhaustive WITHOUT a `_` ---
enum Color:
    Red
    Green
    Blue

fn is_primary(c: Color) -> str:
    return match c:
        Color.Red | Color.Green | Color.Blue: "primary"

print(is_primary(Color.Red))
print(is_primary(Color.Green))
print(is_primary(Color.Blue))

# --- or-pattern WITH bindings: both alternatives bind `a` (same type) ---
enum Shape:
    Circle(int)
    Square(int)

fn measure(s: Shape) -> int:
    return match s:
        Shape.Circle(a) | Shape.Square(a): a

print(measure(Shape.Circle(7)))
print(measure(Shape.Square(11)))

# --- a guard on an or-pattern: the guard runs with the bindings in scope ---
fn classify(n: int) -> str:
    return match n:
        1 | 2 | 3 if n % 2 == 0: "even-low"
        1 | 2 | 3: "odd-low"
        _: "other"

print(classify(2))
print(classify(3))
print(classify(8))

# --- nested nullary variant: the bare `None` in `?None` is a refutable variant match ---
fn describe(oo: int??) -> str:
    return match oo:
        ?None: "inner-none"
        _: "other"

a: int?? = ?None
b: int?? = ?(?42)
c: int?? = None
print(describe(a))
print(describe(b))
print(describe(c))

# --- nested nullary in a `T!E` value: `?(!e)` (distinct outer variants per arm) ---
nested: (int!str)!str = ?(!"boom")
match nested:
    ?(!e): print("nested-err-{e}")
    !e: print("outer-err-{e}")
    _: print("nested-ok")
