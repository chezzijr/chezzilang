# examples/knapsack.chz — 0/1 knapsack via a 2D DP table (Domain D).
#
# Showcases nested mutable collections: a `list[list[int]]` DP table built with push, then
# filled in place with `dp[i][w] = ...` (nested index assignment — gaps #1 reaching two levels).
#
# Gap #12 fixed: `math.max` is now int+float polymorphic, so the DP recurrence reads
# `dp[i][w] = math.max(without, with_it)` directly over the int table — no hand-rolled `if a > b`.

import std.math

fn build_table(rows: int, cols: int) -> list[list[int]]:
    dp := []
    for i in 0..rows:
        row := []
        for w in 0..cols:
            row.push(0)
        dp.push(row)
    return dp

fn main():
    weights := [1, 3, 4, 5]
    values  := [1, 4, 5, 7]
    n := weights.len()
    cap := 7

    dp := build_table(n + 1, cap + 1)

    for i in 1..(n + 1):
        wi := weights[i - 1]
        vi := values[i - 1]
        for w in 0..(cap + 1):
            without := dp[i - 1][w]
            if wi <= w:
                with_it := dp[i - 1][w - wi] + vi
                dp[i][w] = math.max(without, with_it)   # int max — gap #12
            else:
                dp[i][w] = without

    print("items: {n}  capacity: {cap}")
    print("max value: {dp[n][cap]}")

main()
