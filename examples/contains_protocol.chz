# `Contains` operator protocol (L5) — Python's `__contains__`: a type with a
# `contains(self, item) -> bool` method makes `x in that_value` dispatch to it, yielding `bool`.
# Built-in list/set/map/str `in` is unchanged; this adds user structs/enums.

# A struct membership test over its own field.
struct Bag:
    items: List[int]
    fn contains(self, item: int) -> bool:
        for it in self.items:
            if it == item:
                return true
        return false

# Generic: the `contains` param type is the INSTANTIATED type arg (`Box[str]` → `str`). `x == self.v`
# compares two `T`s, so `T` must be bounded by `Eq` (W7-53), matching rustc/Go at the definition.
struct Box[T: Eq]:
    v: T
    fn contains(self, item: T) -> bool:
        return item == self.v

# Enums satisfy `Contains` for free via the shared protocol machinery.
enum Palette:
    RGB
    Gray
    fn contains(self, item: str) -> bool:
        return item == "red" or item == "green" or item == "blue"

fn main():
    b := Bag([1, 2, 3])
    print(2 in b)          # true
    print(9 in b)          # false

    s := Box[str]("hi")
    print("hi" in s)       # true
    print("no" in s)       # false

    p := Palette.RGB
    print("red" in p)      # true
    print("teal" in p)     # false

main()
