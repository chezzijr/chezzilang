# examples/encoding.chz — std.encoding codecs: base64 (std + url-safe), hex, URL percent-encoding.
# All deterministic str<->str round-trips (no entropy), so the golden is byte-identical on every run
# and at every worker count.

import std.encoding as enc
import std.io

# --- base64 (RFC 4648 std alphabet) ---
print("b64 Man     = " + enc.base64_encode("Man"))
print("b64 foobar  = " + enc.base64_encode("foobar"))
match enc.base64_decode("Zm9vYmFy"):
    Ok(s): print("b64 decode  = " + s)
    Err(e): print("b64 decode err: " + e.message())
match enc.base64_decode("not valid!!"):
    Ok(s): print("unexpected ok: " + s)
    Err(e): print("b64 bad     = err")

# --- base64 url-safe ---
print("b64url f?>  = " + enc.base64_encode_url("f?>"))
match enc.base64_decode_url(enc.base64_encode_url("hello/world+more")):
    Ok(s): print("b64url rt   = " + s)
    Err(e): print("b64url err: " + e.message())

# --- hex ---
print("hex foo     = " + enc.hex_encode("foo"))
match enc.hex_decode("68656c6c6f"):
    Ok(s): print("hex decode  = " + s)
    Err(e): print("hex err: " + e.message())
match enc.hex_decode("zz"):
    Ok(s): print("unexpected ok: " + s)
    Err(e): print("hex bad     = err")

# --- url percent-encoding (RFC 3986 component) ---
print("url enc     = " + enc.url_encode("a b/c?d=e&f"))
print("url unres   = " + enc.url_encode("keep~these-chars_.ok"))
match enc.url_decode("a%20b%2Fc%3Fd"):
    Ok(s): print("url decode  = " + s)
    Err(e): print("url err: " + e.message())
match enc.url_decode("%2G"):
    Ok(s): print("unexpected ok: " + s)
    Err(e): print("url bad     = err")

# --- query string builder (sorted keys, both sides percent-encoded) ---
print("query 3     = " + enc.query_encode({"q": "a b", "x": "1", "a&b": "c=d"}))
print("query empty = '" + enc.query_encode({}) + "'")
empty_val: Map[str, str] = {"k": ""}
print("query kv    = " + enc.query_encode(empty_val))
print("query url   = https://x.test/s?" + enc.query_encode({"name": "John Doe", "lang": "C++"}))

# --- query parsing (read-half): +/%20 -> space, leading '?', no-'=' key, dup last-wins ---
rt: Map[str, str] = enc.query_decode(enc.query_encode({"greeting": "a b"}))
print("qd round    = " + rt["greeting"])
plus: Map[str, str] = enc.query_decode("?q=a+b")
print("qd plus     = " + plus["q"])
pct: Map[str, str] = enc.query_decode("q=a%20b")
print("qd pct      = " + pct["q"])
flag: Map[str, str] = enc.query_decode("flag")
print("qd no-eq    = '" + flag["flag"] + "'")
dup: Map[str, str] = enc.query_decode("a=1&a=2")
print("qd dup-last = " + dup["a"])

# --- url_parse (lexical decomposition, components stay encoded) ---
full: Map[str, str] = enc.url_parse("https://host.test:8080/a/b?x=1#frag")
print("up scheme   = " + full["scheme"])
print("up host     = " + full["host"])
print("up port     = " + full["port"])
print("up path     = " + full["path"])
print("up query    = " + full["query"])
print("up frag     = " + full["fragment"])
hostonly: Map[str, str] = enc.url_parse("https://example.com")
print("up hostonly = " + hostonly["host"] + " port='" + hostonly["port"] + "'")
rel: Map[str, str] = enc.url_parse("/local/path?y=2")
print("up rel      = " + rel["path"] + " q=" + rel["query"] + " scheme='" + rel["scheme"] + "'")
