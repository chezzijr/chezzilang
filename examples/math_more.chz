# M19 additive: std.math trig/exp/log intrinsics. Deterministic int-valued float results only,
# so the golden output is stable across float-formatting.

import std.io
import std.math

fn main():
    io.print("{math.cos(0.0)}")
    io.print("{math.exp(0.0)}")
    io.print("{math.log2(8.0)}")
    io.print("{math.log10(1000.0)}")
    io.print("{math.log(8.0, 2.0)}")

main()
