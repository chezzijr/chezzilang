# examples/datetime.chz — std.datetime print-tour (pure-Chezzi civil calendar, UTC-only).
# Fully DETERMINISTIC: uses only FIXED epoch values, never now()/the clock — so it is byte-identical
# across all three engines (interp / VM / --parallel) and matches examples/datetime.expected.

import std.datetime as dt

fn show(epoch: int):
    d := dt.from_epoch(epoch)
    print("{epoch} -> {dt.to_iso8601(d)}  ({dt.weekday_name(d.weekday)})")

fn main():
    print("== from_epoch / formatters ==")
    show(0)
    show(1700000000)
    show(-1)
    show(951782400)     # 2000-02-29 00:00:00 (leap day)

    print("== to_string / date / time ==")
    m := dt.from_epoch(1700000000)
    print(dt.to_string(m))
    print(dt.to_date_string(m))
    print(dt.to_time_string(m))

    print("== round-trip ==")
    print("to_epoch(from_epoch(1700000000)) = {dt.to_epoch(dt.from_epoch(1700000000))}")
    print("to_epoch(from_epoch(-1))         = {dt.to_epoch(dt.from_epoch(-1))}")

    print("== days_from_civil / civil_from_days ==")
    print("days_from_civil(2024,2,29) = {dt.days_from_civil(2024, 2, 29)}")
    y, mo, day := dt.civil_from_days(19675)
    print("civil_from_days(19675) = {y}-{mo}-{day}")

    print("== leap / month length ==")
    print("is_leap_year(2000)={dt.is_leap_year(2000)} is_leap_year(1900)={dt.is_leap_year(1900)} is_leap_year(2024)={dt.is_leap_year(2024)}")
    print("days_in_month(2024,2)={dt.days_in_month(2024, 2)} days_in_month(2023,2)={dt.days_in_month(2023, 2)}")

    print("== duration ==")
    print("add_days(0,7)={dt.add_days(0, 7)} add_seconds(0,90)={dt.add_seconds(0, 90)}")
    print("diff_days(1700000000,1699913600)={dt.diff_days(1700000000, 1699913600)}")
    print("diff_seconds(90,0)={dt.diff_seconds(90, 0)}")

    print("== weekday ==")
    print("weekday(0)={dt.weekday(0)} weekday(-1)={dt.weekday(-1)} weekday(1700000000)={dt.weekday(1700000000)}")

main()
