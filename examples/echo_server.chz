# examples/echo_server.chz — a tiny TCP echo server on the --parallel netpoller (D6).
#
# One `parallel:` runs an acceptor fiber that serves N connections (reading a line and echoing it
# back with an "echo:" prefix) plus N client fibers that each connect, ping, and read the reply.
# All N+1 fibers multiplex over a core-sized worker pool: a would-block accept/read parks the fiber
# on the epoll/kqueue netpoller instead of pinning a thread, so #connections >> #workers.
#
# net sockets are non-blocking and park on the M:N scheduler, so this needs the default engine (the
# cooperative `--serial` oracle runs every fiber on ONE thread, so it has no fiber to park and no peer
# to make the fd ready — a would-block op there returns "requires the --parallel engine"):
#
#   chezzi run examples/echo_server.chz
#
# (A socket op on the top-level `main` fiber does NOT need a nursery: on the default engine it blocks
#  in place until it is ready, exactly as `ln.Accept()` does on Go's main goroutine.)
#
# The printed number is MEASURED, not asserted: a `spawn`ed fiber's return value is discarded (this is
# Go's `go f()`), so the count lives in a shared `AtomicInt` — Go's `atomic.Int64` — that only a client
# which completed the whole round-trip bumps. On `--serial` that prints a truthful `0 connections`.

import std.net
import std.concurrency

fn acceptor(server: Listener, n: int) -> int!:
    for _ in 0..n:
        conn := server.accept()?
        line := conn.read(64)?
        conn.write("echo:" + line)?
        conn.close()
    server.close()
    return Ok(0)

fn client(addr: str, served: AtomicInt) -> int!:
    sock := net.connect(addr)?
    sock.write("ping")?
    reply := sock.read(64)?
    sock.close()
    if reply == "echo:ping":
        served.add(1)             # counted only by a client that got its own echo back
    return Ok(0)

fn run(n: int) -> int!:
    server := net.listen("127.0.0.1:0")?
    addr := server.addr()?
    served := AtomicInt(0)
    parallel:
        spawn acceptor(server, n)
        for _ in 0..n:
            spawn client(addr, served)
    return Ok(served.load())      # the nursery has joined, so every client has finished counting

fn main():
    match run(50):
        Ok(served): print("echo server handled {served} connections")
        Err(e): print("error: " + e.message())

main()
