# `Iterable[T]` / `Iterator[T]` — the two parameterized protocol bounds, and which one to reach for.
#
# `[S: Iterable[T], T]` = "give me anything I can iterate" (Rust's `IntoIterator`, Go's `range`):
#   - built-in list / set / map / str / bytes / bytearray
#   - a cursor from `.iter()`, or a generator's `Iterator[T]`
#   - any user struct with `next(self) -> Option[T]`
#     (a struct with ONLY `iter(self) -> Iterator[T]` is for-iterable and satisfies `Iterable`, but the
#      `T` RECOVERY does not fire for it — bound that one concretely, e.g. `[S: Iterable[int]]`)
#   Its body iterates with `for` — that is what this file's three functions do.
#
# `[S: Iterator[T], T]` = "give me a CURSOR" (Rust's `Iterator`): something that HOLDS a position, so
# the body may call `s.next()` directly. A raw list does NOT satisfy it — a fresh cursor per call
# would hand back element 0 forever. Take one with `.iter()`, or use a generator / a `next` struct.
#
# Either way `T` is inferred by unifying the iterand's element type into the bound's arg — so it flows
# out into return types (`-> T`, `-> List[T]`) and into the loop variable inside the body.

fn first_or[S: Iterable[T], T](xs: S, default: T) -> T:
    for x in xs:
        return x
    return default

# `T` here is recovered ONLY from the bound (it appears in no parameter), proving element recovery.
fn count[S: Iterable[T], T](xs: S) -> int:
    n := 0
    for _ in xs:
        n = n + 1
    return n

fn to_list[S: Iterable[T], T](xs: S) -> List[T]:
    out := []
    for x in xs:
        out.push(x)
    return out

# A user struct iterator (finite): yields 0,1,2,3,4.
struct Counter:
    n: int
    limit: int
    fn next(self) -> Option[int]:
        if self.n >= self.limit:
            return None
        v := self.n
        self.n = self.n + 1
        return Some(v)

fn main():
    nums := [10, 20, 30]
    letters := {"a", "b", "c"}

    print(first_or(nums, 0))         # 10  (list element is int)
    print(first_or("hello", "?"))    # h   (str element is str)
    print(first_or(letters, "z"))    # a   (set, insertion-ordered)

    print(count(nums))               # 3
    print(count(Counter(0, 5)))      # 5  (T recovered from the struct iterator)

    print(to_list(Counter(0, 4)))    # [0, 1, 2, 3]

main()
