# examples/enum_layout.chz — M19 memory-layout lever #2 (enum variant_id). Exercises every
# observable surface the per-instance variant/type-name → dense `variant_id: u32` change touches:
# nullary + payload variants, a generic Option[T]/Result[T,E], exhaustive match, match-with-binding,
# a guard, enum == (equal / unequal-by-variant / unequal-by-enum-type), Display + `{}` interpolation,
# nested enums, Result/Option + the `?` operator, variant-name SHADOWING (a user enum reusing the
# native `Some` name — native vs user identity + `?` on a genuine native), and an enum crossing a
# spawn+Channel (wire/snap carry the dense variant_id directly). Byte-identical on the VM, interp, and
# --parallel — variant_id is behavior-preserving, so any divergence turns the golden RED.

enum Color:
    Red
    Green
    Blue

enum Shape:
    Circle(int)
    Rect(int, int)
    Dot

enum Tree[T]:
    Leaf
    Node(T, Tree[T], Tree[T])

# Variant-name SHADOWING: a user enum may REUSE a native name (`Some`/`None`/...) for one of its
# variants (main allows this). This never conflicts, because the two are reached by DIFFERENT syntax:
# bare `Some(..)`/`None` ALWAYS build the NATIVE builtin (the compiler hardcodes `Some`→Option and
# stamps `VID_SOME`); the user variant is reachable ONLY qualified, as `Shadow.Some(..)`. The reserved
# native ids `VID_SOME`/`VID_NONE_VARIANT` stay DISJOINT from this enum's user ids, so a native Option
# value never compares equal to a `Shadow` value and `?` still recognises genuine natives.
enum Shadow:
    Some(int)
    Bar

# `return Some(v)` is the NATIVE Option (bare `Some` = builtin), matching `-> int?`. `?` on a genuine
# native Option (xs.pop(), which stamps VID_SOME/VID_NONE_VARIANT directly) is recognised by `?`'s gate
# regardless of the `Shadow.Some` name reuse — bare names never resolve to the user enum.
fn first_native(xs: list[int]) -> int?:
    v := xs.pop()?
    return Some(v)

# Exhaustive match (no `_`) selecting an arm by variant id.
fn color_name(c: Color) -> str:
    return match c:
        Color.Red: "red"
        Color.Green: "green"
        Color.Blue: "blue"

# Match with payload binding.
fn shape_area(s: Shape) -> int:
    return match s:
        Shape.Circle(r): r * r
        Shape.Rect(w, h): w * h
        Shape.Dot: 0

# Match guard: an arm matches only when its pattern binds AND the guard is true; else it falls
# through. Each variant appears once; the guard is on the bound payload.
fn shape_kind(s: Shape) -> str:
    return match s:
        Shape.Circle(r) if r > 10: "big circle"
        Shape.Rect(w, h) if w == h: "square"
        _: "other"

# Nested enums in a generic Tree[int].
fn tree_sum(t: Tree[int]) -> int:
    return match t:
        Tree.Leaf: 0
        Tree.Node(v, l, r): tree_sum(l) + v + tree_sum(r)

# Result/Option + the `?` operator (gated on the fixed native variant ids).
fn safe_div(a: int, b: int) -> int!:
    if b == 0:
        return Err("divide by zero")
    return Ok(a / b)

fn chained(a: int, b: int, c: int) -> int!:
    x := safe_div(a, b)?
    y := safe_div(x, c)?
    return Ok(y)

fn first_even(xs: list[int]) -> int?:
    for x in xs:
        if x % 2 == 0:
            return Some(x)
    return None

# An enum value crossing a spawn + Channel: the worker sends an Option[int] back; the receiver
# matches it. Exercises wire/snap variant-id rebuild on the --parallel path.
fn producer(out: Channel[int?]):
    out.send(Some(99))
    out.send(None)

fn main():
    # Nullary + payload variants, Display.
    print(Color.Red)
    print(Shape.Circle(5))
    print(Shape.Rect(3, 4))
    print(color_name(Color.Green))
    print(shape_area(Shape.Circle(6)))
    print(shape_area(Shape.Rect(3, 4)))
    print(shape_area(Shape.Dot))

    # Match guards (guard fails ⇒ falls through to the wildcard).
    print(shape_kind(Shape.Circle(20)))
    print(shape_kind(Shape.Circle(2)))
    print(shape_kind(Shape.Rect(5, 5)))
    print(shape_kind(Shape.Rect(2, 7)))
    print(shape_kind(Shape.Dot))

    # Nested generic enum.
    t: Tree[int] = Tree.Node(2, Tree.Node(1, Tree.Leaf, Tree.Leaf), Tree.Node(3, Tree.Leaf, Tree.Leaf))
    print(tree_sum(t))

    # enum == : equal, unequal-by-variant, unequal-by-enum-type, payload-aware.
    print(Color.Red == Color.Red)
    print(Color.Red == Color.Green)
    print(Shape.Circle(5) == Shape.Circle(5))
    print(Shape.Circle(5) == Shape.Circle(6))
    print(Some(1) == Some(1))
    print(Some(1) == None)

    # Interpolation of an enum value.
    s := Shape.Circle(8)
    print("shape is {s}, area {shape_area(s)}")
    o := Some(42)
    print("opt is {o}")

    # Result/Option + `?`.
    match chained(100, 5, 2):
        Ok(v): print("chained ok {v}")
        Err(e): print("chained err {e}")
    match chained(100, 0, 2):
        Ok(v): print("chained ok {v}")
        Err(e): print("chained err {e}")
    match first_even([1, 3, 4, 7]):
        Option.Some(v): print("first even {v}")
        None: print("no even")
    match first_even([1, 3, 5]):
        Option.Some(v): print("first even {v}")
        None: print("no even")

    # Variant-name shadowing: native Option/Result identity must survive a user enum reusing the
    # names. `Shadow.Some(5)` is the user variant; a native Option::Some(5) from pop() is NOT equal
    # to it, and `?` still unwraps a genuine native Option.
    sh := Shadow.Some(5)
    print(sh)
    nat := [5].pop()              # native int? == Some(5)
    print("native Some == user Shadow.Some:", nat == sh)
    print("first_native:", first_native([10, 20]))
    print("first_native empty:", first_native([]))

    # Enum across spawn + Channel.
    ch := Channel[int?]()
    parallel:
        spawn producer(ch)
    a := ch.recv()
    b := ch.recv()
    match a:
        Option.Some(v): print("recv Some {v}")
        None: print("recv None")
    match b:
        Option.Some(v): print("recv Some {v}")
        None: print("recv None")

main()
