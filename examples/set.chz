# examples/set.chz — the set type (M8): `{a, b, c}` literals (deduped, insertion-ordered),
# membership, mutation, set algebra, and iteration. Elements are hashable scalars (int/str/bool).
# Empty set is `set()` (since `{}` is the empty map); `set(list)` builds one from a list.

# Literal dedups and keeps first-seen order.
nums := {3, 1, 4, 1, 5, 9, 2, 6, 5}
print(nums.len())                 # 7 distinct
print(nums.has(4))                # true
print(nums.has(7))                # false

# Mutation: add is idempotent, remove reports whether it was present.
nums.add(7)
print(nums.has(7))                # true
print(nums.remove(7))             # true
print(nums.remove(7))             # false

# Set algebra returns new sets.
a := {1, 2, 3, 4}
b := {3, 4, 5, 6}
print(a.union(b).len())           # 6
print(a.intersection(b).len())    # 2
print(a.difference(b).len())      # 2

# Equality ignores order.
print({1, 2, 3} == {3, 2, 1})     # true

# Build from a list (dedups) and iterate (insertion order).
seen := set(["red", "green", "red", "blue", "green"])
print(seen.len())                 # 3
order := ""
for c in seen:
    order = order + c + " "
print(order.trim())               # red green blue

# A tiny "unique words" count.
fn count_unique(text: str) -> int:
    seen := set()
    for w in text.split(" "):
        seen.add(w)
    return seen.len()
print(count_unique("the cat the dog the bird"))   # 4
