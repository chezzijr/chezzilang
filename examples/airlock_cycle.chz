# examples/airlock_cycle.chz — a SELF-REFERENTIAL value crossing the concurrency airlock (a `spawn`
# arg, a `Channel.send`, a `Shared(...)`). The airlock serializer (`to_wire`/`from_wire`) is now
# identity-preserving for every container arm (struct/list/map/set/tuple/enum/newtype/iter), exactly
# as it already was for closures/cells: a self-referential value earns a per-serialization id + a
# back-reference, so `a -> b -> a` ROUND-TRIPS across the airlock byte-identically
# instead of overflowing the host stack. The depth cap stays only as the backstop for a
# genuinely-unbounded ACYCLIC nest (see section 4's shallow-but-wide control). Sections 1-3 below cross
# a LOCAL self-referential value → the `to_wire` path.

import std.concurrency

struct Node:
    val: int
    next: List[Node]

fn use_it(n: Node):
    print("got {n.val}")

fn use_wide(xs: List[int]):
    print("wide got len {xs.len()} first {xs[0]} last {xs[99999]}")

# 1) a self-referential value as a `spawn` argument now crosses — the task reads it.
spawn_r := recover:
    a := Node(1, [])
    b := Node(2, [])
    a.next.push(b)
    b.next.push(a)           # a -> b -> a  (cycle)
    parallel:
        spawn use_it(a)
    "done"
match spawn_r:
    Ok(v):  print("spawn ok: {v}")
    Err(e): print("spawn caught: {e.message()}")

# 2) the same cycle handed to `Channel.send` now crosses.
chan_r := recover:
    a := Node(1, [])
    b := Node(2, [])
    a.next.push(b)
    b.next.push(a)
    ch := Channel[Node]()
    ch.send(a)
    "done"
match chan_r:
    Ok(v):  print("channel ok: {v}")
    Err(e): print("channel caught: {e.message()}")

# 3) the same cycle wrapped in `Shared(...)` now crosses.
shared_r := recover:
    a := Node(1, [])
    b := Node(2, [])
    a.next.push(b)
    b.next.push(a)
    s := Shared(a)
    "done"
match shared_r:
    Ok(v):  print("shared ok: {v}")
    Err(e): print("shared caught: {e.message()}")

# 4) a wide, ACYCLIC sendable (100k shallow siblings, structural depth ~2) still crosses fine — the
# 10_000 depth cap counts nesting LEVELS, not siblings, so large-but-shallow data never false-trips.
wide := recover:
    xs := [0]
    for i in 1..100000:
        xs.push(i)
    parallel:
        spawn use_wide(xs)
    "crossed"
match wide:
    Ok(v):  print("wide ok: {v}")
    Err(e): print("wide caught: {e.message()}")
