# Fixed-width integer C-ABI marshalling through `extern "lib":` — int8..uint64 marshalling type
# names. They are NOT global builtins: a module that names a width type must import it per-name from
# `std.ffi` (Chezzi's first type imports), exactly like `null`/`is_null`. Unlike `owned_str`, these are
# BIDIRECTIONAL (param AND return). A return SIGN-extends (signed) or ZERO-extends (unsigned) the C
# value back to i64.
#
# RULE 1 (TICKET-262): a width type describes the C boundary only. To the program each is a plain
# `int` (`float32`: a plain `float`). It may be written in an extern fn param or return (a callback
# type there included) and as a struct field's own type, and nowhere else:
#
#   | position                                              | `int8` written there |
#   |-------------------------------------------------------|----------------------|
#   | extern fn param / return                              | allowed              |
#   | struct field's own type                               | allowed              |
#   | local / global annotation, normal fn param / return   | error: write `int`   |
#   | type argument (`List[int8]`, `int8?`), alias body     | error: write `int`   |
#
# RULE 2: every store into a width slot is range-checked, and Chezzi never wraps silently (CPython
# ctypes does: `ctypes.c_int8(300).value` is 44). A constant that does not fit is a compile error
# (`constant 300 does not fit int8 (-128..127)`); a runtime value that does not fit is a recoverable
# fault with one text at every store (`value 300 does not fit int8 (-128..127)`): an extern argument,
# a struct constructor, a field store, a compound field store, an `ffi.store_<w>`, a callback return.
# `ffi.cast_<w>` (here `cast_int8`) wraps explicitly, like a C cast.
import int8, int32, uint32, cast_int8 from std.ffi

# `libc` is a LOGICAL library name the loader resolves per host (docs/reference/syntax.md §12b).

extern "libc":
    # `atoi(const char*)->int`: parses a decimal string to a C int; declared int32 it sign-extends a
    # negative result back to a Chezzi -1 (not 0x00000000FFFFFFFF).
    fn atoi(s: str) -> int32
    # `htonl(uint32)->uint32`: host->network byte order; an UNSIGNED int32 round-trip (param + return
    # zero-extend — a high-bit result stays positive in the i64).
    fn htonl(x: uint32) -> uint32
    # `abs(int)->int` declared int8 in AND out: exercises a signed round-trip AND the range check
    # (an int too large for int8 is a compile error as a constant and a fault at run time).
    fn abs(x: int8) -> int8

# int32 return sign-extends a negative C int back to a Chezzi -1 (not 4294967295).
print(atoi("-1"))               # -1

# int32 return of a normal positive parses straight through.
print(atoi("42"))               # 42

# uint32 round-trip, zero-extends: on little-endian Linux htonl(1) == 0x01000000 == 16777216.
print(htonl(1))                 # 16777216

# uint32 high-bit zero-extends to a POSITIVE i64 (not a negative): htonl(128) == 0x80000000.
print(htonl(128))               # 2147483648

# int8 round-trip: abs(-5) == 5 (both within int8 range).
print(abs(-5))                  # 5

# 255 does not fit int8: `cast_int8` wraps it like a C cast (255 is 0xFF, -1 as a signed char).
# abs(-1) == 1. Passing `abs(255)` itself is a compile error.
print(abs(cast_int8(255)))      # 1
