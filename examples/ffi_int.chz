# Fixed-width integer C-ABI marshalling through `extern "lib":` — int8..uint64 marshalling type
# names (siblings of `ptr`/`owned_str`). To the program each is a plain `int`; the width/signedness
# is a runtime-only marshalling distinction. Unlike `owned_str`, these are BIDIRECTIONAL (param AND
# return). A param TRUNCATES the Chezzi i64 to the C width (wrapping, C-cast); a return SIGN-extends
# (signed) or ZERO-extends (unsigned) the C value back to i64. No overflow trap — it wraps like a cast.

extern "libc.so.6":
    # `atoi(const char*)->int`: parses a decimal string to a C int; declared int32 it sign-extends a
    # negative result back to a Chezzi -1 (not 0x00000000FFFFFFFF).
    fn atoi(s: str) -> int32
    # `htonl(uint32)->uint32`: host->network byte order; an UNSIGNED int32 round-trip (param + return
    # zero-extend — a high-bit result stays positive in the i64).
    fn htonl(x: uint32) -> uint32
    # `abs(int)->int` declared int8 in AND out: exercises a signed round-trip AND param truncation
    # (a Chezzi i64 too large for int8 wraps per a C cast, never traps).
    fn abs(x: int8) -> int8

# int32 return sign-extends a negative C int back to a Chezzi -1 (not 4294967295).
print(atoi("-1"))               # -1

# int32 return of a normal positive parses straight through.
print(atoi("42"))               # 42

# uint32 round-trip, zero-extends: on little-endian Linux htonl(1) == 0x01000000 == 16777216.
print(htonl(1))                 # 16777216

# uint32 high-bit zero-extends to a POSITIVE i64 (not a negative): htonl(128) == 0x80000000.
print(htonl(128))               # 2147483648

# int8 round-trip: abs(-5) == 5 (both within int8 range).
print(abs(-5))                  # 5

# int8 param TRUNCATES per a C cast: 255 (0xFF) as a signed char is -1; abs(-1) == 1. No trap.
print(abs(255))                 # 1
