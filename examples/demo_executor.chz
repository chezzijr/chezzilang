# `Executor` — DETACHED work queue (the escape hatch when work outlives a `parallel:` scope).
# Same task as demo_spawn.chz. `submit` STARTS a detached job at once; `shutdown()` waits for the
# submitted work. No lexical scope ties the jobs — you own the wait point.

import std.concurrency

fn square_into(n: int, out: Channel[int]):
    out.send(n * n)

fn main():
    ch := Channel[int]()
    ex := Executor()
    ex.submit(fn(): square_into(1, ch))   # starts now, on the pool
    ex.submit(fn(): square_into(2, ch))
    ex.submit(fn(): square_into(3, ch))
    ex.submit(fn(): square_into(4, ch))
    ex.submit(fn(): square_into(5, ch))
    ex.shutdown()                          # waits: every submitted job has finished after this
    total := 0
    for _ in 0..5:
        total += ch.recv()
    print("executor: sum of squares 1..5 = {total}")

main()
