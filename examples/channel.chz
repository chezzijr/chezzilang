# golden: unordered (concurrent prints; tests/examples_golden.rs compares the sorted line sets)
# C2 concurrency: `Channel[T]` fan-out. Workers run at the nursery's dedent and drop their results
# into a shared mailbox; the parent collects them after the join. A send hands the receiver the
# value by handle (Go `chan T`): every task shares the run's one heap.
#
# `channel.expected`'s exact line order is the BUFFERED test sink (every lib helper), where a task's
# output is flushed at the join in spawn order.
# `chezzi run` STREAMS: cross-task print order is nondeterministic by contract
# (docs/reference/concurrency/, "the user-facing contract"), so diffing streamed CLI output against the
# golden is not a supported comparison — the M:N golden asserts the line SET (`assert_same_lines`).

fn worker(id: int, prefix: str, out: Channel[str]):
    out.send("{prefix}-{id}")

fn main():
    ch := Channel[str]()
    label := "task"
    parallel:
        spawn worker(1, label, ch)       # 1, label passed in; ch is the shared mailbox handle
        spawn worker(2, label, ch)
        spawn worker(3, label, ch)
    # Reaching here ⇒ all three workers finished. Their strings are queued FIFO.
    print("received {ch.len()} messages")
    for _ in 0..3:
        print(ch.recv())

main()
