# Phase 3a golden — the eight universe builtins now DECLARED in std/prelude.chz as `native fn`/`native
# ctor` decls (ord/chr/panic/int/float/str/bytes/bytearray), plus synthetic `print`. Their signatures
# moved out of the Rust PRELUDE table into the always-linked .chz prelude, but dispatch stays
# name-keyed, so every result is byte-identical regardless of worker count. This is the
# golden-output guard for the migration.

fn main():
    # conversions are methods (`native struct str` / `float` in std/prelude.chz); each gives `T?`
    print("5".to_int())      # 5
    print((3.9).to_int())    # 3  (truncates toward zero)
    print("2.5".to_float())  # 2.5

    # display is interpolation
    print("42")              # 42
    print("{true}")          # true

    # native ctor bytes / bytearray — from a List[int]
    b := bytes.from_iter([65, 66])
    print(b[0])              # 65
    ba := bytearray.from_iter([90])
    print(ba[0])             # 90

    # native fn ord / chr (round-trip)
    print(ord("a"))          # 97
    print(chr(66))           # B

    # native fn panic — raised inside a recover: block, unwinds, is caught
    r: None!Error = recover:
        panic("boom")
    match r:
        ?_: print("no panic")
        !e: print("caught: {e}")

    # print with sep= / end= (variadic — stays synthetic)
    print("x", "y", "z", sep="-")     # x-y-z
    print("no-newline", end="!")      # no-newline!
    print("")                          # newline

main()
