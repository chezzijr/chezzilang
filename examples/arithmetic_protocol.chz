# M22 — operator protocols (Div / Mod / Neg), protocol embedding (super-protocols), and the builtin
# `Arithmetic` bundle. A struct overloads `/`, `%`, and unary `-` by defining `div`/`mod`/`neg`; the
# builtin `Arithmetic` (= Add + Sub + Mul + Div) and a user `VectorSpace` protocol (which EMBEDS
# `Arithmetic + Neg` plus its own `dot`) drive bounded generics over both structs and ints.

struct Vec2:
    x: int
    y: int
    fn add(self, o: Vec2) -> Vec2:
        return Vec2(self.x + o.x, self.y + o.y)
    fn sub(self, o: Vec2) -> Vec2:
        return Vec2(self.x - o.x, self.y - o.y)
    fn mul(self, o: Vec2) -> Vec2:
        return Vec2(self.x * o.x, self.y * o.y)
    fn div(self, o: Vec2) -> Vec2:
        return Vec2(self.x / o.x, self.y / o.y)
    fn mod(self, o: Vec2) -> Vec2:
        return Vec2(self.x % o.x, self.y % o.y)
    fn neg(self) -> Vec2:
        return Vec2(-self.x, -self.y)
    fn dot(self, o: Vec2) -> int:
        return self.x * o.x + self.y * o.y
    fn str(self) -> str:
        return "({self.x}, {self.y})"

# Bounded by the builtin `Arithmetic` bundle — flattens transitively to Add/Sub/Mul/Div.
fn combine[T: Arithmetic](a: T, b: T) -> T:
    return (a + b) * (a - b) / b

# A user protocol that EMBEDS `Arithmetic` + `Neg` and adds its own `dot` requirement (transitive).
protocol VectorSpace:
    Arithmetic + Neg
    fn dot(self, o: Self) -> int

fn analyze[T: VectorSpace](a: T, b: T) -> int:
    c := -a + b
    return c.dot(b)

fn main():
    a := Vec2(10, 9)
    b := Vec2(2, 3)
    print(a / b)
    print(a % b)
    print(-a)
    print(combine(a, b))
    print(analyze(a, b))
    print(combine(20, 4))

main()
