# bytes — immutable byte-sequence type (Python `bytes` model). Exercises every row of the
# bytes operation table: literal (with \xHH escapes), index -> int, slice -> bytes (incl.
# reverse / step / negative bounds), for-loop -> int, len, == / !=, an out-of-range index
# under recover:, plus Display / str() / interpolation (the b'...' repr).

fn main():
    b := b"\x01\x02\x03\xFF"

    # Display / str() / interpolation — Python b'...' repr (\xHH for non-printable / >=0x80).
    print(b)
    print(str(b"hi\n"))
    ab := b"AB"
    print("interp: {ab}")

    # b[i] -> int (0..255), including a negative index.
    print(b[0])
    print(b[3])
    print(b[-1])

    # b[a:b:c] -> bytes: open bounds, step, reverse, negative.
    print(b[1:3])
    print(b[::-1])
    print(b[::2])
    print(b[-2:])

    # for x in b -> int: sum the bytes.
    total := 0
    for x in b:
        total = total + x
    print(total)

    # len(b) = byte count.
    print(len(b))

    # == / != are structural byte-equality.
    print(b"ab" == b"ab")
    print(b"ab" == b"ac")
    print(b"ab" != b"ac")

    # bytes is Hashable — a valid map key.
    m := {b"k1": 10, b"k2": 20}
    print(m[b"k1"])
    print(m[b"k2"])

    # An out-of-range index faults recoverably (catchable by recover:).
    r := recover:
        b[99]
    match r:
        Ok(v): print(v)
        Err(e): print("caught out-of-range")

main()
