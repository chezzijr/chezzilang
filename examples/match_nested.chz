# examples/match_nested.chz — nested / tuple match patterns (gap #15).
#
# Before: every step down a tree/tuple needed a flat `match` then field access. Now an arm can
# destructure a tuple `(a, b)`, a nested variant `Some((x, y))`, or mix in literals `(1, n)`.

enum Tree:
    Leaf
    Node(int, Tree, Tree)

fn sum(t: Tree) -> int:
    match t:
        Leaf: return 0
        Node(v, l, r): return v + sum(l) + sum(r)

t := Node(1, Node(2, Leaf, Leaf), Node(3, Leaf, Leaf))
print(sum(t))

# Tuple pattern with a literal-guarded first arm.
fn describe(p: (int, int)) -> str:
    return match p:
        (0, 0): "origin"
        (0, y): "on y at {y}"
        (x, 0): "on x at {x}"
        (x, y): "point {x},{y}"

print(describe((0, 0)))
print(describe((0, 5)))
print(describe((3, 0)))
print(describe((3, 4)))

# Nested variant + tuple: Some((a, b)).
o: (int, int)? = Some((10, 20))
match o:
    None: print("none")
    Some((a, b)): print("pair {a} {b}")
