# examples/native_enum_smoke.chz — phase 5b-native-enum ARTIFACT.
#
# The reserved `T?`/`T!E` variant SHAPE is now file-backed (the two `native enum`
# declarations in std/prelude.chz), but the `?` operator, exhaustive `match`, top-level
# error propagation, and a value / None/success/an error CONSTRUCTION all stay Rust-wired. This program exercises that
# whole surface — construction, `?` on a `T!E`-returning AND a `T?`-returning fn, and exhaustive
# matches — so its byte-identical golden output is the phase-5b behavior-preservation gate.

# A `T!E`-returning fn (`int!` = int!Error); the error path short-circuits its `?` caller.
fn safe_at(xs: List[int], i: int) -> int!:
    if i < 0 or i >= xs.len():
        return !"index out of range"
    return ?xs[i]

# `?` on a `T!E` value: propagates the error to THIS fn's caller unchanged, else unwraps the success payload.
fn safe_at_plus(xs: List[int], i: int) -> int!:
    v := safe_at(xs, i)?
    return ?(v + 100)

# A `T?`-returning fn (`int?` = int?).
fn first_even(xs: List[int]) -> int?:
    for x in xs:
        if x % 2 == 0:
            return ?x
    return None

# `?` on a `T?` value: propagates None, else unwraps the value payload.
fn first_even_plus_one(xs: List[int]) -> int?:
    e := first_even(xs)?
    return ?(e + 1)

# Exhaustive match on a `T!E` value.
fn describe_result(r: int!) -> str:
    match r:
        ?v:
            return "ok {v}"
        !e:
            return "err {e.message()}"

# Exhaustive match on a `T?` value.
fn describe_option(o: int?) -> str:
    match o:
        ?v:
            return "some {v}"
        None:
            return "none"

fn main():
    xs := [10, 15, 20]

    # Construction: success / an error / a value / None.
    print(describe_result(?7))
    print(describe_result(!"boom"))
    print(describe_option(?3))
    print(describe_option(None))

    # `?` on a `T!E` value — the success path unwraps, the error path short-circuits.
    print(describe_result(safe_at_plus(xs, 0)))     # ok 110
    print(describe_result(safe_at_plus(xs, 9)))     # err index out of range

    # `?` on a `T?` value — the present path unwraps, the None path short-circuits.
    print(describe_option(first_even_plus_one(xs)))         # some 11
    print(describe_option(first_even_plus_one([1, 3, 5])))  # none

main()
