# examples/sys.chz — the M8 native trio: std.process (run commands), std.fs (filesystem
# queries), std.time (clock + date formatting). Only deterministic operations are printed so the
# golden output is stable (now()/monotonic() are checked as booleans, not values).

import std.process
import std.fs
import std.path
import std.time

# W7-8 — the fs listing fns hand back `path.Path` (raw OS bytes), so a non-UTF-8 filename survives.
# Convert to `str` for display here: `p.str()` is the LOSSY display (it never faults); `p.decode()`
# is the exact conversion that faults on a name that is not valid UTF-8.
fn shown(ps: List[path.Path]) -> str:
    out: List[str] = []
    for p in ps:
        out.push(p.str())
    return ",".join(out)

# --- std.process: a command's output comes back as Result[str] (Ok=stdout, Err=stderr) ---
match process.cmd("echo hello from the shell"):
    Ok(out): print("stdout: " + out.trim())
    Err(e): print("error: " + e.message().trim())

match process.cmd("exit 7"):
    Ok(out): print("ok: " + out)
    Err(e): print("failed: " + e.message())

# --- std.fs: existence, type, size, listing, and a simple */? glob ---
print("exists(Cargo.toml): " + str(fs.exists("Cargo.toml")))
print("exists(nope.xyz): " + str(fs.exists("nope.xyz")))
print("is_dir(examples): " + str(fs.is_dir("examples")))
print("is_file(examples): " + str(fs.is_file("examples")))

match fs.list_dir("examples/sysfixture"):
    Ok(names): print("list: " + shown(names))
    Err(e): print("error: " + e.message())

match fs.glob("examples/sysfixture/*.txt"):
    Ok(hits): print("glob: " + shown(hits))
    Err(e): print("error: " + e.message())

match fs.size("examples/sysfixture/a.txt"):
    Ok(n): print("size: " + str(n))
    Err(e): print("error: " + e.message())

# --- std.time: wall clock (non-deterministic → booleans), then deterministic formatting ---
print("now > 0: " + str(time.now() > 0))
print("monotonic >= 0: " + str(time.monotonic() >= 0.0))
time.sleep_ms(0)
print("format(0): " + time.format(0))
print("format(1700000000): " + time.format(1700000000))
