# Concurrency: `parallel:` nursery + `spawn`.
# A spawned task STARTS at its `spawn`, like Go's `go f()`. The block's dedent is a join BARRIER:
# the parent continues only after every child has finished — no leaks, no WaitGroup.
#
# The line order below is the BUFFERED sink (every Rust test helper, and `--serial`), where a task's
# output is flushed at the join in spawn order. `chezzi run` STREAMS, so there a task's output can
# interleave with the parent's. A join guarantees COMPLETION by the barrier, never that the task
# could not have started (and printed) earlier.

fn worker(id: int, label: str):
    print("{label} worker {id} ran")

fn main():
    label := "fanout"
    print("before nursery")
    parallel:
        # form 1: spawn a named call. Args are evaluated + copied at the spawn point.
        spawn worker(1, label)
        spawn worker(2, label)
        # form 2: spawn an anonymous block.
        spawn:
            n := 3
            print("{label} worker {n} ran")
    # Reaching here means all three tasks finished.
    print("after nursery")

    # The task is already running when the next statement executes; only the FLUSH is ordered by
    # the buffered sink, which is why "body continues" lands first in `parallel.expected`.
    parallel:
        spawn worker(10, "second")
        print("body continues")
    print("done")

main()
