# turbofish at the DECLARATION site (PART 1, type-side). Explicit type args for a generic TYPE go
# ON THE TYPE — `Box[int].Has(5)`, `Result[int, str].Ok(5)`, nullary `Box[int].Empty` — uniformly
# for enum variants AND generic static methods. The OLD gliding form `Box.Has[int](5)` (type args on
# the variant) is removed. Type-erased: the turbofish only drives the checker; runtime is identical
# to the inferred form.

enum Box[T]:
    Has(T)
    Empty
    fn empty() -> Box[T]:
        return Box.Empty
    fn count(self) -> int:
        match self:
            Box.Has(_): return 1
            Box.Empty: return 0

# A 2-param Result-like enum: the multi-type-arg turbofish carrier (`E[int, str].Pair(…)`).
enum Pair[T, U]:
    Both(T, U)
    Neither

fn main():
    # Single type-arg variant ctor on the TYPE.
    b: Box[int] = Box[int].Has(5)
    print(b.count())             # 1

    # Nullary variant value via the type-level turbofish (the args can't be inferred from a payload).
    e: Box[str] = Box[str].Empty
    print(e.count())             # 0

    # Multi type-arg variant ctor (the TypeApply carrier — the comma disambiguates).
    p: Pair[int, str] = Pair[int, str].Both(1, "one")
    match p:
        Pair.Both(n, s): print("{n}-{s}")   # 1-one
        Pair.Neither: print("neither")

    # Generic STATIC method via the type-level turbofish (regression: variant-first falls through).
    c := Box[int].empty()
    print(c.count())             # 0

main()
