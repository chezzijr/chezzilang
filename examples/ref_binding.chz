# examples/ref_binding.chz — `ref T`: transparent by-reference bindings (sugar over std.ref `Ref[T]`).
#
# `ref T` is a binding MODIFIER (locals + params only), not a first-class type. It lowers to a
# `Ref[T]` box: reads auto-deref (`r` -> `r.get()`), writes mutate the pointee (`r = v` -> `r.set(v)`),
# and a fresh box is created on init unless the RHS is already a `ref` binding (then it ALIASES).
# Roughly C++'s `int&` — vs `Ref[T]`, the explicit first-class box (≈ Rust's Rc). Same-task only.

import std.ref

# --- create + read/write sugar -------------------------------------------------------------------
r: ref int = 10
print(r)                 # 10  (rvalue read auto-derefs)
r = 42                   # assignment mutates the pointee (never rebinds)
print(r)                 # 42
r += 1                   # compound assignment: r.set(r.get() + 1)
print(r)                 # 43
print(r + 100)           # 143 (a ref is usable anywhere its value is)

# --- alias shares the same box ------------------------------------------------------------------
r2: ref int = r          # RHS is already a ref binding -> ALIAS (share the box)
r2 = 7
print(r)                 # 7   (mutation through the alias is visible through the original)
print(r2)                # 7

# --- a plain (annotation-less) copy does NOT share -----------------------------------------------
y := r                   # `y := r` auto-derefs -> y: int, a COPY
y = 999
print(r)                 # 7   (unchanged — y is its own value)
print(y)                 # 999

# --- pass-by-ref: callee mutates the caller's binding --------------------------------------------
fn bump(x: ref int):
    x += 10              # mutates the caller's box through the ref param

bump(r)
print(r)                 # 17

# --- ref -> T param: auto-deref to a copy (callee can't see the caller's box) --------------------
fn observe(x: int):
    x = x + 1000         # local mutation only — the arg was a copy
    print(x)             # 1017

observe(r)
print(r)                 # 17  (unchanged)

# --- inner-fn capture by reference persists through the box --------------------------------------
# A nested fn that closes over a `ref` local mutates the SHARED box, so the change is visible to the
# enclosing scope (a plain `int` local would be captured by value and the writes would be invisible).
counter: ref int = 0
fn bump_counter():
    counter += 1

bump_counter()
bump_counter()
bump_counter()
print(counter)           # 3   (the captured box accumulated)
