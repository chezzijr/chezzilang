# Generators declare their element type: `-> Iterator[T]` is written, never inferred from a
# `yield`. Every `yield` must be assignable to that element type.

fn count_to(n: int) -> Iterator[int]:
    i := 0
    while i < n:
        yield i
        i = i + 1

struct Doubler:
    n: int
    # A generator METHOD, also annotation-free.
    fn stream(self) -> Iterator[int]:
        i := 1
        while i <= self.n:
            yield i * 2
            i = i + 1

fn main():
    for x in count_to(5):
        print(x)
    d := Doubler(3)
    for y in d.stream():
        print(y)

main()
