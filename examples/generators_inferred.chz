# Generators without an explicit `-> Iterator[T]` annotation.
# The element type is inferred from the FIRST `yield` (strict-first-yield):
# `count_to` infers `Iterator[int]`, `Doubler.stream` likewise — no `Iterator[T]` spelled anywhere.
# A later `yield` must be assignable to that inferred element type.

fn count_to(n: int):
    i := 0
    while i < n:
        yield i
        i = i + 1

struct Doubler:
    n: int
    # A generator METHOD, also annotation-free.
    fn stream(self):
        i := 1
        while i <= self.n:
            yield i * 2
            i = i + 1

fn main():
    for x in count_to(5):
        print(x)
    d := Doubler(3)
    for y in d.stream():
        print(y)

main()
