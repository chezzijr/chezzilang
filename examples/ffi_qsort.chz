# Capstone: sort a Chezzi list with libc `qsort` — the full FFI composition.
#
# This one example exercises every piece of the C-buffer FFI surface together:
#   - `ffi.alloc` lays out a raw C buffer (one int64 slot per element),
#   - `ffi.store_int64_at` fills it from a Chezzi list,
#   - `qsort` (libc) sorts it in place, calling back into a Chezzi comparator,
#   - the comparator `ffi.load_int64`s both `const void*` sides and returns -1/0/1,
#   - `ffi.load_int64_at` reads the sorted values back,
#   - `defer ffi.free` releases the buffer (manual free — a `ptr` is never auto-freed).
#
# A fixed 8-byte (int64) stride is used in BOTH the buffer and the comparator so the comparator's
# `const void*` slots line up with the stored elements on every LP64 unix.
import std.ffi

extern "libc.so.6":
    fn qsort(base: ptr, n: int, size: int, cmp: fn(ptr, ptr) -> int)

# The comparator C hands two `const void*` (each pointing at one int64 slot). Return -1/0/1 instead
# of `a - b` to avoid signed overflow on extreme values.
fn cmp(a: ptr, b: ptr) -> int:
    x := ffi.load_int64(a)
    y := ffi.load_int64(b)
    if x < y:
        return -1
    if x > y:
        return 1
    return 0

data := [5, 2, 9, 1, 7, 3, 8, 4, 6, 0]
n := data.len()

# Lay out a C int64[n] buffer and fill it from the list.
buf := ffi.alloc(n * 8)
defer ffi.free(buf)
for i in range(n):
    ffi.store_int64_at(buf, i * 8, data[i])

# Sort in place: libc qsort calls `cmp` for each pair, which derefs the Chezzi-side load builtins.
qsort(buf, n, 8, cmp)

# Read the sorted values back out and print them.
for i in range(n):
    print(ffi.load_int64_at(buf, i * 8))
