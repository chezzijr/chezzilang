# examples/rand_shape.chz — std.rand UNSEEDED golden (the OS-entropy auto-seed path). Asserts only
# RANGE/SHAPE (0 <= float < 1, lo <= int < hi, bool is a bool), never the random values — so the
# output is value-independent and byte-identical across all engines despite the nondeterministic
# seed. (The seeded stream itself is covered by examples/rand_seeded.chz.)

import std.rand

fn main():
    float_ok := true
    for _ in 0..1000:
        f := rand.float()
        if f < 0.0 or f >= 1.0:
            float_ok = false
    if float_ok:
        print("float ok")
    else:
        print("float FAIL")

    int_ok := true
    for _ in 0..1000:
        i := rand.int(10, 20)
        if i < 10 or i >= 20:
            int_ok = false
    if int_ok:
        print("int ok")
    else:
        print("int FAIL")

    # bool() always returns a bool; draw a few so the path is exercised.
    for _ in 0..10:
        b := rand.bool()
    print("bool ok")

main()
