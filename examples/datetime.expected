== from_epoch / formatters ==
0 -> 1970-01-01T00:00:00Z  (Thursday)
1700000000 -> 2023-11-14T22:13:20Z  (Tuesday)
-1 -> 1969-12-31T23:59:59Z  (Wednesday)
951782400 -> 2000-02-29T00:00:00Z  (Tuesday)
== to_string / date / time ==
2023-11-14 22:13:20
2023-11-14
22:13:20
== round-trip ==
to_epoch(from_epoch(1700000000)) = 1700000000
to_epoch(from_epoch(-1))         = -1
== days_from_civil / civil_from_days ==
days_from_civil(2024,2,29) = 19782
civil_from_days(19675) = 2023-11-14
== leap / month length ==
is_leap_year(2000)=true is_leap_year(1900)=false is_leap_year(2024)=true
days_in_month(2024,2)=29 days_in_month(2023,2)=28
== duration ==
add_days(0,7)=604800 add_seconds(0,90)=90
diff_days(1700000000,1699913600)=1
diff_seconds(90,0)=90
== weekday ==
weekday(0)=4 weekday(-1)=3 weekday(1700000000)=2
