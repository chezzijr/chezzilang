# `wait:` SEND-arms — Go-`select` symmetry: an arm `ch.send(v):` fires once the channel can accept
# the value (bounded-with-space / unbounded / closed → faults, Go's panic analog). Selection is
# DETERMINISTIC source order (first ready arm wins, recv OR send) — Chezzi's one principled divergence
# from Go's random fairness. See docs/concurrency.md §6d.

fn main():
    # --- Phase A: mixed recv + send + else at top level (single fiber; `else` keeps it non-blocking) ---
    inbox := Channel[int]()      # unbounded
    outbox := Channel[int](1)    # bounded, capacity 1
    inbox.send(10)

    # The recv-arm is ready (inbox has 10) and beats the later send-arm in source order.
    wait:
        v := inbox.recv(): print("A recv {v}")
        outbox.send(1): print("A sent")
        else: print("A idle")

    # inbox is drained; outbox has a free slot → the send-arm is ready, the recv-arm is not.
    wait:
        w := inbox.recv(): print("B recv {w}")
        outbox.send(2): print("B sent")
        else: print("B idle")

    # inbox empty; outbox now full → no arm ready → `else`.
    wait:
        u := inbox.recv(): print("C recv {u}")
        outbox.send(3): print("C sent")
        else: print("C idle")

    print("outbox={outbox.recv()}")   # proves phase-B's send actually queued the 2

    # --- Phase B: a bounded send-arm BLOCKS until a receiver frees a slot (cross-task) ---
    # Single producer → single consumer → FIFO, so the value order is deterministic; only the consumer
    # prints, so there is no concurrent-output interleave. The producer's `wait:` send-arm parks when
    # the cap-1 channel is full and wakes when the consumer's `recv` frees the slot.
    c := Channel[int](1)
    parallel:
        spawn:
            for i in range(0, 5):
                wait:
                    c.send(i): pass
            c.close()
        spawn:
            for x in c:
                print("D {x}")

main()
