# examples/default_expr.chz — non-constant default expressions. A default may be any expression that
# does NOT reference another parameter/field: a computed constant, a global, or a function call.
# A default is evaluated ONCE PER OMITTING CALL, in the MODULE THAT DECLARES IT — so param-referencing
# defaults like `y = x + 1` are rejected (parameters are not in scope there), and a caller's
# same-named global cannot reach in. The cross-module half is `examples/default_xmod/`.

DEFAULT_CAP := 8

fn next_id() -> int:
    return 1000

# default = arithmetic on literals
fn box(w: int, h: int = 2 + 3) -> int:
    return w * h

# default = a global * literal
fn capacity(extra: int = DEFAULT_CAP * 2) -> int:
    return extra

# default = a function call
fn make(id: int = next_id()) -> int:
    return id

# default = a call to a *defaulted* function (its own default fills in)
fn base(n: int = 5) -> int:
    return n * 2

fn scaled(v: int = base()) -> int:
    return v

# default = an expression with null-coalescing (a `??` carrier, lowered by the compiler inside the default)
fn maybe() -> int?:
    return Some(9)

fn pick(v: int = maybe() ?? 0) -> int:
    return v

# struct field defaults = expressions
struct Config:
    retries: int = 1 + 2
    limit: int = DEFAULT_CAP

fn main():
    print(box(4))             # 4 * 5 = 20
    print(box(4, 10))         # 40
    print(capacity())         # 16
    print(capacity(3))        # 3
    print(make())             # 1000
    print(scaled())           # base() = 5*2 = 10
    print(pick())             # maybe() ?? 0 = 9
    c := Config()
    print(c.retries)          # 3
    print(c.limit)            # 8

main()
