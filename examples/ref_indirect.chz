# examples/ref_indirect.chz — `ref T` argument coercion through INDIRECT callees.
#
# The alias-vs-deref-vs-error decision for a `ref` argument is type-directed: it follows the
# resolved callee's parameter, even when the callee is reached through a LOCAL fn-value, a closure,
# or a method shared by name across structs that disagree on ref-ness. All forms lower to the same
# `Ref[T]` box, so the VM and the interpreter are byte-identical.

import std.ref

# --- through a local fn-value: the box aliases (callee mutates the caller's binding) -------------
fn bump(x: ref int):
    x = 99

r: ref int = 7
g := bump                # `g` is a local fn-value bound to `bump`
g(r)                     # resolves through `g` to bump's `ref` param -> ALIAS
print(r)                 # 99

# --- a local fn-value into a by-value param auto-derefs (a copy) ---------------------------------
fn observe(x: int):
    print(x)             # 99

h := observe
h(r)                     # `ref` arg into a `T` param -> deref copy
print(r)                 # 99 (unchanged)

# --- a closure `ref` param behaves like a named-fn `ref` param (reads auto-deref) ----------------
inc := fn(x: ref int) -> int: x + 1
print(inc(r))            # 100 (reads the box's value 99, +1)

# --- a method name shared by two structs that disagree on ref-ness, resolved by receiver ---------
struct Setter:
    tag: int
    fn apply(self, x: ref int):
        x = 42           # ref param -> mutates the caller's box

struct Printer:
    tag: int
    fn apply(self, x: int):
        print(x)         # by-value param -> a copy

s := Setter(0)
s.apply(r)               # resolves to Setter.apply (ref) -> ALIAS
print(r)                 # 42

p := Printer(0)
p.apply(r)               # resolves to Printer.apply (by-value) -> deref copy (prints 42)
print(r)                 # 42 (unchanged)
