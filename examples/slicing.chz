# Slicing + the Index / IndexSet / Slice protocols.
# Built-in list/map/str and user structs all share one indexing vocabulary.

# Built-in list & string slicing — `xs[a..b]` takes a `Range` value; bounds clamp, a negative bound counts from the end.
import Index from std.ops
xs := [1, 2, 3, 4, 5]
print(xs[1..3])         # [2, 3]
print(xs[1..99])        # [2, 3, 4, 5]  (end clamped to len)
print(xs[2..1])         # []            (start > end -> empty)
print("hello"[0..2])    # he

# Open bounds: an omitted component defaults (start -> 0, end -> len).
print(xs[2..])          # [3, 4, 5]
print(xs[..2])          # [1, 2]
print(xs[..])           # [1, 2, 3, 4, 5]

# Step + reverse.
print(xs[Range(0, 5, 2)])       # [1, 3, 5]
print(xs.reversed())        # [5, 4, 3, 2, 1]
print("hello".reversed())   # olleh

# Negative indexing counts from the end (plain index AND slice bounds).
print(xs[-1])          # 5
print(xs[-2])          # 4
print(xs[-2..])         # [4, 5]
print(xs[..-1])         # [1, 2, 3, 4]
xs[-1] = 50            # assignment to a negative index
print(xs[4])           # 50

# A custom collection satisfies the protocols structurally: `index` (read), `set_index`
# (write), and `slice`. A `Ring` wraps its index around the backing list. The `slice` protocol
# takes the `Range` value: `slice(self, r: Range) -> R`, so the body hands it straight to the
# backing list, which resolves the bounds, the step and a negative bound.
struct Ring:
    data: List[int]
    fn index(self, k: int) -> int:
        return self.data[k % self.data.len()]
    fn set_index(self, k: int, v: int):
        self.data[k % self.data.len()] = v
    fn slice(self, r: Range) -> List[int]:
        return self.data[r]

r := Ring([10, 20, 30])
print(r[0])            # 10
print(r[3])            # 10   (wraps: 3 % 3 == 0)
r[1] = 99
print(r[1])            # 99
print(r[0..2])          # [10, 99]
print(r[..])            # [10, 99, 30]
print(r[Range(None, None, -1)])  # [30, 99, 10]

# A generic bounded by `Index[int, V]` works over the built-in list AND the user struct,
# recovering `V` from each argument.
fn first[C: Index[int, V], V](c: C) -> V:
    return c[0]

print(first(xs))       # 1
print(first(r))        # 10
