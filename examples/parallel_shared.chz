# B3.3-threads `--parallel` golden: real OS-thread tasks mutate one `Shared[int]` box concurrently.
# Deterministic-by-construction (decision A): the box's owner serialises every `update`, so the final
# count is the spawn count regardless of thread interleaving — the result is order-independent.
# Run with: chezzi run --parallel examples/parallel_shared.chz

fn bump(s: Shared[int]):
    s.update(fn(x): x + 1)

fn main():
    s := Shared(0)
    parallel:
        spawn bump(s)            # the handle is sendable; every task reaches the same box
        spawn bump(s)
        spawn bump(s)
        spawn bump(s)
        spawn bump(s)
    print(s.get())               # 5 — serialised writes, no torn-write race even on real threads

main()
