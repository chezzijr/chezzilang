# examples/ref_airlock.chz — `ref T` and the concurrency airlock (spec §7).
#
# `ref`/`Ref` are SAME-TASK aliasing only. A `ref T` is a `Ref[T]` box, and a `Ref[T]` is
# NON-SENDABLE: you cannot capture/pass the box across the spawn/parallel:/Channel airlock (the
# checker rejects it — see the companion checker test). To get a value across, deref the ref into a
# plain copy first; the child then mutates only its own copy, so the parent's binding is unchanged.
# For genuine cross-task shared mutation use `Shared[T]`, never `ref`.

import std.concurrency
import std.ref

fn main():
    total: ref int = 100
    snapshot := total          # `:=` auto-derefs the ref -> a plain `int` COPY (sendable)
    result := Shared(0)         # the proper cross-task channel for a result

    parallel:
        spawn:
            # The child sees only the copied value; it cannot reach the parent's box.
            doubled := snapshot * 2
            result.set(doubled)

    print(total)                # 100  (the parent's ref is untouched by the child)
    print(result.get())         # 200  (the child computed from the copied snapshot)

main()
