import std.concurrency

fn main():
    a := Atomic(0)
    print(a.load())          # 0
    a.store(10)
    print(a.load())          # 10
    print(a.add(5))          # 15 (new value)
    print(a.sub(3))          # 12 (new value)
    print(a.exchange(100))   # 12 (old value)
    print(a.load())          # 100
    print(a.cas(100, 7))     # true  — held 100, swapped to 7
    print(a.load())          # 7
    print(a.cas(100, 9))     # false — holds 7, not 100
    print(a.load())          # 7
main()
