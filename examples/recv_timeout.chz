# Channel[T].recv_timeout(ms) waits up to `ms` for a value: Some(v) if one arrives, None on timeout.
# It is TOTAL — it never faults (a closed channel and an unproducible empty channel are both "no
# value will come" → None). Shown here at top level so every engine agrees: the --parallel VM honors
# `ms` as real wall-clock (demote-block with a deadline); the cooperative VM and the frozen
# interpreter have no clock, so an empty channel with no producer resolves to None immediately. All
# three print the same thing.

fn main():
    # A value already queued -> Some(v) right away (no waiting).
    full := Channel[int]()
    full.send(7)
    match full.recv_timeout(50):
        Some(v): print("got {v}")
        None: print("unexpected timeout")

    # Empty, with no producer -> None once the deadline lapses (never the deadlock fault recv raises).
    empty := Channel[int]()
    match empty.recv_timeout(20):
        Some(v): print("unexpected {v}")
        None: print("timed out")

main()
