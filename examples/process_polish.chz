# examples/process_polish.chz — std.process structured forms: run(line) and run_args(prog, args).
# Both return ProcResult{stdout, stderr, code}!: a non-zero exit is a NORMAL success with code !=
# 0 (stdout is NOT discarded), only a spawn failure is an error. run_args runs WITHOUT a shell, so its
# arguments are passed literally (injection-safe). Only deterministic output is printed.

import std.process

# --- run: full structured result over `sh -c` ---
match process.run("echo structured"):
    ?r: print("run stdout: " + r.stdout.trim() + " code: " + str(r.code))
    !e: print("run error: " + e.message())

# A non-zero exit is success, carrying both streams + the code (NOT an error, NOT discarded stdout).
match process.run("echo out; echo oops 1>&2; exit 5"):
    ?r: print("nonzero stdout: " + r.stdout.trim() + " stderr: " + r.stderr.trim() + " code: " + str(r.code))
    !e: print("run error: " + e.message())

# --- run_args: no shell → metacharacters are literal (injection-safe) ---
match process.run_args("echo", ["$(echo PWNED)", ";", "&&"]):
    ?r: print("args stdout: " + r.stdout.trim() + " code: " + str(r.code))
    !e: print("args error: " + e.message())

# A spawn failure (no such program) is a catchable an error, never a panic.
match process.run_args("no-such-prog-xyz", []):
    ?r: print("unexpected ok code: " + str(r.code))
    !e: print("spawn failed")
