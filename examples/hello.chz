# examples/hello.chz — touchstone program for the lexer/parser/interp milestones.
# Doubles as golden-test + LLM-eval material.

fn greet(name: str) -> str:
    return "hi {name}"

struct Point:
    x: int
    y: int

    fn mag_sq(self) -> float:
        return (self.x * self.x + self.y * self.y).to_float()

enum Shape:
    Circle(int)
    Square(int)

fn area(s: Shape) -> float:
    match s:
        Shape.Circle(r): return 3.14 * (r * r).to_float()
        Shape.Square(n): return (n * n).to_float()

fn safe_div(a: int, b: int) -> int!:
    if b == 0:
        return !"divide by zero"
    return ?(a / b)

fn main() -> int!:
    print(greet("chezzi"))

    total := 0
    for i in 0..10:
        if i % 2 == 0:
            total += i
    print("even sum 0..10: {total}")

    p := Point(3, 4)
    print("mag_sq: {p.mag_sq()}")

    print("area: {area(Shape.Circle(2))}")

    r := safe_div(10, 2)?
    print("div: {r}")
    return ?0

main()?
