# M-C: implicit nurseries. Every function body is itself a nursery — a bare `spawn` (no enclosing
# `parallel:`) is legal anywhere and joins at the function's `return`/end. `parallel:` still works as
# an explicit *inner* sub-nursery that joins earlier (at its dedent).
#
# `implicit_nursery.expected`'s exact line order is the BUFFERED test sink (every lib helper, both
# engines) and `--serial`. `chezzi run` STREAMS: cross-task print order is nondeterministic on both
# engines by contract (docs/concurrency.md, "the user-facing contract"), so e.g. `outer ran` may
# print before `after inner nursery` there. A join point guarantees COMPLETION by the barrier, never
# that the task could not have started (and printed) earlier.

fn worker(label: str):
    print("{label} ran")

# Bare spawn at function scope: the task joins at end-of-body, after the inline statements.
fn fanout() -> int:
    spawn worker("a")
    spawn worker("b")
    print("fanout body")
    # `return` is a JOIN point: the two tasks run to completion here, THEN the value is returned.
    return 0

# Function-scope spawn alongside an explicit inner `parallel:`: the inner nursery joins at its
# dedent (first), the implicit function nursery joins at the function's end (last).
fn mixed():
    spawn worker("outer")
    parallel:
        spawn worker("inner")
    print("after inner nursery")

fn main():
    n := fanout()
    print("fanout returned {n}")
    mixed()
    print("done")

main()
