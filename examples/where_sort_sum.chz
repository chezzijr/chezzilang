# Golden: file-backed List `sort` (now `native fn sort(self) -> nil where T: Comparable` in
# std/prelude.chz — the retired bespoke Comparable arm) and `sum` (`native fn sum(self) -> T where
# T: Add`, an annotation over the surviving numeric check-gate). Exercises sort on int / float /
# struct-with-`compare` lists and sum on int / float lists. `where` lowers to NOTHING at runtime, so
# the output is byte-identical on interp, the cooperative VM (--serial), and the M:N engine
# (default / --parallel) — the three-engine parity gate for the where-clause feature.
# Run with: chezzi run examples/where_sort_sum.chz   (also --serial / --parallel — byte-identical)

struct Point:
    n: int
    fn compare(self, o: Point) -> int:
        return self.n - o.n

fn show_ints(xs: List[int]):
    for x in xs:
        print(x)

fn show_floats(xs: List[float]):
    for x in xs:
        print(x)

fn main():
    a := [3, 1, 2]
    a.sort()                 # int list, intrinsic Comparable
    show_ints(a)             # 1 2 3

    b := [3.0, 1.5, 2.5]
    b.sort()                 # float list, intrinsic Comparable
    show_floats(b)           # 1.5 2.5 3.0

    ps := [Point(3), Point(1), Point(2)]
    ps.sort()                # struct list, Comparable via `compare`
    for p in ps:
        print(p.n)           # 1 2 3

    print([1, 2, 3, 4].sum())      # 10 — int sum, T: Add satisfied intrinsically
    print([1.0, 2.0, 3.5].sum())   # 6.5 — float sum

main()
