# M6 — core-type methods (str / list).

fn shout(s: str) -> str:
    return s.upper()

fn main():
    s := "  Hello, World  "
    print(s.trim())
    print(s.trim().upper())
    print(s.len())

    parts := "a,b,c".split(",")
    print(parts)
    print(",".join(parts))

    print("chezzi".starts_with("che"))
    print("chezzi".contains("ez"))

    xs := [1, 2, 3]
    xs.push(4)
    print(xs)
    print(xs.len())

    print(shout("hi"))

main()
