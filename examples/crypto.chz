# examples/crypto.chz — std.crypto digests (sha256, md5) of fixed inputs. Digests are deterministic
# lowercase-hex strings (published FIPS-180 / RFC 1321 vectors), so the golden is byte-identical
# across run / --serial / --parallel and on both engines. MD5 is here for checksums/interop only —
# it is NOT cryptographically secure.

import std.crypto
import std.io

print("sha256('')    = " + crypto.sha256(""))
print("sha256('abc') = " + crypto.sha256("abc"))
print("sha256('Chezzi') = " + crypto.sha256("Chezzi"))
print("md5('')       = " + crypto.md5(""))
print("md5('abc')    = " + crypto.md5("abc"))
print("md5('message digest') = " + crypto.md5("message digest"))
