# `libc`/`libm` are LOGICAL names the loader resolves to this host's real C library (glibc's
# versioned sonames on Linux, `libSystem.B.dylib` on macOS). Any other name goes to `dlopen`
# verbatim — see docs/syntax.md §12b.
extern "libm":
    fn cos(x: float) -> float
    fn sqrt(x: float) -> float

extern "libc":
    fn strlen(s: str) -> int

print(cos(0.0))
print(sqrt(4.0))
print(strlen("hello"))
