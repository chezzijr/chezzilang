# Retained feature (G2): a `ref` PARAM passes a variable by reference into a callee that mutates the
# caller's binding — a distinct capability from closure capture, unchanged by uniform-capture boxing.
import std.ref

fn bump(x: ref int):
    x = x + 1

fn main():
    r: ref int = 0
    bump(r)
    print(r)                # 1

main()
