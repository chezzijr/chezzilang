# `defer` — block-scoped cleanup that runs when the enclosing lexical block exits, LIFO, on every
# exit path: fall-through, `break`/`continue`, normal return, `?` short-circuit, and panic. Every
# indented block is a scope (function body, loop body, `if`/branch, `recover:`, `match` arm, and the
# module top level). The receiver + arguments are evaluated at the `defer` statement; only the call
# is delayed. (`std.os.exit` is a hard halt and skips defers.)

import std.os

# `defer` targets a method or a first-class callable value (built-ins like `print` are wrapped).
fn log(msg: str):
    print(msg)

struct File:
    name: str

    fn close(self):
        log("closing {self.name}")

# --- LIFO order, mixing a method call and free-function calls ---
fn lifo():
    f := File("data.txt")
    defer f.close()
    defer log("second")
    defer log("first")
    log("body")

# --- runs on the `?` short-circuit error path ---
fn parse(ok: bool) -> int!:
    defer log("parse cleanup")
    if not ok:
        return Err("bad input")
    return Ok(7)

fn use_q() -> int!:
    defer log("use_q cleanup")
    n := parse(false)?   # short-circuits here; both frames' defers still run
    return Ok(n)

# --- block scope: a loop-body defer runs at the END of each iteration; each iteration snapshots
#     its own `i` at the defer statement (Go arg semantics) ---
fn args_now():
    for i in 0..3:
        defer log("i={i}")
    log("loop done")

# --- block scope across nesting: an `if`-branch defer fires at the branch's end, before the code
#     after the `if`; `break` runs the current iteration's body defers before leaving the loop ---
fn block_scope():
    for i in 0..3:
        defer log("iter {i} cleanup")
        if i == 1:
            defer log("if cleanup")
            log("breaking")
            break
        log("iter {i} work")
    log("loop exited")

# --- `defer:` block form: a multi-statement cleanup body. Runs top-to-bottom at scope exit, but is
#     LIFO *as a unit* relative to other `defer`s. A `defer:` block runs in the same task and shares
#     the enclosing binding by reference, so it sees the LATEST value of a captured local (unlike the
#     `defer f(x)` CALL form, which evaluates its args eagerly at the defer point). ---
fn block_form():
    defer log("single A (registered first)")
    defer:
        log("block step 1")
        log("block step 2")
    defer log("single B (registered last)")
    x := 1
    defer:
        log("snapshot x = {x}")   # shares x by reference: sees x == 2 when it runs at scope exit
    x = 2
    log("block_form body, x now {x}")

# --- a `defer:` block runs on the `?` short-circuit path too (block-scoped, all exit paths) ---
fn block_q(ok: bool) -> int!:
    defer:
        log("block_q cleanup 1")
        log("block_q cleanup 2")
    if not ok:
        return Err("nope")
    return Ok(1)

# --- defers run as a panic unwinds, before a `recover:` boundary regains control ---
fn faults():
    defer log("faults cleanup")
    xs := [10, 20]
    log("{xs[5]}")   # index out of bounds → fault

# --- a fault inside a deferred call: the others still run, the fault is caught by recover ---
fn boom():
    ys := [1]
    log("{ys[9]}")

fn bad_defer():
    defer log("after")
    defer boom()
    defer log("before")
    log("bad_defer body")

fn main():
    log("== lifo ==")
    lifo()

    log("== ? path ==")
    r := use_q()
    match r:
        Ok(n): log("ok {n}")
        Err(e): log("err {e}")

    log("== args now ==")
    args_now()

    log("== block scope ==")
    block_scope()

    log("== block form ==")
    block_form()

    log("== block form on ? path ==")
    rq := block_q(false)
    match rq:
        Ok(_): log("bq ok")
        Err(e): log("bq err {e}")

    log("== panic + recover ==")
    res := recover:
        faults()
    match res:
        Ok(_): log("recovered ok")
        Err(e): log("recovered err: {e}")

    log("== deferred fault ==")
    res2 := recover:
        bad_defer()
    match res2:
        Ok(_): log("ok")
        Err(e): log("caught: {e}")

main()
