# std.cancel — cooperative cancellation of a pure-CPU loop by a sibling's MANUAL cancel.
#
# OUTPUT DIVERGES BY ENGINE — so this carries NO `.expected` (cf. examples/parallel_cancel.chz). The
# worker spins, polling tok.cancelled() each iteration; the canceller sleeps briefly then cancels.
#   - default OS-thread engine: both run concurrently → the worker observes the cancel and aborts
#     early (partial count).
#   - --serial / --interp (single-threaded oracles): tasks run sequentially at the nursery join in
#     spawn order → the worker runs to completion BEFORE the canceller ever gets the thread.
# A self-polling *timeout* would instead stop on every engine (the deadline is read inline); the
# divergence here is specific to a manual cancel of a non-yielding CPU sibling. Covered by a Rust test.
import std.cancel
import std.time

fn worker(tok: Token, out: Shared[int]):
    i := 0
    while i < 50000000:
        if tok.cancelled():
            out.set(i)
            return
        i = i + 1
    out.set(i)

fn canceller(tok: Token):
    time.sleep_ms(10)
    tok.cancel()

fn main():
    tok := cancel.manual()
    out := Shared(0)
    parallel:
        spawn worker(tok, out)
        spawn canceller(tok)
    if out.get() < 50000000:
        print("worker aborted early")
    else:
        print("worker ran to completion")

main()
