# std.cancel — cooperative cancellation of a pure-CPU loop by a sibling's MANUAL cancel.
#
# OUTPUT IS TIMING-DEPENDENT — so this carries NO `.expected` (cf. examples/parallel_cancel.chz). The
# worker spins, polling tok.cancelled() each iteration; the canceller sleeps briefly then cancels.
# On the M:N engine the two run concurrently, so the worker observes the cancel and stops early with a
# PARTIAL count — but WHICH count depends on the scheduler and the host, which is why there is no
# golden. A self-polling *timeout* would instead stop at a deadline read inline; the nondeterminism
# here is specific to a manual cancel of a non-yielding CPU sibling. Covered by a Rust test.
import std.cancel
import std.concurrency
import std.time

fn worker(tok: Token, out: Shared[int]):
    i := 0
    while i < 50000000:
        if tok.cancelled():
            out.set(i)
            return
        i = i + 1
    out.set(i)

fn canceller(tok: Token):
    time.sleep_ms(10)
    tok.cancel()

fn main():
    tok := cancel.manual()
    out := Shared(0)
    parallel:
        spawn worker(tok, out)
        spawn canceller(tok)
    if out.get() < 50000000:
        print("worker aborted early")
    else:
        print("worker ran to completion")

main()
