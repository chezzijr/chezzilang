# Retained feature (F2): CROSS-TASK shared mutation uses `Shared[T]` (a spawn gets the one box by
# handle), so N tasks over one `Shared` all accumulate — the sanctioned way to order writes
# across tasks (a plain captured local is shared too, but N unlocked writes to it race).
import Shared from std.concurrency

fn main():
    c := Shared(0)
    parallel:
        spawn: c.update(fn(v: int) -> int: v + 1)
        spawn: c.update(fn(v: int) -> int: v + 1)
        spawn: c.update(fn(v: int) -> int: v + 1)
    print(c.get())              # 3

main()
