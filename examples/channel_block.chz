# B1 + B2 (VM engine): blocking `recv`. The consumer is spawned first; it blocks on the empty
# channel, the producer sends, and the consumer then RESUMES exactly where it parked and receives.
# This is the canonical mid-flight producer/consumer that a sequential executor could not express.
#
# NOTE: needs suspendable execution (a blocking `recv` that parks mid-flight). The LINE SET below
# is guaranteed by the program's logic, and running this file for real (`chezzi run`, the streaming
# stdout sink, line-atomic per print) gives the interleaved order shown above, deterministically.
# `golden_channel_block_chz_matches_expected` still compares order-insensitively: it runs through
# the Rust suite's in-process BUFFERED capture, where each spawned task's whole output is merged in
# at the join by spawn order rather than print order (`Vm::reduce_task_slots`), so what that harness
# actually observes is "consumer: waiting/got/got" as one block ahead of "producer: send/send" — a
# property of the test capture path, not a race in the engine.

fn consumer(ch: Channel[int]):
    print("consumer: waiting")
    a := ch.recv()
    print("consumer: got {a}")
    b := ch.recv()
    print("consumer: got {b}")

fn producer(ch: Channel[int]):
    print("producer: send 1")
    ch.send(1)
    print("producer: send 2")
    ch.send(2)

fn main():
    ch := Channel[int]()
    parallel:
        spawn consumer(ch)       # spawned first ⇒ runs first ⇒ blocks on the empty channel
        spawn producer(ch)       # the scheduler switches here; its sends wake the consumer
    print("done")

main()
