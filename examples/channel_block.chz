# golden: unordered (concurrent prints; tests/examples_golden.rs compares the sorted line sets)
# B1 + B2 (VM engine): blocking `recv`. The consumer blocks on the empty channel, the producer
# sends, and the consumer then RESUMES exactly where it parked and receives.
# This is the canonical mid-flight producer/consumer that a sequential executor could not express.
#
# NOTE: needs suspendable execution (a blocking `recv` that parks mid-flight). The LINE SET below
# is guaranteed by the program's logic; the ORDER across the two tasks is not. `Channel[int]()` is
# unbounded, so a `send` never waits for the consumer: no hand-off orders `consumer: waiting`
# against `producer: send 1`, or `producer: send 2` against `consumer: got 1`. What IS forced: each
# task's own lines keep their order, `got N` follows `send N`, and `done` is last (the join).
# `.expected` records one valid `chezzi run` order; the Go twin (two goroutines, a cap-2 channel)
# prints four different orders. The Rust suite's in-process BUFFERED capture merges each task's
# whole output at the join by spawn order (`Vm::reduce_task_slots`), so
# `golden_channel_block_chz_matches_expected` sees "consumer: waiting/got/got" as one block ahead
# of "producer: send/send". See concurrency.md §"Output ordering".

fn consumer(ch: Channel[int]):
    print("consumer: waiting")
    a := ch.recv()
    print("consumer: got {a}")
    b := ch.recv()
    print("consumer: got {b}")

fn producer(ch: Channel[int]):
    print("producer: send 1")
    ch.send(1)
    print("producer: send 2")
    ch.send(2)

fn main():
    ch := Channel[int]()
    parallel:
        spawn consumer(ch)       # parks on the empty channel unless a value is already queued
        spawn producer(ch)       # its sends never wait; each one wakes a parked consumer
    print("done")

main()
