# examples/evaluator.chz — a complete little arithmetic expression evaluator.
#
# Pipeline: tokenize (string scan) -> recursive-descent parse into an AST enum -> evaluate.
# Exercises: enums with payloads (tokens + a self-recursive AST), pattern matching, recursion,
# a mutable struct cursor, `Result`/`?` error propagation through every layer, string indexing,
# and `ord`-based digit math. Errors (bad char, unbalanced parens, trailing input, divide-by-zero)
# are surfaced as `Err` and printed — no process kill — so the output is deterministic.

# ---- tokens ------------------------------------------------------------------------------------

enum Tok:
    Num(int)
    Plus
    Minus
    Star
    Slash
    LParen
    RParen

fn is_digit(c: str) -> bool:
    return c >= "0" and c <= "9"

fn digit_val(c: str) -> int:
    return ord(c) - ord("0")

# Scan a source string into a token list. Unknown characters fail with an Err.
fn tokenize(src: str) -> list[Tok]!:
    toks := []
    i := 0
    n := src.len()
    while i < n:
        c := src[i]
        if c == " ":
            i += 1
        else if c == "+":
            toks.push(Tok.Plus)
            i += 1
        else if c == "-":
            toks.push(Tok.Minus)
            i += 1
        else if c == "*":
            toks.push(Tok.Star)
            i += 1
        else if c == "/":
            toks.push(Tok.Slash)
            i += 1
        else if c == "(":
            toks.push(Tok.LParen)
            i += 1
        else if c == ")":
            toks.push(Tok.RParen)
            i += 1
        else if is_digit(c):
            val := 0
            while i < n and is_digit(src[i]):
                val = val * 10 + digit_val(src[i])
                i += 1
            toks.push(Tok.Num(val))
        else:
            return Err("bad character '{c}' at {i}")
    return Ok(toks)

# ---- AST ---------------------------------------------------------------------------------------

enum Ast:
    Lit(int)
    Bin(str, Ast, Ast)        # self-recursive: an operand is itself an Ast

# ---- parser ------------------------------------------------------------------------------------
#
# Grammar (precedence-climbing, left-associative):
#   expr   := term (('+' | '-') term)*
#   term   := factor (('*' | '/') factor)*
#   factor := Num | '(' expr ')'

struct Parser:
    toks: list[Tok]
    pos: int

    fn peek(self) -> Tok?:
        if self.pos < self.toks.len():
            return Some(self.toks[self.pos])
        return None

    fn advance(self):
        self.pos += 1

    fn parse_expr(self) -> Ast!:
        left := self.parse_term()?
        while true:
            match self.peek():
                None: return Ok(left)
                Some(t):
                    match t:
                        Tok.Plus:
                            self.advance()
                            right := self.parse_term()?
                            left = Ast.Bin("+", left, right)
                        Tok.Minus:
                            self.advance()
                            right := self.parse_term()?
                            left = Ast.Bin("-", left, right)
                        _: return Ok(left)
        return Ok(left)

    fn parse_term(self) -> Ast!:
        left := self.parse_factor()?
        while true:
            match self.peek():
                None: return Ok(left)
                Some(t):
                    match t:
                        Tok.Star:
                            self.advance()
                            right := self.parse_factor()?
                            left = Ast.Bin("*", left, right)
                        Tok.Slash:
                            self.advance()
                            right := self.parse_factor()?
                            left = Ast.Bin("/", left, right)
                        _: return Ok(left)
        return Ok(left)

    fn parse_factor(self) -> Ast!:
        match self.peek():
            None: return Err("expected a number or '('")
            Some(t):
                match t:
                    Tok.Num(v):
                        self.advance()
                        return Ok(Ast.Lit(v))
                    Tok.LParen:
                        self.advance()
                        inner := self.parse_expr()?
                        match self.peek():
                            None: return Err("expected ')'")
                            Some(rt):
                                match rt:
                                    Tok.RParen:
                                        self.advance()
                                        return Ok(inner)
                                    _: return Err("expected ')'")
                    _: return Err("expected a number or '('")

# ---- evaluator ---------------------------------------------------------------------------------

fn eval(node: Ast) -> int!:
    match node:
        Ast.Lit(v):
            return Ok(v)
        Ast.Bin(op, l, r):
            a := eval(l)?
            b := eval(r)?
            match op:
                "+": return Ok(a + b)
                "-": return Ok(a - b)
                "*": return Ok(a * b)
                "/":
                    if b == 0:
                        return Err("division by zero")
                    return Ok(a / b)
                _: return Err("unknown operator '{op}'")

# ---- driver ------------------------------------------------------------------------------------

fn calc(input: str) -> int!:
    toks := tokenize(input)?
    p := Parser(toks, 0)
    ast := p.parse_expr()?
    match p.peek():
        Some(_): return Err("trailing input")
        None:    return eval(ast)

fn main():
    # left-assoc: "10 - 4 - 3" is (10-4)-3 = 3; "7 / 0" -> Err; "1 + " parse error;
    # "3 % 2" bad character; "(1 + 2" unbalanced.
    inputs := ["1 + 2 * 3", "(1 + 2) * 3", "2 * (3 + 4) - 5", "100 / 5 / 2", "10 - 4 - 3", "2 + 3 * 4 - 10 / 2", "7 / 0", "1 + ", "3 % 2", "(1 + 2", "42"]
    for src in inputs:
        match calc(src):
            Ok(v):  print("{src} = {v}")
            Err(e): print("{src} -> error: {e.message()}")

main()
