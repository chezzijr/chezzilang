# examples/hashmap_keys.chz — real hash-table map/set with Hashable struct keys.
#
# map/set are insertion-ordered hash tables (entries + a hash→position index). Keys/elements may be
# any Hashable type: int/str/bool intrinsically, or a struct that defines `hash(self) -> int`. The
# hash routes the probe; structural `==` confirms it. Insertion order is preserved for iteration.

struct Point:
    x: int
    y: int
    fn hash(self) -> int:
        return self.x * 31 + self.y
    fn str(self) -> str:
        return "({self.x}, {self.y})"

fn main():
    # --- scalar keys still work (regression) ---
    counts: Map[str, int] = {}
    for w in ["a", "b", "a", "c", "a", "b"]:
        if counts.has(w):
            counts[w] = counts[w] + 1
        else:
            counts[w] = 1
    print("counts:")
    for k in counts:
        print("  {k} -> {counts[k]}")

    nums: Set[int] = Set([3, 1, 3, 2, 1])
    print("nums.len: {nums.len()}")

    # --- struct keys (the new capability) ---
    label: Map[Point, str] = {}
    label[Point(0, 0)] = "origin"
    label[Point(1, 0)] = "east"
    label[Point(0, 1)] = "north"
    label[Point(0, 0)] = "home"          # structurally-equal key updates in place
    print("labels (insertion order):")
    for p in label:
        print("  {p}: {label[p]}")
    print("at (1,0): {label[Point(1, 0)]}")
    print("has (0,1): {label.has(Point(0, 1))}")
    print("has (9,9): {label.has(Point(9, 9))}")
    print("removed (0,0): {label.remove(Point(0, 0))}")
    print("len after remove: {label.len()}")

    # --- set of structs: dedup via custom hash + structural eq ---
    pts: Set[Point] = Set()
    pts.add(Point(2, 2))
    pts.add(Point(2, 2))                  # duplicate — deduped
    pts.add(Point(3, 3))
    print("pts.len: {pts.len()}")

    a: Set[Point] = Set([Point(1, 1), Point(2, 2)])
    b: Set[Point] = Set([Point(2, 2), Point(3, 3)])
    print("a | b: {a.union(b).len()}")
    print("a & b: {a.intersection(b).len()}")
    print("a - b: {a.difference(b).len()}")

main()
