# Built-in type conversions — str<->bytes (UTF-8) methods + list()/set()/map() constructors.
# Three-engine parity (VM, --serial, --interp): exercises encode/decode round-trip incl. a
# multi-byte char, an invalid-UTF-8 decode under recover:, list() over every for-iterable shape
# (list/set/str/bytes/bytearray/range/user-iterator), set() dedup over several iterables, and
# map() from a list of 2-tuples (with a last-wins duplicate key). No new syntax — all are
# existing call/method productions. UTF-8 only (no encoding-name argument).

# A finite user iterator (NOT a generator) so all three engines agree.
struct Counter:
    n: int
    limit: int
    fn next(self) -> Option[int]:
        if self.n >= self.limit:
            return None
        v := self.n
        self.n = self.n + 1
        return Some(v)

fn main():
    # --- str.encode() -> bytes / bytes.decode() -> str round-trip (multi-byte char) ---
    s := "héllo"
    enc := s.encode()
    print(enc.len())           # 6 bytes: 'h' 0xC3 0xA9 'l' 'l' 'o'
    print(enc.decode())        # héllo (round-trips)
    print(enc.decode() == s)   # true

    # bytearray.decode() — identical to bytes.decode().
    ba := bytearray([104, 105])
    print(ba.decode())         # hi

    # --- invalid UTF-8 decode faults RECOVERABLY (catchable by recover:) ---
    r := recover:
        b"\xff\xfe".decode()
    match r:
        Ok(v): print(v)
        Err(e): print("caught")

    # --- list(it) over every for-iterable shape; sum to stay order-independent ---
    print(list([10, 20, 30]).sum())        # 60 (from a list)
    print(list(set([1, 2, 3])).sum())      # 6 (from a set)
    print(list("ab").len())                # 2 (from a str -> per-char str)
    print(list(b"hi").sum())               # 209 (from bytes -> per-byte int: 104+105)
    print(list(bytearray([1, 2, 3])).sum())# 6 (from a bytearray)
    print(list(range(4)).sum())            # 6 (from a range -> 0+1+2+3)
    print(list(Counter(0, 5)).sum())       # 10 (from a user iterator -> 0+1+2+3+4)

    # --- set(it) dedup over several iterables ---
    print(set([1, 1, 2, 2, 3]).len())      # 3 (list dedup)
    print(set("aabbc").len())              # 3 (str dedup: a b c)
    print(set(range(3)).len())             # 3 (range)
    print(set(Counter(0, 4)).len())        # 4 (user iterator)

    # --- map(it) from a list of 2-tuples + last-wins dup key ---
    m := map([(1, "a"), (2, "b"), (1, "c")])
    print(m.len())                         # 2 (key 1 deduped)
    print(m[1])                            # c (last-wins)
    print(m[2])                            # b

main()
