# Built-in type conversions — str<->bytes (UTF-8) methods + List()/Set()/Map() constructors.
# Deterministic golden (any worker count): exercises encode/decode round-trip incl. a
# multi-byte char, an invalid-UTF-8 decode under recover:, List() over every for-iterable shape
# (list/set/str/bytes/bytearray/range/user-iterator), Set() dedup over several iterables, and
# Map() from a list of 2-tuples (with a last-wins duplicate key). No new syntax — all are
# existing call/method productions. UTF-8 only (no encoding-name argument).

# A finite user iterator (NOT a generator).
struct Counter:
    n: int
    limit: int
    fn next(self) -> int?:
        if self.n >= self.limit:
            return None
        v := self.n
        self.n = self.n + 1
        return ?v

fn main():
    # --- str.encode() -> bytes / bytes.decode() -> str round-trip (multi-byte char) ---
    s := "héllo"
    enc := s.encode()
    print(enc.len())           # 6 bytes: 'h' 0xC3 0xA9 'l' 'l' 'o'
    print(enc.decode())        # héllo (round-trips)
    print(enc.decode() == ?s)  # true

    # bytearray.decode() — identical to bytes.decode().
    ba := bytearray.from_iter([104, 105])
    print(ba.decode())         # hi

    # --- invalid UTF-8: decode() gives an error that names the byte ---
    match b"\xff\xfe".decode():
        ?v: print(v)
        !e: print(e)               # decode: invalid UTF-8 at byte 0 (0xff)

    # --- List.from_iter(it) over every for-iterable shape; sum to stay order-independent ---
    print(List.from_iter([10, 20, 30]).sum())        # 60 (from a list)
    print(List.from_iter(Set.from_iter([1, 2, 3])).sum())      # 6 (from a set)
    print(List.from_iter("ab").len())                # 2 (from a str -> per-char str)
    print(List.from_iter(b"hi").sum())               # 209 (from bytes -> per-byte int: 104+105)
    print(List.from_iter(bytearray.from_iter([1, 2, 3])).sum())# 6 (from a bytearray)
    print(List.from_iter(0..4).sum())            # 6 (from a range -> 0+1+2+3)
    print(List.from_iter(Counter(0, 5)).sum())       # 10 (from a user iterator -> 0+1+2+3+4)

    # --- Set.from_iter(it) dedup over several iterables ---
    print(Set.from_iter([1, 1, 2, 2, 3]).len())      # 3 (list dedup)
    print(Set.from_iter("aabbc").len())              # 3 (str dedup: a b c)
    print(Set.from_iter(0..3).len())             # 3 (range)
    print(Set.from_iter(Counter(0, 4)).len())        # 4 (user iterator)

    # --- Map.from_iter(it) from a list of 2-tuples + last-wins dup key ---
    m := Map.from_iter([(1, "a"), (2, "b"), (1, "c")])
    print(m.len())                         # 2 (key 1 deduped)
    print(m[1])                            # c (last-wins)
    print(m[2])                            # b

main()
