# examples/echo_server_spawn.chz — a TCP echo server with PER-CONNECTION spawn (D-tier).
#
# Unlike examples/echo_server.chz (which services each connection INLINE in the accept loop), here
# the acceptor `spawn`s a `handle(conn)` fiber PER accepted connection inside its own `parallel:`.
# The acceptor returns to `accept()` immediately while handlers run concurrently on the M:N pool —
# the structured-concurrency shape a real server wants. The inner `parallel:` is EAGER: a spawn
# injects a live fiber into the running scheduler (not queued for the join), so the handler runs
# now, not after the loop. The inner nursery joins (waits for every handler) when the loop ends.
#
# Per-connection spawn parks on the netpoller, which needs the default (M:N) engine:
#
#   chezzi run examples/echo_server_spawn.chz
#
# The printed number is MEASURED, not asserted: a `spawn`ed fiber's return value is discarded (this is
# Go's `go f()`), so the count lives in a shared `AtomicInt` — Go's `atomic.Int64` — that only a client
# which completed the whole round-trip bumps. On `--serial` that prints a truthful `0 connections`.

import std.net
import std.concurrency

fn handle(conn: Socket) -> int!:
    msg := conn.read(64)?
    conn.write("echo:" + msg)?
    conn.close()
    return Ok(0)

fn acceptor(server: Listener, n: int) -> int!:
    parallel:
        for _ in 0..n:
            conn := server.accept()?
            spawn handle(conn)        # injected into the live nursery — runs concurrently
    server.close()
    return Ok(0)

fn client(addr: str, served: AtomicInt) -> int!:
    sock := net.connect(addr)?
    sock.write("ping")?
    reply := sock.read(64)?
    sock.close()
    if reply == "echo:ping":
        served.add(1)             # counted only by a client that got its own echo back
    return Ok(0)

fn run(n: int) -> int!:
    server := net.listen("127.0.0.1:0")?
    addr := server.addr()?
    served := AtomicInt(0)
    parallel:
        spawn acceptor(server, n)
        for _ in 0..n:
            spawn client(addr, served)
    return Ok(served.load())      # the nursery has joined, so every client has finished counting

fn main():
    match run(50):
        Ok(served): print("echo server handled {served} connections, one fiber each")
        Err(e): print("error: " + e.message())

main()
