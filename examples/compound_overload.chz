# Compound assignment (`+= -= *= /= %=`) honors operator overloading.
# `x OP= v` is exactly `x = x OP v`, so a struct/enum whose operator overload makes
# `a = a OP b` type-check also accepts `a OP= b` (same runtime opcode path).

struct V:
    x: int
    fn add(self, other: V) -> V:
        return V(self.x + other.x)
    fn str(self) -> str:
        return "V({self.x})"

# A one-field struct: `+=` via its own `add`.
struct Meters:
    v: float
    fn add(self, other: Meters) -> Meters:
        return Meters(self.v + other.v)
    fn str(self) -> str:
        return "{self.v}m"

fn main():
    # struct: the compound form equals the explicit form.
    a := V(1)
    a = a + V(10)
    b := V(1)
    b += V(10)
    print(a)          # V(11)
    print(b)          # V(11)

    # a one-field struct
    m := Meters(1.0)
    m += Meters(2.5)
    print(m)          # 3.5m

main()
