# C5 concurrency: program-exit join. An `Executor` is DETACHED — it outlives the scope that created
# it, and work you submit but never explicitly `shutdown`/`shutdown_now` is still waited for at program
# exit, exactly as a top-level `defer ex.shutdown()` would. Without this the program could exit with
# its jobs half-done. Matches Python's `ThreadPoolExecutor` (its worker threads are joined at
# interpreter exit) and Java's `ExecutorService`. `os.exit` stays a hard halt and does NOT join.
#
# The jobs run concurrently with the rest of the program, so their side effects can land anywhere up to
# the exit join — which is why nothing here prints from inside a job in a fixed position. The last job
# to finish reports the total, so the line appears exactly once whatever order they complete in.

import std.concurrency

fn job(id: int, done: Atomic[int], total: int):
    # `add` returns the NEW total, so this is true for exactly one job whatever order they run in:
    # the last one to arrive.
    if done.add(id) == total:
        print("all {total} units of work finished before exit")

fn main():
    ex := Executor()
    done := Atomic(0)
    ex.submit(fn(): job(1, done, 3))
    ex.submit(fn(): job(2, done, 3))
    print("main() done; executor never shut down")
    # No ex.shutdown() — the runtime waits for the submitted work at program exit.

main()
