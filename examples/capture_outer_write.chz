# Uniform by-reference capture (A1): a closure shares the closest binding of a captured local, so it
# sees writes made AFTER the closure was created. (Under the old value-semantics rule this printed
# `10` — the snapshot at closure creation; capture is now by reference.)
fn main():
    x := 10
    f := fn() -> int: x
    x = 20
    print(f())              # 20

main()
