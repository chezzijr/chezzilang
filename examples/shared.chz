# C3 concurrency: `Shared[T]` — the sanctioned cross-task mutable box (Elixir's `Agent` trick).
# A task holds the parent's values by handle (Go), so two tasks that write one value race; when
# tasks must write one state, reach for `Shared[T]`. Each task gets the box's handle, so every task
# reaches the same box, and its guard serialises the writes: no write is lost.

import Shared from std.concurrency

fn bump(s: Shared[int]):
    s.update(fn(x): x + 1)

fn main():
    s := Shared[int](0)          # one owner holds the value (turbofish optional, checked vs value)
    parallel:
        spawn bump(s)            # each task gets the handle: all three reach the same box
        spawn bump(s)
        spawn bump(s)
    print(s.get())               # 3 — every increment landed (writes are serialised)

    s.set(10)                    # overwrite
    print(s.get())               # 10

main()
