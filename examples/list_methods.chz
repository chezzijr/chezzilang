xs := [1, 2, 3]
last := xs.pop()
match last:
    Some(v): print("popped {v}")
    None: print("empty")
print(xs.len())

ys := [3, 1, 2]
ys.reverse()
print(ys[0])

print(ys.contains(2))
print(ys.contains(9))

print(ys.index_of(1))
print(ys.index_of(99))

print([1, 2, 3, 4].sum())
print([1.0, 2.5, 0.5].sum())

# value/ergonomics methods (gaps.md §2)
print([3, 1, 2].min())
print([3, 1, 2].max())

struct Item:
    weight: int
    name: str
items := [Item(3, "box"), Item(1, "pin"), Item(2, "cup")]
print(items.min_by(fn(it: Item) -> int: it.weight).name)
print(items.max_by(fn(it: Item) -> int: it.weight).name)

zs := [10, 20, 30]
match zs.first():
    Some(v): print("first {v}")
    None: print("none")
match zs.last():
    Some(v): print("last {v}")
    None: print("none")

# reversed() returns a NEW list; the original is untouched
print(zs.reversed())
print(zs)

zs.insert(1, 15)
print(zs)
removed := zs.remove_at(0)
print("removed {removed}")
print(zs)

# iter ergonomics (gaps.md §2 wave-2)
print([3, 1, 3, 2, 1].unique())
print([1, 1, 2, 2, 2, 1, 3, 3].dedup())
empty: List[int] = []
print(empty.unique())
print([5].unique())
print([2, 2, 2].unique())
print([1, 2, 3, 4, 5].chunk(2))
print([1, 2, 3].chunk(3))
print([1, 2].chunk(5))
print(empty.chunk(2))
print([1, 2, 3, 4].windows(2))
print([1, 2].windows(5))
print([1, 2, 3, 4, 1].take_while(fn(x: int) -> bool: x < 3))
print([1, 2, 3, 4, 1].drop_while(fn(x: int) -> bool: x < 3))
print([5, 1].take_while(fn(x: int) -> bool: x < 3))
print([1, 2].drop_while(fn(x: int) -> bool: true))
print([1, 2, 3, 2, 1].count(fn(x: int) -> bool: x == 2))
match [1, 2, 3, 2].position(fn(x: int) -> bool: x == 2):
    Some(i): print("pos {i}")
    None: print("nopos")
match [1, 3].position(fn(x: int) -> bool: x == 2):
    Some(i): print("pos {i}")
    None: print("nopos")
