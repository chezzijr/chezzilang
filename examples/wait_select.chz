# `wait:` — Chezzi's `select`. Race several channel `recv`s: block until whichever channel is ready
# first, bind its result, and run that arm (source-order priority, not Go's random fairness). An arm
# binds what `ch.recv()` returns, `T!RecvError`: the value, or `!RecvError` once the channel is closed
# and drained.
#
# This example uses only NON-blocking arms — a value already queued, a fired `timer`, or `else:` —
# so its output is deterministic at every worker count. (A `wait` that truly blocks until a sibling
# produces is exercised by the `vm_wait_blocks_then_wakes_on_second_channel` test.)

import timer from std.time

fn main():
    orders := Channel[str]()
    cancels := Channel[str]()

    # 1. Both arms ready → the FIRST arm (source order) wins.
    orders.send("a1")
    cancels.send("c1")
    wait:
        v := orders.recv():
            o := v else: panic("orders closed")
            print("order {o}")
        w := cancels.recv():
            c := w else: panic("cancels closed")
            print("cancel {c}")

    # 2. `orders` is drained now; the buffered `cancels` value is taken.
    wait:
        v := orders.recv():
            o := v else: panic("orders closed")
            print("order {o}")
        w := cancels.recv():
            c := w else: panic("cancels closed")
            print("cancel {c}")

    # 3. Nothing ready → the non-blocking `else:` fallback runs.
    wait:
        v := orders.recv():
            o := v else: panic("orders closed")
            print("order {o}")
        else: print("idle")

    # 4. A `timer` arm fires once its deadline passes. For a waiter that owns its OS thread (`main`,
    #    an `Executor` job) or a `parallel:` fiber it is just another arm — a sibling value arriving
    #    first wins the wait (`docs/contributing/gaps.md` W7-14). One shape still inline-sleeps to the deadline
    #    without re-polling siblings: the INLINE outermost-`parallel:` builder, which owns no worker
    #    loop to drive a park (`src/vm/netio.rs` op_wait_poll; `docs/contributing/gaps.md` N10).
    wait:
        _ := timer(1).recv(): print("timeout")

    # 5. `=` assigns an existing outer lvalue (of the recv result type) instead of binding a fresh name.
    nums := Channel[int]()
    nums.send(7)
    last: int!RecvError = ?0
    wait:
        last = nums.recv():
            n := last else: panic("nums closed")
            print("sum {n}")

    # 6. A closed, drained channel is ready: its arm binds `!RecvError`, and the first ready arm in
    #    source order wins, so `close(done)` works as a stop signal. (A guard, `if open:`, switches
    #    an arm off.)
    done := Channel[int]()
    done.close()
    nums.send(9)
    wait:
        d := done.recv():
            match d:
                ?x: print("done {x}")
                !e: print("done: {e.message()}")
        n := nums.recv():
            x := n else: panic("nums closed")
            print("num {x}")

main()
