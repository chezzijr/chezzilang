# examples/ref.chz — Ref[T]: a one-field mutable box (std.ref).
#
# Types defined in any imported module are program-global, so `import std.ref` makes `Ref` usable
# by its bare name. Capture is by reference now, so a closure over a bare local `int` can already
# accumulate into it — `Ref[T]` is the *explicit* first-class box for the cases a bare local can't
# cover: storing the box in a struct field or collection, or passing it around as a value.

import std.ref

# basic get / set
r := Ref(10)
print(r.get())          # 10
r.set(42)
print(r.get())          # 42

# update with a function
r.update(fn(x: int) -> int: x + 1)
print(r.get())          # 43

# closure capture: a bare captured `int` would also accumulate now (capture is by reference); here
# the value lives in an explicit first-class `Ref` box
counter := Ref(0)
add1 := fn(x: int) -> int: x + 1
bump := fn(): counter.update(add1)
bump()
bump()
bump()
print(counter.get())    # 3

# generic over a non-int type
s := Ref("hi")
s.update(fn(v: str) -> str: v.upper())
print(s.get())          # HI
