# examples/ref.chz — Ref[T]: a one-field mutable box (std.ref).
#
# Types defined in any imported module are program-global, so `import std.ref` makes `Ref` usable
# by its bare name. A bare local `int` is captured by value (snapshot), so a closure can't
# accumulate into it — but a `Ref[T]` is a shared struct, so a closure that closes over it and
# mutates it through a method persists the change for the caller.

import std.ref

# basic get / set
r := Ref(10)
print(r.get())          # 10
r.set(42)
print(r.get())          # 42

# update with a function
r.update(fn(x: int) -> int: x + 1)
print(r.get())          # 43

# closure capture: a captured bare `int` would snapshot at 0; the shared Ref accumulates
counter := Ref(0)
add1 := fn(x: int) -> int: x + 1
bump := fn(): counter.update(add1)
bump()
bump()
bump()
print(counter.get())    # 3

# generic over a non-int type
s := Ref("hi")
s.update(fn(v: str) -> str: v.upper())
print(s.get())          # HI
