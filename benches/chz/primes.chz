# Bench: while + %, primes below 200k (sequential, single task — distinct from
# examples/primes_parallel.chz which splits across spawned tasks). Stresses the integer
# arithmetic hot path (modulo, compare, increment) and per-iteration dispatch. Prints 17984.

fn is_prime(n: int) -> bool:
    if n < 2:
        return false
    i := 2
    while i * i <= n:
        if n % i == 0:
            return false
        i += 1
    return true

fn main():
    c := 0
    n := 2
    while n < 200000:
        if is_prime(n):
            c += 1
        n += 1
    print(c)

main()
