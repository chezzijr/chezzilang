# Bench: polymorphic (megamorphic) method dispatch throughput. Four distinct struct types each
# implement Shape.area(); a heterogeneous list[Shape] is walked at ONE call site so `s.area()` sees
# four distinct layout `tid`s in rotation — a genuinely megamorphic CallMethod site (the M19
# N-way method-IC target). ~4M method calls. Prints 34000000.

protocol Shape:
    fn area(self) -> int

struct Sq:
    s: int

    fn area(self) -> int:
        return self.s * self.s

struct Rect:
    w: int
    h: int

    fn area(self) -> int:
        return self.w * self.h

struct Tri:
    b: int
    hh: int

    fn area(self) -> int:
        return self.b * self.hh / 2

struct Circ:
    r: int

    fn area(self) -> int:
        return self.r + self.r + 1

fn total_area(shapes: list[Shape]) -> int:
    acc := 0
    for s in shapes:
        acc = acc + s.area()
    return acc

fn main():
    shapes := []
    shapes.push(Sq(3))      # 9
    shapes.push(Rect(2, 4)) # 8
    shapes.push(Tri(4, 5))  # 10
    shapes.push(Circ(3))    # 7
    total := 0
    i := 0
    while i < 1000000:
        total = total + total_area(shapes)
        i += 1
    print(total)

main()
