# Bench: string-keyed map get-then-increment, 1000 distinct keys x 1000 rounds = 1M gets + 1M sets.
# Sibling of benches/chz/map.chz, which uses INT keys on purpose ("Int keys hash straight to their
# f64 bits") and therefore never pays string-content hashing. This one does, and is the shape of
# word counts, group-bys and JSON-record pipelines. Keys are built once into a list so the loop
# measures hashing and probing rather than string construction. Prints 1000000.

fn main():
    keys := []
    i := 0
    while i < 1000:
        keys.push("key-" + str(i))
        i += 1

    m := {}
    n := 0
    while n < 1000:
        m[keys[n]] = 0
        n += 1

    r := 0
    while r < 1000:
        j := 0
        while j < 1000:
            k := keys[j]
            m[k] = m[k] + 1
            j += 1
        r += 1

    total := 0
    p := 0
    while p < 1000:
        total += m[keys[p]]
        p += 1
    print(total)

main()
