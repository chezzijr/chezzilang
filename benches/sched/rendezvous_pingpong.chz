# TICKET-185 — the channel hand-off hot path: two fibers pass one int back and forth over two
# rendezvous channels, 200000 round trips.
fn main():
    ping := Channel[int](0)
    pong := Channel[int](0)
    parallel:
        spawn:
            for _ in 0..200000:
                v := ping.recv() else: panic("ping closed")
                pong.send(v + 1)
        n := 0
        for _ in 0..200000:
            ping.send(n)
            r := pong.recv() else: panic("pong closed")
            n = r
        print(n)
main()
