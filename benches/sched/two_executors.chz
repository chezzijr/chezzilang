import Executor from std.concurrency
fn burn(n: int) -> int:
    s := 0
    for i in 0..n:
        s += i % 7
    return s
fn main():
    a := Executor()
    b := Executor()
    for i in 0..4:
        _ := a.submit(fn(): print("a{i} {burn(8000000)}"))
        _ := b.submit(fn(): print("b{i} {burn(8000000)}"))
    a.shutdown()
    b.shutdown()
main()
