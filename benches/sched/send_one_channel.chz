fn produce(c: Channel[int], n: int):
    i := 0
    while i < n:
        c.send(i)
        i += 1

fn consume(c: Channel[int], n: int):
    total := 0
    i := 0
    while i < n:
        total += c.recv()
        i += 1
    print("{total}")

ch := Channel[int](1)
n := 200000
parallel:
    spawn produce(ch, n)
    spawn consume(ch, n)
