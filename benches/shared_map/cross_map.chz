# TICKET-192 crossing cost: a 10k-entry map stored into a `Shared` and read back 200 times. Every
# store serializes the map, which since TICKET-192 also builds the wire map's hash index; this bench
# prices that index. Prints 2000000.
import Shared from std.concurrency

fn main():
    m: Map[int, int] = {}
    for i in 0..10000:
        m[i] = i
    box := Shared(m)
    s := 0
    for _ in 0..200:
        box.set(m)
        s = s + box.get().len()
    print(s)
main()
