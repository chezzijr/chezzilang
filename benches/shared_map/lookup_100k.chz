# TICKET-192 perf cell: 100k `ConcurrentMap.get` on a 100k-entry map. Release target:
# under 1 s (O(1) expected per lookup). Prints the hit count, 100000.
import std.concurrency
import ConcurrentMap from std.concurrency.collection

fn main():
    n := 100000
    m: Map[int, int] = {}
    i := 0
    while i < n:
        m[i] = i
        i = i + 1
    box := ConcurrentMap(concurrency.RwShared(m))
    hits := 0
    i = 0
    while i < n:
        match box.get(i):
            ?v: hits = hits + 1
            None: hits = hits
        i = i + 1
    print(hits)
main()
