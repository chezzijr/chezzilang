# Codeforces 1A — Theatre Square. Cover an n×m square with a×a flagstones (no breaking, may
# overhang). Answer = ceil(n/a)*ceil(m/a). Stresses near-i64 multiplication: up to ~1e18.
import std.io

fn main():
    line := ""
    match io.read_line():
        ?l: line = l
        None:    return
    parts: List[str] = []
    for t in line.split(" "):
        s := t.trim()
        if s != "":
            parts.push(s)
    n := parts[0].to_int() ?? panic("input is not an int")
    m := parts[1].to_int() ?? panic("input is not an int")
    a := parts[2].to_int() ?? panic("input is not an int")
    rows := (n + a - 1) / a
    cols := (m + a - 1) / a
    io.print("{rows * cols}")

main()
