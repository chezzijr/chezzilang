# CSES 1621 — Distinct Numbers. Read n then n values; print how many distinct values.
# Stresses: Set insert/dedup over up to 2e5 ints.
import std.io

fn read_tokens() -> List[str]:
    text := ""
    while true:
        match io.read_line():
            ?l: text = text + l + " "
            None:    break
    toks: List[str] = []
    for t in text.split(" "):
        s := t.trim()
        if s != "":
            toks.push(s)
    return toks

fn main():
    toks := read_tokens()
    n := toks[0].to_int() ?? panic("input is not an int")
    seen: Set[int] = Set()
    for i in 0..n:
        seen.insert(toks[1 + i].to_int() ?? panic("input is not an int"))
    io.print("{seen.len()}")

main()
