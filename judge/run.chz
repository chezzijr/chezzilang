# judge/run.chz: DSA known-answer harness, written in Chezzi.
#
# Two problem roots:
#   judge/problems/<slug>/  a hand-written solution + committed samples (samples/N.in, N.out),
#                           judged by token compare. `--samples-only` runs these alone (the cargo gate).
#   judge/lc/<problem>/     a solution to a Library Checker problem
#                           (github.com/yosupo06/library-checker-problems, pinned below). The harness
#                           clones the repo into judge/vendor/ (gitignored), builds the cases with its
#                           generate.py (needs g++ and python3), and judges each answer with the
#                           problem's own checker.
#
# Each solution runs in a subprocess (`timeout N chezzi run solution.chz < case.in`), so a loop (TIME),
# a runtime error (FAULT) or a host panic (PANIC) is caught instead of ending the harness.
#
# Usage (from the repo root, after `cargo build --release`):
#   ./target/release/chezzi run judge/run.chz                  # every problem in both roots
#   ./target/release/chezzi run judge/run.chz unionfind        # one problem
#   ./target/release/chezzi run judge/run.chz --samples-only   # judge/problems samples only
#   ./target/release/chezzi run judge/run.chz --timeout 30     # per-case limit in seconds (default 10)
# Exits 1 if any case fails. `CHEZZI_BIN` overrides the binary under test.

import std.io
import std.fs
import std.process
import std.os

LC_URL := "https://github.com/yosupo06/library-checker-problems"
LC_PIN := "73876f1cbcf082d2b22722924b924d3d65a2f00e"
LC_ROOT := "judge/vendor/library-checker-problems"

struct Verdict:
    tag: str       # PASS | WRONG | FAULT | PANIC | TIME | CHECK | NOEXP | SPAWN
    detail: str    # human hint for a failure (empty for PASS)

# CSES's default checker compares the *token sequence*, ignoring ALL whitespace (spaces, tabs, and
# newlines alike): a token-identical answer with different line breaks is still ACCEPTED. So the
# pass/fail decision is made on tokens (see `tokens` + judge_case), not line structure — otherwise a
# correct solution that lays tokens out differently than the .out would be a false-positive WRONG,
# which would defeat the harness (a non-PASS is meant to flag a candidate Chezzi bug).
fn tokens(s: str) -> List[str]:
    out: List[str] = []
    for l in s.replace("\t", " ").split_lines():
        for t in l.split(" "):
            tt := t.trim()
            if tt != "":
                out.push(tt)
    return out

# Per-line normalization used ONLY for the human-readable diff hint (not the verdict): trim each line,
# drop trailing blank lines.
fn norm_lines(s: str) -> List[str]:
    out: List[str] = []
    for l in s.split_lines():
        out.push(l.trim())
    while out.len() > 0 and out[out.len() - 1] == "":
        _ := out.pop()
    return out

fn first_diff(got: List[str], want: List[str]) -> str:
    n := got.len()
    if want.len() > n:
        n = want.len()
    for i in 0..n:
        g := "<missing>"
        if i < got.len():
            g = got[i]
        w := "<missing>"
        if i < want.len():
            w = want[i]
        if g != w:
            lineno := i + 1
            return "line {lineno}: expected `{w}` got `{g}`"
    return "(differs only in length)"

fn first_line(s: str) -> str:
    ls := s.split_lines()
    if ls.len() > 0:
        return ls[0]
    return ""

fn glob_strs(pat: str) -> List[str]:
    out: List[str] = []
    match fs.glob(pat):
        ?paths:
            for p in paths:
                out.push(p.str())
        !e:    out.extend([])
    return out

# The names of the subdirectories of `dir` that hold `file`.
fn dirs_with(dir: str, file: str) -> List[str]:
    out: List[str] = []
    match fs.list_dir(dir):
        ?names:
            for entry in names:
                name := entry.str()
                if fs.is_file("{dir}/{name}/{file}"):
                    out.push(name)
        !e:    out.extend([])
    return out

# Run one case; return its verdict. `checker` empty: token compare against `expfile`.
# Otherwise the Library Checker convention: `checker <in> <got> <expected>`, exit 0 = AC,
# 3 = the checker itself failed, any other code = wrong answer.
fn judge_case(chezzi: str, timeout_s: int, sol: str, infile: str, expfile: str, checker: str, gotfile: str) -> Verdict:
    expected := ""
    match io.read_file(expfile):
        ?t:  expected = t
        !e: return Verdict("NOEXP", "no expected output {expfile}")
    cmd := "timeout {timeout_s} {chezzi} run {sol} < {infile} > {gotfile}"
    match process.run(cmd):
        ?r:
            if r.code == 124:
                return Verdict("TIME", "killed after {timeout_s}s")
            if r.stderr.contains("panicked at"):
                return Verdict("PANIC", first_line(r.stderr))
            if r.code != 0:
                return Verdict("FAULT", "exit {r.code}: {first_line(r.stderr)}")
        !e:
            return Verdict("SPAWN", e.message())
    if checker != "":
        match process.run("{checker} {infile} {gotfile} {expfile}"):
            ?c:
                if c.code == 0:
                    return Verdict("PASS", "")
                if c.code == 3:
                    return Verdict("CHECK", first_line(c.stderr))
                return Verdict("WRONG", first_line(c.stderr))
            !e:
                return Verdict("SPAWN", e.message())
    got := io.read_file(gotfile) ?? ""
    if " ".join(tokens(got)) == " ".join(tokens(expected)):
        return Verdict("PASS", "")
    return Verdict("WRONG", first_diff(norm_lines(got), norm_lines(expected)))

# A problem to judge: its solution, its cases, and the checker (empty for token compare).
struct Problem:
    slug: str
    sol: str
    inputs: List[str]
    expected_dir: str   # "" = the .out sits next to the .in
    checker: str

fn sh_ok(cmd: str) -> bool:
    match process.run(cmd):
        ?r:
            if r.code != 0:
                print("command failed (exit {r.code}): {cmd}")
                print(r.stderr)
            return r.code == 0
        !e:
            print("cannot run: {cmd} ({e})")
            return false

# Clone the pinned Library Checker commit once.
fn lc_fetch() -> bool:
    if fs.is_dir(LC_ROOT):
        return true
    print("fetching Library Checker {LC_PIN} into {LC_ROOT}")
    return sh_ok("mkdir -p {LC_ROOT} && cd {LC_ROOT} && git init -q && git fetch -q --depth 1 {LC_URL} {LC_PIN} && git checkout -q FETCH_HEAD")

# Build the cases of one Library Checker problem. generate.py skips the build when the cases are newer
# than the sources. The reference solutions recurse deeply, so the stack limit is lifted.
fn lc_problem(slug: str) -> Problem?:
    cats := dirs_with(LC_ROOT, "{slug}/info.toml")
    if cats.len() != 1:
        print("no Library Checker problem named {slug}")
        return None
    dir := "{LC_ROOT}/{cats[0]}/{slug}"
    if not sh_ok("cd {LC_ROOT} && ulimit -s unlimited && python3 generate.py -p {slug} > /dev/null 2>&1"):
        return None
    ins := glob_strs("{dir}/in/*.in")
    return Problem(slug, "judge/lc/{slug}/solution.chz", ins, "{dir}/out", "{dir}/checker")

fn find_problems(only: str, samples_only: bool) -> List[Problem]:
    out: List[Problem] = []
    for slug in dirs_with("judge/problems", "solution.chz"):
        if only == "" or slug == only:
            sol := "judge/problems/{slug}/solution.chz"
            out.push(Problem(slug, sol, glob_strs("judge/problems/{slug}/samples/*.in"), "", ""))
    if samples_only:
        return out
    for slug in dirs_with("judge/lc", "solution.chz"):
        if only != "" and slug != only:
            continue
        if not lc_fetch():
            os.exit(2)
        match lc_problem(slug):
            ?p: out.push(p)
            None: os.exit(2)
    return out

fn main():
    # `CHEZZI_BIN` lets the cargo gate point the harness at the binary cargo just built
    # (`target/debug/chezzi` under a plain `cargo test`); the release build stays the default.
    chezzi := os.env("CHEZZI_BIN") ?? "./target/release/chezzi"
    timeout_s := 10
    only := ""
    samples_only := false
    args := os.args()
    i := 0
    while i < args.len():
        a := args[i]
        if a == "--samples-only":
            samples_only = true
        elif a == "--timeout" and i + 1 < args.len():
            i += 1
            timeout_s = args[i].to_int() ?? panic("--timeout takes whole seconds")
        else:
            only = a
        i += 1

    problems := find_problems(only, samples_only)
    if problems.len() == 0:
        print("no problems found under judge/problems/ or judge/lc/")
        os.exit(2)
    # One output file per harness run, so two runs in one checkout never share it.
    gotfile := (process.cmd("mktemp") ?? "").trim()
    if gotfile == "":
        print("cannot create a temp file (mktemp)")
        os.exit(2)

    total_cases := 0
    total_fail := 0
    skipped := 0

    for pr in problems:
        if pr.inputs.len() == 0:
            skipped += 1
            print("SKIP  {pr.slug}  (no cases)")
            continue

        prob_fail := 0
        for infile in pr.inputs:
            stem := infile.strip_suffix(".in")
            expfile := stem + ".out"
            if pr.expected_dir != "":
                name := stem.split("/")[stem.split("/").len() - 1]
                expfile = "{pr.expected_dir}/{name}.out"
            v := judge_case(chezzi, timeout_s, pr.sol, infile, expfile, pr.checker, gotfile)
            # A missing .out is a data gap, not a solution failure: warn, do not count it.
            if v.tag == "NOEXP":
                print(" WARN  {pr.slug}  {infile}  ({v.detail}, skipped)")
                continue
            total_cases += 1
            if v.tag != "PASS":
                prob_fail += 1
                total_fail += 1
                tag := v.tag.pad_left(5, " ")
                print("{tag}  {pr.slug}  {infile}")
                print("      {v.detail}")

        n := pr.inputs.len()
        if prob_fail == 0:
            print("PASS  {pr.slug}  ({n} case(s))")
        else:
            print("FAIL  {pr.slug}  ({prob_fail}/{n} case(s) failed)")

    _ := fs.remove_file(gotfile)
    print("")
    print("done: {total_cases} case(s), {total_fail} failure(s), {skipped} problem(s) skipped")
    if total_fail > 0:
        os.exit(1)

main()
